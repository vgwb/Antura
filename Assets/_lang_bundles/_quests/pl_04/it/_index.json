{
  "version": "1",
  "questId": "pl_04",
  "lang": "it",
  "lines": [
    {
      "key": "001cba3",
      "nodeTitle": "director_task",
      "sourceText": "È alto 90 metri!",
      "sourceEnText": "It's 90 meters tall!",
      "audioFile": "pl_04_001cba3.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 1463,
      "updatedAt": "2026-09-04T18:05:37Z",
      "textHash": "9cadf98c733d6cb7a1a8eeb323268a9a3c56d582bd1045411a55b81d2a981217"
    },
    {
      "key": "004abc7",
      "nodeTitle": "elephant_kid",
      "sourceText": "Quelle orecchie possono farmi vento d'estate?",
      "sourceEnText": "Can those ears fan me in summer?",
      "audioFile": "pl_04_004abc7.mp3",
      "voiceProfile": "francesco",
      "actorId": "KID_F",
      "durationMs": 2299,
      "updatedAt": "2026-09-04T18:03:25Z",
      "textHash": "60a967f3536475e983bb4bff05fd5718110925acc5f261e6644bb15b4cc4c7c5"
    },
    {
      "key": "005dd46",
      "nodeTitle": "quest_start",
      "sourceText": "Lo zoo più grande della Polonia!",
      "sourceEnText": "The biggest zoo in Poland!",
      "audioFile": "pl_04_005dd46.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1646,
      "updatedAt": "2026-09-04T18:04:12Z",
      "textHash": "d132223bc6c9cdf1dd139ce899c8e862189ff158787b8cf65707c5a9c468ff00"
    },
    {
      "key": "0085a8a",
      "nodeTitle": "animal_peacock",
      "sourceText": "Non ho bisogno di una BANDIERA.",
      "sourceEnText": "I don't need a FLAG.",
      "audioFile": "pl_04_0085a8a.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1776,
      "updatedAt": "2026-09-04T18:04:16Z",
      "textHash": "2aaf2c011cfffbde02f10f693c0b69e2ee9454185fa9925fbbffef5768f34629"
    },
    {
      "key": "0124e1c",
      "nodeTitle": "lion",
      "sourceText": "Quando ero giovane, vivevo con i miei genitori.",
      "sourceEnText": "When I was young, I lived with my parents.",
      "audioFile": "pl_04_0124e1c.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2482,
      "updatedAt": "2026-09-04T18:03:35Z",
      "textHash": "510a4cad6143366691211ff1ee6783148314acb762f5f16031530c85ccb78c29"
    },
    {
      "key": "012b933",
      "nodeTitle": "director_task",
      "sourceText": "Forse uno di loro ce l'ha.",
      "sourceEnText": "Maybe one of them has it.",
      "audioFile": "pl_04_012b933.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 1463,
      "updatedAt": "2026-09-04T18:04:14Z",
      "textHash": "f92d878ecef7c4af4e2813cbd789dff5cf550ea8f33724970e8386e9462f4e1d"
    },
    {
      "key": "019539f",
      "nodeTitle": "lion",
      "sourceText": "Poi sono cresciuto...",
      "sourceEnText": "Then I grew up...",
      "audioFile": "pl_04_019539f.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 1306,
      "updatedAt": "2026-09-04T18:05:41Z",
      "textHash": "80803a74cd51e0ac7d31f671cea27c48fa0fc99d2d443ad4ec3c96686d34ff01"
    },
    {
      "key": "01b3593",
      "nodeTitle": "lion_activity_done",
      "sourceText": "Mi piace molto guardare la bandiera lassù sull'Iglica.",
      "sourceEnText": "I love watching the flag up there on the Iglica.",
      "audioFile": "pl_04_01b3593.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2769,
      "updatedAt": "2026-09-04T18:04:26Z",
      "textHash": "8d5c6d4adfb37770393d6897cbe0fca685f58e41a17b78e9878994a70ab0422a"
    },
    {
      "key": "01d80fc",
      "nodeTitle": "monkey_tutor",
      "sourceText": "Gli scimpanzé sono grandi scalatori.",
      "sourceEnText": "Chimpanzees are great climbers.",
      "audioFile": "pl_04_01d80fc.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2064,
      "updatedAt": "2026-09-04T18:05:07Z",
      "textHash": "eef692904bf2217ddfbe76fcd32774170900282a439a3e7e1876bc1fc896604c"
    },
    {
      "key": "01fe852",
      "nodeTitle": "elephant",
      "sourceText": "Ricordo tutto!",
      "sourceEnText": "I remember everything!",
      "audioFile": "pl_04_01fe852.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 1045,
      "updatedAt": "2026-09-04T18:05:44Z",
      "textHash": "24dbeaeb58a9e7d621d08678657f574bbb076baf2b4d347122c9aa2c1b749490"
    },
    {
      "key": "020100a",
      "nodeTitle": "penguin",
      "sourceText": "Proviamo a risolvere insieme il puzzle!",
      "sourceEnText": "Let's try to solve the puzzle together!",
      "audioFile": "pl_04_020100a.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2116,
      "updatedAt": "2026-09-04T18:05:52Z",
      "textHash": "288db65d4c9a386d5d7bf5f5caadc5d04035259b5a765124ada29f4af9060f0c"
    },
    {
      "key": "020c29f",
      "nodeTitle": "lion_kid",
      "sourceText": "I leoni sono i re della giungla!",
      "sourceEnText": "Lions are the kings of the jungle!",
      "audioFile": "pl_04_020c29f.mp3",
      "voiceProfile": "francesco",
      "actorId": "KID_F",
      "durationMs": 1881,
      "updatedAt": "2026-09-04T18:05:42Z",
      "textHash": "66354a831d9ffb46f0adadcb97e8a515bfc258e1fc7ffd3b99c4fd0159eb7a1c"
    },
    {
      "key": "027b51f",
      "nodeTitle": "elephant",
      "sourceText": "Sono il più grande ANIMALE terrestre.",
      "sourceEnText": "I am the biggest land ANIMAL.",
      "audioFile": "pl_04_027b51f.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2011,
      "updatedAt": "2026-09-04T18:03:18Z",
      "textHash": "d7c735ff8ca7d310d13b4da2c4b0424975e4ce7545efb28dd2df5a5236758410"
    },
    {
      "key": "02af551",
      "nodeTitle": "giraffe",
      "sourceText": "Puoi pulire la foto per me?",
      "sourceEnText": "Can you clean the picture for me?",
      "audioFile": "pl_04_02af551.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 1515,
      "updatedAt": "2026-09-04T18:05:50Z",
      "textHash": "de5baf3f6dd5d2cc1ff26de440b3b82840358800a858a00e535e832ed5c4631f"
    },
    {
      "key": "02b4a06",
      "nodeTitle": "lion_tutor",
      "sourceText": "I maschi adulti hanno la criniera.",
      "sourceEnText": "Adult males have manes.",
      "audioFile": "pl_04_02b4a06.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1829,
      "updatedAt": "2026-09-04T18:05:03Z",
      "textHash": "7658165cc9ad1bf642c56a5183020e34cf0270a16716dafde1acc17073e16575"
    },
    {
      "key": "02d00e2",
      "nodeTitle": "giraffe_activity_done",
      "sourceText": "Sono alto, ma non 90 metri come l'IGLICA!",
      "sourceEnText": "I'm tall, but not 90 meters like the IGLICA!",
      "audioFile": "pl_04_02d00e2.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2717,
      "updatedAt": "2026-09-04T18:04:23Z",
      "textHash": "f8b2146be0712a25ccf2fe11987738642b6b785507e46d8bacfcbf88247e1d5c"
    },
    {
      "key": "02f35e4",
      "nodeTitle": "director_task",
      "sourceText": "Si è svolto sulla Guglia nella SALA DEL CENTENARIO.",
      "sourceEnText": "It was on the IGLICA at CENTENNIAL HALL.",
      "audioFile": "pl_04_02f35e4.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 2664,
      "updatedAt": "2026-09-04T18:03:13Z",
      "textHash": "27e49fce059c56a456293a9086d193e2e3af5bf9edbeb1b6e0240a1d7d5c9daf"
    },
    {
      "key": "032811f",
      "nodeTitle": "director_task_done",
      "sourceText": "Hai parlato con tutti gli ANIMALI.",
      "sourceEnText": "You talked to all ANIMALS.",
      "audioFile": "pl_04_032811f.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 1881,
      "updatedAt": "2026-09-04T18:04:36Z",
      "textHash": "f737d5b3de17c0fb0c12f4d8ca36dc1a959408cb4bc54941bc76fcb182745c94"
    },
    {
      "key": "03321d5",
      "nodeTitle": "item_chest",
      "sourceText": "Hai trovato dei biscotti!",
      "sourceEnText": "You found some cookies!",
      "audioFile": "pl_04_03321d5.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1541,
      "updatedAt": "2026-09-04T18:04:02Z",
      "textHash": "05a00055b0d575c9b804b3373678f782c7c331b466558ce0fce1658b284283bb"
    },
    {
      "key": "0335bf7",
      "nodeTitle": "director_task",
      "sourceText": "È una sottile torre di metallo e un simbolo della nostra città.",
      "sourceEnText": "It is a thin metal tower and a symbol of our city.",
      "audioFile": "pl_04_0335bf7.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 3187,
      "updatedAt": "2026-09-04T18:05:17Z",
      "textHash": "a1e16f2ce88c6454844a313c61de29496e0d1e801fd21f7438ba5d4e7a766dd8"
    },
    {
      "key": "0354bea",
      "nodeTitle": "spawn_tourist",
      "sourceText": "Ci sono più di 10.000 ANIMALI qui.",
      "sourceEnText": "There are more than 10,000 ANIMALS here.",
      "audioFile": "pl_04_0354bea.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-09-04T18:05:26Z",
      "textHash": "896d4ca8ca61b244977d5c8ddbad0148da160aede6449ef923086a5d1276d4f6"
    },
    {
      "key": "0364f30",
      "nodeTitle": "director_task_done",
      "sourceText": "E non hanno preso la BANDIERA.",
      "sourceEnText": "And they didn't take the FLAG.",
      "audioFile": "pl_04_0364f30.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 1593,
      "updatedAt": "2026-09-04T18:04:38Z",
      "textHash": "09a0cbfd73ed5f78029229a218978b3998edcb3fa77b6f8544c684e5e40cb3ea"
    },
    {
      "key": "03a150c",
      "nodeTitle": "elephant",
      "sourceText": "Ho una MEMORIA fantastica.",
      "sourceEnText": "I have a great MEMORY.",
      "audioFile": "pl_04_03a150c.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 1593,
      "updatedAt": "2026-09-04T18:03:20Z",
      "textHash": "ca26be0e7c806e23328d0b0a1a7c039d1ac0f03788b2461a72613e2716ea31c7"
    },
    {
      "key": "03b36c0",
      "nodeTitle": "giraffe_tutor",
      "sourceText": "Le giraffe sono gli animali più alti.",
      "sourceEnText": "Giraffes are the tallest animals.",
      "audioFile": "pl_04_03b36c0.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2064,
      "updatedAt": "2026-09-04T18:04:58Z",
      "textHash": "7022487a1068b99d5f12e1acc627769b3e2044d77e02fbc42c176f6b367e4044"
    },
    {
      "key": "03c4553",
      "nodeTitle": "animal_fox",
      "sourceText": "Ehehe! In realtà non sono dello zoo.",
      "sourceEnText": "Hehe! I'm not actually from the zoo.",
      "audioFile": "pl_04_03c4553.mp3",
      "voiceProfile": "francesco",
      "actorId": "SPECIAL",
      "durationMs": 2612,
      "updatedAt": "2026-09-04T18:04:53Z",
      "textHash": "aa53ba35f83446306a316041904df44a9a8b070ecfb85115f87b1e79c06bc83f"
    },
    {
      "key": "04b42f2",
      "nodeTitle": "giraffe",
      "sourceText": "Adoro mangiare le foglie di ACAMICE!",
      "sourceEnText": "I love eating WATTLE leaves!",
      "audioFile": "pl_04_04b42f2.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2011,
      "updatedAt": "2026-09-04T18:03:30Z",
      "textHash": "42b0bf4ceab32b6267951b2fce2a8a7ce66ec82e8c7b8e3c4a7ce27d17904e52"
    },
    {
      "key": "04fff6b",
      "nodeTitle": "animal_peacock",
      "sourceText": "La mia coda è come una BANDIERA!",
      "sourceEnText": "My tail is like a FLAG!",
      "audioFile": "pl_04_04fff6b.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1724,
      "updatedAt": "2026-09-04T18:03:14Z",
      "textHash": "9dc3c293182926c1a2957cf3941bbb72526eec62e9acbc7d99e889d4d3a66dac"
    },
    {
      "key": "0540c5a",
      "nodeTitle": "penguin",
      "sourceText": "Non so VOLARE, ma NUOTO bene!",
      "sourceEnText": "I can't FLY, but I SWIM well!",
      "audioFile": "pl_04_0540c5a.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 1829,
      "updatedAt": "2026-09-04T18:03:55Z",
      "textHash": "5b15a44c248d95878958dd7212b6b510f4853d34ba12a2af8925022eb5c7de5e"
    },
    {
      "key": "054cc37",
      "nodeTitle": "quest_end",
      "sourceText": "Hai imparato a conoscere gli ANIMALI DELLO ZOO.",
      "sourceEnText": "You learned about ZOO ANIMALS.",
      "audioFile": "pl_04_054cc37.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2482,
      "updatedAt": "2026-09-04T18:04:46Z",
      "textHash": "188b7d9250f14fd56a88fe79b631536d428dcf5ac6995ca4add89ecc309eadee"
    },
    {
      "key": "05ac327",
      "nodeTitle": "penguin_kid",
      "sourceText": "Non potrei vivere sul ghiaccio!",
      "sourceEnText": "I couldn't live on ice!",
      "audioFile": "pl_04_05ac327.mp3",
      "voiceProfile": "francesco",
      "actorId": "KID_F",
      "durationMs": 1724,
      "updatedAt": "2026-09-04T18:04:00Z",
      "textHash": "45159651b5784d11bf095d5a9f98eaccd61aed5406c8bea41b314826268a2818"
    },
    {
      "key": "05da6d7",
      "nodeTitle": "lion_activity_done",
      "sourceText": "Ma non l'ho presa. Per favore, trova quella BANDIERA!",
      "sourceEnText": "But I didn't take it. Please find that FLAG!",
      "audioFile": "pl_04_05da6d7.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 3030,
      "updatedAt": "2026-09-04T18:04:24Z",
      "textHash": "9c72ddee6e053bb0d3a5e0818251acbe066412dca119374b2568ca73ec698ddb"
    },
    {
      "key": "0617de7",
      "nodeTitle": "monkey",
      "sourceText": "Riesci a indovinare su quale albero devo arrampicarmi per arrivare...",
      "sourceEnText": "Can you guess which tree I need to climb to get...",
      "audioFile": "pl_04_0617de7.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 3396,
      "updatedAt": "2026-09-04T18:05:20Z",
      "textHash": "fec6bedd7c48de5d9a714eae47b2739f76238ff18d0075a7a37f3eeaea8ec760"
    },
    {
      "key": "0694a4c",
      "nodeTitle": "spawn_tourist",
      "sourceText": "Mi sembra di aver visto da qualche parte uno scrigno del tesoro.",
      "sourceEnText": "I think I saw a treasure chest somewhere.",
      "audioFile": "pl_04_0694a4c.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2978,
      "updatedAt": "2026-09-04T18:05:47Z",
      "textHash": "1a41d1ddc65a2b0afb18b52df3ee127ec16cb1e64c3a42560259b54bd365dab9"
    },
    {
      "key": "06c3bba",
      "nodeTitle": "elephant_tutor",
      "sourceText": "Gli elefanti hanno la pelle spessa e le orecchie grandi.",
      "sourceEnText": "Elephants have thick skin and big ears.",
      "audioFile": "pl_04_06c3bba.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2717,
      "updatedAt": "2026-09-04T18:04:55Z",
      "textHash": "1b50465f1f89bab4333fcb5a1309f9387f13639a65294e2a84cbf119296181cd"
    },
    {
      "key": "074fe29",
      "nodeTitle": "animal_fox",
      "sourceText": "Non ho visto nessuna bandiera da nessuna parte.",
      "sourceEnText": "I didn't see a flag anywhere.",
      "audioFile": "pl_04_074fe29.mp3",
      "voiceProfile": "francesco",
      "actorId": "SPECIAL",
      "durationMs": 2612,
      "updatedAt": "2026-09-04T18:03:39Z",
      "textHash": "bdb62ee7bb3c55f82729105eea36f8f4033d03c50d01c8ffd3fc0da5364a48ad"
    },
    {
      "key": "0774b92",
      "nodeTitle": "lion",
      "sourceText": "Ora sono un LEONE adulto con una criniera magnifica.",
      "sourceEnText": "Now I'm an adult LION with a magnificent mane.",
      "audioFile": "pl_04_0774b92.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2795,
      "updatedAt": "2026-09-04T18:04:50Z",
      "textHash": "1c1b2def03265bd2743d7e4f77916905e3c19d2072dbd41ec067578e3941fcb6"
    },
    {
      "key": "078190f",
      "nodeTitle": "penguin_activity_done",
      "sourceText": "No, non ho preso la BANDIERA.",
      "sourceEnText": "No, I didn't take the FLAG.",
      "audioFile": "pl_04_078190f.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 1724,
      "updatedAt": "2026-09-04T18:04:31Z",
      "textHash": "77165a9e71fce4c29edd5f116f1a98acfed2d236142164c82fe0a072aaad6bd8"
    },
    {
      "key": "079451b",
      "nodeTitle": "monkey",
      "sourceText": "Abbina i frutti ai loro alberi!",
      "sourceEnText": "Match the fruits to their trees!",
      "audioFile": "pl_04_079451b.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 1724,
      "updatedAt": "2026-09-04T18:03:48Z",
      "textHash": "ff8a65ae7c742f2a65467f030f493e374570e6722ac222d0576c00436684e898"
    },
    {
      "key": "079f4e0",
      "nodeTitle": "lion_kid",
      "sourceText": "Che boato!",
      "sourceEnText": "What a roar!",
      "audioFile": "pl_04_079f4e0.mp3",
      "voiceProfile": "francesco",
      "actorId": "KID_F",
      "durationMs": 888,
      "updatedAt": "2026-09-04T18:03:37Z",
      "textHash": "f1f3cfadaa5321c0f583afb5f52c853fbdda63d7331fd16dbb6576d2773c3d49"
    },
    {
      "key": "07b60e7",
      "nodeTitle": "director",
      "sourceText": "Parla con tutti gli ANIMALI!",
      "sourceEnText": "Talk to all the ANIMALS!",
      "audioFile": "pl_04_07b60e7.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 1541,
      "updatedAt": "2026-09-04T18:05:54Z",
      "textHash": "2d9b8d7f619182e24e93b57790ed582b07b2ae8a4954a9b9f4a3b0a25f453ea3"
    },
    {
      "key": "07f2e15",
      "nodeTitle": "lion",
      "sourceText": "Sono un LEONE dall'AFRICA.",
      "sourceEnText": "I am a LION from AFRICA.",
      "audioFile": "pl_04_07f2e15.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 1515,
      "updatedAt": "2026-09-04T18:03:33Z",
      "textHash": "941a5140da0b4840d17e928ce36c0375d495d050419580638c3c309e6571aba3"
    },
    {
      "key": "0809ac5",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Disegna il tuo ANIMALE preferito o la CENTENNIAL HALL.",
      "sourceEnText": "Draw your favorite ANIMAL or the CENTENNIAL HALL.",
      "audioFile": "pl_04_0809ac5.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2952,
      "updatedAt": "2026-09-04T18:04:48Z",
      "textHash": "42d89fba999e9e0cb4ebee094289d7b3be09d46ce24b7de8ff2156d445e8c341"
    },
    {
      "key": "0810771",
      "nodeTitle": "item_chest",
      "sourceText": "Ora è vuoto.",
      "sourceEnText": "It's empty now.",
      "audioFile": "pl_04_0810771.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 940,
      "updatedAt": "2026-09-04T18:04:04Z",
      "textHash": "d3bb0a4aa967faf533c738ae5d2cd2efaff01af211d13b1377b77ec7fced62f4"
    },
    {
      "key": "0815405",
      "nodeTitle": "director_task",
      "sourceText": "Ciao, sono il direttore dello zoo.",
      "sourceEnText": "Hi, I am the Zoo Director.",
      "audioFile": "pl_04_0815405.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 1881,
      "updatedAt": "2026-09-04T18:05:36Z",
      "textHash": "5824ac3871567e93487bc97aecba260a2aa3d2e4285290170cddb3d482d53ff6"
    },
    {
      "key": "08568f5",
      "nodeTitle": "penguin_activity_done",
      "sourceText": "Ricordati, non so volare!",
      "sourceEnText": "Remember, I can't fly!",
      "audioFile": "pl_04_08568f5.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 1515,
      "updatedAt": "2026-09-04T18:04:33Z",
      "textHash": "245065bf4f8a38d7b362d3dbd2eab5cbfdc06e1301f42d85526748fedab2b66d"
    },
    {
      "key": "0867233",
      "nodeTitle": "monkey",
      "sourceText": "Sono uno SCIMPANZÉ. Mi arrampico sugli ALBERI.",
      "sourceEnText": "I am a CHIMPANZEE. I climb TREES.",
      "audioFile": "pl_04_0867233.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2795,
      "updatedAt": "2026-09-04T18:03:45Z",
      "textHash": "307b85ddecededcb8060d3ceca8716ff9967c90c1b1cd54a231171a495bbc5f3"
    },
    {
      "key": "0877d6f",
      "nodeTitle": "giraffe_activity_done",
      "sourceText": "Grazie. Non ho preso la BANDIERA.",
      "sourceEnText": "Thank you. I did not take the FLAG.",
      "audioFile": "pl_04_0877d6f.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2116,
      "updatedAt": "2026-09-04T18:04:21Z",
      "textHash": "c6ea573741a904f51a5333a06fcb77f440911cf329db1a924bb93776756b69ae"
    },
    {
      "key": "0883b4b",
      "nodeTitle": "monkey_tutor",
      "sourceText": "Mangiano molta frutta.",
      "sourceEnText": "They eat lots of fruit.",
      "audioFile": "pl_04_0883b4b.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 1306,
      "updatedAt": "2026-09-04T18:05:08Z",
      "textHash": "dde4831c26592b7e836e98f113ccafba5daf5198adf973dd6baed7d33773359f"
    },
    {
      "key": "08c70e8",
      "nodeTitle": "penguin",
      "sourceText": "Sono un PINGUINO, un UCCELLO speciale.",
      "sourceEnText": "I am a PENGUIN, a special BIRD.",
      "audioFile": "pl_04_08c70e8.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2534,
      "updatedAt": "2026-09-04T18:03:54Z",
      "textHash": "2c89c93da6674e9ee575050c03c94ab1b64e883121a4e3205d3d8712f3d0cd6f"
    },
    {
      "key": "08c7ea3",
      "nodeTitle": "monkey",
      "sourceText": "Un'arancia",
      "sourceEnText": "An orange",
      "audioFile": "pl_04_08c7ea3.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 862,
      "updatedAt": "2026-09-04T18:05:23Z",
      "textHash": "63d9b46ad541bb95d7df1620e1b038075fdef7b8f215bf295c26ca2b43086d78"
    },
    {
      "key": "091881b",
      "nodeTitle": "lion_tutor",
      "sourceText": "I leoni vivono in gruppi familiari.",
      "sourceEnText": "Lions live in family groups.",
      "audioFile": "pl_04_091881b.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-09-04T18:05:02Z",
      "textHash": "94b6f5a23dbe87aff9fffb2688a15b9ce0e5c3539fa61e43333aaa2d350a75d8"
    },
    {
      "key": "0920adc",
      "nodeTitle": "penguin_tutor",
      "sourceText": "I pinguini sono uccelli che sanno nuotare.",
      "sourceEnText": "Penguins are birds that can swim.",
      "audioFile": "pl_04_0920adc.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-09-04T18:05:11Z",
      "textHash": "98664bbe05f0378e0504acbea1b7f8fc148455a54c596b682e18476eaf893fed"
    },
    {
      "key": "095a71f",
      "nodeTitle": "lion",
      "sourceText": "Puoi mettere in ordine le mie foto?",
      "sourceEnText": "Can you put my pictures in order?",
      "audioFile": "pl_04_095a71f.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2011,
      "updatedAt": "2026-09-04T18:05:49Z",
      "textHash": "61a7f2261c17c6dc5b7d01ee35fb8a76df0f8a41a21cee0caae40b9e0be48161"
    },
    {
      "key": "09c6bf7",
      "nodeTitle": "director_task",
      "sourceText": "Manca la nostra BANDIERA!",
      "sourceEnText": "Our FLAG is missing!",
      "audioFile": "pl_04_09c6bf7.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 1463,
      "updatedAt": "2026-09-04T18:03:11Z",
      "textHash": "7b233d7bc506bb5e51d9e8601da8030d8975e97bc6c97563f2fc908f0258b3f3"
    },
    {
      "key": "0a3420c",
      "nodeTitle": "node",
      "sourceText": "Riesci a trovare il percorso in ICE?",
      "sourceEnText": "Can you find the path in ICE?",
      "audioFile": "pl_04_0a3420c.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1933,
      "updatedAt": "2026-09-04T18:03:57Z",
      "textHash": "ff9b8e121d6328c1d9cfed5a0546bb84a81ec6bd263062ed30d1abc47f254487"
    },
    {
      "key": "0a43c85",
      "nodeTitle": "monkey_activity_done",
      "sourceText": "Sarebbe divertente arrampicarsi su quel palo.",
      "sourceEnText": "It would be fun to climb that pole.",
      "audioFile": "pl_04_0a43c85.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2351,
      "updatedAt": "2026-09-04T18:04:29Z",
      "textHash": "6b9a5f3c4f88f88f00a56881cc30df98b28b059f6f0d5dfda3f67f261b04bf8d"
    },
    {
      "key": "0a4d24e",
      "nodeTitle": "giraffe",
      "sourceText": "Il mio lungo COLLO mi aiuta a raggiungere le foglie.",
      "sourceEnText": "My long NECK helps me reach leaves.",
      "audioFile": "pl_04_0a4d24e.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2612,
      "updatedAt": "2026-09-04T18:03:28Z",
      "textHash": "40f852b5a36c34a5d9f6e456ad1d827647dca0de3153082c3142af3838aeb587"
    },
    {
      "key": "0a93d9b",
      "nodeTitle": "task_animals_done",
      "sourceText": "Ora torniamo al DIRETTORE DELLO ZOO.",
      "sourceEnText": "Now go back to the ZOO DIRECTOR.",
      "audioFile": "pl_04_0a93d9b.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-09-04T18:04:35Z",
      "textHash": "70a409bf1769599fc9226b8cc98e3d0dddfc42b1e50b0ca7c81af2e06a0866e5"
    },
    {
      "key": "0ae73f3",
      "nodeTitle": "penguin_kid",
      "sourceText": "Preferisci volare o nuotare?",
      "sourceEnText": "Do you prefer to fly or swim?",
      "audioFile": "pl_04_0ae73f3.mp3",
      "voiceProfile": "francesco",
      "actorId": "KID_F",
      "durationMs": 1724,
      "updatedAt": "2026-09-04T18:03:59Z",
      "textHash": "27a2b8c7e9bc7a225602504fcc2669189f16a7f0cd1f96a3fa67c8dfe25d0b2f"
    },
    {
      "key": "0b3d05f",
      "nodeTitle": "jigsaw_zoo_done",
      "sourceText": "Aspetta, guarda!",
      "sourceEnText": "Wait, look!",
      "audioFile": "pl_04_0b3d05f.mp3",
      "voiceProfile": "francesco",
      "actorId": "NARRATOR",
      "durationMs": 1123,
      "updatedAt": "2026-09-04T18:04:43Z",
      "textHash": "ffa7fa87ee1bd265274f7720ced870b02fb36e10df8ca23440db40fb224a9af8"
    },
    {
      "key": "0b79d01",
      "nodeTitle": "elephant_activity_done",
      "sourceText": "LA BANDIERA? Non ce l'ho.",
      "sourceEnText": "THE FLAG? I don't have it.",
      "audioFile": "pl_04_0b79d01.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2429,
      "updatedAt": "2026-09-04T18:04:17Z",
      "textHash": "8d02c75073572beb9a114b19b953f4a9737d1538e06a2147f56ebdaceeb33945"
    },
    {
      "key": "0ba1a43",
      "nodeTitle": "penguin",
      "sourceText": "Adoro il GHIACCIO e il FREDDO.",
      "sourceEnText": "I love the ICE and the COLD.",
      "audioFile": "pl_04_0ba1a43.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 1933,
      "updatedAt": "2026-09-04T18:05:46Z",
      "textHash": "2e5f27f02e4c46e1674f11585b8e9f4c5f692ec76b28a5afc0a9c0a07eb27732"
    },
    {
      "key": "0baa8d0",
      "nodeTitle": "penguin_tutor",
      "sourceText": "Vivono vicino agli oceani e ai ghiacci.",
      "sourceEnText": "They live near oceans and ice.",
      "audioFile": "pl_04_0baa8d0.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-09-04T18:05:13Z",
      "textHash": "0715544deb493ad6f50116b1d9d287b2feceb0010aae4f00ef7a88df4b159eac"
    },
    {
      "key": "0bc2b46",
      "nodeTitle": "jigsaw_zoo_done",
      "sourceText": "Se tutti gli ANIMALI fossero innocenti...",
      "sourceEnText": "If all ANIMALS are innocent...",
      "audioFile": "pl_04_0bc2b46.mp3",
      "voiceProfile": "francesco",
      "actorId": "NARRATOR",
      "durationMs": 2351,
      "updatedAt": "2026-09-04T18:04:40Z",
      "textHash": "75c588d400085dbe1ed93b955aac128d975cc0ed35d75ea27a7e2e6a15766914"
    },
    {
      "key": "0bc4ca4",
      "nodeTitle": "elephant_tutor",
      "sourceText": "Sono gli animali terrestri più grandi.",
      "sourceEnText": "They are the largest land animals.",
      "audioFile": "pl_04_0bc4ca4.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2116,
      "updatedAt": "2026-09-04T18:04:56Z",
      "textHash": "a0dc700839eaf6997371551cd060f0911633c0720f2ce8811e7cb4d0a6c79ec2"
    },
    {
      "key": "0bc6238",
      "nodeTitle": "director_task_done",
      "sourceText": "Torniamo alla Centennial Hall.",
      "sourceEnText": "Let's go back to the Centennial Hall.",
      "audioFile": "pl_04_0bc6238.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 1646,
      "updatedAt": "2026-09-04T18:05:15Z",
      "textHash": "381c49336203bef2ca2ef7b207434ff16a4e8f95d8b1fbaee4a872f057a159dd"
    },
    {
      "key": "0bcc257",
      "nodeTitle": "quest_end",
      "sourceText": "Questa missione è completata.",
      "sourceEnText": "This quest is complete.",
      "audioFile": "pl_04_0bcc257.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1646,
      "updatedAt": "2026-09-04T18:04:44Z",
      "textHash": "347fa0a3379db961e6d749c05f376343acd807b9a4a23285a0ca25f3e22e33dd"
    },
    {
      "key": "0bee484",
      "nodeTitle": "giraffe_kid",
      "sourceText": "Con un COLLO così, potrei vedere casa mia da qui!",
      "sourceEnText": "With a NECK like that, I could see my house from here!",
      "audioFile": "pl_04_0bee484.mp3",
      "voiceProfile": "francesco",
      "actorId": "KID_F",
      "durationMs": 2429,
      "updatedAt": "2026-09-04T18:03:32Z",
      "textHash": "65ded639ed22821b05ff5ec40afb3ca19ec91ffe1ece14484c952379b28317c2"
    },
    {
      "key": "0bf024f",
      "nodeTitle": "jigsaw_zoo_done",
      "sourceText": "Il mistero è risolto.",
      "sourceEnText": "The mystery is solved.",
      "audioFile": "pl_04_0bf024f.mp3",
      "voiceProfile": "francesco",
      "actorId": "NARRATOR",
      "durationMs": 1358,
      "updatedAt": "2026-09-04T18:05:18Z",
      "textHash": "3aff5ce43492896255f2e924b552302e1b4d7899eda29fb793814a4b46e30217"
    },
    {
      "key": "0bf2346",
      "nodeTitle": "monkey_kid",
      "sourceText": "Gli scimpanzé hanno lunghe braccia per dondolarsi sugli alberi.",
      "sourceEnText": "CHIMPANZEES have long arms for swinging in trees.",
      "audioFile": "pl_04_0bf2346.mp3",
      "voiceProfile": "francesco",
      "actorId": "KID_F",
      "durationMs": 3318,
      "updatedAt": "2026-09-04T18:03:50Z",
      "textHash": "330f67bb8945990261dd83f4ee6bead26a48b8592fd5d05c58a343634258a639"
    },
    {
      "key": "0c53945",
      "nodeTitle": "monkey_activity_done",
      "sourceText": "Ma non ho preso la BANDIERA!",
      "sourceEnText": "But I didn't take the FLAG!",
      "audioFile": "pl_04_0c53945.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 1646,
      "updatedAt": "2026-09-04T18:04:28Z",
      "textHash": "759390416d66f7ff3c561a2bf7e09632b78469eb02f63b6b2d1a4e1c2674f938"
    },
    {
      "key": "0c6c41a",
      "nodeTitle": "monkey",
      "sourceText": "Una mela",
      "sourceEnText": "An apple",
      "audioFile": "pl_04_0c6c41a.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 758,
      "updatedAt": "2026-09-04T18:05:21Z",
      "textHash": "bf27372690c301c32a056752fdc56434001a1cd39f8b4167260cadbe292b5474"
    },
    {
      "key": "0c71176",
      "nodeTitle": "director_task",
      "sourceText": "Oggi abbiamo un problema.",
      "sourceEnText": "Today we have a problem.",
      "audioFile": "pl_04_0c71176.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 1463,
      "updatedAt": "2026-09-04T18:04:51Z",
      "textHash": "25421b206a918a968518001be5c1b1d30808ff9aee6524b2d1a42b0f2b02b097"
    },
    {
      "key": "0cda3c2",
      "nodeTitle": "monkey_tutor",
      "sourceText": "Ogni frutto cresce su un albero diverso.",
      "sourceEnText": "Each fruit grows on a different tree.",
      "audioFile": "pl_04_0cda3c2.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 2194,
      "updatedAt": "2026-09-04T18:05:10Z",
      "textHash": "d1e441ddd777a9463364822bcb639e314e2ec4f6055581879e26b068beba9d63"
    },
    {
      "key": "0ce7b11",
      "nodeTitle": "monkey",
      "sourceText": "E una banana?",
      "sourceEnText": "And a banana?",
      "audioFile": "pl_04_0ce7b11.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 993,
      "updatedAt": "2026-09-04T18:05:24Z",
      "textHash": "71a799f7b53edc2d3a840bc024dcbc96ecfd0ad834c2fde32867a35077ed049a"
    },
    {
      "key": "0d378cc",
      "nodeTitle": "lion_tutor",
      "sourceText": "Ma i cuccioli no.",
      "sourceEnText": "But young cubs don't.",
      "audioFile": "pl_04_0d378cc.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1097,
      "updatedAt": "2026-09-04T18:05:05Z",
      "textHash": "689cdc3215f27836af2bedf5a6d4b69788e7b68b1146d8db9381baf7fe235635"
    },
    {
      "key": "0d5c607",
      "nodeTitle": "giraffe",
      "sourceText": "Io sono l'ANIMALE più alto.",
      "sourceEnText": "I am the tallest ANIMAL.",
      "audioFile": "pl_04_0d5c607.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 1593,
      "updatedAt": "2026-09-04T18:03:27Z",
      "textHash": "687d09e23b42300c783e151f3904848d15248e88ac1b93264e654da47bfcb1d0"
    },
    {
      "key": "0d80278",
      "nodeTitle": "spawn_tourist",
      "sourceText": "Questo zoo è molto grande.",
      "sourceEnText": "This zoo is very big.",
      "audioFile": "pl_04_0d80278.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1515,
      "updatedAt": "2026-09-04T18:05:28Z",
      "textHash": "05e7bc4c7a49f477bbedd9d833c266c732feecc3d9ec2072b74985b6003a53e6"
    },
    {
      "key": "0d91701",
      "nodeTitle": "jigsaw_zoo_done",
      "sourceText": "Ora la BANDIERA è tornata.",
      "sourceEnText": "Now the FLAG is back.",
      "audioFile": "pl_04_0d91701.mp3",
      "voiceProfile": "francesco",
      "actorId": "NARRATOR",
      "durationMs": 1593,
      "updatedAt": "2026-09-04T18:04:07Z",
      "textHash": "c8acd91a4211d508fafaabfe4053c9a883a29658ffa64edf028a75df3415279e"
    },
    {
      "key": "0d9d52f",
      "nodeTitle": "giraffe_tutor",
      "sourceText": "Hanno colli lunghi per mangiare le foglie degli alberi alti.",
      "sourceEnText": "They have long necks to eat leaves from tall trees.",
      "audioFile": "pl_04_0d9d52f.mp3",
      "voiceProfile": "francesco",
      "actorId": "SENIOR_M",
      "durationMs": 3030,
      "updatedAt": "2026-09-04T18:05:00Z",
      "textHash": "e36745737c2bbe562c99a1a3a7425a7b4afcc8b235ebf16736d9ad7ae6b239de"
    },
    {
      "key": "0da284c",
      "nodeTitle": "director_task",
      "sourceText": "Trova la BANDIERA. Parla con gli ANIMALI.",
      "sourceEnText": "Find the FLAG. Talk to the ANIMALS.",
      "audioFile": "pl_04_0da284c.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 2429,
      "updatedAt": "2026-09-04T18:04:09Z",
      "textHash": "9074bf9e30f218862146559de3810996554d0278fd17d0d9d57f43fc201661f8"
    },
    {
      "key": "0e24973",
      "nodeTitle": "jigsaw_zoo_done",
      "sourceText": "Antura ha la BANDIERA!",
      "sourceEnText": "Antura has the FLAG!",
      "audioFile": "pl_04_0e24973.mp3",
      "voiceProfile": "francesco",
      "actorId": "NARRATOR",
      "durationMs": 1463,
      "updatedAt": "2026-09-04T18:04:06Z",
      "textHash": "05ac2b92788b6bf4769599a96c5c73af9b831cc37e55ebce8504a58be41b3b1e"
    },
    {
      "key": "0e84545",
      "nodeTitle": "animal_parrot",
      "sourceText": "Squawk! Adoro il rosso e il giallo!",
      "sourceEnText": "Squawk! I love red and yellow!",
      "audioFile": "pl_04_0e84545.mp3",
      "voiceProfile": "francesco",
