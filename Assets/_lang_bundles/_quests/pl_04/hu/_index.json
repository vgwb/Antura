{
  "version": "1",
  "questId": "pl_04",
  "lang": "hu",
  "lines": [
    {
      "key": "001cba3",
      "nodeTitle": "director_task",
      "sourceText": "90 méter magas!",
      "sourceEnText": "It's 90 meters tall!",
      "audioFile": "pl_04_001cba3.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1411,
      "updatedAt": "2026-09-04T18:02:52Z",
      "textHash": "1bc97027a1df4c77685084876820bf8159ca55f759e9bca94d65b5c1d6f28d7c"
    },
    {
      "key": "004abc7",
      "nodeTitle": "elephant_kid",
      "sourceText": "Legyezgethetnek azok a fülek nyáron?",
      "sourceEnText": "Can those ears fan me in summer?",
      "audioFile": "pl_04_004abc7.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_F",
      "durationMs": 2116,
      "updatedAt": "2026-09-04T18:00:41Z",
      "textHash": "8d9dc3447e99dfad148189625e3d7b4e2a841f95d2a5b7ea7dce50ef07e250d5"
    },
    {
      "key": "005dd46",
      "nodeTitle": "quest_start",
      "sourceText": "Lengyelország legnagyobb állatkertje!",
      "sourceEnText": "The biggest zoo in Poland!",
      "audioFile": "pl_04_005dd46.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2247,
      "updatedAt": "2026-09-04T18:01:18Z",
      "textHash": "ecd3b3cab4d8ef3f9ddc87aa9ca57049537da2177776245ea74f546a9df9e9bb"
    },
    {
      "key": "0085a8a",
      "nodeTitle": "animal_peacock",
      "sourceText": "Nincs szükségem ZÁSZLÓRA.",
      "sourceEnText": "I don't need a FLAG.",
      "audioFile": "pl_04_0085a8a.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1698,
      "updatedAt": "2026-09-04T18:01:21Z",
      "textHash": "cbe776955445059904574e9eee5356dadaac46842807372f0060e5c055217086"
    },
    {
      "key": "0124e1c",
      "nodeTitle": "lion",
      "sourceText": "Amikor fiatal voltam, a szüleimmel éltem.",
      "sourceEnText": "When I was young, I lived with my parents.",
      "audioFile": "pl_04_0124e1c.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2534,
      "updatedAt": "2026-09-04T18:00:52Z",
      "textHash": "e9aea7f2d43863189d645c191940416b6e5815cd690837c9de9a1b54f70d359d"
    },
    {
      "key": "012b933",
      "nodeTitle": "director_task",
      "sourceText": "Talán valamelyiküknek megvan.",
      "sourceEnText": "Maybe one of them has it.",
      "audioFile": "pl_04_012b933.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1881,
      "updatedAt": "2026-09-04T18:01:19Z",
      "textHash": "3047be2209f1a04d82b787fe943ae14b2b91869af1a4b1f20f5c2fcc055dcce5"
    },
    {
      "key": "019539f",
      "nodeTitle": "lion",
      "sourceText": "Aztán felnőttem...",
      "sourceEnText": "Then I grew up...",
      "audioFile": "pl_04_019539f.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1280,
      "updatedAt": "2026-09-04T18:02:55Z",
      "textHash": "24159b8fb11e90f1ba3c452756ddaac12ea7025a6c56c23fa8b58b6273fa65b5"
    },
    {
      "key": "01b3593",
      "nodeTitle": "lion_activity_done",
      "sourceText": "Szeretem nézni a zászlót ott fent az Iglicán.",
      "sourceEnText": "I love watching the flag up there on the Iglica.",
      "audioFile": "pl_04_01b3593.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2560,
      "updatedAt": "2026-09-04T18:01:31Z",
      "textHash": "308e71309ac27d5ec8bca33bc81dc6b1ab16307505f12054e252bd48194ce920"
    },
    {
      "key": "01d80fc",
      "nodeTitle": "monkey_tutor",
      "sourceText": "A csimpánzok nagyszerű mászók.",
      "sourceEnText": "Chimpanzees are great climbers.",
      "audioFile": "pl_04_01d80fc.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2064,
      "updatedAt": "2026-09-04T18:02:16Z",
      "textHash": "50ef95446aa28fcb91eb6a2cec8421550b25079b14d93fe203663563e9880c77"
    },
    {
      "key": "01fe852",
      "nodeTitle": "elephant",
      "sourceText": "Mindenre emlékszem!",
      "sourceEnText": "I remember everything!",
      "audioFile": "pl_04_01fe852.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1358,
      "updatedAt": "2026-09-04T18:02:59Z",
      "textHash": "ab17f2b5871d7f41f5d14d3324d8d1eb511173942722e1d4bb8e75df507bef62"
    },
    {
      "key": "020100a",
      "nodeTitle": "penguin",
      "sourceText": "Próbáljuk meg együtt megoldani a rejtvényt!",
      "sourceEnText": "Let's try to solve the puzzle together!",
      "audioFile": "pl_04_020100a.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2299,
      "updatedAt": "2026-09-04T18:03:07Z",
      "textHash": "e8c1f06d8c0a5feb56a0830ee72952c9c80b2c44890b3e8cca0ad9dfa90ad9be"
    },
    {
      "key": "020c29f",
      "nodeTitle": "lion_kid",
      "sourceText": "Az oroszlánok a dzsungel királyai!",
      "sourceEnText": "Lions are the kings of the jungle!",
      "audioFile": "pl_04_020c29f.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_F",
      "durationMs": 2194,
      "updatedAt": "2026-09-04T18:02:57Z",
      "textHash": "4dec60c85dfe07deaface9bc0a6d4a04b89f6b475baa4ebc8c19901b55a8f346"
    },
    {
      "key": "027b51f",
      "nodeTitle": "elephant",
      "sourceText": "Én vagyok a legnagyobb szárazföldi ÁLLAT.",
      "sourceEnText": "I am the biggest land ANIMAL.",
      "audioFile": "pl_04_027b51f.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2351,
      "updatedAt": "2026-09-04T18:00:34Z",
      "textHash": "f619b8ee436b9af5842d0d34f855f56c5f028602b2e419edcb31648e22e6f2c2"
    },
    {
      "key": "02af551",
      "nodeTitle": "giraffe",
      "sourceText": "Megtisztítanád nekem a képet?",
      "sourceEnText": "Can you clean the picture for me?",
      "audioFile": "pl_04_02af551.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1829,
      "updatedAt": "2026-09-04T18:03:05Z",
      "textHash": "530d21e66a1cae5927c083467360509ba5f9b36409c093ef11cd8361b028227f"
    },
    {
      "key": "02b4a06",
      "nodeTitle": "lion_tutor",
      "sourceText": "A felnőtt hímeknek sörényük van.",
      "sourceEnText": "Adult males have manes.",
      "audioFile": "pl_04_02b4a06.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2011,
      "updatedAt": "2026-09-04T18:02:13Z",
      "textHash": "edc04ba8534b6130b30b834740265319e826af721d31aa1f1935da02e9eeb30e"
    },
    {
      "key": "02d00e2",
      "nodeTitle": "giraffe_activity_done",
      "sourceText": "Magas vagyok, de nem 90 méteres, mint az IGLICA!",
      "sourceEnText": "I'm tall, but not 90 meters like the IGLICA!",
      "audioFile": "pl_04_02d00e2.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2769,
      "updatedAt": "2026-09-04T18:01:27Z",
      "textHash": "92a7248399ac2f2f02c60fb1ebcbcde1b6b6ab995ed94544c354be91dfc5ef8b"
    },
    {
      "key": "02f35e4",
      "nodeTitle": "director_task",
      "sourceText": "A CENTENÁRIUM TEREMÉBEN a Tornyon került sor.",
      "sourceEnText": "It was on the IGLICA at CENTENNIAL HALL.",
      "audioFile": "pl_04_02f35e4.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 2900,
      "updatedAt": "2026-09-04T18:00:29Z",
      "textHash": "36a79d93dacac892a27fa9335ebfba0bbfa69f7cedbc8db77da7a148959a249e"
    },
    {
      "key": "032811f",
      "nodeTitle": "director_task_done",
      "sourceText": "Minden állattal beszéltél.",
      "sourceEnText": "You talked to all ANIMALS.",
      "audioFile": "pl_04_032811f.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1698,
      "updatedAt": "2026-09-04T18:01:41Z",
      "textHash": "a55eec1508b411a577be54cf45a220032ccbfa9cf5296c9b3cb5834850876ffc"
    },
    {
      "key": "03321d5",
      "nodeTitle": "item_chest",
      "sourceText": "Találtál pár sütit!",
      "sourceEnText": "You found some cookies!",
      "audioFile": "pl_04_03321d5.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1358,
      "updatedAt": "2026-09-04T18:02:01Z",
      "textHash": "5bbfcb29550ba13323e0aa0838b8fff4ad138dc7908498b19c15621fe31a9e9b"
    },
    {
      "key": "0335bf7",
      "nodeTitle": "director_task",
      "sourceText": "Vékony fém torony, városunk jelképe.",
      "sourceEnText": "It is a thin metal tower and a symbol of our city.",
      "audioFile": "pl_04_0335bf7.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 2194,
      "updatedAt": "2026-09-04T18:02:26Z",
      "textHash": "481402fe5e809a11271898fa8bbdbb218229eec43dc79119b09a1ccc7fae92b4"
    },
    {
      "key": "0354bea",
      "nodeTitle": "spawn_tourist",
      "sourceText": "Több mint 10 000 állat él itt.",
      "sourceEnText": "There are more than 10,000 ANIMALS here.",
      "audioFile": "pl_04_0354bea.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-09-04T18:02:41Z",
      "textHash": "90b34bcb01c38dca48a5f3ec4fcadb64435bed8ec7f8a5272b31ac56b5080b8f"
    },
    {
      "key": "0364f30",
      "nodeTitle": "director_task_done",
      "sourceText": "És nem vitték el a FLAG-ot.",
      "sourceEnText": "And they didn't take the FLAG.",
      "audioFile": "pl_04_0364f30.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1698,
      "updatedAt": "2026-09-04T18:01:42Z",
      "textHash": "5f3d2c0fdc03d9a312ef49f354c1b6e386f2a0cf8f2185f49fe4912a259d594c"
    },
    {
      "key": "03a150c",
      "nodeTitle": "elephant",
      "sourceText": "Nagyszerű EMLÉKEZETEM van.",
      "sourceEnText": "I have a great MEMORY.",
      "audioFile": "pl_04_03a150c.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1698,
      "updatedAt": "2026-09-04T18:00:36Z",
      "textHash": "09cb0146aa117a8aaefd5a592626d2dd3d1b0ed1a798289ff765a7e168f7be71"
    },
    {
      "key": "03b36c0",
      "nodeTitle": "giraffe_tutor",
      "sourceText": "A zsiráfok a legmagasabb állatok.",
      "sourceEnText": "Giraffes are the tallest animals.",
      "audioFile": "pl_04_03b36c0.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2142,
      "updatedAt": "2026-09-04T18:02:07Z",
      "textHash": "ffc13074495eee414cd6b4ba5f7eea705574e20384279eefd139f609d44fcacc"
    },
    {
      "key": "03c4553",
      "nodeTitle": "animal_fox",
      "sourceText": "Hehe! Én igazából nem az állatkertből vagyok.",
      "sourceEnText": "Hehe! I'm not actually from the zoo.",
      "audioFile": "pl_04_03c4553.mp3",
      "voiceProfile": "shelley",
      "actorId": "SPECIAL",
      "durationMs": 2612,
      "updatedAt": "2026-09-04T18:01:58Z",
      "textHash": "4c389ff38c8643e1182b1670595276a624a936cdbcb001acd2776b4fdd96e81e"
    },
    {
      "key": "04b42f2",
      "nodeTitle": "giraffe",
      "sourceText": "Imádok enni WATTLE leveleket!",
      "sourceEnText": "I love eating WATTLE leaves!",
      "audioFile": "pl_04_04b42f2.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1776,
      "updatedAt": "2026-09-04T18:00:46Z",
      "textHash": "04525be4ed3ef361cb36e3339992c042145edecda4345717737a5d779c51d9e9"
    },
    {
      "key": "04fff6b",
      "nodeTitle": "animal_peacock",
      "sourceText": "A farkam olyan, mint egy ZÁSZLÓ!",
      "sourceEnText": "My tail is like a FLAG!",
      "audioFile": "pl_04_04fff6b.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1933,
      "updatedAt": "2026-09-04T18:00:31Z",
      "textHash": "3c76c803ada407b680f21e11b70634af91c5bdbf63c974852435393778640f55"
    },
    {
      "key": "0540c5a",
      "nodeTitle": "penguin",
      "sourceText": "Repülni nem tudok, de jól úszom!",
      "sourceEnText": "I can't FLY, but I SWIM well!",
      "audioFile": "pl_04_0540c5a.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1881,
      "updatedAt": "2026-09-04T18:01:04Z",
      "textHash": "53ce62a7ef1321654a60865df5ad5ce1f4a5cb1ec0b891d78c417a81e69ef1a5"
    },
    {
      "key": "054cc37",
      "nodeTitle": "quest_end",
      "sourceText": "Tanultál az állatkerti állatokról.",
      "sourceEnText": "You learned about ZOO ANIMALS.",
      "audioFile": "pl_04_054cc37.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-09-04T18:01:51Z",
      "textHash": "c3216a107211f6ff80f7fd5ec59ea1104c73c1c88ac1e879cda9069682de5332"
    },
    {
      "key": "05ac327",
      "nodeTitle": "penguin_kid",
      "sourceText": "Nem tudnék jégen élni!",
      "sourceEnText": "I couldn't live on ice!",
      "audioFile": "pl_04_05ac327.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_F",
      "durationMs": 1698,
      "updatedAt": "2026-09-04T18:01:09Z",
      "textHash": "78360044426c0948c1782b732a9448c1fa1b5ed181094546952115c5a7e074e2"
    },
    {
      "key": "05da6d7",
      "nodeTitle": "lion_activity_done",
      "sourceText": "De nem vittem el. Kérlek, keresd meg azt a ZÁSZLÓT!",
      "sourceEnText": "But I didn't take it. Please find that FLAG!",
      "audioFile": "pl_04_05da6d7.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2717,
      "updatedAt": "2026-09-04T18:01:29Z",
      "textHash": "781e574ef18d012ee017e32b0ccffcd80b7ecb3ee7ef7d8bf81b0ca319c2495e"
    },
    {
      "key": "0617de7",
      "nodeTitle": "monkey",
      "sourceText": "Kitalálod, melyik fára kell felmásznom, hogy...",
      "sourceEnText": "Can you guess which tree I need to climb to get...",
      "audioFile": "pl_04_0617de7.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2560,
      "updatedAt": "2026-09-04T18:02:30Z",
      "textHash": "fd25daf5286921897df741c080d328b2dcffe3d3edb9f44688ea98d4bf93e8f7"
    },
    {
      "key": "0694a4c",
      "nodeTitle": "spawn_tourist",
      "sourceText": "Azt hiszem, láttam valahol egy kincsesládát.",
      "sourceEnText": "I think I saw a treasure chest somewhere.",
      "audioFile": "pl_04_0694a4c.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2482,
      "updatedAt": "2026-09-04T18:03:02Z",
      "textHash": "bb1185e60db157507ec32e97532f13063f2f15a8cff8e500f06700ebe5e8955a"
    },
    {
      "key": "06c3bba",
      "nodeTitle": "elephant_tutor",
      "sourceText": "Az elefántoknak vastag bőrük és nagy füleik vannak.",
      "sourceEnText": "Elephants have thick skin and big ears.",
      "audioFile": "pl_04_06c3bba.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3082,
      "updatedAt": "2026-09-04T18:02:04Z",
      "textHash": "7e7f2f60ae69189faeadcb34aba125e6a359de41208d6bd5d7beb7acbbcc9cdb"
    },
    {
      "key": "074fe29",
      "nodeTitle": "animal_fox",
      "sourceText": "Sehol sem láttam zászlót.",
      "sourceEnText": "I didn't see a flag anywhere.",
      "audioFile": "pl_04_074fe29.mp3",
      "voiceProfile": "shelley",
      "actorId": "SPECIAL",
      "durationMs": 1646,
      "updatedAt": "2026-09-04T18:01:59Z",
      "textHash": "f0820900fafa7edb3b6f2d86228e649cbe40a7580d6a4721e156dd817e8a8e39"
    },
    {
      "key": "0774b92",
      "nodeTitle": "lion",
      "sourceText": "Most már egy felnőtt OROSZLÁN vagyok, pompás sörénnyel.",
      "sourceEnText": "Now I'm an adult LION with a magnificent mane.",
      "audioFile": "pl_04_0774b92.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 3082,
      "updatedAt": "2026-09-04T18:01:54Z",
      "textHash": "90aafba023d5f9729182ae5f2066922439c59b4c37baddec7cce6023267bd481"
    },
    {
      "key": "078190f",
      "nodeTitle": "penguin_activity_done",
      "sourceText": "Nem, nem én vittem el a FLAG-ot.",
      "sourceEnText": "No, I didn't take the FLAG.",
      "audioFile": "pl_04_078190f.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1881,
      "updatedAt": "2026-09-04T18:01:36Z",
      "textHash": "b0ef64c80b8ad5316a0797f0aaecc4abedf460077836ddd168d32edcdf45f0bd"
    },
    {
      "key": "079451b",
      "nodeTitle": "monkey",
      "sourceText": "Párosítsd a gyümölcsöket a fáikkal!",
      "sourceEnText": "Match the fruits to their trees!",
      "audioFile": "pl_04_079451b.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2351,
      "updatedAt": "2026-09-04T18:00:58Z",
      "textHash": "b589a8436174be638a7b0167fc2ead5001360034a31d6cc95236e18b53ff14c8"
    },
    {
      "key": "079f4e0",
      "nodeTitle": "lion_kid",
      "sourceText": "Micsoda ordítás!",
      "sourceEnText": "What a roar!",
      "audioFile": "pl_04_079f4e0.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_F",
      "durationMs": 1176,
      "updatedAt": "2026-09-04T18:00:53Z",
      "textHash": "107ae1de7523640ea3b3a4d9b403d9414c713cafc961eb199222dd8fe4af16cd"
    },
    {
      "key": "07b60e7",
      "nodeTitle": "director",
      "sourceText": "Beszélj az összes ÁLLATTAL!",
      "sourceEnText": "Talk to all the ANIMALS!",
      "audioFile": "pl_04_07b60e7.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1776,
      "updatedAt": "2026-09-04T18:03:09Z",
      "textHash": "adbfe80638b6b3bd9c32f265a9cc84f1748d620f7ef73ecf8226fbc75bea1f18"
    },
    {
      "key": "07f2e15",
      "nodeTitle": "lion",
      "sourceText": "Oroszlán vagyok Afrikából.",
      "sourceEnText": "I am a LION from AFRICA.",
      "audioFile": "pl_04_07f2e15.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1541,
      "updatedAt": "2026-09-04T18:00:50Z",
      "textHash": "ab56f856c65f739d5fae51c07768d651558d3c8dda2bc4eda870906539a57f2f"
    },
    {
      "key": "0809ac5",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Rajzold le a kedvenc állatodat, vagy a SZÁZADIK ÉVFORDULÓS CSARNOKOT.",
      "sourceEnText": "Draw your favorite ANIMAL or the CENTENNIAL HALL.",
      "audioFile": "pl_04_0809ac5.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 4232,
      "updatedAt": "2026-09-04T18:01:53Z",
      "textHash": "1cefce2e9279557828afdf997dae7456deffc7535a691fa2d54e7f09f851b7c2"
    },
    {
      "key": "0810771",
      "nodeTitle": "item_chest",
      "sourceText": "Most üres.",
      "sourceEnText": "It's empty now.",
      "audioFile": "pl_04_0810771.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1097,
      "updatedAt": "2026-09-04T18:02:02Z",
      "textHash": "ba682d6e21ae6b08ce0420a1ef2741639077da7fde6782109d562e56a0f6e0b7"
    },
    {
      "key": "0815405",
      "nodeTitle": "director_task",
      "sourceText": "Sziasztok, én vagyok az állatkert igazgatója.",
      "sourceEnText": "Hi, I am the Zoo Director.",
      "audioFile": "pl_04_0815405.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 2560,
      "updatedAt": "2026-09-04T18:02:51Z",
      "textHash": "a1a62e992ea0e7cecb87d173616a26bc8b1bd174f2e920bb244bca512bc95d41"
    },
    {
      "key": "08568f5",
      "nodeTitle": "penguin_activity_done",
      "sourceText": "Ne feledd, én nem tudok repülni!",
      "sourceEnText": "Remember, I can't fly!",
      "audioFile": "pl_04_08568f5.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1776,
      "updatedAt": "2026-09-04T18:01:38Z",
      "textHash": "14b339f4a6edf1c5f2ee083d870bd939e9da8a66be9396a5f569c713835ca9bb"
    },
    {
      "key": "0867233",
      "nodeTitle": "monkey",
      "sourceText": "CSIMPÁNZ vagyok. FÁKRA mászok.",
      "sourceEnText": "I am a CHIMPANZEE. I climb TREES.",
      "audioFile": "pl_04_0867233.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2194,
      "updatedAt": "2026-09-04T18:00:55Z",
      "textHash": "75fdf2dc78f35a4f5f6b06a562daf4e8e73cf6dc50e70b2b9d36bd30cfc9ca93"
    },
    {
      "key": "0877d6f",
      "nodeTitle": "giraffe_activity_done",
      "sourceText": "Köszönöm. Nem vittem el a FLAG-et.",
      "sourceEnText": "Thank you. I did not take the FLAG.",
      "audioFile": "pl_04_0877d6f.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1829,
      "updatedAt": "2026-09-04T18:01:26Z",
      "textHash": "79655867382fa154a16f6cb164621d4cb5d7e7c833215c57eed69ae5b797f6ec"
    },
    {
      "key": "0883b4b",
      "nodeTitle": "monkey_tutor",
      "sourceText": "Sok gyümölcsöt esznek.",
      "sourceEnText": "They eat lots of fruit.",
      "audioFile": "pl_04_0883b4b.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1541,
      "updatedAt": "2026-09-04T18:02:18Z",
      "textHash": "990cfffb0a81ad76b14dfc8f6862f9e000285396d27288519590b825a0ee6415"
    },
    {
      "key": "08c70e8",
      "nodeTitle": "penguin",
      "sourceText": "PINGVIN vagyok, egy különleges MADÁR.",
      "sourceEnText": "I am a PENGUIN, a special BIRD.",
      "audioFile": "pl_04_08c70e8.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2299,
      "updatedAt": "2026-09-04T18:01:03Z",
      "textHash": "6e285c633074d52a0842226509aa6ac501b172a8d3d36608324a1a4a0d936118"
    },
    {
      "key": "08c7ea3",
      "nodeTitle": "monkey",
      "sourceText": "Egy narancs",
      "sourceEnText": "An orange",
      "audioFile": "pl_04_08c7ea3.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 940,
      "updatedAt": "2026-09-04T18:02:33Z",
      "textHash": "bed6da5af3ee53a30b3d17e675284e65445ccdaae99c142cea16b4c7b15ad3a9"
    },
    {
      "key": "091881b",
      "nodeTitle": "lion_tutor",
      "sourceText": "Az oroszlánok családi csoportokban élnek.",
      "sourceEnText": "Lions live in family groups.",
      "audioFile": "pl_04_091881b.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2534,
      "updatedAt": "2026-09-04T18:02:11Z",
      "textHash": "aa3b8e09d294da5528e70e8c771fb64dbf4a6fc60d28e57cf10e4f2e0978aac9"
    },
    {
      "key": "0920adc",
      "nodeTitle": "penguin_tutor",
      "sourceText": "A pingvinek olyan madarak, amelyek tudnak úszni.",
      "sourceEnText": "Penguins are birds that can swim.",
      "audioFile": "pl_04_0920adc.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2952,
      "updatedAt": "2026-09-04T18:02:21Z",
      "textHash": "55406918b1ffcb6ccde4c0132139f98919c6e8781bf83e4e901cc60dacf70f12"
    },
    {
      "key": "095a71f",
      "nodeTitle": "lion",
      "sourceText": "Sorrendbe tudnád rakni a képeimet?",
      "sourceEnText": "Can you put my pictures in order?",
      "audioFile": "pl_04_095a71f.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2064,
      "updatedAt": "2026-09-04T18:03:04Z",
      "textHash": "13d3a907baed90e82b1e194d9abc6f8affc9cd125b062ba112c381a2b8a52c90"
    },
    {
      "key": "09c6bf7",
      "nodeTitle": "director_task",
      "sourceText": "A ZÁSZLÓNK hiányzik!",
      "sourceEnText": "Our FLAG is missing!",
      "audioFile": "pl_04_09c6bf7.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1593,
      "updatedAt": "2026-09-04T18:00:27Z",
      "textHash": "f6be9524564abb67d9c314bc52e3f59fd4c67ed8d04c6974ff4eebccd2b3fea4"
    },
    {
      "key": "0a3420c",
      "nodeTitle": "node",
      "sourceText": "Megtalálod az utat az ICE-ban?",
      "sourceEnText": "Can you find the path in ICE?",
      "audioFile": "pl_04_0a3420c.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1829,
      "updatedAt": "2026-09-04T18:01:06Z",
      "textHash": "81bbc0a25a588ee181642cc308740ef82491e0b72d4bce0bfcc1ddfc0a090f48"
    },
    {
      "key": "0a43c85",
      "nodeTitle": "monkey_activity_done",
      "sourceText": "Jó móka lenne megmászni azt a rudat.",
      "sourceEnText": "It would be fun to climb that pole.",
      "audioFile": "pl_04_0a43c85.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2116,
      "updatedAt": "2026-09-04T18:01:34Z",
      "textHash": "2eaca9e8f06e269bfa9b552b00f9b79d2e1a3b334030f496c9f3daddee14b605"
    },
    {
      "key": "0a4d24e",
      "nodeTitle": "giraffe",
      "sourceText": "A hosszú NYAKAM segít elérni a leveleket.",
      "sourceEnText": "My long NECK helps me reach leaves.",
      "audioFile": "pl_04_0a4d24e.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2377,
      "updatedAt": "2026-09-04T18:00:45Z",
      "textHash": "7168deb615d22f172437bdcf1e6c358533356481bb4713151e9883f6fff2c4d2"
    },
    {
      "key": "0a93d9b",
      "nodeTitle": "task_animals_done",
      "sourceText": "Most menj vissza az ÁLLATKERT IGAZGATÓJÁHOZ.",
      "sourceEnText": "Now go back to the ZOO DIRECTOR.",
      "audioFile": "pl_04_0a93d9b.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2664,
      "updatedAt": "2026-09-04T18:01:39Z",
      "textHash": "e57fd529dc2752a2428b0a8124ec7f06c38a9dd176787c0d3fe266afc05f8f13"
    },
    {
      "key": "0ae73f3",
      "nodeTitle": "penguin_kid",
      "sourceText": "Repülni vagy úszni szeretsz jobban?",
      "sourceEnText": "Do you prefer to fly or swim?",
      "audioFile": "pl_04_0ae73f3.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_F",
      "durationMs": 1959,
      "updatedAt": "2026-09-04T18:01:08Z",
      "textHash": "a4a21d4229ff799e07f2b8eac22259b8b95bf8a29876ad18942dc0f56b520d7b"
    },
    {
      "key": "0b3d05f",
      "nodeTitle": "jigsaw_zoo_done",
      "sourceText": "Várj, nézd!",
      "sourceEnText": "Wait, look!",
      "audioFile": "pl_04_0b3d05f.mp3",
      "voiceProfile": "shelley",
      "actorId": "NARRATOR",
      "durationMs": 940,
      "updatedAt": "2026-09-04T18:01:47Z",
      "textHash": "ff0edbf7ef37a79fac43029756003fe82a0de10bde72de3b3f717c9aa7ad791f"
    },
    {
      "key": "0b79d01",
      "nodeTitle": "elephant_activity_done",
      "sourceText": "A ZÁSZLÓ? Nincs nálam.",
      "sourceEnText": "THE FLAG? I don't have it.",
      "audioFile": "pl_04_0b79d01.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1646,
      "updatedAt": "2026-09-04T18:01:23Z",
      "textHash": "49da975a8ae837ec7249a92bec8f51cd65f5642cd6389770192207a7529b3fe5"
    },
    {
      "key": "0ba1a43",
      "nodeTitle": "penguin",
      "sourceText": "Imádom a JEGET és a HIDEGET.",
      "sourceEnText": "I love the ICE and the COLD.",
      "audioFile": "pl_04_0ba1a43.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1698,
      "updatedAt": "2026-09-04T18:03:00Z",
      "textHash": "5367916bedb7a30636abd3ce6c7713586a98d87bd20bb5c2d73cf76269cb2c01"
    },
    {
      "key": "0baa8d0",
      "nodeTitle": "penguin_tutor",
      "sourceText": "Óceánok és jég közelében élnek.",
      "sourceEnText": "They live near oceans and ice.",
      "audioFile": "pl_04_0baa8d0.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2142,
      "updatedAt": "2026-09-04T18:02:23Z",
      "textHash": "6958e5df22d1f1c8e7f61637e0daf21f8c2c3dba3b980f7e285f238311e94d5d"
    },
    {
      "key": "0bc2b46",
      "nodeTitle": "jigsaw_zoo_done",
      "sourceText": "Ha minden állat ártatlan...",
      "sourceEnText": "If all ANIMALS are innocent...",
      "audioFile": "pl_04_0bc2b46.mp3",
      "voiceProfile": "shelley",
      "actorId": "NARRATOR",
      "durationMs": 1593,
      "updatedAt": "2026-09-04T18:01:44Z",
      "textHash": "d892b62482c844282c769f03c9dfdfe09128e04ad7013b22f8bb3de02168e54c"
    },
    {
      "key": "0bc4ca4",
      "nodeTitle": "elephant_tutor",
      "sourceText": "Ők a legnagyobb szárazföldi állatok.",
      "sourceEnText": "They are the largest land animals.",
      "audioFile": "pl_04_0bc4ca4.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2064,
      "updatedAt": "2026-09-04T18:02:06Z",
      "textHash": "1af377f127553d31ea06befeb76d5b3260363db7ea3b9323be7eea1a7a6c8c7c"
    },
    {
      "key": "0bc6238",
      "nodeTitle": "director_task_done",
      "sourceText": "Térjünk vissza a Centennial Hallba.",
      "sourceEnText": "Let's go back to the Centennial Hall.",
      "audioFile": "pl_04_0bc6238.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 2299,
      "updatedAt": "2026-09-04T18:02:25Z",
      "textHash": "57c9f680f30cf0530f7a85b748ba74c551302e11f3bec239cadfc098a66518c6"
    },
    {
      "key": "0bcc257",
      "nodeTitle": "quest_end",
      "sourceText": "Ez a küldetés teljesítve.",
      "sourceEnText": "This quest is complete.",
      "audioFile": "pl_04_0bcc257.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1933,
      "updatedAt": "2026-09-04T18:01:49Z",
      "textHash": "cdfe13143ddf94e7cc7baca8670e84e801a8568c137b11cbdbda52e08360ccee"
    },
    {
      "key": "0bee484",
      "nodeTitle": "giraffe_kid",
      "sourceText": "Egy ilyen NYAKKAL innen már a házamat is láthatnám!",
      "sourceEnText": "With a NECK like that, I could see my house from here!",
      "audioFile": "pl_04_0bee484.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_F",
      "durationMs": 2717,
      "updatedAt": "2026-09-04T18:00:48Z",
      "textHash": "50429d878cb9d3d77b97363f54aca5da680fdf2d906657f907a1366d70d820de"
    },
    {
      "key": "0bf024f",
      "nodeTitle": "jigsaw_zoo_done",
      "sourceText": "A rejtély megoldódott.",
      "sourceEnText": "The mystery is solved.",
      "audioFile": "pl_04_0bf024f.mp3",
      "voiceProfile": "shelley",
      "actorId": "NARRATOR",
      "durationMs": 1515,
      "updatedAt": "2026-09-04T18:02:28Z",
      "textHash": "882d46bad4344ff2d03a7a7356fb0ea9f63c3d4a6ae926900aeac4e2a72b47e6"
    },
    {
      "key": "0bf2346",
      "nodeTitle": "monkey_kid",
      "sourceText": "A csimpánzoknak hosszú karjaik vannak, hogy a fákon hintázhassanak.",
      "sourceEnText": "CHIMPANZEES have long arms for swinging in trees.",
      "audioFile": "pl_04_0bf2346.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_F",
      "durationMs": 4023,
      "updatedAt": "2026-09-04T18:01:00Z",
      "textHash": "21679da45446fc4b3396f84905e78cdfd51e1d30c42084c196b6b6dc3af13d29"
    },
    {
      "key": "0c53945",
      "nodeTitle": "monkey_activity_done",
      "sourceText": "De én nem vittem el a ZÁSZLÓT!",
      "sourceEnText": "But I didn't take the FLAG!",
      "audioFile": "pl_04_0c53945.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1959,
      "updatedAt": "2026-09-04T18:01:32Z",
      "textHash": "b60f8bda0d8f5427019e0e2ab53432acee51b2902b2e0bb6a83c281c62bbdd6f"
    },
    {
      "key": "0c6c41a",
      "nodeTitle": "monkey",
      "sourceText": "Egy alma",
      "sourceEnText": "An apple",
      "audioFile": "pl_04_0c6c41a.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 940,
      "updatedAt": "2026-09-04T18:02:31Z",
      "textHash": "25d2253570811b4b638548021b848a3c6d3fb794a1db34e5b5538d98bf2542a3"
    },
    {
      "key": "0c71176",
      "nodeTitle": "director_task",
      "sourceText": "Ma van egy problémánk.",
      "sourceEnText": "Today we have a problem.",
      "audioFile": "pl_04_0c71176.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1463,
      "updatedAt": "2026-09-04T18:01:56Z",
      "textHash": "6b5ee882be313d0956b49096ff98c46af3bbfc40513654219a1fd8de92e23df7"
    },
    {
      "key": "0cda3c2",
      "nodeTitle": "monkey_tutor",
      "sourceText": "Minden gyümölcs más fán terem.",
      "sourceEnText": "Each fruit grows on a different tree.",
      "audioFile": "pl_04_0cda3c2.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1698,
      "updatedAt": "2026-09-04T18:02:19Z",
      "textHash": "162c8963e6699f834afe4df769e985d0c376ac7c842036e1b13381ae7102903c"
    },
    {
      "key": "0ce7b11",
      "nodeTitle": "monkey",
      "sourceText": "És egy banán?",
      "sourceEnText": "And a banana?",
      "audioFile": "pl_04_0ce7b11.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1123,
      "updatedAt": "2026-09-04T18:02:39Z",
      "textHash": "8b9ebd33e30013b9ce157db71a3f0dc09401a1366127332a7ee2144c3e3eebb8"
    },
    {
      "key": "0d378cc",
      "nodeTitle": "lion_tutor",
      "sourceText": "De a fiatal kölykök nem.",
      "sourceEnText": "But young cubs don't.",
      "audioFile": "pl_04_0d378cc.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1541,
      "updatedAt": "2026-09-04T18:02:15Z",
      "textHash": "032ae371f3fb3451b13ae3d13ad4cd5ca2764d792003468097e02dd1756c92e0"
    },
    {
      "key": "0d5c607",
      "nodeTitle": "giraffe",
      "sourceText": "Én vagyok a legmagasabb ÁLLAT.",
      "sourceEnText": "I am the tallest ANIMAL.",
      "audioFile": "pl_04_0d5c607.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2116,
      "updatedAt": "2026-09-04T18:00:43Z",
      "textHash": "31205dbc205cc1a200ed39b1955ad9cb22f57eccdf6a3fd04306591fc60ef5be"
    },
    {
      "key": "0d80278",
      "nodeTitle": "spawn_tourist",
      "sourceText": "Ez az állatkert nagyon nagy.",
      "sourceEnText": "This zoo is very big.",
      "audioFile": "pl_04_0d80278.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1541,
      "updatedAt": "2026-09-04T18:02:42Z",
      "textHash": "d89f241343b7c9f22aeee031538b7a3461c58c4870f574a636e9c68434d613ff"
    },
    {
      "key": "0d91701",
      "nodeTitle": "jigsaw_zoo_done",
      "sourceText": "Most visszatért a FLAG.",
      "sourceEnText": "Now the FLAG is back.",
      "audioFile": "pl_04_0d91701.mp3",
      "voiceProfile": "shelley",
      "actorId": "NARRATOR",
      "durationMs": 1411,
      "updatedAt": "2026-09-04T18:01:13Z",
      "textHash": "da53cffe9402479fb49bb5d07570b6e3e4641838e0e009b82a7911599f25aaf7"
    },
    {
      "key": "0d9d52f",
      "nodeTitle": "giraffe_tutor",
      "sourceText": "Hosszú nyakuk van, hogy magas fák leveleit egyék.",
      "sourceEnText": "They have long necks to eat leaves from tall trees.",
      "audioFile": "pl_04_0d9d52f.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2978,
      "updatedAt": "2026-09-04T18:02:09Z",
      "textHash": "2b4fae2dbb8e71b2104e183d43e6888753e7313001b611c5011148fb40a36a0a"
    },
    {
      "key": "0da284c",
      "nodeTitle": "director_task",
      "sourceText": "Keresd meg a ZÁSZLÓT. Beszélj az ÁLLATOKKAL.",
      "sourceEnText": "Find the FLAG. Talk to the ANIMALS.",
      "audioFile": "pl_04_0da284c.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 2612,
      "updatedAt": "2026-09-04T18:01:14Z",
      "textHash": "945cc93f09de8350070ce69f3494961b81a5f22a6113642ece3736ddd119c461"
    },
    {
      "key": "0e24973",
      "nodeTitle": "jigsaw_zoo_done",
      "sourceText": "Anturánál van a ZÁSZLÓ!",
      "sourceEnText": "Antura has the FLAG!",
