  "lines": [
    {
      "key": "0071a0d",
      "nodeTitle": "classroom_5",
      "sourceText": "Prends ta trousse et ton cahier.",
      "sourceEnText": "Take your pencil case and your notebook.",
      "audioFile": "fr_02_0071a0d.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1515,
      "updatedAt": "2026-08-24T18:21:31Z",
      "textHash": "68dbe9673bb8808c38bbcd5691c449b0e116888eeb285edb986ff9d04be254b6"
    },
    {
      "key": "008ffb5",
      "nodeTitle": "spawned_teacher",
      "sourceText": "Le midi, on peut manger à la cantine ou renter manger à la maison.",
      "sourceEnText": "At lunchtime, you can eat in the canteen or go home to eat.",
      "audioFile": "fr_02_008ffb5.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_M",
      "durationMs": 3030,
      "updatedAt": "2026-08-24T18:22:45Z",
      "textHash": "c3465640056ad355cce6bb6bed6114b67008d131eb2e5a2c9e947a2c1eb0ccc1"
    },
    {
      "key": "00e71a9",
      "nodeTitle": "task_classroom_desc",
      "sourceText": "Trouve ta classe.",
      "sourceEnText": "Find your class.",
      "audioFile": "fr_02_00e71a9.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1045,
      "updatedAt": "2026-08-24T18:22:03Z",
      "textHash": "86757cc9af51a7334619bc68e591edf1c281d9a684dd76706fd9c171ebc985f4"
    },
    {
      "key": "00f6294",
      "nodeTitle": "classroom_4",
      "sourceText": "Ta classe est toute proche !",
      "sourceEnText": "Your classroom is very close!",
      "audioFile": "fr_02_00f6294.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_F",
      "durationMs": 1411,
      "updatedAt": "2026-08-24T18:21:25Z",
      "textHash": "f3b3664fb1df1c361c241dcb78c16030a542958088a68aa54143dac5b7c1c867"
    },
    {
      "key": "00faf2f",
      "nodeTitle": "task_backpack_desc",
      "sourceText": "Trouve ton cartable pour pouvoir aller à l'école.",
      "sourceEnText": "Find your schoolbag so you can go to school.",
      "audioFile": "fr_02_00faf2f.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2795,
      "updatedAt": "2026-08-24T18:22:07Z",
      "textHash": "d99876b5a64a9894237815fce71bf5bc4595cc54a11484ba9c2529cba60493a5"
    },
    {
      "key": "014887e",
      "nodeTitle": "quest_start",
      "sourceText": "Bienvenue à Angers ! Angers est une ville située à l'Ouest de la France. Aujourd'hui, c'est le premier jour d'école ! C'est la rentrée des classes! ",
      "sourceEnText": "Welcome to Angers! Angers is a city in western France. Today is the first day of school! It's back to school!",
      "audioFile": "fr_02_014887e.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "NARRATOR",
      "durationMs": 9953,
      "updatedAt": "2026-08-24T18:20:29Z",
      "textHash": "71b5864cbd8d516a39dd918083f0948079d6bc30def98e3347513acadb82a1b2"
    },
    {
      "key": "01b23d9",
      "nodeTitle": "spawned_kid_m",
      "sourceText": "J'aime les mathématiques car j'adore faire des calculs.",
      "sourceEnText": "I like mathematics because I love doing calculations.",
      "audioFile": "fr_02_01b23d9.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_M",
      "durationMs": 2900,
      "updatedAt": "2026-08-24T18:22:32Z",
      "textHash": "2fe6c1c3ce531177f7a94946abd8cec10b29925c8d47400d015bc39cface5e7d"
    },
    {
      "key": "021132d",
      "nodeTitle": "school_canteen",
      "sourceText": "Bonjour ! Le midi, tu peux manger à la cantine ou à la maison.",
      "sourceEnText": "Hello! At lunchtime, you can eat at the canteen or at home.",
      "audioFile": "fr_02_021132d.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_F",
      "durationMs": 3605,
      "updatedAt": "2026-08-24T18:21:50Z",
      "textHash": "deac1281c6c3186aa859b37b447b9fb75d65c035cafe4eb08eca1c627a8e0c5b"
    },
    {
      "key": "022962d",
      "nodeTitle": "quest_end",
      "sourceText": "Le jeu est terminé ! Félicitations !",
      "sourceEnText": "The game is over! Congratulations!",
      "audioFile": "fr_02_022962d.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "NARRATOR",
      "durationMs": 2560,
      "updatedAt": "2026-08-24T18:22:17Z",
      "textHash": "c751912b500c63be4d835af731623421e60a29f32e2a3adf2901c4d2be6091b8"
    },
    {
      "key": "02797f8",
      "nodeTitle": "classroom_5",
      "sourceText": "Et voilà ! Voici ta classe. Bienvenue en CM2 !",
      "sourceEnText": "And there you have it! This is your class. Welcome to CM2!",
      "audioFile": "fr_02_02797f8.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 3187,
      "updatedAt": "2026-08-24T18:21:27Z",
      "textHash": "3d0455edf30076c80e472fed08862363969e94a523d13c662af8c55c07b8fa10"
    },
    {
      "key": "027d036",
      "nodeTitle": "spawned_kid_f",
      "sourceText": "Le matin et l'après-midi, il y a une récréation. Pendant la récréation, les enfants jouent sur la cour.",
      "sourceEnText": "In the morning and afternoon, there is a recess. During recess, the children play in the playground.",
      "audioFile": "fr_02_027d036.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_F",
      "durationMs": 6792,
      "updatedAt": "2026-08-24T18:22:25Z",
      "textHash": "087a9737022365417ba33a390c20a0d31b7c3ac2e6ac4d0450e38eb68b5d1aba"
    },
    {
      "key": "027eba1",
      "nodeTitle": "school_4",
      "sourceText": "Les élèves s'appellent des lycéens. Il y a trois classes au lycée.",
      "sourceEnText": "The students are called high school students. There are three classes in high school.",
      "audioFile": "fr_02_027eba1.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 3683,
      "updatedAt": "2026-08-24T18:20:49Z",
      "textHash": "cf58770504ef02401e7f395a4aeca6574c8eea81869be706eee6ce7815c1cbc1"
    },
    {
      "key": "028f2bf",
      "nodeTitle": "spawned_adult",
      "sourceText": "Il y a des vacances dans l’année scolaire.",
      "sourceEnText": "There are holidays during the school year.",
      "audioFile": "fr_02_028f2bf.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_M",
      "durationMs": 1881,
      "updatedAt": "2026-08-24T18:22:40Z",
      "textHash": "a85f78d9d9808746b0744813ba1cc11e4f392037a7d4ab268e856d946a96225e"
    },
    {
      "key": "02977c9",
      "nodeTitle": "school_charte",
      "sourceText": "À l’école, tout le monde est le bienvenu: les filles et les garçons,",
      "sourceEnText": "At school, everyone is welcome: girls and boys,",
      "audioFile": "fr_02_02977c9.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 3736,
      "updatedAt": "2026-08-24T18:21:53Z",
      "textHash": "bc78938da59f23bf144fe8841f1448a07ebe31c1f4559702ca61c0eb6e65ddb5"
    },
    {
      "key": "029fd9c",
      "nodeTitle": "classroom_2",
      "sourceText": "Le CE1 n'est pas ta classe. Tu es en CM2. Essaie encore!!",
      "sourceEnText": "First grade isn't your class. You're in fifth grade. Try again!",
      "audioFile": "fr_02_029fd9c.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 3683,
      "updatedAt": "2026-08-24T18:21:16Z",
      "textHash": "962d7668fb3b57d5782c1372475b3ee92e871cc25c61af6b5537c25a5f17ef8d"
    },
    {
      "key": "0365921",
      "nodeTitle": "classroom_5",
      "sourceText": "Tu vas faire des mathématiques. Tu vas apprendre à compter, calculer.",
      "sourceEnText": "You are going to do mathematics. You are going to learn to count, to calculate.",
      "audioFile": "fr_02_0365921.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 4650,
      "updatedAt": "2026-08-24T18:21:34Z",
      "textHash": "23f8dbaaf788ac6da6b294e37bef883a3c5cdd7891b5d1991e9944b5d3741c25"
    },
    {
      "key": "037e288",
      "nodeTitle": "spawned_adult",
      "sourceText": "En France, l'école commence en septembre et se termine en juin.",
      "sourceEnText": "In France, school starts in September and ends in June.",
      "audioFile": "fr_02_037e288.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_M",
      "durationMs": 3082,
      "updatedAt": "2026-08-24T18:22:38Z",
      "textHash": "e89bac624a9f073f509fbce9b3334432c7449f29215c175ee91fa6163524f973"
    },
    {
      "key": "038dacc",
      "nodeTitle": "quest_end",
      "sourceText": "C'est la rentrée!",
      "sourceEnText": "It's back to school!",
      "audioFile": "fr_02_038dacc.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "NARRATOR",
      "durationMs": 1097,
      "updatedAt": "2026-08-24T18:22:19Z",
      "textHash": "ab6928957976e1955d799d5cec6928679c1c42dc927d664419965b35a23c92ae"
    },
    {
      "key": "03ed76a",
      "nodeTitle": "task_find_school_done",
      "sourceText": "Tu as trouvé ton école !",
      "sourceEnText": "You've found your school!",
      "audioFile": "fr_02_03ed76a.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "NARRATOR",
      "durationMs": 1411,
      "updatedAt": "2026-08-24T18:22:05Z",
      "textHash": "5acff8e52c32fbb131648144a13ff4ede70fe903a741620ad46a0e7ad709c782"
    },
    {
      "key": "043653e",
      "nodeTitle": "node",
      "sourceText": "Bonjour ! Ici c'est la classe des CM1.",
      "sourceEnText": "Hello! This is the class CM1.",
      "audioFile": "fr_02_043653e.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2534,
      "updatedAt": "2026-08-24T18:22:48Z",
      "textHash": "270eb2725daa479d9dd85f0ab2b717735df57198cd5654e2afdec01b0fa00702"
    },
    {
      "key": "044385f",
      "nodeTitle": "school_2_welcome",
      "sourceText": "Tu as besoin de ta trousse, de tes crayons, de tes cahiers et de livres.",
      "sourceEnText": "You need your pencil case, your pencils, your notebooks and your books.",
      "audioFile": "fr_02_044385f.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 5486,
      "updatedAt": "2026-08-24T18:20:42Z",
      "textHash": "4179f491fa491aa635e89e2476341a424fae34b8a90e92f10fe0b9ed67d6946e"
    },
    {
      "key": "04a0e4b",
      "nodeTitle": "school_4",
      "sourceText": "Il y a quatre classe au collège: la 6ème, la 5ème, la 4ème et la 3 ème.",
      "sourceEnText": "There are four grades in middle school: 6th, 5th, 4th and 3rd.",
      "audioFile": "fr_02_04a0e4b.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 5120,
      "updatedAt": "2026-08-24T18:20:47Z",
      "textHash": "3316fb165513bf63140faad0f504db34a3e1d6c9eb3ff1241e523c0fd7601dcb"
    },
    {
      "key": "04da48b",
      "nodeTitle": "school_4_talk_man",
      "sourceText": "Ces livres sont utiles quand on apprend à lire. On apprend avec ces livres l'alphabet et les lettres.",
      "sourceEnText": "These books are useful when learning to read. You learn the alphabet and letters with these books.",
      "audioFile": "fr_02_04da48b.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 5695,
      "updatedAt": "2026-08-24T18:22:13Z",
      "textHash": "633eff6f1b1fb4c5f833cf28f04a3d73b04e1edd23dc3828a6d61e7aa0f73722"
    },
    {
      "key": "052d22a",
      "nodeTitle": "activity_match_geometry",
      "sourceText": "Remets dans l'ordre les lettres de l'alphabet pour écrire le mot ECOLE.",
      "sourceEnText": "Rearrange the letters of the alphabet to spell the word SCHOOL.",
      "audioFile": "fr_02_052d22a.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 4989,
      "updatedAt": "2026-08-24T18:21:36Z",
      "textHash": "c535f01d22181e3fa0e144bd32ddf853159226c3469078afca2f107d4b57b524"
    },
    {
      "key": "0532330",
      "nodeTitle": "classroom_4",
      "sourceText": "Le CM1 est la classe après le CE2.",
      "sourceEnText": "CM1 is the class after CE2.",
      "audioFile": "fr_02_0532330.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_F",
      "durationMs": 2247,
      "updatedAt": "2026-08-24T18:21:23Z",
      "textHash": "f7f9dbda634a73a2719f38e1f210891ae3fe71946d87838d548714bdde5a6b58"
    },
    {
      "key": "058ddbc",
      "nodeTitle": "task_find_classroom",
      "sourceText": "Cherche ta classe.",
      "sourceEnText": "Find your class.",
      "audioFile": "fr_02_058ddbc.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1045,
      "updatedAt": "2026-08-24T18:21:03Z",
      "textHash": "464b34ed99b451c75848c99b266ffc1997b69610a40f79d47c2221a4591b3704"
    },
    {
      "key": "0624437",
      "nodeTitle": "school_2_talk",
      "sourceText": "Et voilà ! Entre dans la salle de classe. ",
      "sourceEnText": "And there you go! Enter the classroom.",
      "audioFile": "fr_02_0624437.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-08-24T18:20:59Z",
      "textHash": "50a232a6366141e4619f657e386365f71e291754cdfd1095e6eb1514c138ec48"
    },
    {
      "key": "0630d14",
      "nodeTitle": "school_4",
      "sourceText": "Tu es trop jeune pour entrer au collège ou au lycée.",
      "sourceEnText": "You are too young to enter middle or high school.",
      "audioFile": "fr_02_0630d14.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2952,
      "updatedAt": "2026-08-24T18:20:51Z",
      "textHash": "e55a4e255c8bd8273965ff535ea1b598e39858173658367e8b20be7f3c147ce0"
    },
    {
      "key": "063e8e0",
      "nodeTitle": "quest_start",
      "sourceText": "La rentrée est toujours en septembre. Tu as 10 ans et tu rentres en classe de CM2.",
      "sourceEnText": "School starts again in September. You are 10 years old and you are going into CM2.",
      "audioFile": "fr_02_063e8e0.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "NARRATOR",
      "durationMs": 4807,
      "updatedAt": "2026-08-24T18:20:31Z",
      "textHash": "38d7c038991a2ccd73f73b6cf7b1c7ae9c2697d08fe54ee390edcd74e9b7ccc0"
    },
    {
      "key": "063f354",
      "nodeTitle": "task_backpack_done",
      "sourceText": "Bravo! Tu as écris le mot ECOLE. Tu peux entrer dans l'école.",
      "sourceEnText": "Well done! You wrote the word SCHOOL. You can go into the school.",
      "audioFile": "fr_02_063f354.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 3814,
      "updatedAt": "2026-08-24T18:21:44Z",
      "textHash": "d88d1f29ccc43699b5145bc4e77c4142d41f50552304c11284b4769e42dbc573"
    },
    {
      "key": "06478e9",
      "nodeTitle": "school_3",
      "sourceText": "Bonjour ! Ici c'est le collège. Les élèves ont entre 11 et 14 ans.",
      "sourceEnText": "Hello! This is the school. The students are between 11 and 14 years old.",
      "audioFile": "fr_02_06478e9.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_M",
      "durationMs": 4389,
      "updatedAt": "2026-08-24T18:20:44Z",
      "textHash": "cc99c48f2234ab5dbd07b703b039cccbac42c39af184b1589899dc98a560e505"
    },
    {
      "key": "0671097",
      "nodeTitle": "school_canteen",
      "sourceText": "Bon appétit!",
      "sourceEnText": "Enjoy your food!",
      "audioFile": "fr_02_0671097.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_F",
      "durationMs": 1045,
      "updatedAt": "2026-08-24T18:22:23Z",
      "textHash": "36e603cbde2e87ab65b3f12c7fd29b0ccb0977f071cbd490e8d93c533a7dfd11"
    },
    {
      "key": "068e48b",
      "nodeTitle": "classroom_1",
      "sourceText": "Ce n'est pas ta classe. Tu as 10 ans. Tu es donc en CM2. ",
      "sourceEnText": "This isn't your class. You're 10 years old. So you're in CM2.",
      "audioFile": "fr_02_068e48b.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 3370,
      "updatedAt": "2026-08-24T18:21:09Z",
      "textHash": "54fbdfbebaccbc3de6dcc949dddced0348c902a4d0f53ffec794d8b440301d8b"
    },
    {
      "key": "078fff9",
      "nodeTitle": "schools_activity_done",
      "sourceText": "Tiens! ",
      "sourceEnText": "Take it!",
      "audioFile": "fr_02_078fff9.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 627,
      "updatedAt": "2026-08-24T18:21:40Z",
      "textHash": "1dc73a486f5b471ba4ed9709365660ea9c3592a1c52691efe611aa098f0cd730"
    },
    {
      "key": "07e8390",
      "nodeTitle": "schools_activity_done",
      "sourceText": "Bravo!",
      "sourceEnText": "Well done!",
      "audioFile": "fr_02_07e8390.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 862,
      "updatedAt": "2026-08-24T18:21:42Z",
      "textHash": "428ec3588d9faeb450212b3934259e0e92deeb1104f4360fdd56873444745e5e"
    },
    {
      "key": "07ed07b",
      "nodeTitle": "school_1",
      "sourceText": "Tu es trop âgé. L'école élémentaire est à juste à côté. Les élèves ont entre 6 et 10 ans.",
      "sourceEnText": "You're too old. The elementary school is right next door. The students are between 6 and 10 years old.",
      "audioFile": "fr_02_07ed07b.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 4859,
      "updatedAt": "2026-08-24T18:20:37Z",
      "textHash": "2a1ad2bfa80be2f855254aa4484443fb77bf3c5277b8b6bffe09ce500a55a4fe"
    },
    {
      "key": "0879a44",
      "nodeTitle": "spawned_kid_f",
      "sourceText": "J'aime dessiner et colorier.",
      "sourceEnText": "I like to draw and color.",
      "audioFile": "fr_02_0879a44.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_F",
      "durationMs": 2247,
      "updatedAt": "2026-08-24T18:22:28Z",
      "textHash": "8f763b5cc00acb0af018fb199ba6fb2aef8a52e88712b0128e2d41036b6410e1"
    },
    {
      "key": "08b2774",
      "nodeTitle": "classroom_1",
      "sourceText": "C'est la classe de CP.",
      "sourceEnText": "This is the first grade class.",
      "audioFile": "fr_02_08b2774.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 1411,
      "updatedAt": "2026-08-24T18:21:05Z",
      "textHash": "2ac683c2e26591c6434e605e24afb1c056b1e5a2ef3e72c2f0ceae3c8984d16a"
    },
    {
      "key": "08f3ab2",
      "nodeTitle": "classroom_2",
      "sourceText": "C'est la classe de CE1. ",
      "sourceEnText": "This is the CE1 class.",
      "audioFile": "fr_02_08f3ab2.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1515,
      "updatedAt": "2026-08-24T18:21:14Z",
      "textHash": "da259a080631538d0e6f028fc250a71beaeb99e751c773796c7dcd7d5cf1219e"
    },
    {
      "key": "092b309",
      "nodeTitle": "school_2_welcome",
      "sourceText": "Bonjour ! Bienvenue ! Tu as trouvé ton école. Tu es à l'école élémentaire. Il y a 5 classes: CP, CE1, CE2, CM1 et CM2.",
      "sourceEnText": "Hello! Welcome! You've found your school. You're in elementary school. There are 5 classes: CP, CE1, CE2, CM1 and CM2.",
      "audioFile": "fr_02_092b309.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 8229,
      "updatedAt": "2026-08-24T18:20:38Z",
      "textHash": "dca2ca8d3b6b0999d09148c9bf46395a17e1986060325b90cf6a59665eca6502"
    },
    {
      "key": "092fccb",
      "nodeTitle": "school_4_talk_man",
      "sourceText": "Remets les classes dans l'ordre.",
      "sourceEnText": "Put the classes back in order.",
      "audioFile": "fr_02_092fccb.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1881,
      "updatedAt": "2026-08-24T18:21:58Z",
      "textHash": "4feabc50545387276d24baaedcbfd17e965a1c7274200d1455e81d5dab7273e7"
    },
    {
      "key": "093e91d",
      "nodeTitle": "task_class_done",
      "sourceText": "Tu peux t'installer à ta place. Voici ta table et ta chaise.",
      "sourceEnText": "You can take your seat. Here's your table and chair.",
      "audioFile": "fr_02_093e91d.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 3265,
      "updatedAt": "2026-08-24T18:21:46Z",
      "textHash": "5227eed3dcc0fc226850ed4de4f7f0dbe54020e17bfad176d24a7291387f20d5"
    },
    {
      "key": "094eace",
      "nodeTitle": "school_4_talk_man",
      "sourceText": "Mais d’abord, il faut le gagner !",
      "sourceEnText": "But first, you have to win it!",
      "audioFile": "fr_02_094eace.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1646,
      "updatedAt": "2026-08-24T18:22:00Z",
      "textHash": "68b8a299882f41e349ab34f2789aac837d09c3dbe967d97d30fd111e69902584"
    },
    {
      "key": "096b721",
      "nodeTitle": "school_1",
      "sourceText": "Bienvenue ! C'est une école maternelle. C'est une école pour les enfants de 3 à 5 ans. Il y a trois classe en maternelle: la classe des petits, la classe des moyens et les grands.",
      "sourceEnText": "Welcome! This is a preschool. It's a school for children aged 3 to 5. There are three classes in preschool: the youngest class, the middle class, and the oldest class.",
      "audioFile": "fr_02_096b721.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 9300,
      "updatedAt": "2026-08-24T18:20:35Z",
      "textHash": "39795184aae3049a26953fc41f7037e287f03e0dcb18d705383f17e912bc9685"
    },
    {
      "key": "0978619",
      "nodeTitle": "school_canteen",
      "sourceText": "Regarde le menu de la cantine.",
      "sourceEnText": "Look at the cafeteria menu.",
      "audioFile": "fr_02_0978619.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_F",
      "durationMs": 1593,
      "updatedAt": "2026-08-24T18:21:52Z",
      "textHash": "0853dc65727bde9a4d8ba0855a15ab72f06e493550665b497392b031a460162d"
    },
    {
      "key": "09ac4f1",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Dessine ta classe.",
      "sourceEnText": "Draw your classroom.",
      "audioFile": "fr_02_09ac4f1.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "NARRATOR",
      "durationMs": 1176,
      "updatedAt": "2026-08-24T18:22:21Z",
      "textHash": "f16b077fd92c7239ee3e77fbaadb4f658645afd81494f2e8f1ca1715a162b61a"
    },
    {
      "key": "09bfe7f",
      "nodeTitle": "classroom_1",
      "sourceText": "Les enfants commencent l’école primaire à 6 ans en CP.",
      "sourceEnText": "Children start primary school at age 6 in CP.",
      "audioFile": "fr_02_09bfe7f.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 2900,
      "updatedAt": "2026-08-24T18:21:07Z",
      "textHash": "5206bb37ea23b903e605d5ab52611a52c93ab130dba0551a449ba649da9dd93f"
    },
    {
      "key": "09c12ac",
      "nodeTitle": "school_charte",
      "sourceText": "peu importe leurs croyances.",
      "sourceEnText": "regardless of their beliefs.",
      "audioFile": "fr_02_09c12ac.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1541,
      "updatedAt": "2026-08-24T18:21:56Z",
      "textHash": "ea375aadc709d7217e81bd98b81d6e410c71f6117373722e7ec1b3f96571ba55"
    },
    {
      "key": "0a5c8f1",
      "nodeTitle": "activity_match_done",
      "sourceText": "Ce n'est pas tout à fait exact. Essaie encore!",
      "sourceEnText": "That's not entirely accurate. Try again!",
      "audioFile": "fr_02_0a5c8f1.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2534,
      "updatedAt": "2026-08-24T18:22:09Z",
      "textHash": "0411d94c71e0730ad9ffe154637e21863dbd2b43fb85ecb64cb613a52b8e9c99"
    },
    {
      "key": "0aeea98",
      "nodeTitle": "spawned_kid_m",
      "sourceText": "J'adore faire du sport avec ma classe. Parfois, on va à la piscine.",
      "sourceEnText": "I love doing sports with my class. Sometimes we go to the swimming pool.",
      "audioFile": "fr_02_0aeea98.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_M",
      "durationMs": 3500,
      "updatedAt": "2026-08-24T18:22:35Z",
      "textHash": "e52e2785c39e8c0c13ac5cf7467e49bd85e15a55b0a368abc44c6269de2f2d67"
    },
    {
      "key": "0b22d07",
      "nodeTitle": "school_4_talk_man",
      "sourceText": "Maintenant, cherche ton école !",
      "sourceEnText": "Now, find your school!",
      "audioFile": "fr_02_0b22d07.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 2194,
      "updatedAt": "2026-08-24T18:22:15Z",
      "textHash": "70903d0de88e34e5fe882c2ffe63a2e2b57ca1cc61993da4d194a4544e277458"
    },
    {
      "key": "0b411ce",
      "nodeTitle": "classroom_3",
      "sourceText": "Les élèves ont 8 ans.",
      "sourceEnText": "The students are 8 years old.",
      "audioFile": "fr_02_0b411ce.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1411,
      "updatedAt": "2026-08-24T18:21:20Z",
      "textHash": "c9defe76bb510f80e81ad4deb8cc2797ca0c9f82ce167791475d8ac1b7841cb1"
    },
    {
      "key": "0b43290",
      "nodeTitle": "task_backpack",
      "sourceText": "Peut-être que quelqu'un a pris ton livre.",
      "sourceEnText": "Maybe someone took your book.",
      "audioFile": "fr_02_0b43290.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1933,
      "updatedAt": "2026-08-24T18:20:57Z",
      "textHash": "03241c3eee3a4f63489d0202f9082b6338fcde66b13184e4b5465073f6c32e7e"
    },
    {
      "key": "0b82cb5",
      "nodeTitle": "spawned_kid_m",
      "sourceText": "Je joue au football avec mes copains sur la cour de récréation.",
      "sourceEnText": "I play football with my friends in the playground.",
      "audioFile": "fr_02_0b82cb5.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_M",
      "durationMs": 3082,
      "updatedAt": "2026-08-24T18:22:33Z",
      "textHash": "db97153d34bc296d3194793f6c4608af03269225a9df5f08f8ca962f9e0e5752"
    },
    {
      "key": "0b91268",
      "nodeTitle": "school_2_talk",
      "sourceText": "Entre ! Ta classe est au bout du couloir.",
      "sourceEnText": "Come in! Your classroom is at the end of the corridor.",
      "audioFile": "fr_02_0b91268.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2351,
      "updatedAt": "2026-08-24T18:21:01Z",
      "textHash": "4f26cccc0eaef7f2f0badea1604f11fcf80de8b1ae1ff55d9b651305cd52a764"
    },
    {
      "key": "0bce01a",
      "nodeTitle": "classroom_3",
      "sourceText": "Bonjour ! Ici c'est la classe de CE2.",
      "sourceEnText": "Hello! This is the CE2 class.",
      "audioFile": "fr_02_0bce01a.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2247,
      "updatedAt": "2026-08-24T18:21:18Z",
      "textHash": "c9feb1d8952b658d91b598addbec0a2e92c3f7b38b6a80e8de7fcd5bb4f18190"
    },
    {
      "key": "0c282e5",
      "nodeTitle": "task_backpack",
      "sourceText": "Va demander aux personnes autour de toi.",
      "sourceEnText": "Go ask the people around you.",
      "audioFile": "fr_02_0c282e5.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2952,
      "updatedAt": "2026-08-24T18:20:55Z",
      "textHash": "c039cf5d79fd921743e28d4945ba5a599fb5fef065d43d79011c733eb7c7db53"
    },
    {
      "key": "0c3b4fe",
      "nodeTitle": "school_4_talk_man",
      "sourceText": "Bonjour ! J'ai trouvé un cartable.",
      "sourceEnText": "Hello! I found a schoolbag.",
      "audioFile": "fr_02_0c3b4fe.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 2377,
      "updatedAt": "2026-08-24T18:20:53Z",
      "textHash": "9cce0697fe33abcd473713a69ee0c333284a26ee980ebe802875863ca1637e68"
    },
    {
      "key": "0ce9646",
      "nodeTitle": "school_4_talk_man",
      "sourceText": "C'est peut-être ton livre ?",
      "sourceEnText": "Is this perhaps your book?",
      "audioFile": "fr_02_0ce9646.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1306,
      "updatedAt": "2026-08-24T18:22:10Z",
      "textHash": "53cb6eeea077c3863e3584fa7bb37788266f95465f51fd3a3582addd60b6c318"
    },
    {
      "key": "0cee587",
      "nodeTitle": "spawned_kid_f",
      "sourceText": "J'aime la musique et chanter avec ma classe.",
      "sourceEnText": "I love music and singing with my class.",
      "audioFile": "fr_02_0cee587.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_F",
      "durationMs": 2351,
      "updatedAt": "2026-08-24T18:22:30Z",
      "textHash": "5222258696a1ab884cf72b596e2d3ecd80f3c54f4c3ab04f10421f94318d027f"
    },
    {
      "key": "0d88d5b",
      "nodeTitle": "spawned_teacher",
      "sourceText": "A l'école, on apprend à lire et écrire.",
      "sourceEnText": "At school, we learn to read and write.",
      "audioFile": "fr_02_0d88d5b.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_M",
      "durationMs": 2194,
      "updatedAt": "2026-08-24T18:22:47Z",
      "textHash": "b3e74cb62649f947eb4499a14ad8754d45005a3fbf22da1e9853a35b74675113"
    },
    {
      "key": "0d8d4aa",
      "nodeTitle": "spawned_adult",
      "sourceText": "A l'école, on apprend à lire, écrire, compter et parler de nouvelles langues.",
      "sourceEnText": "At school, we learn to read, write, count and speak new languages.",
      "audioFile": "fr_02_0d8d4aa.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_M",
      "durationMs": 5721,
      "updatedAt": "2026-08-24T18:22:41Z",
      "textHash": "8919396382c0eb29dd506b22b7566aecf1b31b23983f35a7803883018b1ea23a"
    },
    {
      "key": "0da284c",
      "nodeTitle": "task_find_school_desc",
      "sourceText": "Trouve ton école !",
      "sourceEnText": "Find your school!",
      "audioFile": "fr_02_0da284c.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "NARRATOR",
      "durationMs": 1097,
      "updatedAt": "2026-08-24T18:22:01Z",
      "textHash": "42ff85f66cc6746395a651429f474b568156d88a3c3ff5f7305083b9c453cb94"
    },
    {
      "key": "0dd7977",
      "nodeTitle": "school_2_welcome",
      "sourceText": "Mais tu as oublié de prendre ton cartable.",
      "sourceEnText": "But you forgot to take your schoolbag.",
      "audioFile": "fr_02_0dd7977.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2247,
      "updatedAt": "2026-08-24T18:20:40Z",
      "textHash": "bda235bf61bf0e7abe45ea356aba14f59bf71ef265d8d8e96ccec71be65d5161"
    },
    {
      "key": "0df97f8",
      "nodeTitle": "school_3",
      "sourceText": "Après le CM2, on entre au collège. Les élèves entrent au collège à 11 ans. Ils entrent en 6ème.",
      "sourceEnText": "After CM2, students enter middle school. They start middle school at age 11. They enter 6th grade.",
      "audioFile": "fr_02_0df97f8.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_M",
      "durationMs": 6792,
      "updatedAt": "2026-08-24T18:20:46Z",
      "textHash": "0af5ac00548c594a6b8d582ee6f97bb6c50110d8784e1bcaa0b60bab8cbffe2d"
    },
    {
      "key": "0e1ff90",
      "nodeTitle": "schools_activity_done",
      "sourceText": "Désolé ! Ce n'est pas la bonne réponse. Essaie encore.",
      "sourceEnText": "Sorry! That's not the right answer. Try again.",
      "audioFile": "fr_02_0e1ff90.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 3318,
      "updatedAt": "2026-08-24T18:21:11Z",
      "textHash": "770cb9fded0742b8ff7f274e8c392e94a7c5c3809679a768d7ddfebb020f0a80"
    },
    {
      "key": "0e3ad75",
      "nodeTitle": "task_backpack",
      "sourceText": "Cherche ton cartable et reviens ensuite me voir.",
      "sourceEnText": "Find your schoolbag and then come back to see me.",
      "audioFile": "fr_02_0e3ad75.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2377,
      "updatedAt": "2026-08-24T18:21:48Z",
      "textHash": "4e7f54ac240ad84687aef9f83205b83a0b54105cf298aeb64e5af6a0a3e42d7f"
    },
    {
      "key": "0e3f1fa",
      "nodeTitle": "activity_match_done",
      "sourceText": "Bravo ! tu as réussi! ",
      "sourceEnText": "Well done! You succeeded!",
      "audioFile": "fr_02_0e3f1fa.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1541,
      "updatedAt": "2026-08-24T18:21:38Z",
      "textHash": "13e62f725ad794ebee15054facbfca99606a7fac0894f42a407fdd565fc98d5f"
    },
    {
      "key": "0e4aa95",
      "nodeTitle": "classroom_3",
      "sourceText": "Ce n'est pas ta classe !",
      "sourceEnText": "This isn't your class!",
      "audioFile": "fr_02_0e4aa95.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1280,
      "updatedAt": "2026-08-24T18:21:21Z",
      "textHash": "3bba873000003b5a20e2720821021aa7f5f228181d7fac694c0da94427c92ae8"
    },
    {
      "key": "0f65a1b",
      "nodeTitle": "quest_start",
      "sourceText": "Cherche ton école et ta classe !",
      "sourceEnText": "Find your school and class!",
      "audioFile": "fr_02_0f65a1b.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "NARRATOR",
      "durationMs": 1541,
      "updatedAt": "2026-08-24T18:20:33Z",
      "textHash": "76141bb3fde0ec5158908290f5d8f6a981c7bcc22c5ec1bffc6429bafcda6d1a"
    },
    {
      "key": "0f6b039",
      "nodeTitle": "spawned_teacher",
      "sourceText": "Les cours ont lieu de 8h du matin à 16h de l'après-midi.",
      "sourceEnText": "Classes are held from 8 a.m. to 4 p.m.",
      "audioFile": "fr_02_0f6b039.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_M",
      "durationMs": 3448,
      "updatedAt": "2026-08-24T18:22:43Z",
      "textHash": "4b02c9cde92cdda49cba41b9f6fcd21d4f507ee23a378545eaf6345dcf17a858"
    },
    {
      "key": "0f8995f",
      "nodeTitle": "classroom_5",
      "sourceText": "La maîtresse et le maître sont là pour t'aider à apprendre.",
      "sourceEnText": "The teacher is there to help you learn.",
      "audioFile": "fr_02_0f8995f.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 3213,
      "updatedAt": "2026-08-24T18:21:33Z",
      "textHash": "3b74c8dbd913a31a2a5b530b3121b898a031779e5322447d5eddbd9b064bb9c4"
    },
    {
      "key": "0f90123",
      "nodeTitle": "classroom_5",
      "sourceText": "Installe toi à ta table.",
      "sourceEnText": "Take a seat at your table.",
      "audioFile": "fr_02_0f90123.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1541,
      "updatedAt": "2026-08-24T18:21:29Z",
      "textHash": "6f2bc15e2e523f448c00ac32ff8417b5aecd89eb1d78d4a7bfe4ddeb8039e5cf"
    }
  ]
}