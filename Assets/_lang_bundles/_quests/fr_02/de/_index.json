{
  "version": "1",
  "questId": "fr_02",
  "lang": "de",
  "lines": [
    {
      "key": "0071a0d",
      "nodeTitle": "classroom_5",
      "sourceText": "Nimm dein Federmäppchen und dein Notizbuch mit.",
      "sourceEnText": "Take your pencil case and your notebook.",
      "audioFile": "fr_02_0071a0d.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3318,
      "updatedAt": "2026-08-24T18:24:31Z",
      "textHash": "8012859de2b18e4d9b8b8cde32d22e27a3705d4d29dabcd11bc196209ed2ca73"
    },
    {
      "key": "008ffb5",
      "nodeTitle": "spawned_teacher",
      "sourceText": "Mittags können Sie in der Kantine essen oder nach Hause gehen und dort essen.",
      "sourceEnText": "At lunchtime, you can eat in the canteen or go home to eat.",
      "audioFile": "fr_02_008ffb5.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 5303,
      "updatedAt": "2026-08-24T18:26:01Z",
      "textHash": "fd120d44bb230e0d2e9fbc7573b87bedb579098df9bfb87287dcd29e87d45cc6"
    },
    {
      "key": "00e71a9",
      "nodeTitle": "task_classroom_desc",
      "sourceText": "Finde deinen Kurs.",
      "sourceEnText": "Find your class.",
      "audioFile": "fr_02_00e71a9.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_M",
      "durationMs": 1411,
      "updatedAt": "2026-08-24T18:25:13Z",
      "textHash": "90e430ca00ed52eaa297a51a2dab18e6bc07d5d70b3eeefea9673715a34717c2"
    },
    {
      "key": "00f6294",
      "nodeTitle": "classroom_4",
      "sourceText": "Ihr Klassenzimmer ist ganz in der Nähe!",
      "sourceEnText": "Your classroom is very close!",
      "audioFile": "fr_02_00f6294.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_F",
      "durationMs": 2534,
      "updatedAt": "2026-08-24T18:24:24Z",
      "textHash": "e6d08c7fa33e7bb72d52c9a4a812518da33fe5653953c6e87d119a73d58a0632"
    },
    {
      "key": "00faf2f",
      "nodeTitle": "task_backpack_desc",
      "sourceText": "Finde deine Schultasche, damit du zur Schule gehen kannst.",
      "sourceEnText": "Find your schoolbag so you can go to school.",
      "audioFile": "fr_02_00faf2f.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3370,
      "updatedAt": "2026-08-24T18:25:18Z",
      "textHash": "eac1c5520980fd65ff27f4d7b0d8525d1e7903319b44328dd4098be05ffb0e96"
    },
    {
      "key": "014887e",
      "nodeTitle": "quest_start",
      "sourceText": "Willkommen in Angers! Angers ist eine Stadt in Westfrankreich. Heute ist der erste Schultag! Es geht wieder los in der Schule!",
      "sourceEnText": "Welcome to Angers! Angers is a city in western France. Today is the first day of school! It's back to school!",
      "audioFile": "fr_02_014887e.mp3",
      "voiceProfile": "alice",
      "actorId": "NARRATOR",
      "durationMs": 7367,
      "updatedAt": "2026-08-24T18:23:10Z",
      "textHash": "3a59993bdf4b104f9303af50c1291ec1072b68782a133de6deb24558d5743721"
    },
    {
      "key": "01b23d9",
      "nodeTitle": "spawned_kid_m",
      "sourceText": "Ich mag Mathematik, weil ich gerne rechne.",
      "sourceEnText": "I like mathematics because I love doing calculations.",
      "audioFile": "fr_02_01b23d9.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 2429,
      "updatedAt": "2026-08-24T18:25:49Z",
      "textHash": "f107b63f749e22784f3c4bbaf2178175780384cef0e9e6ad73ed0db3987418e0"
    },
    {
      "key": "021132d",
      "nodeTitle": "school_canteen",
      "sourceText": "Hallo! Mittags können Sie in der Kantine oder zu Hause essen.",
      "sourceEnText": "Hello! At lunchtime, you can eat at the canteen or at home.",
      "audioFile": "fr_02_021132d.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_F",
      "durationMs": 3814,
      "updatedAt": "2026-08-24T18:24:57Z",
      "textHash": "2705b837359b4f6c69c7c9d68f0896bd09a882078b1fc15e7ae0171464bcb8ee"
    },
    {
      "key": "022962d",
      "nodeTitle": "quest_end",
      "sourceText": "Das Spiel ist vorbei! Herzlichen Glückwunsch!",
      "sourceEnText": "The game is over! Congratulations!",
      "audioFile": "fr_02_022962d.mp3",
      "voiceProfile": "alice",
      "actorId": "NARRATOR",
      "durationMs": 3030,
      "updatedAt": "2026-08-24T18:25:31Z",
      "textHash": "14d52d3cce07e42cf296c6aa7ae6a9896072aab81a3ef91b156af83cf207cf76"
    },
    {
      "key": "02797f8",
      "nodeTitle": "classroom_5",
      "sourceText": "Und da haben Sie es! Das ist Ihr Kurs. Willkommen bei CM2!",
      "sourceEnText": "And there you have it! This is your class. Welcome to CM2!",
      "audioFile": "fr_02_02797f8.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3553,
      "updatedAt": "2026-08-24T18:24:26Z",
      "textHash": "d324103cdd38ac677a447c8ca45ee81f7a142f22261737116517e958717f5a77"
    },
    {
      "key": "027d036",
      "nodeTitle": "spawned_kid_f",
      "sourceText": "Vormittags und nachmittags gibt es eine Pause. Während der Pause spielen die Kinder auf dem Spielplatz.",
      "sourceEnText": "In the morning and afternoon, there is a recess. During recess, the children play in the playground.",
      "audioFile": "fr_02_027d036.mp3",
      "voiceProfile": "alice",
      "actorId": "KID_F",
      "durationMs": 6139,
      "updatedAt": "2026-08-24T18:25:41Z",
      "textHash": "1ae15e0d7939fb471a9e3488a053347ad29472b3070081f4ede8115ff8eb29c7"
    },
    {
      "key": "027eba1",
      "nodeTitle": "school_4",
      "sourceText": "Die Schüler werden als Gymnasiasten bezeichnet. Das Gymnasium hat drei Klassenstufen.",
      "sourceEnText": "The students are called high school students. There are three classes in high school.",
      "audioFile": "fr_02_027eba1.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 5407,
      "updatedAt": "2026-08-24T18:23:38Z",
      "textHash": "95a092b992774a0e4e5fc1caa12cafb633e6224b4f506dbafd69211c0e04bb9d"
    },
    {
      "key": "028f2bf",
      "nodeTitle": "spawned_adult",
      "sourceText": "Es gibt Ferien während des Schuljahres.",
      "sourceEnText": "There are holidays during the school year.",
      "audioFile": "fr_02_028f2bf.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 2429,
      "updatedAt": "2026-08-24T18:25:56Z",
      "textHash": "411cd99aefa39cfad9f8761c58ae5f03c28791b3361e19665fc77601c618ff27"
    },
    {
      "key": "02977c9",
      "nodeTitle": "school_charte",
      "sourceText": "In der Schule ist jeder willkommen: Mädchen und Jungen.",
      "sourceEnText": "At school, everyone is welcome: girls and boys,",
      "audioFile": "fr_02_02977c9.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3370,
      "updatedAt": "2026-08-24T18:25:02Z",
      "textHash": "084fe8924a44404380c42d937cd2feb84e12fbca580f2424726cacbd1a801daa"
    },
    {
      "key": "029fd9c",
      "nodeTitle": "classroom_2",
      "sourceText": "Du bist nicht in der ersten Klasse. Du bist in der fünften Klasse. Versuch es nochmal!",
      "sourceEnText": "First grade isn't your class. You're in fifth grade. Try again!",
      "audioFile": "fr_02_029fd9c.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 4989,
      "updatedAt": "2026-08-24T18:24:09Z",
      "textHash": "e71eaa0634cd3a6e5db21c6ead8a3e93b96b8c8435d9c4d11c243f941fd77143"
    },
    {
      "key": "0365921",
      "nodeTitle": "classroom_5",
      "sourceText": "Du wirst Mathematik lernen. Du wirst lernen zu zählen und zu rechnen.",
      "sourceEnText": "You are going to do mathematics. You are going to learn to count, to calculate.",
      "audioFile": "fr_02_0365921.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 5068,
      "updatedAt": "2026-08-24T18:24:37Z",
      "textHash": "5650c58e193871813409b4daf9125cf4a8598e063f9dbf4d062c9fe15338578b"
    },
    {
      "key": "037e288",
      "nodeTitle": "spawned_adult",
      "sourceText": "In Frankreich beginnt die Schule im September und endet im Juni.",
      "sourceEnText": "In France, school starts in September and ends in June.",
      "audioFile": "fr_02_037e288.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 4049,
      "updatedAt": "2026-08-24T18:25:54Z",
      "textHash": "60b5be1e5eaad49a3e4d397185f27d1a12f0775cb34bff9c267c00f59c57a330"
    },
    {
      "key": "038dacc",
      "nodeTitle": "quest_end",
      "sourceText": "Die Schule beginnt wieder!",
      "sourceEnText": "It's back to school!",
      "audioFile": "fr_02_038dacc.mp3",
      "voiceProfile": "alice",
      "actorId": "NARRATOR",
      "durationMs": 1933,
      "updatedAt": "2026-08-24T18:25:33Z",
      "textHash": "51ea1d71c015b077484947aa27534c8fb59e4ce463e85872c3209abee0d76248"
    },
    {
      "key": "03ed76a",
      "nodeTitle": "task_find_school_done",
      "sourceText": "Du hast deine Schule gefunden!",
      "sourceEnText": "You've found your school!",
      "audioFile": "fr_02_03ed76a.mp3",
      "voiceProfile": "alice",
      "actorId": "NARRATOR",
      "durationMs": 2064,
      "updatedAt": "2026-08-24T18:25:16Z",
      "textHash": "59ae94f56fe272b2dc636e1b518ad9166280269a6f5ac0098ed69e541a0bf63c"
    },
    {
      "key": "043653e",
      "nodeTitle": "node",
      "sourceText": "Hallo! Dies ist die Klasse CM1.",
      "sourceEnText": "Hello! This is the class CM1.",
      "audioFile": "fr_02_043653e.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2612,
      "updatedAt": "2026-08-24T18:24:18Z",
      "textHash": "4bcb7fe2616ed3fca992b4f64e4f9adacb0928f8533e0ff7661b57b328a506c7"
    },
    {
      "key": "044385f",
      "nodeTitle": "school_2_welcome",
      "sourceText": "Du brauchst dein Federmäppchen, deine Stifte, deine Notizbücher und deine Bücher.",
      "sourceEnText": "You need your pencil case, your pencils, your notebooks and your books.",
      "audioFile": "fr_02_044385f.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 5642,
      "updatedAt": "2026-08-24T18:23:29Z",
      "textHash": "c74eaa7b953a2a2b170f8aab239bd843f2241772baa3db8be797a004f9d34627"
    },
    {
      "key": "04a0e4b",
      "nodeTitle": "school_4",
      "sourceText": "Die Mittelschule ist in vier Klassenstufen unterteilt: 6., 5., 4. und 3.",
      "sourceEnText": "There are four grades in middle school: 6th, 5th, 4th and 3rd.",
      "audioFile": "fr_02_04a0e4b.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 5904,
      "updatedAt": "2026-08-24T18:23:36Z",
      "textHash": "7fff764ae7e0120f24a2aa5754c3fc1e07b6b914f28d46bcdf7642b9c152c9f3"
    },
    {
      "key": "04da48b",
      "nodeTitle": "school_4_talk_man",
      "sourceText": "Diese Bücher sind hilfreich beim Lesenlernen. Mit ihnen lernt man das Alphabet und die Buchstaben.",
      "sourceEnText": "These books are useful when learning to read. You learn the alphabet and letters with these books.",
      "audioFile": "fr_02_04da48b.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_M",
      "durationMs": 6191,
      "updatedAt": "2026-08-24T18:25:26Z",
      "textHash": "09816df6db0d468c4782fa56c188d589daa00eca7b2a4bedb91b857b096fe105"
    },
    {
      "key": "052d22a",
      "nodeTitle": "activity_match_geometry",
      "sourceText": "Ordne die Buchstaben des Alphabets so an, dass das Wort SCHOOL entsteht.",
      "sourceEnText": "Rearrange the letters of the alphabet to spell the word SCHOOL.",
      "audioFile": "fr_02_052d22a.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 5042,
      "updatedAt": "2026-08-24T18:24:40Z",
      "textHash": "645e0efdb788256f4929bc85932468ab1595551ae713d3420158d6da888ebb33"
    },
    {
      "key": "0532330",
      "nodeTitle": "classroom_4",
      "sourceText": "CM1 ist die Klasse nach CE2.",
      "sourceEnText": "CM1 is the class after CE2.",
      "audioFile": "fr_02_0532330.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_F",
      "durationMs": 2482,
      "updatedAt": "2026-08-24T18:24:21Z",
      "textHash": "d669eee8e8092a314e6ebf8c6908acbfbf4b723aaef1e0869827680f60be92b7"
    },
    {
      "key": "058ddbc",
      "nodeTitle": "task_find_classroom",
      "sourceText": "Finde deinen Kurs.",
      "sourceEnText": "Find your class.",
      "audioFile": "fr_02_058ddbc.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_M",
      "durationMs": 1463,
      "updatedAt": "2026-08-24T18:23:56Z",
      "textHash": "90e430ca00ed52eaa297a51a2dab18e6bc07d5d70b3eeefea9673715a34717c2"
    },
    {
      "key": "0624437",
      "nodeTitle": "school_2_talk",
      "sourceText": "Und los geht's! Betretet das Klassenzimmer.",
      "sourceEnText": "And there you go! Enter the classroom.",
      "audioFile": "fr_02_0624437.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2900,
      "updatedAt": "2026-08-24T18:23:51Z",
      "textHash": "451ae5b187339f065554c8a4cfdf5b183e8d5b8bdcd382f0556662036534ce20"
    },
    {
      "key": "0630d14",
      "nodeTitle": "school_4",
      "sourceText": "Du bist noch zu jung für die Mittel- oder Oberstufe.",
      "sourceEnText": "You are too young to enter middle or high school.",
      "audioFile": "fr_02_0630d14.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3030,
      "updatedAt": "2026-08-24T18:23:41Z",
      "textHash": "f3d53ab4c80b53431da90d6c209dd980f14e0fa68c9d689abfb17fe6af9f7612"
    },
    {
      "key": "063e8e0",
      "nodeTitle": "quest_start",
      "sourceText": "Die Schule beginnt wieder im September. Du bist 10 Jahre alt und kommst in die CM2. Klasse.",
      "sourceEnText": "School starts again in September. You are 10 years old and you are going into CM2.",
      "audioFile": "fr_02_063e8e0.mp3",
      "voiceProfile": "alice",
      "actorId": "NARRATOR",
      "durationMs": 5825,
      "updatedAt": "2026-08-24T18:23:12Z",
      "textHash": "9b7a0fefcde5114512977784ea07b6504b6f99310a1dcf89025d10d02394bfb0"
    },
    {
      "key": "063f354",
      "nodeTitle": "task_backpack_done",
      "sourceText": "Gut gemacht! Du hast das Wort SCHULE geschrieben. Du kannst jetzt in die Schule gehen.",
      "sourceEnText": "Well done! You wrote the word SCHOOL. You can go into the school.",
      "audioFile": "fr_02_063f354.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4807,
      "updatedAt": "2026-08-24T18:24:49Z",
      "textHash": "7f1a897d09a4b80a60c41814e7352bf73f4535ef9acb7c30ceb5191f02cc2cb3"
    },
    {
      "key": "06478e9",
      "nodeTitle": "school_3",
      "sourceText": "Hallo! Das ist die Schule. Die Schüler sind zwischen 11 und 14 Jahre alt.",
      "sourceEnText": "Hello! This is the school. The students are between 11 and 14 years old.",
      "audioFile": "fr_02_06478e9.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 4989,
      "updatedAt": "2026-08-24T18:23:31Z",
      "textHash": "113f83da083d6ad85ba66d5204142adac3df385d4404e8e256c56525b4e12921"
    },
    {
      "key": "0671097",
      "nodeTitle": "school_canteen",
      "sourceText": "Guten Appetit!",
      "sourceEnText": "Enjoy your food!",
      "audioFile": "fr_02_0671097.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_F",
      "durationMs": 1358,
      "updatedAt": "2026-08-24T18:25:38Z",
      "textHash": "a1109f8e327bf2c59f1e4e90d59f3bf43cb138060a722425ddf9f31371abdaaa"
    },
    {
      "key": "068e48b",
      "nodeTitle": "classroom_1",
      "sourceText": "Das ist nicht deine Klasse. Du bist 10 Jahre alt. Also bist du in CM2.",
      "sourceEnText": "This isn't your class. You're 10 years old. So you're in CM2.",
      "audioFile": "fr_02_068e48b.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 5277,
      "updatedAt": "2026-08-24T18:24:01Z",
      "textHash": "b01e1ec0e9d794e527715da7a5d0f90c012cc3404f6c331bcdf1fcd1794c5a81"
    },
    {
      "key": "078fff9",
      "nodeTitle": "schools_activity_done",
      "sourceText": "Nimm es!",
      "sourceEnText": "Take it!",
      "audioFile": "fr_02_078fff9.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_M",
      "durationMs": 888,
      "updatedAt": "2026-08-24T18:24:44Z",
      "textHash": "da329a98b7122c6eecee5c66585f02c3e26a3c5fcd37cb37b6f1d2fccbded16b"
    },
    {
      "key": "07e8390",
      "nodeTitle": "schools_activity_done",
      "sourceText": "Gut gemacht!",
      "sourceEnText": "Well done!",
      "audioFile": "fr_02_07e8390.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_M",
      "durationMs": 1097,
      "updatedAt": "2026-08-24T18:24:47Z",
      "textHash": "66eff3616ea684b1036e335c58e77b9e185b78c86910c5d0b8e84d51bad1c0b1"
    },
    {
      "key": "07ed07b",
      "nodeTitle": "school_1",
      "sourceText": "Du bist zu alt. Die Grundschule ist gleich nebenan. Die Schüler sind zwischen 6 und 10 Jahre alt.",
      "sourceEnText": "You're too old. The elementary school is right next door. The students are between 6 and 10 years old.",
      "audioFile": "fr_02_07ed07b.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 6426,
      "updatedAt": "2026-08-24T18:23:21Z",
      "textHash": "ba334dc68f0502a3361de69577fd3f4d4f9b66e76c6b58f01cbb4b63ce21420d"
    },
    {
      "key": "0879a44",
      "nodeTitle": "spawned_kid_f",
      "sourceText": "Ich zeichne und male gern.",
      "sourceEnText": "I like to draw and color.",
      "audioFile": "fr_02_0879a44.mp3",
      "voiceProfile": "alice",
      "actorId": "KID_F",
      "durationMs": 1881,
      "updatedAt": "2026-08-24T18:25:44Z",
      "textHash": "5434f96fd0d09ccf5c3aa4214bb4b31a32ac8f286603b677d46e32524bf37840"
    },
    {
      "key": "08b2774",
      "nodeTitle": "classroom_1",
      "sourceText": "Das ist die erste Klasse.",
      "sourceEnText": "This is the first grade class.",
      "audioFile": "fr_02_08b2774.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1515,
      "updatedAt": "2026-08-24T18:23:57Z",
      "textHash": "709e17fef22353b31e03527131c11732adc4d1621c7b7207952eaed3eecc42e0"
    },
    {
      "key": "08f3ab2",
      "nodeTitle": "classroom_2",
      "sourceText": "Dies ist die CE1-Klasse.",
      "sourceEnText": "This is the CE1 class.",
      "audioFile": "fr_02_08f3ab2.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T18:24:06Z",
      "textHash": "e4f27f83f96a6f27e109a670d2683b63850e442d69ff38199f1af311d9cba71f"
    },
    {
      "key": "092b309",
      "nodeTitle": "school_2_welcome",
      "sourceText": "Hallo! Willkommen! Du hast deine Schule gefunden. Du bist in der Grundschule. Es gibt 5 Klassen: CP, CE1, CE2, CM1 und CM2.",
      "sourceEnText": "Hello! Welcome! You've found your school. You're in elementary school. There are 5 classes: CP, CE1, CE2, CM1 and CM2.",
      "audioFile": "fr_02_092b309.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 10736,
      "updatedAt": "2026-08-24T18:23:24Z",
      "textHash": "36a071c72984c74e58a4580735b9c868bd85c1cacefc868e7587e730fb39bc75"
    },
    {
      "key": "092fccb",
      "nodeTitle": "school_4_talk_man",
      "sourceText": "Bringt die Klassen wieder in die richtige Reihenfolge.",
      "sourceEnText": "Put the classes back in order.",
      "audioFile": "fr_02_092fccb.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_M",
      "durationMs": 2952,
      "updatedAt": "2026-08-24T18:25:07Z",
      "textHash": "5c79bcd0ca5fccf82b036a8d59112b2acef91fea69272bc17e591672e6dcd42c"
    },
    {
      "key": "093e91d",
      "nodeTitle": "task_class_done",
      "sourceText": "Sie können Platz nehmen. Hier sind Ihr Tisch und Ihr Stuhl.",
      "sourceEnText": "You can take your seat. Here's your table and chair.",
      "audioFile": "fr_02_093e91d.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_M",
      "durationMs": 3631,
      "updatedAt": "2026-08-24T18:24:52Z",
      "textHash": "3049ddd221d3853022d5157f5d472843d05a4dce4e5a9bdda30c65c4f3e143b0"
    },
    {
      "key": "094eace",
      "nodeTitle": "school_4_talk_man",
      "sourceText": "Aber zuerst musst du es gewinnen!",
      "sourceEnText": "But first, you have to win it!",
      "audioFile": "fr_02_094eace.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_M",
      "durationMs": 2534,
      "updatedAt": "2026-08-24T18:25:09Z",
      "textHash": "e088b714e9091b8aaf2d8d50e9a8b0eeaa9f3cf65929c504214b1535c1a7395b"
    },
    {
      "key": "096b721",
      "nodeTitle": "school_1",
      "sourceText": "Herzlich willkommen! Dies ist ein Kindergarten. Es ist eine Einrichtung für Kinder im Alter von 3 bis 5 Jahren. Der Kindergarten ist in drei Gruppen unterteilt: die jüngste, die mittlere und die älteste Gruppe.",
      "sourceEnText": "Welcome! This is a preschool. It's a school for children aged 3 to 5. There are three classes in preschool: the youngest class, the middle class, and the oldest class.",
      "audioFile": "fr_02_096b721.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 14472,
      "updatedAt": "2026-08-24T18:23:18Z",
      "textHash": "7fcfdb1fc99f7f6214e687db9a4b1c5946d9ae2d042b130a5bd8e0402065312b"
    },
    {
      "key": "0978619",
      "nodeTitle": "school_canteen",
      "sourceText": "Schau dir den Speiseplan der Cafeteria an.",
      "sourceEnText": "Look at the cafeteria menu.",
      "audioFile": "fr_02_0978619.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_F",
      "durationMs": 2847,
      "updatedAt": "2026-08-24T18:24:59Z",
      "textHash": "c171dc77d86d42dfa4616421b633671e5cb6822392258954693dc6c5cd5f504b"
    },
    {
      "key": "09ac4f1",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Zeichne dein Klassenzimmer.",
      "sourceEnText": "Draw your classroom.",
      "audioFile": "fr_02_09ac4f1.mp3",
      "voiceProfile": "alice",
      "actorId": "NARRATOR",
      "durationMs": 1724,
      "updatedAt": "2026-08-24T18:25:36Z",
      "textHash": "7c41c2e58ed05dcc043831e0446296fa3bbb7f552571d83f5386449ed5c41641"
    },
    {
      "key": "09bfe7f",
      "nodeTitle": "classroom_1",
      "sourceText": "In CP beginnen die Kinder mit 6 Jahren die Grundschule.",
      "sourceEnText": "Children start primary school at age 6 in CP.",
      "audioFile": "fr_02_09bfe7f.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 3370,
      "updatedAt": "2026-08-24T18:23:59Z",
      "textHash": "c2741c55ea51601edd9f8b42663c50f17f7a9cd1171b2a510d6172e225c92fcf"
    },
    {
      "key": "09c12ac",
      "nodeTitle": "school_charte",
      "sourceText": "unabhängig von ihren Überzeugungen.",
      "sourceEnText": "regardless of their beliefs.",
      "audioFile": "fr_02_09c12ac.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-08-24T18:25:04Z",
      "textHash": "2245948b1c3108ca1ef8a025060f5475754eb95e53d2f72ec2386c04c0bfdc43"
    },
    {
      "key": "0a5c8f1",
      "nodeTitle": "activity_match_done",
      "sourceText": "Das stimmt so nicht ganz. Versuchen Sie es noch einmal!",
      "sourceEnText": "That's not entirely accurate. Try again!",
      "audioFile": "fr_02_0a5c8f1.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3605,
      "updatedAt": "2026-08-24T18:25:21Z",
      "textHash": "8ed32d3e05b9fc00189a2209d216db0400860de19d7d4ced6ea055e5a94c3303"
    },
    {
      "key": "0aeea98",
      "nodeTitle": "spawned_kid_m",
      "sourceText": "Ich liebe es, mit meiner Klasse Sport zu treiben. Manchmal gehen wir ins Schwimmbad.",
      "sourceEnText": "I love doing sports with my class. Sometimes we go to the swimming pool.",
      "audioFile": "fr_02_0aeea98.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 4989,
      "updatedAt": "2026-08-24T18:25:52Z",
      "textHash": "03394261f11a233c28ec775d74f10c7898e0ca4467e9841d4e9d4ba3c1888aec"
    },
    {
      "key": "0b22d07",
      "nodeTitle": "school_4_talk_man",
      "sourceText": "Finde nun deine Schule!",
      "sourceEnText": "Now, find your school!",
      "audioFile": "fr_02_0b22d07.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_M",
      "durationMs": 1829,
      "updatedAt": "2026-08-24T18:25:29Z",
      "textHash": "a7e8cce2603c228558c88f388225394eb45c86b303d42a2616451420ab940f67"
    },
    {
      "key": "0b411ce",
      "nodeTitle": "classroom_3",
      "sourceText": "Die Schüler sind 8 Jahre alt.",
      "sourceEnText": "The students are 8 years old.",
      "audioFile": "fr_02_0b411ce.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2064,
      "updatedAt": "2026-08-24T18:24:14Z",
      "textHash": "86fecd9cf751bf27c0dbf46c0fba95697b1f3b812365a507c65f997945c6c7c2"
    },
    {
      "key": "0b43290",
      "nodeTitle": "task_backpack",
      "sourceText": "Vielleicht hat jemand dein Buch mitgenommen.",
      "sourceEnText": "Maybe someone took your book.",
      "audioFile": "fr_02_0b43290.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2769,
      "updatedAt": "2026-08-24T18:23:49Z",
      "textHash": "b1cb19359a22fb474b81536c30e417f7a497cba3b13c16387ab3b333c0ee7c5a"
    },
    {
      "key": "0b82cb5",
      "nodeTitle": "spawned_kid_m",
      "sourceText": "Ich spiele mit meinen Freunden auf dem Spielplatz Fußball.",
      "sourceEnText": "I play football with my friends in the playground.",
      "audioFile": "fr_02_0b82cb5.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 3500,
      "updatedAt": "2026-08-24T18:25:50Z",
      "textHash": "0a99d078d85178c04e5fb346d1b0f0e52f0b705f0324c09cc07484c85455e2ea"
    },
    {
      "key": "0b91268",
      "nodeTitle": "school_2_talk",
      "sourceText": "Komm herein! Dein Klassenzimmer befindet sich am Ende des Flurs.",
      "sourceEnText": "Come in! Your classroom is at the end of the corridor.",
      "audioFile": "fr_02_0b91268.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4023,
      "updatedAt": "2026-08-24T18:23:54Z",
      "textHash": "d4665effcb003ee0af85dd4b989af8b524e7fa9637f74e41abfa29b1ef5f94f1"
    },
    {
      "key": "0bce01a",
      "nodeTitle": "classroom_3",
      "sourceText": "Hallo! Dies ist der CE2-Kurs.",
      "sourceEnText": "Hello! This is the CE2 class.",
      "audioFile": "fr_02_0bce01a.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2560,
      "updatedAt": "2026-08-24T18:24:11Z",
      "textHash": "0d2fcdbcc185c4c935d4b3bc7885cbfb69ee61d9e3d27cd936536497ebb6a3f6"
    },
    {
      "key": "0c282e5",
      "nodeTitle": "task_backpack",
      "sourceText": "Frag doch einfach die Leute in deiner Umgebung.",
      "sourceEnText": "Go ask the people around you.",
      "audioFile": "fr_02_0c282e5.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2717,
      "updatedAt": "2026-08-24T18:23:46Z",
      "textHash": "e3e1af2e9bd035f69b3422f6fa387f49e3b6a252c7432649b5eebfcd921dad52"
    },
    {
      "key": "0c3b4fe",
      "nodeTitle": "school_4_talk_man",
      "sourceText": "Hallo! Ich habe eine Schultasche gefunden.",
      "sourceEnText": "Hello! I found a schoolbag.",
      "audioFile": "fr_02_0c3b4fe.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_M",
      "durationMs": 2717,
      "updatedAt": "2026-08-24T18:23:44Z",
      "textHash": "3c144b0171d563365d1df75290bbb0a78128e0728fa2f705ec95786f09242556"
    },
    {
      "key": "0ce9646",
      "nodeTitle": "school_4_talk_man",
      "sourceText": "Ist das vielleicht Ihr Buch?",
      "sourceEnText": "Is this perhaps your book?",
      "audioFile": "fr_02_0ce9646.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_M",
      "durationMs": 1698,
      "updatedAt": "2026-08-24T18:25:23Z",
      "textHash": "443e79a16eae140bff75554834aad1958d1ecc10d7955d5fad389ffb9501aa9c"
    },
    {
      "key": "0cee587",
      "nodeTitle": "spawned_kid_f",
      "sourceText": "Ich liebe Musik und singe gerne mit meiner Klasse.",
      "sourceEnText": "I love music and singing with my class.",
      "audioFile": "fr_02_0cee587.mp3",
      "voiceProfile": "alice",
      "actorId": "KID_F",
      "durationMs": 3265,
      "updatedAt": "2026-08-24T18:25:47Z",
      "textHash": "bee45eb64ba6bc9d3083f1be4b3b5697bc1dd13e20e6448350cf4e94725c5a73"
    },
    {
      "key": "0d88d5b",
      "nodeTitle": "spawned_teacher",
      "sourceText": "In der Schule lernen wir lesen und schreiben.",
      "sourceEnText": "At school, we learn to read and write.",
      "audioFile": "fr_02_0d88d5b.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 2534,
      "updatedAt": "2026-08-24T18:26:03Z",
      "textHash": "6ac0be6d12346879d01427f694438c1669b7a3a1bb84484b8905f71d80d82eb4"
    },
    {
      "key": "0d8d4aa",
      "nodeTitle": "spawned_adult",
      "sourceText": "In der Schule lernen wir lesen, schreiben, rechnen und neue Sprachen sprechen.",
      "sourceEnText": "At school, we learn to read, write, count and speak new languages.",
      "audioFile": "fr_02_0d8d4aa.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 5460,
      "updatedAt": "2026-08-24T18:25:57Z",
      "textHash": "5913a5ea5c776c04796ab308e0385873330ea07f0899a63859936b41f18eeb78"
    },
    {
      "key": "0da284c",
      "nodeTitle": "task_find_school_desc",
      "sourceText": "Finde deine Schule!",
      "sourceEnText": "Find your school!",
      "audioFile": "fr_02_0da284c.mp3",
      "voiceProfile": "alice",
      "actorId": "NARRATOR",
      "durationMs": 1358,
      "updatedAt": "2026-08-24T18:25:11Z",
      "textHash": "98518e7566a656f02ffe7d781e1b60729a88cfa36afa492f777974904c7142ac"
    },
    {
      "key": "0dd7977",
      "nodeTitle": "school_2_welcome",
      "sourceText": "Aber du hast vergessen, deine Schultasche mitzunehmen.",
      "sourceEnText": "But you forgot to take your schoolbag.",
      "audioFile": "fr_02_0dd7977.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3318,
      "updatedAt": "2026-08-24T18:23:26Z",
      "textHash": "19d8fc96f71ed72782a0e41fa05d64dddf21a479d7fea98be8ade6485805f2f0"
    },
    {
      "key": "0df97f8",
      "nodeTitle": "school_3",
      "sourceText": "Nach der zweiten Klasse (CM2) wechseln die Schüler in die Mittelschule. Sie beginnen die Mittelschule im Alter von 11 Jahren und kommen in die sechste Klasse.",
      "sourceEnText": "After CM2, students enter middle school. They start middle school at age 11. They enter 6th grade.",
      "audioFile": "fr_02_0df97f8.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 10423,
      "updatedAt": "2026-08-24T18:23:33Z",
      "textHash": "4e323417d4d7e65751d8075dc01b394c5b96a62844b9a80dedd337a114ed130e"
    },
    {
      "key": "0e1ff90",
      "nodeTitle": "schools_activity_done",
      "sourceText": "Entschuldigung! Das ist nicht die richtige Antwort. Versuchen Sie es erneut.",
      "sourceEnText": "Sorry! That's not the right answer. Try again.",
      "audioFile": "fr_02_0e1ff90.mp3",
      "voiceProfile": "alice",
      "actorId": "SENIOR_M",
      "durationMs": 4571,
      "updatedAt": "2026-08-24T18:24:04Z",
      "textHash": "926811570da372cb76fa58337659731e31c755668d3386a7c05aa2f1fc761fd9"
    },
    {
      "key": "0e3ad75",
      "nodeTitle": "task_backpack",
      "sourceText": "Finde deine Schultasche und komm dann wieder zu mir.",
      "sourceEnText": "Find your schoolbag and then come back to see me.",
      "audioFile": "fr_02_0e3ad75.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3030,
      "updatedAt": "2026-08-24T18:24:54Z",
      "textHash": "ac3e9c7b6861210c24608c81d026648884132562ba2f8edfc47c718d99a0188c"
    },
    {
      "key": "0e3f1fa",
      "nodeTitle": "activity_match_done",
      "sourceText": "Gut gemacht! Du hast es geschafft!",
      "sourceEnText": "Well done! You succeeded!",
      "audioFile": "fr_02_0e3f1fa.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2377,
      "updatedAt": "2026-08-24T18:24:42Z",
      "textHash": "eb8075965890b5e47b77852259dfeb9558b9c6fbb2a7814b8577cf9b180bb674"
    },
    {
      "key": "0e4aa95",
      "nodeTitle": "classroom_3",
      "sourceText": "Das ist nicht dein Unterricht!",
      "sourceEnText": "This isn't your class!",
      "audioFile": "fr_02_0e4aa95.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1698,
      "updatedAt": "2026-08-24T18:24:16Z",
      "textHash": "8b1ab62494417a43dd5644f48222582a9c4bc7699fdf52657c2b4978dd3b96ed"
    },
    {
      "key": "0f65a1b",
      "nodeTitle": "quest_start",
      "sourceText": "Finde deine Schule und Klasse!",
      "sourceEnText": "Find your school and class!",
      "audioFile": "fr_02_0f65a1b.mp3",
      "voiceProfile": "alice",
      "actorId": "NARRATOR",
      "durationMs": 2064,
      "updatedAt": "2026-08-24T18:23:15Z",
      "textHash": "b1381f4f2f0346628440f318dd90157c43fa8da1d1ea0eea29a5abed45480140"
    },
    {
      "key": "0f6b039",
      "nodeTitle": "spawned_teacher",
      "sourceText": "Der Unterricht findet von 8:00 bis 16:00 Uhr statt.",
      "sourceEnText": "Classes are held from 8 a.m. to 4 p.m.",
      "audioFile": "fr_02_0f6b039.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 3318,
      "updatedAt": "2026-08-24T18:25:59Z",
      "textHash": "b30247b092385d25beb8bf9df7cbdd10d7cb74be6fafce4fc789ccfd6989c6e1"
    },
    {
      "key": "0f8995f",
      "nodeTitle": "classroom_5",
      "sourceText": "Der Lehrer ist da, um Ihnen beim Lernen zu helfen.",
      "sourceEnText": "The teacher is there to help you learn.",
      "audioFile": "fr_02_0f8995f.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3448,
      "updatedAt": "2026-08-24T18:24:33Z",
      "textHash": "a6a80e74e822470aa0170a8ca5a78465e8fe045ce42cdcc2e7758992cc9478ed"
    },
    {
      "key": "0f90123",
      "nodeTitle": "classroom_5",
      "sourceText": "Nehmen Sie an Ihrem Tisch Platz.",
      "sourceEnText": "Take a seat at your table.",
      "audioFile": "fr_02_0f90123.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1881,
      "updatedAt": "2026-08-24T18:24:28Z",
      "textHash": "dae19e928027483c8d77b7edd1b340cae28e240dc1646c2e778edb622c7d8917"
    }
  ]
}