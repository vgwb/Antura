      "audioFile": "pl_00_05de5ab.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1881,
      "updatedAt": "2026-09-04T16:44:12Z",
      "textHash": "16aed56511ca5175b2e585b5d0d835b431e13cda2cc943520b84a9cf198e083e"
