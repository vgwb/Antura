      "audioFile": "pl_00_04bf6d1.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2351,
      "updatedAt": "2026-09-04T16:44:30Z",
      "textHash": "986e7c8513addd3f4d823e89ecad946658e8aa3cd43d6185de37372eaf607d12"
    },
    {
      "key": "04dc97a",
      "nodeTitle": "germany_npc",
      "sourceText": "Híresek vagyunk a kastélyokról, az erdőkről és a vonatokról!",
      "sourceEnText": "We're famous for castles, forests, and trains!",
      "audioFile": "pl_00_04dc97a.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3448,
      "updatedAt": "2026-09-04T16:43:31Z",
      "textHash": "9aecde6b1b6741990491d8ce7ba60018abfdacf3b5b6dcf9c949a503cc076ea1"
    },
    {
      "key": "04f4280",
      "nodeTitle": "spawned_npc",
      "sourceText": "Európában az emberek több mint 50 nyelvet beszélnek!",
      "sourceEnText": "In Europe, people speak over 50 languages!",
      "audioFile": "pl_00_04f4280.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_M",
      "durationMs": 3135,
      "updatedAt": "2026-09-04T16:44:53Z",
      "textHash": "ca0c66becdf9951c7e0cad7d6b5e1f7a6aa76d8c49329e5c03496d4dc6d786d3"
    },
    {
      "key": "0534a85",
      "nodeTitle": "lithuania_npc",
      "sourceText": "Szia! Litvániából származom!",
