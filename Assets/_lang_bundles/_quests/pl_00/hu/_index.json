    },
    {
      "key": "002aafd",
      "nodeTitle": "quest_start",
      "sourceText": "Európában vagyunk",
      "sourceEnText": "We are in Europe",
      "audioFile": "pl_00_002aafd.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1306,
      "updatedAt": "2026-09-04T16:45:03Z",
      "textHash": "6d871af40c92563a3c37c0c68ada5a44f972f2e4f68de0d63daa4c864664964a"
    },
    {
      "key": "0068fe1",
      "nodeTitle": "germany_npc",
      "sourceText": "Halló! Németországból származom!",
      "sourceEnText": "Hallo! I'm from Germany!",
      "audioFile": "pl_00_0068fe1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1933,
