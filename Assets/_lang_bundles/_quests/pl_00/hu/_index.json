      "audioFile": "pl_00_04bd4db.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_F",
      "durationMs": 1593,
      "updatedAt": "2026-09-04T16:43:08Z",
      "textHash": "51d69ab6d824cebaf0d864100bc120308cc7c89dd43051dbe93b4c1c44bfb1ad"
    },
    {
      "key": "04bf6d1",
      "nodeTitle": "npc_slovakia",
      "sourceText": "Tudsz segíteni az orosz szomszédunknak?",
