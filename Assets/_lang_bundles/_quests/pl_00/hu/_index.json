      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2900,
      "updatedAt": "2026-09-04T16:44:59Z",
      "textHash": "6b0502c7c5403b98eb61c902ab55854c192760a54a2c3e3ef92928acac564d5e"
    },
    {
      "key": "07ba10f",
      "nodeTitle": "czech_republic_npc",
