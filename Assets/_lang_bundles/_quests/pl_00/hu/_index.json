      "updatedAt": "2026-09-04T16:44:43Z",
      "textHash": "ba599b6611ad18d20b85192adbf8f5046cbd7dd3b597332b5837a7f936765b93"
    },
    {
      "key": "00af906",
      "nodeTitle": "lithuania_npc",
      "sourceText": "Ne feledje, az én zászlóm piros, zöld és sárga.",
      "sourceEnText": "Remember, my flag is red, green and yellow.",
      "audioFile": "pl_00_00af906.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_F",
      "durationMs": 2664,
      "updatedAt": "2026-09-04T16:44:04Z",
      "textHash": "e0cb9d27148b1c54b8d32b7ddafe051b9aa1173799433050d9bf69d06c8242e0"
    },
    {
      "key": "00f1fcc",
      "nodeTitle": "item_flag_russia",
      "sourceText": "Oroszország zászlaja.",
      "sourceEnText": "Flag of russia.",
      "audioFile": "pl_00_00f1fcc.mp3",
      "voiceProfile": "shelley",
      "actorId": "NARRATOR",
