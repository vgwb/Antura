    },
    {
      "key": "0157c15",
      "nodeTitle": "item_flag_belarus",
      "sourceText": "Megtaláltad a fehérorosz zászlót! Menj vissza Fehéroroszországba.",
      "sourceEnText": "You found the Belarusian flag! Go back to the Belarus.",
      "audioFile": "pl_00_0157c15.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3918,
      "updatedAt": "2026-09-04T16:44:22Z",
      "textHash": "393c02b06d1b1b8ff79e7a6eb90934d1d02f040e4010b17ceba4ecc5d7832fae"
    },
    {
      "key": "017ad80",
      "nodeTitle": "poland_npc",
      "sourceText": "Helló! Lengyelországból származom!",
      "sourceEnText": "Hello! I am from Poland!",
      "audioFile": "pl_00_017ad80.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_F",
      "durationMs": 2011,
      "updatedAt": "2026-09-04T16:43:12Z",
      "textHash": "8507ab19800ddc6610eb01134b834232d52d27a4c29b5f0ac5a7968721bcea2e"
    },
    {
      "key": "01b1e6d",
      "nodeTitle": "ukraine_npc",
      "sourceText": "Fővárosunk Kijev.",
      "sourceEnText": "Our capital is Kiev.",
      "audioFile": "pl_00_01b1e6d.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1411,
      "updatedAt": "2026-09-04T16:44:11Z",
      "textHash": "d40f315aa3bd3b8486b1faca530ba099a00100e0b7238b2e1249bf16eb2d3938"
    },
    {
      "key": "01f830b",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Miért nem rajzolod le a zászlót most?",
      "sourceEnText": "Why don't you draw your flag, now?",
      "audioFile": "pl_00_01f830b.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2142,
      "updatedAt": "2026-09-04T16:45:08Z",
      "textHash": "a6c19e991e5abdaf32b3c5136569ba62e1df5e2ac88ba5dabefca980347ed19d"
    },
    {
      "key": "021e1a2",
      "nodeTitle": "belarus_npc",
      "sourceText": "Tudsz segíteni a cseh barátomnak?",
      "sourceEnText": "Can you help my czech friend?",
      "audioFile": "pl_00_021e1a2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2011,
      "updatedAt": "2026-09-04T16:43:40Z",
      "textHash": "f9fd408bf49c7886bd40cc78c9a2cf816145c90cd9e8c2bf0379b263c621a3a8"
    },
    {
      "key": "0278f6a",
      "nodeTitle": "npc_slovakia",
      "sourceText": "Szlovákia gyönyörű hegyeiről és barlangjairól ismert.",
      "sourceEnText": "Slovakia is known for its beautiful mountains and caves.",
      "audioFile": "pl_00_0278f6a.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 3265,
      "updatedAt": "2026-09-04T16:44:35Z",
      "textHash": "60210f37d39a7d1f0087435543dc22993cb5455dd777916d1ae3d22dd1d2ead3"
    },
    {
      "key": "029ee72",
      "nodeTitle": "task_germany",
      "sourceText": "Keresd meg a német zászlót. Fekete, piros és sárga.",
      "sourceEnText": "Find the German flag. It's black, red, and yellow.",
      "audioFile": "pl_00_029ee72.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3187,
      "updatedAt": "2026-09-04T16:43:33Z",
      "textHash": "5692c730eaf4107890337126f71a4c3d721271f0513b454f1b8365cdaf68e376"
    },
    {
      "key": "031f72c",
      "nodeTitle": "win",
      "sourceText": "Ön felfedezte Közép-Európa egy részét!",
      "sourceEnText": "You discovered a part of Central Europe!",
      "audioFile": "pl_00_031f72c.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_F",
      "durationMs": 2560,
      "updatedAt": "2026-09-04T16:44:50Z",
      "textHash": "e050af04154a2c19d49df746d3edbf6881a4fb3cd5c15284a9ddf49472f26a93"
    },
    {
      "key": "03dc09c",
      "nodeTitle": "czech_republic_npc",
      "sourceText": "Csehország híres gyönyörű várairól, kristályüvegeiről és finom gombócairól.",
      "sourceEnText": "Czechia is famous for its beautiful castles, crystal glass, and delicious dumplings.",
      "audioFile": "pl_00_03dc09c.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_M",
      "durationMs": 4702,
      "updatedAt": "2026-09-04T16:43:56Z",
      "textHash": "19b75cb34104bf8ca1254e0c3e58f166aeab4461731f2d4135eb6d19b388f641"
    },
    {
      "key": "0446f03",
      "nodeTitle": "germany_npc",
      "sourceText": "Berlin Németország fővárosa.",
      "sourceEnText": "Berlin is the capital of Germany.",
      "audioFile": "pl_00_0446f03.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-09-04T16:43:23Z",
      "textHash": "205a05c1d33c4e405ad1860f6a079464d2eabefead24d49fbf184ed192456566"
    },
    {
      "key": "0465c31",
      "nodeTitle": "lithuania_npc",
      "sourceText": "Hazánk egyharmadát erdők borítják!",
      "sourceEnText": "One third of our country is covered by forests!",
      "audioFile": "pl_00_0465c31.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_F",
      "durationMs": 2142,
      "updatedAt": "2026-09-04T16:44:08Z",
      "textHash": "97102115095c6549c80529a84ce3d566e8266ab3d909a43533f87eb96fe53bf9"
    },
    {
      "key": "0466a59",
      "nodeTitle": "npc_russia",
      "sourceText": "Köszönöm, hogy visszahoztátok a zászlómat!",
      "sourceEnText": "Thank you for bringing my flag back!",
      "audioFile": "pl_00_0466a59.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2247,
      "updatedAt": "2026-09-04T16:44:58Z",
      "textHash": "1f90c2980bb745ddea37a11e9add2188ebd092510a7a13e075a09852b432ee11"
    },
    {
      "key": "046db1f",
      "nodeTitle": "quest_start",
      "sourceText": "Üdvözöljük Lengyelországban!",
      "sourceEnText": "Welcome to Poland!",
      "audioFile": "pl_00_046db1f.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1646,
      "updatedAt": "2026-09-04T16:44:54Z",
      "textHash": "fb7c591ca0ced24ac5214134b17d10b83d89348bddd72588172d89756a66d983"
    },
    {
      "key": "04b6692",
      "nodeTitle": "task_slovakia",
      "sourceText": "Keresse meg a szlovák zászlót.",
      "sourceEnText": "Find the Slovakian flag.",
      "audioFile": "pl_00_04b6692.mp3",
