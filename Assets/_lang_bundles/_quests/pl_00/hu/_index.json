      "textHash": "1322a701e0ba4736b837236c7fe3b83b63adbfd597c26ca213583cf4f1990fff"
    },
    {
      "key": "0653fae",
      "nodeTitle": "belarus_npc",
      "sourceText": "A zászlóm piros és zöld, a bal oldalon piros mintával.",
      "sourceEnText": "My flag is red and green with a red pattern on the left.",
      "audioFile": "pl_00_0653fae.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3187,
      "updatedAt": "2026-09-04T16:43:41Z",
      "textHash": "27f0a4368f567cc13e74b3a536b743b3549ff4d5beb74e9f828ae8033498ea1c"
    },
    {
      "key": "065c41c",
      "nodeTitle": "npc_russia",
      "sourceText": "Hello, Oroszország vagyok.",
