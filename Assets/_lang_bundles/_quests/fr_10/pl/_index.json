    {
      "key": "037efcf",
      "nodeTitle": "npc_boat_people",
      "sourceText": "Zanurzyć się pod wodą",
      "sourceEnText": "To go under the water",
      "audioFile": "fr_10_037efcf.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1515,
      "updatedAt": "2026-08-24T23:02:11Z",
      "textHash": "c67a801c1e37152ba9d84a93316e2823df07857798b50b3e7f0bd851a12daa61"
    },
    {
      "key": "038b8f6",
      "nodeTitle": "spawned_french_woman",
      "sourceText": "W Paryżu jest wiele mostów!",
