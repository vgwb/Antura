      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4885,
      "updatedAt": "2026-08-24T23:02:56Z",
      "textHash": "9e14bb1fbca28207841f21d5884f7da67f40c6d0b1a4f309ca4b540d4bffb249"
    },
    {
      "key": "02ab1e0",
      "nodeTitle": "question_seine_map",
      "sourceText": "Morze Śródziemne",
