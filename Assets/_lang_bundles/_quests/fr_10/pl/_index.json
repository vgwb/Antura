      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1646,
      "updatedAt": "2026-08-24T23:02:44Z",
      "textHash": "dece3bc61a454b7b752cf85ee3a85b2de40d8cd3e7b15c78c1a51bb4085b532d"
    },
    {
      "key": "018a0eb",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "Bardzo silny",
      "sourceEnText": "Very strong",
      "audioFile": "fr_10_018a0eb.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1358,
