    },
    {
      "key": "01f30c4",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "Samochody jadą szybko. Jak mogę bezpiecznie przejść?",
      "sourceEnText": "The cars are driving fast. How can I cross safely?",
      "audioFile": "fr_10_01f30c4.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3683,
      "updatedAt": "2026-08-24T23:02:25Z",
      "textHash": "0f2805458f4e0098f1d188d07a89dfab27fe4901405efebf3a87a884346f2cab"
    },
    {
      "key": "0210ef0",
      "nodeTitle": "protagonist",
      "sourceText": "Odwiedzam Paryż. Jestem turystą. Pies Antura zabrał moją książkę o Paryżu!",
      "sourceEnText": "I'm visiting Paris. I'm a tourist. Antura the dog took my book about Paris!",
      "audioFile": "fr_10_0210ef0.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 6008,
      "updatedAt": "2026-08-24T23:00:58Z",
      "textHash": "66d4468755164a32e0d44eedd528f632859c7dee2f4f5d18b3a4dbd082a09490"
    },
    {
      "key": "021f382",
      "nodeTitle": "npc_bridge_alexandre",
      "sourceText": "Dlaczego ten most jest sławny?",
      "sourceEnText": "What is special about this famous bridge?",
      "audioFile": "fr_10_021f382.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T23:02:15Z",
      "textHash": "14676a0ccdd67bc680c0be735af63eb515dfe3ac778305b032b742a04cea5185"
    },
    {
      "key": "02349a3",
      "nodeTitle": "npc_boat_people",
      "sourceText": "Do transportu samochodów",
      "sourceEnText": "To transport cars",
      "audioFile": "fr_10_02349a3.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1776,
      "updatedAt": "2026-08-24T23:02:09Z",
      "textHash": "233005daeb4d461736ab110b14cc9e3cc350ec1362af8ae639383dc1a0b4b0ce"
    },
    {
      "key": "0280e8f",
      "nodeTitle": "quest_start",
      "sourceText": "Dziś odkryjesz Sekwanę i jej liczne mosty. Po Sekwanie pływają najróżniejsze łodzie.",
      "sourceEnText": "Today, you will discover the Seine and its many bridges. On the Seine, there are all kinds of boats.",
      "audioFile": "fr_10_0280e8f.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 6243,
      "updatedAt": "2026-08-24T23:00:23Z",
      "textHash": "a922846109a0969fd6bbe755a0fb3958d1ae9dcf83420a6b4222e60b7353e009"
    },
    {
      "key": "0281b33",
      "nodeTitle": "npc_seine_map",
      "sourceText": "Sekwana wpływa do kanału La Manche (morza) w kierunku północnym.",
      "sourceEnText": "The Seine flows into the English Channel (a sea) in a northerly direction.",
