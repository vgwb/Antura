      "key": "056c933",
      "nodeTitle": "npc_bridge_alexandre",
      "sourceText": "Są posągi wykonane ze złota.",
      "sourceEnText": "There are statues made of gold.",
      "audioFile": "fr_10_056c933.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-08-24T23:02:17Z",
      "textHash": "bfd2cfda1e1d1354d2d8993e523a98d6ffca336bb14fb4febdbe78e61cfe878f"
