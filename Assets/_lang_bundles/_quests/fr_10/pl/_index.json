      "textHash": "0edd2d99ff15165cc02c1f6f7b29286aabee5ebcaf2cbedc953debe1c46e1df5"
    },
    {
      "key": "02ce3de",
      "nodeTitle": "npc_boat_people",
      "sourceText": "Dlaczego statek turystyczny ma duże okna?",
      "sourceEnText": "Why does a tourist boat have big windows?",
      "audioFile": "fr_10_02ce3de.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2534,
      "updatedAt": "2026-08-24T23:02:04Z",
      "textHash": "41e9551e08462f530f3471e676da1cba0d6ecdb0ae775d4d9c98cf42441dd93f"
    },
    {
      "key": "02ed36d",
      "nodeTitle": "npc_boat",
      "sourceText": "Tak, widziałem spacerującego psa.",
      "sourceEnText": "I did see a dog walking around, yes.",
      "audioFile": "fr_10_02ed36d.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 2299,
      "updatedAt": "2026-08-24T23:03:00Z",
      "textHash": "bd2fd4f60330837eba1747c2a2c3f8cf06a6b772e1a71561420150bb7c7d3d9d"
    },
    {
      "key": "036ba15",
      "nodeTitle": "npc_boat_house",
      "sourceText": "Ta łódź przewozi towary",
      "sourceEnText": "This boat is transporting goods",
      "audioFile": "fr_10_036ba15.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1646,
      "updatedAt": "2026-08-24T23:02:00Z",
      "textHash": "43dade8bcdf2bf244f05a5e4fa1e2b3c79ac876847636db99e1fb71f28a11db0"
