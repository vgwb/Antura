      "textHash": "4dd095fde60749c924e8094618b60bdd3d77a0483392cb5b84b35357610d362a"
    },
    {
      "key": "01663fa",
      "nodeTitle": "npc_train",
      "sourceText": "Chciałbym pojeździć pociągiem!",
      "sourceEnText": "I would love to ride a train!",
