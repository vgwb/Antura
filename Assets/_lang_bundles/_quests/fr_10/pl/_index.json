      "key": "04b2cf2",
      "nodeTitle": "npc_ile_de_france",
      "sourceText": "Znajduje się w starym centrum Paryża.",
      "sourceEnText": "It is in the old center of Paris.",
      "audioFile": "fr_10_04b2cf2.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2482,
