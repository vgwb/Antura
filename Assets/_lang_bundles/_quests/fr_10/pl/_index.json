      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 810,
      "updatedAt": "2026-08-24T23:03:15Z",
      "textHash": "6a1271ac74817d7c60c74e641ba1f7aa732f73d2293e9c40965443bb019b9d67"
    },
    {
      "key": "06d2470",
      "nodeTitle": "spawned_river_friend",
      "sourceText": "Na mapach zaznaczone są meandry rzeki.",
      "sourceEnText": "The maps show the meanders of the river.",
      "audioFile": "fr_10_06d2470.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2612,
      "updatedAt": "2026-08-24T23:03:28Z",
      "textHash": "0eeb9dcbc3a3223f877b0dfe71f9d9be89a35477c013add4dc82c58df16efda7"
    },
    {
      "key": "072a345",
      "nodeTitle": "spawned_french_woman",
      "sourceText": "Dzień dobry!",
      "sourceEnText": "Good morning!",
      "audioFile": "fr_10_072a345.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1123,
      "updatedAt": "2026-08-24T23:03:10Z",
      "textHash": "ce9ea426609de03013a505b4654a4c3f2d0ae37ef46c1d0b4db52aa1f74b86c5"
    },
    {
      "key": "074efa5",
      "nodeTitle": "facts_river",
      "sourceText": "Sekwana wpływa do kanału La Manche.",
      "sourceEnText": "The Seine flows into the English Channel.",
      "audioFile": "fr_10_074efa5.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2482,
      "updatedAt": "2026-08-24T23:03:08Z",
      "textHash": "724f45666bc6b1446b9a83a3eb15585e0ee171ff12715aa40b341fb098747ca1"
    },
    {
      "key": "076ee7f",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "Przez ulicę można przejść w dowolnym miejscu.",
      "sourceEnText": "You can cross the road anywhere.",
      "audioFile": "fr_10_076ee7f.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2847,
      "updatedAt": "2026-08-24T23:02:30Z",
      "textHash": "fb415660c7ff0854ea9ea9c2b2a35287d3587e45625f83836945205c9bd72606"
    },
    {
      "key": "07cac48",
      "nodeTitle": "protagonist",
      "sourceText": "Znalazłeś wszystkie zdjęcia z mojego przewodnika!",
      "sourceEnText": "You found all the photos from my guide!",
      "audioFile": "fr_10_07cac48.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3265,
      "updatedAt": "2026-08-24T23:00:43Z",
      "textHash": "6fb0db65b73fb3232aaf394f96c4380c9cc46203bc165ed401b4daea93856278"
    },
    {
      "key": "07f732f",
      "nodeTitle": "npc_bridge_people",
      "sourceText": "most dla samochodów",
      "sourceEnText": "a bridge for cars",
      "audioFile": "fr_10_07f732f.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1306,
      "updatedAt": "2026-08-24T23:02:52Z",
      "textHash": "b1ff7cf37ef9281ff68f25fa307b437fb470416f2cd414f5743c26a14e1e4f56"
    },
    {
      "key": "0816b6b",
      "nodeTitle": "spawned_bridge_expert",
      "sourceText": "Most kolejowy musi być solidny.",
      "sourceEnText": "A train bridge must be strong.",
      "audioFile": "fr_10_0816b6b.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T23:03:21Z",
      "textHash": "94bde378b099f346a87c3dd7a0bffb162cfdf9de58d921f5ebe5eefb95307e21"
    },
    {
      "key": "084c7e4",
      "nodeTitle": "protagonist",
      "sourceText": "Wybierz się na spacer brzegiem Sekwany i znajdź zdjęcia!",
      "sourceEnText": "Take a walk along the banks of the Seine and find the photos!",
      "audioFile": "fr_10_084c7e4.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3736,
      "updatedAt": "2026-08-24T23:00:50Z",
      "textHash": "030d4fa4868d7ccd517418a8e9a1dd6026c8fe23bcdc396eb9aad92cab3d6439"
    },
    {
      "key": "08b0aea",
      "nodeTitle": "protagonist",
      "sourceText": "Nareszcie mogę iść do domu! Mam jeszcze jedno ostatnie pytanie…",
      "sourceEnText": "I can finally go home! I have one last question…",
      "audioFile": "fr_10_08b0aea.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4467,
      "updatedAt": "2026-08-24T23:00:45Z",
      "textHash": "13abb0be2d3fd022923b15fa6583b180bb46336096ebd178bd5e3586c1bd871b"
    },
    {
      "key": "08b1177",
      "nodeTitle": "npc_seine_map",
      "sourceText": "Spójrz na tę mapę Sekwany.",
      "sourceEnText": "Look at this map of the Seine.",
      "audioFile": "fr_10_08b1177.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1881,
      "updatedAt": "2026-08-24T23:02:54Z",
      "textHash": "842bcee0e5377ed5392ddec0a14c44e8e7ae45ed27d8eb5e8b810d88b91672e8"
    },
    {
      "key": "08b4fad",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "do samochodów",
      "sourceEnText": "for cars",
      "audioFile": "fr_10_08b4fad.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1358,
      "updatedAt": "2026-08-24T23:02:40Z",
      "textHash": "b8abc213abf3ea04bc042274b94acaf205535a231dda187cb4be19cb952f518a"
    },
    {
      "key": "08cc02a",
      "nodeTitle": "quest_end",
      "sourceText": "Ważne zabytki Paryża zostały zbudowane wokół Sekwany.",
      "sourceEnText": "Important monuments in Paris were built around the Seine.",
      "audioFile": "fr_10_08cc02a.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3631,
      "updatedAt": "2026-08-24T23:00:37Z",
      "textHash": "95cba15cd6d35cbb707e5d4bdedb1b6ed2e26c66fb685aa0d99a2c5cb8cceae3"
    },
    {
      "key": "08d8ef0",
      "nodeTitle": "spawned_bridge_expert",
      "sourceText": "Samochody przejeżdżają przez rzekę codziennie.",
      "sourceEnText": "Cars cross the river every day.",
      "audioFile": "fr_10_08d8ef0.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 2560,
      "updatedAt": "2026-08-24T23:03:24Z",
      "textHash": "b67897acebd5a68378c90bc563019d659c836c17173c78d726052bf398162966"
    },
    {
      "key": "091e9fc",
      "nodeTitle": "quest_end",
      "sourceText": "Odkryłeś mosty i łodzie na Sekwanie. Mosty pozwalają przekroczyć rzekę przepływającą przez Paryż: Sekwanę.",
      "sourceEnText": "You discovered the bridges and boats of the Seine. The bridges allow you to cross the river that flows through Paris: the Seine.",
      "audioFile": "fr_10_091e9fc.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 8281,
      "updatedAt": "2026-08-24T23:00:30Z",
      "textHash": "78c8cd4fde8b090ad782557ce156dc37faa00807c1e1d0c52f94fc151cb6c235"
    },
    {
      "key": "09731f9",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "Most kolejowy jest mostem...",
      "sourceEnText": "A train bridge is a bridge...",
      "audioFile": "fr_10_09731f9.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1829,
      "updatedAt": "2026-08-24T23:02:36Z",
      "textHash": "e134560730751afb6a16460affec4c6e07643b4f827f70cfca46d104545f0299"
    },
    {
      "key": "099fe86",
      "nodeTitle": "question_seine_map",
      "sourceText": "To nie jest poprawna odpowiedź. Loara przepływa przez Nantes, w pobliżu Muzeum Juliusza Verne'a.",
      "sourceEnText": "That's not the correct answer. The Loire flows through Nantes, near the Jules Verne Museum.",
      "audioFile": "fr_10_099fe86.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 6426,
      "updatedAt": "2026-08-24T23:01:13Z",
      "textHash": "acf7dbc9a6da58ae84e41f45828eba288962d4fa92d63a9741ae7503cd667209"
    },
    {
      "key": "09c706f",
      "nodeTitle": "npc_bridge_alexandre",
      "sourceText": "To jest most Aleksandra III. To bardzo znany most.",
      "sourceEnText": "This is the Alexander III Bridge. It's a very famous bridge.",
      "audioFile": "fr_10_09c706f.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4206,
      "updatedAt": "2026-08-24T23:02:13Z",
      "textHash": "3f66bab47939afd1c6a9351c599013f726ff92d8a61f563425899d1b83619388"
    },
    {
      "key": "09f3f7a",
      "nodeTitle": "npc_boat",
      "sourceText": "Pies? Jest tu wiele psów...",
      "sourceEnText": "A dog? There are many dogs here...",
      "audioFile": "fr_10_09f3f7a.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1724,
      "updatedAt": "2026-08-24T23:02:59Z",
      "textHash": "02546ec8bcdb502939d1e05693239ae137c3c4451207baa5fa40c1bc092d2c72"
    },
    {
      "key": "0a0991d",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "To jest most dla pociągów!",
      "sourceEnText": "It's a bridge for trains!",
      "audioFile": "fr_10_0a0991d.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1829,
      "updatedAt": "2026-08-24T23:02:34Z",
      "textHash": "d87fde446b44ee22e3fca3f80bec3e4900df3f20c1d1b13b342ca794daf7fa61"
    },
    {
      "key": "0a29742",
      "nodeTitle": "quest_end",
      "sourceText": "Istnieją łodzie mieszkalne. Ludzie mieszkają na tych łodziach. Nazywają się barkami.",
      "sourceEnText": "There are houseboats. People live on these boats. They are called barges.",
      "audioFile": "fr_10_0a29742.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 5825,
      "updatedAt": "2026-08-24T23:00:34Z",
      "textHash": "1ca8cc7d480a8bc930941d82cb0266b5890c9ec7561a0ea80db17f2cdeadf5e5"
    },
    {
      "key": "0a2bcd3",
      "nodeTitle": "question_seine_map",
      "sourceText": "Tak, to Sekwana. Rzeka przepływająca przez Paryż nazywa się Sekwana.",
      "sourceEnText": "Yes, it's the Seine. The river that flows through Paris is called the Seine.",
      "audioFile": "fr_10_0a2bcd3.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 5277,
      "updatedAt": "2026-08-24T23:01:18Z",
      "textHash": "50aae5481d66a115fb93682f0f6ac459546c879fe0de9336b14f3857dd25501d"
    },
    {
      "key": "0a627c2",
      "nodeTitle": "npc_boat_house",
      "sourceText": "Ta łódź to dom. Na tej łodzi mieszkają ludzie. Ta łódź nazywa się houseboat.",
      "sourceEnText": "This boat is a house. There are people who live on this boat. This boat is called a houseboat.",
      "audioFile": "fr_10_0a627c2.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 5721,
      "updatedAt": "2026-08-24T23:01:50Z",
      "textHash": "d11261a799aaab7c209f6b6a7b43a64e26c886fac9734a67fbbb0bf447f7054d"
    },
    {
      "key": "0a70250",
      "nodeTitle": "protagonist",
      "sourceText": "Dziękuję!",
      "sourceEnText": "Thank you!",
      "audioFile": "fr_10_0a70250.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1228,
      "updatedAt": "2026-08-24T23:00:41Z",
      "textHash": "6fe44d56d96b7f1802939c734c8e3e7f4bdbe430114ddfb0745f725e7ba832d1"
    },
    {
      "key": "0a9c8e7",
      "nodeTitle": "protagonist",
      "sourceText": "Spaceruj wzdłuż rzeki, a znajdziesz zdjęcia!",
      "sourceEnText": "Walk near the river and you'll find the photos!",
      "audioFile": "fr_10_0a9c8e7.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3318,
      "updatedAt": "2026-08-24T23:01:03Z",
      "textHash": "0b7db504412fc6da43469e4b8951e55150776648e5ca580ae63b7f0ef4ec39db"
    },
    {
      "key": "0aa0f3a",
      "nodeTitle": "protagonist",
      "sourceText": "Pomocy! Pomóż mi!",
      "sourceEnText": "Help! Help me!",
      "audioFile": "fr_10_0aa0f3a.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1776,
      "updatedAt": "2026-08-24T23:00:56Z",
      "textHash": "3dcad6be4c6ed693649c3938dddcea355fb9660c9d1d5f14fc2d04f1722a273b"
    },
    {
      "key": "0b12cb3",
      "nodeTitle": "npc_boat_goods",
      "sourceText": "Statek towarowy może przewozić: drewno, piasek, ale także przedmioty: samochody, meble...",
      "sourceEnText": "Boxes and things",
      "audioFile": "fr_10_0b12cb3.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 6844,
      "updatedAt": "2026-08-24T23:01:26Z",
      "textHash": "9c73d02d8396e6f2c50baed6230a1489e7b5f3ebfa4a319009c91a35a6b73645"
    },
    {
      "key": "0b37e92",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Narysuj most w swoim zeszycie!",
      "sourceEnText": "Draw a bridge in your notebook!",
      "audioFile": "fr_10_0b37e92.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2011,
      "updatedAt": "2026-08-24T23:00:39Z",
      "textHash": "7c665b9c48b778d1c36a190a812f97bbbe4972e1881a72286ecca06698bc9b8f"
    },
    {
      "key": "0ba2f29",
      "nodeTitle": "spawned_bridge_expert",
      "sourceText": "Niektóre mosty przeznaczone są wyłącznie dla pieszych.",
      "sourceEnText": "Some bridges are intended for pedestrians only.",
      "audioFile": "fr_10_0ba2f29.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 2795,
      "updatedAt": "2026-08-24T23:03:23Z",
      "textHash": "57fbd173423e41c195d1836764b44ae8e6231ebd886a19a91d65ace72b21ed73"
    },
    {
      "key": "0bbd3ce",
      "nodeTitle": "npc_boat_goods",
      "sourceText": "Turyści z aparatami",
      "sourceEnText": "Tourists with cameras",
      "audioFile": "fr_10_0bbd3ce.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1515,
      "updatedAt": "2026-08-24T23:01:31Z",
      "textHash": "1e2e913fab873ddfa6b6650c32c5caa85b6b310fe6a7c58434da363c7e2e85e6"
    },
    {
      "key": "0bfcb05",
      "nodeTitle": "protagonist",
      "sourceText": "Jeśli nie możesz ich znaleźć, możesz skorzystać z mapy Paryża!",
      "sourceEnText": "If you can't find them, you can use the map of Paris to locate them!",
      "audioFile": "fr_10_0bfcb05.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4101,
      "updatedAt": "2026-08-24T23:00:52Z",
      "textHash": "e76bbc2fa3cc9720ce68a7f86095e51435defcb0b226d03457a51a23ca38cbdc"
    },
    {
      "key": "0c408c3",
      "nodeTitle": "quest_end",
      "sourceText": "Świetnie, ukończyłeś to zadanie!",
      "sourceEnText": "Great, you've completed this quest!",
      "audioFile": "fr_10_0c408c3.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2534,
      "updatedAt": "2026-08-24T23:00:25Z",
      "textHash": "408d2aa9d39d8340b429616e33903b136157b343eef026b6c278f601c58b4b78"
    },
    {
      "key": "0c86d26",
      "nodeTitle": "npc_boat_house",
      "sourceText": "Można tam zamieszkać.",
      "sourceEnText": "It's possible to live there.",
      "audioFile": "fr_10_0c86d26.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1776,
      "updatedAt": "2026-08-24T23:01:56Z",
      "textHash": "b9679d1e6d2486286104c3b92295f23b18af7adefb42ebe7bef20dea818eda89"
    },
    {
      "key": "0c8cdae",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "Należy chodzić po chodniku i przechodzić na przejściu dla pieszych.",
      "sourceEnText": "Use the sidewalk and cross at the crossing",
      "audioFile": "fr_10_0c8cdae.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4284,
      "updatedAt": "2026-08-24T23:02:28Z",
      "textHash": "1b6036fb94ea6824b26ca1ded5b14db56dd8ad9f4332c853526ca2b82ecbab4e"
    },
    {
      "key": "0c8e7b6",
      "nodeTitle": "protagonist",
      "sourceText": "Strony mojej książki i zdjęcia upadły w pobliżu Sekwany!",
      "sourceEnText": "The pages of my book and the photos fell near the Seine!",
      "audioFile": "fr_10_0c8e7b6.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4101,
      "updatedAt": "2026-08-24T23:01:00Z",
      "textHash": "359a1fb34c3f111916c98d768d09728e7586bdc7c707fc22aa156718c6be4d1e"
    },
    {
      "key": "0cf371b",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "Musisz iść drogą",
      "sourceEnText": "You have to walk on the road",
      "audioFile": "fr_10_0cf371b.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1306,
      "updatedAt": "2026-08-24T23:02:32Z",
      "textHash": "e34828cfa8f774df5c92c591c1fa1faa364cd3cb6c461eb4a4b2137d6087132b"
    },
    {
      "key": "0d1724c",
      "nodeTitle": "spawned_river_friend",
      "sourceText": "Rzeka wpada do morza.",
      "sourceEnText": "The river flows into the sea.",
      "audioFile": "fr_10_0d1724c.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1515,
      "updatedAt": "2026-08-24T23:03:31Z",
      "textHash": "64806eea96ad78db2fccfcdad6eccac2a3c2b2922c83518cbb75bb1dc4b48015"
    },
    {
      "key": "0d79d7d",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "To most dla samochodów!",
      "sourceEnText": "It's a bridge for cars!",
      "audioFile": "fr_10_0d79d7d.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1829,
      "updatedAt": "2026-08-24T23:02:23Z",
      "textHash": "672695bee34ee7e1e4558e9fd112ddaba42da797440416dab8090c72250b8cc4"
    },
    {
      "key": "0d94ea8",
      "nodeTitle": "spawned_french_man",
      "sourceText": "Paryż jest najpiękniejszym miastem na świecie!",
      "sourceEnText": "Paris is the most beautiful city in the world!",
      "audioFile": "fr_10_0d94ea8.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 2769,
      "updatedAt": "2026-08-24T23:03:18Z",
      "textHash": "1d909dadd3323a26b6b08e9bc15dd4adeb43ff6e5dc254151e51504883d354a9"
    },
    {
      "key": "0d9bc29",
      "nodeTitle": "npc_bridge_alexandre",
      "sourceText": "To most dla samochodów.",
      "sourceEnText": "It's a bridge for cars.",
      "audioFile": "fr_10_0d9bc29.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1881,
      "updatedAt": "2026-08-24T23:02:21Z",
      "textHash": "3ed20cfc826c482cb6b4a46c9580bc737c5e9c882f73e91024907d6925742c68"
    },
    {
      "key": "0e48593",
      "nodeTitle": "npc_bridge_people",
      "sourceText": "Kładka",
      "sourceEnText": "Footbridge",
