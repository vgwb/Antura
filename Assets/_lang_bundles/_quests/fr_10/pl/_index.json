      "textHash": "9ab077717f60db90939c0aed572033578a246748f97f36997a44a5ba5b723075"
    },
    {
      "key": "00728bb",
      "nodeTitle": "spawned_boat_guide",
      "sourceText": "Dom na wodzie może być domem.",
      "sourceEnText": "A houseboat can be a home.",
      "audioFile": "fr_10_00728bb.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1698,
      "updatedAt": "2026-08-24T23:03:36Z",
      "textHash": "d6be990ac4e0fb302f055d95034137c921dc44f89786892477924572ecdfc67f"
    },
    {
      "key": "0129c99",
      "nodeTitle": "npc_boat_people",
      "sourceText": "Ta łódź ma duże okna. Turyści mogą podziwiać miasto. To „statek rzeczny”.",
      "sourceEnText": "This boat has large windows. Tourists can admire the city. It's a \"riverboat\".",
      "audioFile": "fr_10_0129c99.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 5721,
      "updatedAt": "2026-08-24T23:02:02Z",
      "textHash": "e542c82c8d430d2273457b256c0307dc7184151c9cf44a08a85e95f92efcbe39"
    },
    {
      "key": "0165157",
      "nodeTitle": "npc_boat_house",
      "sourceText": "Dlaczego tę łódź nazywa się houseboatem?",
      "sourceEnText": "Why is this boat called a houseboat?",
      "audioFile": "fr_10_0165157.mp3",
      "voiceProfile": "alice",
