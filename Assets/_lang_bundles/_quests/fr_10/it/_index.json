    {
      "key": "06d2470",
      "nodeTitle": "spawned_river_friend",
      "sourceText": "Le mappe mostrano le anse del fiume.",
      "sourceEnText": "The maps show the meanders of the river.",
      "audioFile": "fr_10_06d2470.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_F",
      "durationMs": 2116,
      "updatedAt": "2026-08-24T23:00:11Z",
      "textHash": "520dae61409e221205d39c196aaf89eb3a7b7c53325767be0f35247647d378d3"
    },
    {
      "key": "072a345",
      "nodeTitle": "spawned_french_woman",
      "sourceText": "Buongiorno!",
      "sourceEnText": "Good morning!",
      "audioFile": "fr_10_072a345.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_F",
      "durationMs": 888,
      "updatedAt": "2026-08-24T22:59:56Z",
      "textHash": "07a0873c86d163b89f404e51538ebc9a414c953ee618697b5a3d47d66475a860"
    },
    {
      "key": "074efa5",
      "nodeTitle": "facts_river",
      "sourceText": "La Senna sfocia nel Canale della Manica.",
      "sourceEnText": "The Seine flows into the English Channel.",
      "audioFile": "fr_10_074efa5.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2247,
      "updatedAt": "2026-08-24T22:59:55Z",
      "textHash": "bbbc036175f143ff06d57a0058b0890a674c6abc81d045ae3ad967b317dffb2d"
    },
    {
      "key": "076ee7f",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "Puoi attraversare la strada ovunque.",
      "sourceEnText": "You can cross the road anywhere.",
      "audioFile": "fr_10_076ee7f.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T22:59:24Z",
      "textHash": "b92afe8f60b6a249d0910acba3ad11cf5df9ddf4de51aaf2359dae9f8e5f32a6"
    },
    {
      "key": "07cac48",
      "nodeTitle": "protagonist",
      "sourceText": "Hai trovato tutte le foto della mia guida!",
      "sourceEnText": "You found all the photos from my guide!",
      "audioFile": "fr_10_07cac48.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2116,
      "updatedAt": "2026-08-24T22:58:15Z",
      "textHash": "43e8c1ee7e889c6ee0c1c5e82cac5d6a45de6c6ef0356b8f80667b72b7817ead"
    },
    {
      "key": "07f732f",
      "nodeTitle": "npc_bridge_people",
      "sourceText": "un ponte per auto",
      "sourceEnText": "a bridge for cars",
      "audioFile": "fr_10_07f732f.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 1176,
      "updatedAt": "2026-08-24T22:59:42Z",
      "textHash": "a9a0215570dcbdbbc27c851488d55e37be016525dad584c6188d136267a526ee"
    },
    {
      "key": "0816b6b",
      "nodeTitle": "spawned_bridge_expert",
      "sourceText": "Un ponte ferroviario deve essere robusto.",
      "sourceEnText": "A train bridge must be strong.",
      "audioFile": "fr_10_0816b6b.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 2351,
      "updatedAt": "2026-08-24T23:00:06Z",
      "textHash": "8cacc947593c454a9741ba17c3d0b52f1f76d070283646e53883667374f7895c"
    },
    {
      "key": "084c7e4",
      "nodeTitle": "protagonist",
      "sourceText": "Fate una passeggiata lungo le rive della Senna e andate a vedere le foto!",
      "sourceEnText": "Take a walk along the banks of the Seine and find the photos!",
      "audioFile": "fr_10_084c7e4.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 3814,
      "updatedAt": "2026-08-24T22:58:19Z",
      "textHash": "377ae40bc3eb75df174447c26647d3c726d0d037335c654e1e1072a3fa7cbc9b"
    },
    {
      "key": "08b0aea",
      "nodeTitle": "protagonist",
      "sourceText": "Finalmente posso tornare a casa! Ho un'ultima domanda…",
      "sourceEnText": "I can finally go home! I have one last question…",
      "audioFile": "fr_10_08b0aea.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 3135,
      "updatedAt": "2026-08-24T22:58:16Z",
      "textHash": "f211e159192d125bd2ea54ee1ccd3b0485be19488084b662fcb381f898eadec5"
    },
    {
      "key": "08b1177",
      "nodeTitle": "npc_seine_map",
      "sourceText": "Osservate questa mappa della Senna.",
      "sourceEnText": "Look at this map of the Seine.",
      "audioFile": "fr_10_08b1177.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T22:59:43Z",
      "textHash": "6fb87966b659dfce2fedad4ce274ac808e5ecf2c5667baf270258deac1328117"
    },
    {
      "key": "08b4fad",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "per auto",
      "sourceEnText": "for cars",
      "audioFile": "fr_10_08b4fad.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 758,
      "updatedAt": "2026-08-24T22:59:31Z",
      "textHash": "f841f5037317edebad8813e819b82a80368d3d99848cd2dda88b01780a8b338c"
    },
    {
      "key": "08cc02a",
      "nodeTitle": "quest_end",
      "sourceText": "Importanti monumenti di Parigi sono stati costruiti intorno alla Senna.",
      "sourceEnText": "Important monuments in Paris were built around the Seine.",
      "audioFile": "fr_10_08cc02a.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 3788,
      "updatedAt": "2026-08-24T22:58:11Z",
      "textHash": "a033a25df30302f6d5c60be76359d068abe61f9e04404b8af6a0d544113e2298"
    },
    {
      "key": "08d8ef0",
      "nodeTitle": "spawned_bridge_expert",
      "sourceText": "Ogni giorno le auto attraversano il fiume.",
      "sourceEnText": "Cars cross the river every day.",
      "audioFile": "fr_10_08d8ef0.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 2377,
      "updatedAt": "2026-08-24T23:00:08Z",
      "textHash": "f504c1fca732f43a126effe5ee22a96645a05aeac093d29cc389c3d93e90289a"
    },
    {
      "key": "091e9fc",
      "nodeTitle": "quest_end",
      "sourceText": "Hai scoperto i ponti e le barche della Senna. I ponti permettono di attraversare il fiume che scorre attraverso Parigi: la Senna.",
      "sourceEnText": "You discovered the bridges and boats of the Seine. The bridges allow you to cross the river that flows through Paris: the Seine.",
      "audioFile": "fr_10_091e9fc.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 6792,
      "updatedAt": "2026-08-24T22:58:06Z",
      "textHash": "d9105a6bb46a0466bea518356f4f043355f48fff4f3b2232d1cb55ed65cec340"
    },
    {
      "key": "09731f9",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "Un ponte ferroviario è un ponte...",
      "sourceEnText": "A train bridge is a bridge...",
      "audioFile": "fr_10_09731f9.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1881,
      "updatedAt": "2026-08-24T22:59:28Z",
      "textHash": "afafc0dfa391b7e24ae8ae59f729661274127b2d5c3b938c1f0fa3cbacc6f8d5"
    },
    {
      "key": "099fe86",
      "nodeTitle": "question_seine_map",
      "sourceText": "Non è la risposta corretta. La Loira attraversa Nantes, vicino al Museo Jules Verne.",
      "sourceEnText": "That's not the correct answer. The Loire flows through Nantes, near the Jules Verne Museum.",
      "audioFile": "fr_10_099fe86.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 4859,
      "updatedAt": "2026-08-24T22:58:35Z",
      "textHash": "9981f2f1337e02dff40e2290647d739e0aaadfbf8f2b3210edc8a47980b8d4f1"
    },
    {
      "key": "09c706f",
      "nodeTitle": "npc_bridge_alexandre",
      "sourceText": "Questo è il Ponte Alessandro III. È un ponte molto famoso.",
      "sourceEnText": "This is the Alexander III Bridge. It's a very famous bridge.",
      "audioFile": "fr_10_09c706f.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 3500,
      "updatedAt": "2026-08-24T22:59:13Z",
      "textHash": "c434dc7eda8c20cae39cdfdc157c653ea6f351d1985cef9a679cd0ad25ec571c"
    },
    {
      "key": "09f3f7a",
      "nodeTitle": "npc_boat",
      "sourceText": "Un cane? Qui ci sono molti cani...",
      "sourceEnText": "A dog? There are many dogs here...",
      "audioFile": "fr_10_09f3f7a.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 2064,
      "updatedAt": "2026-08-24T22:59:48Z",
      "textHash": "483ab8be473cd3ce88d5cc54ae2b9ac8ed5d20d9eabb13bedc04ebfcefa820c4"
    },
    {
      "key": "0a0991d",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "È un ponte ferroviario!",
      "sourceEnText": "It's a bridge for trains!",
      "audioFile": "fr_10_0a0991d.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1463,
      "updatedAt": "2026-08-24T22:59:27Z",
      "textHash": "0e41dc28ccb170f1215f2f8235c882be3136e80610f743abd8b2c7a7dd91c1b0"
    },
    {
      "key": "0a29742",
      "nodeTitle": "quest_end",
      "sourceText": "Esistono case galleggianti. Le persone vivono su queste barche. Si chiamano chiatte.",
      "sourceEnText": "There are houseboats. People live on these boats. They are called barges.",
      "audioFile": "fr_10_0a29742.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 4989,
      "updatedAt": "2026-08-24T22:58:09Z",
      "textHash": "52bcbcef54cdffda6114b64c46886169d3b383f0a4445238cc5a265c907b5659"
    },
    {
      "key": "0a2bcd3",
      "nodeTitle": "question_seine_map",
      "sourceText": "Sì, è la Senna. Il fiume che attraversa Parigi si chiama Senna.",
      "sourceEnText": "Yes, it's the Seine. The river that flows through Paris is called the Seine.",
      "audioFile": "fr_10_0a2bcd3.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 3971,
      "updatedAt": "2026-08-24T22:58:38Z",
      "textHash": "68d012309a194f80d6a4173b332ecf3825b34a89f22bd57e3fdb7cc55e4714c2"
    },
    {
      "key": "0a627c2",
      "nodeTitle": "npc_boat_house",
      "sourceText": "Questa barca è una casa. Ci sono persone che vivono su questa barca. Questa barca si chiama casa galleggiante.",
      "sourceEnText": "This boat is a house. There are people who live on this boat. This boat is called a houseboat.",
      "audioFile": "fr_10_0a627c2.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 6060,
      "updatedAt": "2026-08-24T22:58:58Z",
      "textHash": "dbcb51309772403f6d8dbae243109cd50e9f8d1f09fe4ce7ab41ab154568c90a"
    },
    {
      "key": "0a70250",
      "nodeTitle": "protagonist",
      "sourceText": "Grazie!",
      "sourceEnText": "Thank you!",
      "audioFile": "fr_10_0a70250.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 862,
      "updatedAt": "2026-08-24T22:58:13Z",
      "textHash": "02cb0023be94e775ca225f86c17417f855bbc27eb9afa5c37522f8deaaa8b92d"
    },
    {
      "key": "0a9c8e7",
      "nodeTitle": "protagonist",
      "sourceText": "Avvicinatevi al fiume e troverete le foto!",
      "sourceEnText": "Walk near the river and you'll find the photos!",
      "audioFile": "fr_10_0a9c8e7.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2247,
      "updatedAt": "2026-08-24T22:58:28Z",
      "textHash": "fd0abc16528c703ab886486039e095532cb2d9f4d1267f6708f458d56f261500"
    },
    {
      "key": "0aa0f3a",
      "nodeTitle": "protagonist",
      "sourceText": "Aiuto! Aiutatemi!",
      "sourceEnText": "Help! Help me!",
      "audioFile": "fr_10_0aa0f3a.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1593,
      "updatedAt": "2026-08-24T22:58:23Z",
      "textHash": "382edc785f892b8f4488fbf82d65e43145437432bf5cbe2b1cf3dca079d4df69"
    },
    {
      "key": "0b12cb3",
      "nodeTitle": "npc_boat_goods",
      "sourceText": "Una nave mercantile può trasportare: legno, sabbia, ma anche oggetti: automobili, mobili...",
      "sourceEnText": "Boxes and things",
      "audioFile": "fr_10_0b12cb3.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 5642,
      "updatedAt": "2026-08-24T22:58:43Z",
      "textHash": "e08054a254f844b29882d0ebf0a3cdc74abf0644a0982a66d0d2cfe5c357bbad"
    },
    {
      "key": "0b37e92",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Disegna un ponte sul tuo quaderno!",
      "sourceEnText": "Draw a bridge in your notebook!",
      "audioFile": "fr_10_0b37e92.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1881,
      "updatedAt": "2026-08-24T22:58:12Z",
      "textHash": "ae2cceb573fda9f09df57f8291bc5ca27e21efd26e042149dc48fe3ce17fdd82"
    },
    {
      "key": "0ba2f29",
      "nodeTitle": "spawned_bridge_expert",
      "sourceText": "Alcuni ponti sono destinati esclusivamente ai pedoni.",
      "sourceEnText": "Some bridges are intended for pedestrians only.",
      "audioFile": "fr_10_0ba2f29.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 2952,
      "updatedAt": "2026-08-24T23:00:07Z",
      "textHash": "62af3fecaa8538956aa34b5b4af78c56f27b1b26caceb67267fcbdc33191a0db"
    },
    {
      "key": "0bbd3ce",
      "nodeTitle": "npc_boat_goods",
      "sourceText": "Turisti con le macchine fotografiche",
      "sourceEnText": "Tourists with cameras",
      "audioFile": "fr_10_0bbd3ce.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T22:58:46Z",
      "textHash": "e77508bda29972eaf744555b448da56f7c01c6a9a0ac2b6d0712b1b83748836b"
    },
    {
      "key": "0bfcb05",
      "nodeTitle": "protagonist",
      "sourceText": "Se non riuscite a trovarli, potete usare la mappa di Parigi per localizzarli!",
      "sourceEnText": "If you can't find them, you can use the map of Paris to locate them!",
      "audioFile": "fr_10_0bfcb05.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 4049,
      "updatedAt": "2026-08-24T22:58:21Z",
      "textHash": "b324ca24daf81e1c3df2d1991139cab65bfcd59b1c39026916a61ded68ea3e5e"
    },
    {
      "key": "0c408c3",
      "nodeTitle": "quest_end",
      "sourceText": "Ottimo, hai completato questa missione!",
      "sourceEnText": "Great, you've completed this quest!",
      "audioFile": "fr_10_0c408c3.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2247,
      "updatedAt": "2026-08-24T22:58:05Z",
      "textHash": "04629093bd1ac5aaf865d53aad23a4cc6542d7d917ffbd286af10ef94b54ae89"
    },
    {
      "key": "0c86d26",
      "nodeTitle": "npc_boat_house",
      "sourceText": "È possibile viverci.",
      "sourceEnText": "It's possible to live there.",
      "audioFile": "fr_10_0c86d26.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1463,
      "updatedAt": "2026-08-24T22:59:01Z",
      "textHash": "2a8e1593bda724cf026887b83b68a6c2a4953bc833dafb53dc9d5d1934e0a606"
    },
    {
      "key": "0c8cdae",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "È obbligatorio camminare sul marciapiede e attraversare sulle strisce pedonali.",
      "sourceEnText": "Use the sidewalk and cross at the crossing",
      "audioFile": "fr_10_0c8cdae.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 4049,
      "updatedAt": "2026-08-24T22:59:22Z",
      "textHash": "ad40d1f18047f40757fcdf1d591b07f24d1ae2689ec2cc62eecbbc825aeda42b"
    },
    {
      "key": "0c8e7b6",
      "nodeTitle": "protagonist",
      "sourceText": "Le pagine del mio libro e le foto sono cadute vicino alla Senna!",
      "sourceEnText": "The pages of my book and the photos fell near the Seine!",
      "audioFile": "fr_10_0c8e7b6.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 3213,
      "updatedAt": "2026-08-24T22:58:26Z",
      "textHash": "bd7d7e7870368746ac11803845274315d02283c37f86d51b35f35de77bd1831b"
    },
    {
      "key": "0cf371b",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "Devi camminare sulla strada",
      "sourceEnText": "You have to walk on the road",
      "audioFile": "fr_10_0cf371b.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1515,
      "updatedAt": "2026-08-24T22:59:25Z",
      "textHash": "40fd93a1ac8d4d87afdf3d0b0bc39768f3691531c2f1d941c0a8e20866c1aa6d"
    },
    {
      "key": "0d1724c",
      "nodeTitle": "spawned_river_friend",
      "sourceText": "Il fiume sfocia nel mare.",
      "sourceEnText": "The river flows into the sea.",
      "audioFile": "fr_10_0d1724c.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_F",
      "durationMs": 1463,
      "updatedAt": "2026-08-24T23:00:13Z",
      "textHash": "bac0fc39f1c2a1b553b2ac7466a9e7879aa51809ea3b2facfc698d19baac74bd"
    },
    {
      "key": "0d79d7d",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "È un ponte per auto!",
      "sourceEnText": "It's a bridge for cars!",
      "audioFile": "fr_10_0d79d7d.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1280,
      "updatedAt": "2026-08-24T22:59:20Z",
      "textHash": "ed83f2a88e15853f1c88be657ad45680237e2b1fc7d7ba669c1238e42030a327"
    },
    {
      "key": "0d94ea8",
      "nodeTitle": "spawned_french_man",
      "sourceText": "Parigi è la città più bella del mondo!",
      "sourceEnText": "Paris is the most beautiful city in the world!",
      "audioFile": "fr_10_0d94ea8.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 2351,
      "updatedAt": "2026-08-24T23:00:03Z",
      "textHash": "232cb08d8c1b55ec002c21730c1e26cf6b5dc0a5e3c6ec6ac557c5726a5805d2"
    },
    {
      "key": "0d9bc29",
      "nodeTitle": "npc_bridge_alexandre",
      "sourceText": "Si tratta di un ponte per automobili.",
      "sourceEnText": "It's a bridge for cars.",
      "audioFile": "fr_10_0d9bc29.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2064,
      "updatedAt": "2026-08-24T22:59:18Z",
      "textHash": "c5a8006eae7a95d2290896b81e4e94667730a0a9bfaf9f2b03f3af7a4229c902"
    },
    {
      "key": "0e48593",
      "nodeTitle": "npc_bridge_people",
      "sourceText": "Passerella",
      "sourceEnText": "Footbridge",
      "audioFile": "fr_10_0e48593.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 888,
      "updatedAt": "2026-08-24T22:59:39Z",
      "textHash": "e2a79c8dd8f50a3726f2a19e1fd56bdb96bc04ce98f2524540cd329ebc987ffb"
    },
    {
      "key": "0ec822e",
      "nodeTitle": "spawned_river_friend",
      "sourceText": "La Senna permette alle imbarcazioni di circolare a Parigi.",
      "sourceEnText": "The Seine allows boats to circulate in Paris.",
