      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 4885,
      "updatedAt": "2026-08-24T22:50:54Z",
      "textHash": "1443b6d0ca80b63199c6a62c55eafe47f615d6ecfcdffed02b57f89be5c8d839"
