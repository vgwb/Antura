    {
      "key": "02ce3de",
      "nodeTitle": "npc_boat_people",
      "sourceText": "لماذا تحتوي القوارب السياحية على نوافذ كبيرة؟",
      "sourceEnText": "Why does a tourist boat have big windows?",
      "audioFile": "fr_10_02ce3de.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 3187,
      "updatedAt": "2026-08-24T22:50:17Z",
      "textHash": "5d085421a52c04bb0ed4ccd128677e0284668b01ce6260ac8c08e2a4342bb5c4"
    },
    {
      "key": "02ed36d",
      "nodeTitle": "npc_boat",
      "sourceText": "نعم، رأيت كلباً يتجول.",
      "sourceEnText": "I did see a dog walking around, yes.",
      "audioFile": "fr_10_02ed36d.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_M",
