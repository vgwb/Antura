      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 2377,
      "updatedAt": "2026-08-24T22:50:23Z",
      "textHash": "7c0c0eded21f22b2039d647615abefa5382099d0411203df37eb597471afcb91"
    },
    {
      "key": "02349a3",
      "nodeTitle": "npc_boat_people",
      "sourceText": "لنقل السيارات",
      "sourceEnText": "To transport cars",
      "audioFile": "fr_10_02349a3.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 1541,
