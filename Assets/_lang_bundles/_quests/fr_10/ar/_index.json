    {
      "key": "01f30c4",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "السيارات تسير بسرعة. كيف يمكنني عبور الطريق بأمان؟",
      "sourceEnText": "The cars are driving fast. How can I cross safely?",
      "audioFile": "fr_10_01f30c4.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 4650,
      "updatedAt": "2026-08-24T22:50:31Z",
      "textHash": "cd7f2ebf90c219acbe45fc799a1314e614a989087a4f7c55782edf92f2474ee0"
    },
    {
      "key": "0210ef0",
      "nodeTitle": "protagonist",
      "sourceText": "أنا أزور باريس. أنا سائح. أخذ الكلب أنتورا كتابي عن باريس!",
      "sourceEnText": "I'm visiting Paris. I'm a tourist. Antura the dog took my book about Paris!",
