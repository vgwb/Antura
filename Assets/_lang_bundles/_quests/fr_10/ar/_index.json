      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 6322,
      "updatedAt": "2026-08-24T22:49:34Z",
      "textHash": "eeac311257ebc59ad51f6fa6306a047141bf703b25830a1878b94798d7464a0f"
    },
    {
      "key": "021f382",
      "nodeTitle": "npc_bridge_alexandre",
      "sourceText": "لماذا يشتهر هذا الجسر؟",
      "sourceEnText": "What is special about this famous bridge?",
