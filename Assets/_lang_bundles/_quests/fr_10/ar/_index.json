      "textHash": "a5a0f1dbc026de1c2209de7bcb9846afb7a1eed86ea5b95d7e136de1866ddc78"
    },
    {
      "key": "018a0eb",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "قوي جداً",
      "sourceEnText": "Very strong",
      "audioFile": "fr_10_018a0eb.mp3",
      "voiceProfile": "haytham",
