      "textHash": "3edad4ac06c2cd8c4ef9c40ea2727ba3ca54189375600d1cb7fa848476b75d69"
    },
    {
      "key": "06d2470",
      "nodeTitle": "spawned_river_friend",
      "sourceText": "Hărțile prezintă meandrele râului.",
      "sourceEnText": "The maps show the meanders of the river.",
      "audioFile": "fr_10_06d2470.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 2142,
      "updatedAt": "2026-08-24T23:06:03Z",
      "textHash": "3f21ad00fac0b25d97f390965ba70d488eb03e84d9f5869f8134f4b2b9363223"
    },
    {
      "key": "072a345",
      "nodeTitle": "spawned_french_woman",
      "sourceText": "Bună dimineaţa!",
      "sourceEnText": "Good morning!",
      "audioFile": "fr_10_072a345.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 1123,
      "updatedAt": "2026-08-24T23:05:44Z",
      "textHash": "6e6d9ea99bb90819fcd9e03bccb40cfc2caf5bc6ea6f1da5798ddbc795c550de"
    },
    {
      "key": "074efa5",
      "nodeTitle": "facts_river",
      "sourceText": "Sena se varsă în Canalul Mânecii.",
      "sourceEnText": "The Seine flows into the English Channel.",
      "audioFile": "fr_10_074efa5.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2351,
      "updatedAt": "2026-08-24T23:05:42Z",
      "textHash": "479fc770b3df1922f8df78ca9dca121e5ae9bd687b0398d1cf4d52b69662ab01"
    },
    {
      "key": "076ee7f",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "Poți traversa strada oriunde.",
      "sourceEnText": "You can cross the road anywhere.",
      "audioFile": "fr_10_076ee7f.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2011,
      "updatedAt": "2026-08-24T23:05:09Z",
      "textHash": "164a18a4b0768200d6b1b9a1611cf536115338ec918969b7c964d3bb23f25582"
    },
    {
      "key": "07cac48",
      "nodeTitle": "protagonist",
      "sourceText": "Ai găsit toate fotografiile din ghidul meu!",
      "sourceEnText": "You found all the photos from my guide!",
      "audioFile": "fr_10_07cac48.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2377,
      "updatedAt": "2026-08-24T23:03:54Z",
      "textHash": "aca8e1d14577335c29d56f2a20fce8d3df6cc32294393d97618eee79d6ef0d9b"
    },
    {
      "key": "07f732f",
      "nodeTitle": "npc_bridge_people",
      "sourceText": "un pod pentru mașini",
      "sourceEnText": "a bridge for cars",
      "audioFile": "fr_10_07f732f.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_M",
      "durationMs": 1463,
      "updatedAt": "2026-08-24T23:05:28Z",
      "textHash": "2d9d129fdceb524fa2122edcaed3b9180ae32abc3dedb0e93b3b3d2b14824683"
    },
    {
      "key": "0816b6b",
      "nodeTitle": "spawned_bridge_expert",
      "sourceText": "Un pod de cale ferată trebuie să fie rezistent.",
      "sourceEnText": "A train bridge must be strong.",
      "audioFile": "fr_10_0816b6b.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_M",
      "durationMs": 2952,
      "updatedAt": "2026-08-24T23:05:56Z",
      "textHash": "1f62532b34a452262d23325ba000b9e81cb9fe62a4e9efb9a0b8d67cf2e8071c"
    },
    {
      "key": "084c7e4",
      "nodeTitle": "protagonist",
      "sourceText": "Fă o plimbare pe malurile Senei și găsește fotografiile!",
      "sourceEnText": "Take a walk along the banks of the Seine and find the photos!",
      "audioFile": "fr_10_084c7e4.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 3448,
      "updatedAt": "2026-08-24T23:04:00Z",
      "textHash": "87c50dbd3b0289a0398e18591e6d59983b882026bcbad86db560b158649ff080"
    },
    {
      "key": "08b0aea",
      "nodeTitle": "protagonist",
      "sourceText": "În sfârșit pot merge acasă! Mai am o ultimă întrebare…",
      "sourceEnText": "I can finally go home! I have one last question…",
      "audioFile": "fr_10_08b0aea.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 3631,
      "updatedAt": "2026-08-24T23:03:56Z",
      "textHash": "1ee46dde536fdf7cccfc66c472dbd76739ef3939dffe69e51d321d4ef133c01e"
    },
    {
      "key": "08b1177",
      "nodeTitle": "npc_seine_map",
      "sourceText": "Uită-te la această hartă a Senei.",
      "sourceEnText": "Look at this map of the Seine.",
      "audioFile": "fr_10_08b1177.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T23:05:30Z",
      "textHash": "e20284ac3dfa39a6966c8106de6331b5d90b24997f5f3e0f0dec32cf844f810b"
    },
    {
      "key": "08b4fad",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "pentru mașini",
      "sourceEnText": "for cars",
      "audioFile": "fr_10_08b4fad.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1045,
      "updatedAt": "2026-08-24T23:05:16Z",
      "textHash": "72abd9d92064681aee129bf5ba9858ca9ece4a2c0cc1fae4cfed6b3588175c81"
    },
    {
      "key": "08cc02a",
      "nodeTitle": "quest_end",
      "sourceText": "Monumente importante din Paris au fost construite în jurul Senei.",
      "sourceEnText": "Important monuments in Paris were built around the Seine.",
      "audioFile": "fr_10_08cc02a.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 3814,
      "updatedAt": "2026-08-24T23:03:50Z",
      "textHash": "8d4208e525dffe63a875fc07a83074b12adef63304eff207f89dc27816b9d0a9"
    },
    {
      "key": "08d8ef0",
      "nodeTitle": "spawned_bridge_expert",
      "sourceText": "Mașinile traversează râul în fiecare zi.",
      "sourceEnText": "Cars cross the river every day.",
      "audioFile": "fr_10_08d8ef0.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_M",
      "durationMs": 2482,
      "updatedAt": "2026-08-24T23:06:00Z",
      "textHash": "78b414f2279d808e0f3f61dd8a60664898bd081c821bab67cfa1b70c247fb12a"
    },
    {
      "key": "091e9fc",
      "nodeTitle": "quest_end",
      "sourceText": "Ai descoperit podurile și bărcile de pe Sena. Podurile îți permit să traversezi râul care curge prin Paris: Sena.",
      "sourceEnText": "You discovered the bridges and boats of the Seine. The bridges allow you to cross the river that flows through Paris: the Seine.",
      "audioFile": "fr_10_091e9fc.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 6609,
      "updatedAt": "2026-08-24T23:03:44Z",
      "textHash": "ddabf9e1a6e8b98b675c8faa5017bb99db329e2331c9add2fbcc6f95e0a59351"
    },
    {
      "key": "09731f9",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "Un pod feroviar este un pod...",
      "sourceEnText": "A train bridge is a bridge...",
      "audioFile": "fr_10_09731f9.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1933,
      "updatedAt": "2026-08-24T23:05:13Z",
      "textHash": "16dfe2bc8b4a94ff0eb2c64e1f422f099c92f72d4f9c0c00302bf65597d04bb1"
    },
    {
      "key": "099fe86",
      "nodeTitle": "question_seine_map",
      "sourceText": "Acesta nu este răspunsul corect. Loara curge prin Nantes, în apropierea Muzeului Jules Verne.",
      "sourceEnText": "That's not the correct answer. The Loire flows through Nantes, near the Jules Verne Museum.",
      "audioFile": "fr_10_099fe86.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 5538,
      "updatedAt": "2026-08-24T23:04:18Z",
      "textHash": "ffd79027e161facd1c6953594047e1ea31ff289c2794d2d9d55d79ec92cc9ab0"
    },
    {
      "key": "09c706f",
      "nodeTitle": "npc_bridge_alexandre",
      "sourceText": "Acesta este Podul Alexandru al III-lea. Este un pod foarte faimos.",
      "sourceEnText": "This is the Alexander III Bridge. It's a very famous bridge.",
      "audioFile": "fr_10_09c706f.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 4232,
      "updatedAt": "2026-08-24T23:04:58Z",
      "textHash": "70a12c0f16a3ad8de77064abaf290ebce5f19247822b46edcd0985c9cb948659"
    },
    {
      "key": "09f3f7a",
      "nodeTitle": "npc_boat",
      "sourceText": "Un câine? Sunt mulți câini aici...",
      "sourceEnText": "A dog? There are many dogs here...",
      "audioFile": "fr_10_09f3f7a.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_M",
      "durationMs": 2560,
      "updatedAt": "2026-08-24T23:05:34Z",
      "textHash": "747d3cb5c8daabdde98041ad98521a9826f63d5378f520a078b29fd98d428542"
    },
    {
      "key": "0a0991d",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "E un pod pentru trenuri!",
      "sourceEnText": "It's a bridge for trains!",
      "audioFile": "fr_10_0a0991d.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1541,
      "updatedAt": "2026-08-24T23:05:12Z",
      "textHash": "a980ddf06f628a69511e3752a5ccc552cef3d829bf9bfd2ab316687be614ca4a"
    },
    {
      "key": "0a29742",
      "nodeTitle": "quest_end",
      "sourceText": "Există case plutitoare. Oamenii locuiesc pe aceste bărci. Se numesc barje.",
      "sourceEnText": "There are houseboats. People live on these boats. They are called barges.",
      "audioFile": "fr_10_0a29742.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 4885,
      "updatedAt": "2026-08-24T23:03:48Z",
      "textHash": "7aa62c25c5340d2ee80a3dd494575e7d7eb41b8c4f59b88210244dbc89f8752d"
    },
    {
      "key": "0a2bcd3",
      "nodeTitle": "question_seine_map",
      "sourceText": "Da, este Sena. Râul care curge prin Paris se numește Sena.",
      "sourceEnText": "Yes, it's the Seine. The river that flows through Paris is called the Seine.",
      "audioFile": "fr_10_0a2bcd3.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 4049,
      "updatedAt": "2026-08-24T23:04:21Z",
      "textHash": "756a3b3372c1567c48c91b7f99585f370b37cf999e8f1116730932dff0f611ab"
    },
    {
      "key": "0a627c2",
      "nodeTitle": "npc_boat_house",
      "sourceText": "Această barcă este o casă. Sunt oameni care locuiesc pe această barcă. Această barcă se numește casă plutitoare.",
      "sourceEnText": "This boat is a house. There are people who live on this boat. This boat is called a houseboat.",
      "audioFile": "fr_10_0a627c2.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 7158,
      "updatedAt": "2026-08-24T23:04:44Z",
      "textHash": "1ba686f4cdd522d528cfe8022d511f9b503b46101af7cf8480748cec89609bef"
    },
    {
      "key": "0a70250",
      "nodeTitle": "protagonist",
      "sourceText": "Mulțumesc!",
      "sourceEnText": "Thank you!",
      "audioFile": "fr_10_0a70250.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1045,
      "updatedAt": "2026-08-24T23:03:53Z",
      "textHash": "7a5533723a8e80b5d42ac0ed5b4855e70194dc893310eac1519ade3b1da1f321"
    },
    {
      "key": "0a9c8e7",
      "nodeTitle": "protagonist",
      "sourceText": "Mergeți pe lângă râu și veți găsi fotografiile!",
      "sourceEnText": "Walk near the river and you'll find the photos!",
      "audioFile": "fr_10_0a9c8e7.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2847,
      "updatedAt": "2026-08-24T23:04:10Z",
      "textHash": "a165aee5d5a3427513a4561bdf83325329565eeeedf0ce2895257f1c5e7a240b"
    },
    {
      "key": "0aa0f3a",
      "nodeTitle": "protagonist",
      "sourceText": "Ajutor! Ajută-mă!",
      "sourceEnText": "Help! Help me!",
      "audioFile": "fr_10_0aa0f3a.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1515,
      "updatedAt": "2026-08-24T23:04:05Z",
      "textHash": "99a23d22acbae9b04820d8101f488b5269b808a1006072d7fcf5a24205c22bc3"
    },
    {
      "key": "0b12cb3",
      "nodeTitle": "npc_boat_goods",
      "sourceText": "O navă de marfă poate transporta: lemn, nisip, dar și obiecte: mașini, mobilă...",
      "sourceEnText": "Boxes and things",
      "audioFile": "fr_10_0b12cb3.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 5460,
      "updatedAt": "2026-08-24T23:04:28Z",
      "textHash": "84401bc722e203651fbdcd1c8e52c24945931aba5127fa8a72a2f3c35ae6c8b7"
    },
    {
      "key": "0b37e92",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Desenează un pod în caietul tău!",
      "sourceEnText": "Draw a bridge in your notebook!",
      "audioFile": "fr_10_0b37e92.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T23:03:51Z",
      "textHash": "4e76e762b84fb39429e8f76e2e442942ee0926636eec391643536c721f66e9eb"
    },
    {
      "key": "0ba2f29",
      "nodeTitle": "spawned_bridge_expert",
      "sourceText": "Unele poduri sunt destinate exclusiv pietonilor.",
      "sourceEnText": "Some bridges are intended for pedestrians only.",
      "audioFile": "fr_10_0ba2f29.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_M",
      "durationMs": 3135,
      "updatedAt": "2026-08-24T23:05:58Z",
      "textHash": "2343e7817c10b6094208ad35e8ccc9d69e5098d41c72060a9a2a0a5202aa7ef4"
    },
    {
      "key": "0bbd3ce",
      "nodeTitle": "npc_boat_goods",
      "sourceText": "Turiști cu camere de filmat",
      "sourceEnText": "Tourists with cameras",
      "audioFile": "fr_10_0bbd3ce.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1776,
      "updatedAt": "2026-08-24T23:04:31Z",
      "textHash": "aa45e10e87397f8fea6f41069936711e061f4e92b8658bae5e34586348ff0ed5"
    },
    {
      "key": "0bfcb05",
      "nodeTitle": "protagonist",
      "sourceText": "Dacă nu le găsiți, puteți folosi harta Parisului pentru a le localiza!",
      "sourceEnText": "If you can't find them, you can use the map of Paris to locate them!",
      "audioFile": "fr_10_0bfcb05.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 4023,
      "updatedAt": "2026-08-24T23:04:01Z",
      "textHash": "7cbae0f4d251a8263ef74edd35709e4b74d9e0c3c57909158c2d279a5dbd7190"
    },
    {
      "key": "0c408c3",
      "nodeTitle": "quest_end",
      "sourceText": "Grozav, ai finalizat această misiune!",
      "sourceEnText": "Great, you've completed this quest!",
      "audioFile": "fr_10_0c408c3.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2377,
      "updatedAt": "2026-08-24T23:03:43Z",
      "textHash": "fba03f075617ec1e753d18060b00693756ab4ff6dfe78fda8e8759b4619298f1"
    },
    {
      "key": "0c86d26",
      "nodeTitle": "npc_boat_house",
      "sourceText": "E posibil să locuiești acolo.",
      "sourceEnText": "It's possible to live there.",
      "audioFile": "fr_10_0c86d26.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T23:04:47Z",
      "textHash": "f270079d05c6a1265c5159cff1a9855243327f8acb25c7645ac40f3623a64947"
    },
    {
      "key": "0c8cdae",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "Trebuie să mergeți pe trotuar și să traversați la trecerea de pietoni.",
      "sourceEnText": "Use the sidewalk and cross at the crossing",
      "audioFile": "fr_10_0c8cdae.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 3814,
      "updatedAt": "2026-08-24T23:05:08Z",
      "textHash": "8c815c12eb339d7ab378d7a17d5827b6f036cefd5837421f0c8b96cf9ed8c766"
    },
    {
      "key": "0c8e7b6",
      "nodeTitle": "protagonist",
      "sourceText": "Paginile cărții mele și fotografiile au căzut lângă Sena!",
      "sourceEnText": "The pages of my book and the photos fell near the Seine!",
      "audioFile": "fr_10_0c8e7b6.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 3213,
      "updatedAt": "2026-08-24T23:04:08Z",
      "textHash": "a7b4886c408f5684c240c4b0ef02eec8daa9c2117435f093fbee7602d832b266"
    },
    {
      "key": "0cf371b",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "Trebuie să mergi pe drum",
      "sourceEnText": "You have to walk on the road",
      "audioFile": "fr_10_0cf371b.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1646,
      "updatedAt": "2026-08-24T23:05:11Z",
      "textHash": "b5869a95c27b740c8e43b411177e4b71da3f93b557631add96e6e1a6d0f81a1b"
    },
    {
      "key": "0d1724c",
      "nodeTitle": "spawned_river_friend",
      "sourceText": "Râul se varsă în mare.",
      "sourceEnText": "The river flows into the sea.",
      "audioFile": "fr_10_0d1724c.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 1646,
      "updatedAt": "2026-08-24T23:06:04Z",
      "textHash": "1b58151cc8de73cfdcecfe426f17047b31cafbae4315737d8566e8010c8ec400"
    },
    {
      "key": "0d79d7d",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "E un pod pentru mașini!",
      "sourceEnText": "It's a bridge for cars!",
      "audioFile": "fr_10_0d79d7d.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1463,
      "updatedAt": "2026-08-24T23:05:05Z",
      "textHash": "25ebc4a169725010ee08eeab35b1d2384ab8cd81f122f352bbfef24694d37bbc"
    },
    {
      "key": "0d94ea8",
      "nodeTitle": "spawned_french_man",
      "sourceText": "Parisul este cel mai frumos oraș din lume!",
      "sourceEnText": "Paris is the most beautiful city in the world!",
      "audioFile": "fr_10_0d94ea8.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_M",
      "durationMs": 2482,
      "updatedAt": "2026-08-24T23:05:53Z",
      "textHash": "1c273e646566d2bcfbee6de732df49ede9037e86ea4342a05024db864d35b78d"
    },
    {
      "key": "0d9bc29",
      "nodeTitle": "npc_bridge_alexandre",
      "sourceText": "Este un pod pentru mașini.",
      "sourceEnText": "It's a bridge for cars.",
      "audioFile": "fr_10_0d9bc29.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1646,
      "updatedAt": "2026-08-24T23:05:04Z",
      "textHash": "5cf41fa8d544b219dde2cae403e87471d29b0f284a8d90f0563c4688753814e9"
    },
    {
      "key": "0e48593",
      "nodeTitle": "npc_bridge_people",
      "sourceText": "Pasarelă",
      "sourceEnText": "Footbridge",
      "audioFile": "fr_10_0e48593.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_M",
