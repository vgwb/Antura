    },
    {
      "key": "06aa0c1",
      "nodeTitle": "spawned_french_man",
      "sourceText": "Szia!",
      "sourceEnText": "Hi!",
      "audioFile": "fr_10_06aa0c1.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 679,
      "updatedAt": "2026-08-24T22:57:42Z",
      "textHash": "cee55d470611dbd3f989d027cb533a674183c8f6c4be607d5b7367cca5583c8b"
    },
    {
      "key": "06d2470",
      "nodeTitle": "spawned_river_friend",
      "sourceText": "A térképek a folyó kanyarulatait mutatják.",
      "sourceEnText": "The maps show the meanders of the river.",
      "audioFile": "fr_10_06d2470.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2717,
      "updatedAt": "2026-08-24T22:57:53Z",
      "textHash": "8dd5ad95c0e150bd77e324a18c3d6d88acff585a6b8fdd191c8555500a33d9f6"
    },
    {
      "key": "072a345",
      "nodeTitle": "spawned_french_woman",
      "sourceText": "Jó reggelt!",
      "sourceEnText": "Good morning!",
      "audioFile": "fr_10_072a345.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 993,
      "updatedAt": "2026-08-24T22:57:38Z",
      "textHash": "ce7df6c863c1d1b408f9be582c02c2994aa2169efffe1099e717c6f7b5273924"
    },
    {
      "key": "074efa5",
      "nodeTitle": "facts_river",
      "sourceText": "A Szajna a La Manche csatornába ömlik.",
      "sourceEnText": "The Seine flows into the English Channel.",
      "audioFile": "fr_10_074efa5.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2482,
      "updatedAt": "2026-08-24T22:57:36Z",
      "textHash": "132875f714cbcacf2271f2a14a1a76de24cfd5381594980ed2c8861de487bf15"
    },
    {
      "key": "076ee7f",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "Bárhol átkelhetsz az úton.",
      "sourceEnText": "You can cross the road anywhere.",
      "audioFile": "fr_10_076ee7f.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2064,
      "updatedAt": "2026-08-24T22:57:07Z",
      "textHash": "4ffb103bdfda100e20fcd4f998690c9c54725e6a49660159c6d7369167db60dc"
    },
    {
      "key": "07cac48",
      "nodeTitle": "protagonist",
      "sourceText": "Megtaláltad az összes képet az útmutatómból!",
      "sourceEnText": "You found all the photos from my guide!",
      "audioFile": "fr_10_07cac48.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2560,
      "updatedAt": "2026-08-24T22:55:59Z",
      "textHash": "df42728fa08ac25c7cc8a53146a1f0253953c782bf3845fe110931b2265ca3f7"
    },
    {
      "key": "07f732f",
      "nodeTitle": "npc_bridge_people",
      "sourceText": "egy híd autóknak",
      "sourceEnText": "a bridge for cars",
      "audioFile": "fr_10_07f732f.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1280,
      "updatedAt": "2026-08-24T22:57:24Z",
      "textHash": "03094edc1017084e386ea952b355eb4cb95fb20edddf9f1418f3e5f0a876df58"
    },
    {
      "key": "0816b6b",
      "nodeTitle": "spawned_bridge_expert",
      "sourceText": "Egy vasúti hídnak erősnek kell lennie.",
      "sourceEnText": "A train bridge must be strong.",
      "audioFile": "fr_10_0816b6b.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 2429,
      "updatedAt": "2026-08-24T22:57:47Z",
      "textHash": "ad4ea01ffc82b17d47a86e985fa9a3fdd985d63c1c887a3a5f10b17ede6dba2b"
    },
    {
      "key": "084c7e4",
      "nodeTitle": "protagonist",
      "sourceText": "Sétálj egyet a Szajna partján, és keresd meg a fotókat!",
      "sourceEnText": "Take a walk along the banks of the Seine and find the photos!",
      "audioFile": "fr_10_084c7e4.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3135,
      "updatedAt": "2026-08-24T22:56:03Z",
      "textHash": "3bf9205e6ea91ddb56c23c44da78f9e8d0d9db9794793b26f3a1252462bf6b12"
    },
    {
      "key": "08b0aea",
      "nodeTitle": "protagonist",
      "sourceText": "Végre hazamehetek! Van egy utolsó kérdésem…",
      "sourceEnText": "I can finally go home! I have one last question…",
      "audioFile": "fr_10_08b0aea.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2560,
      "updatedAt": "2026-08-24T22:56:01Z",
      "textHash": "8d391791b1ec304fd71b54695e3976f744bc8be934101094e151f5b077a9c423"
    },
    {
      "key": "08b1177",
      "nodeTitle": "npc_seine_map",
      "sourceText": "Nézd meg ezt a Szajna térképet.",
      "sourceEnText": "Look at this map of the Seine.",
      "audioFile": "fr_10_08b1177.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1881,
      "updatedAt": "2026-08-24T22:57:25Z",
      "textHash": "ba2b48cd9127d8b55703db2c70d8f4482add3d8f43107357e1414d5a1f2de7c7"
    },
    {
      "key": "08b4fad",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "autókhoz",
      "sourceEnText": "for cars",
      "audioFile": "fr_10_08b4fad.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1045,
      "updatedAt": "2026-08-24T22:57:13Z",
      "textHash": "89573ad627f17d6ec07bd9836c69020d6bafde5c7743fb835ecd2f9072704c47"
    },
    {
      "key": "08cc02a",
      "nodeTitle": "quest_end",
      "sourceText": "Párizsban fontos emlékműveket építettek a Szajna környékén.",
      "sourceEnText": "Important monuments in Paris were built around the Seine.",
      "audioFile": "fr_10_08cc02a.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3553,
      "updatedAt": "2026-08-24T22:55:55Z",
      "textHash": "ce827ef0dcf86cac4b4179dfe3191534a572e4426424baab32fdae274225c688"
    },
    {
      "key": "08d8ef0",
      "nodeTitle": "spawned_bridge_expert",
      "sourceText": "Az autók minden nap átkelnek a folyón.",
      "sourceEnText": "Cars cross the river every day.",
      "audioFile": "fr_10_08d8ef0.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 2142,
      "updatedAt": "2026-08-24T22:57:50Z",
      "textHash": "f69e0b4edbf7e5ae60cf4dd471f8f058c910141364c1ac95fdc5b576041876b0"
    },
    {
      "key": "091e9fc",
      "nodeTitle": "quest_end",
      "sourceText": "Felfedezted a Szajna hídjait és hajóit. A hidak segítségével kelhetsz át a Párizson átfolyó folyón: a Szajnán.",
      "sourceEnText": "You discovered the bridges and boats of the Seine. The bridges allow you to cross the river that flows through Paris: the Seine.",
      "audioFile": "fr_10_091e9fc.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 7549,
      "updatedAt": "2026-08-24T22:55:51Z",
      "textHash": "b57a78a28e3f2564d74615db2c5a9b5e9795642a667377c1bbf1627d34f2d7ea"
    },
    {
      "key": "09731f9",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "A vasúti híd az egy híd...",
      "sourceEnText": "A train bridge is a bridge...",
      "audioFile": "fr_10_09731f9.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1724,
      "updatedAt": "2026-08-24T22:57:11Z",
      "textHash": "38c986e905fc809616117b8c1cf3542357bf5635a960f0e71496035d504cfaae"
    },
    {
      "key": "099fe86",
      "nodeTitle": "question_seine_map",
      "sourceText": "Ez nem a helyes válasz. A Loire átfolyik Nantes-on, a Jules Verne Múzeum közelében.",
      "sourceEnText": "That's not the correct answer. The Loire flows through Nantes, near the Jules Verne Museum.",
      "audioFile": "fr_10_099fe86.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 5303,
      "updatedAt": "2026-08-24T22:56:19Z",
      "textHash": "a5801ae89c842e4e13e3a2f820e3b8c2f9692c809d314a17c756be5d63eaa91c"
    },
    {
      "key": "09c706f",
      "nodeTitle": "npc_bridge_alexandre",
      "sourceText": "Ez a III. Sándor híd. Nagyon híres híd.",
      "sourceEnText": "This is the Alexander III Bridge. It's a very famous bridge.",
      "audioFile": "fr_10_09c706f.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2351,
      "updatedAt": "2026-08-24T22:56:56Z",
      "textHash": "eb8bd69adedcb6b1f27a17fcb30a82449f8e5c3917b7318c7c11fa3160930357"
    },
    {
      "key": "09f3f7a",
      "nodeTitle": "npc_boat",
      "sourceText": "Egy kutya? Sok kutya van itt...",
      "sourceEnText": "A dog? There are many dogs here...",
      "audioFile": "fr_10_09f3f7a.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1933,
      "updatedAt": "2026-08-24T22:57:30Z",
      "textHash": "673aabc971c19cdde8322e28aa974646ba914b3f996810c0f6d1df5fdf2eefc3"
    },
    {
      "key": "0a0991d",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "Ez egy híd a vonatoknak!",
      "sourceEnText": "It's a bridge for trains!",
      "audioFile": "fr_10_0a0991d.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1541,
      "updatedAt": "2026-08-24T22:57:09Z",
      "textHash": "d66d256226f6ebf268215576c6b44182683d41ed1836fd8250e54c9336e7c476"
    },
    {
      "key": "0a29742",
      "nodeTitle": "quest_end",
      "sourceText": "Vannak lakóhajók. Emberek laknak ezeken a hajókon. Bárkáknak hívják őket.",
      "sourceEnText": "There are houseboats. People live on these boats. They are called barges.",
      "audioFile": "fr_10_0a29742.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 4989,
      "updatedAt": "2026-08-24T22:55:54Z",
      "textHash": "32f51279c26fac4032ddf5420f054c895c465ac14a447485698b8f4e0ddc8edd"
    },
    {
      "key": "0a2bcd3",
      "nodeTitle": "question_seine_map",
      "sourceText": "Igen, ez a Szajna. A Párizson átfolyó folyót Szajnának hívják.",
      "sourceEnText": "Yes, it's the Seine. The river that flows through Paris is called the Seine.",
      "audioFile": "fr_10_0a2bcd3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 4441,
      "updatedAt": "2026-08-24T22:56:21Z",
      "textHash": "4ae81016b3f1cac060df7f5ddebd22d8b4970e7f1696356f7932e746985793a3"
    },
    {
      "key": "0a627c2",
      "nodeTitle": "npc_boat_house",
      "sourceText": "Ez a hajó egy ház. Emberek laknak ezen a hajón. Ezt a hajót lakóhajónak hívják.",
      "sourceEnText": "This boat is a house. There are people who live on this boat. This boat is called a houseboat.",
      "audioFile": "fr_10_0a627c2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 4754,
      "updatedAt": "2026-08-24T22:56:42Z",
      "textHash": "8f7c50e5926d9c71b34aa55fd343ae012a53ce9b3a1ff8ed9ab26be5fe13f760"
    },
    {
      "key": "0a70250",
      "nodeTitle": "protagonist",
      "sourceText": "Köszönöm!",
      "sourceEnText": "Thank you!",
      "audioFile": "fr_10_0a70250.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1045,
      "updatedAt": "2026-08-24T22:55:58Z",
      "textHash": "8a1644ff9573191a323e7e6fc6de726156bf7e652214f4e917225fc437a999da"
    },
    {
      "key": "0a9c8e7",
      "nodeTitle": "protagonist",
      "sourceText": "Sétálj közel a folyóhoz, és megtalálod a képeket!",
      "sourceEnText": "Walk near the river and you'll find the photos!",
      "audioFile": "fr_10_0a9c8e7.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2978,
      "updatedAt": "2026-08-24T22:56:12Z",
      "textHash": "d58622c73a0260158c8cb9f1977822a1fd5699cd5a680cb375849418791fa304"
    },
    {
      "key": "0aa0f3a",
      "nodeTitle": "protagonist",
      "sourceText": "Segítség! Segítség!",
      "sourceEnText": "Help! Help me!",
      "audioFile": "fr_10_0aa0f3a.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1411,
      "updatedAt": "2026-08-24T22:56:07Z",
      "textHash": "842534b4966a1356f53ad5792bddb4efaeb3bbc6e447e8b0b83f8f9119f602d5"
    },
    {
      "key": "0b12cb3",
      "nodeTitle": "npc_boat_goods",
      "sourceText": "Egy teherhajó szállíthat: fát, homokot, de tárgyakat is: autókat, bútorokat...",
      "sourceEnText": "Boxes and things",
      "audioFile": "fr_10_0b12cb3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 4937,
      "updatedAt": "2026-08-24T22:56:27Z",
      "textHash": "9d649136308973ebcc6f8dd69958063fbed7585eeeceeb73444a00b04c7d0133"
    },
    {
      "key": "0b37e92",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Rajzolj egy hidat a füzetedbe!",
      "sourceEnText": "Draw a bridge in your notebook!",
      "audioFile": "fr_10_0b37e92.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1698,
      "updatedAt": "2026-08-24T22:55:56Z",
      "textHash": "c40d2509b2e272f395001c7eedd7986e1063a0996ac473de47b47bf9ac22e33c"
    },
    {
      "key": "0ba2f29",
      "nodeTitle": "spawned_bridge_expert",
      "sourceText": "Néhány híd csak gyalogosok számára van fenntartva.",
      "sourceEnText": "Some bridges are intended for pedestrians only.",
      "audioFile": "fr_10_0ba2f29.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 3187,
      "updatedAt": "2026-08-24T22:57:49Z",
      "textHash": "c964451d0445335581d8e7eb3eb38672408cab77dea196f12d8dedc7c65c85f1"
    },
    {
      "key": "0bbd3ce",
      "nodeTitle": "npc_boat_goods",
      "sourceText": "Turisták kamerákkal",
      "sourceEnText": "Tourists with cameras",
      "audioFile": "fr_10_0bbd3ce.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1541,
      "updatedAt": "2026-08-24T22:56:30Z",
      "textHash": "54da4d557c23badbc09beb1dba84966b34c895b15c0c3c7e13daed986eb3584e"
    },
    {
      "key": "0bfcb05",
      "nodeTitle": "protagonist",
      "sourceText": "Ha nem találod őket, Párizs térképével megkeresheted őket!",
      "sourceEnText": "If you can't find them, you can use the map of Paris to locate them!",
      "audioFile": "fr_10_0bfcb05.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3213,
      "updatedAt": "2026-08-24T22:56:05Z",
      "textHash": "da07ab5f4c323c84def92ab628034ea44549b591358e9f59cd58d0c007673932"
    },
    {
      "key": "0c408c3",
      "nodeTitle": "quest_end",
      "sourceText": "Remek, teljesítetted ezt a küldetést!",
      "sourceEnText": "Great, you've completed this quest!",
      "audioFile": "fr_10_0c408c3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2142,
      "updatedAt": "2026-08-24T22:55:49Z",
      "textHash": "804de7aaa44c656d2f63f8eaf35c3a546a7d963df02857d5793116bfadddb796"
    },
    {
      "key": "0c86d26",
      "nodeTitle": "npc_boat_house",
      "sourceText": "Lehetséges ott élni.",
      "sourceEnText": "It's possible to live there.",
      "audioFile": "fr_10_0c86d26.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1515,
      "updatedAt": "2026-08-24T22:56:45Z",
      "textHash": "f2e5609502a1d742d1f8c4da31ae6fe6bb92243e50976cbe1a356f4bc5d3a3f0"
    },
    {
      "key": "0c8cdae",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "A járdán kell haladni, és a gyalogátkelőhelyen kell átkelni.",
      "sourceEnText": "Use the sidewalk and cross at the crossing",
      "audioFile": "fr_10_0c8cdae.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 4153,
      "updatedAt": "2026-08-24T22:57:05Z",
      "textHash": "ca47bb4f232b08f201e00cbc8e51bd573332ac0dfc602e3d8998e98f0474315a"
    },
    {
      "key": "0c8e7b6",
      "nodeTitle": "protagonist",
      "sourceText": "A könyvem lapjai és a fotók a Szajna közelében hullottak!",
      "sourceEnText": "The pages of my book and the photos fell near the Seine!",
      "audioFile": "fr_10_0c8e7b6.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3265,
      "updatedAt": "2026-08-24T22:56:10Z",
      "textHash": "e30b67abccf6e43687b552901aa0ec57f1b274860160714b54c8762f5bc0b431"
    },
    {
      "key": "0cf371b",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "Az úton kell gyalogolnod",
      "sourceEnText": "You have to walk on the road",
      "audioFile": "fr_10_0cf371b.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1593,
      "updatedAt": "2026-08-24T22:57:08Z",
      "textHash": "5134969b850592991a19b04a87b90f5fac9072e52d697682f958ba0b4fee5642"
    },
    {
      "key": "0d1724c",
      "nodeTitle": "spawned_river_friend",
      "sourceText": "A folyó a tengerbe ömlik.",
      "sourceEnText": "The river flows into the sea.",
      "audioFile": "fr_10_0d1724c.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1724,
      "updatedAt": "2026-08-24T22:57:54Z",
      "textHash": "4a84a50618cb085763a17eb366dd7b021f489e6bd18434249c2810aa678f6869"
    },
    {
      "key": "0d79d7d",
      "nodeTitle": "npc_bridge_cars",
      "sourceText": "Ez egy híd az autóknak!",
      "sourceEnText": "It's a bridge for cars!",
      "audioFile": "fr_10_0d79d7d.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1593,
      "updatedAt": "2026-08-24T22:57:02Z",
      "textHash": "828611439baee57a5c6b13415e11b0c828c147b8dea62a115e12cabefa4cc81e"
    },
    {
      "key": "0d94ea8",
      "nodeTitle": "spawned_french_man",
      "sourceText": "Párizs a világ legszebb városa!",
      "sourceEnText": "Paris is the most beautiful city in the world!",
      "audioFile": "fr_10_0d94ea8.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T22:57:45Z",
      "textHash": "1d14dc7eadbfa197c0979d740db23b4eb8d3559875731ba13e13b2d8f483fc03"
    },
    {
      "key": "0d9bc29",
      "nodeTitle": "npc_bridge_alexandre",
      "sourceText": "Ez egy híd az autók számára.",
      "sourceEnText": "It's a bridge for cars.",
      "audioFile": "fr_10_0d9bc29.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
