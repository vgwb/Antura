    },
    {
      "key": "05c2518",
      "nodeTitle": "npc_bridge_alexandre",
      "sourceText": "Ez egy híd a vonatok számára.",
      "sourceEnText": "It's a bridge for trains.",
      "audioFile": "fr_10_05c2518.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1933,
      "updatedAt": "2026-08-24T22:57:00Z",
      "textHash": "8d7fd949f03f856da2dac51415e353038d65ae7914450cb8b1afa94946ddbbdb"
    },
    {
      "key": "0614aef",
      "nodeTitle": "npc_boat",
      "sourceText": "Nem, nem láttam a kutyádat.",
      "sourceEnText": "No, I haven't seen your dog.",
      "audioFile": "fr_10_0614aef.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1541,
      "updatedAt": "2026-08-24T22:57:28Z",
      "textHash": "154fd3e581784471237c149286161f8675dd75afb04bfa6d53552f80482d1185"
    },
    {
      "key": "062cc35",
      "nodeTitle": "quest_end",
      "sourceText": "Vannak hajók a turisták számára. Nagy ablakokon keresztül a Szajnáról is láthatók Párizs műemlékei.",
      "sourceEnText": "There are boats for tourists. They have large windows to see the monuments of Paris from the Seine.",
      "audioFile": "fr_10_062cc35.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 6713,
      "updatedAt": "2026-08-24T22:55:52Z",
      "textHash": "8d7580b9841a81d8d44c05319c453103630d5459c10e78df84e653a6b55cccaa"
    },
    {
      "key": "06638a3",
      "nodeTitle": "npc_boat_goods",
      "sourceText": "Vasúti kocsik",
      "sourceEnText": "Train cars",
      "audioFile": "fr_10_06638a3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1280,
      "updatedAt": "2026-08-24T22:56:32Z",
      "textHash": "1a2159ebddbbbd7870621fb1236503a2258d49d161512a5fd13075bc52089966"
    },
    {
      "key": "066d7bd",
      "nodeTitle": "question_seine_map",
      "sourceText": "A Párizson átfolyó folyó neve...",
      "sourceEnText": "The river that flows through Paris is called...",
      "audioFile": "fr_10_066d7bd.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2011,
      "updatedAt": "2026-08-24T22:56:16Z",
