    },
    {
      "key": "0090192",
      "nodeTitle": "luxembourg_npc",
      "sourceText": "Чи можете ви допомогти моєму швейцарському другові?",
      "sourceEnText": "Can you help my Swiss friend?",
      "audioFile": "fr_00_0090192.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "SENIOR_M",
      "durationMs": 3814,
      "updatedAt": "2026-08-25T01:33:06Z",
      "textHash": "007bf6ffa843b9261f5375bb8dd395da45227a75612c1ca1917abbfab00fc71c"
    },
    {
      "key": "00bd939",
      "nodeTitle": "monaco",
      "sourceText": "Мій прапор червоно-білий.",
      "sourceEnText": "My flag is red and white.",
      "audioFile": "fr_00_00bd939.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_M",
      "durationMs": 2116,
      "updatedAt": "2026-08-25T01:31:37Z",
      "textHash": "5f8d14b3d667d9dec0b97b396d3a43deddf5a0cd84c75a97a1312046f7894cac"
    },
    {
      "key": "0141a13",
      "nodeTitle": "belgium_npc",
      "sourceText": "Мій прапор має чорні, жовті та червоні смуги.",
      "sourceEnText": "My flag has black, yellow and red stripes.",
      "audioFile": "fr_00_0141a13.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "SENIOR_F",
      "durationMs": 4389,
      "updatedAt": "2026-08-25T01:32:43Z",
      "textHash": "972ac3a0751ae2fece1e3d613592d814a61119ba06536489d7ab2da1d919e62d"
    },
    {
      "key": "0148420",
      "nodeTitle": "npc_swiss",
      "sourceText": "Поверніться до початку та отримайте свій приз!",
      "sourceEnText": "Go back to the start and get your prize!",
      "audioFile": "fr_00_0148420.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3553,
      "updatedAt": "2026-08-25T01:33:08Z",
      "textHash": "3aaa271b38d294372318ad76323b8c7a40bbb1327b99d6902ffff33bc6a56fee"
    },
    {
      "key": "0148edb",
      "nodeTitle": "italy_npc",
      "sourceText": "Наша столиця — Рим!",
      "sourceEnText": "Our capital is Rome!",
      "audioFile": "fr_00_0148edb.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 2142,
      "updatedAt": "2026-08-25T01:32:27Z",
      "textHash": "c5b08aac2586dfccab19e6ad22192cd004bcc0210da5368c03b210b48ab32213"
    },
    {
      "key": "018e4cf",
      "nodeTitle": "task_lux",
      "sourceText": "Це червоний, білий і світло-блакитний.",
      "sourceEnText": "It is red, white, and light blue.",
      "audioFile": "fr_00_018e4cf.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "SENIOR_F",
      "durationMs": 2795,
