    },
    {
      "key": "03684cb",
      "nodeTitle": "germany_npc",
      "sourceText": "Чи можете ви допомогти моєму італійському другу?",
      "sourceEnText": "Can you help my Italian friend?",
      "audioFile": "fr_00_03684cb.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_M",
      "durationMs": 3553,
      "updatedAt": "2026-08-25T01:32:05Z",
      "textHash": "dae0ee865fe6e64cc3016833cc0cdfec56427da20ccb5ac2c7539c94a1381073"
    },
    {
      "key": "03a9b7d",
      "nodeTitle": "belgium_npc",
      "sourceText": "Чи можете ви допомогти моєму іспанському другу?",
      "sourceEnText": "Can you help my Spanish friend?",
      "audioFile": "fr_00_03a9b7d.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "SENIOR_F",
      "durationMs": 3448,
