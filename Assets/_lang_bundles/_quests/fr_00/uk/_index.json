      "durationMs": 2377,
      "updatedAt": "2026-08-25T01:32:02Z",
      "textHash": "2b230d1757c8b22d8f00849ef539be500000a65e6484494d724f5000b9365a5c"
    },
    {
      "key": "046db1f",
      "nodeTitle": "quest_start",
      "sourceText": "Ласкаво просимо до Франції!",
      "sourceEnText": "Welcome to France!",
      "audioFile": "fr_00_046db1f.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-08-25T01:33:01Z",
      "textHash": "3a8bed67741905101808fdc74e1028df6ecb6421fb1ffc33f252044bf6dfb58e"
    },
    {
      "key": "049610c",
      "nodeTitle": "item_flag_spain",
      "sourceText": "Ви знайшли іспанський прапор! Повертайтеся до Іспанії.",
      "sourceEnText": "You found the Spanish flag! Go back to Spain.",
      "audioFile": "fr_00_049610c.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "NARRATOR",
      "durationMs": 4519,
      "updatedAt": "2026-08-25T01:33:26Z",
      "textHash": "7efc00e80884fb2339f9bb2c109cb8c969fe649716d52933acbfdaec9ed85d55"
    },
    {
      "key": "04bd4db",
      "nodeTitle": "france_npc",
      "sourceText": "Чи можете ви зараз допомогти нашим німецьким друзям?",
      "sourceEnText": "Can you now help our german friends?",
      "audioFile": "fr_00_04bd4db.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_F",
      "durationMs": 3814,
      "updatedAt": "2026-08-25T01:31:49Z",
      "textHash": "c21fda3db368e0895fbb7a5a9a5c5142b6580a429620952ce3c42712710e538c"
    },
    {
      "key": "04dc97a",
      "nodeTitle": "germany_npc",
      "sourceText": "Ми славимося замками, лісами та потягами!",
      "sourceEnText": "We're famous for castles, forests, and trains!",
      "audioFile": "fr_00_04dc97a.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_M",
      "durationMs": 3030,
      "updatedAt": "2026-08-25T01:32:09Z",
      "textHash": "2419462e010f7b12081cb17284a93f28357b798bb790bc086e86485ad1c39b0e"
    },
    {
      "key": "04e0432",
      "nodeTitle": "france_npc",
      "sourceText": "Це не мій прапор. Мій синій, білий і червоний.",
      "sourceEnText": "That’s not my flag. Mine is blue, white, and red.",
      "audioFile": "fr_00_04e0432.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_F",
      "durationMs": 3370,
      "updatedAt": "2026-08-25T01:31:51Z",
      "textHash": "d99f7e8054ad98d96ff0810a8193bda68064104e07619caef3354c853e707412"
    },
    {
      "key": "04f4280",
      "nodeTitle": "spawned_npc",
      "sourceText": "У Європі люди розмовляють понад 100 мовами!",
      "sourceEnText": "In Europe, people speak over 100 languages!",
      "audioFile": "fr_00_04f4280.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 4206,
      "updatedAt": "2026-08-25T01:33:17Z",
      "textHash": "aef95793197cf7bda4247f7a4e13dc6a40899da800a885c87921c49b7ad2f483"
    },
    {
      "key": "0529472",
      "nodeTitle": "luxembourg_npc",
      "sourceText": "ні! Наш прапор червоно-біло-блакитний.",
      "sourceEnText": "Nope! Our flag is red, white, and light blue.",
      "audioFile": "fr_00_0529472.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "SENIOR_M",
      "durationMs": 3683,
      "updatedAt": "2026-08-25T01:32:57Z",
      "textHash": "1c9e813f4d020a44792562830b1888496d15758582cc7b55d968c6e73dfbcef2"
    },
    {
      "key": "055df11",
      "nodeTitle": "france_npc",
      "sourceText": "Париж — столиця Франції.",
      "sourceEnText": "Paris is the capital of France.",
      "audioFile": "fr_00_055df11.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_F",
      "durationMs": 2534,
      "updatedAt": "2026-08-25T01:33:21Z",
      "textHash": "5ce89e5688f16c3e0f56f5a595fb0abb64bcec879cc6a5537e7a2a4434149c61"
    },
    {
      "key": "05badd7",
      "nodeTitle": "item_flag_lux",
      "sourceText": "Прапор Люксембургу.",
      "sourceEnText": "Flag of Luxembourg.",
      "audioFile": "fr_00_05badd7.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "NARRATOR",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T01:31:20Z",
      "textHash": "f0ce110747e2899052351bb00c96cd770173c99421553413457866cc243cedfd"
    },
    {
      "key": "05de5ab",
      "nodeTitle": "luxembourg_npc",
      "sourceText": "дякую! Це мій прапор.",
      "sourceEnText": "Thank you! That is my flag.",
      "audioFile": "fr_00_05de5ab.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "SENIOR_M",
      "durationMs": 1933,
      "updatedAt": "2026-08-25T01:32:56Z",
      "textHash": "b6170edae883e7310597ae7f0b9bc14f255d35a5180242a0ddd5c664d3c2669c"
    },
    {
      "key": "05e6d48",
      "nodeTitle": "spain_npc",
      "sourceText": "У нас є танець фламенко!",
      "sourceEnText": "We have a dance called flamenco!",
      "audioFile": "fr_00_05e6d48.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "NARRATOR",
      "durationMs": 2011,
      "updatedAt": "2026-08-25T01:32:22Z",
      "textHash": "cbfcd1af58eca9988abc7ac090128aa57008c8b512693007465002ed1ac9c9fb"
    },
    {
      "key": "05e9552",
      "nodeTitle": "spawned_germany",
      "sourceText": "Столиця Німеччини — Берлін.",
      "sourceEnText": "The capital of Germany is Berlin.",
      "audioFile": "fr_00_05e9552.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 1959,
      "updatedAt": "2026-08-25T01:33:42Z",
      "textHash": "e26c75eb4e2fb6e851680a73526858814cffdbbde6eae083add62c869a262381"
    },
    {
      "key": "05f0ed2",
      "nodeTitle": "item_flag_germany",
      "sourceText": "Ви знайшли німецький прапор! Повертайтеся до Німеччини.",
      "sourceEnText": "You found the German flag! Go back to Germany.",
      "audioFile": "fr_00_05f0ed2.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "NARRATOR",
      "durationMs": 4153,
      "updatedAt": "2026-08-25T01:33:25Z",
      "textHash": "9ea16d33e5d7dfd9e9312465fb8de2b0968e47e00706ec23fa2dffa5612ec9b7"
    },
    {
      "key": "05ff51a",
      "nodeTitle": "item_flag_germany",
      "sourceText": "Прапор Німеччини.",
      "sourceEnText": "Flag of Germany.",
      "audioFile": "fr_00_05ff51a.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "NARRATOR",
      "durationMs": 1541,
      "updatedAt": "2026-08-25T01:31:43Z",
      "textHash": "e85dba229c9c7c2b61fee2dfe3283683c5e0e7b0b8f930be3dc21ae8df44b87b"
    },
    {
      "key": "06722b3",
      "nodeTitle": "spawned_germany",
      "sourceText": "У Німеччині є пиво та ковбаси.",
      "sourceEnText": "In Germany there is beer and sausages.",
      "audioFile": "fr_00_06722b3.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 2900,
      "updatedAt": "2026-08-25T01:33:40Z",
      "textHash": "c3cfc91fddf8761ceb4aa29c6140b425516611dc8ad4f0fbe42771dcbf8c4253"
    },
    {
      "key": "06b3ceb",
      "nodeTitle": "belgium_npc",
      "sourceText": "Брюссель є столицею Бельгії.",
      "sourceEnText": "Brussels is the capital of Belgium.",
      "audioFile": "fr_00_06b3ceb.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "SENIOR_F",
      "durationMs": 2011,
      "updatedAt": "2026-08-25T01:32:39Z",
      "textHash": "08829a9e88b18639e11bfd41d4d6eedaf44c7884bb24eb94b208ee2a4022968d"
    },
    {
      "key": "06dfdd6",
      "nodeTitle": "france_npc",
      "sourceText": "Привіт! Я з Франції!",
      "sourceEnText": "Hello! I’m from France!",
      "audioFile": "fr_00_06dfdd6.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_F",
      "durationMs": 2299,
      "updatedAt": "2026-08-25T01:31:53Z",
      "textHash": "07ae9db3d6b2dbdd5fc7eb372962ad99f60dc0234ae19dacbc2d8cd4cd875a33"
    },
    {
      "key": "06e1dd4",
      "nodeTitle": "win",
      "sourceText": "Ви знайшли частину Європи!",
      "sourceEnText": "You found part of Europe!",
      "audioFile": "fr_00_06e1dd4.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_F",
      "durationMs": 2664,
      "updatedAt": "2026-08-25T01:33:03Z",
      "textHash": "27fa4df2a6362b76115f39762faa2efd0d746439251a9237b44596ec5cac4c40"
    },
    {
      "key": "06e3b06",
      "nodeTitle": "spawned_npc",
      "sourceText": "У Європі близько 45 країн, всі вони розташовані близько одна до одної, як сусіди!",
      "sourceEnText": "Europe has around 45 countries, all close together like neighbors!",
      "audioFile": "fr_00_06e3b06.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 7210,
      "updatedAt": "2026-08-25T01:33:36Z",
      "textHash": "26228d5028bd586aa25d5a951e153c7d00fcfe59a92fa274daf09c84213d28c0"
    },
    {
      "key": "071f85c",
      "nodeTitle": "andorra",
      "sourceText": "Холо! Я з Андорри!",
      "sourceEnText": "Hola! I’m from Andorra!",
      "audioFile": "fr_00_071f85c.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 2011,
      "updatedAt": "2026-08-25T01:31:39Z",
      "textHash": "0f32df42df5cacbbbf61a295700fd7ec8735d4300d7eb30d0d1f1fc2f3749707"
    },
    {
      "key": "073fe02",
      "nodeTitle": "item_flag_belgium",
      "sourceText": "Ви знайшли бельгійський прапор! Повертайтеся до Бельгії.",
      "sourceEnText": "You found the Belgian flag! Go back to Belgium.",
      "audioFile": "fr_00_073fe02.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "NARRATOR",
      "durationMs": 4101,
      "updatedAt": "2026-08-25T01:33:30Z",
      "textHash": "779c1ce41be3c42d151c2c46b59d43ede1d486682b8d21c85b206d8a50ec5040"
    },
    {
      "key": "0768ab7",
      "nodeTitle": "item_flag_switzerland",
      "sourceText": "Прапор Швейцарії.",
      "sourceEnText": "Flag of Switzerland.",
      "audioFile": "fr_00_0768ab7.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "NARRATOR",
      "durationMs": 1515,
      "updatedAt": "2026-08-25T01:31:46Z",
      "textHash": "81539728ca8bd7d1192cefd8566a782489d4ee57bf0830a64d95b3fe0a4a16ac"
    },
    {
      "key": "079096a",
      "nodeTitle": "belgium_npc",
      "sourceText": "дякую! Мій прапор повернувся!",
      "sourceEnText": "Thank you! My flag is back!",
      "audioFile": "fr_00_079096a.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "SENIOR_F",
      "durationMs": 2482,
      "updatedAt": "2026-08-25T01:32:41Z",
      "textHash": "8dcbcd653dd789fe3e59458aa7267b8b5a17b6a2b9e5341f2e00ccbc3b74c561"
    },
    {
      "key": "079ecca",
      "nodeTitle": "task_belgium",
      "sourceText": "Це чорний, жовтий і червоний з вертикальними смугами.",
      "sourceEnText": "It's black, yellow, and red with vertical stripes.",
      "audioFile": "fr_00_079ecca.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "SENIOR_F",
      "durationMs": 3918,
      "updatedAt": "2026-08-25T01:32:50Z",
      "textHash": "8f0d083de2008ac40dee98b9eb982e97b82b47351a0aad8d9eb44fd48bb64a86"
    },
    {
      "key": "07cc57e",
      "nodeTitle": "task_swiss",
      "sourceText": "Він червоний з великим білим хрестом, як аптечка.",
      "sourceEnText": "It is red with a big white cross like a first aid kit.",
      "audioFile": "fr_00_07cc57e.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "SENIOR_F",
      "durationMs": 3683,
      "updatedAt": "2026-08-25T01:31:32Z",
      "textHash": "6c01a5356b24e4018a28a687dc38ead164443e7a617d7807b51e6c5214f89647"
    },
    {
      "key": "081ac66",
      "nodeTitle": "italy_npc",
      "sourceText": "Дякую! Це мій прапор!",
      "sourceEnText": "Grazie! That's my flag!",
      "audioFile": "fr_00_081ac66.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 2116,
      "updatedAt": "2026-08-25T01:32:28Z",
      "textHash": "7010df8ed57f41fc795efc4229c201b9f880307fcbce1a282016382c93aa6933"
    },
    {
      "key": "0868737",
      "nodeTitle": "task_france",
      "sourceText": "Мій прапор синьо-біло-червоний.",
      "sourceEnText": "It's blue, white, and red.",
      "audioFile": "fr_00_0868737.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_F",
      "durationMs": 2769,
      "updatedAt": "2026-08-25T01:31:56Z",
      "textHash": "58c996d4f0bb188932f6bd7b03f05276e49fea07d957596a2a846c26361acf22"
    },
    {
      "key": "08a09de",
      "nodeTitle": "quest_start",
      "sourceText": "Давайте зустрінемося з друзями з сусідніх країн.",
      "sourceEnText": "Let’s meet friends from nearby countries.",
      "audioFile": "fr_00_08a09de.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 3918,
      "updatedAt": "2026-08-25T01:33:12Z",
      "textHash": "6e70cbce13e40d80e7fb26abbdc80290d2975ff62fee9a207fc39a650ebb5057"
    },
    {
      "key": "08a8ce8",
      "nodeTitle": "quest_start",
      "sourceText": "Ми в Європі.",
      "sourceEnText": "We are in Europe.",
      "audioFile": "fr_00_08a8ce8.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 1280,
      "updatedAt": "2026-08-25T01:33:10Z",
      "textHash": "87aa4798d90846a15862cc38c9ca8ccde8845dbc41d4a364932f80c0223c5f4e"
    },
    {
      "key": "091cc7c",
      "nodeTitle": "task_spain",
      "sourceText": "Знайдіть іспанський прапор.",
      "sourceEnText": "Find the Spanish flag.",
      "audioFile": "fr_00_091cc7c.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 1933,
      "updatedAt": "2026-08-25T01:32:24Z",
      "textHash": "5e0cf8e221be76ceb8265b74f9cf17fda53ad356ecd0e13976e82defb59a7478"
    },
    {
      "key": "0930602",
      "nodeTitle": "spain_npc",
      "sourceText": "Дякую. Чи можете ви дати моєму люксембурзькому другу їхній прапор?",
      "sourceEnText": "Thank you. Can you give my Luxembourg friend their flag?",
      "audioFile": "fr_00_0930602.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "NARRATOR",
      "durationMs": 4937,
      "updatedAt": "2026-08-25T01:32:18Z",
      "textHash": "65f3b9593dfff80dc5eb76b56cc17df9dc74afd3132f6e3dc6120163307c9aa7"
    },
    {
      "key": "09635b4",
      "nodeTitle": "task_spain",
      "sourceText": "Він червоно-жовтий, як сонце.",
      "sourceEnText": "It is red and yellow like the sun.",
      "audioFile": "fr_00_09635b4.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2299,
      "updatedAt": "2026-08-25T01:32:25Z",
      "textHash": "5a14715ae1ffecf79656193080d148cae702e75b366004800b9c7912a517477d"
    },
    {
      "key": "09cf6c9",
      "nodeTitle": "spain_npc",
      "sourceText": "Мадрид — столиця Іспанії.",
      "sourceEnText": "Madrid is the capital of Spain.",
      "audioFile": "fr_00_09cf6c9.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "NARRATOR",
      "durationMs": 2351,
      "updatedAt": "2026-08-25T01:32:14Z",
      "textHash": "1de2528cf89935e317f3513064929f49d6b95624dc1714f138c5593326aa5da6"
    },
    {
      "key": "09fe8fc",
      "nodeTitle": "npc_swiss",
      "sourceText": "Привіт! Я зі Швейцарії!",
      "sourceEnText": "Hello! I’m from Switzerland!",
      "audioFile": "fr_00_09fe8fc.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2429,
      "updatedAt": "2026-08-25T01:31:27Z",
      "textHash": "d3ef58f34b262eafaa457ce8c3ed65f7de8edc7bb7f4d06ceaf26d24af2ebfd7"
    },
    {
      "key": "0a20eed",
      "nodeTitle": "france_npc",
      "sourceText": "Антура переплутала всі прапори!",
      "sourceEnText": "We have a problem. Antura mixed up all the flags!",
      "audioFile": "fr_00_0a20eed.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_F",
      "durationMs": 3030,
      "updatedAt": "2026-08-25T01:31:54Z",
      "textHash": "9ed9a8d015dbe64ae0a1191b5af6d25d11140177464b71cd10c3369ecf68cb2b"
    },
    {
      "key": "0a23cce",
      "nodeTitle": "spawned_italy",
      "sourceText": "Італія на карті схожа на чобіт!",
      "sourceEnText": "Italy looks like a boot on the map!",
      "audioFile": "fr_00_0a23cce.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 2795,
      "updatedAt": "2026-08-25T01:33:43Z",
      "textHash": "73c3cfc4a49548658cd2751984f9b0749e9ac5a4f403f6b594c1cfebd9a74c7f"
    },
    {
      "key": "0a3d0e3",
      "nodeTitle": "luxembourg_npc",
      "sourceText": "Ми маленька країна, але розмовляємо трьома мовами!",
      "sourceEnText": "We are a small country and speak three languages!",
      "audioFile": "fr_00_0a3d0e3.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "SENIOR_M",
      "durationMs": 4519,
      "updatedAt": "2026-08-25T01:31:16Z",
      "textHash": "0542df3a7b26fdf1dd90c8ec4c5dcf7fbf46703e57cf39fd3fde3b6c551d1059"
    },
    {
      "key": "0a3f8f6",
      "nodeTitle": "monaco",
      "sourceText": "Бонжур! Я з Монако!",
      "sourceEnText": "Bonjour! I’m from Monaco!",
      "audioFile": "fr_00_0a3f8f6.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_M",
      "durationMs": 2377,
      "updatedAt": "2026-08-25T01:31:33Z",
      "textHash": "ba0e5e6116a3447b7a8634d536bb96ebecb97d4d8e95889da0219fd1493dad3c"
    },
    {
      "key": "0a61b67",
      "nodeTitle": "belgium_npc",
      "sourceText": "Бонжур! Я з Бельгії!",
      "sourceEnText": "Bonjour! I'm from Belgium!",
      "audioFile": "fr_00_0a61b67.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "SENIOR_F",
      "durationMs": 2482,
      "updatedAt": "2026-08-25T01:32:45Z",
      "textHash": "0d6fc06a68882c021be8eaf308f9254faccc5d45ef9e5e3ff44060d70bd0939e"
    },
    {
      "key": "0a9b166",
      "nodeTitle": "item_flag_france",
      "sourceText": "Ти знайшов французький прапор! Повернися до француза.",
      "sourceEnText": "You found the French flag! Go back to the French man.",
      "audioFile": "fr_00_0a9b166.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "NARRATOR",
      "durationMs": 4153,
      "updatedAt": "2026-08-25T01:33:23Z",
      "textHash": "fe9a45aa92fc8b155d8a20c5272514f927c1fc991320f6dfb71fda0b30157cf1"
    },
    {
      "key": "0a9f34e",
      "nodeTitle": "france_npc",
      "sourceText": "Ви можете мені допомогти?",
      "sourceEnText": "Can you help us?",
      "audioFile": "fr_00_0a9f34e.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_F",
      "durationMs": 1829,
      "updatedAt": "2026-08-25T01:31:57Z",
      "textHash": "2fd41238c8c9bccbc6032264a7bac07e3c86096a2de243718865b6a5ed726f8b"
    },
    {
      "key": "0ab3dd9",
      "nodeTitle": "spawned_france",
      "sourceText": "Франція є другою за величиною країною в Європі після України.",
      "sourceEnText": "France is the second biggest country in the Europe after Ukraine.",
      "audioFile": "fr_00_0ab3dd9.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 4389,
      "updatedAt": "2026-08-25T01:33:19Z",
      "textHash": "bd84b54e5fec89ef429a4e850cbab8b7b7ec007465052acd9c5f2fb0dd8f9845"
    },
    {
      "key": "0b11066",
      "nodeTitle": "item_flag_belgium",
      "sourceText": "Прапор Бельгії.",
      "sourceEnText": "Flag of Belgium.",
      "audioFile": "fr_00_0b11066.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "NARRATOR",
      "durationMs": 1411,
      "updatedAt": "2026-08-25T01:32:52Z",
      "textHash": "518d8cc441d5dc7aab618f86b8f536d07ba7d942c8edb8c18115e9df3fb3340b"
    },
    {
      "key": "0b18893",
      "nodeTitle": "belgium_npc",
      "sourceText": "Ми також розмовляємо французькою!",
      "sourceEnText": "We also speak French!",
      "audioFile": "fr_00_0b18893.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "SENIOR_F",
      "durationMs": 2247,
      "updatedAt": "2026-08-25T01:32:47Z",
      "textHash": "3496e8a2f2b67a698d29ea938542153e365af27cc64a8a42b25b5d164fab41fe"
    },
    {
      "key": "0b22d58",
      "nodeTitle": "luxembourg_npc",
      "sourceText": "Moien! Я з Люксембургу!",
      "sourceEnText": "Moien! I’m from Luxembourg!",
      "audioFile": "fr_00_0b22d58.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "SENIOR_M",
      "durationMs": 2795,
      "updatedAt": "2026-08-25T01:32:59Z",
      "textHash": "d53da6ae69d8bf2022e39930dc58fef2ef0377105bc262f584efef7ed4503c1b"
    },
    {
      "key": "0ba3c4c",
      "nodeTitle": "win",
      "sourceText": "хороша робота! Ви це зробили!",
      "sourceEnText": "Good job! You did it!",
      "audioFile": "fr_00_0ba3c4c.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_F",
      "durationMs": 2769,
      "updatedAt": "2026-08-25T01:31:14Z",
      "textHash": "66feb2e8a812f5baecc4f14dd6bd3b926ebc87130cef84e4b5d26076da995481"
    },
    {
      "key": "0ba8707",
      "nodeTitle": "germany_npc",
      "sourceText": "Данке! Це мій прапор!",
      "sourceEnText": "Danke! That is my flag!",
      "audioFile": "fr_00_0ba8707.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_M",
      "durationMs": 2429,
      "updatedAt": "2026-08-25T01:32:03Z",
      "textHash": "cd54f1d1d16a597c034925667a7d4cbca076c7e17a4adf7ae5b4d71e0a918f3f"
    },
    {
      "key": "0bda0fc",
      "nodeTitle": "italy_npc",
      "sourceText": "Чао! Я з Італії!",
      "sourceEnText": "Ciao! I'm from Italy!",
      "audioFile": "fr_00_0bda0fc.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T01:32:33Z",
      "textHash": "73b0f68aea902464b231013c0c453c618435a17cf9e4a23e706b1e61922f1d3a"
    },
    {
      "key": "0bf6b0d",
      "nodeTitle": "npc_swiss",
      "sourceText": "Ми славимося сніжними горами та сиром.",
      "sourceEnText": "We're famous for snowy mountains and cheese.",
      "audioFile": "fr_00_0bf6b0d.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3683,
      "updatedAt": "2026-08-25T01:31:29Z",
      "textHash": "6e122a569bf545993152531ec20d7ec21575f5ae2f5b583d52043e08d91711bb"
    },
    {
      "key": "0c097e4",
      "nodeTitle": "spawned_france",
      "sourceText": "У Франції є Ейфелева вежа — гігантська залізна вежа, яка виблискує вночі.",
      "sourceEnText": "In France there is the Eiffel Tower, a giant iron tower that sparkles at night.",
      "audioFile": "fr_00_0c097e4.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 5825,
      "updatedAt": "2026-08-25T01:33:38Z",
      "textHash": "eefb11778da2188ff2fed679fdb35856ed64c083ad85e63379459ee5735f3dbb"
    },
    {
      "key": "0c48a14",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Чи можете ви зараз намалювати свій прапор?",
      "sourceEnText": "Can you draw your flag now?",
      "audioFile": "fr_00_0c48a14.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 2560,
      "updatedAt": "2026-08-25T01:33:15Z",
      "textHash": "9dfbb0d10e23b8c991dcc7529b08adb42dfc3504249740b940aa69d03449f5a3"
    },
    {
      "key": "0c57e40",
      "nodeTitle": "spain_npc",
      "sourceText": "Це мій прапор!",
      "sourceEnText": "That is my flag!",
      "audioFile": "fr_00_0c57e40.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "NARRATOR",
      "durationMs": 1123,
      "updatedAt": "2026-08-25T01:32:16Z",
      "textHash": "0781f55c7151e972c189a7eea696dda4799009b1ff7efe61251344122908d7c2"
    },
    {
      "key": "0ca99a0",
      "nodeTitle": "npc_swiss",
      "sourceText": "Дякую, що повернули мій прапор!",
      "sourceEnText": "Thank you for bringing my flag back!",
      "audioFile": "fr_00_0ca99a0.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2194,
      "updatedAt": "2026-08-25T01:31:24Z",
      "textHash": "f5cf904687c3c54f236a4c7c36ca6d76eef048cdc469de2fee38d0bf00b50d82"
    },
    {
      "key": "0caad5a",
      "nodeTitle": "npc_swiss",
      "sourceText": "Наш прапор червоний з білим хрестом.",
      "sourceEnText": "Our flag is red with a white cross.",
      "audioFile": "fr_00_0caad5a.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2795,
      "updatedAt": "2026-08-25T01:31:25Z",
      "textHash": "68d904171cec5304ae738d8335781b71a80edb04999a3d1adcdda2239eda5f55"
    },
    {
      "key": "0cd7024",
      "nodeTitle": "germany_npc",
      "sourceText": "Наш прапор має чорні, червоні та жовті смуги.",
      "sourceEnText": "Our flag has black, red and yellow stripes.",
      "audioFile": "fr_00_0cd7024.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_M",
      "durationMs": 3605,
      "updatedAt": "2026-08-25T01:32:06Z",
      "textHash": "ca3bbaafe479ff238f03621a7fff0c5a9b975cff1ce2610e72c78dab7746a461"
    },
    {
      "key": "0cde44c",
      "nodeTitle": "task_italy",
      "sourceText": "Він зелений, білий і червоний, як піца!",
      "sourceEnText": "It is green, white, and red like a pizza!",
      "audioFile": "fr_00_0cde44c.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 3318,
      "updatedAt": "2026-08-25T01:32:37Z",
      "textHash": "e1c05f9170d13cc6a8738e4c40749b8c1c052384000594b1da4c2b9bacff531c"
    },
    {
      "key": "0d2e2d7",
      "nodeTitle": "npc_swiss",
      "sourceText": "Столиця Швейцарії - Берн!",
      "sourceEnText": "The capital of Switzerland is Bern!",
      "audioFile": "fr_00_0d2e2d7.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2064,
      "updatedAt": "2026-08-25T01:31:22Z",
      "textHash": "7320275c676ca16d5ae2af074ad0b8357594248606c315ec4ec5bf7464688ef4"
    },
    {
      "key": "0db05da",
      "nodeTitle": "spain_npc",
      "sourceText": "Не моє! Наш прапор червоно-жовтий.",
      "sourceEnText": "Our flag is red and yellow.",
      "audioFile": "fr_00_0db05da.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "NARRATOR",
      "durationMs": 3370,
      "updatedAt": "2026-08-25T01:32:19Z",
      "textHash": "b415559788d8a85810664779787ee315202cf9036e023acebede0a345a1c2126"
