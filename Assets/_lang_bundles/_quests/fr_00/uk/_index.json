    },
    {
      "key": "0446f03",
      "nodeTitle": "germany_npc",
      "sourceText": "Берлін — столиця Німеччини.",
      "sourceEnText": "Berlin is the capital of Germany.",
      "audioFile": "fr_00_0446f03.mp3",
      "voiceProfile": "yaroslava",
