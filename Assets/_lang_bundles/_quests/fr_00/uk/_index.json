      "durationMs": 2299,
      "updatedAt": "2026-08-25T01:32:08Z",
      "textHash": "74979d6d264c7f1a4fc4ca0a6f31e1e6b709a972239b402e1ca88b0f0a5c9440"
    },
    {
      "key": "006ce10",
      "nodeTitle": "item_flag_spain",
      "sourceText": "Прапор Іспанії",
      "sourceEnText": "Flag of Spain",
      "audioFile": "fr_00_006ce10.mp3",
      "voiceProfile": "yaroslava",
