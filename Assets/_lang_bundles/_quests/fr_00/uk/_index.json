      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 3736,
      "updatedAt": "2026-08-25T01:32:30Z",
      "textHash": "1dc4d78666c8e5c75381eb9e1e4203574687a8410b98546bb8bf50b344e75f58"
    },
    {
      "key": "0068fe1",
      "nodeTitle": "germany_npc",
      "sourceText": "Привіт! Я з Німеччини!",
      "sourceEnText": "Hello! I’m from Germany!",
      "audioFile": "fr_00_0068fe1.mp3",
      "voiceProfile": "yaroslava",
