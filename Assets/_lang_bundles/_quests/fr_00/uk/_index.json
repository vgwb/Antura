      "textHash": "2ba7785fa6baa8f655af6badf5bec801f6d2926ea90312fdd35380d20b40dad6"
    },
    {
      "key": "01d9617",
      "nodeTitle": "item_flag_france",
      "sourceText": "Прапор Франції.",
      "sourceEnText": "Flag of France.",
      "audioFile": "fr_00_01d9617.mp3",
      "voiceProfile": "yaroslava",
