      "audioFile": "fr_00_04dc97a.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 3866,
      "updatedAt": "2026-08-25T01:19:33Z",
      "textHash": "0131b8394a3192b9f321d88cc2dd3475eceb8879803e7cc3f507aa5633e88757"
    },
    {
      "key": "04e0432",
      "nodeTitle": "france_npc",
      "sourceText": "Ez nem az én zászlóm. Az enyém kék, fehér és piros.",
      "sourceEnText": "That’s not my flag. Mine is blue, white, and red.",
      "audioFile": "fr_00_04e0432.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_F",
      "durationMs": 3030,
      "updatedAt": "2026-08-25T01:19:14Z",
      "textHash": "e64de766dc8293aadaaf9890c08c3203cf47b0292eee8b8aa80bdd3c82ee5649"
    },
    {
      "key": "04f4280",
      "nodeTitle": "spawned_npc",
      "sourceText": "Európában több mint 100 nyelvet beszélnek az emberek!",
