      "voiceProfile": "shelley",
      "actorId": "KID_M",
      "durationMs": 3213,
      "updatedAt": "2026-08-25T01:20:33Z",
      "textHash": "4920ac69d4b95ee4031f1dfa172225aa797394ccc436e15fba50fb01db669511"
    },
    {
      "key": "0529472",
      "nodeTitle": "luxembourg_npc",
      "sourceText": "Dehogy! Zászlónk piros, fehér és világoskék.",
