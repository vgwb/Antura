      "textHash": "f34474f2796ae79ee076550b498e644ead5d12fcb76ec66746c971c25313dd9e"
    },
    {
      "key": "04dc97a",
      "nodeTitle": "germany_npc",
      "sourceText": "Híresek vagyunk a kastélyokról, az erdőkről és a vonatokról!",
