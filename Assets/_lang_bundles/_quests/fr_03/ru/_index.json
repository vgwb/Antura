{
  "version": "1",
  "questId": "fr_03",
  "lang": "ru",
  "lines": [
    {
      "key": "003b311",
      "nodeTitle": "verne_house",
      "sourceText": "Жюль Верн родился здесь, в Нанте.",
      "sourceEnText": "Jules Verne was born here in NANTES.",
      "audioFile": "fr_03_003b311.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2377,
      "updatedAt": "2026-08-25T00:37:29Z",
      "textHash": "5f4702ca8a39890f3f99069a48ba333ce75432db00947cc73272b4ae599e8aa4"
    },
    {
      "key": "006e7fc",
      "nodeTitle": "quest_start",
      "sourceText": "Кто такой Жюль Верн? И куда он путешествовал?",
      "sourceEnText": "Who is Jules Verne? And where did he travel?",
      "audioFile": "fr_03_006e7fc.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 3135,
      "updatedAt": "2026-08-25T00:37:54Z",
      "textHash": "5eb9876045751d74564b2d301b5b78b679f690c1558dfd85425edbbf3e66f818"
    },
    {
      "key": "00a6154",
      "nodeTitle": "tutor_20000",
      "sourceText": "Помогите! «Наутилус» пропал!",
      "sourceEnText": "Help! The Nautilus is missing!",
      "audioFile": "fr_03_00a6154.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2769,
      "updatedAt": "2026-08-25T00:38:37Z",
      "textHash": "39ce7943327b9b6020abc67b529429fa2c7f8b01e0e14b42d27d224e7b81700c"
    },
    {
      "key": "00b1d04",
      "nodeTitle": "spawned_guide",
      "sourceText": "Вы знаете, кто такой Жюль Верн?",
      "sourceEnText": "Do you know who Jules Verne is?",
      "audioFile": "fr_03_00b1d04.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_M",
      "durationMs": 1959,
      "updatedAt": "2026-08-25T00:37:56Z",
      "textHash": "a1a725419107c50fd8f13d3ff778c7b15bc491049540004b61a979bed548bbd3"
    },
    {
      "key": "00be1f0",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Я бы хотела однажды полетать на воздушном шаре.",
      "sourceEnText": "I want to ride a BALLOON one day.",
      "audioFile": "fr_03_00be1f0.mp3",
      "voiceProfile": "felix",
      "actorId": "KID_M",
      "durationMs": 3030,
      "updatedAt": "2026-08-25T00:37:47Z",
      "textHash": "4fc6b3ab0206f68a6938f1453cc0c6bbcb21a636acbf05ec9958ce31007bc2d3"
    },
    {
      "key": "00eefe0",
      "nodeTitle": "activity_match_done",
      "sourceText": "Теперь всё готово для посетителей!",
      "sourceEnText": "Now everything is ready for the visitors!",
      "audioFile": "fr_03_00eefe0.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2534,
      "updatedAt": "2026-08-25T00:38:32Z",
      "textHash": "7a185b5654ae3bfd5c56464c443c1f3b8437ea107195ed1791227e20983ec564"
    },
    {
      "key": "00f3a57",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Я обожаю читать книги!",
      "sourceEnText": "I love reading BOOKS!",
      "audioFile": "fr_03_00f3a57.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 1881,
      "updatedAt": "2026-08-25T00:37:40Z",
      "textHash": "99de5de7869cc4854335a2c544ed6a42b61cc1e632970fd169611ae1688abe41"
    },
    {
      "key": "0131b99",
      "nodeTitle": "balloon",
      "sourceText": "Воздушный шар поднимается в воздух с помощью теплого воздуха.",
      "sourceEnText": "A BALLOON goes up with warm AIR.",
      "audioFile": "fr_03_0131b99.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 4206,
      "updatedAt": "2026-08-25T00:37:37Z",
      "textHash": "2a3f3c384f597716abf995d49ebb49943d5ec7e4e7d923967d0133dc2e59a301"
    },
    {
      "key": "0174104",
      "nodeTitle": "quest_end",
      "sourceText": "Теперь вы знаете о Жюле Верне и его книгах!",
      "sourceEnText": "Now you know about Jules Verne and his BOOKS!",
      "audioFile": "fr_03_0174104.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 3082,
      "updatedAt": "2026-08-25T00:37:26Z",
      "textHash": "8ce3c147cc1cf3290032e5964e05dcde64c1f628b0a1abad1bd8710d32fcf3e4"
    },
    {
      "key": "01a9d0f",
      "nodeTitle": "npc_door",
      "sourceText": "Помогите мне почистить тротуар!",
      "sourceEnText": "Help me clean the sidewalk!",
      "audioFile": "fr_03_01a9d0f.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 2194,
      "updatedAt": "2026-08-25T00:38:15Z",
      "textHash": "e98178e816e2d0ee0712b1c4906902cd8e14cb7ad12e543f9c77625684df8e01"
    },
    {
      "key": "01f76f3",
      "nodeTitle": "tutor_80days",
      "sourceText": "Вы нашли ПОЕЗД!",
      "sourceEnText": "You found the TRAIN!",
      "audioFile": "fr_03_01f76f3.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1358,
      "updatedAt": "2026-08-25T00:38:55Z",
      "textHash": "0a900974c7cb9a34d5dd89e073cfd13dc2d2d1741905ec049721bb08394159ee"
    },
    {
      "key": "020d924",
      "nodeTitle": "book_5weeks",
      "sourceText": "Воздушный шар поднимается в воздух, потому что теплый воздух легкий.",
      "sourceEnText": "A BALLOON rises because warm AIR is light.",
      "audioFile": "fr_03_020d924.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 4441,
      "updatedAt": "2026-08-25T00:38:50Z",
      "textHash": "812d67cd4cf7fdb5108f8a1a99c3486e90f94ee3ba749c84b07a345fe8781898"
    },
    {
      "key": "0210ef0",
      "nodeTitle": "npc_door",
      "sourceText": "Та синяя собака бежала и намусорила!",
      "sourceEnText": "That blue DOG was running and made a mess!",
      "audioFile": "fr_03_0210ef0.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 2717,
      "updatedAt": "2026-08-25T00:38:12Z",
      "textHash": "4bf0b5c53d9c9be24caae17260b355067ee0e0e280a838576142091a01774e01"
    },
    {
      "key": "0245e0e",
      "nodeTitle": "museum_guide",
      "sourceText": "Соедините книги с их транспортными средствами!",
      "sourceEnText": "Put the BOOKS together with their vehicles!",
      "audioFile": "fr_03_0245e0e.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2978,
      "updatedAt": "2026-08-25T00:38:24Z",
      "textHash": "84337079261015eb004299e9032724eabbfa2f8ba75e2a81aa726eb1a917aaec"
    },
    {
      "key": "0286510",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Вы нашли воздушный шар! Его также называют воздушным шаром.",
      "sourceEnText": "You found the HOT AIR BALLOON!",
      "audioFile": "fr_03_0286510.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 3971,
      "updatedAt": "2026-08-25T00:38:44Z",
      "textHash": "afff408512940435d659b4d6befc3287264c5dfb3a9651b0760715110fa6383d"
    },
    {
      "key": "02e7812",
      "nodeTitle": "tutor_20000",
      "sourceText": "Пожалуйста, исправьте это.",
      "sourceEnText": "Can you please fix it?",
      "audioFile": "fr_03_02e7812.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1593,
      "updatedAt": "2026-08-25T00:38:36Z",
      "textHash": "bb2e64064e2aa81d4c1cb34385a2b1fae854d2b8be9856ce231ff5083f02090b"
    },
    {
      "key": "03131e3",
      "nodeTitle": "book_80days",
      "sourceText": "Эта книга называется «Вокруг света за 80 дней».",
      "sourceEnText": "This BOOK is \"Around the World in 80 Days.\"",
      "audioFile": "fr_03_03131e3.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 3370,
      "updatedAt": "2026-08-25T00:37:32Z",
      "textHash": "d02b5bccd41dbc564c81b23365ca2a76379a695d3718846f136710327de7ec62"
    },
    {
      "key": "03536a1",
      "nodeTitle": "book_20000",
      "sourceText": "Эта книга называется «20 000 лье под водой».",
      "sourceEnText": "This BOOK is \"20,000 Leagues Under the Seas.\"",
      "audioFile": "fr_03_03536a1.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 3370,
      "updatedAt": "2026-08-25T00:37:35Z",
      "textHash": "b8a378dae357de6058bfcf864cf2b55804f41097c66023fd683faa34256b3cc3"
    },
    {
      "key": "036574d",
      "nodeTitle": "tutor_80days",
      "sourceText": "Найдите старый паровоз.",
      "sourceEnText": "Find the OLD STEAM TRAIN",
      "audioFile": "fr_03_036574d.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T00:38:58Z",
      "textHash": "7eed2908dc557f786d26a31090c1502050267ccbf111de08c28d9fde0415cb91"
    },
    {
      "key": "0386706",
      "nodeTitle": "museum_guide",
      "sourceText": "Пожалуйста, обратитесь к первому дежурному в номере.",
      "sourceEnText": "Please talk to the first room guardian.",
      "audioFile": "fr_03_0386706.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 3187,
      "updatedAt": "2026-08-25T00:38:29Z",
      "textHash": "953675344b8ed581f81f8962171807a29753b95d2a8497361241e56195d852f5"
    },
    {
      "key": "03af9a8",
      "nodeTitle": "tutor_20000",
      "sourceText": "Приходи ко мне позже.",
      "sourceEnText": "Come back to me later.",
      "audioFile": "fr_03_03af9a8.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1515,
      "updatedAt": "2026-08-25T00:38:52Z",
      "textHash": "cee4e7fb58f7fe7dcb5a03b7f26241de42a87a47614f0468b88b5f05580bac76"
    },
    {
      "key": "03efbc0",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Найдите космическую ракету",
      "sourceEnText": "Find the SPACE ROCKET",
      "audioFile": "fr_03_03efbc0.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1959,
      "updatedAt": "2026-08-25T00:39:06Z",
      "textHash": "f575de77d11d111b9637eee9aa27784663d2579da0c2bd9be341e9cb20e8044b"
    },
    {
      "key": "05130c0",
      "nodeTitle": "train",
      "sourceText": "Поезда сделали поездки на дальние расстояния быстрее.",
      "sourceEnText": "TRAINS made long trips faster.",
      "audioFile": "fr_03_05130c0.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 3448,
      "updatedAt": "2026-08-25T00:39:02Z",
      "textHash": "7b6fb93050e155ae119b8cf96265c9a5e9f03232936704a93b65b8917e032ed9"
    },
    {
      "key": "0525efc",
      "nodeTitle": "museum_guide",
      "sourceText": "В музей забрела забавная синяя собака и устроила там беспорядок!",
      "sourceEnText": "A funny blue DOG entered the MUSEUM and made a mess!",
      "audioFile": "fr_03_0525efc.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 4336,
      "updatedAt": "2026-08-25T00:38:04Z",
      "textHash": "52276b7587141d9aa6dd8c6031dcfadf5014f658ff11ca963521ec0acbcc1008"
    },
    {
      "key": "056e79e",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Жюль Верн изобрел научно-фантастические рассказы.",
      "sourceEnText": "Jules Verne invented science FICTION stories.",
      "audioFile": "fr_03_056e79e.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 3370,
      "updatedAt": "2026-08-25T00:37:42Z",
      "textHash": "e74c5e1e1655a55b82987aa1c7570d11d7d45eb42825456bda2e198c088c997d"
    },
    {
      "key": "05bc5e9",
      "nodeTitle": "tutor_20000",
      "sourceText": "Если не можете найти, воспользуйтесь картой.",
      "sourceEnText": "If you can't find it, USE THE MAP",
      "audioFile": "fr_03_05bc5e9.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2769,
      "updatedAt": "2026-08-25T00:39:12Z",
      "textHash": "a3fae5c00f8baaebc2150dbc6d69136de858935c142ebdb548a81be3c432ddbc"
    },
    {
      "key": "05e298d",
      "nodeTitle": "book_earthmoon",
      "sourceText": "В этой истории используется огромная космическая пушка для запуска ракеты.",
      "sourceEnText": "The story has a huge space CANNON to launch the ROCKET",
      "audioFile": "fr_03_05e298d.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 5120,
      "updatedAt": "2026-08-25T00:39:14Z",
      "textHash": "c89b05cf23f17285846941913c5a51313ef8fa9cc3a339358145590e2074f3d4"
    },
    {
      "key": "0642734",
      "nodeTitle": "museum_guide",
      "sourceText": "У нас проблема!",
      "sourceEnText": "We have a PROBLEM!",
      "audioFile": "fr_03_0642734.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1123,
      "updatedAt": "2026-08-25T00:38:02Z",
      "textHash": "8fa9f2b314aefa60ce056e713060127ff1789ffe856851fe30130032ade64fe5"
    },
    {
      "key": "0666ee2",
      "nodeTitle": "tutor_20000",
      "sourceText": "Вы нашли подводную лодку!",
      "sourceEnText": "You found the SUBMARINE!",
      "audioFile": "fr_03_0666ee2.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1881,
      "updatedAt": "2026-08-25T00:38:35Z",
      "textHash": "5320a650725b404efb55d333a6d5102684909eea3cee228e731f1193e6c2b750"
    },
    {
      "key": "06aef1a",
      "nodeTitle": "submarine",
      "sourceText": "Подводная лодка движется под водой.",
      "sourceEnText": "A SUBMARINE moves under the SEA.",
      "audioFile": "fr_03_06aef1a.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2377,
      "updatedAt": "2026-08-25T00:38:54Z",
      "textHash": "d0efcdaf26e8033c35d1089a7e5df7051b9ce01a4010961b27705a4a1683086a"
    },
    {
      "key": "06b6d4d",
      "nodeTitle": "rocket",
      "sourceText": "Ракета изо всех сил пытается покинуть Землю.",
      "sourceEnText": "A ROCKET pushes hard to leave EARTH.",
      "audioFile": "fr_03_06b6d4d.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2978,
      "updatedAt": "2026-08-25T00:37:33Z",
      "textHash": "c6d0f7caf52b08baaad92d5c5bc5562d767902653290c6dded5f0dc67634a405"
    },
    {
      "key": "06e1473",
      "nodeTitle": "spawned_guide",
      "sourceText": "Многие идеи из его книг воплотились в жизнь.",
      "sourceEnText": "Many ideas in his BOOKS became real.",
      "audioFile": "fr_03_06e1473.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_M",
      "durationMs": 2952,
      "updatedAt": "2026-08-25T00:37:52Z",
      "textHash": "178fd43908132ca5bdff723438bbba66282196fab709ff9414e7aa13aa14154f"
    },
    {
      "key": "06fb1cd",
      "nodeTitle": "spawned_guide",
      "sourceText": "Нет, кто он?",
      "sourceEnText": "No, who is he?",
      "audioFile": "fr_03_06fb1cd.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_M",
      "durationMs": 1097,
      "updatedAt": "2026-08-25T00:37:58Z",
      "textHash": "0da5b1f8da0b481769ea62c785d87a61fd9a13e185f46d1db014e25c5fb0606c"
    },
    {
      "key": "0757b30",
      "nodeTitle": "submarine_lost",
      "sourceText": "Отлично! Теперь верните его опекуну.",
      "sourceEnText": "Great! Now bring it back to its guardian",
      "audioFile": "fr_03_0757b30.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 4049,
      "updatedAt": "2026-08-25T00:38:43Z",
      "textHash": "43f161aba5285e590c6f7d33964c23bea588e9b2c63eff5b2e6093e08371446e"
    },
    {
      "key": "07c4369",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Помогите! Наша самая ценная машина пропала!",
      "sourceEnText": "Help! Our most precious machine is missing!",
      "audioFile": "fr_03_07c4369.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 3265,
      "updatedAt": "2026-08-25T00:39:05Z",
      "textHash": "252dc7dd54d2f54814e4fd203dec9f400391674ec6ce5e7345098a21466d8816"
    },
    {
      "key": "07ee86b",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Ракета, летящая на Луну, выглядит очень быстрой.",
      "sourceEnText": "The ROCKET to the MOON looks fast.",
      "audioFile": "fr_03_07ee86b.mp3",
      "voiceProfile": "felix",
      "actorId": "KID_M",
      "durationMs": 3265,
      "updatedAt": "2026-08-25T00:37:49Z",
      "textHash": "60dfddb7ea70d0a4a28d673af1efbb054bb8be564fef70bf045920a1768781a3"
    },
    {
      "key": "07f7b4b",
      "nodeTitle": "spawned_guide",
      "sourceText": "Да, он ПИСАТЕЛЬ!",
      "sourceEnText": "Yes, he is a WRITER!",
      "audioFile": "fr_03_07f7b4b.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_M",
      "durationMs": 1280,
      "updatedAt": "2026-08-25T00:37:57Z",
      "textHash": "35d04e1c4c3c5d781cfeead5e8f56d779fb0758ed300e861ecf99c30282a013c"
    },
    {
      "key": "084486e",
      "nodeTitle": "activity_train_done",
      "sourceText": "Вы нашли все транспортные средства!",
      "sourceEnText": "You found all the vehicles!",
      "audioFile": "fr_03_084486e.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2194,
      "updatedAt": "2026-08-25T00:39:10Z",
      "textHash": "bd51a488d22f2ca4923f0ac585f5c05d0dffc30cccc574656309a3e42013e427"
    },
    {
      "key": "08669ce",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Подводная лодка «Наутилус» — это нечто невероятное.",
      "sourceEnText": "The SUBMARINE Nautilus is amazing.",
      "audioFile": "fr_03_08669ce.mp3",
      "voiceProfile": "felix",
      "actorId": "KID_M",
      "durationMs": 3631,
      "updatedAt": "2026-08-25T00:37:53Z",
      "textHash": "6ed056eac272f68c6db00c8144f29a247fc447375e0d0835babdc6b1099e3c59"
    },
    {
      "key": "087acef",
      "nodeTitle": "post_quest_activity",
      "sourceText": "В качестве занятия в классе вы можете НАРИСОВАТЬ ПОДВОДНУЮ ЛОДКУ или РАКЕТУ!",
      "sourceEnText": "As classroom activity, you can DRAW a SUBMARINE or a ROCKET!",
      "audioFile": "fr_03_087acef.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 5277,
      "updatedAt": "2026-08-25T00:38:05Z",
      "textHash": "a7f335ba404d9a26757ee7fa256b0c3ed27586bf7bc477e5abc805d3d960dabd"
    },
    {
      "key": "08cfbc0",
      "nodeTitle": "tutor_80days",
      "sourceText": "Помогите! Мы потеряли ПОЕЗД!",
      "sourceEnText": "Help! We lost the TRAIN!",
      "audioFile": "fr_03_08cfbc0.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 3448,
      "updatedAt": "2026-08-25T00:38:57Z",
      "textHash": "9dfc06454f16409a0a2bd1c24efc6ca01e519028b5ec7aec63d9f6437f99263b"
    },
    {
      "key": "08f0d37",
      "nodeTitle": "quest_end",
      "sourceText": "Задание выполнено! Поздравляем!",
      "sourceEnText": "The quest is complete! Congratulations!",
      "audioFile": "fr_03_08f0d37.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 2351,
      "updatedAt": "2026-08-25T00:38:19Z",
      "textHash": "78791ecc1ac43787a90bc3850ebdb637aa0264ccd5a2565e1c149bf1997e1f12"
    },
    {
      "key": "08fed68",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Вы нашли РАКЕТУ!",
      "sourceEnText": "You found the ROCKET!",
      "audioFile": "fr_03_08fed68.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1411,
      "updatedAt": "2026-08-25T00:39:03Z",
      "textHash": "e7027eda4ebfee4f9038a13e91324428e4527483e461bab0e09c5fe35600f8b8"
    },
    {
      "key": "0907ccb",
      "nodeTitle": "book_earthmoon",
      "sourceText": "Жюль Верн давно уже придумал РАКЕТЫ и космические ПУТЕШЕСТВИЯ.",
      "sourceEnText": "Jules Verne imagined ROCKETS and space TRAVEL long ago.",
      "audioFile": "fr_03_0907ccb.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 4101,
      "updatedAt": "2026-08-25T00:39:13Z",
      "textHash": "91c67658c499dfb7f91fb596202450d7a11ea8a1fdba5e25129f974d9fdb35f9"
    },
    {
      "key": "09438f6",
      "nodeTitle": "activity_submarine_done",
      "sourceText": "Теперь перейдите к следующему опекуну.",
      "sourceEnText": "Now go to next guardian.",
      "audioFile": "fr_03_09438f6.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2482,
      "updatedAt": "2026-08-25T00:38:41Z",
      "textHash": "dd4f5c530c958da59f266bddb7b117ded653ab20c9d2832ca8dbf7fa10f4222d"
    },
    {
      "key": "096a3b3",
      "nodeTitle": "verne_painting",
      "sourceText": "Это Жюль Верн. Он был ПИСАТЕЛЕМ.",
      "sourceEnText": "This is Jules Verne. He was a WRITER.",
      "audioFile": "fr_03_096a3b3.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2377,
      "updatedAt": "2026-08-25T00:37:28Z",
      "textHash": "4b844f7fddfbde25730902e4fa4c03084845246f57cefda8c349b129abda3ee2"
    },
    {
      "key": "097c3fc",
      "nodeTitle": "tutor_20000",
      "sourceText": "Но оно СЛОМАНО!",
      "sourceEnText": "But it's BROKEN!",
      "audioFile": "fr_03_097c3fc.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1228,
      "updatedAt": "2026-08-25T00:38:51Z",
      "textHash": "70e021de383bbf7a5af4f1930ecd48690d45fcc95ff385068eff637b32a2cc08"
    },
    {
      "key": "0998347",
      "nodeTitle": "train",
      "sourceText": "Поезд движется по рельсам.",
      "sourceEnText": "A TRAIN runs on RAILS.",
      "audioFile": "fr_03_0998347.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1724,
      "updatedAt": "2026-08-25T00:38:59Z",
      "textHash": "1608d83f96cf054c5f0c86235f133998fbbcc61e71def78e92b200f95d130eb7"
    },
    {
      "key": "09a8c21",
      "nodeTitle": "balloon",
      "sourceText": "Оно движется вместе с ветром.",
      "sourceEnText": "It moves with the WIND.",
      "audioFile": "fr_03_09a8c21.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1959,
      "updatedAt": "2026-08-25T00:37:39Z",
      "textHash": "72a7077056b4b39706ab7f559866bc4d47f9026b1740927cf87b4bb412786c79"
    },
    {
      "key": "09bcaba",
      "nodeTitle": "map_nantes",
      "sourceText": "Это карта Нанта.",
      "sourceEnText": "This is a MAP of NANTES.",
      "audioFile": "fr_03_09bcaba.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1358,
      "updatedAt": "2026-08-25T00:37:30Z",
      "textHash": "cfaa286c1ea185b99c5a1499a37d1b5c26105f8655816a8a6220f8c838eb91b7"
    },
    {
      "key": "09eafa1",
      "nodeTitle": "museum_guide",
      "sourceText": "Вы можете помочь с уборкой музея?",
      "sourceEnText": "Can you help cleaning the MUSEUM?",
      "audioFile": "fr_03_09eafa1.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2194,
      "updatedAt": "2026-08-25T00:38:21Z",
      "textHash": "27e612f320d62674c3478b4cc57268ebaa783bef05d9550d9c15cfc66f1a5d72"
    },
    {
      "key": "0a1520b",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Найдите воздушный шар",
      "sourceEnText": "Find the HOT AIR BALLOON",
      "audioFile": "fr_03_0a1520b.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1541,
      "updatedAt": "2026-08-25T00:38:47Z",
      "textHash": "e7fd457c52598b662c5231e1297a3b326cd34e06c56b2ef1173dd3a796da8a29"
    },
    {
      "key": "0a3e2f4",
      "nodeTitle": "npc_door",
      "sourceText": "Какой же бардак перед музеем!",
      "sourceEnText": "What a MESS outside the MUSEUM!",
      "audioFile": "fr_03_0a3e2f4.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 2011,
      "updatedAt": "2026-08-25T00:38:07Z",
      "textHash": "ce29586e744fe63c4eac8350b57676cedf9a89e76ffb6545f09e7b53cfadf3bf"
    },
    {
      "key": "0a7dfb3",
      "nodeTitle": "museum_guide",
      "sourceText": "У нас ещё одна ПРОБЛЕМА!",
      "sourceEnText": "We have another PROBLEM!",
      "audioFile": "fr_03_0a7dfb3.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T00:38:26Z",
      "textHash": "e91ac41766c2bb43d774d27e5eae4a71a9beffaf0ceb6b06dc56fa29c7811429"
    },
    {
      "key": "0b5e2f3",
      "nodeTitle": "quest_start",
      "sourceText": "Добро пожаловать в Нант! Посетите Музей Жюля Верна!",
      "sourceEnText": "Welcome to Nantes. Go and discover the Jules Verne Museum!",
      "audioFile": "fr_03_0b5e2f3.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 3736,
      "updatedAt": "2026-08-25T00:37:25Z",
      "textHash": "0f71280ac9eb44fda7b3ba70abd8d3ee8521c94132253cc823fd13d585853ee9"
    },
    {
      "key": "0b5eb24",
      "nodeTitle": "task_clean_museum_done",
      "sourceText": "Отлично. Теперь в музее чисто! Вернитесь к путеводителю по музею.",
      "sourceEnText": "Perfect. Now the Museum is clean! Go back to the MUSEUM GUIDE.",
      "audioFile": "fr_03_0b5eb24.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 5355,
      "updatedAt": "2026-08-25T00:38:33Z",
      "textHash": "db0ed692d0d3e0a326712cfe19bc22a04df942442da1ffa088c0e29759c5dc26"
    },
    {
      "key": "0b7b198",
      "nodeTitle": "train",
      "sourceText": "Этот старый поезд передвигался на ПАРЕ.",
      "sourceEnText": "This old TRAIN used STEAM to move.",
      "audioFile": "fr_03_0b7b198.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2482,
      "updatedAt": "2026-08-25T00:39:01Z",
      "textHash": "58acb5173d33838d85151c5bdba15d8abbb36a4d15830801aa9c7677e48d4a7a"
    },
    {
      "key": "0ba85d3",
      "nodeTitle": "activity_submarine_done",
      "sourceText": "Вы всё починили! Спасибо!",
      "sourceEnText": "You repaired it! Thank you!",
      "audioFile": "fr_03_0ba85d3.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2351,
      "updatedAt": "2026-08-25T00:38:40Z",
      "textHash": "fe5bb3e2cc6e0e542801a51d655aaa77f83dee11eb4c8a2273d7c7751f96d7fb"
    },
    {
      "key": "0bb264b",
      "nodeTitle": "tutor_20000",
      "sourceText": "Найдите подводную лодку",
      "sourceEnText": "Find the SUBMARINE",
      "audioFile": "fr_03_0bb264b.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1698,
      "updatedAt": "2026-08-25T00:38:39Z",
      "textHash": "93046b3fe3a3fc78efcbd5a4ce57b48b3967614a810e7fea2bc9d2fd3ce8db3f"
    },
    {
      "key": "0bb46da",
      "nodeTitle": "museum_guide",
      "sourceText": "Этих транспортных средств там больше нет.",
      "sourceEnText": "The vehicles are no longer there.",
      "audioFile": "fr_03_0bb46da.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2560,
      "updatedAt": "2026-08-25T00:38:28Z",
      "textHash": "fa550b5dbb59732fcc69d93d78d97aa239ce83fdd50f3553baff7644d02e61b4"
    },
    {
      "key": "0bc6c7b",
      "nodeTitle": "museum_guide",
      "sourceText": "Жюль Верн гордился бы тобой!",
      "sourceEnText": "Jules Verne would be proud of you!",
      "audioFile": "fr_03_0bc6c7b.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1881,
      "updatedAt": "2026-08-25T00:38:22Z",
      "textHash": "ab5f7019efc3306c1199b44c271f245cb80522cea87d743befa59f4e17b9a67b"
    },
    {
      "key": "0bcc84d",
      "nodeTitle": "book_80days",
      "sourceText": "На нём изображено множество мест на Земле.",
      "sourceEnText": "It shows many places on EARTH.",
      "audioFile": "fr_03_0bcc84d.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2664,
      "updatedAt": "2026-08-25T00:37:50Z",
      "textHash": "a64794bfdd2d7b57474677e50fa77587b9ca46655000911663b354dfd0deaf5e"
    },
    {
      "key": "0c3d777",
      "nodeTitle": "book_5weeks",
      "sourceText": "Эта книга называется \"Пять недель на воздушном шаре\".",
      "sourceEnText": "This BOOK is \"Five Weeks in a Balloon.\"",
      "audioFile": "fr_03_0c3d777.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 3187,
      "updatedAt": "2026-08-25T00:38:48Z",
      "textHash": "4032f013205569641754bb2e629ca494323e0090778c6dc411f837e2c7e60816"
    },
    {
      "key": "0c52f3c",
      "nodeTitle": "museum_guide",
      "sourceText": "Это хорошо. Вы ещё не закончили, продолжайте!",
      "sourceEnText": "You are doing well!",
      "audioFile": "fr_03_0c52f3c.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 3396,
      "updatedAt": "2026-08-25T00:38:25Z",
      "textHash": "b0d33f3783a6daab2dd52ebc356715d4562a302617cea74f17ce1ae94d4ffef8"
    },
    {
      "key": "0c790cf",
      "nodeTitle": "spawned_guide",
      "sourceText": "Жюль Верн был французским писателем. Он родился неподалеку.",
      "sourceEnText": "Jules Verne was a French WRITER. He was born near here.",
      "audioFile": "fr_03_0c790cf.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_M",
      "durationMs": 3814,
      "updatedAt": "2026-08-25T00:38:00Z",
      "textHash": "ce4c1989ed4f757c633ad8a03af73b9eb9517dbd27f2a91a6ddffc578af4df2e"
    },
    {
      "key": "0c81640",
      "nodeTitle": "museum_guide",
      "sourceText": "Спасибо! Теперь с музеем всё в порядке.",
      "sourceEnText": "Thank you! Now the MUSEUM is in order",
      "audioFile": "fr_03_0c81640.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 4232,
      "updatedAt": "2026-08-25T00:38:18Z",
      "textHash": "002c3fcfdc87e0ec7114395032576555f13b359ffabefd57c163125a2f21b12e"
    },
    {
      "key": "0caca1b",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Жюль Верн написал множество книг!",
      "sourceEnText": "Jules Verne wrote many BOOKS!",
      "audioFile": "fr_03_0caca1b.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 2482,
      "updatedAt": "2026-08-25T00:37:43Z",
      "textHash": "e3c8c3fa9bbdc46e4516e8300c0859167a4ea31ffdbe8d146304d449b7682589"
    },
    {
      "key": "0cec96a",
      "nodeTitle": "npc_door",
      "sourceText": "Спасибо за уборку!",
      "sourceEnText": "Thank you for cleaning up!",
      "audioFile": "fr_03_0cec96a.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 1541,
      "updatedAt": "2026-08-25T00:38:09Z",
      "textHash": "0558d122bd85791408594e5282a2ef094cb1b0249cc0f29c1873885e41ea6f21"
    },
    {
      "key": "0d2e2f0",
      "nodeTitle": "npc_door",
      "sourceText": "Музей открыт! Поговорите с экскурсоводом музея!",
      "sourceEnText": "The Museum is now open! Talk to the MUSEUM GUIDE!",
      "audioFile": "fr_03_0d2e2f0.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 3396,
      "updatedAt": "2026-08-25T00:38:11Z",
      "textHash": "e90f0bcc1843f2aef21b972fc5552221300bacb2c155fafd4f3df1ac85630ae2"
    },
    {
      "key": "0d58543",
      "nodeTitle": "npc_door",
      "sourceText": "Я не могу открыть музей из-за этого бардака.",
      "sourceEnText": "I can't open the MUSEUM with this mess here.",
      "audioFile": "fr_03_0d58543.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 2612,
      "updatedAt": "2026-08-25T00:38:14Z",
      "textHash": "6978346b9bf7b322d16901da236f8849dc8ad9aa242c65f008c6589f8b0fd76b"
    },
    {
      "key": "0dcb855",
      "nodeTitle": "book_20000",
      "sourceText": "Подводная лодка перемещается ПОД ВОДОЙ.",
      "sourceEnText": "A SUBMARINE travels UNDERWATER.",
      "audioFile": "fr_03_0dcb855.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2769,
      "updatedAt": "2026-08-25T00:37:36Z",
      "textHash": "f525703d89ac8fceca3f0424cb5d39660d3447517e9613c03b519c88b07d383c"
    },
    {
      "key": "0de00ff",
      "nodeTitle": "rocket",
      "sourceText": "Это космическая ракета.",
      "sourceEnText": "This is a space ROCKET.",
      "audioFile": "fr_03_0de00ff.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T00:39:09Z",
      "textHash": "3db70db5061f08d52511f289c1fb5e20bcd3dd7a65f635129545443b55af2d83"
    },
    {
      "key": "0e81901",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Мне нравится история о МИРЕ.",
      "sourceEnText": "I like the story about the WORLD.",
      "audioFile": "fr_03_0e81901.mp3",
      "voiceProfile": "felix",
      "actorId": "KID_M",
      "durationMs": 1933,
      "updatedAt": "2026-08-25T00:37:46Z",
      "textHash": "dcd83693cca2798bcebfd20c8ae50c70769c345f3a96159a0f9090d8305de084"
    },
    {
      "key": "0e86b01",
      "nodeTitle": "activity_match_done",
      "sourceText": "Отлично! Вы сопоставили все книги с соответствующими транспортными средствами.",
      "sourceEnText": "Well done! You matched all the BOOKS with their VEHICLES.",
      "audioFile": "fr_03_0e86b01.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 5172,
      "updatedAt": "2026-08-25T00:38:31Z",
      "textHash": "b58a257935c319f39e7f3e87ae59cad1d6efe49a37add234b965279bed8ba2a1"
    },
    {
      "key": "0e928ab",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Помогите! Чего-то не хватает!",
      "sourceEnText": "Help! Something is missing!",
      "audioFile": "fr_03_0e928ab.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2377,
      "updatedAt": "2026-08-25T00:38:46Z",
      "textHash": "f37d987e6d7274c04c951c93101f7cb1ca593a291198c990e813c08f4c29a2fb"
    },
    {
      "key": "0ee83b2",
      "nodeTitle": "activity_train_done",
      "sourceText": "Вернуться к путеводителю по музею!",
      "sourceEnText": "Go back to the MUSEUM GUIDE!",
      "audioFile": "fr_03_0ee83b2.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_F",
      "durationMs": 2377,
      "updatedAt": "2026-08-25T00:39:08Z",
      "textHash": "03ebdbe0e5403c2fc81505c256a12f3883d2a0225f77aab22a45131ec1dd6c44"
    },
    {
      "key": "0f5f36d",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Его книги читают на многих языках!",
      "sourceEnText": "People read his BOOKS in many languages!",
      "audioFile": "fr_03_0f5f36d.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 2482,
      "updatedAt": "2026-08-25T00:37:44Z",
      "textHash": "57918704a0a8752df19458ac9408c11e11d87238d56d53fd1265ce0c918f3740"
    },
    {
      "key": "0f72ec7",
      "nodeTitle": "quest_end",
      "sourceText": "Если вы поедете в Нант с родителями, обязательно посетите Музей Жюля Верна!",
      "sourceEnText": "If you go to Nantes with your parents, go to the Jules Verne Museum!",
      "audioFile": "fr_03_0f72ec7.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 5224,
      "updatedAt": "2026-08-25T00:38:08Z",
      "textHash": "d8b63ecae296718ba1336b8faf0f9dfea23320fc3002921c896ea49df63bf487"
    },
    {
      "key": "0f8dd6c",
      "nodeTitle": "task_clean_done",
      "sourceText": "Отлично! Вернитесь и поговорите с джентльменом у входа в музей.",
      "sourceEnText": "Well done! Go back and see the gentleman at the museum entrance.",
      "audioFile": "fr_03_0f8dd6c.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
