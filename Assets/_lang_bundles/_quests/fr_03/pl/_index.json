  "lang": "pl",
  "lines": [
    {
      "key": "003b311",
      "nodeTitle": "verne_house",
      "sourceText": "Juliusz Verne urodził się tutaj, w NANTES.",
      "sourceEnText": "Jules Verne was born here in NANTES.",
      "audioFile": "fr_03_003b311.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3135,
      "updatedAt": "2026-08-25T00:32:57Z",
      "textHash": "421c75646f46189462c38a337220a363a8589b91e1a79d43ce78c2f17bbdaecd"
    },
    {
      "key": "006e7fc",
      "nodeTitle": "quest_start",
      "sourceText": "Kim jest Juliusz Verne? I dokąd podróżował?",
      "sourceEnText": "Who is Jules Verne? And where did he travel?",
      "audioFile": "fr_03_006e7fc.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2978,
      "updatedAt": "2026-08-25T00:33:32Z",
      "textHash": "f3d6a8e95c7e8fdb0575a9c72ff390431a5d4d40ce3527a7595748fd3c1d562b"
    },
    {
      "key": "00a6154",
      "nodeTitle": "tutor_20000",
      "sourceText": "Pomocy! Nautilus zaginął!",
      "sourceEnText": "Help! The Nautilus is missing!",
      "audioFile": "fr_03_00a6154.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2664,
      "updatedAt": "2026-08-25T00:34:34Z",
      "textHash": "1af5251d9e3cacf8b33e59332a1e072e762dee1a5f98d26edafcf2d43ddf5b99"
    },
    {
      "key": "00b1d04",
      "nodeTitle": "spawned_guide",
      "sourceText": "Czy wiesz kim był Juliusz Verne?",
      "sourceEnText": "Do you know who Jules Verne is?",
      "audioFile": "fr_03_00b1d04.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1959,
      "updatedAt": "2026-08-25T00:33:33Z",
      "textHash": "0773df71f46cb3fb8152d897cafa90052aaad3e48f3bfa8c42a9dfa8f377e0d5"
    },
    {
      "key": "00be1f0",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Chciałbym kiedyś wybrać się na lot balonem.",
      "sourceEnText": "I want to ride a BALLOON one day.",
      "audioFile": "fr_03_00be1f0.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 2534,
      "updatedAt": "2026-08-25T00:33:23Z",
      "textHash": "d406cea9c9f0ec0bed2f250d609cf866a331b72636265356fc98fb1f176d5156"
    },
    {
      "key": "00eefe0",
      "nodeTitle": "activity_match_done",
      "sourceText": "Teraz wszystko jest gotowe na przyjęcie gości!",
      "sourceEnText": "Now everything is ready for the visitors!",
      "audioFile": "fr_03_00eefe0.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2952,
      "updatedAt": "2026-08-25T00:34:26Z",
      "textHash": "6dd5189a28fe13f649585f565810527b52efbbce92e5b21492802d2322df12d9"
    },
    {
      "key": "00f3a57",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Uwielbiam czytać KSIĄŻKI!",
      "sourceEnText": "I love reading BOOKS!",
      "audioFile": "fr_03_00f3a57.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1933,
      "updatedAt": "2026-08-25T00:33:14Z",
      "textHash": "260b8cc8352a058ef4b336e742da98069295d7b4fec486525125450f2eafc25a"
    },
    {
      "key": "0131b99",
      "nodeTitle": "balloon",
      "sourceText": "BALONIK unosi się w górę dzięki ciepłemu POWIETRZU.",
      "sourceEnText": "A BALLOON goes up with warm AIR.",
      "audioFile": "fr_03_0131b99.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3631,
      "updatedAt": "2026-08-25T00:33:10Z",
      "textHash": "400fd9411ca02a79413425e610e31c1c763a0104d88314eb85df80268e3cade1"
    },
    {
      "key": "0174104",
      "nodeTitle": "quest_end",
      "sourceText": "Teraz wiesz o Juliuszu Verne i jego KSIĄŻKACH!",
      "sourceEnText": "Now you know about Jules Verne and his BOOKS!",
      "audioFile": "fr_03_0174104.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3318,
      "updatedAt": "2026-08-25T00:32:53Z",
      "textHash": "c87335c670c2326edc7721d7ffb0ecc6490ad616c85b87657df84fd0235994fc"
    },
    {
      "key": "01a9d0f",
      "nodeTitle": "npc_door",
      "sourceText": "Pomóż mi posprzątać chodnik!",
      "sourceEnText": "Help me clean the sidewalk!",
      "audioFile": "fr_03_01a9d0f.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1933,
      "updatedAt": "2026-08-25T00:34:00Z",
      "textHash": "3cbe9ce0a8802ca52d2262aa296fe4a992b443176281bfbbdffa18c2cf78d3d9"
    },
    {
      "key": "01f76f3",
      "nodeTitle": "tutor_80days",
      "sourceText": "Znalazłeś POCIĄG!",
      "sourceEnText": "You found the TRAIN!",
      "audioFile": "fr_03_01f76f3.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1698,
      "updatedAt": "2026-08-25T00:35:01Z",
      "textHash": "64d06d8ed4548691a90ec96ce0a8148f528334372992ff0b0c41eb65b3a001f9"
    },
    {
      "key": "020d924",
      "nodeTitle": "book_5weeks",
      "sourceText": "BALONIK unosi się, ponieważ ciepłe POWIETRZE jest lekkie.",
      "sourceEnText": "A BALLOON rises because warm AIR is light.",
      "audioFile": "fr_03_020d924.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3788,
      "updatedAt": "2026-08-25T00:34:53Z",
      "textHash": "0e3da03bfaa20eef07a023550794b08f34281837e37880a47e8ab99430e6b09a"
    },
    {
      "key": "0210ef0",
      "nodeTitle": "npc_door",
      "sourceText": "Ten niebieski PIES biegł i narobił bałaganu!",
      "sourceEnText": "That blue DOG was running and made a mess!",
      "audioFile": "fr_03_0210ef0.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3631,
      "updatedAt": "2026-08-25T00:33:56Z",
      "textHash": "61813f8dc3e551c9b723fbc24354aedbcdedd26ab79a09c30ce1bb94b7ed8654"
    },
    {
      "key": "0245e0e",
      "nodeTitle": "museum_guide",
      "sourceText": "Połącz KSIĄŻKI z pojazdami!",
      "sourceEnText": "Put the BOOKS together with their vehicles!",
      "audioFile": "fr_03_0245e0e.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1881,
      "updatedAt": "2026-08-25T00:34:13Z",
      "textHash": "e0a7f54effceaa4347f7bff6935e349d2be2a0f79ba64bc633f05d2b7bf909ce"
    },
    {
      "key": "0286510",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Znalazłeś BALON NA OGRODZENIOWE POWIETRZE! Nazywa się go też balonem.",
      "sourceEnText": "You found the HOT AIR BALLOON!",
      "audioFile": "fr_03_0286510.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 5538,
      "updatedAt": "2026-08-25T00:34:45Z",
      "textHash": "edf1f9bc21698850a682a94b87ffaf7fa1dbae1a6cb15014f9b0429e4a903640"
    },
    {
      "key": "02e7812",
      "nodeTitle": "tutor_20000",
      "sourceText": "Czy możesz to naprawić?",
      "sourceEnText": "Can you please fix it?",
      "audioFile": "fr_03_02e7812.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T00:34:32Z",
      "textHash": "46c59a9e5d8700bf0c463c37c76110c08c0e0121c21eac405f26e33f41835d84"
    },
    {
      "key": "03131e3",
      "nodeTitle": "book_80days",
      "sourceText": "Ta KSIĄŻKA nosi tytuł „W 80 dni dookoła świata”.",
      "sourceEnText": "This BOOK is \"Around the World in 80 Days.\"",
      "audioFile": "fr_03_03131e3.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 4206,
      "updatedAt": "2026-08-25T00:33:01Z",
      "textHash": "2317a7f65b36fd23d245acb84ec6cb376a96265a2c6a53a489438d12311d1dac"
    },
    {
      "key": "03536a1",
      "nodeTitle": "book_20000",
      "sourceText": "Ta KSIĄŻKA nosi tytuł „20 000 mil podmorskiej żeglugi”.",
      "sourceEnText": "This BOOK is \"20,000 Leagues Under the Seas.\"",
      "audioFile": "fr_03_03536a1.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 4989,
      "updatedAt": "2026-08-25T00:33:06Z",
      "textHash": "721ba4eba9d94a2d68362ebfc4bfd419a913c76d9cd9f32581dae2eeba562cf6"
    },
    {
      "key": "036574d",
      "nodeTitle": "tutor_80days",
      "sourceText": "Znajdź STARY POCIĄG PAROWY",
      "sourceEnText": "Find the OLD STEAM TRAIN",
      "audioFile": "fr_03_036574d.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2717,
      "updatedAt": "2026-08-25T00:35:05Z",
      "textHash": "efb7d4f397da52a3c8d72bafc29e219196e78c7105f91e0f48a8aed4be85c8e9"
    },
    {
      "key": "0386706",
      "nodeTitle": "museum_guide",
      "sourceText": "Proszę porozmawiać z opiekunem pierwszego pokoju.",
      "sourceEnText": "Please talk to the first room guardian.",
      "audioFile": "fr_03_0386706.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3605,
      "updatedAt": "2026-08-25T00:34:21Z",
      "textHash": "17a1b503d43fa4da9b9aea520e2570cb0722e61893a4130ab5f055c9811d0747"
    },
    {
      "key": "03af9a8",
      "nodeTitle": "tutor_20000",
      "sourceText": "Wróć do mnie później.",
      "sourceEnText": "Come back to me later.",
      "audioFile": "fr_03_03af9a8.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1411,
      "updatedAt": "2026-08-25T00:34:57Z",
      "textHash": "7b1f005ed6a1208da2641e2b7548056a556a89dfada2658f1fc7d268ddc0e059"
    },
    {
      "key": "03efbc0",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Znajdź RAKIETĘ KOSMICZNĄ",
      "sourceEnText": "Find the SPACE ROCKET",
      "audioFile": "fr_03_03efbc0.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2142,
      "updatedAt": "2026-08-25T00:35:19Z",
      "textHash": "1a36027bbc1e0ec3a24786eb88a44a1a6d22a6cbdee5eba21e09a3d34018ff50"
    },
    {
      "key": "05130c0",
      "nodeTitle": "train",
      "sourceText": "Dzięki pociągom długie podróże stały się szybsze.",
      "sourceEnText": "TRAINS made long trips faster.",
      "audioFile": "fr_03_05130c0.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3318,
      "updatedAt": "2026-08-25T00:35:12Z",
      "textHash": "d25005d558264df7970970064bbf8026ca7f27525649f8740be70f4c8cf5870d"
    },
    {
      "key": "0525efc",
      "nodeTitle": "museum_guide",
      "sourceText": "Zabawny niebieski PIES wszedł do MUZEUM i narobił bałaganu!",
      "sourceEnText": "A funny blue DOG entered the MUSEUM and made a mess!",
      "audioFile": "fr_03_0525efc.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 4232,
      "updatedAt": "2026-08-25T00:33:43Z",
      "textHash": "c77fa21482acecd0df875823f7acca707d0532167276370e9d4af51e67455386"
    },
    {
      "key": "056e79e",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Juliusz Verne wymyślił opowieści science fiction.",
      "sourceEnText": "Jules Verne invented science FICTION stories.",
      "audioFile": "fr_03_056e79e.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3553,
      "updatedAt": "2026-08-25T00:33:16Z",
      "textHash": "9a355339080610ab9a54a573155e2915afad0646692a78a638edd76575be0405"
    },
    {
      "key": "05bc5e9",
      "nodeTitle": "tutor_20000",
      "sourceText": "Jeśli nie możesz tego znaleźć, UŻYJ MAPY",
      "sourceEnText": "If you can't find it, USE THE MAP",
      "audioFile": "fr_03_05bc5e9.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3135,
      "updatedAt": "2026-08-25T00:35:27Z",
      "textHash": "f4aeb96fab495159db3d31f9916d5e8a29eb6ba0d951464cd9945ba7471b7196"
    },
    {
      "key": "05e298d",
      "nodeTitle": "book_earthmoon",
      "sourceText": "Historia ma ogromną przestrzeń, w której DZIAŁO wystrzeliwuje RAKIETĘ",
      "sourceEnText": "The story has a huge space CANNON to launch the ROCKET",
      "audioFile": "fr_03_05e298d.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 4571,
      "updatedAt": "2026-08-25T00:35:31Z",
      "textHash": "872fe8c7dac567131d955e72ae1aa77424febda31847c63ac49d6383d776a60d"
    },
    {
      "key": "0642734",
      "nodeTitle": "museum_guide",
      "sourceText": "Mamy PROBLEM!",
      "sourceEnText": "We have a PROBLEM!",
      "audioFile": "fr_03_0642734.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1358,
      "updatedAt": "2026-08-25T00:33:40Z",
      "textHash": "9228f64524306d559f784d41039497235926b2b9476561d1c07243409b4ad179"
    },
    {
      "key": "0666ee2",
      "nodeTitle": "tutor_20000",
      "sourceText": "Znalazłeś ŁÓDŹ PODWODNĄ!",
      "sourceEnText": "You found the SUBMARINE!",
      "audioFile": "fr_03_0666ee2.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2116,
      "updatedAt": "2026-08-25T00:34:30Z",
      "textHash": "abbb2b97202821b39f5f33c769737361ad38d6db1c988e49294e099f9bb0b06e"
    },
    {
      "key": "06aef1a",
      "nodeTitle": "submarine",
      "sourceText": "ŁÓDŹ PODWODNA porusza się pod wodą.",
      "sourceEnText": "A SUBMARINE moves under the SEA.",
      "audioFile": "fr_03_06aef1a.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2299,
      "updatedAt": "2026-08-25T00:34:59Z",
      "textHash": "b46e086d0a077422296c8ae41059d2ccbb261f8c92a5e0c59f12cfcfe1ebac96"
    },
    {
      "key": "06b6d4d",
      "nodeTitle": "rocket",
      "sourceText": "RAKIETA mocno próbuje opuścić ZIEMIĘ.",
      "sourceEnText": "A ROCKET pushes hard to leave EARTH.",
      "audioFile": "fr_03_06b6d4d.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2900,
      "updatedAt": "2026-08-25T00:33:03Z",
      "textHash": "10aa7c27c2de0cd307bd87c5c7a6d1ba445859f3a51ce4cd8d55fedc5d202c94"
    },
    {
      "key": "06e1473",
      "nodeTitle": "spawned_guide",
      "sourceText": "Wiele pomysłów zawartych w jego KSIĄŻKACH stało się rzeczywistością.",
      "sourceEnText": "Many ideas in his BOOKS became real.",
      "audioFile": "fr_03_06e1473.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 4232,
      "updatedAt": "2026-08-25T00:33:28Z",
      "textHash": "d170aae2f54f080a1a785996cb9746290c6538ed58712a8ad0798e6bca40751f"
    },
    {
      "key": "06fb1cd",
      "nodeTitle": "spawned_guide",
      "sourceText": "Nie, kim on jest?",
      "sourceEnText": "No, who is he?",
      "audioFile": "fr_03_06fb1cd.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1463,
      "updatedAt": "2026-08-25T00:33:36Z",
      "textHash": "f21fdf51917bb23584c14ad4cbec2c0f74a9410df4b53267f288c36ff065a91f"
    },
    {
      "key": "0757b30",
      "nodeTitle": "submarine_lost",
      "sourceText": "Świetnie! Teraz oddaj go opiekunowi.",
      "sourceEnText": "Great! Now bring it back to its guardian",
      "audioFile": "fr_03_0757b30.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2900,
      "updatedAt": "2026-08-25T00:34:42Z",
      "textHash": "18eab4ec05c3a6c9833b387105664b3692f4fc60779dfe2edc98e2d49f4fc5d4"
    },
    {
      "key": "07c4369",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Ratunku! Nasza najcenniejsza maszyna zaginęła!",
      "sourceEnText": "Help! Our most precious machine is missing!",
      "audioFile": "fr_03_07c4369.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3448,
      "updatedAt": "2026-08-25T00:35:17Z",
      "textHash": "7b7ca3539177c66f0dd4c1ef92a09be9b2b14654be74cdefc4974f02bf0b36a9"
    },
    {
      "key": "07ee86b",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "RAKIETA na KSIĘŻYC wygląda na szybką.",
      "sourceEnText": "The ROCKET to the MOON looks fast.",
      "audioFile": "fr_03_07ee86b.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 2482,
      "updatedAt": "2026-08-25T00:33:25Z",
      "textHash": "c47173f1507c11bd90e22afa3df4688f36ef3d9c3feb2c386c6b5a3814eb5d81"
    },
    {
      "key": "07f7b4b",
      "nodeTitle": "spawned_guide",
      "sourceText": "Tak, on jest PISARZEM!",
      "sourceEnText": "Yes, he is a WRITER!",
      "audioFile": "fr_03_07f7b4b.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1541,
      "updatedAt": "2026-08-25T00:33:34Z",
      "textHash": "84f65a292bd0de34b70f1ac801d919bb8c138c700d685d462821cca96c112ff0"
    },
    {
      "key": "084486e",
      "nodeTitle": "activity_train_done",
      "sourceText": "Znalazłeś wszystkie pojazdy!",
      "sourceEnText": "You found all the vehicles!",
      "audioFile": "fr_03_084486e.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1881,
      "updatedAt": "2026-08-25T00:35:25Z",
      "textHash": "350dc9bb8c48d9620cf91ffb91de8732c7a8bef53ba70043440d55929ad0b561"
    },
    {
      "key": "08669ce",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Łódź podwodna Nautilus jest niesamowita.",
      "sourceEnText": "The SUBMARINE Nautilus is amazing.",
      "audioFile": "fr_03_08669ce.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 2978,
      "updatedAt": "2026-08-25T00:33:30Z",
      "textHash": "9d23dafa88ddc8ee6aee6b42aa9e4f3b4c50faeb8779892c465df1e1cb47b8d6"
    },
    {
      "key": "087acef",
      "nodeTitle": "post_quest_activity",
      "sourceText": "W ramach zajęć w klasie możesz NARYSOWAĆ ŁÓDŹ PODWODNĄ lub RAKIETĘ!",
      "sourceEnText": "As classroom activity, you can DRAW a SUBMARINE or a ROCKET!",
      "audioFile": "fr_03_087acef.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 5355,
      "updatedAt": "2026-08-25T00:33:45Z",
      "textHash": "e923adbb993b958b1fe75c6295a59cee8f692c38da95e9e59dc5d2caeabe0d7f"
    },
    {
      "key": "08cfbc0",
      "nodeTitle": "tutor_80days",
      "sourceText": "Ratunku! Zgubiliśmy POCIĄG!",
      "sourceEnText": "Help! We lost the TRAIN!",
      "audioFile": "fr_03_08cfbc0.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2377,
      "updatedAt": "2026-08-25T00:35:03Z",
      "textHash": "5863268b5cf5f21750731d68ee551797b3e2556f920d2f919ee81c44f1ddf4b6"
    },
    {
      "key": "08f0d37",
      "nodeTitle": "quest_end",
      "sourceText": "Zadanie ukończone! Gratulacje!",
      "sourceEnText": "The quest is complete! Congratulations!",
      "audioFile": "fr_03_08f0d37.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2194,
      "updatedAt": "2026-08-25T00:34:07Z",
      "textHash": "a6be5f7a3cb44e925378ccfcfb53ee802b659d4c322554e4f37087ea2e91477f"
    },
    {
      "key": "08fed68",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Znalazłeś RAKIETĘ!",
      "sourceEnText": "You found the ROCKET!",
      "audioFile": "fr_03_08fed68.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1724,
      "updatedAt": "2026-08-25T00:35:14Z",
      "textHash": "cc5f0f2d48221461c14dfe3dfb517b1605f59d5b6bde69f827dd8d02bef3640b"
    },
    {
      "key": "0907ccb",
      "nodeTitle": "book_earthmoon",
      "sourceText": "Juliusz Verne dawno temu wyobrażał sobie RAKIETY i PODRÓŻE kosmiczne.",
      "sourceEnText": "Jules Verne imagined ROCKETS and space TRAVEL long ago.",
      "audioFile": "fr_03_0907ccb.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 5224,
      "updatedAt": "2026-08-25T00:35:29Z",
      "textHash": "db72a65429eb1ca3520eb8907a22c3f60d9f9e8edc71a673ec5077cf5b15a52e"
    },
    {
      "key": "09438f6",
      "nodeTitle": "activity_submarine_done",
      "sourceText": "Teraz przejdź do następnego strażnika.",
      "sourceEnText": "Now go to next guardian.",
      "audioFile": "fr_03_09438f6.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2560,
      "updatedAt": "2026-08-25T00:34:40Z",
      "textHash": "21acc77fa160547fe909778d1c92e9948908dc5f772c96a6248601e81cffcf55"
    },
    {
      "key": "096a3b3",
      "nodeTitle": "verne_painting",
      "sourceText": "To jest Juliusz Verne. Był PISARZEM.",
      "sourceEnText": "This is Jules Verne. He was a WRITER.",
      "audioFile": "fr_03_096a3b3.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2560,
      "updatedAt": "2026-08-25T00:32:55Z",
      "textHash": "a5cc61c4c391073fbb06ff9432aee0d717bb2c678b2f35d02eb7e7a0377cdb49"
    },
    {
      "key": "097c3fc",
      "nodeTitle": "tutor_20000",
      "sourceText": "Ale jest zepsute!",
      "sourceEnText": "But it's BROKEN!",
      "audioFile": "fr_03_097c3fc.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T00:34:55Z",
      "textHash": "bf4ec60d557c1c6aa96a8f3016a298edf0536687a1393ee912ed63f0037fb35f"
    },
    {
      "key": "0998347",
      "nodeTitle": "train",
      "sourceText": "POCIĄG porusza się po SZYNACH.",
      "sourceEnText": "A TRAIN runs on RAILS.",
      "audioFile": "fr_03_0998347.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2247,
      "updatedAt": "2026-08-25T00:35:08Z",
      "textHash": "f669e1f512bc12223e260278fe574496d18b15b15ab33d6579821fa8ca7d9c33"
    },
    {
      "key": "09a8c21",
      "nodeTitle": "balloon",
      "sourceText": "Porusza się z WIATREM.",
      "sourceEnText": "It moves with the WIND.",
      "audioFile": "fr_03_09a8c21.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T00:33:12Z",
      "textHash": "eea12a714fbf85aefa9f01aeec1bf4d9bc696251b4c473806c64352b4fbd64d5"
    },
    {
      "key": "09bcaba",
      "nodeTitle": "map_nantes",
      "sourceText": "To jest MAPA NANTES.",
      "sourceEnText": "This is a MAP of NANTES.",
      "audioFile": "fr_03_09bcaba.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1829,
      "updatedAt": "2026-08-25T00:32:59Z",
      "textHash": "88e92ab47b765253f6ecd4705fb6540785847ab3415ea1c5d75b5bfdffc60c11"
    },
    {
      "key": "09eafa1",
      "nodeTitle": "museum_guide",
      "sourceText": "Czy możesz pomóc w sprzątaniu MUZEUM?",
      "sourceEnText": "Can you help cleaning the MUSEUM?",
      "audioFile": "fr_03_09eafa1.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2769,
      "updatedAt": "2026-08-25T00:34:09Z",
      "textHash": "10263198c25fbe705b3f0aac57e9fce7a71cd3087d9efea48d3b0f8c3f6baf11"
    },
    {
      "key": "0a1520b",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Znajdź balon na ogrzane powietrze",
      "sourceEnText": "Find the HOT AIR BALLOON",
      "audioFile": "fr_03_0a1520b.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2377,
      "updatedAt": "2026-08-25T00:34:49Z",
      "textHash": "f458bfe22beb0bc7f387f920efe8e0475245c9f04eda7445278bdd12c81785ab"
    },
    {
      "key": "0a3e2f4",
      "nodeTitle": "npc_door",
      "sourceText": "Jaki BAŁAGANOWANY jest teren przed MUZEUM!",
      "sourceEnText": "What a MESS outside the MUSEUM!",
      "audioFile": "fr_03_0a3e2f4.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3631,
      "updatedAt": "2026-08-25T00:33:47Z",
      "textHash": "964f2c913a9be0fce6b913c9367650be8ef3a927b7d9c9ce3acabf37c27ff52a"
    },
    {
      "key": "0a7dfb3",
      "nodeTitle": "museum_guide",
      "sourceText": "Mamy kolejny PROBLEM!",
      "sourceEnText": "We have another PROBLEM!",
      "audioFile": "fr_03_0a7dfb3.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1593,
      "updatedAt": "2026-08-25T00:34:17Z",
      "textHash": "6a0a5fb1e71d883d19734678c069ad134d2f8e104ed8a54c9cfa288c43e25475"
    },
    {
      "key": "0b5e2f3",
      "nodeTitle": "quest_start",
      "sourceText": "Witamy w Nantes. Odwiedź Muzeum Juliusza Verne'a!",
      "sourceEnText": "Welcome to Nantes. Go and discover the Jules Verne Museum!",
      "audioFile": "fr_03_0b5e2f3.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3971,
      "updatedAt": "2026-08-25T00:32:51Z",
      "textHash": "727417fbac55dfa5ae6ed26ef3df97ff21d90db7c3e13e5b57da3455591e8f0a"
    },
    {
      "key": "0b5eb24",
      "nodeTitle": "task_clean_museum_done",
      "sourceText": "Idealnie. Teraz muzeum jest czyste! Wróć do PRZEWODNIKA PO MUZEUM.",
      "sourceEnText": "Perfect. Now the Museum is clean! Go back to the MUSEUM GUIDE.",
      "audioFile": "fr_03_0b5eb24.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 4754,
      "updatedAt": "2026-08-25T00:34:28Z",
      "textHash": "884ec9489a08a8f2aa6c7287f673fe0e1ad9b31a84681af7dfaf31feac51c143"
    },
    {
      "key": "0b7b198",
      "nodeTitle": "train",
      "sourceText": "Ten stary POCIĄG poruszał się za pomocą PARY.",
      "sourceEnText": "This old TRAIN used STEAM to move.",
      "audioFile": "fr_03_0b7b198.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3370,
      "updatedAt": "2026-08-25T00:35:10Z",
      "textHash": "5128b030128d2dd93ea80de7f6a12ee7952d6ac823c64cfbdb17f0d9049ab7af"
    },
    {
      "key": "0ba85d3",
      "nodeTitle": "activity_submarine_done",
      "sourceText": "Naprawiłeś to! Dziękuję!",
      "sourceEnText": "You repaired it! Thank you!",
      "audioFile": "fr_03_0ba85d3.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1881,
      "updatedAt": "2026-08-25T00:34:38Z",
      "textHash": "184e5a9af0d57c0cefcb582922efc48496526e1503e1e420fa5b2e88b60a3c1b"
    },
    {
      "key": "0bb264b",
      "nodeTitle": "tutor_20000",
      "sourceText": "Znajdź łódź podwodną",
      "sourceEnText": "Find the SUBMARINE",
      "audioFile": "fr_03_0bb264b.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1776,
      "updatedAt": "2026-08-25T00:34:36Z",
      "textHash": "18179f98ac32563c3166679f24d329c506eab2a0cec76124082bcc6f9a7e321e"
    },
    {
      "key": "0bb46da",
      "nodeTitle": "museum_guide",
      "sourceText": "Pojazdów już tam nie ma.",
      "sourceEnText": "The vehicles are no longer there.",
      "audioFile": "fr_03_0bb46da.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1881,
      "updatedAt": "2026-08-25T00:34:19Z",
      "textHash": "efddadea5653253f0b7420f6d4a783a8083b57c5ed18524856953375217a2097"
    },
    {
      "key": "0bc6c7b",
      "nodeTitle": "museum_guide",
      "sourceText": "Juliusz Verne byłby z ciebie dumny!",
      "sourceEnText": "Jules Verne would be proud of you!",
      "audioFile": "fr_03_0bc6c7b.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2429,
      "updatedAt": "2026-08-25T00:34:11Z",
      "textHash": "597eecba0b3ced25549b2804bfb221539c2e5297a4a598ed916bbc0265830493"
    },
    {
      "key": "0bcc84d",
      "nodeTitle": "book_80days",
      "sourceText": "Pokazuje wiele miejsc na ZIEMI.",
      "sourceEnText": "It shows many places on EARTH.",
      "audioFile": "fr_03_0bcc84d.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2064,
      "updatedAt": "2026-08-25T00:33:27Z",
      "textHash": "479dadc119baa0fa4aec2c7cf7c681233b146b03f93d0926ba9b938758032434"
    },
    {
      "key": "0c3d777",
      "nodeTitle": "book_5weeks",
      "sourceText": "Ta KSIĄŻKA nosi tytuł „Pięć tygodni w balonie”.",
      "sourceEnText": "This BOOK is \"Five Weeks in a Balloon.\"",
      "audioFile": "fr_03_0c3d777.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3736,
      "updatedAt": "2026-08-25T00:34:51Z",
      "textHash": "05c6f6b41e31e78da31b1cf5b4548b92066cc1c25a032b17d70841251a2e6d7c"
    },
    {
      "key": "0c52f3c",
      "nodeTitle": "museum_guide",
      "sourceText": "To dobrze. Jeszcze nie skończyłeś, kontynuuj!",
      "sourceEnText": "You are doing well!",
      "audioFile": "fr_03_0c52f3c.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2978,
      "updatedAt": "2026-08-25T00:34:15Z",
      "textHash": "e770d8fb33c3030d8036b67f8287bfbb3506656ced7f17be369e229d346f0f5e"
    },
    {
      "key": "0c790cf",
      "nodeTitle": "spawned_guide",
      "sourceText": "Juliusz Verne był francuskim PISARZEM. Urodził się w pobliżu.",
      "sourceEnText": "Jules Verne was a French WRITER. He was born near here.",
      "audioFile": "fr_03_0c790cf.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 3553,
      "updatedAt": "2026-08-25T00:33:37Z",
      "textHash": "295add3d370ecc4634a3e3f8d767650182534f4cd1411ce145083fa93727dc80"
    },
    {
      "key": "0c81640",
      "nodeTitle": "museum_guide",
      "sourceText": "Dziękuję! Teraz MUZEUM jest w porządku",
      "sourceEnText": "Thank you! Now the MUSEUM is in order",
      "audioFile": "fr_03_0c81640.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3265,
      "updatedAt": "2026-08-25T00:34:05Z",
      "textHash": "af2b21c28e0fd7ffb650c1485166f9aaf19c9554ece227b1be8b47379dec3b02"
    },
    {
      "key": "0caca1b",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Juliusz Verne napisał WIELE KSIĄŻEK!",
      "sourceEnText": "Jules Verne wrote many BOOKS!",
      "audioFile": "fr_03_0caca1b.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3318,
      "updatedAt": "2026-08-25T00:33:18Z",
      "textHash": "900d29948e31fdd9d288da7aefd758b2bed72d873966e94908fdf63c9792657b"
    },
    {
      "key": "0cec96a",
      "nodeTitle": "npc_door",
      "sourceText": "Dziękujemy za posprzątanie!",
      "sourceEnText": "Thank you for cleaning up!",
      "audioFile": "fr_03_0cec96a.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2429,
      "updatedAt": "2026-08-25T00:33:51Z",
      "textHash": "e732a0f194af2dc53ff06000022550d5bda9a29797ae1b133cd5729a7833b83a"
    },
    {
      "key": "0d2e2f0",
      "nodeTitle": "npc_door",
      "sourceText": "Muzeum jest już otwarte! Porozmawiaj z PRZEWODNIKIEM PO MUZEUM!",
      "sourceEnText": "The Museum is now open! Talk to the MUSEUM GUIDE!",
      "audioFile": "fr_03_0d2e2f0.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4807,
      "updatedAt": "2026-08-25T00:33:54Z",
      "textHash": "6041584094f2b443447e641a06c8e19485d4ee667a3e8338cf17a9f0dee34d7e"
    },
    {
      "key": "0d58543",
      "nodeTitle": "npc_door",
      "sourceText": "Nie mogę otworzyć MUZEUM, skoro panuje tu taki bałagan.",
      "sourceEnText": "I can't open the MUSEUM with this mess here.",
      "audioFile": "fr_03_0d58543.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3553,
      "updatedAt": "2026-08-25T00:33:58Z",
      "textHash": "f7c9a884352b19109a79081e288ebc23b323fac96e8cc5f55aff02bf69d8fba7"
    },
    {
      "key": "0dcb855",
      "nodeTitle": "book_20000",
      "sourceText": "ŁÓDŹ PODWODNA podróżuje POD WODĄ.",
      "sourceEnText": "A SUBMARINE travels UNDERWATER.",
      "audioFile": "fr_03_0dcb855.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2900,
      "updatedAt": "2026-08-25T00:33:08Z",
      "textHash": "564fbbdf609403705940da31ea9b55688d6821995db068642c9c1b4af2e169a4"
    },
    {
      "key": "0de00ff",
      "nodeTitle": "rocket",
      "sourceText": "To jest RAKIETA kosmiczna.",
      "sourceEnText": "This is a space ROCKET.",
      "audioFile": "fr_03_0de00ff.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1933,
      "updatedAt": "2026-08-25T00:35:23Z",
      "textHash": "2c86bdba72dd72ec8800d4c5d7b0932f43121f0f794bec5e2966b127716e5a9a"
    },
    {
      "key": "0e81901",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Podoba mi się opowieść o ŚWIECIE.",
      "sourceEnText": "I like the story about the WORLD.",
      "audioFile": "fr_03_0e81901.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 2011,
      "updatedAt": "2026-08-25T00:33:22Z",
      "textHash": "4209131c13436e76ee7a6392ebfae989b3312a85a10daaacb109d08ffab3ca7d"
    },
    {
      "key": "0e86b01",
      "nodeTitle": "activity_match_done",
      "sourceText": "Gratulacje! Udało Ci się dopasować wszystkie KSIĄŻKI do POJAZDÓW.",
      "sourceEnText": "Well done! You matched all the BOOKS with their VEHICLES.",
      "audioFile": "fr_03_0e86b01.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 5120,
      "updatedAt": "2026-08-25T00:34:24Z",
      "textHash": "7466f750d5a433c7d09f3f6dc45f69f72c4d9e276231507a79d01a90ecb10377"
    },
    {
      "key": "0e928ab",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Pomocy! Czegoś brakuje!",
      "sourceEnText": "Help! Something is missing!",
      "audioFile": "fr_03_0e928ab.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1933,
      "updatedAt": "2026-08-25T00:34:47Z",
      "textHash": "d233d6d3b0e74b4dc5176b72579e1a5581c66f4a6e3247702cb65535204c558a"
    },
    {
      "key": "0ee83b2",
      "nodeTitle": "activity_train_done",
      "sourceText": "Wróć do PRZEWODNIKA PO MUZEUM!",
      "sourceEnText": "Go back to the MUSEUM GUIDE!",
      "audioFile": "fr_03_0ee83b2.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2247,
      "updatedAt": "2026-08-25T00:35:21Z",
      "textHash": "3755c6e93af95db5819cc77a2fa36e350c1667a849904585240c98fbe0d776b6"
    },
    {
      "key": "0f5f36d",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Jego książki czytane są w wielu językach!",
      "sourceEnText": "People read his BOOKS in many languages!",
      "audioFile": "fr_03_0f5f36d.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3553,
      "updatedAt": "2026-08-25T00:33:20Z",
      "textHash": "cc690c4171e13699d8f837ccf134c84e77c4902c2910898772e7a4e0d59589a5"
    },
    {
      "key": "0f72ec7",
      "nodeTitle": "quest_end",
      "sourceText": "Jeśli jedziesz do Nantes z rodzicami, odwiedźcie Muzeum Juliusza Verne'a!",
      "sourceEnText": "If you go to Nantes with your parents, go to the Jules Verne Museum!",
      "audioFile": "fr_03_0f72ec7.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4702,
      "updatedAt": "2026-08-25T00:33:49Z",
      "textHash": "88843b0daf9e6ab7975d794612f00c0e911143a356bfd23461b71c680d17a7cf"
    },
    {
      "key": "0f8dd6c",
      "nodeTitle": "task_clean_done",
      "sourceText": "Dobra robota! Wróć i spotkaj się z panem przy wejściu do muzeum.",
      "sourceEnText": "Well done! Go back and see the gentleman at the museum entrance.",
      "audioFile": "fr_03_0f8dd6c.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4389,
      "updatedAt": "2026-08-25T00:34:02Z",
      "textHash": "111e31994b67f2d2903fac5b2f062638817e319927a7fee8b6ea914c7663002a"
    },
    {
      "key": "0f92a05",
      "nodeTitle": "spawned_guide",
      "sourceText": "Napisał bardzo znane KSIĄŻKI przygodowe.",
