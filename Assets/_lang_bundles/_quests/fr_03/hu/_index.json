{
  "version": "1",
  "questId": "fr_03",
  "lang": "hu",
  "lines": [
    {
      "key": "003b311",
      "nodeTitle": "verne_house",
      "sourceText": "Jules Verne itt született Nantes-ban.",
      "sourceEnText": "Jules Verne was born here in NANTES.",
      "audioFile": "fr_03_003b311.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2194,
      "updatedAt": "2026-08-25T00:29:15Z",
      "textHash": "1dcf2e10df4e49c7a795a13696de0d8467133ff33860f7f9fb24c878f80956b6"
    },
    {
      "key": "006e7fc",
      "nodeTitle": "quest_start",
      "sourceText": "Ki Jules Verne? És hová utazott?",
      "sourceEnText": "Who is Jules Verne? And where did he travel?",
      "audioFile": "fr_03_006e7fc.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2064,
      "updatedAt": "2026-08-25T00:29:40Z",
      "textHash": "ea78637346ac7c435ca4026ccae1905078fd6c6216c3956c41e9c91416fa7f5c"
    },
    {
      "key": "00a6154",
      "nodeTitle": "tutor_20000",
      "sourceText": "Segítség! A Nautilus eltűnt!",
      "sourceEnText": "Help! The Nautilus is missing!",
      "audioFile": "fr_03_00a6154.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1776,
      "updatedAt": "2026-08-25T00:30:22Z",
      "textHash": "c91ad7626ff2c2858694400f19e021762eb2be6a5c8ff97a208847b6563fbbdf"
    },
    {
      "key": "00b1d04",
      "nodeTitle": "spawned_guide",
      "sourceText": "Tudod, ki Jules Verne?",
      "sourceEnText": "Do you know who Jules Verne is?",
      "audioFile": "fr_03_00b1d04.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1306,
      "updatedAt": "2026-08-25T00:29:41Z",
      "textHash": "659ea08763f2329c3a7b72b0e0e5e3f05c7847da06f109c52c103d69692b1fea"
    },
    {
      "key": "00be1f0",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Szeretnék egyszer hőlégballonozni menni.",
      "sourceEnText": "I want to ride a BALLOON one day.",
      "audioFile": "fr_03_00be1f0.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_M",
      "durationMs": 2116,
      "updatedAt": "2026-08-25T00:29:33Z",
      "textHash": "8277a464b55826abcbad78eeb4f17424c5932d422d33146bb0ab15f6dc16659f"
    },
    {
      "key": "00eefe0",
      "nodeTitle": "activity_match_done",
      "sourceText": "Most már minden készen áll a látogatók fogadására!",
      "sourceEnText": "Now everything is ready for the visitors!",
      "audioFile": "fr_03_00eefe0.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2978,
      "updatedAt": "2026-08-25T00:30:16Z",
      "textHash": "be2ef88cfceaf1637e9c7e2286680073c4c763ee82287211fdb24501f2e71327"
    },
    {
      "key": "00f3a57",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Imádok KÖNYVEKET olvasni!",
      "sourceEnText": "I love reading BOOKS!",
      "audioFile": "fr_03_00f3a57.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1724,
      "updatedAt": "2026-08-25T00:29:26Z",
      "textHash": "6bca5f55add37152a84565b7088304675173645d246009bbb174219661c6ef06"
    },
    {
      "key": "0131b99",
      "nodeTitle": "balloon",
      "sourceText": "Egy léggömb meleg levegővel száll fel.",
      "sourceEnText": "A BALLOON goes up with warm AIR.",
      "audioFile": "fr_03_0131b99.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2534,
      "updatedAt": "2026-08-25T00:29:24Z",
      "textHash": "72eba6b26c563fdb213a459a64eaea70019c9d93aa0df42e0fd9b3a497cf8dc9"
    },
    {
      "key": "0174104",
      "nodeTitle": "quest_end",
      "sourceText": "Most már ismered Jules Verne-t és a könyveit!",
      "sourceEnText": "Now you know about Jules Verne and his BOOKS!",
      "audioFile": "fr_03_0174104.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2482,
      "updatedAt": "2026-08-25T00:29:13Z",
      "textHash": "636ca5b4bf37be22ca08ffe1b735b87cc08caa03c8a032649df0cb254852b1dc"
    },
    {
      "key": "01a9d0f",
      "nodeTitle": "npc_door",
      "sourceText": "Segíts megtisztítani a járdát!",
      "sourceEnText": "Help me clean the sidewalk!",
      "audioFile": "fr_03_01a9d0f.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2064,
      "updatedAt": "2026-08-25T00:30:00Z",
      "textHash": "47131f1e6521f6b3ef135c3ae5b6b3beda8ce5e61ebec01100d1c7334407d259"
    },
    {
      "key": "01f76f3",
      "nodeTitle": "tutor_80days",
      "sourceText": "Megtaláltad a VONATOT!",
      "sourceEnText": "You found the TRAIN!",
      "audioFile": "fr_03_01f76f3.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1541,
      "updatedAt": "2026-08-25T00:30:39Z",
      "textHash": "442bc4353ee6db33c91b6cd6807ee689c4b041d16493800f1427ff70e70fb942"
    },
    {
      "key": "020d924",
      "nodeTitle": "book_5weeks",
      "sourceText": "Egy LÉGGÖMB felemelkedik, mert a meleg levegő könnyű.",
      "sourceEnText": "A BALLOON rises because warm AIR is light.",
      "audioFile": "fr_03_020d924.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 3213,
      "updatedAt": "2026-08-25T00:30:34Z",
      "textHash": "15246a3c186f0801db08feba2fef2666eab6a7c2f58613ad72e56fc2f45c5920"
    },
    {
      "key": "0210ef0",
      "nodeTitle": "npc_door",
      "sourceText": "Az a kék KUTYA szaladgált és rendetlenséget csinált!",
      "sourceEnText": "That blue DOG was running and made a mess!",
      "audioFile": "fr_03_0210ef0.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3265,
      "updatedAt": "2026-08-25T00:29:57Z",
      "textHash": "702586ba7cf0c8db42dc1dc3001bf5683074dc45ece29be9661cdbe68c5ab756"
    },
    {
      "key": "0245e0e",
      "nodeTitle": "museum_guide",
      "sourceText": "Tedd össze a KÖNYVEKET a járműveikkel!",
      "sourceEnText": "Put the BOOKS together with their vehicles!",
      "audioFile": "fr_03_0245e0e.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2194,
      "updatedAt": "2026-08-25T00:30:08Z",
      "textHash": "2dbe4f2cf8dfb0f78b0de0932a0a647543dad69b2c494b6a499dacda63ccaa3e"
    },
    {
      "key": "0286510",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Megtaláltad a HŐLÉGFALAT! Úgy is hívják, hogy lufi.",
      "sourceEnText": "You found the HOT AIR BALLOON!",
      "audioFile": "fr_03_0286510.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2900,
      "updatedAt": "2026-08-25T00:30:28Z",
      "textHash": "ca670102782cd39bc2f2fb5e29cc1536e02f4943e5468a1dbe6c121a750d0dec"
    },
    {
      "key": "02e7812",
      "nodeTitle": "tutor_20000",
      "sourceText": "Meg tudnád javítani?",
      "sourceEnText": "Can you please fix it?",
      "audioFile": "fr_03_02e7812.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1306,
      "updatedAt": "2026-08-25T00:30:20Z",
      "textHash": "e3c199935395b379265477a04e6a32971ada8c48f2fda947d02b34c40baf4532"
    },
    {
      "key": "03131e3",
      "nodeTitle": "book_80days",
      "sourceText": "Ez a könyv a \"80 nap alatt a Föld körül\" címet viseli.",
      "sourceEnText": "This BOOK is \"Around the World in 80 Days.\"",
      "audioFile": "fr_03_03131e3.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 3135,
      "updatedAt": "2026-08-25T00:29:18Z",
      "textHash": "bca0df6a0a6bae40f20bb515721f0b62a5c9c0e28dd0386db0a39e1574ae2392"
    },
    {
      "key": "03536a1",
      "nodeTitle": "book_20000",
      "sourceText": "Ez a KÖNYV a „Húszezer mérföld a tenger alatt” címet viseli.",
      "sourceEnText": "This BOOK is \"20,000 Leagues Under the Seas.\"",
      "audioFile": "fr_03_03536a1.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 3683,
      "updatedAt": "2026-08-25T00:29:21Z",
      "textHash": "3c498797fd3ab01367c1fa6bab65e1fb1bfd38dbd684b6f05569423cc50b1ec6"
    },
    {
      "key": "036574d",
      "nodeTitle": "tutor_80days",
      "sourceText": "Találd meg a RÉGI GŐZVONATOT",
      "sourceEnText": "Find the OLD STEAM TRAIN",
      "audioFile": "fr_03_036574d.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2351,
      "updatedAt": "2026-08-25T00:30:42Z",
      "textHash": "d1d9f74b34419d5caa0d5806468eb7bed1751ea6c5e930707eda0dc2fb14b5ae"
    },
    {
      "key": "0386706",
      "nodeTitle": "museum_guide",
      "sourceText": "Kérlek, beszélj az első szoba gondnokával.",
      "sourceEnText": "Please talk to the first room guardian.",
      "audioFile": "fr_03_0386706.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2247,
      "updatedAt": "2026-08-25T00:30:13Z",
      "textHash": "ded5b33a4b0607002892b0c4c1cecb6bad2c8d4bfb58f6044ef5571a43cf8d5e"
    },
    {
      "key": "03af9a8",
      "nodeTitle": "tutor_20000",
      "sourceText": "Gyere vissza hozzám később.",
      "sourceEnText": "Come back to me later.",
      "audioFile": "fr_03_03af9a8.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T00:30:36Z",
      "textHash": "821f600fdecd4ffd47f2f3d931725dbf51f3711a8605485198b6a4765054d110"
    },
    {
      "key": "03efbc0",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Találd meg az ŰRRAKÉTÁT",
      "sourceEnText": "Find the SPACE ROCKET",
      "audioFile": "fr_03_03efbc0.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1541,
      "updatedAt": "2026-08-25T00:30:50Z",
      "textHash": "34a6960285d017a8c87dea301bf6d54838cecc6305d1cdd9c4ceaf0a497eb790"
    },
    {
      "key": "05130c0",
      "nodeTitle": "train",
      "sourceText": "A VONATOK gyorsabban tették meg a hosszú utakat.",
      "sourceEnText": "TRAINS made long trips faster.",
      "audioFile": "fr_03_05130c0.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 3265,
      "updatedAt": "2026-08-25T00:30:46Z",
      "textHash": "82f8631f46360348b81c0c302f71221d36c45b9b5bee786c2c3cd57f8e1f7262"
    },
    {
      "key": "0525efc",
      "nodeTitle": "museum_guide",
      "sourceText": "Egy vicces kék KUTYA belépett a MÚZEUMBA és rendetlenséget csinált!",
      "sourceEnText": "A funny blue DOG entered the MUSEUM and made a mess!",
      "audioFile": "fr_03_0525efc.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 4153,
      "updatedAt": "2026-08-25T00:29:49Z",
      "textHash": "c77fab3d4808f0db12ed9f7995221066848e83101e7d1b402b751b51f6046963"
    },
    {
      "key": "056e79e",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Jules Verne találta fel a sci-fi történeteket.",
      "sourceEnText": "Jules Verne invented science FICTION stories.",
      "audioFile": "fr_03_056e79e.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2534,
      "updatedAt": "2026-08-25T00:29:28Z",
      "textHash": "a5c805d3cde7a0109937a91948d55476388e103a485a416de9de3d6c710a992a"
    },
    {
      "key": "05bc5e9",
      "nodeTitle": "tutor_20000",
      "sourceText": "Ha nem találod, HASZNÁLD A TÉRKÉPET",
      "sourceEnText": "If you can't find it, USE THE MAP",
      "audioFile": "fr_03_05bc5e9.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2064,
      "updatedAt": "2026-08-25T00:30:55Z",
      "textHash": "e2db6e0c350bc62c28f8b4475edc18fad84210c830bf671bf901f3425a485906"
    },
    {
      "key": "05e298d",
      "nodeTitle": "book_earthmoon",
      "sourceText": "A történetben egy hatalmas űrágyú van a RAKÉTA kilövéséhez",
      "sourceEnText": "The story has a huge space CANNON to launch the ROCKET",
      "audioFile": "fr_03_05e298d.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 4101,
      "updatedAt": "2026-08-25T00:30:58Z",
      "textHash": "1b2c45eb24868594f28dea3bb02c31ffb36b75158035ea13e6808845ecc457f8"
    },
    {
      "key": "0642734",
      "nodeTitle": "museum_guide",
      "sourceText": "Van egy PROBLÉMÁNK!",
      "sourceEnText": "We have a PROBLEM!",
      "audioFile": "fr_03_0642734.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1228,
      "updatedAt": "2026-08-25T00:29:48Z",
      "textHash": "d80ff93635cd3839eb9dc1d8b4ba7f9597108742810ec0910b649f72f5f9d5b2"
    },
    {
      "key": "0666ee2",
      "nodeTitle": "tutor_20000",
      "sourceText": "Megtaláltad a TENGERALATTI TENGERLATTARTÓT!",
      "sourceEnText": "You found the SUBMARINE!",
      "audioFile": "fr_03_0666ee2.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2560,
      "updatedAt": "2026-08-25T00:30:19Z",
      "textHash": "4513840f80cb44ca083b131856e9d58c6286b360e5ace8f55c6e3b93fe4f14a2"
    },
    {
      "key": "06aef1a",
      "nodeTitle": "submarine",
      "sourceText": "EGY TENGERALÁTTI mozog a TENGER alatt.",
      "sourceEnText": "A SUBMARINE moves under the SEA.",
      "audioFile": "fr_03_06aef1a.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2194,
      "updatedAt": "2026-08-25T00:30:38Z",
      "textHash": "3fe2bea7b4f4a8d09d6fb6cfa3b8b2250723ba495707b62b39f54ce6c75ed1e3"
    },
    {
      "key": "06b6d4d",
      "nodeTitle": "rocket",
      "sourceText": "Egy rakéta erőteljesen igyekszik elhagyni a FÖLDET.",
      "sourceEnText": "A ROCKET pushes hard to leave EARTH.",
      "audioFile": "fr_03_06b6d4d.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 3082,
      "updatedAt": "2026-08-25T00:29:19Z",
      "textHash": "a82477f6e4382c7736e32d3df104c023f35ae1a37113986aa6d06a59d2f5443e"
    },
    {
      "key": "06e1473",
      "nodeTitle": "spawned_guide",
      "sourceText": "KÖNYVEIBEN szereplő számos ötlet valósággá vált.",
      "sourceEnText": "Many ideas in his BOOKS became real.",
      "audioFile": "fr_03_06e1473.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 3318,
      "updatedAt": "2026-08-25T00:29:37Z",
      "textHash": "27248bf30c784f999796c3043d02ce2ecd6a537fe53c5134780db9166d98f91c"
    },
    {
      "key": "06fb1cd",
      "nodeTitle": "spawned_guide",
      "sourceText": "Nem, ki ő?",
      "sourceEnText": "No, who is he?",
      "audioFile": "fr_03_06fb1cd.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1097,
      "updatedAt": "2026-08-25T00:29:44Z",
      "textHash": "381a33ef6deb94e7a87a7cd7cbf38d90706c654c0ef8b213b31367682f5d1119"
    },
    {
      "key": "0757b30",
      "nodeTitle": "submarine_lost",
      "sourceText": "Remek! Most vidd vissza a gondviselőjének.",
      "sourceEnText": "Great! Now bring it back to its guardian",
      "audioFile": "fr_03_0757b30.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2299,
      "updatedAt": "2026-08-25T00:30:27Z",
      "textHash": "ce79220b91baa9962e1ad7f0e08e5eec5e3226f0eab9c7cb2e0457dabfc66973"
    },
    {
      "key": "07c4369",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Segítség! Eltűnt a legdrágább gépünk!",
      "sourceEnText": "Help! Our most precious machine is missing!",
      "audioFile": "fr_03_07c4369.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2717,
      "updatedAt": "2026-08-25T00:30:48Z",
      "textHash": "e478ce683a325e48a5f459d367e09c3f5c1c4e3ade0a0ff9564b40f0ff481b69"
    },
    {
      "key": "07ee86b",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "A HOLDRA KÉSZÜLT RAKÉTA gyorsnak tűnik.",
      "sourceEnText": "The ROCKET to the MOON looks fast.",
      "audioFile": "fr_03_07ee86b.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_M",
      "durationMs": 2560,
      "updatedAt": "2026-08-25T00:29:34Z",
      "textHash": "9c2760ef9c2e43dfb8d95ca33d60fd77ba5f22faa02ae52afcc4193aaca4b995"
    },
    {
      "key": "07f7b4b",
      "nodeTitle": "spawned_guide",
      "sourceText": "Igen, ő ÍRÓ!",
      "sourceEnText": "Yes, he is a WRITER!",
      "audioFile": "fr_03_07f7b4b.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1123,
      "updatedAt": "2026-08-25T00:29:42Z",
      "textHash": "75ef88573d381e49c9d902d58f685338265dea1ebf455f1a6a97474e48bb4db7"
    },
    {
      "key": "084486e",
      "nodeTitle": "activity_train_done",
      "sourceText": "Megtaláltad az összes járművet!",
      "sourceEnText": "You found all the vehicles!",
      "audioFile": "fr_03_084486e.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1776,
      "updatedAt": "2026-08-25T00:30:54Z",
      "textHash": "ad93556289d92afed6f946c62bd4b68daa9ff6eb958913597636cc0c048f97c0"
    },
    {
      "key": "08669ce",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "A Nautilus tengeralattjáró hihetetlen.",
      "sourceEnText": "The SUBMARINE Nautilus is amazing.",
      "audioFile": "fr_03_08669ce.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_M",
      "durationMs": 2377,
      "updatedAt": "2026-08-25T00:29:38Z",
      "textHash": "8588f2805c1fa7889bb07a78850cd9220d404ffabf917898843d7ee3a9f7225c"
    },
    {
      "key": "087acef",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Órai feladatként RAJZOLHATSZ EGY TENGERALATTJÁRÓT vagy EGY RAKÉTÁT!",
      "sourceEnText": "As classroom activity, you can DRAW a SUBMARINE or a ROCKET!",
      "audioFile": "fr_03_087acef.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3971,
      "updatedAt": "2026-08-25T00:29:50Z",
      "textHash": "0396e4a5a6e93d32fe609ea5ebb2ee38acb3557fdcb64c9d66422d1af593e133"
    },
    {
      "key": "08cfbc0",
      "nodeTitle": "tutor_80days",
      "sourceText": "Segítség! Elvesztettük a VONATOT!",
      "sourceEnText": "Help! We lost the TRAIN!",
      "audioFile": "fr_03_08cfbc0.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2351,
      "updatedAt": "2026-08-25T00:30:40Z",
      "textHash": "fba96e3f2716e2914b9d6fff0c7c1b1e2e1b4788edb02e76005c2076c13da859"
    },
    {
      "key": "08f0d37",
      "nodeTitle": "quest_end",
      "sourceText": "A küldetés teljesítve! Gratulálunk!",
      "sourceEnText": "The quest is complete! Congratulations!",
      "audioFile": "fr_03_08f0d37.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2247,
      "updatedAt": "2026-08-25T00:30:04Z",
      "textHash": "5c84e64d607c9e8b22c3fba5233dba7e2f495b7ac398916e5fb756bb72d8a31d"
    },
    {
      "key": "08fed68",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Megtaláltad a RAKÉTÁT!",
      "sourceEnText": "You found the ROCKET!",
      "audioFile": "fr_03_08fed68.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1776,
      "updatedAt": "2026-08-25T00:30:47Z",
      "textHash": "a1e13d286325f3ab3b4e5937bef2627da0f89c420d2b83c95e9b40e42f1b1e45"
    },
    {
      "key": "0907ccb",
      "nodeTitle": "book_earthmoon",
      "sourceText": "Jules Verne réges-régen elképzelte a rakétákat és az űrutazást.",
      "sourceEnText": "Jules Verne imagined ROCKETS and space TRAVEL long ago.",
      "audioFile": "fr_03_0907ccb.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 4754,
      "updatedAt": "2026-08-25T00:30:56Z",
      "textHash": "ec16526b804f22cda8c7cdf820d8530bb6049426a73ccc4f39d90994ff0ea8ae"
    },
    {
      "key": "09438f6",
      "nodeTitle": "activity_submarine_done",
      "sourceText": "Most menj a következő őrhöz.",
      "sourceEnText": "Now go to next guardian.",
      "audioFile": "fr_03_09438f6.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T00:30:26Z",
      "textHash": "e6e27ce504bfd4e9d78eb36f386e27da862b05838061e43ac12e3448338f7f70"
    },
    {
      "key": "096a3b3",
      "nodeTitle": "verne_painting",
      "sourceText": "Ez itt Jules Verne. Író volt.",
      "sourceEnText": "This is Jules Verne. He was a WRITER.",
      "audioFile": "fr_03_096a3b3.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1724,
      "updatedAt": "2026-08-25T00:29:14Z",
      "textHash": "8e094e92dcf59355049b1bc04b284b02677d9659b3ddcd505fd26bdd4de93ac7"
    },
    {
      "key": "097c3fc",
      "nodeTitle": "tutor_20000",
      "sourceText": "De ELTÖRT!",
      "sourceEnText": "But it's BROKEN!",
      "audioFile": "fr_03_097c3fc.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1097,
      "updatedAt": "2026-08-25T00:30:35Z",
      "textHash": "dfb1916c3f9cb496849baea21575047a866d79cf19a5489b7ff8307a4bf194a2"
    },
    {
      "key": "0998347",
      "nodeTitle": "train",
      "sourceText": "A VONAT SÍNEN közlekedik.",
      "sourceEnText": "A TRAIN runs on RAILS.",
      "audioFile": "fr_03_0998347.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1776,
      "updatedAt": "2026-08-25T00:30:43Z",
      "textHash": "103da244903a23274a1e7fec54b7d6ed9e0034cc3f52c69a781a7aecc4283b1f"
    },
    {
      "key": "09a8c21",
      "nodeTitle": "balloon",
      "sourceText": "A SZÉLLEL mozog.",
      "sourceEnText": "It moves with the WIND.",
      "audioFile": "fr_03_09a8c21.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1176,
      "updatedAt": "2026-08-25T00:29:25Z",
      "textHash": "5e4e78eed6e59a55d549254d7064f937563af614d84f9bab11a228dd349b8db0"
    },
    {
      "key": "09bcaba",
      "nodeTitle": "map_nantes",
      "sourceText": "Ez NANTES TÉRKÉPE.",
      "sourceEnText": "This is a MAP of NANTES.",
      "audioFile": "fr_03_09bcaba.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1541,
      "updatedAt": "2026-08-25T00:29:17Z",
      "textHash": "6db6bc2cdabe369b1ae330765337fe4fca206faac47563170cd14cbea7548130"
    },
    {
      "key": "09eafa1",
      "nodeTitle": "museum_guide",
      "sourceText": "Tudsz segíteni a MÚZEUM takarításában?",
      "sourceEnText": "Can you help cleaning the MUSEUM?",
      "audioFile": "fr_03_09eafa1.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2299,
      "updatedAt": "2026-08-25T00:30:05Z",
      "textHash": "705182776d45194084cd0769b11dec3ef7b90afa835d52b5760ed898a490b84c"
    },
    {
      "key": "0a1520b",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Keresd meg a hőlégballont",
      "sourceEnText": "Find the HOT AIR BALLOON",
      "audioFile": "fr_03_0a1520b.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1776,
      "updatedAt": "2026-08-25T00:30:31Z",
      "textHash": "42216193986f626c72102b90d01469074106b987a7711b25902bef2c6d28d777"
    },
    {
      "key": "0a3e2f4",
      "nodeTitle": "npc_door",
      "sourceText": "Micsoda KÁOSZ a MÚZEUM előtt!",
      "sourceEnText": "What a MESS outside the MUSEUM!",
      "audioFile": "fr_03_0a3e2f4.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1881,
      "updatedAt": "2026-08-25T00:29:52Z",
      "textHash": "35d91ce793e2c658bdc98a88fb8e7e857bdbdddffb3d614b0274e90edb739a65"
    },
    {
      "key": "0a7dfb3",
      "nodeTitle": "museum_guide",
      "sourceText": "Van még egy PROBLÉMÁNK!",
      "sourceEnText": "We have another PROBLEM!",
      "audioFile": "fr_03_0a7dfb3.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1593,
      "updatedAt": "2026-08-25T00:30:11Z",
      "textHash": "8948029ae2bbd31a63a760967f3db1d85176885dd9e0e345d3f07df4b89215b0"
    },
    {
      "key": "0b5e2f3",
      "nodeTitle": "quest_start",
      "sourceText": "Üdvözöljük Nantes-ban! Fedezze fel a Jules Verne Múzeumot!",
      "sourceEnText": "Welcome to Nantes. Go and discover the Jules Verne Museum!",
      "audioFile": "fr_03_0b5e2f3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3500,
      "updatedAt": "2026-08-25T00:29:11Z",
      "textHash": "8e07d98e412156371b6817790969cd19d27840cbfa142e5ccf2612f6b1a78dfc"
    },
    {
      "key": "0b5eb24",
      "nodeTitle": "task_clean_museum_done",
      "sourceText": "Tökéletes. Most már tiszta a múzeum! Menj vissza a MÚZEUMI ÚTMUTATÓHOZ.",
      "sourceEnText": "Perfect. Now the Museum is clean! Go back to the MUSEUM GUIDE.",
      "audioFile": "fr_03_0b5eb24.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 4467,
      "updatedAt": "2026-08-25T00:30:18Z",
      "textHash": "2797afe66a489a9cfc9601c19484d44dec9f19e3a1ff15a4c2b2863e1f8816e6"
    },
    {
      "key": "0b7b198",
      "nodeTitle": "train",
      "sourceText": "Ez a régi VONAT GŐZZEL mozgott.",
      "sourceEnText": "This old TRAIN used STEAM to move.",
      "audioFile": "fr_03_0b7b198.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2142,
      "updatedAt": "2026-08-25T00:30:44Z",
      "textHash": "24c88ffe97b932a9fc273fadbb90a50e76ee6b4d2f1c5fa266ba4f88dd84199c"
    },
    {
      "key": "0ba85d3",
      "nodeTitle": "activity_submarine_done",
      "sourceText": "Megjavítottad! Köszönöm!",
      "sourceEnText": "You repaired it! Thank you!",
      "audioFile": "fr_03_0ba85d3.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1593,
      "updatedAt": "2026-08-25T00:30:24Z",
      "textHash": "7907810745c719aabb7853f2a105b900535415e16d2097bba44cb37836d416e1"
    },
    {
      "key": "0bb264b",
      "nodeTitle": "tutor_20000",
      "sourceText": "Találd meg a tengeralattjárót",
      "sourceEnText": "Find the SUBMARINE",
      "audioFile": "fr_03_0bb264b.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1829,
      "updatedAt": "2026-08-25T00:30:23Z",
      "textHash": "e64002c489cf35fc1f734762e93d2cbae11357d947e00eaf48aa76fc2a80fc61"
    },
    {
      "key": "0bb46da",
      "nodeTitle": "museum_guide",
      "sourceText": "A járművek már nincsenek ott.",
      "sourceEnText": "The vehicles are no longer there.",
      "audioFile": "fr_03_0bb46da.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1698,
      "updatedAt": "2026-08-25T00:30:12Z",
      "textHash": "a39843f9e4e515ac5246c2f518e3dd3eb0e510c81d316686e1399cdfea83d285"
    },
    {
      "key": "0bc6c7b",
      "nodeTitle": "museum_guide",
      "sourceText": "Jules Verne büszke lenne rád!",
      "sourceEnText": "Jules Verne would be proud of you!",
      "audioFile": "fr_03_0bc6c7b.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T00:30:07Z",
      "textHash": "2faac72ae1c9c23914bcbeefafab7609aa613a1364ad1a6ffbcb7368a9b2b87d"
    },
    {
      "key": "0bcc84d",
      "nodeTitle": "book_80days",
      "sourceText": "Sok helyet mutat a FÖLDÖN.",
      "sourceEnText": "It shows many places on EARTH.",
      "audioFile": "fr_03_0bcc84d.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1698,
      "updatedAt": "2026-08-25T00:29:36Z",
      "textHash": "5a324857018b8bfd90828eb1b7142177d70125126e023237e9a3478ae1eaf4a1"
    },
    {
      "key": "0c3d777",
      "nodeTitle": "book_5weeks",
      "sourceText": "Ez a KÖNYV a \"Öt hét léggömbben\" címet viseli.",
      "sourceEnText": "This BOOK is \"Five Weeks in a Balloon.\"",
      "audioFile": "fr_03_0c3d777.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 3187,
      "updatedAt": "2026-08-25T00:30:32Z",
      "textHash": "5d7a1a4e71bcaa7e25f8ba4d3011c9f3d472210e52201d47e6b28b9351a993b3"
    },
    {
      "key": "0c52f3c",
      "nodeTitle": "museum_guide",
      "sourceText": "Ez jó. Még nem végeztél, csak így tovább!",
      "sourceEnText": "You are doing well!",
      "audioFile": "fr_03_0c52f3c.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2116,
      "updatedAt": "2026-08-25T00:30:09Z",
      "textHash": "1532441d6c0eb078788072d91db54f468696d1574fe15ac9cf344c2e838f8046"
    },
    {
      "key": "0c790cf",
      "nodeTitle": "spawned_guide",
      "sourceText": "Jules Verne francia ÍRÓ volt. Itt született a közelben.",
      "sourceEnText": "Jules Verne was a French WRITER. He was born near here.",
      "audioFile": "fr_03_0c790cf.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 3448,
      "updatedAt": "2026-08-25T00:29:45Z",
      "textHash": "2b7f9ef93dba9bfac75ad3b30fd72917246db7ea329c09ec2a32a3e8052c13ba"
    },
    {
      "key": "0c81640",
      "nodeTitle": "museum_guide",
      "sourceText": "Köszönöm! Most már rendben van a MÚZEUM.",
      "sourceEnText": "Thank you! Now the MUSEUM is in order",
      "audioFile": "fr_03_0c81640.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2247,
      "updatedAt": "2026-08-25T00:30:03Z",
      "textHash": "c9f4ec90f5432d472ad84077ac165d1ccff6afcc4416ba6273d796186acefa6e"
    },
    {
      "key": "0caca1b",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Jules Verne rengeteg könyvet írt!",
      "sourceEnText": "Jules Verne wrote many BOOKS!",
      "audioFile": "fr_03_0caca1b.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2116,
      "updatedAt": "2026-08-25T00:29:29Z",
      "textHash": "dd0716b853aaf6079adae272d932344718b4eb8983eae78e0b83641d89eccea5"
    },
    {
      "key": "0cec96a",
      "nodeTitle": "npc_door",
      "sourceText": "Köszönöm a takarítást!",
      "sourceEnText": "Thank you for cleaning up!",
      "audioFile": "fr_03_0cec96a.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1698,
      "updatedAt": "2026-08-25T00:29:54Z",
      "textHash": "617ca17682ca862fff2ff9c806f5cb69272b31327defc4bc172c2b8dbe844fb7"
    },
    {
      "key": "0d2e2f0",
      "nodeTitle": "npc_door",
      "sourceText": "A múzeum mostantól nyitva! Beszélj a MÚZEUMI ÚTMUTATÓVAL!",
      "sourceEnText": "The Museum is now open! Talk to the MUSEUM GUIDE!",
      "audioFile": "fr_03_0d2e2f0.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3500,
      "updatedAt": "2026-08-25T00:29:56Z",
      "textHash": "2a9dd136d2b55e36685e96ef52c6596348f3da747bfef155a9c6c745dcc5cebf"
    },
    {
      "key": "0d58543",
      "nodeTitle": "npc_door",
      "sourceText": "Nem tudom megnyitni a MÚZEUMOT ebben a káoszban.",
      "sourceEnText": "I can't open the MUSEUM with this mess here.",
      "audioFile": "fr_03_0d58543.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2847,
      "updatedAt": "2026-08-25T00:29:59Z",
      "textHash": "2541698d469555e713fd50b0a9961096650f9988c477f0870c126a490400c610"
    },
    {
      "key": "0dcb855",
      "nodeTitle": "book_20000",
      "sourceText": "EGY TENGERALATTJÁRÓ VÍZ ALATT utazik.",
      "sourceEnText": "A SUBMARINE travels UNDERWATER.",
      "audioFile": "fr_03_0dcb855.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2351,
      "updatedAt": "2026-08-25T00:29:22Z",
      "textHash": "768331ec6f8299b4a393b25e89014dfc09c3f3eaf94763bb3126ddd27e32dccd"
    },
    {
      "key": "0de00ff",
      "nodeTitle": "rocket",
      "sourceText": "Ez egy űrrakéta.",
      "sourceEnText": "This is a space ROCKET.",
      "audioFile": "fr_03_0de00ff.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1463,
      "updatedAt": "2026-08-25T00:30:52Z",
      "textHash": "61c4d5fc5179ef99f46ccdd22a94c960fcc4062061e254a03ae092d32fc68eba"
    },
    {
      "key": "0e81901",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Tetszik a VILÁGról szóló történet.",
      "sourceEnText": "I like the story about the WORLD.",
      "audioFile": "fr_03_0e81901.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_M",
      "durationMs": 2064,
      "updatedAt": "2026-08-25T00:29:32Z",
      "textHash": "a86d0ab8da1fdcf16b68e5e37c9d79b32b7ef9d881f32339e7ba985e76d7015d"
    },
    {
      "key": "0e86b01",
      "nodeTitle": "activity_match_done",
      "sourceText": "Szép munka! Összepárosítottad az összes KÖNYVET a JÁRMŰVEL.",
      "sourceEnText": "Well done! You matched all the BOOKS with their VEHICLES.",
      "audioFile": "fr_03_0e86b01.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 3370,
      "updatedAt": "2026-08-25T00:30:15Z",
      "textHash": "7721db41281b1f76e1063b2bdb69ed23ee38191eff650fc78b80cbec5ee2530a"
    },
    {
      "key": "0e928ab",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Segítség! Valami hiányzik!",
      "sourceEnText": "Help! Something is missing!",
      "audioFile": "fr_03_0e928ab.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1881,
      "updatedAt": "2026-08-25T00:30:30Z",
      "textHash": "d43f3db59678def07aa0d15485dca561a2abde326d7af87682ab8cac3b4b232d"
    },
    {
      "key": "0ee83b2",
      "nodeTitle": "activity_train_done",
      "sourceText": "Térj vissza a MÚZEUMI ÚTMUTATÓHOZ!",
      "sourceEnText": "Go back to the MUSEUM GUIDE!",
      "audioFile": "fr_03_0ee83b2.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2664,
      "updatedAt": "2026-08-25T00:30:51Z",
      "textHash": "96694f6bd32040a4f430813cb33a38e701843998ae2b04b0adf2efb057a4b911"
    },
    {
      "key": "0f5f36d",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Könyveit sok nyelven olvassák!",
      "sourceEnText": "People read his BOOKS in many languages!",
      "audioFile": "fr_03_0f5f36d.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1933,
      "updatedAt": "2026-08-25T00:29:30Z",
      "textHash": "d715f39322ba05901e7e0490841707020beb890bd3f16acdcfc268590f3bb56f"
    },
    {
      "key": "0f72ec7",
      "nodeTitle": "quest_end",
      "sourceText": "Ha a szüleiddel Nantes-ba mész, menj el a Jules Verne Múzeumba!",
      "sourceEnText": "If you go to Nantes with your parents, go to the Jules Verne Museum!",
      "audioFile": "fr_03_0f72ec7.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3500,
      "updatedAt": "2026-08-25T00:29:53Z",
      "textHash": "19b35e1dc4a2fc60291e7a4b317550d01edf39cedec4d295ea7a59fb243f75cb"
    },
    {
      "key": "0f8dd6c",
      "nodeTitle": "task_clean_done",
      "sourceText": "Szép munka! Menj vissza, és keresd meg az urat a múzeum bejáratánál.",
      "sourceEnText": "Well done! Go back and see the gentleman at the museum entrance.",
      "audioFile": "fr_03_0f8dd6c.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 5120,
      "updatedAt": "2026-08-25T00:30:01Z",
      "textHash": "d5be0afa6e2308dd6c4d30d0fe56667d93a25f7d7a7dd215084e85e65b9d0860"
    },
    {
      "key": "0f92a05",
      "nodeTitle": "spawned_guide",
