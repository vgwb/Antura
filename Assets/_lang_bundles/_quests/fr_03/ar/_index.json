{
  "version": "1",
  "questId": "fr_03",
  "lang": "ar",
  "lines": [
    {
      "key": "003b311",
      "nodeTitle": "verne_house",
      "sourceText": "ولد جول فيرن هنا في نانت.",
      "sourceEnText": "Jules Verne was born here in NANTES.",
      "audioFile": "fr_03_003b311.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2142,
      "updatedAt": "2026-08-25T00:23:39Z",
      "textHash": "145927decc12d06f2ed0ba7dc98d6fe2279531074ac188874f11b8904526d0d2"
    },
    {
      "key": "006e7fc",
      "nodeTitle": "quest_start",
      "sourceText": "من هو جول فيرن؟ وأين سافر؟",
      "sourceEnText": "Who is Jules Verne? And where did he travel?",
      "audioFile": "fr_03_006e7fc.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 2612,
      "updatedAt": "2026-08-25T00:24:11Z",
      "textHash": "216bd455f0c0d61929cf5f7d6c50086bf30ef432a16e177427312b5a132ebbae"
    },
    {
      "key": "00a6154",
      "nodeTitle": "tutor_20000",
      "sourceText": "النجدة! غواصة نوتيلوس مفقودة!",
      "sourceEnText": "Help! The Nautilus is missing!",
      "audioFile": "fr_03_00a6154.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2900,
      "updatedAt": "2026-08-25T00:25:01Z",
      "textHash": "35474f9955665b8c9014b4a7452f8d7c8d5520477b4bc5d5a52dd3f3a603511d"
    },
    {
      "key": "00b1d04",
      "nodeTitle": "spawned_guide",
      "sourceText": "هل تعرف من هو جول فيرن؟",
      "sourceEnText": "Do you know who Jules Verne is?",
      "audioFile": "fr_03_00b1d04.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_M",
      "durationMs": 1959,
      "updatedAt": "2026-08-25T00:24:13Z",
      "textHash": "9f6bea9adfce96f9c2fc7d3b9099caad2802fbb78b060968ef62dee505669e2f"
    },
    {
      "key": "00be1f0",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "أرغب في ركوب منطاد الهواء الساخن يوماً ما.",
      "sourceEnText": "I want to ride a BALLOON one day.",
      "audioFile": "fr_03_00be1f0.mp3",
      "voiceProfile": "haytham",
      "actorId": "KID_M",
      "durationMs": 3082,
      "updatedAt": "2026-08-25T00:24:03Z",
      "textHash": "3c4cea16f54c773a045d752b6b7b87f00583dfcbd1962d7c51080ccdd41a4acf"
    },
    {
      "key": "00eefe0",
      "nodeTitle": "activity_match_done",
      "sourceText": "كل شيء جاهز الآن لاستقبال الزوار!",
      "sourceEnText": "Now everything is ready for the visitors!",
      "audioFile": "fr_03_00eefe0.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 3082,
      "updatedAt": "2026-08-25T00:24:56Z",
      "textHash": "2d94acb4c9295155e354f72a6d31607ea79d9642c690103269b171a8b2571bdd"
    },
    {
      "key": "00f3a57",
      "nodeTitle": "spawned_visitor",
      "sourceText": "أحب قراءة الكتب!",
      "sourceEnText": "I love reading BOOKS!",
      "audioFile": "fr_03_00f3a57.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T00:23:53Z",
      "textHash": "f2507575ef62092adfac7566433f1748b6354befbef6cef0751eda2e368e993f"
    },
    {
      "key": "0131b99",
      "nodeTitle": "balloon",
      "sourceText": "يرتفع البالون بالهواء الدافئ.",
      "sourceEnText": "A BALLOON goes up with warm AIR.",
      "audioFile": "fr_03_0131b99.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2482,
      "updatedAt": "2026-08-25T00:23:49Z",
      "textHash": "ca6a78ac569c58d87905db3eb17fc3a455fd06616b3863c5e9bda810adfcdc41"
    },
    {
      "key": "0174104",
      "nodeTitle": "quest_end",
      "sourceText": "الآن تعرفون جول فيرن وكتبه!",
      "sourceEnText": "Now you know about Jules Verne and his BOOKS!",
      "audioFile": "fr_03_0174104.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 2247,
      "updatedAt": "2026-08-25T00:23:36Z",
      "textHash": "3befeadd745fb901c6b9bcad7f233eda211821ec05476941c3b0bb2105768789"
    },
    {
      "key": "01a9d0f",
      "nodeTitle": "npc_door",
      "sourceText": "ساعدني في تنظيف الرصيف!",
      "sourceEnText": "Help me clean the sidewalk!",
      "audioFile": "fr_03_01a9d0f.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 2116,
      "updatedAt": "2026-08-25T00:24:37Z",
      "textHash": "99655104e3d988857b494c8d707afaa36e5ad9f07e48790245e59bc057ba3cd5"
    },
    {
      "key": "01f76f3",
      "nodeTitle": "tutor_80days",
      "sourceText": "لقد وجدت القطار!",
      "sourceEnText": "You found the TRAIN!",
      "audioFile": "fr_03_01f76f3.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T00:25:19Z",
      "textHash": "7c4789cc7d4326374d7cdfeeae2431d9d98b7977693e20afebb181600853f8d8"
    },
    {
      "key": "020d924",
      "nodeTitle": "book_5weeks",
      "sourceText": "يرتفع البالون لأن الهواء الدافئ خفيف.",
      "sourceEnText": "A BALLOON rises because warm AIR is light.",
      "audioFile": "fr_03_020d924.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 3866,
      "updatedAt": "2026-08-25T00:25:14Z",
      "textHash": "8ae6c89e2e1e817303e467a496de3e313ac78a6e8648c91a4889e0e3d69bf927"
    },
    {
      "key": "0210ef0",
      "nodeTitle": "npc_door",
      "sourceText": "كان ذلك الكلب الأزرق يركض وأحدث فوضى!",
      "sourceEnText": "That blue DOG was running and made a mess!",
      "audioFile": "fr_03_0210ef0.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 3265,
      "updatedAt": "2026-08-25T00:24:34Z",
      "textHash": "8f289e537773c563691bfee991dd0964e09da4c73d5b642d65c7a86e9e3bc060"
    },
    {
      "key": "0245e0e",
      "nodeTitle": "museum_guide",
      "sourceText": "ضع الكتب مع مركباتهم!",
      "sourceEnText": "Put the BOOKS together with their vehicles!",
      "audioFile": "fr_03_0245e0e.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 1881,
      "updatedAt": "2026-08-25T00:24:46Z",
      "textHash": "4e0ca65c243f576a11625184f529fbbeba8e2584a89dc0a4fc0d6c2f71f8b9a9"
    },
    {
      "key": "0286510",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "لقد وجدت منطاد الهواء الساخن! يُطلق عليه أيضًا اسم بالون.",
      "sourceEnText": "You found the HOT AIR BALLOON!",
      "audioFile": "fr_03_0286510.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 5642,
      "updatedAt": "2026-08-25T00:25:08Z",
      "textHash": "027af298597a97edef10db6bffa6eb80345c68ceac9eff62752ad9bfeb38088e"
    },
    {
      "key": "02e7812",
      "nodeTitle": "tutor_20000",
      "sourceText": "هل يمكنك إصلاح ذلك من فضلك؟",
      "sourceEnText": "Can you please fix it?",
      "audioFile": "fr_03_02e7812.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2351,
      "updatedAt": "2026-08-25T00:25:00Z",
      "textHash": "674d65a180656aff006cf8509f14ff367bb3ce3ccba9cb52afc006dc30f2e2a3"
    },
    {
      "key": "03131e3",
      "nodeTitle": "book_80days",
      "sourceText": "هذا الكتاب بعنوان \"حول العالم في 80 يومًا\".",
      "sourceEnText": "This BOOK is \"Around the World in 80 Days.\"",
      "audioFile": "fr_03_03131e3.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 3918,
      "updatedAt": "2026-08-25T00:23:42Z",
      "textHash": "d06c2dac86a8fa1930241a71ee22265add3797a3a6e16a7f04357ea4c00a1271"
    },
    {
      "key": "03536a1",
      "nodeTitle": "book_20000",
      "sourceText": "هذا الكتاب بعنوان \"عشرون ألف فرسخ تحت الماء\".",
      "sourceEnText": "This BOOK is \"20,000 Leagues Under the Seas.\"",
      "audioFile": "fr_03_03536a1.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 4049,
      "updatedAt": "2026-08-25T00:23:46Z",
      "textHash": "4107b0e854737b734b5b450c4d2aab8f71250ebc28da37cf28e0eaa2c48e9c4a"
    },
    {
      "key": "036574d",
      "nodeTitle": "tutor_80days",
      "sourceText": "ابحث عن قطار البخار القديم",
      "sourceEnText": "Find the OLD STEAM TRAIN",
      "audioFile": "fr_03_036574d.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2142,
      "updatedAt": "2026-08-25T00:25:22Z",
      "textHash": "022d2e5f2077cf97a4142a6213d87502cdb107bf862d5c0b4b8cb7fbc5b123d9"
    },
    {
      "key": "0386706",
      "nodeTitle": "museum_guide",
      "sourceText": "يرجى التحدث إلى حارس الغرفة الأولى.",
      "sourceEnText": "Please talk to the first room guardian.",
      "audioFile": "fr_03_0386706.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2717,
      "updatedAt": "2026-08-25T00:24:53Z",
      "textHash": "ed16b9667b3a6741082a5edcab013187c2f42297ce96c125fdcebeff5bc66aa4"
    },
    {
      "key": "03af9a8",
      "nodeTitle": "tutor_20000",
      "sourceText": "عد إليّ لاحقاً.",
      "sourceEnText": "Come back to me later.",
      "audioFile": "fr_03_03af9a8.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 1541,
      "updatedAt": "2026-08-25T00:25:16Z",
      "textHash": "3aa3c9f0e6ef88bb00ad0600607e797a17b8e58f9fbe602e23c1704589039b5b"
    },
    {
      "key": "03efbc0",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "ابحث عن الصاروخ الفضائي",
      "sourceEnText": "Find the SPACE ROCKET",
      "audioFile": "fr_03_03efbc0.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 1829,
      "updatedAt": "2026-08-25T00:25:30Z",
      "textHash": "66437b673e11d79fecf4f40772876a3ff668fbb6733eae9ee9e3796841781924"
    },
    {
      "key": "05130c0",
      "nodeTitle": "train",
      "sourceText": "ساهمت القطارات في جعل الرحلات الطويلة أسرع.",
      "sourceEnText": "TRAINS made long trips faster.",
      "audioFile": "fr_03_05130c0.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 3370,
      "updatedAt": "2026-08-25T00:25:26Z",
      "textHash": "853d826fa3e49e9faefb71d4f9eab36ca948ace89752711b6c82786ca5cd972f"
    },
    {
      "key": "0525efc",
      "nodeTitle": "museum_guide",
      "sourceText": "دخل كلب أزرق مضحك إلى المتحف وأحدث فوضى عارمة!",
      "sourceEnText": "A funny blue DOG entered the MUSEUM and made a mess!",
      "audioFile": "fr_03_0525efc.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 4101,
      "updatedAt": "2026-08-25T00:24:23Z",
      "textHash": "e90381d23d2e33eed5ebd3f762b7bbfeba54ba35d662bf8ab334fe923ec7cbd4"
    },
    {
      "key": "056e79e",
      "nodeTitle": "spawned_visitor",
      "sourceText": "ابتكر جول فيرن قصص الخيال العلمي.",
      "sourceEnText": "Jules Verne invented science FICTION stories.",
      "audioFile": "fr_03_056e79e.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 2534,
      "updatedAt": "2026-08-25T00:23:56Z",
      "textHash": "e66116c8a12b810d47c8750d176c5f091e693c093061299b2f892cddfb1b8929"
    },
    {
      "key": "05bc5e9",
      "nodeTitle": "tutor_20000",
      "sourceText": "إذا لم تتمكن من العثور عليه، فاستخدم الخريطة",
      "sourceEnText": "If you can't find it, USE THE MAP",
      "audioFile": "fr_03_05bc5e9.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 4023,
      "updatedAt": "2026-08-25T00:25:36Z",
      "textHash": "c384f48fbf409278503b4031151daaf4a574fedfead0066057705a755643fe35"
    },
    {
      "key": "05e298d",
      "nodeTitle": "book_earthmoon",
      "sourceText": "تتضمن القصة مدفعًا فضائيًا ضخمًا لإطلاق الصاروخ",
      "sourceEnText": "The story has a huge space CANNON to launch the ROCKET",
      "audioFile": "fr_03_05e298d.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 4206,
      "updatedAt": "2026-08-25T00:25:39Z",
      "textHash": "ffa3fea8389d17f519116e53b020518cf7fda9f4d8e1df45662263ef41cda653"
    },
    {
      "key": "0642734",
      "nodeTitle": "museum_guide",
      "sourceText": "لدينا مشكلة!",
      "sourceEnText": "We have a PROBLEM!",
      "audioFile": "fr_03_0642734.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 1228,
      "updatedAt": "2026-08-25T00:24:21Z",
      "textHash": "da7ebe43b6c1e6939b829380d92335d774c9b528434bbe7d8b8fd1b46860fcd7"
    },
    {
      "key": "0666ee2",
      "nodeTitle": "tutor_20000",
      "sourceText": "لقد وجدت الغواصة!",
      "sourceEnText": "You found the SUBMARINE!",
      "audioFile": "fr_03_0666ee2.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 1933,
      "updatedAt": "2026-08-25T00:24:59Z",
      "textHash": "4b2b8576397dea9980dd3ed62f35ffddcc70ccf9e1a7672a7f1f2b5d5bf98ac0"
    },
    {
      "key": "06aef1a",
      "nodeTitle": "submarine",
      "sourceText": "غواصة تتحرك تحت سطح البحر.",
      "sourceEnText": "A SUBMARINE moves under the SEA.",
      "audioFile": "fr_03_06aef1a.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2299,
      "updatedAt": "2026-08-25T00:25:18Z",
      "textHash": "a5adea1c5c6c84d488f65368efa9d31298cb71387abff6fd854786abaff32bb9"
    },
    {
      "key": "06b6d4d",
      "nodeTitle": "rocket",
      "sourceText": "ينطلق صاروخ بقوة ليغادر الأرض.",
      "sourceEnText": "A ROCKET pushes hard to leave EARTH.",
      "audioFile": "fr_03_06b6d4d.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2664,
      "updatedAt": "2026-08-25T00:23:44Z",
      "textHash": "a8a2b03c4ad57feabf9d5c5c13a8f74c6b62295e37ea7e00371f02b3871d31a2"
    },
    {
      "key": "06e1473",
      "nodeTitle": "spawned_guide",
      "sourceText": "العديد من الأفكار الواردة في كتبه أصبحت حقيقة واقعة.",
      "sourceEnText": "Many ideas in his BOOKS became real.",
      "audioFile": "fr_03_06e1473.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_M",
      "durationMs": 4937,
      "updatedAt": "2026-08-25T00:24:08Z",
      "textHash": "ad2007e7ab16615e484765f5e82880402dd5b059302abfbb383e88e78cab019f"
    },
    {
      "key": "06fb1cd",
      "nodeTitle": "spawned_guide",
      "sourceText": "لا، من هو؟",
      "sourceEnText": "No, who is he?",
      "audioFile": "fr_03_06fb1cd.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_M",
      "durationMs": 1228,
      "updatedAt": "2026-08-25T00:24:16Z",
      "textHash": "d937ec060d52916e9c594162768b42fdbe1cbcd10ea8672322dc56ee20145390"
    },
    {
      "key": "0757b30",
      "nodeTitle": "submarine_lost",
      "sourceText": "ممتاز! الآن أعده إلى حارسه.",
      "sourceEnText": "Great! Now bring it back to its guardian",
      "audioFile": "fr_03_0757b30.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2560,
      "updatedAt": "2026-08-25T00:25:07Z",
      "textHash": "a5efa84e5a3d1726484bccc81ee5827f270d86f6dc4b50e24f3582e9d9a38d0f"
    },
    {
      "key": "07c4369",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "النجدة! آلتنا الأثمن مفقودة!",
      "sourceEnText": "Help! Our most precious machine is missing!",
      "audioFile": "fr_03_07c4369.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 3265,
      "updatedAt": "2026-08-25T00:25:29Z",
      "textHash": "a702c9995a59a42b9dd734695ae25abbd8cc86a3e371fe36052036ac8ab39908"
    },
    {
      "key": "07ee86b",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "يبدو أن الصاروخ إلى القمر سريع.",
      "sourceEnText": "The ROCKET to the MOON looks fast.",
      "audioFile": "fr_03_07ee86b.mp3",
      "voiceProfile": "haytham",
      "actorId": "KID_M",
      "durationMs": 2534,
      "updatedAt": "2026-08-25T00:24:05Z",
      "textHash": "fda2ee996abf6b2df9987eadbfa9f320609767c081b7b125865688859352daf1"
    },
    {
      "key": "07f7b4b",
      "nodeTitle": "spawned_guide",
      "sourceText": "نعم، إنه كاتب!",
      "sourceEnText": "Yes, he is a WRITER!",
      "audioFile": "fr_03_07f7b4b.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_M",
      "durationMs": 1411,
      "updatedAt": "2026-08-25T00:24:15Z",
      "textHash": "c574e669fdfdb9e3242a5c71eaa3523fe4d2b3e239e0fb931f4b9dc9722bb88a"
    },
    {
      "key": "084486e",
      "nodeTitle": "activity_train_done",
      "sourceText": "لقد وجدت جميع المركبات!",
      "sourceEnText": "You found all the vehicles!",
      "audioFile": "fr_03_084486e.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2429,
      "updatedAt": "2026-08-25T00:25:34Z",
      "textHash": "1a9b83739b1dccac18e95da1f34dc1c2e77713aea79cf24de18d26f60ca29887"
    },
    {
      "key": "08669ce",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "الغواصة نوتيلوس مذهلة.",
      "sourceEnText": "The SUBMARINE Nautilus is amazing.",
      "audioFile": "fr_03_08669ce.mp3",
      "voiceProfile": "haytham",
      "actorId": "KID_M",
      "durationMs": 2194,
      "updatedAt": "2026-08-25T00:24:10Z",
      "textHash": "cec42c04f88c905a0c375f48edad04ad2040a61af860a58b8f3170fbccc628de"
    },
    {
      "key": "087acef",
      "nodeTitle": "post_quest_activity",
      "sourceText": "كنشاط صفي، يمكنك رسم غواصة أو صاروخ!",
      "sourceEnText": "As classroom activity, you can DRAW a SUBMARINE or a ROCKET!",
      "audioFile": "fr_03_087acef.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 3370,
      "updatedAt": "2026-08-25T00:24:25Z",
      "textHash": "449a13787819598175cb169e79b96c32f3b0e3165fda3814d0604582c6479c2d"
    },
    {
      "key": "08cfbc0",
      "nodeTitle": "tutor_80days",
      "sourceText": "النجدة! لقد فقدنا القطار!",
      "sourceEnText": "Help! We lost the TRAIN!",
      "audioFile": "fr_03_08cfbc0.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2299,
      "updatedAt": "2026-08-25T00:25:20Z",
      "textHash": "9b8b23e186136feb964d31af366328f9ac684bf35032de16a413be645024cfc5"
    },
    {
      "key": "08f0d37",
      "nodeTitle": "quest_end",
      "sourceText": "اكتملت المهمة! تهانينا!",
      "sourceEnText": "The quest is complete! Congratulations!",
      "audioFile": "fr_03_08f0d37.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 3082,
      "updatedAt": "2026-08-25T00:24:42Z",
      "textHash": "2dbd7fec7aa6116ccd53e3d5fae487a1a6ec8aa4a368ddb57710609651467483"
    },
    {
      "key": "08fed68",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "لقد وجدت الصاروخ!",
      "sourceEnText": "You found the ROCKET!",
      "audioFile": "fr_03_08fed68.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 1776,
      "updatedAt": "2026-08-25T00:25:27Z",
      "textHash": "86dd4e7faac621526b2ee24e7ae0ea3177ddfdbc34742c886bbd7fe4fb2b251c"
    },
    {
      "key": "0907ccb",
      "nodeTitle": "book_earthmoon",
      "sourceText": "تخيل جول فيرن الصواريخ والسفر إلى الفضاء منذ زمن بعيد.",
      "sourceEnText": "Jules Verne imagined ROCKETS and space TRAVEL long ago.",
      "audioFile": "fr_03_0907ccb.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 4441,
      "updatedAt": "2026-08-25T00:25:37Z",
      "textHash": "e935c8c637b53e827ff49b777f78c80d193c64cf2ab7e9deb2dbfe017891e982"
    },
    {
      "key": "09438f6",
      "nodeTitle": "activity_submarine_done",
      "sourceText": "والآن انتقل إلى الحارس التالي.",
      "sourceEnText": "Now go to next guardian.",
      "audioFile": "fr_03_09438f6.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2847,
      "updatedAt": "2026-08-25T00:25:05Z",
      "textHash": "1245586567b2cc265b1e17edf0509b579d20515bb9430447dbf984320520614d"
    },
    {
      "key": "096a3b3",
      "nodeTitle": "verne_painting",
      "sourceText": "هذا هو جول فيرن. لقد كان كاتباً.",
      "sourceEnText": "This is Jules Verne. He was a WRITER.",
      "audioFile": "fr_03_096a3b3.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 3265,
      "updatedAt": "2026-08-25T00:23:37Z",
      "textHash": "94584c82118cdfee6752499d2a55d5038a8b917b16f399fd10fa4e9dfb31d526"
    },
    {
      "key": "097c3fc",
      "nodeTitle": "tutor_20000",
      "sourceText": "لكنها معطلة!",
      "sourceEnText": "But it's BROKEN!",
      "audioFile": "fr_03_097c3fc.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 1515,
      "updatedAt": "2026-08-25T00:25:15Z",
      "textHash": "a490e9b50274dd6f82ff45ea203a47170e479d92180bcbe2e50679fb67bda95a"
    },
    {
      "key": "0998347",
      "nodeTitle": "train",
      "sourceText": "يسير القطار على قضبان.",
      "sourceEnText": "A TRAIN runs on RAILS.",
      "audioFile": "fr_03_0998347.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2142,
      "updatedAt": "2026-08-25T00:25:23Z",
      "textHash": "f06426662c9b380f2ffaa4cb085147a9b1d8763f8b881ef21ef315b009b1c6db"
    },
    {
      "key": "09a8c21",
      "nodeTitle": "balloon",
      "sourceText": "إنها تتحرك مع الريح.",
      "sourceEnText": "It moves with the WIND.",
      "audioFile": "fr_03_09a8c21.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2064,
      "updatedAt": "2026-08-25T00:23:51Z",
      "textHash": "88343f30ce7748f145d017f6f7b7ad2991be726fe16a024c884a20407e00c848"
    },
    {
      "key": "09bcaba",
      "nodeTitle": "map_nantes",
      "sourceText": "هذه خريطة لمدينة نانت.",
      "sourceEnText": "This is a MAP of NANTES.",
      "audioFile": "fr_03_09bcaba.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2011,
      "updatedAt": "2026-08-25T00:23:41Z",
      "textHash": "5a0eff9f8fbcfc99a49dc59b36ff3b3db0d604f3e7daa5a75983795ce794febc"
    },
    {
      "key": "09eafa1",
      "nodeTitle": "museum_guide",
      "sourceText": "هل يمكنك المساعدة في تنظيف المتحف؟",
      "sourceEnText": "Can you help cleaning the MUSEUM?",
      "audioFile": "fr_03_09eafa1.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2142,
      "updatedAt": "2026-08-25T00:24:43Z",
      "textHash": "2579d2be85f75e48a103b85192e3008d203db65697d1b3a02152ef13c55773ac"
    },
    {
      "key": "0a1520b",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "ابحث عن منطاد الهواء الساخن",
      "sourceEnText": "Find the HOT AIR BALLOON",
      "audioFile": "fr_03_0a1520b.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2142,
      "updatedAt": "2026-08-25T00:25:11Z",
      "textHash": "1b9d5ee0685e1041185370bfd3d0a98084c73aa16064da5de5a296b761968454"
    },
    {
      "key": "0a3e2f4",
      "nodeTitle": "npc_door",
      "sourceText": "يا لها من فوضى عارمة خارج المتحف!",
      "sourceEnText": "What a MESS outside the MUSEUM!",
      "audioFile": "fr_03_0a3e2f4.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 2560,
      "updatedAt": "2026-08-25T00:24:26Z",
      "textHash": "9a7cd0867c299e37822d18d712c8dacb4a452793d65173c826dff0f5c57693e6"
    },
    {
      "key": "0a7dfb3",
      "nodeTitle": "museum_guide",
      "sourceText": "لدينا مشكلة أخرى!",
      "sourceEnText": "We have another PROBLEM!",
      "audioFile": "fr_03_0a7dfb3.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T00:24:50Z",
      "textHash": "2f3548f62b27d73c7d0168d40cebac2cdc600179740635aac028ace873652081"
    },
    {
      "key": "0b5e2f3",
      "nodeTitle": "quest_start",
      "sourceText": "أهلاً بكم في نانت. انطلقوا لاكتشاف متحف جول فيرن!",
      "sourceEnText": "Welcome to Nantes. Go and discover the Jules Verne Museum!",
      "audioFile": "fr_03_0b5e2f3.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 4754,
      "updatedAt": "2026-08-25T00:23:34Z",
      "textHash": "aaf1675b2c737ce746838ad13758614be92fb0008d370311a7bd31a46a036dc8"
    },
    {
      "key": "0b5eb24",
      "nodeTitle": "task_clean_museum_done",
      "sourceText": "ممتاز. أصبح المتحف نظيفاً الآن! ارجع إلى دليل المتحف.",
      "sourceEnText": "Perfect. Now the Museum is clean! Go back to the MUSEUM GUIDE.",
      "audioFile": "fr_03_0b5eb24.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 6740,
      "updatedAt": "2026-08-25T00:24:57Z",
      "textHash": "2c33cead405352c66190e4534c1179da13fc926001821892a463928644ce6ca1"
    },
    {
      "key": "0b7b198",
      "nodeTitle": "train",
      "sourceText": "كان هذا القطار القديم يستخدم البخار للتحرك.",
      "sourceEnText": "This old TRAIN used STEAM to move.",
      "audioFile": "fr_03_0b7b198.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 3866,
      "updatedAt": "2026-08-25T00:25:25Z",
      "textHash": "795bbf6dc79cb2c22e91f2b36f07fdaf1cdd6302c9b792391dd88acf34ee52f7"
    },
    {
      "key": "0ba85d3",
      "nodeTitle": "activity_submarine_done",
      "sourceText": "لقد أصلحتها! شكراً لك!",
      "sourceEnText": "You repaired it! Thank you!",
      "audioFile": "fr_03_0ba85d3.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2429,
      "updatedAt": "2026-08-25T00:25:04Z",
      "textHash": "9224dc4ba4b228a11fc36147c4b9e0f1549ce92224574199c4ebaba14efaa371"
    },
    {
      "key": "0bb264b",
      "nodeTitle": "tutor_20000",
      "sourceText": "ابحث عن الغواصة",
      "sourceEnText": "Find the SUBMARINE",
      "audioFile": "fr_03_0bb264b.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T00:25:03Z",
      "textHash": "b3b16d11bcdb21a90de54b583128638e1a636012defc79ddf2a7a188e784e2e8"
    },
    {
      "key": "0bb46da",
      "nodeTitle": "museum_guide",
      "sourceText": "لم تعد المركبات موجودة.",
      "sourceEnText": "The vehicles are no longer there.",
      "audioFile": "fr_03_0bb46da.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 1959,
      "updatedAt": "2026-08-25T00:24:51Z",
      "textHash": "180164af08f9e516946176910070b481ac83aef8c213e19222e87962d349d201"
    },
    {
      "key": "0bc6c7b",
      "nodeTitle": "museum_guide",
      "sourceText": "كان جول فيرن سيفخر بك!",
      "sourceEnText": "Jules Verne would be proud of you!",
      "audioFile": "fr_03_0bc6c7b.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 1959,
      "updatedAt": "2026-08-25T00:24:45Z",
      "textHash": "09ab36e09fe01cec433c53117d77afd9a352f7e2e03dca3fb7a7e989e0d85af9"
    },
    {
      "key": "0bcc84d",
      "nodeTitle": "book_80days",
      "sourceText": "يُظهر العديد من الأماكن على الأرض.",
      "sourceEnText": "It shows many places on EARTH.",
      "audioFile": "fr_03_0bcc84d.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2534,
      "updatedAt": "2026-08-25T00:24:07Z",
      "textHash": "8f77ac17dfbce98356fd2d5b3fb8454a386822562c8c9774f42176bf92c6fd8a"
    },
    {
      "key": "0c3d777",
      "nodeTitle": "book_5weeks",
      "sourceText": "هذا الكتاب بعنوان \"خمسة أسابيع في منطاد\".",
      "sourceEnText": "This BOOK is \"Five Weeks in a Balloon.\"",
      "audioFile": "fr_03_0c3d777.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 3814,
      "updatedAt": "2026-08-25T00:25:12Z",
      "textHash": "935f6ab360e1c2cc71962f0c20fdc15a2efd5402cd6501892eb10f28129b0656"
    },
    {
      "key": "0c52f3c",
      "nodeTitle": "museum_guide",
      "sourceText": "هذا جيد. لم تنتهِ بعد، استمر!",
      "sourceEnText": "You are doing well!",
      "audioFile": "fr_03_0c52f3c.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 3030,
      "updatedAt": "2026-08-25T00:24:48Z",
      "textHash": "42f6767476d1ccb054939e85ca13fb4dfb98827886a6cc7cc8d707a8fcef6172"
    },
    {
      "key": "0c790cf",
      "nodeTitle": "spawned_guide",
      "sourceText": "كان جول فيرن كاتبًا فرنسيًا. وقد ولد بالقرب من هنا.",
      "sourceEnText": "Jules Verne was a French WRITER. He was born near here.",
      "audioFile": "fr_03_0c790cf.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_M",
      "durationMs": 5042,
      "updatedAt": "2026-08-25T00:24:18Z",
      "textHash": "d8b7c5d922c87994481c7b9d5fcdb47b0d80dc6b51271263ce6bd5b895c38eeb"
    },
    {
      "key": "0c81640",
      "nodeTitle": "museum_guide",
      "sourceText": "شكراً! أصبح المتحف الآن جاهزاً.",
      "sourceEnText": "Thank you! Now the MUSEUM is in order",
      "audioFile": "fr_03_0c81640.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 3500,
      "updatedAt": "2026-08-25T00:24:40Z",
      "textHash": "5478fde093cbf773dde9199410a76cab98b5d4fdd0537667a4f35b5a296e3488"
    },
    {
      "key": "0caca1b",
      "nodeTitle": "spawned_visitor",
      "sourceText": "كتب جول فيرن العديد من الكتب!",
      "sourceEnText": "Jules Verne wrote many BOOKS!",
      "audioFile": "fr_03_0caca1b.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 2351,
      "updatedAt": "2026-08-25T00:23:58Z",
      "textHash": "f9dacad5f93b3028f4587adf71eaa74aac75ff2f6acf7ffea7d7d8296a4c084e"
    },
    {
      "key": "0cec96a",
      "nodeTitle": "npc_door",
      "sourceText": "شكراً لكم على التنظيف!",
      "sourceEnText": "Thank you for cleaning up!",
      "audioFile": "fr_03_0cec96a.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 1829,
      "updatedAt": "2026-08-25T00:24:30Z",
      "textHash": "f4d0457422f66874c6db141f73ba5c39f5f2b6eedd625b0fe4ce1e4e4fe97bcb"
    },
    {
      "key": "0d2e2f0",
      "nodeTitle": "npc_door",
      "sourceText": "المتحف مفتوح الآن! تحدث إلى مرشد المتحف!",
      "sourceEnText": "The Museum is now open! Talk to the MUSEUM GUIDE!",
      "audioFile": "fr_03_0d2e2f0.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 4284,
      "updatedAt": "2026-08-25T00:24:32Z",
      "textHash": "7a96361dce99236028b0046992a37c9fba9da7fa8dd7b01fc19d5ce57966fe83"
    },
    {
      "key": "0d58543",
      "nodeTitle": "npc_door",
      "sourceText": "لا يمكنني فتح المتحف مع وجود هذه الفوضى هنا.",
      "sourceEnText": "I can't open the MUSEUM with this mess here.",
      "audioFile": "fr_03_0d58543.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 3318,
      "updatedAt": "2026-08-25T00:24:35Z",
      "textHash": "2bbde7b24950d3e4b9928560c2e3c545e9cd4ae2618663885b1188fbab7b7951"
    },
    {
      "key": "0dcb855",
      "nodeTitle": "book_20000",
      "sourceText": "الغواصة تسير تحت الماء.",
      "sourceEnText": "A SUBMARINE travels UNDERWATER.",
      "audioFile": "fr_03_0dcb855.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2247,
      "updatedAt": "2026-08-25T00:23:48Z",
      "textHash": "425631ca6f51338b77f103872cc9b7fc5515e3a8ddca0863df5184cb27f9b577"
    },
    {
      "key": "0de00ff",
      "nodeTitle": "rocket",
      "sourceText": "هذا صاروخ فضائي.",
      "sourceEnText": "This is a space ROCKET.",
      "audioFile": "fr_03_0de00ff.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 1541,
      "updatedAt": "2026-08-25T00:25:33Z",
      "textHash": "8c9a03e145dc25132f1d6aee345adb21c29d505feb03f8e78531f6922d6b1082"
    },
    {
      "key": "0e81901",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "أعجبتني القصة التي تتحدث عن العالم.",
      "sourceEnText": "I like the story about the WORLD.",
      "audioFile": "fr_03_0e81901.mp3",
      "voiceProfile": "haytham",
      "actorId": "KID_M",
      "durationMs": 2900,
      "updatedAt": "2026-08-25T00:24:01Z",
      "textHash": "73d768112e2ef14459fd154316c7c49e0675849d4d0b47a2671947957067fb6b"
    },
    {
      "key": "0e86b01",
      "nodeTitle": "activity_match_done",
      "sourceText": "أحسنت! لقد قمت بمطابقة جميع الكتب مع مركباتها.",
      "sourceEnText": "Well done! You matched all the BOOKS with their VEHICLES.",
      "audioFile": "fr_03_0e86b01.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 4441,
      "updatedAt": "2026-08-25T00:24:54Z",
      "textHash": "a0e970849f4f86ee02993ffe1b2d9c6b91c4f15ad606d7c381195ed229e28c46"
    },
    {
      "key": "0e928ab",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "النجدة! هناك شيء مفقود!",
      "sourceEnText": "Help! Something is missing!",
      "audioFile": "fr_03_0e928ab.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 2769,
      "updatedAt": "2026-08-25T00:25:10Z",
      "textHash": "fc3116475196c646e52e0447e22bb41da58c43c91ba4311d3d11b4656dd7a41c"
    },
    {
      "key": "0ee83b2",
      "nodeTitle": "activity_train_done",
      "sourceText": "ارجع إلى دليل المتحف!",
      "sourceEnText": "Go back to the MUSEUM GUIDE!",
      "audioFile": "fr_03_0ee83b2.mp3",
      "voiceProfile": "haytham",
      "actorId": "ADULT_F",
      "durationMs": 1829,
      "updatedAt": "2026-08-25T00:25:31Z",
      "textHash": "a9001779ca1aad033dfde28a90033bc92a1f7245ef0bcdae3f88271f2547be06"
    },
    {
      "key": "0f5f36d",
      "nodeTitle": "spawned_visitor",
      "sourceText": "تُقرأ كتبه بلغات عديدة!",
      "sourceEnText": "People read his BOOKS in many languages!",
      "audioFile": "fr_03_0f5f36d.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-08-25T00:24:00Z",
      "textHash": "0b5db988c57e8cb09e0b175154459111cd1409bf0b6445e215f9a284124ea3b1"
    },
    {
      "key": "0f72ec7",
      "nodeTitle": "quest_end",
      "sourceText": "إذا ذهبت إلى نانت مع والديك، فلا تفوت زيارة متحف جول فيرن!",
      "sourceEnText": "If you go to Nantes with your parents, go to the Jules Verne Museum!",
      "audioFile": "fr_03_0f72ec7.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 4571,
      "updatedAt": "2026-08-25T00:24:28Z",
      "textHash": "2f2657e9c199abd74463b4157124286ac44992270e860ff93adc96c91129e20c"
    },
    {
