    },
    {
      "key": "0174104",
      "nodeTitle": "quest_end",
      "sourceText": "Acum știi despre Jules Verne și CĂRȚILE sale!",
      "sourceEnText": "Now you know about Jules Verne and his BOOKS!",
      "audioFile": "fr_03_0174104.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2847,
      "updatedAt": "2026-08-25T00:35:35Z",
      "textHash": "9b659a661b370cb5d78052689b202ef955ac6907247869e93dce78692dcea3ce"
    },
    {
      "key": "01a9d0f",
      "nodeTitle": "npc_door",
      "sourceText": "Ajută-mă să curăț trotuarul!",
      "sourceEnText": "Help me clean the sidewalk!",
      "audioFile": "fr_03_01a9d0f.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1829,
