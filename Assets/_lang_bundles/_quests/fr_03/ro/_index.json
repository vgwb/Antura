    {
      "key": "06e1473",
      "nodeTitle": "spawned_guide",
      "sourceText": "Multe idei din CĂRȚILE sale au devenit realitate.",
      "sourceEnText": "Many ideas in his BOOKS became real.",
      "audioFile": "fr_03_06e1473.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_M",
      "durationMs": 3370,
      "updatedAt": "2026-08-25T00:36:00Z",
      "textHash": "9b5616924a44320f1cce9f8f8a8b46c4739529143723758b6d486234eb370e99"
    },
    {
      "key": "06fb1cd",
      "nodeTitle": "spawned_guide",
      "sourceText": "Nu, cine este el?",
      "sourceEnText": "No, who is he?",
      "audioFile": "fr_03_06fb1cd.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_M",
      "durationMs": 1411,
      "updatedAt": "2026-08-25T00:36:07Z",
      "textHash": "18a4eddd06a5205febe75907d74c14de7316d41fcd4b8be3131a6af8cb9bb0cf"
    },
    {
      "key": "0757b30",
      "nodeTitle": "submarine_lost",
      "sourceText": "Grozav! Acum du-l înapoi la tutorele său.",
      "sourceEnText": "Great! Now bring it back to its guardian",
      "audioFile": "fr_03_0757b30.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 2612,
      "updatedAt": "2026-08-25T00:36:51Z",
      "textHash": "47c41fce6235ea5be99ac72a0a769e169802253a1059b490e551fab3d3db77ab"
    },
    {
      "key": "07c4369",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Ajutor! Cea mai prețioasă mașinărie a noastră lipsește!",
      "sourceEnText": "Help! Our most precious machine is missing!",
      "audioFile": "fr_03_07c4369.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 4571,
      "updatedAt": "2026-08-25T00:37:13Z",
      "textHash": "12af2a0a48acaaa81cfcbb3521a493605a2f20382b0b2238cf16bf15d3b1018d"
    },
    {
      "key": "07ee86b",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "RACHETA către LUNĂ pare rapidă.",
      "sourceEnText": "The ROCKET to the MOON looks fast.",
      "audioFile": "fr_03_07ee86b.mp3",
      "voiceProfile": "cristi",
      "actorId": "KID_M",
      "durationMs": 2247,
      "updatedAt": "2026-08-25T00:35:57Z",
      "textHash": "0ab768a558bfa71b2978c54b283edd0349fdc26450879b0157d0e0b20fa8c389"
    },
