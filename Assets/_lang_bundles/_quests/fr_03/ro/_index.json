    },
    {
      "key": "0caca1b",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Jules Verne a scris multe CĂRȚI!",
      "sourceEnText": "Jules Verne wrote many BOOKS!",
      "audioFile": "fr_03_0caca1b.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-08-25T00:35:52Z",
      "textHash": "d0e0483887ad35f04461effba57bad5637e81cc2f9f9404d186c47d6972038ae"
    },
    {
      "key": "0cec96a",
      "nodeTitle": "npc_door",
      "sourceText": "Mulțumesc pentru curățenie!",
      "sourceEnText": "Thank you for cleaning up!",
      "audioFile": "fr_03_0cec96a.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1724,
