    {
      "key": "0c52f3c",
      "nodeTitle": "museum_guide",
      "sourceText": "Bună. Nu ai terminat încă, continuă!",
      "sourceEnText": "You are doing well!",
      "audioFile": "fr_03_0c52f3c.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
