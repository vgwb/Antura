    {
      "key": "0f72ec7",
      "nodeTitle": "quest_end",
      "sourceText": "Dacă mergi la Nantes cu părinții tăi, mergi la Muzeul Jules Verne!",
      "sourceEnText": "If you go to Nantes with your parents, go to the Jules Verne Museum!",
      "audioFile": "fr_03_0f72ec7.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 4153,
      "updatedAt": "2026-08-25T00:36:17Z",
      "textHash": "8aa15a5228a6ac69a8b1fa84349837ee91e616fe0cd0d07015c05dedb10deba5"
