    {
      "key": "0f8dd6c",
      "nodeTitle": "task_clean_done",
      "sourceText": "Bravo! Întoarce-te și vezi domnul de la intrarea muzeului.",
      "sourceEnText": "Well done! Go back and see the gentleman at the museum entrance.",
      "audioFile": "fr_03_0f8dd6c.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 3213,
      "updatedAt": "2026-08-25T00:36:25Z",
      "textHash": "a9eaa2e4993e13ebf759a1881dc90b640ef39905dfe6ddd506e74a3c2db0a824"
    },
    {
      "key": "0f92a05",
      "nodeTitle": "spawned_guide",
      "sourceText": "A scris cărți de aventuri foarte faimoase.",
      "sourceEnText": "He wrote very famous adventure BOOKS.",
      "audioFile": "fr_03_0f92a05.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_M",
      "durationMs": 2534,
      "updatedAt": "2026-08-25T00:36:10Z",
