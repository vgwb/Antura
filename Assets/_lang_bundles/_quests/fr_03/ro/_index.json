    {
      "key": "0b5e2f3",
      "nodeTitle": "quest_start",
      "sourceText": "Bine ați venit la Nantes. Mergeți și descoperiți Muzeul Jules Verne!",
      "sourceEnText": "Welcome to Nantes. Go and discover the Jules Verne Museum!",
      "audioFile": "fr_03_0b5e2f3.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 4232,
      "updatedAt": "2026-08-25T00:35:33Z",
