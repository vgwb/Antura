      "textHash": "67ddcfd23077b41ac7c3761084f39a4a9495c63cf17cdcd5a4bed1b830be3778"
    },
    {
      "key": "01f76f3",
      "nodeTitle": "tutor_80days",
      "sourceText": "Ai găsit TRENUL!",
      "sourceEnText": "You found the TRAIN!",
      "audioFile": "fr_03_01f76f3.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 1228,
      "updatedAt": "2026-08-25T00:37:03Z",
      "textHash": "d0674fc573a84351fb70a11ab84006b051c80bc83839ddcf6e30eb6ae79d3191"
    },
    {
      "key": "020d924",
      "nodeTitle": "book_5weeks",
      "sourceText": "Un balon se ridică deoarece aerul cald este ușor.",
      "sourceEnText": "A BALLOON rises because warm AIR is light.",
      "audioFile": "fr_03_020d924.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 3213,
      "updatedAt": "2026-08-25T00:36:58Z",
      "textHash": "30641efa3b1d8e4e9816d27e7ae468d8604eaf3695a3f13b44009b1d77f8a2d7"
    },
    {
      "key": "0210ef0",
      "nodeTitle": "npc_door",
      "sourceText": "Câinele ăla albastru alerga și a făcut mizerie!",
      "sourceEnText": "That blue DOG was running and made a mess!",
      "audioFile": "fr_03_0210ef0.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 3213,
      "updatedAt": "2026-08-25T00:36:21Z",
      "textHash": "723bdb1197215d49f42d605f0079896a6cd9705c5144593199cefb43172d7c5a"
    },
    {
      "key": "0245e0e",
      "nodeTitle": "museum_guide",
      "sourceText": "Pune CĂRȚILE împreună cu vehiculele lor!",
      "sourceEnText": "Put the BOOKS together with their vehicles!",
      "audioFile": "fr_03_0245e0e.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 2482,
      "updatedAt": "2026-08-25T00:36:32Z",
      "textHash": "492433b9d3848a73ed5fd093ba7c6993219cc30ad457629f43e746a34f574fff"
    },
    {
      "key": "0286510",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Ai găsit BALONUL CU AER CALD! Se mai numește și balon.",
      "sourceEnText": "You found the HOT AIR BALLOON!",
      "audioFile": "fr_03_0286510.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 3788,
      "updatedAt": "2026-08-25T00:36:52Z",
      "textHash": "05887c94309798d62fda4d3e95015fd3ed10ff399a035e57e01bff5902f71b21"
    },
    {
      "key": "02e7812",
      "nodeTitle": "tutor_20000",
      "sourceText": "Poți să-l repari, te rog?",
      "sourceEnText": "Can you please fix it?",
      "audioFile": "fr_03_02e7812.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 1593,
      "updatedAt": "2026-08-25T00:36:44Z",
      "textHash": "ef29e9f89c1bb0c421312e434e328c762493acb7adedecc757aeb3adeec5a475"
    },
    {
      "key": "03131e3",
      "nodeTitle": "book_80days",
      "sourceText": "Această carte este „Înconjurul lumii în 80 de zile”.",
      "sourceEnText": "This BOOK is \"Around the World in 80 Days.\"",
      "audioFile": "fr_03_03131e3.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 3553,
      "updatedAt": "2026-08-25T00:35:41Z",
      "textHash": "867f74c1f11928a5f9bf78615637c74179418beb20208009ad2f49bb01459be9"
    },
    {
      "key": "03536a1",
      "nodeTitle": "book_20000",
      "sourceText": "Această CARTE este „20.000 de leghe sub mări”.",
      "sourceEnText": "This BOOK is \"20,000 Leagues Under the Seas.\"",
      "audioFile": "fr_03_03536a1.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 3814,
      "updatedAt": "2026-08-25T00:35:43Z",
      "textHash": "00e66a3dadc71fac02f3b49b106acf96b6258b6a37d683e63f4149f649700d83"
    },
    {
      "key": "036574d",
      "nodeTitle": "tutor_80days",
      "sourceText": "Găsește VECHIUL TREN CU ABURI",
      "sourceEnText": "Find the OLD STEAM TRAIN",
      "audioFile": "fr_03_036574d.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 1933,
      "updatedAt": "2026-08-25T00:37:06Z",
      "textHash": "9a562496a3b4c0ae7f41b31a20139be01b91071b83badbf237c94b68b472bc96"
    },
    {
      "key": "0386706",
      "nodeTitle": "museum_guide",
      "sourceText": "Te rog să vorbești cu primul gardian de cameră.",
      "sourceEnText": "Please talk to the first room guardian.",
      "audioFile": "fr_03_0386706.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 3866,
      "updatedAt": "2026-08-25T00:36:37Z",
      "textHash": "e12f54dfdeadeeb0f6e4e880b32eb4926e1487f2dc2693d255dd207db14f11de"
