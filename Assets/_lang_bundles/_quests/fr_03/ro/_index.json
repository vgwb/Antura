      "textHash": "104425b46026bbd89390fd203fddff57af9451f98e4519e441b8c8551efda515"
    },
    {
      "key": "0525efc",
      "nodeTitle": "museum_guide",
      "sourceText": "Un CÂINE albastru și amuzant a intrat în MUZEU și a făcut mizerie!",
      "sourceEnText": "A funny blue DOG entered the MUSEUM and made a mess!",
      "audioFile": "fr_03_0525efc.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 3866,
      "updatedAt": "2026-08-25T00:36:13Z",
      "textHash": "1f4c6f8baf54357ad126f435de9c0397122c7354f0089bcb1e182bb2f3f15572"
    },
    {
      "key": "056e79e",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Jules Verne a inventat povestiri science-fiction.",
      "sourceEnText": "Jules Verne invented science FICTION stories.",
      "audioFile": "fr_03_056e79e.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2952,
      "updatedAt": "2026-08-25T00:35:50Z",
      "textHash": "58ca55ab6605dc4c2b6bf14b3212eb394323df1069b5919688dcc3e9f66ed98f"
    },
    {
      "key": "05bc5e9",
      "nodeTitle": "tutor_20000",
      "sourceText": "Dacă nu îl găsești, FOLOSEȘTE HARTA",
      "sourceEnText": "If you can't find it, USE THE MAP",
      "audioFile": "fr_03_05bc5e9.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 2482,
      "updatedAt": "2026-08-25T00:37:20Z",
      "textHash": "945788cf7cfeeab373177809505a1735729dc181cec55b8393f1c66523ad1685"
    },
    {
      "key": "05e298d",
      "nodeTitle": "book_earthmoon",
      "sourceText": "Povestea are un TUN spațial imens pentru a lansa RACHETA",
      "sourceEnText": "The story has a huge space CANNON to launch the ROCKET",
      "audioFile": "fr_03_05e298d.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 3553,
      "updatedAt": "2026-08-25T00:37:22Z",
      "textHash": "e54683336fdd2023da8593985af7b72ab55b5c80fc67ae5c82c1502cb2e2da46"
    },
    {
      "key": "0642734",
      "nodeTitle": "museum_guide",
      "sourceText": "Avem o PROBLEMĂ!",
      "sourceEnText": "We have a PROBLEM!",
      "audioFile": "fr_03_0642734.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 1306,
      "updatedAt": "2026-08-25T00:36:11Z",
      "textHash": "0f11100e58060bf13089684fe736d7adf295a3bd95ecc6100f770321cc243f01"
