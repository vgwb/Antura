      "textHash": "f2281e432b6414f5e4ce32d94769e977cf71d2a75b5a1e6a6cef0c2809d8aef4"
    },
    {
      "key": "0dcb855",
      "nodeTitle": "book_20000",
      "sourceText": "UN SUBMARIN călătorește SUB APĂ.",
      "sourceEnText": "A SUBMARINE travels UNDERWATER.",
      "audioFile": "fr_03_0dcb855.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 2429,
      "updatedAt": "2026-08-25T00:35:45Z",
      "textHash": "33debbc998b143fb70515fc13a5d0c572c9eee65c8d7de0c62052d43cc20ddf9"
    },
    {
      "key": "0de00ff",
      "nodeTitle": "rocket",
      "sourceText": "Aceasta este o RACHETĂ spațială.",
      "sourceEnText": "This is a space ROCKET.",
      "audioFile": "fr_03_0de00ff.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 2351,
      "updatedAt": "2026-08-25T00:37:17Z",
      "textHash": "5daabeaacef199f2460af83e57a509c5006c7a512f74e7b3a41d4922f8ed18d6"
    },
    {
      "key": "0e81901",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Îmi place povestea despre LUME.",
      "sourceEnText": "I like the story about the WORLD.",
      "audioFile": "fr_03_0e81901.mp3",
      "voiceProfile": "cristi",
      "actorId": "KID_M",
      "durationMs": 1881,
      "updatedAt": "2026-08-25T00:35:55Z",
      "textHash": "a12aa3e5f07bc965793a3cae3f77568ee14404e70de43f6c590278bcb42c63ca"
    },
    {
      "key": "0e86b01",
      "nodeTitle": "activity_match_done",
      "sourceText": "Bravo! Ai potrivit toate CĂRȚILE cu VEHICULELE LOR.",
      "sourceEnText": "Well done! You matched all the BOOKS with their VEHICLES.",
      "audioFile": "fr_03_0e86b01.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 3370,
      "updatedAt": "2026-08-25T00:36:39Z",
      "textHash": "4efade6e0f7019624e85521c8b90e2c030e6eb1d35093a013e2a1e9060c932e1"
    },
    {
      "key": "0e928ab",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Ajutor! Lipsește ceva!",
      "sourceEnText": "Help! Something is missing!",
      "audioFile": "fr_03_0e928ab.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 1881,
      "updatedAt": "2026-08-25T00:36:54Z",
      "textHash": "3f65cd5929d35df0732c7c9c429125da155a4ebe64fa8a856612eb29b89d08c8"
