    {
      "key": "0ee83b2",
      "nodeTitle": "activity_train_done",
      "sourceText": "Întoarceți-vă la GHIDUL MUZEULUI!",
      "sourceEnText": "Go back to the MUSEUM GUIDE!",
      "audioFile": "fr_03_0ee83b2.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 2247,
