    {
      "key": "03af9a8",
      "nodeTitle": "tutor_20000",
      "sourceText": "Întoarce-te la mine mai târziu.",
      "sourceEnText": "Come back to me later.",
      "audioFile": "fr_03_03af9a8.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 1724,
      "updatedAt": "2026-08-25T00:37:00Z",
      "textHash": "71cea1f84c2f1d09a8840668f3b78ecff9e6cbb14eeebf2db5f666db451f8222"
    },
    {
      "key": "03efbc0",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Găsește RACHETA SPAȚIALĂ",
      "sourceEnText": "Find the SPACE ROCKET",
      "audioFile": "fr_03_03efbc0.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 1933,
      "updatedAt": "2026-08-25T00:37:14Z",
      "textHash": "60b802a94825482c8062f13f70777c1e896bb4e36231e25d1b8d09829c43bf75"
    },
    {
      "key": "05130c0",
      "nodeTitle": "train",
      "sourceText": "TRENURILE făceau călătoriile lungi mai rapide.",
      "sourceEnText": "TRAINS made long trips faster.",
      "audioFile": "fr_03_05130c0.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 2847,
