    },
    {
      "key": "0c790cf",
      "nodeTitle": "spawned_guide",
      "sourceText": "Jules Verne a fost un SCRIITOR francez. S-a născut în apropiere.",
      "sourceEnText": "Jules Verne was a French WRITER. He was born near here.",
      "audioFile": "fr_03_0c790cf.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_M",
      "durationMs": 4153,
      "updatedAt": "2026-08-25T00:36:08Z",
      "textHash": "f78b2ce04843c99adc9e07a4b980124e1f59ed58375db3bf5e185a38da9b9fc4"
    },
    {
      "key": "0c81640",
      "nodeTitle": "museum_guide",
      "sourceText": "Mulțumesc! Acum MUZEUL este în ordine.",
