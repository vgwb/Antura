      "textHash": "55801c89cba084eb7e7e513a2e7fc2211aa84fa936a20d3f1d10ec248ac62fd4"
    },
    {
      "key": "0b7b198",
      "nodeTitle": "train",
      "sourceText": "Acest TREN vechi folosea ABURUL pentru a se deplasa.",
