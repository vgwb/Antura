    {
      "key": "0666ee2",
      "nodeTitle": "tutor_20000",
      "sourceText": "Ai găsit SUBMARINUL!",
      "sourceEnText": "You found the SUBMARINE!",
      "audioFile": "fr_03_0666ee2.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 1515,
      "updatedAt": "2026-08-25T00:36:43Z",
      "textHash": "59e6119760bd843cf3865587dc37834a972de3eb5843f99f9afcba69da853bc6"
    },
    {
      "key": "06aef1a",
      "nodeTitle": "submarine",
      "sourceText": "Un submarin se mișcă pe sub mare.",
      "sourceEnText": "A SUBMARINE moves under the SEA.",
      "audioFile": "fr_03_06aef1a.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 2299,
      "updatedAt": "2026-08-25T00:37:02Z",
      "textHash": "9e4530b981c142526236cdeca1804208fbf07a41d182fc55cf403c991c0dfc40"
    },
    {
      "key": "06b6d4d",
      "nodeTitle": "rocket",
      "sourceText": "O RACHETĂ se împinge puternic pentru a părăsi PĂMÂNTUL.",
      "sourceEnText": "A ROCKET pushes hard to leave EARTH.",
      "audioFile": "fr_03_06b6d4d.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 3213,
      "updatedAt": "2026-08-25T00:35:42Z",
      "textHash": "c83429e821d9a9f8dcf50f0994185e763ac23883a5d76e5027bec3ef551653ca"
