    },
    {
      "key": "00be1f0",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Vreau să merg într-o zi la o plimbare cu balonul cu aer cald.",
      "sourceEnText": "I want to ride a BALLOON one day.",
