      "textHash": "51d977fe4560dd9c08d032cbd3181f57f11e0c8309368ed0fef816ae30521156"
    },
    {
      "key": "0d58543",
      "nodeTitle": "npc_door",
      "sourceText": "Nu pot deschide MUZEU cu toată mizeria asta.",
      "sourceEnText": "I can't open the MUSEUM with this mess here.",
