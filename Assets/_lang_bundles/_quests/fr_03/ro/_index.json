      "textHash": "78b37774a6dac1aa6d384140a8096a4bdd0a7923d1b2d3c0340e1df02c07709e"
    },
    {
      "key": "00eefe0",
      "nodeTitle": "activity_match_done",
      "sourceText": "Acum totul este pregătit pentru vizitatori!",
