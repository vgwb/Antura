    {
      "key": "0f5f36d",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Cărțile lui sunt citite în multe limbi!",
      "sourceEnText": "People read his BOOKS in many languages!",
      "audioFile": "fr_03_0f5f36d.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2194,
      "updatedAt": "2026-08-25T00:35:53Z",
