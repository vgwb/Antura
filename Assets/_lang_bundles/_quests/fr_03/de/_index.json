    },
    {
      "key": "096a3b3",
      "nodeTitle": "verne_painting",
      "sourceText": "Das ist Jules Verne. Er war ein Schriftsteller.",
      "sourceEnText": "This is Jules Verne. He was a WRITER.",
      "audioFile": "fr_03_096a3b3.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3318,
      "updatedAt": "2026-08-24T18:59:22Z",
