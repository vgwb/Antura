  "lines": [
    {
      "key": "003b311",
      "nodeTitle": "verne_house",
      "sourceText": "Jules Verne wurde hier in Nantes geboren.",
      "sourceEnText": "Jules Verne was born here in NANTES.",
      "audioFile": "fr_03_003b311.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2482,
      "updatedAt": "2026-08-24T18:59:25Z",
      "textHash": "8b2ecaadf297f3649af3ca0f7735e73d540ea17292f133a6a6760c3f9e3fc4a0"
    },
    {
      "key": "006e7fc",
      "nodeTitle": "quest_start",
      "sourceText": "Wer war Jules Verne? Und wohin ist er gereist?",
      "sourceEnText": "Who is Jules Verne? And where did he travel?",
      "audioFile": "fr_03_006e7fc.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3135,
      "updatedAt": "2026-08-24T19:00:09Z",
      "textHash": "fb96f0e2184b08c1ccdfa5e11674e827608d0aa2bde05c4c2844cdcc455f2e06"
    },
    {
      "key": "00a6154",
      "nodeTitle": "tutor_20000",
      "sourceText": "Hilfe! Die Nautilus ist verschwunden!",
      "sourceEnText": "Help! The Nautilus is missing!",
      "audioFile": "fr_03_00a6154.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2847,
      "updatedAt": "2026-08-24T19:01:27Z",
      "textHash": "1ee05900e542e5b9efbb86ba59d99e1181c8bbffec2ec94aa78f2a9c7c037727"
    },
    {
      "key": "00b1d04",
      "nodeTitle": "spawned_guide",
      "sourceText": "Wissen Sie, wer Jules Verne ist?",
      "sourceEnText": "Do you know who Jules Verne is?",
      "audioFile": "fr_03_00b1d04.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1829,
      "updatedAt": "2026-08-24T19:00:11Z",
      "textHash": "f980358cc3f186254d87bc58e921dcc21c271be63847f36a923d8b2ebfbfaabd"
    },
    {
      "key": "00be1f0",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Ich möchte eines Tages eine Fahrt mit einem Heißluftballon machen.",
      "sourceEnText": "I want to ride a BALLOON one day.",
      "audioFile": "fr_03_00be1f0.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 4023,
      "updatedAt": "2026-08-24T18:59:58Z",
      "textHash": "079d51165ee7e20cf525e41c8c315fe51bff17df4e0d7565ff16661806c2c7e0"
    },
    {
      "key": "00eefe0",
      "nodeTitle": "activity_match_done",
      "sourceText": "Nun ist alles bereit für die Besucher!",
      "sourceEnText": "Now everything is ready for the visitors!",
      "audioFile": "fr_03_00eefe0.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2299,
      "updatedAt": "2026-08-24T19:01:16Z",
      "textHash": "d6cbcef4263a17ac6086ecf109d72789149a0178d9e343e260b388a7b606f3e2"
    },
    {
      "key": "00f3a57",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Ich liebe es, Bücher zu lesen!",
      "sourceEnText": "I love reading BOOKS!",
      "audioFile": "fr_03_00f3a57.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2011,
      "updatedAt": "2026-08-24T18:59:46Z",
      "textHash": "7b1e37064b17accded82e049d1bb002df07936f47647e59f41af40aea621dd8f"
    },
    {
      "key": "0131b99",
      "nodeTitle": "balloon",
      "sourceText": "Ein Ballon steigt mit warmer Luft auf.",
      "sourceEnText": "A BALLOON goes up with warm AIR.",
      "audioFile": "fr_03_0131b99.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2482,
      "updatedAt": "2026-08-24T18:59:41Z",
      "textHash": "cbf0ff5b5765ce74db986577d6fea07450aa46296919c8ab36079830d1b7f2a4"
    },
    {
      "key": "0174104",
      "nodeTitle": "quest_end",
      "sourceText": "Jetzt wisst ihr etwas über Jules Verne und seine Bücher!",
      "sourceEnText": "Now you know about Jules Verne and his BOOKS!",
      "audioFile": "fr_03_0174104.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3448,
      "updatedAt": "2026-08-24T18:59:20Z",
      "textHash": "59e1d02fb0fcab9d862879860fae7540c5fa903a8abedcf11fcb8342b8dd87a8"
    },
    {
      "key": "01a9d0f",
      "nodeTitle": "npc_door",
      "sourceText": "Hilf mir, den Gehweg zu reinigen!",
      "sourceEnText": "Help me clean the sidewalk!",
      "audioFile": "fr_03_01a9d0f.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2194,
      "updatedAt": "2026-08-24T19:00:45Z",
      "textHash": "7190bd868a752f8e661952df7020abb62d779b8071f9b5352c25d59bb6a02bf9"
    },
    {
      "key": "01f76f3",
      "nodeTitle": "tutor_80days",
      "sourceText": "Du hast den Zug gefunden!",
      "sourceEnText": "You found the TRAIN!",
      "audioFile": "fr_03_01f76f3.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1724,
      "updatedAt": "2026-08-24T19:02:01Z",
      "textHash": "384d49255c2c0a4743ff61409f486e00942f236a6c6f17895dc0bb874dbaa28e"
    },
    {
      "key": "020d924",
      "nodeTitle": "book_5weeks",
      "sourceText": "Ein Ballon steigt auf, weil warme Luft leicht ist.",
      "sourceEnText": "A BALLOON rises because warm AIR is light.",
      "audioFile": "fr_03_020d924.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3187,
      "updatedAt": "2026-08-24T19:01:50Z",
      "textHash": "f5a36cad9260b933a8f1d4eeced90c49ef0a61838cdb6f0b9682f231268d523a"
    },
    {
      "key": "0210ef0",
      "nodeTitle": "npc_door",
      "sourceText": "Der blaue Hund rannte herum und hinterließ ein Chaos!",
      "sourceEnText": "That blue DOG was running and made a mess!",
      "audioFile": "fr_03_0210ef0.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3683,
      "updatedAt": "2026-08-24T19:00:40Z",
      "textHash": "ae3c6ac3c93fabe4857f43684b8d8f0da5e0417a6648b4964aaaf5964acc28d0"
    },
    {
      "key": "0245e0e",
      "nodeTitle": "museum_guide",
      "sourceText": "Ordne die Bücher ihren Fahrzeugen zu!",
      "sourceEnText": "Put the BOOKS together with their vehicles!",
      "audioFile": "fr_03_0245e0e.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2299,
      "updatedAt": "2026-08-24T19:01:01Z",
      "textHash": "9f379389eaf6c42a22de32e201daa4fb6f58af4b61b84f8550b8d5522bae6f88"
    },
    {
      "key": "0286510",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Du hast den Heißluftballon gefunden! Er wird auch Ballon genannt.",
      "sourceEnText": "You found the HOT AIR BALLOON!",
      "audioFile": "fr_03_0286510.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 4153,
      "updatedAt": "2026-08-24T19:01:40Z",
      "textHash": "bf30990dfccae863703765a3fac64d8fd2a16210f826b7b70de96ba111c35978"
    },
    {
      "key": "02e7812",
      "nodeTitle": "tutor_20000",
      "sourceText": "Könnten Sie das bitte beheben?",
      "sourceEnText": "Can you please fix it?",
      "audioFile": "fr_03_02e7812.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1724,
      "updatedAt": "2026-08-24T19:01:24Z",
      "textHash": "85a079089e52aa3aad4b52c449ed822ea4a00b414a5db79fd499e802063c9b34"
    },
    {
      "key": "03131e3",
      "nodeTitle": "book_80days",
      "sourceText": "Dieses Buch heißt „In 80 Tagen um die Welt“.",
      "sourceEnText": "This BOOK is \"Around the World in 80 Days.\"",
      "audioFile": "fr_03_03131e3.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3396,
      "updatedAt": "2026-08-24T18:59:30Z",
      "textHash": "c95947ba6163941aa05662558d5336924e23f8259c2530c10ad851427db530db"
    },
    {
      "key": "03536a1",
      "nodeTitle": "book_20000",
      "sourceText": "Dieses Buch heißt „20.000 Meilen unter dem Meer“.",
      "sourceEnText": "This BOOK is \"20,000 Leagues Under the Seas.\"",
      "audioFile": "fr_03_03536a1.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3553,
      "updatedAt": "2026-08-24T18:59:35Z",
      "textHash": "54b687c2fefae716ef5fb9c831c15c4958835565cb9427858e05208b856057bb"
    },
    {
      "key": "036574d",
      "nodeTitle": "tutor_80days",
      "sourceText": "Finde den ALTEN DAMPFZUG",
      "sourceEnText": "Find the OLD STEAM TRAIN",
      "audioFile": "fr_03_036574d.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2142,
      "updatedAt": "2026-08-24T19:02:07Z",
      "textHash": "2ade8df812ebfc0bfd7db874aeccff105d1a3fe27326faee631b0cb381551daf"
    },
    {
      "key": "0386706",
      "nodeTitle": "museum_guide",
      "sourceText": "Bitte sprechen Sie mit dem Wächter im ersten Raum.",
      "sourceEnText": "Please talk to the first room guardian.",
      "audioFile": "fr_03_0386706.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3135,
      "updatedAt": "2026-08-24T19:01:11Z",
      "textHash": "cf84c4bcecf5e0d198affbc681d67327033915e81f274a7ab481a14097bc9c8a"
    },
    {
      "key": "03af9a8",
      "nodeTitle": "tutor_20000",
      "sourceText": "Komm später wieder auf mich zurück.",
      "sourceEnText": "Come back to me later.",
      "audioFile": "fr_03_03af9a8.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2116,
      "updatedAt": "2026-08-24T19:01:56Z",
      "textHash": "c291cde38a945898d35c34394293c38ef001dc4217084f53a09e01baf867b9bd"
    },
    {
      "key": "03efbc0",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Finde die Weltraumrakete",
      "sourceEnText": "Find the SPACE ROCKET",
      "audioFile": "fr_03_03efbc0.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1776,
      "updatedAt": "2026-08-24T19:02:22Z",
      "textHash": "5be4140c3fe2d4a7c5f292df8c8db58e1a84022d4dcb9711cf1c809770b4eb56"
    },
    {
      "key": "05130c0",
      "nodeTitle": "train",
      "sourceText": "Züge beschleunigten lange Reisen.",
      "sourceEnText": "TRAINS made long trips faster.",
      "audioFile": "fr_03_05130c0.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2482,
      "updatedAt": "2026-08-24T19:02:14Z",
      "textHash": "13e33d6003b932b0d1b249e3ed96bab747f0412f4421cdbe10cce4903b9fac45"
    },
    {
      "key": "0525efc",
      "nodeTitle": "museum_guide",
      "sourceText": "Ein lustiger blauer HUND ist ins MUSEUM eingedrungen und hat ein Chaos angerichtet!",
      "sourceEnText": "A funny blue DOG entered the MUSEUM and made a mess!",
      "audioFile": "fr_03_0525efc.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 5642,
      "updatedAt": "2026-08-24T19:00:24Z",
      "textHash": "339c1b8e36b381186683be5d513854066abc1abf3c286e60308a74254676854b"
    },
    {
      "key": "056e79e",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Jules Verne erfand die Science-Fiction-Geschichten.",
      "sourceEnText": "Jules Verne invented science FICTION stories.",
      "audioFile": "fr_03_056e79e.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2952,
      "updatedAt": "2026-08-24T18:59:49Z",
      "textHash": "5baf6e1a2d3150a0ecc76cfa818be8c2b15b60f9411a19de078172e1793bd308"
    },
    {
      "key": "05bc5e9",
      "nodeTitle": "tutor_20000",
      "sourceText": "Falls Sie es nicht finden können, BENUTZEN SIE DIE KARTE",
      "sourceEnText": "If you can't find it, USE THE MAP",
      "audioFile": "fr_03_05bc5e9.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3370,
      "updatedAt": "2026-08-24T19:02:32Z",
      "textHash": "5cc31b2af32708d5bac921c180f1df1d09023fb30fd56df4c92a8e9f5feebc76"
    },
    {
      "key": "05e298d",
      "nodeTitle": "book_earthmoon",
      "sourceText": "Die Geschichte beinhaltet eine riesige Weltraumkanone zum Start der Rakete.",
      "sourceEnText": "The story has a huge space CANNON to launch the ROCKET",
      "audioFile": "fr_03_05e298d.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 5303,
      "updatedAt": "2026-08-24T19:02:38Z",
      "textHash": "ed9801f412051f0c406f82982764cfcc9dcad610e2ecbda9494c6cb25eb01069"
    },
    {
      "key": "0642734",
      "nodeTitle": "museum_guide",
      "sourceText": "Wir haben ein PROBLEM!",
      "sourceEnText": "We have a PROBLEM!",
      "audioFile": "fr_03_0642734.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1698,
      "updatedAt": "2026-08-24T19:00:21Z",
      "textHash": "7aefc5ba1687494869923f7dd5a39825cd86eb07c320dcb3fd18aff9a54e9df9"
    },
    {
      "key": "0666ee2",
      "nodeTitle": "tutor_20000",
      "sourceText": "Du hast das U-BOOT gefunden!",
      "sourceEnText": "You found the SUBMARINE!",
      "audioFile": "fr_03_0666ee2.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2534,
      "updatedAt": "2026-08-24T19:01:22Z",
      "textHash": "74c424f5b111243b09235e3433de57796a1a4586a2f92961754aa5c80fd3d7d4"
    },
    {
      "key": "06aef1a",
      "nodeTitle": "submarine",
      "sourceText": "Ein U-Boot fährt unter dem Meer.",
      "sourceEnText": "A SUBMARINE moves under the SEA.",
      "audioFile": "fr_03_06aef1a.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2299,
      "updatedAt": "2026-08-24T19:01:58Z",
      "textHash": "b506f77daf93464d650904007bb9996333e0e3ff701b12f4809cc4f598964a81"
    },
    {
      "key": "06b6d4d",
      "nodeTitle": "rocket",
      "sourceText": "Eine Rakete gibt alles, um die Erde zu verlassen.",
      "sourceEnText": "A ROCKET pushes hard to leave EARTH.",
      "audioFile": "fr_03_06b6d4d.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3135,
      "updatedAt": "2026-08-24T18:59:33Z",
      "textHash": "a8bfa79858a96287a9e96392e2145a1c33a84ef63d212add7f9d35ae63d08527"
    },
    {
      "key": "06e1473",
      "nodeTitle": "spawned_guide",
      "sourceText": "Viele Ideen aus seinen Büchern wurden Realität.",
      "sourceEnText": "Many ideas in his BOOKS became real.",
      "audioFile": "fr_03_06e1473.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 2900,
      "updatedAt": "2026-08-24T19:00:05Z",
      "textHash": "cc728cc838e250dd831cedc069aac2eaae5603f32f0a623ef8358ceb89489185"
    },
    {
      "key": "06fb1cd",
      "nodeTitle": "spawned_guide",
      "sourceText": "Nein, wer ist er?",
      "sourceEnText": "No, who is he?",
      "audioFile": "fr_03_06fb1cd.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1228,
      "updatedAt": "2026-08-24T19:00:15Z",
      "textHash": "0ed66f354aef65c157c48432374105f84aa8c8a30b9adc3515e9752a301c8cac"
    },
    {
      "key": "0757b30",
      "nodeTitle": "submarine_lost",
      "sourceText": "Großartig! Bring es nun zu seinem Hüter zurück.",
      "sourceEnText": "Great! Now bring it back to its guardian",
      "audioFile": "fr_03_0757b30.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3213,
      "updatedAt": "2026-08-24T19:01:37Z",
      "textHash": "4877c1fb70ec0e557533ada2f9e93f8f2b311a8cbe93c14476eb618ddbe0e067"
    },
    {
      "key": "07c4369",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Hilfe! Unsere wertvollste Maschine ist verschwunden!",
      "sourceEnText": "Help! Our most precious machine is missing!",
      "audioFile": "fr_03_07c4369.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3500,
      "updatedAt": "2026-08-24T19:02:19Z",
      "textHash": "2b80bcb5b599324edbb2c4839aa820972ddf984df7a3d34e8c57d4bba6325fac"
    },
    {
      "key": "07ee86b",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Die Rakete zum Mond sieht schnell aus.",
      "sourceEnText": "The ROCKET to the MOON looks fast.",
      "audioFile": "fr_03_07ee86b.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 2299,
      "updatedAt": "2026-08-24T19:00:00Z",
      "textHash": "055ee25c37a5d3093db3e3f64c8ec806d9229326106e70fc73ba85456a31f3ea"
    },
    {
      "key": "07f7b4b",
      "nodeTitle": "spawned_guide",
      "sourceText": "Ja, er ist SCHRIFTSTELLER!",
      "sourceEnText": "Yes, he is a WRITER!",
      "audioFile": "fr_03_07f7b4b.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1724,
      "updatedAt": "2026-08-24T19:00:13Z",
      "textHash": "d3749b910e32447db5dd613e9f32c55f2de165e44e56e5d485d4d21ec794e5b1"
    },
    {
      "key": "084486e",
      "nodeTitle": "activity_train_done",
      "sourceText": "Du hast alle Fahrzeuge gefunden!",
      "sourceEnText": "You found all the vehicles!",
      "audioFile": "fr_03_084486e.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2952,
      "updatedAt": "2026-08-24T19:02:30Z",
      "textHash": "f6d0744eaaa73a570bf5659e9be7bab06050d502cabfc121f065235c7b0bf25d"
    },
    {
      "key": "08669ce",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Das U-Boot Nautilus ist unglaublich.",
      "sourceEnText": "The SUBMARINE Nautilus is amazing.",
      "audioFile": "fr_03_08669ce.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 2612,
      "updatedAt": "2026-08-24T19:00:06Z",
      "textHash": "d7dfb8ed1bea1458aca289b28cc50bd75959c532b78bc25164149fffa703ebc1"
    },
    {
      "key": "087acef",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Als Aktivität im Unterricht könnt ihr ein U-Boot oder eine Rakete zeichnen!",
      "sourceEnText": "As classroom activity, you can DRAW a SUBMARINE or a ROCKET!",
      "audioFile": "fr_03_087acef.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4624,
      "updatedAt": "2026-08-24T19:00:27Z",
      "textHash": "cc66703d8b94d39db49c184809e11bb2276966d060303e606049ec741bd02fba"
    },
    {
      "key": "08cfbc0",
      "nodeTitle": "tutor_80days",
      "sourceText": "Hilfe! Wir haben den Zug verloren!",
      "sourceEnText": "Help! We lost the TRAIN!",
      "audioFile": "fr_03_08cfbc0.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2429,
      "updatedAt": "2026-08-24T19:02:04Z",
