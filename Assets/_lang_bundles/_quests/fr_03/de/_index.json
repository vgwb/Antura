      "textHash": "8c8bbf8619246d9eb9c561b71e7ecad8389ac09bd362033fa228d3bf7fc0298b"
    },
    {
      "key": "0c790cf",
      "nodeTitle": "spawned_guide",
      "sourceText": "Jules Verne war ein französischer Schriftsteller. Er wurde in der Nähe von hier geboren.",
      "sourceEnText": "Jules Verne was a French WRITER. He was born near here.",
      "audioFile": "fr_03_0c790cf.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 4571,
      "updatedAt": "2026-08-24T19:00:17Z",
      "textHash": "f0b21deb69c456263c4c3a863843b6d8e2fea1b377c9a2b1ade00e338a5e5e89"
    },
    {
      "key": "0c81640",
      "nodeTitle": "museum_guide",
      "sourceText": "Vielen Dank! Jetzt ist das MUSEUM in Ordnung.",
      "sourceEnText": "Thank you! Now the MUSEUM is in order",
      "audioFile": "fr_03_0c81640.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3213,
      "updatedAt": "2026-08-24T19:00:50Z",
      "textHash": "21a6ebeb3bf1aa370066c74d045541368ee16b333aa965092727a43f054eb7fe"
    },
    {
      "key": "0caca1b",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Jules Verne hat viele Bücher geschrieben!",
      "sourceEnText": "Jules Verne wrote many BOOKS!",
      "audioFile": "fr_03_0caca1b.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2560,
      "updatedAt": "2026-08-24T18:59:51Z",
      "textHash": "adde2bf0c7528e75e5f28646cd83dbb2e93e284be852038f497c3f5077342706"
    },
    {
      "key": "0cec96a",
      "nodeTitle": "npc_door",
      "sourceText": "Danke fürs Aufräumen!",
      "sourceEnText": "Thank you for cleaning up!",
      "audioFile": "fr_03_0cec96a.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1646,
      "updatedAt": "2026-08-24T19:00:35Z",
      "textHash": "af5009e5a79e28f89af89d24b7c1aa5f03b2822318bb5334e189586c7da5b2e4"
    },
    {
      "key": "0d2e2f0",
      "nodeTitle": "npc_door",
      "sourceText": "Das Museum ist jetzt geöffnet! Sprechen Sie mit dem Museumsführer!",
      "sourceEnText": "The Museum is now open! Talk to the MUSEUM GUIDE!",
      "audioFile": "fr_03_0d2e2f0.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4624,
      "updatedAt": "2026-08-24T19:00:38Z",
      "textHash": "63286be09ad078731c6abac2ec988b8ac35ca5b35b81acf107787cdb2cff8ecc"
    },
    {
      "key": "0d58543",
      "nodeTitle": "npc_door",
      "sourceText": "Bei diesem Chaos hier kann ich das MUSEUM nicht öffnen.",
      "sourceEnText": "I can't open the MUSEUM with this mess here.",
      "audioFile": "fr_03_0d58543.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3448,
      "updatedAt": "2026-08-24T19:00:43Z",
      "textHash": "f30fedcf95c74aaa70c024f829bf551e743f5f517c1eec64b93f0ffba0d59232"
    },
    {
      "key": "0dcb855",
      "nodeTitle": "book_20000",
      "sourceText": "Ein U-Boot fährt unter Wasser.",
      "sourceEnText": "A SUBMARINE travels UNDERWATER.",
      "audioFile": "fr_03_0dcb855.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1933,
      "updatedAt": "2026-08-24T18:59:38Z",
      "textHash": "502f29f9d2ad395dccc20de2795e61663fbf4b1dcc2283663c396ed6e6dd40ca"
    },
    {
      "key": "0de00ff",
      "nodeTitle": "rocket",
      "sourceText": "Das ist eine Weltraumrakete.",
      "sourceEnText": "This is a space ROCKET.",
      "audioFile": "fr_03_0de00ff.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1933,
      "updatedAt": "2026-08-24T19:02:27Z",
      "textHash": "4445099ae22c4278c34c46ce46ed847e2259c639c80c77bd2657e9f1888acc35"
    },
    {
      "key": "0e81901",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Mir gefällt die Geschichte über die WELT.",
      "sourceEnText": "I like the story about the WORLD.",
      "audioFile": "fr_03_0e81901.mp3",
      "voiceProfile": "johnny",
      "actorId": "KID_M",
      "durationMs": 2194,
      "updatedAt": "2026-08-24T18:59:56Z",
      "textHash": "c7d3f5f0383a4166b1abbaddfae727c83878e47517a2d0c72e450755c03ce2af"
    },
    {
      "key": "0e86b01",
      "nodeTitle": "activity_match_done",
      "sourceText": "Gut gemacht! Du hast alle BÜCHER den passenden FAHRZEUGEN zugeordnet.",
      "sourceEnText": "Well done! You matched all the BOOKS with their VEHICLES.",
      "audioFile": "fr_03_0e86b01.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 5042,
      "updatedAt": "2026-08-24T19:01:14Z",
      "textHash": "aa03a1e0be728bf17c28587052bdb83dd38cb9a851d4d61912ffe2da193e9fe6"
    },
    {
      "key": "0e928ab",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Hilfe! Irgendetwas fehlt!",
      "sourceEnText": "Help! Something is missing!",
      "audioFile": "fr_03_0e928ab.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T19:01:42Z",
      "textHash": "ee781075469fd4a9e6eac34a2764c328dc867254bd261ed75665844e4966cd26"
    },
    {
      "key": "0ee83b2",
      "nodeTitle": "activity_train_done",
      "sourceText": "Zurück zum Museumsführer!",
      "sourceEnText": "Go back to the MUSEUM GUIDE!",
      "audioFile": "fr_03_0ee83b2.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2011,
      "updatedAt": "2026-08-24T19:02:24Z",
      "textHash": "46afc3548efc28e9e7d3c0413667786ac3baa4259f8f97d7828906df6fda9ef0"
    },
    {
      "key": "0f5f36d",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Seine Bücher werden in vielen Sprachen gelesen!",
      "sourceEnText": "People read his BOOKS in many languages!",
      "audioFile": "fr_03_0f5f36d.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3082,
      "updatedAt": "2026-08-24T18:59:54Z",
      "textHash": "e353134c348cea049245c2061f938185efc24a1b5ded8775c8e3a2b78ad8ec6f"
    },
    {
      "key": "0f72ec7",
      "nodeTitle": "quest_end",
      "sourceText": "Wenn du mit deinen Eltern nach Nantes fährst, besucht unbedingt das Jules-Verne-Museum!",
      "sourceEnText": "If you go to Nantes with your parents, go to the Jules Verne Museum!",
      "audioFile": "fr_03_0f72ec7.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 5460,
      "updatedAt": "2026-08-24T19:00:32Z",
      "textHash": "0a4f019021b880ca290959587d9b5190c0ce463599af8ad1027e85b8657ba899"
