      "textHash": "512eb8608882eca95a38a62f10933aa7c00a2602bdaea8a97b8fa7a210b3ed61"
    },
    {
      "key": "0c52f3c",
      "nodeTitle": "museum_guide",
      "sourceText": "Das ist gut. Du bist noch nicht fertig, mach weiter!",
      "sourceEnText": "You are doing well!",
      "audioFile": "fr_03_0c52f3c.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3135,
