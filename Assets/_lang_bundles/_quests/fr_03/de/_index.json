    },
    {
      "key": "0b5e2f3",
      "nodeTitle": "quest_start",
      "sourceText": "Willkommen in Nantes. Besuchen Sie das Jules-Verne-Museum!",
      "sourceEnText": "Welcome to Nantes. Go and discover the Jules Verne Museum!",
      "audioFile": "fr_03_0b5e2f3.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3396,
      "updatedAt": "2026-08-24T18:59:17Z",
      "textHash": "b6e30453593bf359cc178e7375add0861c8b6888f9cd1aed4ed80937b4f49e39"
    },
    {
      "key": "0b5eb24",
      "nodeTitle": "task_clean_museum_done",
      "sourceText": "Perfekt. Jetzt ist das Museum sauber! Gehen Sie zurück zum Museumsführer.",
      "sourceEnText": "Perfect. Now the Museum is clean! Go back to the MUSEUM GUIDE.",
      "audioFile": "fr_03_0b5eb24.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 4937,
      "updatedAt": "2026-08-24T19:01:19Z",
      "textHash": "82ec842cf9d9677a58e959fe01384a167b219314ba20b8aef67626b1dd1031eb"
    },
    {
      "key": "0b7b198",
      "nodeTitle": "train",
      "sourceText": "Dieser alte Zug wurde mit Dampf angetrieben.",
      "sourceEnText": "This old TRAIN used STEAM to move.",
