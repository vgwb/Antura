    },
    {
      "key": "0907ccb",
      "nodeTitle": "book_earthmoon",
      "sourceText": "Jules Verne hat sich schon vor langer Zeit RAKETEN und Weltraumreisen ausgedacht.",
      "sourceEnText": "Jules Verne imagined ROCKETS and space TRAVEL long ago.",
