      "key": "07ee86b",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "La fusée va vite vers la LUNE.",
      "sourceEnText": "The ROCKET to the MOON looks fast.",
      "audioFile": "fr_03_07ee86b.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_M",
      "durationMs": 1698,
      "updatedAt": "2026-08-24T18:27:00Z",
      "textHash": "d861689b77ecb5248b8905ec21c009c31f6a1e1dacd3349e4ff37b8ab69bca97"
    },
    {
      "key": "07f7b4b",
      "nodeTitle": "spawned_guide",
      "sourceText": "Oui, c'est un ÉCRIVAIN !",
      "sourceEnText": "Yes, he is a WRITER!",
      "audioFile": "fr_03_07f7b4b.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 1280,
