    {
      "key": "0666ee2",
      "nodeTitle": "tutor_20000",
      "sourceText": "Tu as trouvé le SOUS-MARIN !",
      "sourceEnText": "You found the SUBMARINE!",
      "audioFile": "fr_03_0666ee2.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1593,
      "updatedAt": "2026-08-24T18:28:03Z",
      "textHash": "3dcade279b2adba7ef8f6ce09dd90450c724af3235fef85da325ce603ef8eb43"
    },
    {
      "key": "06aef1a",
      "nodeTitle": "submarine",
      "sourceText": "Un sous-marin va sous la mer.",
      "sourceEnText": "A SUBMARINE moves under the SEA.",
      "audioFile": "fr_03_06aef1a.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1515,
      "updatedAt": "2026-08-24T18:28:28Z",
      "textHash": "124637a41ed235a24011fbfd6c9359bd01eeae47ed4a3511cd13094ebcc809c4"
    },
    {
      "key": "06b6d4d",
      "nodeTitle": "rocket",
      "sourceText": "Une fusée pousse fort pour partir de la Terre.",
      "sourceEnText": "A ROCKET pushes hard to leave EARTH.",
      "audioFile": "fr_03_06b6d4d.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2429,
