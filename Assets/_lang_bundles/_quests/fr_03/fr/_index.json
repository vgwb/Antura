      "textHash": "80f04619df30af0c0df046594c6b7f30236fb1abdf4ffe4139f509812552f131"
    },
    {
      "key": "06e1473",
      "nodeTitle": "spawned_guide",
      "sourceText": "Beaucoup des idées de Jules Verne sont vraies maintenant.",
      "sourceEnText": "Many ideas in his BOOKS became real.",
      "audioFile": "fr_03_06e1473.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 2664,
      "updatedAt": "2026-08-24T18:27:04Z",
      "textHash": "8cebe505bcfac486c182891da902b1fa9c7d2feacaebab628d9fb702ad861d6e"
    },
    {
      "key": "06fb1cd",
      "nodeTitle": "spawned_guide",
      "sourceText": "Non, qui est-ce ?",
      "sourceEnText": "No, who is he?",
      "audioFile": "fr_03_06fb1cd.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 1097,
      "updatedAt": "2026-08-24T18:27:13Z",
      "textHash": "bd6d3f87d7b2b0eaea7e313310cd6efa7147566f041649e24b4da2b6ae6ead62"
    },
    {
      "key": "0757b30",
      "nodeTitle": "submarine_lost",
      "sourceText": "Super ! Maintenant, donne-le à son gardien.",
      "sourceEnText": "Great! Now bring it back to its guardian",
      "audioFile": "fr_03_0757b30.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2377,
      "updatedAt": "2026-08-24T18:28:14Z",
      "textHash": "d27646f578daf03cedf806234606e9623ab69619dfbddc538fbbbc7b7c9d900e"
    },
    {
      "key": "07c4369",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Au secours ! Notre plus belle machine a disparu !",
      "sourceEnText": "Help! Our most precious machine is missing!",
      "audioFile": "fr_03_07c4369.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2717,
      "updatedAt": "2026-08-24T18:28:43Z",
      "textHash": "52b440317d66442fa9740e5cc34688e759b9427887a43a6d2b5c9c857af21d68"
