    {
      "key": "0386706",
      "nodeTitle": "museum_guide",
      "sourceText": "Va voir le gardien de la première salle.",
      "sourceEnText": "Please talk to the first room guardian.",
      "audioFile": "fr_03_0386706.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2194,
      "updatedAt": "2026-08-24T18:27:55Z",
      "textHash": "3471a0a238ff5a8e6c12eb94e0f3c46df9107f375fcceadfd82c8d753c16acec"
