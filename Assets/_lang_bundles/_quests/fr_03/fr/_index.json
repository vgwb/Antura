      "textHash": "4be420c4696360ae7e4d130588cb57be3881394a7e85b4466340721aa3a35a39"
    },
    {
      "key": "00b1d04",
      "nodeTitle": "spawned_guide",
      "sourceText": "Savez-vous qui est Jules Verne ?",
      "sourceEnText": "Do you know who Jules Verne is?",
      "audioFile": "fr_03_00b1d04.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 1724,
      "updatedAt": "2026-08-24T18:27:10Z",
      "textHash": "72e401904f5b81728424bb87a45fe346c709d5a40f68fb78892a1139b676300b"
    },
    {
      "key": "00be1f0",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Je veux faire un tour en ballon un jour.",
      "sourceEnText": "I want to ride a BALLOON one day.",
      "audioFile": "fr_03_00be1f0.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_M",
      "durationMs": 1933,
      "updatedAt": "2026-08-24T18:26:58Z",
      "textHash": "7c59dd06824a25c26be7ad176963ca06e3a7bbb73736565fe114924481c3d257"
    },
    {
      "key": "00eefe0",
      "nodeTitle": "activity_match_done",
      "sourceText": "Maintenant, Tout est prêt pour les visiteurs !",
      "sourceEnText": "Now everything is ready for the visitors!",
      "audioFile": "fr_03_00eefe0.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2351,
      "updatedAt": "2026-08-24T18:27:59Z",
      "textHash": "4fc5ebdbff0af74d8270c35c4a989e14029a28f75b1acd1ac26b80d73ba7cf8d"
    },
    {
      "key": "00f3a57",
      "nodeTitle": "spawned_visitor",
      "sourceText": "J'adore lire des LIVRES !",
      "sourceEnText": "I love reading BOOKS!",
      "audioFile": "fr_03_00f3a57.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1411,
      "updatedAt": "2026-08-24T18:26:48Z",
      "textHash": "721ba2868b7575f6458b112c7899d3dac220c4ff1e5039cee3203066366caa6e"
    },
    {
      "key": "0131b99",
      "nodeTitle": "balloon",
      "sourceText": "Un BALLON monte grâce à l'AIR chaud.",
      "sourceEnText": "A BALLOON goes up with warm AIR.",
      "audioFile": "fr_03_0131b99.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2142,
      "updatedAt": "2026-08-24T18:26:45Z",
      "textHash": "58e99c2cbf1bc36a46173e26a93a25b927a32b08c691ce9ce0e168b92cf2ae14"
    },
    {
      "key": "0174104",
      "nodeTitle": "quest_end",
      "sourceText": "Maintenant, tu connais Jules Verne et ses LIVRES !",
      "sourceEnText": "Now you know about Jules Verne and his BOOKS!",
      "audioFile": "fr_03_0174104.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-08-24T18:26:31Z",
      "textHash": "0cb1a697f98836de46abe775eb964540d7b41ab0b826ace42e3d8e07cf5baad7"
    },
    {
      "key": "01a9d0f",
      "nodeTitle": "npc_door",
      "sourceText": "Aidez-moi à nettoyer le trottoir !",
      "sourceEnText": "Help me clean the sidewalk!",
      "audioFile": "fr_03_01a9d0f.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1724,
      "updatedAt": "2026-08-24T18:27:36Z",
      "textHash": "ebe6bb52e8d1f676ca46bb09853a4988ffbe71c29d9a2c75e75c59c2895f542b"
    },
    {
      "key": "01f76f3",
      "nodeTitle": "tutor_80days",
      "sourceText": "Tu as trouvé le TRAIN !",
      "sourceEnText": "You found the TRAIN!",
      "audioFile": "fr_03_01f76f3.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1280,
      "updatedAt": "2026-08-24T18:28:30Z",
      "textHash": "3a2bc899d0d8b98dedb05c47b9c3710389d1d6d5c4104622eb744d527bc5f721"
    },
    {
      "key": "020d924",
      "nodeTitle": "book_5weeks",
      "sourceText": "Un BALLON monte car l'AIR chaud est léger.",
      "sourceEnText": "A BALLOON rises because warm AIR is light.",
      "audioFile": "fr_03_020d924.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2429,
      "updatedAt": "2026-08-24T18:28:23Z",
      "textHash": "26f5a93b22b211e6aa484d99d2eeb63c33bc4a6ae23109b3cd11021c331eec70"
    },
    {
      "key": "0210ef0",
      "nodeTitle": "npc_door",
      "sourceText": "Ce chien bleu courait et il a fait des bêtises !",
      "sourceEnText": "That blue DOG was running and made a mess!",
      "audioFile": "fr_03_0210ef0.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2560,
      "updatedAt": "2026-08-24T18:27:32Z",
      "textHash": "c5f5943b2cb65c047f5dafad777e5cdd3d35def7493e93ad9f6a83b6107932c2"
    },
    {
      "key": "0245e0e",
      "nodeTitle": "museum_guide",
      "sourceText": "Mets ensemble les LIVRES avec leurs véhicules !",
      "sourceEnText": "Put the BOOKS together with their vehicles!",
      "audioFile": "fr_03_0245e0e.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2664,
      "updatedAt": "2026-08-24T18:27:47Z",
      "textHash": "64770ba8579e8c48780625fe306be15ba431865535cc7cc159b7431a5a04cc9b"
    },
    {
      "key": "0286510",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Tu as trouvé la MONTGOLFIÈRE ! On l'appelle aussi un ballon.",
      "sourceEnText": "You found the HOT AIR BALLOON!",
      "audioFile": "fr_03_0286510.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2978,
      "updatedAt": "2026-08-24T18:28:16Z",
      "textHash": "93f3019e01055b43dc270aa1b35dad498600fe9d17263daae18070d6e6ec5b66"
    },
    {
      "key": "02e7812",
      "nodeTitle": "tutor_20000",
      "sourceText": "Peux-tu le réparer, s'il te plaît ?",
      "sourceEnText": "Can you please fix it?",
      "audioFile": "fr_03_02e7812.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T18:28:05Z",
      "textHash": "8a877819ee7d0c7d06512025276fa879ce55c62c43bce0057bb4d52a4d57e027"
    },
    {
      "key": "03131e3",
      "nodeTitle": "book_80days",
      "sourceText": "Ce livre s'appelle « Le tour du monde en 80 jours ».",
      "sourceEnText": "This BOOK is \"Around the World in 80 Days.\"",
      "audioFile": "fr_03_03131e3.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 3082,
      "updatedAt": "2026-08-24T18:26:38Z",
      "textHash": "3f9b7956a86e2beaaa870fcbd0105b2963f90436ab63f7b7ead8cffe40dd2f53"
    },
    {
      "key": "03536a1",
      "nodeTitle": "book_20000",
      "sourceText": "Ce livre s'appelle « Vingt mille lieues sous les mers ».",
      "sourceEnText": "This BOOK is \"20,000 Leagues Under the Seas.\"",
      "audioFile": "fr_03_03536a1.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 6844,
      "updatedAt": "2026-08-24T18:26:42Z",
      "textHash": "e99b80fc63847f148e8b2977d61aace0bbeffa1f5177c6cb8d620c360b14460a"
    },
    {
      "key": "036574d",
      "nodeTitle": "tutor_80days",
      "sourceText": "Trouve le vieux train à vapeur",
      "sourceEnText": "Find the OLD STEAM TRAIN",
      "audioFile": "fr_03_036574d.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1515,
      "updatedAt": "2026-08-24T18:28:34Z",
      "textHash": "099d1a878ece3a42151fa84824feca52bc0b94323a414496ce6c15aa6c712105"
