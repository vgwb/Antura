    {
      "key": "03af9a8",
      "nodeTitle": "tutor_20000",
      "sourceText": "Reviens me voir plus tard.",
      "sourceEnText": "Come back to me later.",
      "audioFile": "fr_03_03af9a8.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1358,
      "updatedAt": "2026-08-24T18:28:27Z",
      "textHash": "c8296e0fb70cda339bafdb3b5ab1ad25e30c621415aaace59219b09ad735f0d6"
    },
    {
      "key": "03efbc0",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Trouve la FUSÉE",
      "sourceEnText": "Find the SPACE ROCKET",
      "audioFile": "fr_03_03efbc0.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1045,
      "updatedAt": "2026-08-24T18:28:44Z",
      "textHash": "ec2f848789a39a89e6e04061be519c7dd04f5bcba4a0f923bc95a4f609b10aed"
    },
    {
      "key": "05130c0",
      "nodeTitle": "train",
      "sourceText": "Avec les trains on allait plus vite.",
      "sourceEnText": "TRAINS made long trips faster.",
      "audioFile": "fr_03_05130c0.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T18:28:39Z",
      "textHash": "8489f51dbaebbeff8f77360109819322d924b320e25c0ec3d60dfd9919cac25f"
    },
    {
      "key": "0525efc",
      "nodeTitle": "museum_guide",
      "sourceText": "Un drôle de chien bleu est entré dans le musée et a fait des bêtises !",
      "sourceEnText": "A funny blue DOG entered the MUSEUM and made a mess!",
      "audioFile": "fr_03_0525efc.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 3448,
      "updatedAt": "2026-08-24T18:27:20Z",
      "textHash": "318255e28c0376f06793ce332a175531ef12b379e26b81608aec56985b563fea"
    },
    {
      "key": "056e79e",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Jules Verne a inventé les histoires de science-fiction.",
      "sourceEnText": "Jules Verne invented science FICTION stories.",
      "audioFile": "fr_03_056e79e.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 3265,
      "updatedAt": "2026-08-24T18:26:50Z",
      "textHash": "5921325baa58f3db3a86842e79cf5668c6edba27cd90f51accb46034ef12f133"
    },
    {
      "key": "05bc5e9",
      "nodeTitle": "tutor_20000",
      "sourceText": "Si tu ne le trouves pas, VA VOIR LA CARTE",
      "sourceEnText": "If you can't find it, USE THE MAP",
      "audioFile": "fr_03_05bc5e9.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2299,
      "updatedAt": "2026-08-24T18:28:52Z",
      "textHash": "ccebffc812f6911c0d3b499ab3709fbba186d33a9194b5ae9dfde23eca11105c"
    },
    {
      "key": "05e298d",
      "nodeTitle": "book_earthmoon",
      "sourceText": "L'histoire parle d'un très gros CANON qui lance la FUSÉE.",
      "sourceEnText": "The story has a huge space CANNON to launch the ROCKET",
      "audioFile": "fr_03_05e298d.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 3082,
      "updatedAt": "2026-08-24T18:28:56Z",
      "textHash": "2d97de6968c71c8177e4a5b96f356d679bfd09239bacf5b9f35543ca8ca9308f"
    },
    {
      "key": "0642734",
      "nodeTitle": "museum_guide",
      "sourceText": "Nous avons un PROBLÈME !",
      "sourceEnText": "We have a PROBLEM!",
      "audioFile": "fr_03_0642734.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1515,
      "updatedAt": "2026-08-24T18:27:19Z",
