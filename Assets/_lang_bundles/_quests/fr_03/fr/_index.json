      "key": "08669ce",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Le sous-marin Nautilus est incroyable.",
      "sourceEnText": "The SUBMARINE Nautilus is amazing.",
      "audioFile": "fr_03_08669ce.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_M",
      "durationMs": 2142,
