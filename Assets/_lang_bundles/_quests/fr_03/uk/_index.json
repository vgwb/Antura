{
  "version": "1",
  "questId": "fr_03",
  "lang": "uk",
  "lines": [
    {
      "key": "003b311",
      "nodeTitle": "verne_house",
      "sourceText": "Жюль Верн народився тут, у Нанті.",
      "sourceEnText": "Jules Verne was born here in NANTES.",
      "audioFile": "fr_03_003b311.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3370,
      "updatedAt": "2026-08-25T00:39:21Z",
      "textHash": "4c3f14cfae315ecc1bec4a7fe4ca52358061d24b699cf0d2f511637942b5c114"
    },
    {
      "key": "006e7fc",
      "nodeTitle": "quest_start",
      "sourceText": "Хто такий Жюль Верн? І куди він подорожував?",
      "sourceEnText": "Who is Jules Verne? And where did he travel?",
      "audioFile": "fr_03_006e7fc.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 3135,
      "updatedAt": "2026-08-25T00:39:46Z",
      "textHash": "95e583f93c362ae9c184a613638249521412c8a15aee19bc8ef623f00a723326"
    },
    {
      "key": "00a6154",
      "nodeTitle": "tutor_20000",
      "sourceText": "Допоможіть! \"Наутілус\" зник!",
      "sourceEnText": "Help! The Nautilus is missing!",
      "audioFile": "fr_03_00a6154.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3082,
      "updatedAt": "2026-08-25T00:40:30Z",
      "textHash": "153b2f133c58326af06fc6ca0c5954007c159a0f1e86a0db6e61c56fde744c34"
    },
    {
      "key": "00b1d04",
      "nodeTitle": "spawned_guide",
      "sourceText": "Чи знаєте ви, хто такий Жюль Верн?",
      "sourceEnText": "Do you know who Jules Verne is?",
      "audioFile": "fr_03_00b1d04.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_M",
      "durationMs": 2429,
      "updatedAt": "2026-08-25T00:39:48Z",
      "textHash": "1addb9bfe62323f0dd8de0d9c6db9fe073dbbcbc5902409752bfd36e970e2805"
    },
    {
      "key": "00be1f0",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Я хочу одного дня політати на повітряній кулі.",
      "sourceEnText": "I want to ride a BALLOON one day.",
      "audioFile": "fr_03_00be1f0.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 3135,
      "updatedAt": "2026-08-25T00:39:39Z",
      "textHash": "51fb92281393f783361641caabc0c9d3a5978164ad6c080862b4d9816e86d1d5"
    },
    {
      "key": "00eefe0",
      "nodeTitle": "activity_match_done",
      "sourceText": "Тепер все готове для відвідувачів!",
      "sourceEnText": "Now everything is ready for the visitors!",
      "audioFile": "fr_03_00eefe0.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2560,
      "updatedAt": "2026-08-25T00:40:24Z",
      "textHash": "103e2d27cfc23c4bf2bd65ea4a7a72ebf94bb3e76753f38ba93fffbb2972474f"
    },
    {
      "key": "00f3a57",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Я люблю читати КНИГИ!",
      "sourceEnText": "I love reading BOOKS!",
      "audioFile": "fr_03_00f3a57.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 1881,
      "updatedAt": "2026-08-25T00:39:32Z",
      "textHash": "e1f230ca4c319abb07e465d27683806ff15b21e2ade7babaa05a0bd345dd8ac9"
    },
    {
      "key": "0131b99",
      "nodeTitle": "balloon",
      "sourceText": "ПОВІТРЯНА КУЛЯ злітає вгору з теплим ПОВІТРЯМ.",
      "sourceEnText": "A BALLOON goes up with warm AIR.",
      "audioFile": "fr_03_0131b99.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3918,
      "updatedAt": "2026-08-25T00:39:29Z",
      "textHash": "d52a32ec25e59ae1dd72df3c50934e1d9e0d11df95d8c7fd717e96486759ec9b"
    },
    {
      "key": "0174104",
      "nodeTitle": "quest_end",
      "sourceText": "Тепер ви знаєте про Жуля Верна та його КНИГИ!",
      "sourceEnText": "Now you know about Jules Verne and his BOOKS!",
      "audioFile": "fr_03_0174104.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 3213,
      "updatedAt": "2026-08-25T00:39:18Z",
      "textHash": "48d52fb329d53d59eef9cdd0f006ced50a0ac0a651f9e183e965307215ca93e0"
    },
    {
      "key": "01a9d0f",
      "nodeTitle": "npc_door",
      "sourceText": "Допоможіть мені почистити тротуар!",
      "sourceEnText": "Help me clean the sidewalk!",
      "audioFile": "fr_03_01a9d0f.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 2900,
      "updatedAt": "2026-08-25T00:40:07Z",
      "textHash": "64887d93d3473fbfa59a3464f2534b984785a2ad6a0c1ac23932b9220889e47c"
    },
    {
      "key": "01f76f3",
      "nodeTitle": "tutor_80days",
      "sourceText": "Ви знайшли ПОЇЗД!",
      "sourceEnText": "You found the TRAIN!",
      "audioFile": "fr_03_01f76f3.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 1646,
      "updatedAt": "2026-08-25T00:40:48Z",
      "textHash": "40af73dad15fa09a225710abc2132432d2003ccd957fddbf23d5c1ebd50181d9"
    },
    {
      "key": "020d924",
      "nodeTitle": "book_5weeks",
      "sourceText": "ПОВІТРЯНА КУЛЯ піднімається, тому що тепле ПОВІТРЯ легке.",
      "sourceEnText": "A BALLOON rises because warm AIR is light.",
      "audioFile": "fr_03_020d924.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 4519,
      "updatedAt": "2026-08-25T00:40:43Z",
      "textHash": "b2b288dd8b2cba5126b3b9735fd67227554226b42aca9dfb21ffeee2e8b1e89b"
    },
    {
      "key": "0210ef0",
      "nodeTitle": "npc_door",
      "sourceText": "Той синій СОБАКА бігав і влаштував безлад!",
      "sourceEnText": "That blue DOG was running and made a mess!",
      "audioFile": "fr_03_0210ef0.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 3736,
      "updatedAt": "2026-08-25T00:40:04Z",
      "textHash": "ff6ff3d9d13d56f7b1a49b7f4d27924d8c936ae42f0ba05dc8453493719aaa56"
    },
    {
      "key": "0245e0e",
      "nodeTitle": "museum_guide",
      "sourceText": "Зберіть КНИГИ разом з їхніми транспортними засобами!",
      "sourceEnText": "Put the BOOKS together with their vehicles!",
      "audioFile": "fr_03_0245e0e.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 4153,
      "updatedAt": "2026-08-25T00:40:16Z",
      "textHash": "9a83775cb441133211823725b50a30890f992b6b1d0406c188ea27330f715c3f"
    },
    {
      "key": "0286510",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Ви знайшли ПОВІТРЯНУ КУЛЮ! Її також називають повітряною кулькою.",
      "sourceEnText": "You found the HOT AIR BALLOON!",
      "audioFile": "fr_03_0286510.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 5172,
      "updatedAt": "2026-08-25T00:40:37Z",
      "textHash": "e17010fbb74670d2f894b0d1d480457ea334f3ea143f9940e27ee2543e148c0c"
    },
    {
      "key": "02e7812",
      "nodeTitle": "tutor_20000",
      "sourceText": "Чи можете ви це виправити?",
      "sourceEnText": "Can you please fix it?",
      "audioFile": "fr_03_02e7812.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 1776,
      "updatedAt": "2026-08-25T00:40:28Z",
      "textHash": "01f87e7cf745b84b0c21c4049aaba69756a3f448074753767701c9656fb9e3bf"
    },
    {
      "key": "03131e3",
      "nodeTitle": "book_80days",
      "sourceText": "Ця КНИГА називається «Навколо світу за 80 днів».",
      "sourceEnText": "This BOOK is \"Around the World in 80 Days.\"",
      "audioFile": "fr_03_03131e3.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 4206,
      "updatedAt": "2026-08-25T00:39:23Z",
      "textHash": "cf17319ab58530f0327f99008bfecf95d6211608ba858a6bfb99aa6b1f8bf5c4"
    },
    {
      "key": "03536a1",
      "nodeTitle": "book_20000",
      "sourceText": "Ця КНИГА називається «20 000 льє під водою».",
      "sourceEnText": "This BOOK is \"20,000 Leagues Under the Seas.\"",
      "audioFile": "fr_03_03536a1.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3683,
      "updatedAt": "2026-08-25T00:39:26Z",
      "textHash": "b492ba9a537ddd987fe72cd70508c89ff4f0bff6b8bd650177d986353a84c840"
    },
    {
      "key": "036574d",
      "nodeTitle": "tutor_80days",
      "sourceText": "Знайдіть СТАРИЙ ПАРОВІЗ",
      "sourceEnText": "Find the OLD STEAM TRAIN",
      "audioFile": "fr_03_036574d.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2194,
      "updatedAt": "2026-08-25T00:40:51Z",
      "textHash": "13b4d2c88e11ba6e2c3a0077e204d293bd557f1c094316c757289d08e2d57508"
    },
    {
      "key": "0386706",
      "nodeTitle": "museum_guide",
      "sourceText": "Будь ласка, поговоріть з першим охоронцем кімнати.",
      "sourceEnText": "Please talk to the first room guardian.",
      "audioFile": "fr_03_0386706.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3866,
      "updatedAt": "2026-08-25T00:40:21Z",
      "textHash": "f96f460f351afa704faf897a3143cbbe663122279dcb964c294b9f6b7826f260"
    },
    {
      "key": "03af9a8",
      "nodeTitle": "tutor_20000",
      "sourceText": "Повернися до мене пізніше.",
      "sourceEnText": "Come back to me later.",
      "audioFile": "fr_03_03af9a8.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2299,
      "updatedAt": "2026-08-25T00:40:45Z",
      "textHash": "ec2b5cb35784aa85446a89e561d13ec9e47b4be828a91e643bda7c41222582b2"
    },
    {
      "key": "03efbc0",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Знайдіть КОСМІЧНУ РАКЕТУ",
      "sourceEnText": "Find the SPACE ROCKET",
      "audioFile": "fr_03_03efbc0.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2534,
      "updatedAt": "2026-08-25T00:40:59Z",
      "textHash": "2e70323ae66209835cdaa5ed63aa84208e850cdc9f3b44d53392e0d69d13d69b"
    },
    {
      "key": "05130c0",
      "nodeTitle": "train",
      "sourceText": "ПОЇЗДИ робили далекі поїздки швидшими.",
      "sourceEnText": "TRAINS made long trips faster.",
      "audioFile": "fr_03_05130c0.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3553,
      "updatedAt": "2026-08-25T00:40:55Z",
      "textHash": "e50c0fa8a7af50e2473ee0d0776cf7ff00ba1bdc9374f329704d3bba0ae68a75"
    },
    {
      "key": "0525efc",
      "nodeTitle": "museum_guide",
      "sourceText": "Кумедний синій СОБАКА зайшов до МУЗЕЮ та влаштував безлад!",
      "sourceEnText": "A funny blue DOG entered the MUSEUM and made a mess!",
      "audioFile": "fr_03_0525efc.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 4650,
      "updatedAt": "2026-08-25T00:39:56Z",
      "textHash": "3acf975d84ee8daea832d6b0d21442093bb1d8c1c882bed3da331acdb98c62b2"
    },
    {
      "key": "056e79e",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Жуль Верн вигадав науково-фантастичні історії.",
      "sourceEnText": "Jules Verne invented science FICTION stories.",
      "audioFile": "fr_03_056e79e.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 3866,
      "updatedAt": "2026-08-25T00:39:33Z",
      "textHash": "fa5990c3054d39d868053d739dff326c382fa0933800c31a387368aafdcf21dc"
    },
    {
      "key": "05bc5e9",
      "nodeTitle": "tutor_20000",
      "sourceText": "Якщо ви не можете знайти, СКОРИСТАЙТЕСЯ КАРТОЮ",
      "sourceEnText": "If you can't find it, USE THE MAP",
      "audioFile": "fr_03_05bc5e9.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3866,
      "updatedAt": "2026-08-25T00:41:04Z",
      "textHash": "8182614aeef05a006f1fbabb07338de12bc01dad9b67365bd10a9816349b4a6f"
    },
    {
      "key": "05e298d",
      "nodeTitle": "book_earthmoon",
      "sourceText": "У сюжеті є величезна космічна ГАРМАТА для запуску РАКЕТИ",
      "sourceEnText": "The story has a huge space CANNON to launch the ROCKET",
      "audioFile": "fr_03_05e298d.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 4624,
      "updatedAt": "2026-08-25T00:41:07Z",
      "textHash": "043019d0538ed997e79fec759f923a7ea5f3dc7c38e847974009e8da5e91c7ae"
    },
    {
      "key": "0642734",
      "nodeTitle": "museum_guide",
      "sourceText": "У нас ПРОБЛЕМА!",
      "sourceEnText": "We have a PROBLEM!",
      "audioFile": "fr_03_0642734.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 1515,
      "updatedAt": "2026-08-25T00:39:54Z",
      "textHash": "591e4adc84afbb15ac2d2a2131307c14b6d7ff716f72847c65838dcc69ce7a0e"
    },
    {
      "key": "0666ee2",
      "nodeTitle": "tutor_20000",
      "sourceText": "Ви знайшли ПІДВОДНИЙ ЧОВЕН!",
      "sourceEnText": "You found the SUBMARINE!",
      "audioFile": "fr_03_0666ee2.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2351,
      "updatedAt": "2026-08-25T00:40:27Z",
      "textHash": "f0bd47137509604db3d3da7a10d7aee0284e126a048575cf59e9be4e463c0f64"
    },
    {
      "key": "06aef1a",
      "nodeTitle": "submarine",
      "sourceText": "ПІДВОДНИЙ СУД рухається під водою.",
      "sourceEnText": "A SUBMARINE moves under the SEA.",
      "audioFile": "fr_03_06aef1a.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3396,
      "updatedAt": "2026-08-25T00:40:47Z",
      "textHash": "3718c7729aa1f5b630d63f2fac728267c52b60a7593eda6f53cf4f1494db4e17"
    },
    {
      "key": "06b6d4d",
      "nodeTitle": "rocket",
      "sourceText": "РАКЕТА з силою відривається від ЗЕМЛІ.",
      "sourceEnText": "A ROCKET pushes hard to leave EARTH.",
      "audioFile": "fr_03_06b6d4d.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3918,
      "updatedAt": "2026-08-25T00:39:25Z",
      "textHash": "7c4cd2a7c83a281c81a1fefd7919254a2e6636ebdecdde630bab0296d67aa2a5"
    },
    {
      "key": "06e1473",
      "nodeTitle": "spawned_guide",
      "sourceText": "Багато ідей у ​​його КНИГАХ стали реальністю.",
      "sourceEnText": "Many ideas in his BOOKS became real.",
      "audioFile": "fr_03_06e1473.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_M",
      "durationMs": 3788,
      "updatedAt": "2026-08-25T00:39:43Z",
      "textHash": "661c9d3d7425541f890b283f3ee669b135fca34fd76a64ecfc1891b4e22ca6cb"
    },
    {
      "key": "06fb1cd",
      "nodeTitle": "spawned_guide",
      "sourceText": "Ні, а хто він?",
      "sourceEnText": "No, who is he?",
      "audioFile": "fr_03_06fb1cd.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_M",
      "durationMs": 1541,
      "updatedAt": "2026-08-25T00:39:50Z",
      "textHash": "f4fbaab0468dfb77adc7dd0b7c8ce5297f37a027a2e7b8c89614d3d61875dc59"
    },
    {
      "key": "0757b30",
      "nodeTitle": "submarine_lost",
      "sourceText": "Чудово! А тепер поверніть його охоронцю.",
      "sourceEnText": "Great! Now bring it back to its guardian",
      "audioFile": "fr_03_0757b30.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3500,
      "updatedAt": "2026-08-25T00:40:35Z",
      "textHash": "b6062dcf6f02283d38e5c412eca95604599cfbab6dc1adc237d26055e3c488aa"
    },
    {
      "key": "07c4369",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Допоможіть! Наша найцінніша машина зникла!",
      "sourceEnText": "Help! Our most precious machine is missing!",
      "audioFile": "fr_03_07c4369.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 4049,
      "updatedAt": "2026-08-25T00:40:57Z",
      "textHash": "40ecbd29777f195189c1dfeec9129411ac2500b1c98dd99177d8b7f4ec4c70b4"
    },
    {
      "key": "07ee86b",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "РАКЕТА на МІСЯЦЬ виглядає швидкою.",
      "sourceEnText": "The ROCKET to the MOON looks fast.",
      "audioFile": "fr_03_07ee86b.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 2664,
      "updatedAt": "2026-08-25T00:39:40Z",
      "textHash": "36391db2f4f1b980eb23d6a1058abf79117eeb9c28e058056ab0b7b9bc5a8b94"
    },
    {
      "key": "07f7b4b",
      "nodeTitle": "spawned_guide",
      "sourceText": "Так, він ПИСЬМЕННИК!",
      "sourceEnText": "Yes, he is a WRITER!",
      "audioFile": "fr_03_07f7b4b.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_M",
      "durationMs": 1541,
      "updatedAt": "2026-08-25T00:39:49Z",
      "textHash": "264e12c8c5de532c6967f7951824e51418672f6ef9c265d8066aabd634325c51"
    },
    {
      "key": "084486e",
      "nodeTitle": "activity_train_done",
      "sourceText": "Ви знайшли всі транспортні засоби!",
      "sourceEnText": "You found all the vehicles!",
      "audioFile": "fr_03_084486e.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3500,
      "updatedAt": "2026-08-25T00:41:03Z",
      "textHash": "5d7694dfd71e4813e944464e70cd233ba5119f7f30a2699f40f6e1cd49979317"
    },
    {
      "key": "08669ce",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Підводний човен \"Наутілус\" неймовірний.",
      "sourceEnText": "The SUBMARINE Nautilus is amazing.",
      "audioFile": "fr_03_08669ce.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 3265,
      "updatedAt": "2026-08-25T00:39:45Z",
      "textHash": "0216c29cad36a3e5a3488849a908bd7442b58e5e12b4169b56cc513ca67adb03"
    },
    {
      "key": "087acef",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Як класну роботу, ви можете НАМАЛЮВАТИ ПІДВОДНИЙ ЧОВЕН або РАКЕТУ!",
      "sourceEnText": "As classroom activity, you can DRAW a SUBMARINE or a ROCKET!",
      "audioFile": "fr_03_087acef.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 6191,
      "updatedAt": "2026-08-25T00:39:57Z",
      "textHash": "809e97d6a85b42f6bbce6388b0b70e795c5f1060ea779660fedb4b094dd150ff"
    },
    {
      "key": "08cfbc0",
      "nodeTitle": "tutor_80days",
      "sourceText": "Допоможіть! Ми втратили ПОЇЗД!",
      "sourceEnText": "Help! We lost the TRAIN!",
      "audioFile": "fr_03_08cfbc0.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3370,
      "updatedAt": "2026-08-25T00:40:49Z",
      "textHash": "bd6f91b522e34013c6ad85ec6f872482c7af7ceabd8a5620feadf610a8ad8833"
    },
    {
      "key": "08f0d37",
      "nodeTitle": "quest_end",
      "sourceText": "Квест завершено! Вітаємо!",
      "sourceEnText": "The quest is complete! Congratulations!",
      "audioFile": "fr_03_08f0d37.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 2560,
      "updatedAt": "2026-08-25T00:40:11Z",
      "textHash": "c9a21e2a4a0356f30ada4c9fb62e6f7725efcefc603cf4c0cd8323d2768f2423"
    },
    {
      "key": "08fed68",
      "nodeTitle": "tutor_earthmoon",
      "sourceText": "Ви знайшли РАКЕТУ!",
      "sourceEnText": "You found the ROCKET!",
      "audioFile": "fr_03_08fed68.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 1724,
      "updatedAt": "2026-08-25T00:40:56Z",
      "textHash": "660d02838299e2f1fe24c87e113adf6d859bfbaac5529c162fa6f857e8c06121"
    },
    {
      "key": "0907ccb",
      "nodeTitle": "book_earthmoon",
      "sourceText": "Жуль Верн давно уявляв собі РАКЕТИ та КОСМІЧНІ ПОДОРОЖІ.",
      "sourceEnText": "Jules Verne imagined ROCKETS and space TRAVEL long ago.",
      "audioFile": "fr_03_0907ccb.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 4336,
      "updatedAt": "2026-08-25T00:41:06Z",
      "textHash": "17adbb011e0501775db5edb915706209ffa1714eb08156f194f167968051df08"
    },
    {
      "key": "09438f6",
      "nodeTitle": "activity_submarine_done",
      "sourceText": "Тепер перейдіть до наступного охоронця.",
      "sourceEnText": "Now go to next guardian.",
      "audioFile": "fr_03_09438f6.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2795,
      "updatedAt": "2026-08-25T00:40:34Z",
      "textHash": "b4d6e14eda3e9b57f7ce767b6c68d4938497860ca44778ec4b13e94fc8cdf33e"
    },
    {
      "key": "096a3b3",
      "nodeTitle": "verne_painting",
      "sourceText": "Це Жуль Верн. Він був ПИСЬМЕННИКОМ.",
      "sourceEnText": "This is Jules Verne. He was a WRITER.",
      "audioFile": "fr_03_096a3b3.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3631,
      "updatedAt": "2026-08-25T00:39:19Z",
      "textHash": "8470d53a287e9f273dcaf5cbdf0f8106df5700b7a3b23dfe5e6c6fdde0b956aa"
    },
    {
      "key": "097c3fc",
      "nodeTitle": "tutor_20000",
      "sourceText": "Але воно ЗЛАМАНЕ!",
      "sourceEnText": "But it's BROKEN!",
      "audioFile": "fr_03_097c3fc.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 1515,
      "updatedAt": "2026-08-25T00:40:44Z",
      "textHash": "db5777feeb3bda6f811fda24f6688a6f5a0c19dbecfaa731143c7ce5f3e2d1b6"
    },
    {
      "key": "0998347",
      "nodeTitle": "train",
      "sourceText": "ПОЇЗД курсує по РЕЙКАХ.",
      "sourceEnText": "A TRAIN runs on RAILS.",
      "audioFile": "fr_03_0998347.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2377,
      "updatedAt": "2026-08-25T00:40:52Z",
      "textHash": "b5823d6bbd7f7792235212860f7f5ab5825021f36e5b74c12e5acb784e7ec1a2"
    },
    {
      "key": "09a8c21",
      "nodeTitle": "balloon",
      "sourceText": "Він рухається разом з ВІТРОМ.",
      "sourceEnText": "It moves with the WIND.",
      "audioFile": "fr_03_09a8c21.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 1959,
      "updatedAt": "2026-08-25T00:39:31Z",
      "textHash": "6fadf3ed8dd0bbf43717615806e1c3cb514ea98d89bb22c082fe0f82732b7c72"
    },
    {
      "key": "09bcaba",
      "nodeTitle": "map_nantes",
      "sourceText": "Це КАРТА НАНТА.",
      "sourceEnText": "This is a MAP of NANTES.",
      "audioFile": "fr_03_09bcaba.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 1515,
      "updatedAt": "2026-08-25T00:39:22Z",
      "textHash": "dffcbac69f17651dc186e934764a4a78850dfe05f41b864ad2029d2f35e97b7e"
    },
    {
      "key": "09eafa1",
      "nodeTitle": "museum_guide",
      "sourceText": "Чи можете ви допомогти з прибиранням МУЗЕЮ?",
      "sourceEnText": "Can you help cleaning the MUSEUM?",
      "audioFile": "fr_03_09eafa1.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3448,
      "updatedAt": "2026-08-25T00:40:13Z",
      "textHash": "3b311a44bcfbb18bedf9d4d54303fea4ebedee1ba2a33e2a985542202ed8339f"
    },
    {
      "key": "0a1520b",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Знайдіть ПОВІТРЯНУ КУЛЮ",
      "sourceEnText": "Find the HOT AIR BALLOON",
      "audioFile": "fr_03_0a1520b.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2612,
      "updatedAt": "2026-08-25T00:40:40Z",
      "textHash": "d5d999fd0ab4fed37ebd7ed9c34dcd426be90602ead3de02d59de4c63747f109"
    },
    {
      "key": "0a3e2f4",
      "nodeTitle": "npc_door",
      "sourceText": "Який БЕЗЛАД біля МУЗЕЮ!",
      "sourceEnText": "What a MESS outside the MUSEUM!",
      "audioFile": "fr_03_0a3e2f4.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 1881,
      "updatedAt": "2026-08-25T00:39:59Z",
      "textHash": "eadee1c405e7b935bc5162ff4878fa9c7d8cd14913518225df05bffb9f4c66a7"
    },
    {
      "key": "0a7dfb3",
      "nodeTitle": "museum_guide",
      "sourceText": "У нас ще одна ПРОБЛЕМА!",
      "sourceEnText": "We have another PROBLEM!",
      "audioFile": "fr_03_0a7dfb3.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2194,
      "updatedAt": "2026-08-25T00:40:19Z",
      "textHash": "7529e331413e9e60a33f414359f2240817ca2a3e7a794f77663fd55728967489"
    },
    {
      "key": "0b5e2f3",
      "nodeTitle": "quest_start",
      "sourceText": "Ласкаво просимо до Нанта. Відвідайте Музей Жюля Верна!",
      "sourceEnText": "Welcome to Nantes. Go and discover the Jules Verne Museum!",
      "audioFile": "fr_03_0b5e2f3.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 4232,
      "updatedAt": "2026-08-25T00:39:17Z",
      "textHash": "2c3e05b5aacc0988f7113475a23ef37d6b379dac53dc1cc5f6025e25cb90bf78"
    },
    {
      "key": "0b5eb24",
      "nodeTitle": "task_clean_museum_done",
      "sourceText": "Чудово. Тепер музей чистий! Поверніться до МУЗЕЙНОГО ПУТІВНИКА.",
      "sourceEnText": "Perfect. Now the Museum is clean! Go back to the MUSEUM GUIDE.",
      "audioFile": "fr_03_0b5eb24.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 4989,
      "updatedAt": "2026-08-25T00:40:26Z",
      "textHash": "d90fdc0c78ab05ab24186af968ef572cbf16aa25c9f95cea719c7ad985466258"
    },
    {
      "key": "0b7b198",
      "nodeTitle": "train",
      "sourceText": "Цей старий ПОЇЗД рухався НА ПАРОВІЙ РУХОВІЙ ТЕХНІЦІ.",
      "sourceEnText": "This old TRAIN used STEAM to move.",
      "audioFile": "fr_03_0b7b198.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 4284,
      "updatedAt": "2026-08-25T00:40:53Z",
      "textHash": "8a6a09ac25e48433ee626affd15123c53099a3140bf4a0b352f83a4f574e63c4"
    },
    {
      "key": "0ba85d3",
      "nodeTitle": "activity_submarine_done",
      "sourceText": "Ви це полагодили! Дякую!",
      "sourceEnText": "You repaired it! Thank you!",
      "audioFile": "fr_03_0ba85d3.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2377,
      "updatedAt": "2026-08-25T00:40:33Z",
      "textHash": "c8b4d20e5ecad7cc4cde921a6a448de177e0f845ba7a6ea95273f8b3debccec9"
    },
    {
      "key": "0bb264b",
      "nodeTitle": "tutor_20000",
      "sourceText": "Знайдіть підводний човен",
      "sourceEnText": "Find the SUBMARINE",
      "audioFile": "fr_03_0bb264b.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2142,
      "updatedAt": "2026-08-25T00:40:31Z",
      "textHash": "d04733a4cb8d1bfbd63c0d3b7acae5ad1b4864d664e01f7a8e28ce4decf409e0"
    },
    {
      "key": "0bb46da",
      "nodeTitle": "museum_guide",
      "sourceText": "Транспортних засобів там вже немає.",
      "sourceEnText": "The vehicles are no longer there.",
      "audioFile": "fr_03_0bb46da.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2795,
      "updatedAt": "2026-08-25T00:40:20Z",
      "textHash": "a484032695ab545f128c6f7fa823457a869fa192ef0db62c8881c5a594ee7d5b"
    },
    {
      "key": "0bc6c7b",
      "nodeTitle": "museum_guide",
      "sourceText": "Жуль Верн пишався б тобою!",
      "sourceEnText": "Jules Verne would be proud of you!",
      "audioFile": "fr_03_0bc6c7b.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2482,
      "updatedAt": "2026-08-25T00:40:14Z",
      "textHash": "03ef742a0d22fe99488c0f9915c9e2333ed3fc476f2892893b7ebe662f6dba1b"
    },
    {
      "key": "0bcc84d",
      "nodeTitle": "book_80days",
      "sourceText": "На ньому показано багато місць на ЗЕМЛІ.",
      "sourceEnText": "It shows many places on EARTH.",
      "audioFile": "fr_03_0bcc84d.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2717,
      "updatedAt": "2026-08-25T00:39:42Z",
      "textHash": "4cfb4b16688a083f5416f4364b3d2386a141c900b21b923b0b370ed12652da64"
    },
    {
      "key": "0c3d777",
      "nodeTitle": "book_5weeks",
      "sourceText": "Ця КНИГА називається «П'ять тижнів на повітряній кулі».",
      "sourceEnText": "This BOOK is \"Five Weeks in a Balloon.\"",
      "audioFile": "fr_03_0c3d777.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 4441,
      "updatedAt": "2026-08-25T00:40:41Z",
      "textHash": "549f34d1c75bb28324ede75a1ef0b4b6a053ef8c2b24498ffc1344009cc2c828"
    },
    {
      "key": "0c52f3c",
      "nodeTitle": "museum_guide",
      "sourceText": "Це добре. Ти ще не закінчив, продовжуй!",
      "sourceEnText": "You are doing well!",
      "audioFile": "fr_03_0c52f3c.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3500,
      "updatedAt": "2026-08-25T00:40:17Z",
      "textHash": "82e7cd01c52d478777a280224aaaf1c43f51cea1dd405cd4f7929fc12a5b30f9"
    },
    {
      "key": "0c790cf",
      "nodeTitle": "spawned_guide",
      "sourceText": "Жюль Верн був французьким письменником. Він народився неподалік.",
      "sourceEnText": "Jules Verne was a French WRITER. He was born near here.",
      "audioFile": "fr_03_0c790cf.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_M",
      "durationMs": 4049,
      "updatedAt": "2026-08-25T00:39:52Z",
      "textHash": "54420a3f4315e696eda6437f21b8bad0bc0b5537873dcaafeba9e460b63bb396"
    },
    {
      "key": "0c81640",
      "nodeTitle": "museum_guide",
      "sourceText": "Дякую! Тепер у МУЗЕЇ все гаразд.",
      "sourceEnText": "Thank you! Now the MUSEUM is in order",
      "audioFile": "fr_03_0c81640.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3396,
      "updatedAt": "2026-08-25T00:40:10Z",
      "textHash": "5fc3937294615801af50c1a4d5f7c09ad4ffc626da1a0119e3662d2257916011"
    },
    {
      "key": "0caca1b",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Жюль Верн написав багато КНИГ!",
      "sourceEnText": "Jules Verne wrote many BOOKS!",
      "audioFile": "fr_03_0caca1b.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 2429,
      "updatedAt": "2026-08-25T00:39:35Z",
      "textHash": "e408dec98a644b5d2a08911936625540dfb1de65a16fcdf6e810ef5585373522"
    },
    {
      "key": "0cec96a",
      "nodeTitle": "npc_door",
      "sourceText": "Дякую за прибирання!",
      "sourceEnText": "Thank you for cleaning up!",
      "audioFile": "fr_03_0cec96a.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 1724,
      "updatedAt": "2026-08-25T00:40:02Z",
      "textHash": "db40012e4244a8ba6bd44298874a7dacb05cec517ec3d19f7f9b3319c297ff9a"
    },
    {
      "key": "0d2e2f0",
      "nodeTitle": "npc_door",
      "sourceText": "Музей тепер відкритий! Поспілкуйтеся з МУЗЕЙНИМ ГІДОМ!",
      "sourceEnText": "The Museum is now open! Talk to the MUSEUM GUIDE!",
      "audioFile": "fr_03_0d2e2f0.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 4336,
      "updatedAt": "2026-08-25T00:40:03Z",
      "textHash": "8bd7e2d6f05fb1f2152529f1701dfdc0630e90fe5d0585d05d9aa0a09275343f"
    },
    {
      "key": "0d58543",
      "nodeTitle": "npc_door",
      "sourceText": "Я не можу відкрити МУЗЕЙ у цьому безладі.",
      "sourceEnText": "I can't open the MUSEUM with this mess here.",
      "audioFile": "fr_03_0d58543.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "Default",
      "durationMs": 2769,
      "updatedAt": "2026-08-25T00:40:06Z",
      "textHash": "af9403ad2ec0f4cad351738e0034bf3356e0070869f1c6ef42bdae0a2a361940"
    },
    {
      "key": "0dcb855",
      "nodeTitle": "book_20000",
      "sourceText": "ПІДВОДНИЙ СУДНО подорожує ПІД ВОДОЮ.",
      "sourceEnText": "A SUBMARINE travels UNDERWATER.",
      "audioFile": "fr_03_0dcb855.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 3187,
      "updatedAt": "2026-08-25T00:39:28Z",
      "textHash": "b7f78d48619d2e05e241639c0cba590a267537e24823cc831b6b685add613073"
    },
    {
      "key": "0de00ff",
      "nodeTitle": "rocket",
      "sourceText": "Це космічна РАКЕТА.",
      "sourceEnText": "This is a space ROCKET.",
      "audioFile": "fr_03_0de00ff.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 1724,
      "updatedAt": "2026-08-25T00:41:02Z",
      "textHash": "c6b06738976601378e49862b457f45b951ce175bf5e638a8b345b74aaf114fd0"
    },
    {
      "key": "0e81901",
      "nodeTitle": "spawned_kid_visitor",
      "sourceText": "Мені подобається історія про СВІТ.",
      "sourceEnText": "I like the story about the WORLD.",
      "audioFile": "fr_03_0e81901.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "KID_M",
      "durationMs": 2482,
      "updatedAt": "2026-08-25T00:39:38Z",
      "textHash": "8a9539029f7b968b3423b4f9b4b89bac80e5e03871dd314d4e0f69b5082b2cc0"
    },
    {
      "key": "0e86b01",
      "nodeTitle": "activity_match_done",
      "sourceText": "Чудово! Ви зіставили всі КНИГИ з їхніми ТРАНСПОРТНИМИ ЗАСОБАМИ.",
      "sourceEnText": "Well done! You matched all the BOOKS with their VEHICLES.",
      "audioFile": "fr_03_0e86b01.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 5120,
      "updatedAt": "2026-08-25T00:40:23Z",
      "textHash": "9a79d8ab685049176799217c574f9089f8415b2a605d14f6bdae71a52d4ba2ae"
    },
    {
      "key": "0e928ab",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Допоможіть! Чогось бракує!",
      "sourceEnText": "Help! Something is missing!",
      "audioFile": "fr_03_0e928ab.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2795,
      "updatedAt": "2026-08-25T00:40:38Z",
      "textHash": "f0fd6221aa02a8e3d394d6aaf5b01333ffe3611846de4cca50b8cf2eb86164b5"
    },
    {
      "key": "0ee83b2",
      "nodeTitle": "activity_train_done",
      "sourceText": "Поверніться до МУЗЕЙНОГО ПУТІВНИКА!",
      "sourceEnText": "Go back to the MUSEUM GUIDE!",
      "audioFile": "fr_03_0ee83b2.mp3",
      "voiceProfile": "yaroslava",
      "actorId": "ADULT_F",
      "durationMs": 2847,
      "updatedAt": "2026-08-25T00:41:00Z",
