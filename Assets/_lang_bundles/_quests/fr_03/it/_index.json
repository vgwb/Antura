    },
    {
      "key": "0e86b01",
      "nodeTitle": "activity_match_done",
      "sourceText": "Ottimo lavoro! Hai abbinato tutti i LIBRI ai rispettivi VEICOLI.",
      "sourceEnText": "Well done! You matched all the BOOKS with their VEHICLES.",
      "audioFile": "fr_03_0e86b01.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_F",
      "durationMs": 3736,
      "updatedAt": "2026-08-25T00:32:05Z",
      "textHash": "e5c2ff26910ffdc577ddabcf82ed4922c33fed4b353ecbcc693c70bf1d5619cf"
    },
    {
      "key": "0e928ab",
      "nodeTitle": "tutor_5weeks",
      "sourceText": "Aiuto! Manca qualcosa!",
      "sourceEnText": "Help! Something is missing!",
      "audioFile": "fr_03_0e928ab.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_F",
      "durationMs": 1933,
      "updatedAt": "2026-08-25T00:32:20Z",
      "textHash": "91839575249f899d9b63e794c2e8cb92ff47238d3f5322ed0027a17155934976"
