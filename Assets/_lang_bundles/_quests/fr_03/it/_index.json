      "textHash": "e337831472b718c6794dacd7819bc527b75ac18d43d466b2f686779620ee4679"
    },
    {
      "key": "056e79e",
      "nodeTitle": "spawned_visitor",
      "sourceText": "Jules Verne ha inventato i racconti di fantascienza.",
      "sourceEnText": "Jules Verne invented science FICTION stories.",
