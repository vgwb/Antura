    },
    {
      "key": "06fb1cd",
      "nodeTitle": "spawned_guide",
      "sourceText": "No, chi è?",
      "sourceEnText": "No, who is he?",
      "audioFile": "fr_03_06fb1cd.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 888,
      "updatedAt": "2026-08-25T00:31:32Z",
