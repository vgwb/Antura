      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2900,
      "updatedAt": "2026-08-25T00:31:01Z",
      "textHash": "001d70431c3e06fee5e78120a345d26354385cbaab709bef0c699f78775d589a"
    },
    {
      "key": "01a9d0f",
      "nodeTitle": "npc_door",
      "sourceText": "Aiutatemi a pulire il marciapiede!",
