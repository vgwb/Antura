      "voiceProfile": "francesco",
      "actorId": "ADULT_F",
      "durationMs": 3500,
      "updatedAt": "2026-08-25T00:32:48Z",
      "textHash": "72b129ff1a433f98728a6c3b9cfefa0d51473a5178a04fe2965bc2c30c50e627"
    },
    {
      "key": "0642734",
      "nodeTitle": "museum_guide",
      "sourceText": "Abbiamo un PROBLEMA!",
