      "key": "0de00ff",
      "nodeTitle": "rocket",
      "sourceText": "Questo è un razzo spaziale.",
      "sourceEnText": "This is a space ROCKET.",
      "audioFile": "fr_03_0de00ff.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_F",
      "durationMs": 1698,
