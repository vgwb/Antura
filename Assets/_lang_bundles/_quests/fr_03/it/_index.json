    {
      "key": "0f92a05",
      "nodeTitle": "spawned_guide",
      "sourceText": "Ha scritto libri d'avventura famosissimi.",
      "sourceEnText": "He wrote very famous adventure BOOKS.",
      "audioFile": "fr_03_0f92a05.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 2351,
      "updatedAt": "2026-08-25T00:31:35Z",
