      "textHash": "48e7d372ea6462a23957591fc56882f579110916edac8888ebf2f8e386d1740c"
    },
    {
      "key": "0245e0e",
      "nodeTitle": "museum_guide",
      "sourceText": "Metti insieme i LIBRI con i loro veicoli!",
      "sourceEnText": "Put the BOOKS together with their vehicles!",
