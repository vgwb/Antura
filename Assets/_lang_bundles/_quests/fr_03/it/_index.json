      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 3683,
      "updatedAt": "2026-08-25T00:31:34Z",
      "textHash": "23fc96e7bb9fb60faa88928e703b0e67e51644f7d2a4dfe2a17b0e5accd29eab"
    },
    {
      "key": "0c81640",
      "nodeTitle": "museum_guide",
      "sourceText": "Grazie! Ora il MUSEO è in ordine",
