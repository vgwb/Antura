    {
      "key": "0f5f36d",
      "nodeTitle": "spawned_visitor",
      "sourceText": "I suoi libri vengono letti in molte lingue!",
      "sourceEnText": "People read his BOOKS in many languages!",
      "audioFile": "fr_03_0f5f36d.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2194,
      "updatedAt": "2026-08-25T00:31:19Z",
      "textHash": "13e5d31a09e80f78c1dd68bb503cec5245dab7c429332dafbaca85c700b4770e"
