      "textHash": "d76f3ad0e4be6a4897593096af064c051141b06ee857ca8ff97c61eca1d2dfe7"
    },
    {
      "key": "0525efc",
      "nodeTitle": "museum_guide",
      "sourceText": "Un buffo cane blu è entrato nel museo e ha combinato un disastro!",
