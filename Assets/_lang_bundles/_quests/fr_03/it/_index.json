      "key": "0757b30",
      "nodeTitle": "submarine_lost",
      "sourceText": "Ottimo! Ora riportalo al suo custode.",
      "sourceEnText": "Great! Now bring it back to its guardian",
      "audioFile": "fr_03_0757b30.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_F",
      "durationMs": 2351,
