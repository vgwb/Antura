    {
      "key": "0f72ec7",
      "nodeTitle": "quest_end",
      "sourceText": "Se andate a Nantes con i vostri genitori, visitate il Museo di Jules Verne!",
      "sourceEnText": "If you go to Nantes with your parents, go to the Jules Verne Museum!",
      "audioFile": "fr_03_0f72ec7.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 4206,
      "updatedAt": "2026-08-25T00:31:42Z",
