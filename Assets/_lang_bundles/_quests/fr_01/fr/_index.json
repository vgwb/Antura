{
  "version": "1",
  "questId": "fr_01",
  "lang": "fr",
  "lines": [
    {
      "key": "002620f",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Veux-tu dessiner la Tour Eiffel ?",
      "sourceEnText": "Do you want to draw the Eiffel Tower?",
      "audioFile": "fr_01_002620f.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "NARRATOR",
      "durationMs": 1646,
      "updatedAt": "2026-08-24T18:19:37Z",
      "textHash": "0a39bf55a6758b89505ebb406e67b97649cbc8c21657312ab5371ad0c996e73a"
    },
    {
      "key": "002796f",
      "nodeTitle": "spawned_man",
      "sourceText": "Que fais-tu?",
      "sourceEnText": "What are you doing?",
      "audioFile": "fr_01_002796f.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 888,
      "updatedAt": "2026-08-24T18:18:16Z",
      "textHash": "502a416546e88ad046c9e4e9d50f697cc28e4482c9bc1adb5d45c1c76680b1c0"
    },
    {
      "key": "006fcf2",
      "nodeTitle": "talk_eiffell_ticket",
      "sourceText": "Profitez de votre visite !",
      "sourceEnText": "Enjoy your visit!",
      "audioFile": "fr_01_006fcf2.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1541,
      "updatedAt": "2026-08-24T18:17:43Z",
      "textHash": "6525b0ef47f19861ea5a0736055a42b941479862c68979214f989f9e20237e57"
    },
    {
      "key": "0070084",
      "nodeTitle": "talk_eiffell_guide",
      "sourceText": "Bonjour. Que voulez-vous savoir ?",
      "sourceEnText": "Hello. What do you want to know?",
      "audioFile": "fr_01_0070084.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1829,
      "updatedAt": "2026-08-24T18:17:51Z",
      "textHash": "b6dcff31fa3802298ed0677e17d0bc214155612608f4b12318bb1644f30924dc"
    },
    {
      "key": "0097a65",
      "nodeTitle": "talk_eiffell_ticket",
      "sourceText": "Regardez autour de toi et ramasse les pièces.",
      "sourceEnText": "Look around and pick up coins.",
      "audioFile": "fr_01_0097a65.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2142,
      "updatedAt": "2026-08-24T18:18:47Z",
      "textHash": "df32d4584e2499e0a8c319931c18832ad1a1f3df17fcc655169cf934855e1ffc"
    },
    {
      "key": "00f1d2f",
      "nodeTitle": "baguette_salt",
      "sourceText": "Vous avez trouvé du sel.",
      "sourceEnText": "You found salt.",
      "audioFile": "fr_01_00f1d2f.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1463,
      "updatedAt": "2026-08-24T18:17:32Z",
      "textHash": "b8625078928103a619b80d3e91da1c80294e3ae5bb2b6233670ecb0044be51d8"
    },
    {
      "key": "0141851",
      "nodeTitle": "talk_eiffell_ticket",
      "sourceText": "Un billet pour monter en haut de la Tour Eiffel.",
      "sourceEnText": "A ticket to go up the Eiffel Tower.",
      "audioFile": "fr_01_0141851.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-08-24T18:18:26Z",
      "textHash": "2f0fda8843773aa3f5ae9dc11041f67d0047dc743617d889b9192c3a50035359"
    },
    {
      "key": "01fa210",
      "nodeTitle": "spawned_eiffell_tourist",
      "sourceText": "C'était pour célébrer un anniversaire important pour la France.",
      "sourceEnText": "It was to celebrate a big birthday for France.",
      "audioFile": "fr_01_01fa210.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 3135,
      "updatedAt": "2026-08-24T18:19:46Z",
      "textHash": "17e0d606139cdea8743503ff29079aac062dd88556d0ff87dcafbdce21a595bf"
    },
    {
      "key": "025865d",
      "nodeTitle": "baguette_yeast",
      "sourceText": "Vous avez trouvé de la levure !",
      "sourceEnText": "You found yeast!",
      "audioFile": "fr_01_025865d.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1593,
      "updatedAt": "2026-08-24T18:17:38Z",
      "textHash": "9c0bcbb451c9b18b0ee6befb5400392aa89ea07c1c28039431d04220413efaec"
    },
    {
      "key": "02b627d",
      "nodeTitle": "talk_eiffell_guide",
      "sourceText": "Nous sommes à Paris.",
      "sourceEnText": "We are in Paris.",
      "audioFile": "fr_01_02b627d.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1123,
      "updatedAt": "2026-08-24T18:18:00Z",
      "textHash": "e30be1fa72186ba5d418cf4ec5244c691a83d4613e8caafdfaa337abec75799d"
    },
    {
      "key": "03dc852",
      "nodeTitle": "talk_eiffell_ticket",
      "sourceText": "Une baguette.",
      "sourceEnText": "A baguette.",
      "audioFile": "fr_01_03dc852.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 888,
      "updatedAt": "2026-08-24T18:16:58Z",
      "textHash": "7f89db073a7dd2548cec82041bfb1770c97bddb731e0ad58a9c72b327335e8b2"
    },
    {
      "key": "041403d",
      "nodeTitle": "spawned_kid_f",
      "sourceText": "Bonjour !",
      "sourceEnText": "Bonjour!",
      "audioFile": "fr_01_041403d.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_F",
      "durationMs": 810,
      "updatedAt": "2026-08-24T18:19:49Z",
      "textHash": "384598b9213098c675d42ce19f37e593af0d04212c85b524292275b1b156110f"
    },
    {
      "key": "04986a3",
      "nodeTitle": "spawned_kid_f",
      "sourceText": "Ça va ?",
      "sourceEnText": "Ca va?",
      "audioFile": "fr_01_04986a3.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "KID_F",
      "durationMs": 705,
      "updatedAt": "2026-08-24T18:19:51Z",
      "textHash": "03f193515f082c29aa5f325e0d24fe98db01e990dd87ab7410e739a93c083edd"
    },
    {
      "key": "04e74ad",
      "nodeTitle": "ticket_payment_done",
      "sourceText": "Voici votre billet.",
      "sourceEnText": "Here is your ticket.",
      "audioFile": "fr_01_04e74ad.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1306,
      "updatedAt": "2026-08-24T18:17:07Z",
      "textHash": "ff976a3b4a0d138856232ac334e6e962e7b77c6afa1aa939dd48e0a3fe7c2d5c"
    },
    {
      "key": "0585a5e",
      "nodeTitle": "ticket_payment_done",
      "sourceText": "Prenez l'ascenseur ou utilisez les escaliers !",
      "sourceEnText": "Take the elevator or use the stairs!",
      "audioFile": "fr_01_0585a5e.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2429,
      "updatedAt": "2026-08-24T18:17:11Z",
      "textHash": "a0d4fa5de3c5ed2c2bb8267e87b55374e44583a873b35d23e9883be8c0cfa1cb"
    },
    {
      "key": "05a38a8",
      "nodeTitle": "spawned_man",
      "sourceText": "Je vais acheter du pain à la boulangerie.",
      "sourceEnText": "I am going to buy bread at the bakery.",
      "audioFile": "fr_01_05a38a8.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T18:18:19Z",
      "textHash": "9106e9cc60ce8a3b4bad3fc419b5d036886101222888933f4bd23d69ceaf53e1"
    },
    {
      "key": "05eabcf",
      "nodeTitle": "spawned_man",
      "sourceText": "D'où viens-tu?",
      "sourceEnText": "Where do you come from?",
      "audioFile": "fr_01_05eabcf.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 888,
      "updatedAt": "2026-08-24T18:18:21Z",
      "textHash": "26e60161b8d6f17645aaabfd09e9cd8e86e77e6854dd1ef218abd0c17c281704"
    },
    {
      "key": "06022b0",
      "nodeTitle": "baguette_flour",
      "sourceText": "Vous avez trouvé de la farine !",
      "sourceEnText": "You found flour!",
      "audioFile": "fr_01_06022b0.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1515,
      "updatedAt": "2026-08-24T18:17:34Z",
      "textHash": "227b61566a82be9453d9bd8cc35fda7e895b3207f06399acf5e4f70b3b143f0a"
    },
    {
      "key": "0635a6a",
      "nodeTitle": "spawned_man",
      "sourceText": "Je ne suis pas né dans ce pays.",
      "sourceEnText": "I was not born in this country.",
      "audioFile": "fr_01_0635a6a.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 1593,
      "updatedAt": "2026-08-24T18:18:23Z",
      "textHash": "d7f168b8b8e78dedb4b166f2a2eb4aafc157f1337dcc4c289b6e95f1a9d5ede4"
    },
    {
      "key": "069cbb3",
      "nodeTitle": "talk_eiffell_ticket",
      "sourceText": "Le billet coûte 5 pièces",
      "sourceEnText": "The ticket costs 5 coins.",
      "audioFile": "fr_01_069cbb3.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1411,
      "updatedAt": "2026-08-24T18:17:12Z",
      "textHash": "a40fc941ffc39d7684874259ad985f258eac302b174abdbf7256a9d0645f8e92"
    },
    {
      "key": "06cccc0",
      "nodeTitle": "talk_baker",
      "sourceText": "Maintenant, il me faut du sel.",
      "sourceEnText": "Now I need the salt.",
      "audioFile": "fr_01_06cccc0.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1593,
      "updatedAt": "2026-08-24T18:16:53Z",
      "textHash": "71ed091adca702b0ce3b89adf7d1a4f59451500dee4decdf870c09a4d24480c3"
    },
    {
      "key": "06f3fa2",
      "nodeTitle": "talk_notre_dame",
      "sourceText": "Voici la cathédrale Notre-Dame.",
      "sourceEnText": "This is Notre-Dame Cathedral.",
      "audioFile": "fr_01_06f3fa2.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1829,
      "updatedAt": "2026-08-24T18:17:15Z",
      "textHash": "b3199d5be2827aeebaafed0865d068bf3cd9e48e630ea70b20db58640a3ac428"
    },
    {
      "key": "06f3fa2_cathedral",
      "nodeTitle": "talk_notre_dame",
      "sourceText": "Cathédrale signifie une très grande église.",
      "sourceEnText": "A cathedral is a very big church.",
      "audioFile": "fr_01_06f3fa2_cathedral.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 2142,
      "updatedAt": "2026-08-24T18:18:28Z",
      "textHash": "09c4ea5d929ce730411176d29a92f17233da1c3b9e08f04e45aa10fb8ff6e803"
    },
    {
      "key": "0718e4a",
      "nodeTitle": "talk_eiffell_ticket",
      "sourceText": "Juste pour regarder autour de soi.",
      "sourceEnText": "Just to look around.",
      "audioFile": "fr_01_0718e4a.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1829,
      "updatedAt": "2026-08-24T18:19:41Z",
      "textHash": "b1fcb96250859b62ce75c706c987b399a772c477ffea32a766a55f56f9ce2c91"
    },
    {
      "key": "076b3e3",
      "nodeTitle": "baker_finish",
      "sourceText": "Voyons si vous vous souvenez de ce que vous avez appris à Paris.",
      "sourceEnText": "Let's see if you remember what you learned in Paris.",
      "audioFile": "fr_01_076b3e3.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 3082,
      "updatedAt": "2026-08-24T18:19:54Z",
      "textHash": "730af1e18487b31f37f7e2267fbd92f855e668ade175989011da87e4821e17ce"
    },
    {
      "key": "07a113f",
      "nodeTitle": "talk_eiffell_guide",
      "sourceText": "C'est un symbole emblématique de Paris !",
      "sourceEnText": "It is a special symbol of Paris!",
      "audioFile": "fr_01_07a113f.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2194,
      "updatedAt": "2026-08-24T18:17:56Z",
      "textHash": "f1a71a991641fa0f3075bb4cde255298b48cca83645030637616999fe38e2c86"
    },
    {
      "key": "07b94e9",
      "nodeTitle": "spawned_man",
      "sourceText": "Avez-vous des questions ?",
      "sourceEnText": "Do you have questions?",
      "audioFile": "fr_01_07b94e9.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 1228,
      "updatedAt": "2026-08-24T18:18:08Z",
      "textHash": "75505b453333a963361622dc8b48f73c273547a416fef3a40afe9d761131d2de"
    },
    {
      "key": "083dfcc",
      "nodeTitle": "talk_notre_dame",
      "sourceText": "Monte sur le toit avec ce portail !",
      "sourceEnText": "Go up to the roof through that portal!",
      "audioFile": "fr_01_083dfcc.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1881,
      "updatedAt": "2026-08-24T18:17:17Z",
      "textHash": "ac74ebea6cb9f1ce81bf52a866182204578ddf13eb96fb787ebe06d30a7dfd30"
    },
    {
      "key": "08654e6",
      "nodeTitle": "talk_eiffell_guide",
      "sourceText": "Oui ! Pourquoi me posez-vous cette question ?",
      "sourceEnText": "Yes! Why do you ask?",
      "audioFile": "fr_01_08654e6.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2299,
      "updatedAt": "2026-08-24T18:18:03Z",
      "textHash": "eefb0061d244708db1d94883f0dea3a313324bf3066acdd6bce4b266dec95f3f"
    },
    {
      "key": "089abda",
      "nodeTitle": "ticket_payment_done",
      "sourceText": "J'ai vu Antura monter au sommet de la tour.",
      "sourceEnText": "I saw Antura going up to the top of the tower.",
      "audioFile": "fr_01_089abda.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2247,
      "updatedAt": "2026-08-24T18:17:09Z",
      "textHash": "055442dfee7877fb86c54059f7dd841aca88331bde95548524663dc2eb376a7c"
    },
    {
      "key": "08bede4",
      "nodeTitle": "talk_eiffell_guide",
      "sourceText": "Cet endroit existe-t-il vraiment ?",
      "sourceEnText": "Is this place real?",
      "audioFile": "fr_01_08bede4.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2011,
      "updatedAt": "2026-08-24T18:18:01Z",
      "textHash": "62b152ec00fc4fc9f0acb5c1eaedc41be44982aa2208d6ba62175bda93ca6752"
    },
    {
      "key": "08c1973",
      "nodeTitle": "talk_eiffell_roof",
      "sourceText": "La tour Eiffel mesure 300 mètres de haut.",
      "sourceEnText": "The Eiffel Tower is 300 meters tall.",
      "audioFile": "fr_01_08c1973.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2351,
      "updatedAt": "2026-08-24T18:17:00Z",
      "textHash": "fb4477edcc58b91db55d9a3d39138bc9a06eadccb961c047ce0da8c36987263d"
    },
    {
      "key": "09a0ead",
      "nodeTitle": "talk_notre_dame_roof",
      "sourceText": "Il y a eu un gros incendie en 2019, mais nous l'avons réparé.",
      "sourceEnText": "There was a big fire in 2019, but it is fixed now.",
      "audioFile": "fr_01_09a0ead.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 3370,
      "updatedAt": "2026-08-24T18:17:40Z",
      "textHash": "d925a443db96c6b8d8ac01fff4dc25f90c0b569d557bf9515e9af534dcb55c6f"
    },
    {
      "key": "09be864",
      "nodeTitle": "spawned_eiffell_tourist",
      "sourceText": "Il vous faut un billet pour monter.",
      "sourceEnText": "You need a ticket to go up.",
      "audioFile": "fr_01_09be864.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 1698,
      "updatedAt": "2026-08-24T18:19:44Z",
      "textHash": "da573440ce6b0bb196d18e3c0a95844e5aeafd9a855cfcf1f6eb5a25f029b6aa"
    },
    {
      "key": "09dd1da",
      "nodeTitle": "talk_eiffell_guide",
      "sourceText": "Où sommes-nous?",
      "sourceEnText": "Where are we?",
      "audioFile": "fr_01_09dd1da.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 940,
      "updatedAt": "2026-08-24T18:17:58Z",
      "textHash": "536518c8195af88187464c65398000d852e75369150efe426b433e5c184e5a4b"
    },
    {
      "key": "09e454b",
      "nodeTitle": "talk_eiffell_ticket",
      "sourceText": "Bonjour. Que désirez-vous ?",
      "sourceEnText": "Good morning. What do you want?",
      "audioFile": "fr_01_09e454b.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1881,
      "updatedAt": "2026-08-24T18:17:14Z",
      "textHash": "cc40162968d9fe0779011de2a6cd4fbd7fbdc3faf46fa0de8ec05c25dd8fb26a"
    },
    {
      "key": "09e5c3b",
      "nodeTitle": "talk_eiffell_roof",
      "sourceText": "Gustave Eiffel l'a construit en 1887.",
      "sourceEnText": "Gustave Eiffel built it in 1887.",
      "audioFile": "fr_01_09e5c3b.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2717,
      "updatedAt": "2026-08-24T18:17:02Z",
      "textHash": "2b2bc034fbf708434733a09a926fe10fe6e089a3fc96e57af06b32539b4ded68"
    },
    {
      "key": "0a3f4e1",
      "nodeTitle": "spawned_eiffell_tourist",
      "sourceText": "Il y eut une grande foire à Paris en 1889.",
      "sourceEnText": "There was a big fair in Paris in 1889.",
      "audioFile": "fr_01_0a3f4e1.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 2795,
      "updatedAt": "2026-08-24T18:19:09Z",
      "textHash": "aaa332866c84ceeb4b3af4a889405ee9b93c7fd583288f02df4294d143e77c26"
    },
    {
      "key": "0ac5a72",
      "nodeTitle": "talk_notre_dame",
      "sourceText": "C'est une très vieille église. Elle a été construite il y a très longtemps.",
      "sourceEnText": "It is a very old church. It was built long ago.",
      "audioFile": "fr_01_0ac5a72.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 4885,
      "updatedAt": "2026-08-24T18:18:45Z",
      "textHash": "7bf0300bafe680132442d5bf0dbecb9d654f64ffe968a5bf2649560bfdc61ef8"
    },
    {
      "key": "0aee9bb",
      "nodeTitle": "spawned_eiffell_tourist",
      "sourceText": "J'aimerais monter en haut de la tour Eiffel.",
      "sourceEnText": "I would like to go up the Eiffel Tower.",
      "audioFile": "fr_01_0aee9bb.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 2116,
      "updatedAt": "2026-08-24T18:19:42Z",
      "textHash": "dc5f9c0db5285cf782c045db3bc9936eeb5c4847f0bb13d5a12d0fd775d56cc7"
    },
    {
      "key": "0ba42cd",
      "nodeTitle": "coins_collected",
      "sourceText": "Vous avez maintenant assez de pièces pour acheter le billet.",
      "sourceEnText": "You have enough coins now to buy the ticket.",
      "audioFile": "fr_01_0ba42cd.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2952,
      "updatedAt": "2026-08-24T18:18:32Z",
      "textHash": "38dd56e53c28b059a9119a6cf25cd09fd5c59f5a3866e5cd22acc7e25c0b6722"
    },
    {
      "key": "0bc62a3",
      "nodeTitle": "talk_eiffell_guide",
      "sourceText": "Eh bien… on dirait un jeu vidéo.",
      "sourceEnText": "Well... it looks like a video game.",
      "audioFile": "fr_01_0bc62a3.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1829,
      "updatedAt": "2026-08-24T18:18:05Z",
      "textHash": "b053533330a66b6b57246801f3a770169b05b18e6fe57bf58b3eb09ab01b18d3"
    },
    {
      "key": "0bda18a",
      "nodeTitle": "spawned_eiffell_tourist",
      "sourceText": "J'adore Paris !",
      "sourceEnText": "I love Paris!",
      "audioFile": "fr_01_0bda18a.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 1045,
      "updatedAt": "2026-08-24T18:19:47Z",
      "textHash": "19dfcdb8759ecea13f66b53b8c4012649ebd4d160867817c6559cce1282d5956"
    },
    {
      "key": "0c4d1f6",
      "nodeTitle": "baguette_water",
      "sourceText": "Ceci est de l'eau.",
      "sourceEnText": "This is water.",
      "audioFile": "fr_01_0c4d1f6.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1123,
      "updatedAt": "2026-08-24T18:17:36Z",
      "textHash": "9c513e781bfcf5865c4f0f201b91a8aa1f3a36f903cf9d50f8bc1c4887d19afb"
    },
    {
      "key": "0cbdcce",
      "nodeTitle": "talk_eiffell_ticket",
      "sourceText": "Il y a une boulangerie près d'ici. Mais elle ouvre tard.",
      "sourceEnText": "There is a bakery near here. But it opens later.",
      "audioFile": "fr_01_0cbdcce.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 3396,
      "updatedAt": "2026-08-24T18:17:27Z",
      "textHash": "0f3acdd61fe0965179ea8501cce5414de1f9388363a1a218822a0de2108cfe63"
    },
    {
      "key": "0d11596",
      "nodeTitle": "quest_end",
      "sourceText": "Félicitations!",
      "sourceEnText": "Congratulations!",
      "audioFile": "fr_01_0d11596.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "NARRATOR",
      "durationMs": 1097,
      "updatedAt": "2026-08-24T18:17:19Z",
      "textHash": "8e5f00d30f5a2b5b6c5ece11c02537ff1a2b9d82a6af272f85ff3c75231b0c27"
    },
    {
      "key": "0d11596a",
      "nodeTitle": "quest_end",
      "sourceText": "Tu as aimé Paris ?",
      "sourceEnText": "Did you like Paris?",
      "audioFile": "fr_01_0d11596a.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "NARRATOR",
      "durationMs": 1228,
      "updatedAt": "2026-08-24T18:18:50Z",
      "textHash": "0fc93b0f5b7c233c578c69a0dd4489e55896bcb32fc28c45a9cfdb1ce16481e3"
    },
    {
      "key": "0d46853",
      "nodeTitle": "arc_activity_done",
      "sourceText": "Il se trouve sur le toit. Utilisez le téléporteur pour y aller.",
      "sourceEnText": "It is on the roof. use the teleporter to go there.",
      "audioFile": "fr_01_0d46853.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_F",
      "durationMs": 3448,
      "updatedAt": "2026-08-24T18:19:59Z",
      "textHash": "7410ffa2f77ba1d3e5e95ac069f5b3d8692f5a37a2b394b00007c1fab0525898"
    },
    {
      "key": "0d59ade",
      "nodeTitle": "talk_eiffell_roof",
      "sourceText": "Elle est en fer.",
      "sourceEnText": "It is made of iron!",
      "audioFile": "fr_01_0d59ade.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1045,
      "updatedAt": "2026-08-24T18:17:03Z",
      "textHash": "98e887c648811cdeec2a89300cffc558abf1dad1ce9bb3f00178def991e2ecd4"
    },
    {
      "key": "0d59ade_fair",
      "nodeTitle": "talk_eiffell_roof",
      "sourceText": "Il a été construit il y a longtemps pour une grande foire.",
      "sourceEnText": "It was built for a big fair long ago.",
      "audioFile": "fr_01_0d59ade_fair.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 3213,
      "updatedAt": "2026-08-24T18:18:30Z",
      "textHash": "1a76f618d93cecf4e960cbaaa8472297fceef5818d9ada3c5dfbae9ed30f0c63"
    },
    {
      "key": "0d6f3c4",
      "nodeTitle": "spawned_eiffell_tourist",
      "sourceText": "La tour Eiffel a été construite pour cette grande fête.",
      "sourceEnText": "The Eiffel Tower was built for that big party.",
      "audioFile": "fr_01_0d6f3c4.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 3265,
      "updatedAt": "2026-08-24T18:19:12Z",
      "textHash": "be00696a6c5fb9e61852e823fbcdf52d6ea333603b564d5a14535274f8c6fe14"
    },
    {
      "key": "0d91dc0",
      "nodeTitle": "talk_eiffell_guide",
      "sourceText": "Qu'est-ce que la tour Eiffel ?",
      "sourceEnText": "What is the Eiffel Tower?",
      "audioFile": "fr_01_0d91dc0.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1698,
      "updatedAt": "2026-08-24T18:17:52Z",
      "textHash": "2a53bf7c7e886cbc889e08729189b4e244c45bad973e43356f74926f3492a65a"
    },
    {
      "key": "0da46e8",
      "nodeTitle": "talk_eiffell_roof",
      "sourceText": "Bienvenue au sommet de la Tour Eiffel !",
      "sourceEnText": "Welcome to the top of the Eiffel Tower!",
      "audioFile": "fr_01_0da46e8.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 2194,
      "updatedAt": "2026-08-24T18:19:56Z",
      "textHash": "ed6b159e851195694f336316fac5a8103ac95ee61dd3bb88ecf70880209037ca"
    },
    {
      "key": "0ee51fc",
      "nodeTitle": "spawned_man",
      "sourceText": "Au revoir",
      "sourceEnText": "Goodbye",
      "audioFile": "fr_01_0ee51fc.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 758,
      "updatedAt": "2026-08-24T18:18:25Z",
      "textHash": "eb09b701aa80238ebc8c1577577211e0c1c699da004e903269c5cca022617242"
    },
    {
      "key": "0f17af0",
      "nodeTitle": "talk_eiffell_guide",
      "sourceText": "Une haute tour en fer, d'environ 300 mètres de haut.",
      "sourceEnText": "A tall iron tower, about 300 meters high.",
      "audioFile": "fr_01_0f17af0.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 2978,
      "updatedAt": "2026-08-24T18:17:55Z",
      "textHash": "63b64098751521d2b9f524043d10995710c5ec0517332515ba3fa910a575b8e8"
    },
    {
      "key": "0f18ad3",
      "nodeTitle": "spawned_man",
      "sourceText": "Avez-vous vu Antura ?",
      "sourceEnText": "Have you seen Antura?",
      "audioFile": "fr_01_0f18ad3.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 1280,
      "updatedAt": "2026-08-24T18:18:10Z",
      "textHash": "71cb93903989c4a0296b970bfe2417a358d59b2e1f55693cb64f2d323f8c204d"
    },
    {
      "key": "0f44ea7",
      "nodeTitle": "talk_eiffell_ticket",
      "sourceText": "Tu dois maintenant payer tes achats",
      "sourceEnText": "Select the money to pay.",
      "audioFile": "fr_01_0f44ea7.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1724,
      "updatedAt": "2026-08-24T18:19:57Z",
      "textHash": "c6e2ac98c64312adc33610d3f91df6ffe3dfc8cd61e6d473802224d14a4de060"
    },
    {
      "key": "0f7f9d8",
      "nodeTitle": "gargoyle",
      "sourceText": "Regardez cette statue ! Elle n'est pas effrayante ?",
      "sourceEnText": "Look at that statue! Is it scary?",
      "audioFile": "fr_01_0f7f9d8.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 2847,
      "updatedAt": "2026-08-24T18:19:39Z",
      "textHash": "87dc8d4464c521c69b1bcc7f9af3528d9fa92ace0b93c9ac446a55a26a24d296"
    },
    {
      "key": "0f9dd62",
      "nodeTitle": "spawned_man",
      "sourceText": "Non. Qui est Antura ?",
      "sourceEnText": "No. Who is Antura?",
      "audioFile": "fr_01_0f9dd62.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "ADULT_M",
      "durationMs": 1776,
      "updatedAt": "2026-08-24T18:18:14Z",
      "textHash": "0ff960269215a6ec4c40794cb170345ddbf8c4abf96b650a7998be407277c2c9"
    },
    {
      "key": "0fe0732",
      "nodeTitle": "talk_eiffell_guide",
      "sourceText": "Rien. Au revoir.",
      "sourceEnText": "Nothing. Bye.",
      "audioFile": "fr_01_0fe0732.mp3",
      "voiceProfile": "mademoiselle",
      "actorId": "ADULT_F",
      "durationMs": 1123,
      "updatedAt": "2026-08-24T18:18:07Z",
      "textHash": "74067400f9979f9801c3e719ecc25ab887fa74152cbc2fb86684772c449ce361"
    },
    {
      "key": "already_solved",
      "nodeTitle": "talk_notre_dame",
      "sourceText": "Nous avons déjà résolu cette partie.",
      "sourceEnText": "We already solved this part.",
      "audioFile": "fr_01_already_solved.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 2011,
      "updatedAt": "2026-08-24T18:19:52Z",
      "textHash": "d5e8050e3a57327d46a6655b48f27f54bc01396c0805f58aa9d4e10711a6be23"
    },
    {
      "key": "arc_0",
      "nodeTitle": "talk_arc",
      "sourceText": "Voici l'Arc de Triomphe.",
      "sourceEnText": "This is the Arc de Triomphe.",
      "audioFile": "fr_01_arc_0.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_F",
      "durationMs": 1411,
      "updatedAt": "2026-08-24T18:17:24Z",
      "textHash": "02115b2b8f7abf7714547c40ca2da7862ecc9cd9d6876ac80714a38c9fb72015"
    },
    {
      "key": "arc_0a",
      "nodeTitle": "talk_arc",
      "sourceText": "Il rend hommage aux personnes qui ont combattu pour la France.",
      "sourceEnText": "It honors people who fought for France.",
      "audioFile": "fr_01_arc_0a.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_F",
      "durationMs": 2900,
      "updatedAt": "2026-08-24T18:17:05Z",
      "textHash": "88f3b51a5672ee2d095919e168d6974d402636be406c4751fd07a042139b208a"
    },
    {
      "key": "baker_0",
      "nodeTitle": "talk_baker",
      "sourceText": "Bonjour ! Je suis le boulanger. Je fais du pain tous les jours.",
      "sourceEnText": "Hello! I am a baker. I make bread every day.",
      "audioFile": "fr_01_baker_0.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 3553,
      "updatedAt": "2026-08-24T18:18:57Z",
      "textHash": "6d5120d93a3032494da2e200c3e118b0dbbc619592831514a8032351da172756"
    },
    {
      "key": "baker_1",
      "nodeTitle": "talk_baker",
      "sourceText": "Je veux faire une baguette.",
      "sourceEnText": "Today I want to make a baguette...",
      "audioFile": "fr_01_baker_1.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1228,
      "updatedAt": "2026-08-24T18:18:55Z",
      "textHash": "d3f26475b70404dd98b5cb99469bc5c83bb112da794eaee04ce35791a189a463"
    },
    {
      "key": "baker_2",
      "nodeTitle": "talk_baker",
      "sourceText": "Mais  je n'ai pas les ingrédients!",
      "sourceEnText": "But I lost the ingredients!",
      "audioFile": "fr_01_baker_2.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1541,
      "updatedAt": "2026-08-24T18:18:18Z",
      "textHash": "842aae9c34551847f28255a9c7e2fe638da0bf6fafe014e064bc5e4fbb0cb11f"
    },
    {
      "key": "baker_3",
      "nodeTitle": "talk_baker",
      "sourceText": "Un gros chien bleu a volé la farine, le sel, l'eau et la levue.",
      "sourceEnText": "A big blue dog stole my flour!",
      "audioFile": "fr_01_baker_3.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 3866,
      "updatedAt": "2026-08-24T18:16:55Z",
      "textHash": "55b4c7e368acb8232ce8799df2325623b44fe8fa5c3b0a8f12623c5d81ae9b7b"
    },
    {
      "key": "baker_4",
      "nodeTitle": "talk_baker",
      "sourceText": "Peux tu m'aider à les trouver ?",
      "sourceEnText": "Can you help me find them?",
      "audioFile": "fr_01_baker_4.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1463,
      "updatedAt": "2026-08-24T18:17:45Z",
      "textHash": "ddf54e476bae8a22a2d207982d594b9f166786fe49b2e75757ff57b937ad330a"
    },
    {
      "key": "baker_5",
      "nodeTitle": "talk_baker",
      "sourceText": "Allez à la Tour Eiffel.",
      "sourceEnText": "Go to the Eiffel Tower.",
      "audioFile": "fr_01_baker_5.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1280,
      "updatedAt": "2026-08-24T18:17:31Z",
      "textHash": "046ff7944eadd0ffe8f1fc2a2919f7a597408a4acda794ffc43f146814fac259"
    },
    {
      "key": "baker_finish_0",
      "nodeTitle": "baker_finish",
      "sourceText": "Vous avez trouvé tous les ingrédients !",
      "sourceEnText": "You found all the ingredients!",
      "audioFile": "fr_01_baker_finish_0.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 2011,
      "updatedAt": "2026-08-24T18:17:41Z",
      "textHash": "00c3a533d1233c2259e63f97717bfe4bf9002443909352352442087403a7c741"
    },
    {
      "key": "baker_finish_1",
      "nodeTitle": "baker_finish",
      "sourceText": "Maintenant, je peux faire une baguette.",
      "sourceEnText": "Now I can make a baguette.",
      "audioFile": "fr_01_baker_finish_1.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1829,
      "updatedAt": "2026-08-24T18:17:49Z",
      "textHash": "757a562b23ab02c64523c5066236b5063f1e0451cc60590a05617aa4f502b672"
    },
    {
      "key": "baker_finish_2",
      "nodeTitle": "node",
      "sourceText": "Paris sent le pain frais !",
      "sourceEnText": "Paris smells like fresh bread!",
      "audioFile": "fr_01_baker_finish_2.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1463,
      "updatedAt": "2026-08-24T18:18:12Z",
      "textHash": "12371d50ca95b3109d8404f6a8b307c5270d3c70b411f488e4b33916da2a3960"
    },
    {
      "key": "baker_r1",
      "nodeTitle": "talk_baker",
      "sourceText": "Super ! Nous avons de la farine.",
      "sourceEnText": "Great! We have flour.",
      "audioFile": "fr_01_baker_r1.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 2116,
      "updatedAt": "2026-08-24T18:19:15Z",
      "textHash": "97180a433fffa9d4621fa62aaac52364daec0779fbf9fbe686ffc82c8f6b1140"
    },
    {
      "key": "baker_r2",
      "nodeTitle": "talk_baker",
      "sourceText": "Allez à Notre-Dame.",
      "sourceEnText": "Go to Notre-Dame.",
      "audioFile": "fr_01_baker_r2.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1123,
      "updatedAt": "2026-08-24T18:19:13Z",
      "textHash": "6e39325f726ebe91614542f3ed8994598bfd48e0baf654610cdcc67ac005caca"
    },
    {
      "key": "baker_r3",
      "nodeTitle": "talk_baker",
      "sourceText": "Du sel ! Bravo.",
      "sourceEnText": "Salt! Well done.",
      "audioFile": "fr_01_baker_r3.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1228,
      "updatedAt": "2026-08-24T18:19:01Z",
      "textHash": "de5b45fda6bbca871c3debe5c1abf797db53e812aa65c21e27b055db0dea30ce"
    },
    {
      "key": "baker_r4",
      "nodeTitle": "talk_baker",
      "sourceText": "Antura prit l'eau et se rendit au Louvre.",
      "sourceEnText": "Antura took the water and went to the Louvre.",
      "audioFile": "fr_01_baker_r4.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 2116,
      "updatedAt": "2026-08-24T18:18:59Z",
      "textHash": "ee7245d8b9050a8a951574e9165d7457406c0a278dc71b8e357f53c0d7e08d64"
    },
    {
      "key": "baker_r5",
      "nodeTitle": "talk_baker",
      "sourceText": "Parfait ! Nous avons de l'eau.",
      "sourceEnText": "Perfect! We have water.",
      "audioFile": "fr_01_baker_r5.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1776,
      "updatedAt": "2026-08-24T18:18:54Z",
      "textHash": "e63605c87464408fa7a81cc22452609c187e51ff73b178a24955096d16acec88"
    },
    {
      "key": "baker_r6",
      "nodeTitle": "talk_baker",
      "sourceText": "Peut-être que la levure se trouve à l'Arc de Triomphe.",
      "sourceEnText": "Maybe the yeast is at the Arc de Triomphe.",
      "audioFile": "fr_01_baker_r6.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 2560,
      "updatedAt": "2026-08-24T18:18:52Z",
      "textHash": "b82a7c56bfb776009ebb19be233e5127ea1027d8082c0cc972bf8b84af83e90f"
    },
    {
      "key": "chest_unlocked",
      "nodeTitle": "eiffell_activity_done",
      "sourceText": "Le coffre s'ouvre.",
      "sourceEnText": "The chest is now unlocked.",
      "audioFile": "fr_01_chest_unlocked.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "Default",
      "durationMs": 1123,
      "updatedAt": "2026-08-24T18:17:20Z",
      "textHash": "9475fec403ec31f2cc8cd740ff710be5cf288ce29af2b2dc91f50c3ccc906440"
    },
    {
      "key": "come_back_later",
      "nodeTitle": "talk_notre_dame",
      "sourceText": "Reviens quand tu as trouvé.",
      "sourceEnText": "Come back later.",
      "audioFile": "fr_01_come_back_later.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 1411,
      "updatedAt": "2026-08-24T18:17:29Z",
      "textHash": "8e0fad5a94a6ecb7e6c932d6e9d91ab6c449c10192e933cfea80c9edbc2a1c21"
    },
    {
      "key": "fr01_bakery_1",
      "nodeTitle": "npc_bakery",
      "sourceText": "L'odeur du pain frais rend les gens heureux.",
      "sourceEnText": "Fresh bread smell makes people happy.",
      "audioFile": "fr_01_fr01_bakery_1.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 2351,
      "updatedAt": "2026-08-24T18:19:32Z",
      "textHash": "c575d7f3dee7808f54d1305659fc4f66ced7737a4606ea7c342315ae9da09995"
    },
    {
      "key": "fr01_bakery_2",
      "nodeTitle": "npc_bakery",
      "sourceText": "Une baguette est composée de farine, d'eau, de levure et de sel.",
      "sourceEnText": "A baguette needs flour, water, yeast, and salt.",
      "audioFile": "fr_01_fr01_bakery_2.mp3",
      "voiceProfile": "clement_fr",
      "actorId": "SENIOR_M",
      "durationMs": 3318,
      "updatedAt": "2026-08-24T18:19:33Z",
      "textHash": "8e83cb6efabe838ae8f0bbd84f2f9bd3bd5b21370a3fe324c741c556180f073b"
    },
    {
      "key": "fr01_bakery_2a",
      "nodeTitle": "npc_bakery",
      "sourceText": "La levure permet au pain de lever.",
