      "textHash": "bc806310f38a5f4c5f320c38a02adc1b4146d31fe51bf5bf5e971af5d756269c"
    },
    {
      "key": "prot_5",
      "nodeTitle": "protagonist",
      "sourceText": "Au secours ! Antura a pris mon guide de Wrocław pour un os !",
      "sourceEnText": "Help! Antura thought my Wrocław Guide was a bone!",
