      "textHash": "8ddd0fb460d4d10484a7655822f665c70574bc539550746b6bde373c7fbfbcd8"
    },
    {
      "key": "prot_4",
      "nodeTitle": "protagonist",
      "sourceText": "Cherchez les coffres ! Les gens au bord de la rivière les surveillent.",
      "sourceEnText": "Look for the chests! The people by the river watch over them.",
