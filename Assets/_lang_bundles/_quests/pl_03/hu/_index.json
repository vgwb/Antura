  "lang": "hu",
  "lines": [
    {
      "key": "006ab27",
      "nodeTitle": "protagonist",
      "sourceText": "Bátor vagy! De még mindig hiányoznak a folyóparti csodáinkról készült fotók.",
      "sourceEnText": "You are brave! But I still miss photos of our river wonders.",
      "audioFile": "pl_03_006ab27.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 4989,
      "updatedAt": "2026-09-04T17:24:16Z",
      "textHash": "5da8868f28e4af8515ff139cdabec1e4a6f0e2b29cf075df2a59033c4f787530"
    },
    {
      "key": "0265d07",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Rajzolj egy egyszerű TÉRKÉPET az utazásodról.",
      "sourceEnText": "Draw a simple MAP of your journey.",
      "audioFile": "pl_03_0265d07.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2795,
      "updatedAt": "2026-09-04T17:24:22Z",
      "textHash": "d3f04f5e582e4f064686a62e06ade3f5bc96f2d29167cf7ad198c9d7e1f28e9f"
    },
    {
      "key": "02a257c",
      "nodeTitle": "quest_end",
      "sourceText": "Gratulálok!",
      "sourceEnText": "Well done!",
      "audioFile": "pl_03_02a257c.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1123,
      "updatedAt": "2026-09-04T17:24:29Z",
      "textHash": "5c8b1949a12bbb27c6143d50b70c3585fee36e269df81c96cac86be5e4225a1d"
    },
    {
      "key": "03ea48b",
      "nodeTitle": "protagonist",
      "sourceText": "Jól csinálod!",
      "sourceEnText": "You are doing well!",
      "audioFile": "pl_03_03ea48b.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 993,
      "updatedAt": "2026-09-04T17:24:10Z",
      "textHash": "3b3ab080ecc3810420eb624ffd578dc06b9eebe47b714849a75aa629f2e489b2"
    },
    {
      "key": "0577d80",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Annyi HÍD van ebben a városban.",
      "sourceEnText": "So many BRIDGES in this city.",
      "audioFile": "pl_03_0577d80.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_M",
      "durationMs": 1881,
      "updatedAt": "2026-09-04T17:25:45Z",
      "textHash": "3fb51b6992d7a12a2dae91700e444e438e4e1e2cc41b33df676124a38854149c"
    },
    {
      "key": "07ff8c5",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Imádom a Pierogit!",
      "sourceEnText": "I love Pierogi!",
      "audioFile": "pl_03_07ff8c5.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_M",
      "durationMs": 1306,
      "updatedAt": "2026-09-04T17:25:48Z",
      "textHash": "4eac2794c674516fcba64e931e0317725c6741dc5dd402e4bc7209cc94f4c58b"
    },
    {
      "key": "089ea37",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Wrocław tényleg gyönyörű.",
      "sourceEnText": "Wroclaw is really beautiful.",
      "audioFile": "pl_03_089ea37.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_M",
      "durationMs": 1515,
      "updatedAt": "2026-09-04T17:25:46Z",
      "textHash": "b4378e28ee746915e92572d2d632e1ba5f4849df6b977130fcb1e84f13a9720e"
    },
    {
      "key": "0bfcb05",
      "nodeTitle": "protagonist",
      "sourceText": "Ha nem találod őket, használd a térképet!",
      "sourceEnText": "If you can't find them, use the map!",
      "audioFile": "pl_03_0bfcb05.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2377,
      "updatedAt": "2026-09-04T17:24:12Z",
      "textHash": "dedb5ed80fc71255d3a30d68ac4cbc527d923ddcdf17570da9729e49c535f80a"
    },
    {
      "key": "0f36b7f",
      "nodeTitle": "spawned_kayak",
      "sourceText": "Egy kis KAJAK-kal szeretnék utazni.",
      "sourceEnText": "I want to ride a small KAYAK.",
      "audioFile": "pl_03_0f36b7f.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_M",
      "durationMs": 1959,
      "updatedAt": "2026-09-04T17:25:39Z",
      "textHash": "9d834ffc05bc3630265435f7d5df31962f4b3a7a0c374711136b0fd48806768a"
    },
    {
      "key": "barge_1",
      "nodeTitle": "npc_boat_barge",
      "sourceText": "A bárkák (barki) évszázadok óta szállítottak szenet és homokot az Odrán.",
      "sourceEnText": "Barges (Barki) have carried coal and sand on the Odra for centuries.",
      "audioFile": "pl_03_barge_1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 4571,
      "updatedAt": "2026-09-04T17:25:26Z",
      "textHash": "a012629e65df14196cbe30928e9e254f51baf2755c6b0e8098647fe43245f7f8"
    },
    {
      "key": "barge_2",
      "nodeTitle": "npc_boat_barge",
      "sourceText": "Egy uszály nagyon lapos. Miért?",
      "sourceEnText": "A barge is very flat. Why?",
      "audioFile": "pl_03_barge_2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2116,
      "updatedAt": "2026-09-04T17:25:28Z",
      "textHash": "b11e21f80a1e56d9d05e560c1fe9d17bc2b908b0acfc3dcda5ae42581e30608a"
    },
    {
      "key": "barge_3",
      "nodeTitle": "npc_boat_barge",
      "sourceText": "Nehéz dolgokat cipelni akkor is, ha nem mély a víz.",
      "sourceEnText": "To carry heavy things even when the water is not deep.",
      "audioFile": "pl_03_barge_3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2795,
      "updatedAt": "2026-09-04T17:25:30Z",
      "textHash": "d3b9532f3e7c94efaee3f3761203c28853e53e2171dd328e74f681bdccaabd41"
    },
    {
      "key": "barge_4",
      "nodeTitle": "npc_boat_barge",
      "sourceText": "Pontosan! Ez egy úszó teherautó.",
      "sourceEnText": "Exactly! It's a truck that floats.",
      "audioFile": "pl_03_barge_4.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2142,
      "updatedAt": "2026-09-04T17:25:32Z",
      "textHash": "a898c14a08e0aa61e9b1854a590b12283cc893eccbb2cb10094592354b46b6ed"
    },
    {
      "key": "barge_5",
      "nodeTitle": "npc_boat_barge",
      "sourceText": "Így elbújhat a törpék elől",
      "sourceEnText": "So it can hide from dwarves",
      "audioFile": "pl_03_barge_5.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1593,
      "updatedAt": "2026-09-04T17:25:34Z",
      "textHash": "993013803f7b188933e0fe419d973e0ac6d1aed700b7d0bbd4609d8b6fd8089b"
    },
    {
      "key": "ch_house1",
      "nodeTitle": "chest_boat_house",
      "sourceText": "Javítsd meg az úszó ház ablakait!",
      "sourceEnText": "Fix the windows on the floating house!",
      "audioFile": "pl_03_ch_house1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-09-04T17:25:07Z",
      "textHash": "d30ba5601370d8eab80e6cb83d60d136fa369b2fdb787abbfe66ccf8d8e7db31"
    },
    {
      "key": "ch_house2",
      "nodeTitle": "chest_boat_house",
      "sourceText": "Egy hangulatos otthon az Odera folyón! Fotó: collection.",
      "sourceEnText": "A cozy home on the Odra! Photo collected.",
      "audioFile": "pl_03_ch_house2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3500,
      "updatedAt": "2026-09-04T17:25:09Z",
      "textHash": "b0ffba763110dc7e31b081c48eb7c178aff33404e20cdccd87779d6706a66d3f"
    },
    {
      "key": "ch_map1",
      "nodeTitle": "chest_odra_map",
      "sourceText": "Bizonyítsd be, hogy tudod, merre folyik a folyó!",
      "sourceEnText": "Prove you know where the river flows!",
      "audioFile": "pl_03_ch_map1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2377,
      "updatedAt": "2026-09-04T17:23:15Z",
      "textHash": "ffe5d5a0e6db4fae8d8045b248ffb58b27c4f1e71d56d19feb3966866872756e"
    },
    {
      "key": "ch_map2",
      "nodeTitle": "chest_odra_map",
      "sourceText": "Visszatért a térkép! Az Odera folyót mutatja a Balti-tengerbe.",
      "sourceEnText": "The map is back! It shows the Odra flowing into the Baltic Sea.",
      "audioFile": "pl_03_ch_map2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 4049,
      "updatedAt": "2026-09-04T17:23:13Z",
      "textHash": "186e7844fe382cc64c026c12f88c1e717e84f121a8b94a5dc373472501cd811d"
    },
    {
      "key": "ch_redz1",
      "nodeTitle": "chest_redzinski_bridge",
      "sourceText": "Újjáépítik Wrocław legnagyobb hídját!",
      "sourceEnText": "Rebuild the biggest bridge in Wrocław!",
      "audioFile": "pl_03_ch_redz1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-09-04T17:24:36Z",
      "textHash": "34bbef0b3908bb3b09c570284e57125e40f04a06c8a0fa4f5eb94a8cd0dc7348"
    },
    {
      "key": "ch_sign1",
      "nodeTitle": "chest_river_sign",
      "sourceText": "Antura beborította a táblát sárral! Töröld le, hogy lásd a hullámokat.",
      "sourceEnText": "Antura covered the sign in mud! Wipe it clean to see the waves.",
      "audioFile": "pl_03_ch_sign1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 4467,
      "updatedAt": "2026-09-04T17:23:29Z",
      "textHash": "b111a310dc02b6b2a42f2c17a6d2f6a2049161b1e317685c21ded0c2771bde0a"
    },
    {
      "key": "ch_sign2",
      "nodeTitle": "chest_river_sign",
      "sourceText": "Remek munka! Mostantól mindig tudni fogod, mikor kelsz át egy folyón Európában.",
      "sourceEnText": "Great job! Now you'll always know when you're crossing a river in Europe.",
      "audioFile": "pl_03_ch_sign2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 4650,
      "updatedAt": "2026-09-04T17:23:28Z",
      "textHash": "cc207e67515196f964753b4747b341b8e07f0216f6b1bb08695e287afad5c4ce"
    },
    {
      "key": "ch_tour1",
      "nodeTitle": "chest_boat_people",
      "sourceText": "Találd meg a fedélzeten elrejtett turistákat!",
      "sourceEnText": "Find the tourists hidden on the deck!",
      "audioFile": "pl_03_ch_tour1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2482,
      "updatedAt": "2026-09-04T17:25:24Z",
      "textHash": "08ac007222e6ff046c555ad721870bcea5eaf177b00f07057ce53f95f65dcd7f"
    },
    {
      "key": "ch_train1",
      "nodeTitle": "chest_bridge_train",
      "sourceText": "Párosítsd a nehéz dobozokat a vasúti sínekkel!",
      "sourceEnText": "Match the heavy boxes to the train tracks!",
      "audioFile": "pl_03_ch_train1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2978,
      "updatedAt": "2026-09-04T17:24:52Z",
      "textHash": "6cc94e280f32afd272eec34b945e8a62ad70297d47c21103ba0144921eb3d872"
    },
    {
      "key": "ch_tum1",
      "nodeTitle": "chest_tumski_bridge",
      "sourceText": "Tisztítsd le a rozsdát erről a régi vashídról!",
      "sourceEnText": "Clean the rust off this old iron bridge!",
      "audioFile": "pl_03_ch_tum1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2612,
      "updatedAt": "2026-09-04T17:23:01Z",
      "textHash": "535df3aad76dbea39d57dde26249569ed7aa524a82c3410c0c90417e19336d7e"
    },
    {
      "key": "chest_empty",
      "nodeTitle": "chest_river_sign",
      "sourceText": "A mellkas üres.",
      "sourceEnText": "The chest is empty.",
      "audioFile": "pl_03_chest_empty.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1280,
      "updatedAt": "2026-09-04T17:23:26Z",
      "textHash": "9fe99f3f6ae173b5cfce99c3cfdbdf97530e4c07afdc33b1a69ab8fbdd234cca"
    },
    {
      "key": "chest_locked",
      "nodeTitle": "chest_river_sign",
      "sourceText": "A mellkas zárva van.",
      "sourceEnText": "The chest is locked.",
      "audioFile": "pl_03_chest_locked.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1411,
      "updatedAt": "2026-09-04T17:23:24Z",
      "textHash": "56370b0ec273031134874b307db980906731c1bb5efdaba0d1e7d0b45d98e68e"
    },
    {
      "key": "chest_minigame",
      "nodeTitle": "chest_boat_barge",
      "sourceText": "Játssz egy mini játékot a láda kinyitásához!",
      "sourceEnText": "Play a mini game to open the chest!",
      "audioFile": "pl_03_chest_minigame.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2900,
      "updatedAt": "2026-09-04T17:25:36Z",
      "textHash": "d1fbf8db83751d8369e08cd23528a2ff0f359c6463b40d60e26316ae5ba8f981"
    },
    {
      "key": "chest_opens",
      "nodeTitle": "chest_boat_barge",
      "sourceText": "A láda kinyílik. Találsz egy fotót!",
      "sourceEnText": "The chest opens. You find a photo!",
      "audioFile": "pl_03_chest_opens.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2116,
      "updatedAt": "2026-09-04T17:25:37Z",
      "textHash": "abf83efe5d595d29041e2f2be3b00025adf742e315d053584129ceb9d90ab5e3"
    },
    {
      "key": "dont_know",
      "nodeTitle": "npc_river_sign",
      "sourceText": "Nem tudom",
      "sourceEnText": "I don't know",
      "audioFile": "pl_03_dont_know.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 705,
      "updatedAt": "2026-09-04T17:23:31Z",
      "textHash": "099c47eff0972328fa4832ed702e7410bb3558aae798c50b3f03b1f856e1f501"
    },
    {
      "key": "dontknow",
      "nodeTitle": "final_quiz",
      "sourceText": "Nem tudom",
      "sourceEnText": "I don't know",
      "audioFile": "pl_03_dontknow.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 758,
      "updatedAt": "2026-09-04T17:23:51Z",
      "textHash": "099c47eff0972328fa4832ed702e7410bb3558aae798c50b3f03b1f856e1f501"
    },
    {
      "key": "end_1",
      "nodeTitle": "quest_end",
      "sourceText": "Ismerkedtünk meg a különböző típusú hidakkal.",
      "sourceEnText": "We learned about different types of bridges.",
      "audioFile": "pl_03_end_1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2952,
      "updatedAt": "2026-09-04T17:24:27Z",
      "textHash": "bef4b73bfaa44587aaf51344a2780745bd4c31f01524a7a276c44304f21ac1d3"
    },
    {
      "key": "end_2",
      "nodeTitle": "quest_end",
      "sourceText": "Ismerkedtünk meg a különböző hajófajtákkal.",
      "sourceEnText": "We learned about different types of boats.",
      "audioFile": "pl_03_end_2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2900,
      "updatedAt": "2026-09-04T17:24:25Z",
      "textHash": "446b1d69359b5b04a8d8efc20719356caebabf0036d7ea269baa0da4b40ab32c"
    },
    {
      "key": "end_3",
      "nodeTitle": "quest_end",
      "sourceText": "Felfedeztük az ODRA folyót.",
      "sourceEnText": "We explored the ODRA RIVER.",
      "audioFile": "pl_03_end_3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1776,
      "updatedAt": "2026-09-04T17:24:23Z",
      "textHash": "196d3fdaa64ef76e681b4fb2a8b0b4f97b72e18b370483572d2920f290608b66"
    },
    {
      "key": "fail_redz",
      "nodeTitle": "npc_redzinski_bridge",
      "sourceText": "Úgy néz ki, mint egy varázslat, de valójában mérnöki munka!",
      "sourceEnText": "It looks like magic, but it's actually engineering!",
      "audioFile": "pl_03_fail_redz.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3082,
      "updatedAt": "2026-09-04T17:22:49Z",
      "textHash": "01789995933ca55c5eedfd32f0c05456b92b51219edfa2c024e6a720db6760f6"
    },
    {
      "key": "fail_tour",
      "nodeTitle": "npc_boat_people",
      "sourceText": "Még nem vagyunk víz alatt! Próbáld újra.",
      "sourceEnText": "We aren't underwater yet! Try again.",
      "audioFile": "pl_03_fail_tour.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2247,
      "updatedAt": "2026-09-04T17:25:22Z",
      "textHash": "daa939eeafd3eee05f47713838cf4af8b86103ef6f16ee457c50ce05e8fa50e6"
    },
    {
      "key": "fail_train",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "Hangosak, de nem ezért!",
      "sourceEnText": "They are loud, but that's not why!",
      "audioFile": "pl_03_fail_train.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1515,
      "updatedAt": "2026-09-04T17:24:50Z",
      "textHash": "0e0f262157560848f8637bc48880bb2fd5209eab207c2f393036f3cc9e73b863"
    },
    {
      "key": "fail_tum",
      "nodeTitle": "npc_tumski_bridge",
      "sourceText": "Az nem lenne túl romantikus! Próbáld újra.",
      "sourceEnText": "That would not be very romantic! Try again.",
      "audioFile": "pl_03_fail_tum.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2534,
      "updatedAt": "2026-09-04T17:23:02Z",
      "textHash": "df153fbfd17cecfbe76cc8d53f2bf2da96d094eadc55abcb54d72e7a6c87fa07"
    },
    {
      "key": "found_photos",
      "nodeTitle": "task_find_photos_done",
      "sourceText": "Megtaláltad az összes képet!",
      "sourceEnText": "You found all the photos!",
      "audioFile": "pl_03_found_photos.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 1646,
      "updatedAt": "2026-09-04T17:24:06Z",
      "textHash": "ad958d10d0ec72575d65ae7219fd35dfe22363e972fb22279a94e7d1e6f98f52"
    },
    {
      "key": "go_back",
      "nodeTitle": "task_find_photos_done",
      "sourceText": "Menj vissza, és beszélj az idegenvezetővel.",
      "sourceEnText": "Go back and talk to the guide.",
      "audioFile": "pl_03_go_back.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2534,
      "updatedAt": "2026-09-04T17:24:04Z",
      "textHash": "76676d151423d493a6babca7f10c9da33b2377d5925ed00046d701a981c18172"
    },
    {
      "key": "house_1",
      "nodeTitle": "npc_boat_house",
      "sourceText": "Wrocławban egyesek a folyót \"szülőutcájuknak\" nevezik.",
      "sourceEnText": "In Wrocław, some people call the river their \"home street.\"",
      "audioFile": "pl_03_house_1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3135,
      "updatedAt": "2026-09-04T17:24:55Z",
      "textHash": "145b241b053d60780a5aa72142172595744f1ea4961f9b9681fad6c6a995d261"
    },
    {
      "key": "house_2",
      "nodeTitle": "npc_boat_house",
      "sourceText": "Még a törpék is imádnának egy úszó házat!",
      "sourceEnText": "Even the dwarves would love a floating house!",
      "audioFile": "pl_03_house_2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2612,
      "updatedAt": "2026-09-04T17:24:57Z",
      "textHash": "9d96a40b34c2a4bd82bdb03322f3974bb64bf6390636c297283b9264d23bfdbf"
    },
    {
      "key": "house_3",
      "nodeTitle": "npc_boat_house",
      "sourceText": "Ha lakóhajón élsz, mit használsz hátsó udvarnak?",
      "sourceEnText": "If you live on a houseboat, what do you use for a backyard?",
      "audioFile": "pl_03_house_3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2900,
      "updatedAt": "2026-09-04T17:25:00Z",
      "textHash": "585a5cb2c4403802b0fa33ac39a75fddab4f0be90796a3ab6224718cc2ad4354"
    },
    {
      "key": "house_4",
      "nodeTitle": "npc_boat_house",
      "sourceText": "Az Odra folyó",
      "sourceEnText": "The River Odra",
      "audioFile": "pl_03_house_4.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 993,
      "updatedAt": "2026-09-04T17:25:02Z",
      "textHash": "52509bb45955b93a6ea0c0f33971efb38fe5f0e994ab2a28874a6f3b31219ac6"
    },
    {
      "key": "house_6",
      "nodeTitle": "npc_boat_house",
      "sourceText": "Egy tetőtéri erdő",
      "sourceEnText": "A rooftop forest",
      "audioFile": "pl_03_house_6.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1698,
      "updatedAt": "2026-09-04T17:25:04Z",
      "textHash": "94edc3566057f3d34f4907543a779ee9f00fa62a56de39666b599d1f72b0cd95"
    },
    {
      "key": "kayak_2",
      "nodeTitle": "spawned_kayak",
      "sourceText": "A kajakok nagyszerűek a természet felfedezéséhez!",
      "sourceEnText": "Kayaks are great for exploring nature!",
      "audioFile": "pl_03_kayak_2.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_M",
      "durationMs": 3135,
      "updatedAt": "2026-09-04T17:25:41Z",
      "textHash": "a91e78b310c75b966d24cd7aabaf1815368b7361a0114e72cc9e95775cc28546"
    },
    {
      "key": "kayak_3",
      "nodeTitle": "spawned_kayak",
      "sourceText": "A pancsolás szórakoztató és jó testmozgás!",
      "sourceEnText": "Paddling is fun and good exercise!",
      "audioFile": "pl_03_kayak_3.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_M",
      "durationMs": 2769,
      "updatedAt": "2026-09-04T17:25:43Z",
      "textHash": "3a67fc44b0ed5fb2f9c97a953afd3dc986b55b9e924ea57afa3208581fb20a2d"
    },
    {
      "key": "map_1",
      "nodeTitle": "npc_odra_map",
      "sourceText": "Az Odera Lengyelország második leghosszabb folyója.",
      "sourceEnText": "The Odra is Poland's second longest river.",
      "audioFile": "pl_03_map_1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3030,
      "updatedAt": "2026-09-04T17:23:23Z",
      "textHash": "0bed6c27f947298dd4c5745365e4f647f4a6bcbd5696d891db747cf8dd4173db"
    },
    {
      "key": "map_2",
      "nodeTitle": "npc_odra_map",
      "sourceText": "Az Odra a hegyekbe vagy a tengerbe folyik?",
      "sourceEnText": "Does the Odra flow into the mountains or the sea?",
      "audioFile": "pl_03_map_2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2247,
      "updatedAt": "2026-09-04T17:23:21Z",
      "textHash": "09b45b4a2a7d71417ae964e19ddb6e3f60bd4dd9ef4f78386bb4aea7e4e3ddf4"
    },
    {
      "key": "map_3",
      "nodeTitle": "npc_odra_map",
      "sourceText": "A Balti-tenger",
      "sourceEnText": "The Baltic Sea",
      "audioFile": "pl_03_map_3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1123,
      "updatedAt": "2026-09-04T17:23:20Z",
      "textHash": "d1605f750726c9df6a6031e52c39ced5b0c041105d92ba082d053237200a65d0"
    },
    {
      "key": "map_4",
      "nodeTitle": "npc_odra_map",
      "sourceText": "Helyes! Egészen északig folyik.",
      "sourceEnText": "Correct! It flows all the way to the north.",
      "audioFile": "pl_03_map_4.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2116,
      "updatedAt": "2026-09-04T17:23:18Z",
      "textHash": "ec15c41dc930ccf65547c68beffe9d0609c98e078c4876f75300039b781556ef"
    },
    {
      "key": "map_5",
      "nodeTitle": "npc_odra_map",
      "sourceText": "A Földközi-tenger",
      "sourceEnText": "The Mediterranean Sea",
      "audioFile": "pl_03_map_5.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1463,
      "updatedAt": "2026-09-04T17:23:17Z",
      "textHash": "8995440972bbd55e4d9cb9c9985470910e122b095c6919360d3820111ca48b18"
    },
    {
      "key": "prot_1",
      "nodeTitle": "protagonist",
      "sourceText": "Dziękuję! Az összes fotómat megtaláltad!",
      "sourceEnText": "Dziękuję! You found all my photos!",
      "audioFile": "pl_03_prot_1.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2534,
      "updatedAt": "2026-09-04T17:24:20Z",
      "textHash": "285b43931158c168836083d3765a0be58ded00d4192c53a162b0f67e1ef36a98"
    },
    {
      "key": "prot_2",
      "nodeTitle": "protagonist",
      "sourceText": "Most már folytathatom a látogatást. Egy utolsó kérdés...",
      "sourceEnText": "Now I can continue the visit. One last question...",
      "audioFile": "pl_03_prot_2.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 3265,
      "updatedAt": "2026-09-04T17:24:18Z",
      "textHash": "0eafc81822c048f7ac281e408956adb1a4b13f4dc1a513a2ef53ff03807206c6"
    },
    {
      "key": "prot_4",
      "nodeTitle": "protagonist",
      "sourceText": "Keresd a ládákat! Az emberek a folyóparton őrködnek felettük.",
      "sourceEnText": "Look for the chests! The people by the river watch over them.",
      "audioFile": "pl_03_prot_4.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 4049,
      "updatedAt": "2026-09-04T17:24:14Z",
      "textHash": "be9ffa508210e944ad7003f9a1ee4dc2b554496736b1e88e86152ad72a171fec"
    },
    {
      "key": "prot_5",
      "nodeTitle": "protagonist",
      "sourceText": "Segítség! Antura azt hitte, hogy a wrocławi kalauzom egy csont!",
      "sourceEnText": "Help! Antura thought my Wrocław Guide was a bone!",
      "audioFile": "pl_03_prot_5.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 3396,
      "updatedAt": "2026-09-04T17:24:09Z",
      "textHash": "6ed2e57420f30da3b9bd2dd9d83c35e817b180075e9f314a7fab1bf122a373c2"
    },
    {
      "key": "prot_6",
      "nodeTitle": "protagonist",
      "sourceText": "Elvesznek az oldalak. Megtalálod őket?",
      "sourceEnText": "The pages are lost around. Can you find them?",
      "audioFile": "pl_03_prot_6.mp3",
      "voiceProfile": "shelley",
      "actorId": "SENIOR_M",
      "durationMs": 2247,
      "updatedAt": "2026-09-04T17:24:07Z",
      "textHash": "397c52d9f755852af7c38e3f2baaf56e79c9bd1cad3cbf9260ecf9cf468c734f"
    },
    {
      "key": "quiz1_fail1",
      "nodeTitle": "final_quiz",
      "sourceText": "Hmm... az túl délre van!",
      "sourceEnText": "Hmm... that's much too far south!",
      "audioFile": "pl_03_quiz1_fail1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1646,
      "updatedAt": "2026-09-04T17:23:56Z",
      "textHash": "569751d8020d18632f44925d14951198c264fed9a8eefd0f249bec517dec1326"
    },
    {
      "key": "quiz1_fail2",
      "nodeTitle": "final_quiz",
      "sourceText": "Nem egészen. Az Odra észak felé tart, nem dél felé!",
      "sourceEnText": "Not quite. The Odra heads North, not South!",
      "audioFile": "pl_03_quiz1_fail2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2847,
      "updatedAt": "2026-09-04T17:23:53Z",
      "textHash": "4dae758444e5024749467de82bc7ef865ac6c9f2db8155a4d8b4c1ff7445d65f"
    },
    {
      "key": "quiz1_hint",
      "nodeTitle": "final_quiz",
      "sourceText": "Semmi gond! Nézd meg a kék vonalat a térképen.",
      "sourceEnText": "No worries! Look at the blue line on the map.",
      "audioFile": "pl_03_quiz1_hint.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2900,
      "updatedAt": "2026-09-04T17:23:50Z",
      "textHash": "e45aba587ce68d40ba7531868db319cf4b5a56b0bb9b9d6ba72a86f5834d34f2"
    },
    {
      "key": "quiz1_intro",
      "nodeTitle": "final_quiz",
      "sourceText": "Az Odra egy hosszú folyó. Emlékszel, hová torkollik a víz?",
      "sourceEnText": "The Odra is a long river. Do you remember where all that water ends up?",
      "audioFile": "pl_03_quiz1_intro.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3187,
      "updatedAt": "2026-09-04T17:24:03Z",
      "textHash": "381c53b83abce58c3bfcf1920c5db62aa4fd56467610d21906e4ea5fa178452e"
    },
    {
      "key": "quiz1_ok",
      "nodeTitle": "final_quiz",
      "sourceText": "Tak! Így van! Az Odera észak felé folyik Lengyelországon keresztül, és a Balti-tengerbe ömlik.",
      "sourceEnText": "Tak! Correct! The Odra flows north across Poland and into the Baltic Sea.",
      "audioFile": "pl_03_quiz1_ok.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 5878,
      "updatedAt": "2026-09-04T17:23:59Z",
      "textHash": "55b71bf59bcb5bb99424e4357d7f9c0011c20f787f675221d00e27a8d99b384a"
    },
    {
      "key": "quiz2_a1",
      "nodeTitle": "final_quiz_2",
      "sourceText": "Nem, a Wisła hosszabb",
      "sourceEnText": "No, the Wisła is longer",
      "audioFile": "pl_03_quiz2_a1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1593,
      "updatedAt": "2026-09-04T17:23:47Z",
      "textHash": "bb58c7a63b1fa912e4cde2d91df718fa1348d1610d7defe42d5fedaba765cc03"
    },
    {
      "key": "quiz2_a2",
      "nodeTitle": "final_quiz_2",
      "sourceText": "Igen, ez a leghosszabb",
      "sourceEnText": "Yes, it is the longest",
      "audioFile": "pl_03_quiz2_a2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1280,
      "updatedAt": "2026-09-04T17:23:44Z",
      "textHash": "357fe71e2fa2a5b8bb868f87d28af2e20c2111362b0fd9c8e24cce4d3205fad1"
    },
    {
      "key": "quiz2_fail",
      "nodeTitle": "final_quiz_2",
      "sourceText": "Nagyon nagy, de van egy folyó, ami még hosszabb.",
      "sourceEnText": "It is very big, but there is one river that is even longer.",
      "audioFile": "pl_03_quiz2_fail.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2717,
      "updatedAt": "2026-09-04T17:23:42Z",
      "textHash": "529fce81c3754c6e29601d41e48133dac2573e9b10aa462cbbe28071b28fa5f9"
    },
    {
      "key": "quiz2_intro",
      "nodeTitle": "final_quiz_2",
      "sourceText": "Az Odera Lengyelország *leghosszabb* folyója?",
      "sourceEnText": "Is Odra the longest river in Poland?",
      "audioFile": "pl_03_quiz2_intro.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2429,
      "updatedAt": "2026-09-04T17:23:48Z",
      "textHash": "52cddd993579f9696cf6462aea2f4ce959bdc2b092d135c6fbb7084d209ea370"
    },
    {
      "key": "quiz2_ok",
      "nodeTitle": "final_quiz_2",
      "sourceText": "Tökéletes! A Wisła az első, az Odra a második leghosszabb.",
      "sourceEnText": "Perfect! The Wisła is number one, Odra is the second longest.",
      "audioFile": "pl_03_quiz2_ok.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3736,
      "updatedAt": "2026-09-04T17:23:45Z",
      "textHash": "b1544e50a9508767f878882bc7efd9964fe5e9a5d90666670dc861c8d085595e"
    },
    {
      "key": "quiz_a1",
      "nodeTitle": "final_quiz",
      "sourceText": "A Balti-tenger",
      "sourceEnText": "The Baltic Sea",
      "audioFile": "pl_03_quiz_a1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1228,
      "updatedAt": "2026-09-04T17:24:01Z",
      "textHash": "d1605f750726c9df6a6031e52c39ced5b0c041105d92ba082d053237200a65d0"
    },
    {
      "key": "quiz_a2",
      "nodeTitle": "final_quiz",
      "sourceText": "A Földközi-tenger",
      "sourceEnText": "The Mediterranean Sea",
      "audioFile": "pl_03_quiz_a2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1411,
      "updatedAt": "2026-09-04T17:23:58Z",
      "textHash": "8995440972bbd55e4d9cb9c9985470910e122b095c6919360d3820111ca48b18"
    },
    {
      "key": "quiz_a3",
      "nodeTitle": "final_quiz",
      "sourceText": "A Fekete-tenger",
      "sourceEnText": "The Black Sea",
      "audioFile": "pl_03_quiz_a3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1176,
      "updatedAt": "2026-09-04T17:23:55Z",
      "textHash": "ee1393e7faa12c88bcaba64db3b01844e708d4c799c10cec2842606edba814d5"
    },
    {
      "key": "redz_1",
      "nodeTitle": "npc_redzinski_bridge",
      "sourceText": "A Rędziński híd Lengyelország legmagasabb és leghosszabb hídja.",
      "sourceEnText": "The Rędziński Bridge is the tallest and longest in Poland.",
      "audioFile": "pl_03_redz_1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3866,
      "updatedAt": "2026-09-04T17:22:59Z",
      "textHash": "595c64951cac30fae7b585c784c4ea14ac68d985d9658d691f2b001248e11379"
    },
    {
      "key": "redz_2",
      "nodeTitle": "npc_redzinski_bridge",
      "sourceText": "122 méter magas. Magasabb, mint a katedrális!",
      "sourceEnText": "It is 122 meters tall. Higher than the Cathedral!",
      "audioFile": "pl_03_redz_2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2952,
      "updatedAt": "2026-09-04T17:22:57Z",
      "textHash": "296096999e27419721eac09701ec0494d26add24e3b20a271c7551f2a3d4577b"
    },
    {
      "key": "redz_3",
      "nodeTitle": "npc_redzinski_bridge",
      "sourceText": "Mi tartja fenn ezt a hatalmas hidat?",
      "sourceEnText": "What holds this massive bridge up?",
      "audioFile": "pl_03_redz_3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2194,
      "updatedAt": "2026-09-04T17:22:56Z",
      "textHash": "79c186970746c7b7cee1ec79d18e8bfed696a9f05ca1c8fcdf02c482d84bd07a"
    },
    {
      "key": "redz_4",
      "nodeTitle": "npc_redzinski_bridge",
      "sourceText": "Acélkábelek",
      "sourceEnText": "Steel cables",
      "audioFile": "pl_03_redz_4.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1280,
      "updatedAt": "2026-09-04T17:22:54Z",
      "textHash": "90ab98140d1ccda7a425b2e556ff4337042294a349f92d16dcad6041da9e9ec6"
    },
    {
      "key": "redz_5",
      "nodeTitle": "npc_redzinski_bridge",
      "sourceText": "Így van! Erős kötelek tartják ezt az óriási hidat. Az autók rajta közlekednek a városban.",
      "sourceEnText": "Correct! Strong ropes hold this giant bridge. Cars use it to drive around the city.",
      "audioFile": "pl_03_redz_5.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 5695,
      "updatedAt": "2026-09-04T17:22:53Z",
      "textHash": "05bf08c31213015697f446d5167485e666e44c601afb80e036760913a8a05db0"
    },
    {
      "key": "redz_6",
      "nodeTitle": "npc_redzinski_bridge",
      "sourceText": "Mágnesek és mágia",
      "sourceEnText": "Magnets and Magic",
      "audioFile": "pl_03_redz_6.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1593,
      "updatedAt": "2026-09-04T17:22:50Z",
      "textHash": "3e7c5e24b1b251fe5eb50fccce6514cbe1146178c7a9a2a8150eb9f75b3dcafb"
    },
    {
      "key": "sign_1",
      "nodeTitle": "npc_river_sign",
      "sourceText": "Nézd meg a nagy kék táblát a híd mellett.",
      "sourceEnText": "Look at the big blue sign near the bridge.",
      "audioFile": "pl_03_sign_1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2429,
      "updatedAt": "2026-09-04T17:23:40Z",
      "textHash": "2cfa5912e1e7c3d32104fc2722934fd70037bb316b0446fec7bda56613c96fe5"
    },
    {
      "key": "sign_3",
      "nodeTitle": "npc_river_sign",
      "sourceText": "Mit árulnak el nekünk a fehér hullámos vonalak?",
      "sourceEnText": "What do the white wavy lines tell us?",
      "audioFile": "pl_03_sign_3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2795,
      "updatedAt": "2026-09-04T17:23:39Z",
      "textHash": "e58839b6403066de6926672853c4b0b7392dfa29569ef22f7e6fd96c639f5e1a"
    },
    {
      "key": "sign_4",
      "nodeTitle": "npc_river_sign",
      "sourceText": "Itt egy folyó folyik",
      "sourceEnText": "There is a river flowing here",
      "audioFile": "pl_03_sign_4.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1411,
      "updatedAt": "2026-09-04T17:23:37Z",
      "textHash": "db5e5cfe124c136138885b80249beef5c2637cdad469afd42a725c388bfd0c75"
    },
    {
      "key": "sign_5",
      "nodeTitle": "npc_river_sign",
      "sourceText": "Tak! Azok a kék hullámok a folyók egyetemes jelei.",
      "sourceEnText": "Tak! Those blue waves are the universal sign for a river.",
      "audioFile": "pl_03_sign_5.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3318,
      "updatedAt": "2026-09-04T17:23:36Z",
      "textHash": "d2ee2b1bfc4ab0d20f077c2a0eeed0b22fb62b229ecf0e64b4286e3017ed21ea"
    },
    {
      "key": "sign_6",
      "nodeTitle": "npc_river_sign",
      "sourceText": "Hídmozgások",
      "sourceEnText": "There bridge moves",
      "audioFile": "pl_03_sign_6.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1280,
      "updatedAt": "2026-09-04T17:23:34Z",
      "textHash": "1f45a9c8b7d64d6766a8d28405ece83a3e2acec01f05bdf6eb53c268c652ee7c"
    },
    {
      "key": "start_1",
      "nodeTitle": "quest_start",
      "sourceText": "Wrocławban vagyunk, a „Száz híd városában”.",
      "sourceEnText": "We are in Wrocław, the \"City of a Hundred Bridges\".",
      "audioFile": "pl_03_start_1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2664,
      "updatedAt": "2026-09-04T17:24:34Z",
      "textHash": "5091eb1777cd6da3b7229e0b9e44eaa48ebe63b4c8df6034138c694c1c1803f6"
    },
    {
      "key": "start_2",
      "nodeTitle": "quest_start",
      "sourceText": "Ma a folyót, a hidakat és a hajókat fogjuk felfedezni.",
      "sourceEnText": "Today we will explore the river, bridges and boats.",
      "audioFile": "pl_03_start_2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3187,
      "updatedAt": "2026-09-04T17:24:31Z",
      "textHash": "225de2b9ff5983302e557c532ea9f527c8d2837b1fb48503a27010967bf70785"
    },
    {
      "key": "tour_1",
      "nodeTitle": "npc_boat_people",
      "sourceText": "Turistahajók viszik az embereket az Állatkertbe és a Székesegyházba.",
      "sourceEnText": "Tourist boats take people to see the Zoo and the Cathedral.",
      "audioFile": "pl_03_tour_1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 4101,
      "updatedAt": "2026-09-04T17:25:11Z",
      "textHash": "154c90f30a253e8759b2eb2df8329415e612e309c4cecd6b04b5a4bd69d60dd3"
    },
    {
      "key": "tour_2",
      "nodeTitle": "npc_boat_people",
      "sourceText": "Mivel nézik meg a nevezetességeket az ezeken a hajókon utazók?",
      "sourceEnText": "What do the people on these boats use to see the sights?",
      "audioFile": "pl_03_tour_2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3605,
      "updatedAt": "2026-09-04T17:25:13Z",
      "textHash": "83d56b94cb1a5db2d12c96dc0e14931c6b2533de805fadc2d9585702c7fc1f74"
    },
    {
      "key": "tour_3",
      "nodeTitle": "npc_boat_people",
      "sourceText": "A szemük és a kamerájuk",
      "sourceEnText": "Their eyes and cameras",
      "audioFile": "pl_03_tour_3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1698,
      "updatedAt": "2026-09-04T17:25:15Z",
      "textHash": "b251794126b3c5318791a3914ca39249baafcd2adfd51643d45130535f7c3c9a"
    },
    {
      "key": "tour_4",
      "nodeTitle": "npc_boat_people",
      "sourceText": "Igen! Mosolyogj a fotóhoz!",
      "sourceEnText": "Yes! Smile for the photo!",
      "audioFile": "pl_03_tour_4.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1724,
      "updatedAt": "2026-09-04T17:25:18Z",
      "textHash": "e000d0e386ad743055ebc5003e2355e2fd9eea9811bb31b8e88d8e5c91f9ee8b"
    },
    {
      "key": "tour_5",
      "nodeTitle": "npc_boat_people",
      "sourceText": "Egy periszkóp",
      "sourceEnText": "A periscope",
      "audioFile": "pl_03_tour_5.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1045,
      "updatedAt": "2026-09-04T17:25:20Z",
      "textHash": "70f268f945bcc11a83684e30919639798f4d09b6300b7b7e1ddbc2360f7b12c5"
    },
    {
      "key": "tourist_4",
      "nodeTitle": "spawned_tourist",
      "sourceText": "A katedrális szigete varázslatos éjszaka.",
      "sourceEnText": "The Cathedral island is magical at night.",
      "audioFile": "pl_03_tourist_4.mp3",
      "voiceProfile": "shelley",
      "actorId": "KID_M",
      "durationMs": 2612,
      "updatedAt": "2026-09-04T17:25:50Z",
      "textHash": "10dd57aeeeb07ed5ec47f65f014971d589af1aea1836c173a71d8fd177da4160"
    },
    {
      "key": "train_1",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "A vonatok több mint 150 éve közlekednek az Oderán Wrocławban.",
      "sourceEnText": "Trains have been crossing the Odra in Wrocław for over 150 years.",
      "audioFile": "pl_03_train_1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3788,
      "updatedAt": "2026-09-04T17:24:38Z",
      "textHash": "4529f3acb1d041753a13ac346680d8fb8a452375773a3b47403280b937021430"
    },
    {
      "key": "train_2",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "Miért készülnek a vasúti hidak ilyen nehéz acélból?",
      "sourceEnText": "Why are train bridges made of such heavy steel?",
      "audioFile": "pl_03_train_2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3082,
      "updatedAt": "2026-09-04T17:24:40Z",
      "textHash": "988fab7d5e53d367884db21eb3d4fed65b68b8073f1ff0b5e6ff29e1b239c38c"
    },
    {
      "key": "train_3",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "Mert a vonatok nagyon nehezek",
      "sourceEnText": "Because trains are very heavy",
      "audioFile": "pl_03_train_3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1776,
      "updatedAt": "2026-09-04T17:24:42Z",
      "textHash": "c3af3e25ca06b0df6121c69462f6b2582b194d16639f5bd230b6c7f9b1cc506c"
    },
    {
      "key": "train_4",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "Igen! Elég erősnek kell lennie a nehéz vonatokhoz.",
      "sourceEnText": "Yes! It must be strong enough for the heavy trains.",
      "audioFile": "pl_03_train_4.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3082,
      "updatedAt": "2026-09-04T17:24:45Z",
      "textHash": "4c2615a7e15136e52212d0cc1ac3a4575ceec0ad19f47eccae396151c3c7e195"
    },
    {
      "key": "train_5",
      "nodeTitle": "npc_bridge_train",
      "sourceText": "Hangos zajt csapni",
      "sourceEnText": "To make a loud noise",
      "audioFile": "pl_03_train_5.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1280,
      "updatedAt": "2026-09-04T17:24:47Z",
      "textHash": "3a1130bf7c56a8b50bd2aef3a75111f1ca6b2708370697dc40aeaa6253f69a96"
    },
    {
      "key": "try_again",
      "nodeTitle": "npc_river_sign",
      "sourceText": "Nem. Próbáld újra.",
      "sourceEnText": "No. Try again.",
      "audioFile": "pl_03_try_again.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1280,
      "updatedAt": "2026-09-04T17:23:32Z",
      "textHash": "08cf77e01178678147f6727f370e217f7f082d3da445f75643a9c93ae07b9083"
    },
    {
      "key": "tum_1",
      "nodeTitle": "npc_tumski_bridge",
      "sourceText": "Ez a Tumski híd. A város legrégebbi részébe vezet.",
      "sourceEnText": "This is the Tumski Bridge. It goes to the oldest part of the city.",
      "audioFile": "pl_03_tum_1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3448,
      "updatedAt": "2026-09-04T17:23:12Z",
      "textHash": "33f2425286a322c1a7042fa3355b1412aca6cd265e7b7ca8ceece44a1eb3b42a"
    },
    {
      "key": "tum_2",
      "nodeTitle": "npc_tumski_bridge",
      "sourceText": "Minden este egy férfi kézzel gyújtja meg a 102 gázlámpást!",
      "sourceEnText": "Every evening, a man lights the 102 gas lanterns here by hand!",
      "audioFile": "pl_03_tum_2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3500,
      "updatedAt": "2026-09-04T17:23:10Z",
      "textHash": "cc2fef3a5a5e9e363c57a5e7e715faa09363d1d91ff5a75a582e0bd138d43233"
    },
    {
      "key": "tum_3",
      "nodeTitle": "npc_tumski_bridge",
      "sourceText": "Mit akasztanak a párok erre a hídra szerencséért és szerelemért?",
      "sourceEnText": "What do couples hang on this bridge for luck and love?",
      "audioFile": "pl_03_tum_3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3605,
      "updatedAt": "2026-09-04T17:23:09Z",
      "textHash": "b4c10d8804e6d392a8739a507c8ecd83ea103e194664f96a8b66300c1bd26ed4"
    },
    {
      "key": "tum_4",
      "nodeTitle": "npc_tumski_bridge",
      "sourceText": "Lakatok",
      "sourceEnText": "Padlocks",
      "audioFile": "pl_03_tum_4.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 993,
      "updatedAt": "2026-09-04T17:23:07Z",
      "textHash": "47defe7ee502fbd01485fbbe0ea11359fc2d12e87da10cc713c57e35f522dab0"
    },
    {
      "key": "tum_5",
      "nodeTitle": "npc_tumski_bridge",
      "sourceText": "Igen! Bár nagyon nehezek, és el fogják távolítani őket!",
      "sourceEnText": "Yes! Though they are very heavy and will be removed!",
      "audioFile": "pl_03_tum_5.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3318,
      "updatedAt": "2026-09-04T17:23:05Z",
      "textHash": "701a76a09923529bfbcea2602c5e5a084175dd29324c3f845aebddc8b526096b"
    },
    {
      "key": "tum_6",
      "nodeTitle": "npc_tumski_bridge",
      "sourceText": "Nedves zoknik",
      "sourceEnText": "Wet socks",
      "audioFile": "pl_03_tum_6.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1280,
      "updatedAt": "2026-09-04T17:23:04Z",
      "textHash": "00faa1b401166cb93ea10fc6eab596c006ad2b383cd7ed4b6f6ce6b605a1f26d"
    },
    {
      "key": "yes_chest",
      "nodeTitle": "npc_river_sign",
      "sourceText": "Most már kinyithatod azt a ládát!",
      "sourceEnText": "Now you can open that chest!",
      "audioFile": "pl_03_yes_chest.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1881,
      "updatedAt": "2026-09-04T17:25:52Z",
      "textHash": "881e2aa9ee7f290c0244aeb8768650dfa27fc302f398557830a033998eebf55b"
    }
  ]
}