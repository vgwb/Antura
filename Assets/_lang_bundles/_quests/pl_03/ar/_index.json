    },
    {
      "key": "chest_minigame",
      "nodeTitle": "chest_boat_barge",
      "sourceText": "العب لعبة مصغرة لفتح الصندوق!",
      "sourceEnText": "Play a mini game to open the chest!",
      "audioFile": "pl_03_chest_minigame.mp3",
      "voiceProfile": "haytham",
      "actorId": "Default",
      "durationMs": 2717,
      "updatedAt": "2026-09-04T17:10:50Z",
      "textHash": "c78bd3ffdbb1dd89c125dd6dbee8235986b4f20aa81234e1b0c6f387bf8011a3"
    },
    {
      "key": "chest_opens",
      "nodeTitle": "chest_boat_barge",
      "sourceText": "يُفتح الصندوق. فتجد صورة!",
      "sourceEnText": "The chest opens. You find a photo!",
      "audioFile": "pl_03_chest_opens.mp3",
      "voiceProfile": "haytham",
