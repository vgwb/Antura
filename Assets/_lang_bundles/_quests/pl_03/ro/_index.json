      "key": "redz_5",
      "nodeTitle": "npc_redzinski_bridge",
      "sourceText": "Corect! Acest pod gigantic este susținut de frânghii puternice. Mașinile îl folosesc pentru a circula prin oraș.",
      "sourceEnText": "Correct! Strong ropes hold this giant bridge. Cars use it to drive around the city.",
      "audioFile": "pl_03_redz_5.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 6896,
      "updatedAt": "2026-09-04T17:32:34Z",
      "textHash": "6d863f5e59d6dd7829944e40c9dc345b544ba1864a486d231a46efd6a63bc5ac"
    },
