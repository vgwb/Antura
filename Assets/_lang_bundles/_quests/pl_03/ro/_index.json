    {
      "key": "ch_sign2",
      "nodeTitle": "chest_river_sign",
      "sourceText": "Bravo! Acum vei ști mereu când traversezi un râu în Europa.",
      "sourceEnText": "Great job! Now you'll always know when you're crossing a river in Europe.",
      "audioFile": "pl_03_ch_sign2.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 3788,
      "updatedAt": "2026-09-04T17:33:08Z",
      "textHash": "4cf6351b7f9c33e390724d22e06ded54fae71fc3273eade1911874a45a8caa8a"
    },
    {
      "key": "ch_tour1",
      "nodeTitle": "chest_boat_people",
      "sourceText": "Găsește turiștii ascunși pe punte!",
