      "textHash": "f1612927adedd9755ccda97d2874a7405cc9dc0a063b3c334167f2cfcf2a352b"
    },
    {
      "key": "ch_redz1",
      "nodeTitle": "chest_redzinski_bridge",
      "sourceText": "Reconstruiți cel mai mare pod din Wrocław!",
      "sourceEnText": "Rebuild the biggest bridge in Wrocław!",
