    },
    {
      "key": "end_2",
      "nodeTitle": "quest_end",
      "sourceText": "W Alpach jest wiele dużych i pięknych gór.",
      "sourceEnText": "In the Alps, there are many large and beautiful mountains.",
      "audioFile": "fr_08_end_2.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
