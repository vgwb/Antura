  "lines": [
    {
      "key": "000fc05",
      "nodeTitle": "item_hat",
      "sourceText": "W czapce głowa ci nie zmarznie.",
      "sourceEnText": "With a hat, your head won't get cold.",
      "audioFile": "fr_08_000fc05.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2142,
      "updatedAt": "2026-08-24T23:58:52Z",
      "textHash": "9271cd2e32d2b5052e9266104f0d18516db19026d1df4f6a83a63a6e21c7556d"
    },
    {
      "key": "001e940",
      "nodeTitle": "npc_base4",
      "sourceText": "Odpowiedz na trzy pytania dotyczące góry.",
      "sourceEnText": "Answer three questions about the mountain.",
      "audioFile": "fr_08_001e940.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2664,
      "updatedAt": "2026-08-24T23:59:42Z",
      "textHash": "03b696f7ab311e0048da4fa2d3bec25225e4485a53ac10ae77dc0f837f13325d"
    },
    {
      "key": "003e87c",
      "nodeTitle": "chest_bonus",
      "sourceText": "Oto miły, ciepły szalik! Weź go!",
      "sourceEnText": "Here's a nice warm scarf! Take it!",
      "audioFile": "fr_08_003e87c.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2377,
      "updatedAt": "2026-08-25T00:00:24Z",
      "textHash": "175671385e8684dde9c3d50654d81727d4608be0ded72d1ff50adab798d1fbcc"
    },
    {
      "key": "003ecb2",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Mont Blanc jest najwyższą górą we Francji.",
      "sourceEnText": "Mont Blanc is the highest mountain in France.",
      "audioFile": "fr_08_003ecb2.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2612,
      "updatedAt": "2026-08-25T00:00:31Z",
      "textHash": "812ecb73b003a71b1ca79be2b731d3d3d8182e0892f125c46efecd32f312eb44"
    },
    {
      "key": "00a7e83",
      "nodeTitle": "npc_base3",
      "sourceText": "Dokładny ! ",
      "sourceEnText": "Exact ! ",
      "audioFile": "fr_08_00a7e83.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1123,
      "updatedAt": "2026-08-24T23:59:26Z",
      "textHash": "22cff9573643f6ef5966e5bcc74f726f97beeb19420e3424f8f07ea73d474346"
    },
    {
      "key": "011dc7e",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Uwielbiam góry. A ty?",
      "sourceEnText": "I love the mountains. And you?",
      "audioFile": "fr_08_011dc7e.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 1724,
      "updatedAt": "2026-08-25T00:00:29Z",
      "textHash": "b2d32e475acb3d273c0bc2732bc566e9b9ed4d9b06ee352121935deff9287a06"
    },
    {
      "key": "015bf8a",
      "nodeTitle": "npc_base1",
      "sourceText": "Jesteś gotowy. Możesz wejść na szczyt Mont Blanc!",
      "sourceEnText": "Now you're ready. You can go to the summit of Mont Blanc!",
      "audioFile": "fr_08_015bf8a.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3500,
      "updatedAt": "2026-08-24T23:58:34Z",
      "textHash": "3ac99e44a7daaf83d8d49e4e3e7fa571b37c693efb85ae990afe0de51ab77472"
    },
    {
      "key": "018880a",
      "nodeTitle": "npc_base4",
      "sourceText": "Szczyt Mont Blanc ma 4807 metrów wysokości.",
      "sourceEnText": "The summit of Mont Blanc is 4807 meters high.",
      "audioFile": "fr_08_018880a.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4624,
      "updatedAt": "2026-08-24T23:59:40Z",
      "textHash": "dd03e49c135da5e55b2738e515a46f920af070da40c5b5fb27e14ab037318b85"
    },
    {
      "key": "01a4b20",
      "nodeTitle": "npc_base3",
      "sourceText": "liście palmowe",
      "sourceEnText": "palm fronds",
      "audioFile": "fr_08_01a4b20.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1280,
      "updatedAt": "2026-08-24T23:59:28Z",
      "textHash": "602edc13188136cbcd1f533b07bb1a3409f83dfa62cf7cfe7967f7481f4b6630"
    },
    {
      "key": "01beb5e",
      "nodeTitle": "npc_intro",
      "sourceText": "Pies poszedł w góry z twoimi rzeczami.",
      "sourceEnText": "The dog went up into the mountains with your things.",
      "audioFile": "fr_08_01beb5e.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2560,
      "updatedAt": "2026-08-24T23:58:16Z",
      "textHash": "43e3443803189ca63e833afcde04bd7fa426a07c157c61efb2eb2882553341cc"
    },
    {
      "key": "01e5f66",
      "nodeTitle": "spawned_hiker",
      "sourceText": "Czy kiedykolwiek lepiłeś bałwana?",
      "sourceEnText": "Have you ever made a snowman?",
      "audioFile": "fr_08_01e5f66.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1959,
      "updatedAt": "2026-08-25T00:00:43Z",
      "textHash": "cd690247ba418385d19c15a677fc9b6eebc1d2b0bd976de6103e548249f71304"
    },
    {
      "key": "029a03e",
      "nodeTitle": "npc_base2",
      "sourceText": "Słońce i śnieg bolą oczy. Potrzebujesz okularów przeciwsłonecznych.",
      "sourceEnText": "The sun and snow hurt your eyes. You need sunglasses.",
      "audioFile": "fr_08_029a03e.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 5773,
      "updatedAt": "2026-08-24T23:59:03Z",
      "textHash": "211c44e59e647fe1a1d66a7532a17175aa503f5d7da9321ea79f8e742040375c"
    },
    {
      "key": "029f39c",
      "nodeTitle": "item_backpack",
      "sourceText": "Teraz idź w góry. Znajdź ciepłe ubrania i sprzęt górski.",
      "sourceEnText": "Now go to the mountains. Find warm clothes and mountain gear.",
      "audioFile": "fr_08_029f39c.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4284,
      "updatedAt": "2026-08-24T23:58:32Z",
      "textHash": "f8b70396ed240384c8f438faaeb247321fc70c99a86413f3ea8ba79c468274d2"
    },
    {
      "key": "02a2ea9",
      "nodeTitle": "item_sunglasses",
      "sourceText": "W górach słońce i śnieg raziły w oczy",
      "sourceEnText": "In the mountains, the sun and snow hurt the eyes",
      "audioFile": "fr_08_02a2ea9.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2795,
      "updatedAt": "2026-08-24T23:59:18Z",
      "textHash": "9826fd246cd71b5eabe6588d56784a51de78109a015b879e50837f459a56e1d5"
    },
    {
      "key": "02a3874",
      "nodeTitle": "snowman_1",
      "sourceText": "Nie, dziękuję. Zostanę tutaj.",
      "sourceEnText": "No thanks, I'll stay here.",
      "audioFile": "fr_08_02a3874.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1881,
      "updatedAt": "2026-08-25T00:00:16Z",
      "textHash": "ad001c65ee38a03aac680b49cc779472a8160bb3bd1cfb0182a44b0c64e5c534"
    },
    {
      "key": "02c9805",
      "nodeTitle": "activity_3_done",
      "sourceText": "Otwórz skrzynię, aby wyjąć raki!",
      "sourceEnText": "Open the chest to get crampons!",
      "audioFile": "fr_08_02c9805.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2377,
      "updatedAt": "2026-03-15T12:37:04Z",
      "textHash": "ffc2c803331744e38005fd9616b771ad2d870219ea97fd7fc3c083dd99ea2d42"
    },
    {
      "key": "030fa1c",
      "nodeTitle": "npc_base4",
      "sourceText": "Gratulacje! Dotarłeś na szczyt Mont Blanc.",
      "sourceEnText": "Well done! You've reached the summit of Mont Blanc.",
      "audioFile": "fr_08_030fa1c.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3082,
      "updatedAt": "2026-08-24T23:59:36Z",
      "textHash": "945b5d406eb107c6c04798bd85d7b0a9d2061e39e701f3cd404718d601e3f844"
    },
    {
      "key": "035e68a",
      "nodeTitle": "node",
      "sourceText": "Obóz bazowy 4",
      "sourceEnText": "Base Camp 4",
      "audioFile": "fr_08_035e68a.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1515,
      "updatedAt": "2026-08-25T00:00:14Z",
      "textHash": "17f733f2e866867cc684d15282c1cf4b0067f5a1402c0a7e2e8e4c35e22ed735"
    },
    {
      "key": "0371d31",
      "nodeTitle": "spawned_alps_climber",
      "sourceText": "Możesz wybrać się z przewodnikiem górskim.",
      "sourceEnText": "A mountain guide can come with you.",
      "audioFile": "fr_08_0371d31.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2664,
      "updatedAt": "2026-08-25T00:00:49Z",
      "textHash": "3c2757ed53f2363e81f87c31610c8f99848cbe77d3122a63d45aa939556a6208"
    },
    {
      "key": "038d1bc",
      "nodeTitle": "item_rope",
      "sourceText": "Lina zapewnia bezpieczeństwo na lodzie i skałach.",
      "sourceEnText": "The rope allows you to be safe on ice and rocks.",
      "audioFile": "fr_08_038d1bc.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3082,
      "updatedAt": "2026-08-24T23:59:34Z",
      "textHash": "288e75fcc59398cc9b719129e2b028a4ce8d93011087e3776fac5651a969a2d4"
    },
    {
      "key": "03db010",
      "nodeTitle": "npc_swiss",
      "sourceText": "Szwajcaria leży na północ od Mont Blanc.",
      "sourceEnText": "Switzerland is north of Mont Blanc.",
      "audioFile": "fr_08_03db010.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2769,
      "updatedAt": "2026-03-15T16:42:06Z",
      "textHash": "3d192ef27a2d0396a8ab01c8a91b7b394927a5dab523a546b7fbe3b12fab2bc1"
    },
    {
      "key": "03dd802",
      "nodeTitle": "npc_base1",
      "sourceText": "Nie masz płaszcza. Idź go poszukać!",
      "sourceEnText": "You don't have a coat. Go find it!",
      "audioFile": "fr_08_03dd802.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-08-24T23:58:38Z",
      "textHash": "dee363e03825d96f97b4dd6225af81387b05795ff78eae350ad04720241abfce"
    },
    {
      "key": "045409f",
      "nodeTitle": "npc_intro",
      "sourceText": "Po pierwsze, potrzebujesz plecaka.",
      "sourceEnText": "First, you need a backpack.",
      "audioFile": "fr_08_045409f.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2247,
      "updatedAt": "2026-08-24T23:58:21Z",
      "textHash": "6f7533d9cc077539df10ec92bbcbc65a8eee4964b79c593524cb65575b88ccd5"
    },
    {
      "key": "046eb33",
      "nodeTitle": "npc_intro",
      "sourceText": "Wróć, gdy znajdziesz.",
      "sourceEnText": "Come back when you've found it.",
      "audioFile": "fr_08_046eb33.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1593,
      "updatedAt": "2026-08-24T23:58:12Z",
      "textHash": "bf78e8ccb851c90f57fc092e9b6dc4521137df0f0f6852bbfa89565b9f9f71f7"
    },
    {
      "key": "04bbada",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Przyjrzyj się uważnie! Zobaczysz świstaka.",
      "sourceEnText": "Look closely! You're going to see a marmot.",
      "audioFile": "fr_08_04bbada.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2952,
      "updatedAt": "2026-08-25T00:00:33Z",
      "textHash": "d0e200615be5f6d66e64c3f9aba7eced7e38c524f0214c3c17344b6ad68d3cde"
    },
    {
      "key": "04c1c1f",
      "nodeTitle": "npc_intro",
      "sourceText": "Masz plecak. Teraz idź po ciepłe ubrania i sprzęt górski.",
      "sourceEnText": "You have your backpack. Now go get your warm clothes and mountain gear.",
      "audioFile": "fr_08_04c1c1f.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3971,
      "updatedAt": "2026-08-24T23:58:03Z",
      "textHash": "a8425d078dba3957d6a30180009cf43d670c59f5c60bb952d24e056504bcdc12"
    },
    {
      "key": "050fe70",
      "nodeTitle": "npc_italy",
      "sourceText": "Włochy leżą na wschód od Mont Blanc.",
      "sourceEnText": "Italy is east of Mont Blanc.",
      "audioFile": "fr_08_050fe70.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2482,
      "updatedAt": "2026-03-15T16:42:05Z",
      "textHash": "18aa2d4ae9ecee1d632ecae35db443fc7915fe7b0da6015c32c492b5f00689a2"
    },
    {
      "key": "0557ef5",
      "nodeTitle": "spawned_hiker",
      "sourceText": "W górach jest śnieg.",
      "sourceEnText": "There is snow in the mountains.",
      "audioFile": "fr_08_0557ef5.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1515,
      "updatedAt": "2026-08-25T00:00:40Z",
      "textHash": "ccc17310eab24d617b0f7d2af4a0af0a00d8034a48d00009ba034c7f25611249"
    },
    {
      "key": "056ec2b",
      "nodeTitle": "chest_base1",
      "sourceText": "Skrzynia się otwiera! Zawiera trochę sprzętu.",
      "sourceEnText": "The chest opens! It contains some equipment.",
      "audioFile": "fr_08_056ec2b.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3448,
      "updatedAt": "2026-08-24T23:58:48Z",
      "textHash": "177e36f569d0d610c00a5413e574805844a29245b08f17e089cb3cd2c9fe895f"
    },
    {
      "key": "058bb65",
      "nodeTitle": "node",
      "sourceText": "Obóz bazowy 3",
      "sourceEnText": "Base Camp 3",
      "audioFile": "fr_08_058bb65.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1280,
      "updatedAt": "2026-08-25T00:00:12Z",
      "textHash": "764ea33bba7b0f5c0312ac8361dd26f9953eee24e459f985c2d244051e431c8e"
    },
    {
      "key": "0590129",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Aby wejść na szczyt Mont Blanc należy zabrać ciepłe ubrania.",
      "sourceEnText": "To go to the summit of Mont Blanc, take warm clothes.",
      "audioFile": "fr_08_0590129.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3736,
      "updatedAt": "2026-08-25T00:00:35Z",
      "textHash": "251d57ce0e94811a139394e6f37f9441bb9ccac236dd1bd7f29f4e8d22e2b687"
    },
    {
      "key": "059d744",
      "nodeTitle": "item_hat",
      "sourceText": "Kapelusz chroni przed wiatrem.",
      "sourceEnText": "The hat protects you from the wind.",
      "audioFile": "fr_08_059d744.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-08-24T23:58:54Z",
      "textHash": "a0b4335ca22dd3412e202709dc0ecc01ddbb6f96c53ea66a894fabb35c162128"
    },
    {
      "key": "05cabb5",
      "nodeTitle": "npc_intro",
      "sourceText": "Otwórz skrzynię, aby znaleźć plecak!",
      "sourceEnText": "Open the chest to find the backpack!",
      "audioFile": "fr_08_05cabb5.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2351,
      "updatedAt": "2026-08-24T23:58:23Z",
      "textHash": "7818c83c02fff1359ef92a373d44a8b8afc8418d6f1951704808e89b978086a8"
    },
    {
      "key": "05e3658",
      "nodeTitle": "node",
      "sourceText": "Obóz bazowy 2",
      "sourceEnText": "Base Camp 2",
      "audioFile": "fr_08_05e3658.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1515,
      "updatedAt": "2026-08-25T00:00:10Z",
      "textHash": "8194b9bab3a76a973b8c159b3ab0c996b8becad498fb6155876d8ca3d9f75d1b"
    },
    {
      "key": "05e80cb",
      "nodeTitle": "item_backpack",
      "sourceText": "W plecaku znajduje się woda, jedzenie i mapa.",
      "sourceEnText": "In the backpack, there is water, food, and a map.",
      "audioFile": "fr_08_05e80cb.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3187,
      "updatedAt": "2026-08-24T23:58:29Z",
      "textHash": "3c501cde632faf18758573258836bb336c7e2563c00a2b7780cb8a7064befe4b"
    },
    {
      "key": "0650acc",
      "nodeTitle": "npc_intro",
      "sourceText": "Znajdź ciepłą odzież i sprzęt górski.",
      "sourceEnText": "Find warm clothing and mountain gear.",
      "audioFile": "fr_08_0650acc.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2847,
      "updatedAt": "2026-08-24T23:58:19Z",
      "textHash": "d0df1b79202894234d221c19789c663b9dcc388ef97fd325eab1778d2e3d8d20"
    },
    {
      "key": "06b15bb",
      "nodeTitle": "npc_base3",
      "sourceText": "Masz swój sprzęt górski. Ostatnia próba zdobycia szczytu.",
      "sourceEnText": "You have your mountain gear. One last effort to reach the summit.",
      "audioFile": "fr_08_06b15bb.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3918,
      "updatedAt": "2026-08-24T23:59:20Z",
      "textHash": "79c375412678eba65a472c7dd593d04e36668ae01614a346995c668b84beb37d"
    },
    {
      "key": "06b3363",
      "nodeTitle": "npc_base2",
      "sourceText": "Nie masz rękawiczek!",
      "sourceEnText": "You don't have any gloves!",
      "audioFile": "fr_08_06b3363.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1358,
      "updatedAt": "2026-08-24T23:59:00Z",
      "textHash": "6edc6175caf8798b63081a7076f0f24bc4569509a2f09dd3fe5a3bd0f30f2894"
    },
    {
      "key": "06d9f34",
      "nodeTitle": "npc_base3",
      "sourceText": "Aby chodzić po lodowcu, potrzebujemy specjalnego sprzętu.",
      "sourceEnText": "To walk on glacier ice, we need special gear.",
      "audioFile": "fr_08_06d9f34.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3553,
      "updatedAt": "2026-03-15T12:36:55Z",
      "textHash": "3caca46d8743bfca204f1892ec4d1e43fbe421bd21a444ec1fcfd13eb484476d"
    },
    {
      "key": "06f9a2a",
      "nodeTitle": "question_alps",
      "sourceText": "W jakim paśmie górskim znajduje się Mont Blanc?",
      "sourceEnText": "What mountain range is Mont Blanc in?",
      "audioFile": "fr_08_06f9a2a.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3213,
      "updatedAt": "2026-03-15T12:37:14Z",
      "textHash": "249ede6eef0f73045a4d4fbaeb4f2fd86691f72d92f491927cafc692637dd0f0"
    },
    {
      "key": "07102e7",
      "nodeTitle": "item_crampons",
      "sourceText": "Raki pomagają chodzić po lodzie.",
      "sourceEnText": "Crampons help you walk on ice.",
      "audioFile": "fr_08_07102e7.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2534,
      "updatedAt": "2026-08-24T23:59:32Z",
