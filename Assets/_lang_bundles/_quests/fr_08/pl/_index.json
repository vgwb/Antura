    {
      "key": "end_1",
      "nodeTitle": "quest_end",
      "sourceText": "Gratulacje! Zdobyłeś szczyt Mont Blanc. Mierzy on 4807 metrów. To najwyższa góra we Francji.",
      "sourceEnText": "Well done! You've reached the summit of Mont Blanc. It measures 4807 meters. It's the highest mountain in France.",
      "audioFile": "fr_08_end_1.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 7993,
      "updatedAt": "2026-08-24T23:57:57Z",
