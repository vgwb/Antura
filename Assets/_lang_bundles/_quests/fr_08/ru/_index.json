    {
      "key": "0724de3",
      "nodeTitle": "npc_intro",
      "sourceText": "Помогите! Я ваш горный проводник. Синяя собака украла ваши вещи.",
      "sourceEnText": "Help me! I'm your mountain guide. A blue dog took your things.",
      "audioFile": "fr_08_0724de3.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 5355,
      "updatedAt": "2026-08-25T00:03:02Z",
      "textHash": "e8f6e246b35013827de3adc8da9db7249137ec79df7a8f3ddd7daa5d1451f561"
    },
    {
      "key": "076433f",
      "nodeTitle": "npc_base3",
      "sourceText": "Что надевают на обувь, чтобы ходить по льду?",
      "sourceEnText": "What do you put on your shoes to walk on ice?",
