    },
    {
      "key": "0e83480",
      "nodeTitle": "activity_1_done",
      "sourceText": "Откройте сундук, и вы найдете шляпу!",
      "sourceEnText": "Open the chest to find the hat!",
      "audioFile": "fr_08_0e83480.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 2482,
      "updatedAt": "2026-08-25T00:03:23Z",
      "textHash": "3aeed223235c8b70a7e534e8104c16e3a35796880e1857ffa37aef57dda01509"
    },
    {
      "key": "0f2aac7",
      "nodeTitle": "item_gloves",
      "sourceText": "Перчатки защищают руки.",
      "sourceEnText": "The gloves protect the hands.",
      "audioFile": "fr_08_0f2aac7.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 2064,
      "updatedAt": "2026-08-25T00:03:43Z",
      "textHash": "4fbc518345610704e1c700106e215d54d592d74b2ad993c2c8210c687b9d5f3a"
    },
    {
      "key": "0f4644b",
      "nodeTitle": "npc_intro",
      "sourceText": "Поднимитесь на вершину Монблана",
      "sourceEnText": "Climb to the top of Mont Blanc",
      "audioFile": "fr_08_0f4644b.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 2194,
      "updatedAt": "2026-08-25T00:02:57Z",
      "textHash": "b4b350a88bcd75610af1873a665fc8fbf08b0839e199918f6fb0a5c8d05fe384"
    },
    {
      "key": "0f4c405",
      "nodeTitle": "snowman_1",
      "sourceText": "Да, пожалуйста, помогите мне.",
      "sourceEnText": "Yes, please help me.",
      "audioFile": "fr_08_0f4c405.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 1829,
      "updatedAt": "2026-08-25T00:04:21Z",
      "textHash": "ca6ae1ca5a46e23383c3fed38b483c4e1ffe710eb20aebdd8e4697250ee302de"
    },
    {
      "key": "0fdc3cb",
      "nodeTitle": "activity_2_done",
      "sourceText": "Откройте багажник, и вы найдете солнцезащитные очки!",
      "sourceEnText": "Open the trunk to find the sunglasses!",
      "audioFile": "fr_08_0fdc3cb.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 3631,
      "updatedAt": "2026-08-25T00:03:40Z",
      "textHash": "b477d7ace374a9515c455570d0eebd9ded1d895ca5a2a1509786293c09d4827b"
    },
    {
      "key": "b1_1",
      "nodeTitle": "npc_base1",
      "sourceText": "Ветрено. Нужно защитить уши.",
      "sourceEnText": "It's windy. You need to protect your ears.",
      "audioFile": "fr_08_b1_1.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 2769,
      "updatedAt": "2026-08-25T00:03:20Z",
      "textHash": "482e5213d75e035c6aac0e471fb47d96476d45cf0cc948a88309e163a5ec4181"
    },
    {
      "key": "b1_q",
      "nodeTitle": "npc_base1",
      "sourceText": "Как защитить уши?",
      "sourceEnText": "How to protect your ears?",
      "audioFile": "fr_08_b1_q.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 1411,
      "updatedAt": "2026-08-25T00:03:22Z",
      "textHash": "c58e3fb9b842d4ca06e0b76a034faec980fc7c665bc58d940c85fb661620efd2"
    },
    {
      "key": "chest_locked",
      "nodeTitle": "chest_intro",
      "sourceText": "Сундук заперт. Найдите ключ, чтобы открыть его.",
      "sourceEnText": "The chest is locked. Find the key to open it.",
      "audioFile": "fr_08_chest_locked.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 3135,
      "updatedAt": "2026-08-25T00:03:11Z",
      "textHash": "5892a49e6c6f95b67b8dd3d0a27185fa6bd16301b3d2abba5d24022cb2cabc1a"
    },
    {
      "key": "comebacklater",
      "nodeTitle": "question_alps",
      "sourceText": "Заходите позже!",
      "sourceEnText": "Come back later!",
      "audioFile": "fr_08_comebacklater.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 1176,
      "updatedAt": "2026-03-15T18:59:05Z",
      "textHash": "1bc4343e92aa443ce16fbcfb66c92deeae8247b0acbf8d2d5a9018863b86918b"
    },
    {
      "key": "correct",
      "nodeTitle": "question_alps",
      "sourceText": "Это верно.",
      "sourceEnText": "That's right.",
      "audioFile": "fr_08_correct.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 993,
      "updatedAt": "2026-08-25T00:04:08Z",
      "textHash": "3d122f79410514eaa04bd020b93bbb6b353d08aa6c1008b15fe7ab1b26f468b7"
    },
    {
      "key": "dontknow",
      "nodeTitle": "question_alps",
      "sourceText": "Я не знаю",
      "sourceEnText": "I don't know",
      "audioFile": "fr_08_dontknow.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 705,
      "updatedAt": "2026-03-15T18:59:04Z",
      "textHash": "2d0c1a993a6f85eda690f986c1cfdebe642a888b73eda299e557d4674947b23c"
    },
    {
      "key": "end_1",
      "nodeTitle": "quest_end",
      "sourceText": "Отлично! Вы достигли вершины Монблана. Его высота составляет 4807 метров. Это самая высокая гора во Франции.",
      "sourceEnText": "Well done! You've reached the summit of Mont Blanc. It measures 4807 meters. It's the highest mountain in France.",
      "audioFile": "fr_08_end_1.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 8934,
      "updatedAt": "2026-08-25T00:02:52Z",
      "textHash": "b560dc895096dc2c05fdb48da3de2ed36cd9c1a521d03971a403f18b3dc7ded4"
    },
    {
      "key": "end_2",
      "nodeTitle": "quest_end",
      "sourceText": "В Альпах много высоких и красивых гор.",
      "sourceEnText": "In the Alps, there are many large and beautiful mountains.",
      "audioFile": "fr_08_end_2.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 2847,
      "updatedAt": "2026-08-25T00:02:53Z",
      "textHash": "2847861a002df0d5a2d2bc1ea9598df2e08a36702d3fa6337d7ea3a32cc041af"
    },
    {
      "key": "fr08_b2_chest",
      "nodeTitle": "chest_base2",
      "sourceText": "Багажник открыт! Достаньте солнцезащитные очки.",
      "sourceEnText": "The trunk is open! Take out the sunglasses.",
      "audioFile": "fr_08_fr08_b2_chest.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 3631,
      "updatedAt": "2026-08-25T00:03:41Z",
      "textHash": "a8ad0c8c753942528917c5b78cdc5f690712836d8a8769ee4212e5ac71f3272b"
    },
    {
      "key": "fr08_b2_help",
      "nodeTitle": "npc_base2",
      "sourceText": "Снеговик может вам помочь.",
      "sourceEnText": "The snowman can help you.",
      "audioFile": "fr_08_fr08_b2_help.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 1698,
      "updatedAt": "2026-08-25T00:03:32Z",
      "textHash": "6e41d54892a1c90625bacf43bdbb3ebb6779fdfb7d8078b0ddf2ba9598de2c11"
    },
    {
      "key": "fr08_marmot_2",
      "nodeTitle": "marmot",
      "sourceText": "Говорят, я сплю всю зиму, я впадаю в спячку.",
      "sourceEnText": "I sleep all winter, they say I hibernate.",
      "audioFile": "fr_08_fr08_marmot_2.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 3135,
      "updatedAt": "2026-08-25T00:04:24Z",
      "textHash": "8273059bdd73d8988a291ec8e0aad184943b3bff15dd161db0376c33b8e0152e"
    },
    {
      "key": "fr08_marmot_3",
      "nodeTitle": "marmot",
      "sourceText": "Я обожаю есть цветы, фрукты и травы. Объедение!",
      "sourceEnText": "I love eating flowers, fruits, and herbs. Yum!",
      "audioFile": "fr_08_fr08_marmot_3.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 3553,
      "updatedAt": "2026-08-25T00:04:26Z",
      "textHash": "43b0ec0a3a1fe5d9d992fd825156594db408832ce4d5bb7d7e57aca997c9bddd"
    },
    {
      "key": "fr08_marmot_4",
      "nodeTitle": "marmot",
      "sourceText": "Мне нравится отдыхать на солнце.",
      "sourceEnText": "I like to relax in the sun.",
      "audioFile": "fr_08_fr08_marmot_4.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 2064,
      "updatedAt": "2026-08-25T00:04:27Z",
      "textHash": "3787d5515008982d7c764bc9b787266d5848431c3dc35ac15a228296d7c89052"
    },
    {
      "key": "keep_looking",
