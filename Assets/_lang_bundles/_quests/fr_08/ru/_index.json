    },
    {
      "key": "07c6385",
      "nodeTitle": "npc_base3",
      "sourceText": "Нет! Вы не в бассейне! Попробуйте ещё раз.",
      "sourceEnText": "No! You're not at the swimming pool! Try again.",
      "audioFile": "fr_08_07c6385.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
