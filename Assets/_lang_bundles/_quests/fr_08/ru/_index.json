    },
    {
      "key": "0bc67f7",
      "nodeTitle": "spawned_hiker",
      "sourceText": "Присмотритесь! Вы увидите горного козла.",
      "sourceEnText": "Look closely! You're going to see an ibex.",
      "audioFile": "fr_08_0bc67f7.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_M",
