    },
    {
      "key": "0a7146f",
      "nodeTitle": "item_hat",
      "sourceText": "Продолжайте восхождение!",
      "sourceEnText": "Keep climbing!",
      "audioFile": "fr_08_0a7146f.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 1933,
