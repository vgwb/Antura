    },
    {
      "key": "0c18060",
      "nodeTitle": "snowman_1",
      "sourceText": "Вам нужна помощь, чтобы сесть?",
      "sourceEnText": "Do you need help getting on?",
      "audioFile": "fr_08_0c18060.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-08-25T00:04:19Z",
      "textHash": "e3124abe8922e7f87ee8a51b029bfb3bbbff574221eaf4c7bd565c0999a2cb37"
    },
    {
      "key": "0c18c08",
      "nodeTitle": "npc_base3",
      "sourceText": "У тебя нет веревки!",
      "sourceEnText": "You don't have a rope!",
      "audioFile": "fr_08_0c18c08.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 1411,
      "updatedAt": "2026-08-25T00:03:50Z",
      "textHash": "0360a737a502dc04ba85d7e638aa8cee743a9f18976ed075d2318bc4480ee853"
    },
    {
      "key": "0c1f006",
      "nodeTitle": "chest_intro",
      "sourceText": "Сундук открывается! Бери рюкзак.",
      "sourceEnText": "The chest opens! Take the backpack.",
      "audioFile": "fr_08_0c1f006.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 2534,
      "updatedAt": "2026-08-25T00:03:10Z",
      "textHash": "1140057db34167948906c88cde5772cb17e72e48369c4866f66b4065d7da8afc"
    },
    {
      "key": "0d01879",
      "nodeTitle": "item_gloves",
      "sourceText": "В горах холодно.",
      "sourceEnText": "It's cold in the mountains",
      "audioFile": "fr_08_0d01879.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 1306,
      "updatedAt": "2026-08-25T00:03:44Z",
      "textHash": "1efdceca05f4ee72511a734b79372fa8aa4ef34b4e4edacf3e7264d693fbcd7a"
    },
    {
      "key": "0d23529",
      "nodeTitle": "npc_france",
      "sourceText": "Франция расположена к западу от Монблана.",
      "sourceEnText": "France is west of Mont Blanc.",
      "audioFile": "fr_08_0d23529.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-03-15T16:42:20Z",
      "textHash": "615e7fb98a51a31a797e0763a29a2e7516fadbe4102bb4d465844cc128e32adc"
    },
    {
      "key": "0dbac73",
      "nodeTitle": "spawned_hiker",
      "sourceText": "Чтобы отправиться в горы, возьмите удобную обувь.",
      "sourceEnText": "To go into the mountains, take good shoes.",
      "audioFile": "fr_08_0dbac73.mp3",
      "voiceProfile": "felix",
      "actorId": "ADULT_M",
      "durationMs": 2978,
      "updatedAt": "2026-08-25T00:04:39Z",
      "textHash": "64a193607aeb7aca6a1bbbb39bb0766ad0e8303d34c8427a3aaf34ab164421e1"
    },
    {
      "key": "0e23f1f",
      "nodeTitle": "item_coat",
      "sourceText": "В пальто тепло и прохладно в ветреную или снежную погоду.",
      "sourceEnText": "With a coat, you stay warm when it's windy or snowy.",
      "audioFile": "fr_08_0e23f1f.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 4571,
      "updatedAt": "2026-08-25T00:03:27Z",
