    },
    {
      "key": "0b50050",
      "nodeTitle": "npc_base3",
      "sourceText": "Кошки",
      "sourceEnText": "Crampons",
      "audioFile": "fr_08_0b50050.mp3",
      "voiceProfile": "felix",
      "actorId": "Default",
      "durationMs": 679,
