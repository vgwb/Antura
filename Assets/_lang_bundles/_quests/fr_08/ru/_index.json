    },
    {
      "key": "07f2699",
      "nodeTitle": "npc_intro",
      "sourceText": "Найдите теплую одежду и снаряжение для походов.",
      "sourceEnText": "Find warm clothes and mountain gear.",
      "audioFile": "fr_08_07f2699.mp3",
      "voiceProfile": "felix",
