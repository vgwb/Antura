    },
    {
      "key": "05e3658",
      "nodeTitle": "snowman",
      "sourceText": "Campo base 2",
      "sourceEnText": "Basecamp 2",
      "audioFile": "fr_08_05e3658.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 940,
      "updatedAt": "2026-03-15T12:35:31Z",
      "textHash": "8f70907c734a637969fa1aaa0646ba200b3948c20ee2edfe133ac11a173c98cf"
    },
    {
      "key": "05e80cb",
      "nodeTitle": "item_backpack",
      "sourceText": "Nello zaino ci sono acqua, cibo e una mappa.",
      "sourceEnText": "In the backpack, there is water, food, and a map.",
      "audioFile": "fr_08_05e80cb.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2377,
      "updatedAt": "2026-08-24T23:56:21Z",
      "textHash": "924313bd014fc04b593b92525a98ce5f1f9867217246c4dc2028ad8817dfc729"
    },
    {
      "key": "0650acc",
      "nodeTitle": "npc_intro",
      "sourceText": "Trova abbigliamento caldo e attrezzatura da montagna.",
      "sourceEnText": "Find warm clothing and mountain gear.",
      "audioFile": "fr_08_0650acc.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2978,
      "updatedAt": "2026-08-24T23:56:14Z",
      "textHash": "ec694eb84995e4c4a6f14ce913b8275f4b89ab0126f0f90dfbcd6d740d3e6744"
    },
    {
      "key": "06b15bb",
      "nodeTitle": "npc_base3",
      "sourceText": "Hai con te l'attrezzatura da montagna. Un ultimo sforzo per raggiungere la vetta.",
      "sourceEnText": "You have your mountain gear. One last effort to reach the summit.",
      "audioFile": "fr_08_06b15bb.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 4153,
      "updatedAt": "2026-08-24T23:56:54Z",
      "textHash": "3a87771ee9275ef7e8e926935d8cc5407dcdc181e9c3774a35cd3881291a78b9"
    },
    {
      "key": "06b3363",
      "nodeTitle": "npc_base2",
      "sourceText": "Non hai i guanti!",
      "sourceEnText": "You don't have any gloves!",
      "audioFile": "fr_08_06b3363.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2377,
      "updatedAt": "2026-08-24T23:56:41Z",
      "textHash": "d999ff6a76583a7f0e1efb0a262b62ab736fec2644938540b664908d3f19e9db"
