    {
      "key": "0590129",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Per raggiungere la vetta del Monte Bianco, portatevi abiti caldi.",
      "sourceEnText": "To go to the summit of Mont Blanc, take warm clothes.",
      "audioFile": "fr_08_0590129.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_F",
      "durationMs": 3500,
      "updatedAt": "2026-08-24T23:57:37Z",
      "textHash": "5ddae24ccf2184fd698fc57f2f502cb7ccf84d5b0a8a5d6d6b8433bcd114d193"
    },
    {
      "key": "059d744",
      "nodeTitle": "item_hat",
      "sourceText": "Il cappello ti protegge dal vento.",
      "sourceEnText": "The hat protects you from the wind.",
      "audioFile": "fr_08_059d744.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T23:56:37Z",
