    },
    {
      "key": "01beb5e",
      "nodeTitle": "npc_intro",
      "sourceText": "Il cane è andato in montagna con le tue cose.",
      "sourceEnText": "The dog went up into the mountains with your things.",
      "audioFile": "fr_08_01beb5e.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2377,
      "updatedAt": "2026-08-24T23:56:13Z",
      "textHash": "e5d28c9138e34f23b7b659e090a90e86dc9dc173391a5bee5bc513b0063f5502"
    },
    {
      "key": "01e5f66",
      "nodeTitle": "spawned_hiker",
      "sourceText": "Hai mai costruito un pupazzo di neve?",
      "sourceEnText": "Have you ever made a snowman?",
      "audioFile": "fr_08_01e5f66.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
      "durationMs": 2064,
      "updatedAt": "2026-08-24T23:57:44Z",
      "textHash": "719d9dfaffbf48a50ed014b9ae57a84ebdf7eb14e4d2615c1d48cd48150f1a55"
    },
    {
      "key": "029a03e",
      "nodeTitle": "npc_base2",
      "sourceText": "Il sole e la neve ti fanno male agli occhi. Hai bisogno di occhiali da sole.",
      "sourceEnText": "The sun and snow hurt your eyes. You need sunglasses.",
      "audioFile": "fr_08_029a03e.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 4232,
      "updatedAt": "2026-08-24T23:56:43Z",
      "textHash": "a0af81b21a273ef9ed385ea114a47bdda6ad037f4013f79e5188d24d6cf5b2c5"
    },
    {
      "key": "029f39c",
      "nodeTitle": "item_backpack",
      "sourceText": "Ora vai in montagna. Procurati vestiti caldi e attrezzatura da montagna.",
      "sourceEnText": "Now go to the mountains. Find warm clothes and mountain gear.",
      "audioFile": "fr_08_029f39c.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 4519,
      "updatedAt": "2026-08-24T23:56:23Z",
      "textHash": "249da7fd355dcc3e29fc49ffb456091ee97fa289ec252a82a506c74ade7c829a"
    },
    {
      "key": "02a2ea9",
      "nodeTitle": "item_sunglasses",
      "sourceText": "In montagna, il sole e la neve fanno male agli occhi",
      "sourceEnText": "In the mountains, the sun and snow hurt the eyes",
      "audioFile": "fr_08_02a2ea9.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 3082,
      "updatedAt": "2026-08-24T23:56:52Z",
      "textHash": "bac8b620c6524993743c1096b6bd7990d8a1e52c43f2f7535d4746179aee260f"
    },
    {
      "key": "02a3874",
      "nodeTitle": "snowman_1",
      "sourceText": "No grazie, resto qui.",
      "sourceEnText": "No thanks, I'll stay here.",
      "audioFile": "fr_08_02a3874.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1515,
      "updatedAt": "2026-08-24T23:57:24Z",
      "textHash": "03c1da56ef070f2ff414fc1f4a3f5e9506020b6c409e215a1df48e535a5f36c8"
    },
    {
      "key": "02c9805",
      "nodeTitle": "activity_3_done",
      "sourceText": "Apri il forziere per prendere i ramponi!",
      "sourceEnText": "Open the chest to get crampons!",
      "audioFile": "fr_08_02c9805.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2142,
      "updatedAt": "2026-03-15T12:35:09Z",
      "textHash": "d58953653c82b638a3da7e582dfa6adb80d98608f3aaa9c813ec4cfaf71bf6ec"
    },
    {
      "key": "030fa1c",
      "nodeTitle": "npc_base4",
      "sourceText": "Complimenti! Hai raggiunto la vetta del Monte Bianco.",
      "sourceEnText": "Well done! You've reached the summit of Mont Blanc.",
      "audioFile": "fr_08_030fa1c.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 3135,
      "updatedAt": "2026-08-24T23:57:05Z",
      "textHash": "ee4739c447d56a758e24feb44fdfe7b35874083e433039423c51bcce40f722cf"
    },
    {
      "key": "035e68a",
      "nodeTitle": "snowman",
      "sourceText": "Campo base 4",
      "sourceEnText": "Basecamp 4",
      "audioFile": "fr_08_035e68a.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1097,
      "updatedAt": "2026-03-15T12:35:32Z",
      "textHash": "bf2849b04aa356d2185b272bc5c3753b6093bc1d0facfc91a693c5fecde1ab57"
    },
    {
      "key": "0371d31",
      "nodeTitle": "spawned_alps_climber",
      "sourceText": "È possibile essere accompagnati da una guida alpina.",
      "sourceEnText": "A mountain guide can come with you.",
      "audioFile": "fr_08_0371d31.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_F",
      "durationMs": 2900,
      "updatedAt": "2026-08-24T23:57:49Z",
      "textHash": "a0bfa865aee9afd938ed4c5ae452288690ed7a55aa78d99d30ec8b3dd21a54b5"
    },
    {
      "key": "038d1bc",
      "nodeTitle": "item_rope",
      "sourceText": "La corda ti permette di stare al sicuro su ghiaccio e rocce.",
      "sourceEnText": "The rope allows you to be safe on ice and rocks.",
      "audioFile": "fr_08_038d1bc.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 3135,
      "updatedAt": "2026-08-24T23:57:03Z",
      "textHash": "458da68b4cf9497183bdace73f85f98b97e6fd51b799715f4251eaad445ca940"
    },
    {
      "key": "03db010",
      "nodeTitle": "npc_swiss",
      "sourceText": "La Svizzera si trova a nord del Monte Bianco.",
      "sourceEnText": "Switzerland is north of Mont Blanc.",
      "audioFile": "fr_08_03db010.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2429,
      "updatedAt": "2026-03-15T16:41:53Z",
      "textHash": "0c6461d711b57b5df9e3a952b6704f4e830edce32dc7de754acfe9397526e9c7"
    },
    {
      "key": "03dd802",
      "nodeTitle": "npc_base1",
      "sourceText": "Non hai il cappotto. Vai a cercarlo!",
      "sourceEnText": "You don't have a coat. Go find it!",
      "audioFile": "fr_08_03dd802.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2978,
      "updatedAt": "2026-08-24T23:56:27Z",
      "textHash": "7e727cf1403e885754b22f5518ca49aa7d66e73f6af7feadcff3899b9f17a2e7"
    },
    {
      "key": "045409f",
      "nodeTitle": "npc_intro",
      "sourceText": "Innanzitutto, ti serve uno zaino.",
      "sourceEnText": "First, you need a backpack.",
      "audioFile": "fr_08_045409f.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2064,
      "updatedAt": "2026-08-24T23:56:15Z",
      "textHash": "777dd02a78bb8fe355e0aab16e88fb7833425ba7690930b27647d5968851bb8b"
    },
    {
      "key": "046eb33",
      "nodeTitle": "npc_intro",
      "sourceText": "Torna quando l'avrai trovato.",
      "sourceEnText": "Come back when you've found it.",
      "audioFile": "fr_08_046eb33.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1541,
      "updatedAt": "2026-08-24T23:56:10Z",
      "textHash": "88278492e49be353a59b669def3f0d5e59c7adc2ca8502ed686620ae5ba9c267"
    },
    {
      "key": "04bbada",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Guardate attentamente! Vedrete una marmotta.",
      "sourceEnText": "Look closely! You're going to see a marmot.",
      "audioFile": "fr_08_04bbada.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_F",
      "durationMs": 2534,
      "updatedAt": "2026-08-24T23:57:36Z",
      "textHash": "009edbfa07bc20db315688deaabbe2e4527a63e6b6b46249727a22f0abb332dd"
    },
    {
      "key": "04c1c1f",
      "nodeTitle": "npc_intro",
      "sourceText": "Hai il tuo zaino. Ora vai a prendere i vestiti caldi e l'attrezzatura da montagna.",
      "sourceEnText": "You have your backpack. Now go get your warm clothes and mountain gear.",
      "audioFile": "fr_08_04c1c1f.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 4336,
      "updatedAt": "2026-08-24T23:56:05Z",
      "textHash": "345f62031dac113d508005c2ecb370c9a0a5642b8e888f7456ad68b427772739"
    },
    {
      "key": "050fe70",
      "nodeTitle": "npc_italy",
      "sourceText": "L'Italia si trova a est del Monte Bianco.",
      "sourceEnText": "Italy is east of Mont Blanc.",
      "audioFile": "fr_08_050fe70.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2351,
      "updatedAt": "2026-03-15T16:41:52Z",
      "textHash": "88ff873d0593429392a046347bd006897f95b8924f6c0abe6436ecfee1dcaab9"
    },
    {
      "key": "0557ef5",
      "nodeTitle": "spawned_hiker",
      "sourceText": "C'è neve in montagna.",
      "sourceEnText": "There is snow in the mountains.",
      "audioFile": "fr_08_0557ef5.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_M",
