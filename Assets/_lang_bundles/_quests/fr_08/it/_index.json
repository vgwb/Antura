    },
    {
      "key": "001e940",
      "nodeTitle": "npc_base4",
      "sourceText": "Rispondi a tre domande sulla montagna.",
      "sourceEnText": "Answer three questions about the mountain.",
      "audioFile": "fr_08_001e940.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2116,
      "updatedAt": "2026-08-24T23:57:07Z",
      "textHash": "bf21c94855605cf7ea499db5bab68358d034cdb8703983f4b024a38c5e852c19"
    },
    {
      "key": "003e87c",
      "nodeTitle": "chest_bonus",
      "sourceText": "Ecco una bella sciarpa calda! Prendila!",
      "sourceEnText": "Here's a nice warm scarf! Take it!",
      "audioFile": "fr_08_003e87c.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2377,
      "updatedAt": "2026-08-24T23:57:30Z",
      "textHash": "5089ddf2b3ea4496635a5c54d5aede41705dc70c026d798a21b400249dc283ec"
    },
    {
      "key": "003ecb2",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Il Monte Bianco è la montagna più alta della Francia.",
      "sourceEnText": "Mont Blanc is the highest mountain in France.",
      "audioFile": "fr_08_003ecb2.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_F",
      "durationMs": 2717,
      "updatedAt": "2026-08-24T23:57:35Z",
      "textHash": "192e45fc753d5312ff418b39d40e0634a5c5c2ff16ed174b32dca5b17e54eb8e"
    },
    {
      "key": "00a7e83",
      "nodeTitle": "npc_base3",
      "sourceText": "Esatto!",
      "sourceEnText": "Exact ! ",
      "audioFile": "fr_08_00a7e83.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 810,
      "updatedAt": "2026-08-24T23:56:58Z",
      "textHash": "9494e2585e48413b5d00aa535491f0989cf602e0bb6856fdabafbf403b0a964b"
    },
    {
      "key": "011dc7e",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Adoro la montagna. E tu?",
      "sourceEnText": "I love the mountains. And you?",
      "audioFile": "fr_08_011dc7e.mp3",
      "voiceProfile": "francesco",
      "actorId": "ADULT_F",
      "durationMs": 1698,
      "updatedAt": "2026-08-24T23:57:33Z",
      "textHash": "4e7c9ff81504cc452be6b3e86d314eb7cd2a026d778d5a3d6ea0f12f3aa96eab"
    },
    {
      "key": "015bf8a",
      "nodeTitle": "npc_base1",
      "sourceText": "Ora sei pronto. Puoi raggiungere la vetta del Monte Bianco!",
      "sourceEnText": "Now you're ready. You can go to the summit of Mont Blanc!",
      "audioFile": "fr_08_015bf8a.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 3082,
      "updatedAt": "2026-08-24T23:56:24Z",
      "textHash": "06f183b617e5d910002851867f620289967248949160af34d38e355d3a646156"
    },
    {
      "key": "018880a",
      "nodeTitle": "npc_base4",
      "sourceText": "La vetta del Monte Bianco è alta 4807 metri.",
      "sourceEnText": "The summit of Mont Blanc is 4807 meters high.",
      "audioFile": "fr_08_018880a.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 3370,
      "updatedAt": "2026-08-24T23:57:06Z",
      "textHash": "2f258cbdea271fa0c1d4d7c5323097c285fe49463cf8a329c4c0d807ba105fd0"
    },
    {
      "key": "01a4b20",
      "nodeTitle": "npc_base3",
      "sourceText": "fronde di palma",
      "sourceEnText": "palm fronds",
      "audioFile": "fr_08_01a4b20.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 1045,
      "updatedAt": "2026-08-24T23:56:59Z",
