    {
      "key": "05cabb5",
      "nodeTitle": "npc_intro",
      "sourceText": "Apri il forziere per trovare lo zaino!",
      "sourceEnText": "Open the chest to find the backpack!",
      "audioFile": "fr_08_05cabb5.mp3",
      "voiceProfile": "francesco",
      "actorId": "Default",
      "durationMs": 2064,
      "updatedAt": "2026-08-24T23:56:17Z",
