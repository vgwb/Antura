    },
    {
      "key": "001e940",
      "nodeTitle": "npc_base4",
      "sourceText": "Răspundeți la trei întrebări despre munte.",
      "sourceEnText": "Answer three questions about the mountain.",
      "audioFile": "fr_08_001e940.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2482,
      "updatedAt": "2026-08-25T00:02:04Z",
      "textHash": "0708acd198d3281398ec00836a7f10819c3c2081170fd39979d690315507bece"
    },
    {
      "key": "003e87c",
      "nodeTitle": "chest_bonus",
      "sourceText": "Uite o eșarfă frumoasă și călduroasă! Ia-o!",
      "sourceEnText": "Here's a nice warm scarf! Take it!",
      "audioFile": "fr_08_003e87c.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 4702,
      "updatedAt": "2026-08-25T00:02:26Z",
      "textHash": "ebe3a6b5e9c065dc2e8f21f9f00639d874d932f25562f95fe642b053e60c53f4"
    },
    {
      "key": "003ecb2",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Mont Blanc este cel mai înalt munte din Franța.",
      "sourceEnText": "Mont Blanc is the highest mountain in France.",
      "audioFile": "fr_08_003ecb2.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 2978,
      "updatedAt": "2026-08-25T00:02:31Z",
      "textHash": "81592be6e2c7eb716642df0a23b2a4f50ca2ddb676ba7de0a18628804daa6906"
    },
    {
      "key": "00a7e83",
      "nodeTitle": "npc_base3",
      "sourceText": "Exact!",
      "sourceEnText": "Exact ! ",
      "audioFile": "fr_08_00a7e83.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 810,
      "updatedAt": "2026-08-25T00:01:54Z",
      "textHash": "30ab441787e94a3052da190c61ff759cf9fd392aafe31ec997c369e253d6a4d9"
    },
    {
      "key": "011dc7e",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Iubesc munții. Și tu?",
      "sourceEnText": "I love the mountains. And you?",
      "audioFile": "fr_08_011dc7e.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 1724,
      "updatedAt": "2026-08-25T00:02:29Z",
      "textHash": "aa5684bcf0de88d87d7da1e30cd1401d75c20fe870f7569ec134a4abcfca4979"
    },
    {
      "key": "015bf8a",
      "nodeTitle": "npc_base1",
      "sourceText": "Acum ești gata. Poți merge pe vârful Mont Blanc!",
      "sourceEnText": "Now you're ready. You can go to the summit of Mont Blanc!",
      "audioFile": "fr_08_015bf8a.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2978,
      "updatedAt": "2026-08-25T00:01:19Z",
      "textHash": "92153444df27600e3fafe717e173f65fa58ddb82a6a5237bc60da7889864f073"
    },
    {
      "key": "018880a",
      "nodeTitle": "npc_base4",
      "sourceText": "Vârful Mont Blanc are o înălțime de 4807 metri.",
      "sourceEnText": "The summit of Mont Blanc is 4807 meters high.",
      "audioFile": "fr_08_018880a.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 4284,
      "updatedAt": "2026-08-25T00:02:02Z",
      "textHash": "d4bc84c8b0d5febfba38fddf561d1eb70759673bb8cf28edc55892545d4e8549"
    },
    {
      "key": "01a4b20",
      "nodeTitle": "npc_base3",
      "sourceText": "frunze de palmier",
      "sourceEnText": "palm fronds",
      "audioFile": "fr_08_01a4b20.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1306,
      "updatedAt": "2026-08-25T00:01:55Z",
      "textHash": "39db22ed0979a3fdc04f690ecffc5d2f0308609b1da0637ea91607d944e03635"
    },
    {
      "key": "01beb5e",
      "nodeTitle": "npc_intro",
      "sourceText": "Câinele s-a dus în munte cu lucrurile tale.",
      "sourceEnText": "The dog went up into the mountains with your things.",
      "audioFile": "fr_08_01beb5e.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2769,
      "updatedAt": "2026-08-25T00:01:06Z",
      "textHash": "c6482489d0fe711d115d386820c4ecc34809371c9bb039a59e6b5c3a75db8ded"
    },
    {
      "key": "01e5f66",
      "nodeTitle": "spawned_hiker",
      "sourceText": "Ai făcut vreodată un om de zăpadă?",
      "sourceEnText": "Have you ever made a snowman?",
      "audioFile": "fr_08_01e5f66.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_M",
      "durationMs": 2011,
      "updatedAt": "2026-08-25T00:02:42Z",
      "textHash": "12b6be32301a394447c46b0cc2909e7282ed6ca97f1a6534b09c3af136dda694"
    },
    {
      "key": "029a03e",
      "nodeTitle": "npc_base2",
      "sourceText": "Soarele și zăpada îți rănesc ochii. Ai nevoie de ochelari de soare.",
      "sourceEnText": "The sun and snow hurt your eyes. You need sunglasses.",
      "audioFile": "fr_08_029a03e.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 4101,
      "updatedAt": "2026-08-25T00:01:37Z",
      "textHash": "3c66a2962e123e4f8fdcd2dedb28a75259b3073fe4dfb4831a3ef5fcd071e38d"
    },
    {
      "key": "029f39c",
      "nodeTitle": "item_backpack",
      "sourceText": "Acum du-te la munte. Găsește haine groase și echipament de munte.",
      "sourceEnText": "Now go to the mountains. Find warm clothes and mountain gear.",
      "audioFile": "fr_08_029f39c.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 4023,
      "updatedAt": "2026-08-25T00:01:17Z",
      "textHash": "275b785f619b8e07c1aadfe9ec9e78b769c4e868f52918d4b188cbda5899fa31"
    },
    {
      "key": "02a2ea9",
      "nodeTitle": "item_sunglasses",
      "sourceText": "La munte, soarele și zăpada rănesc ochii",
      "sourceEnText": "In the mountains, the sun and snow hurt the eyes",
      "audioFile": "fr_08_02a2ea9.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2717,
      "updatedAt": "2026-08-25T00:01:46Z",
      "textHash": "989cb82809f7f5b42d890f0ca5120c00f4e78221a5d85e34e216d779ac86f893"
    },
    {
      "key": "02a3874",
      "nodeTitle": "snowman_1",
      "sourceText": "Nu, mulțumesc, voi rămâne aici.",
      "sourceEnText": "No thanks, I'll stay here.",
      "audioFile": "fr_08_02a3874.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2064,
      "updatedAt": "2026-08-25T00:02:21Z",
      "textHash": "d1f45a18d351d06bbe9f41f1d01d4a207dbf241f04b2faddd2b9a991d769b2f5"
    },
    {
      "key": "02c9805",
      "nodeTitle": "activity_3_done",
      "sourceText": "Deschide cufărul ca să iei colțari!",
      "sourceEnText": "Open the chest to get crampons!",
      "audioFile": "fr_08_02c9805.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2142,
      "updatedAt": "2026-03-15T12:38:53Z",
      "textHash": "7a46cd11b3e599fc64bff7c59e13da2538658e5a076523ef4a76275300f2be9a"
    },
    {
      "key": "030fa1c",
      "nodeTitle": "npc_base4",
      "sourceText": "Bravo! Ai ajuns pe vârful Mont Blanc.",
      "sourceEnText": "Well done! You've reached the summit of Mont Blanc.",
      "audioFile": "fr_08_030fa1c.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2429,
      "updatedAt": "2026-08-25T00:02:01Z",
      "textHash": "2c2725467a47160ab37beda84256cbb7cff261889adab7da49924278b3f9d658"
    },
    {
      "key": "035e68a",
      "nodeTitle": "snowman",
      "sourceText": "Tabăra de bază 4",
      "sourceEnText": "Basecamp 4",
      "audioFile": "fr_08_035e68a.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2064,
      "updatedAt": "2026-03-15T12:39:15Z",
      "textHash": "770e267efd1fc93ec78d448e9002c6168368dc7eb6316e7ee5ddcd6bcd7a6c59"
    },
    {
      "key": "0371d31",
      "nodeTitle": "spawned_alps_climber",
      "sourceText": "Un ghid montan poate veni cu tine.",
      "sourceEnText": "A mountain guide can come with you.",
      "audioFile": "fr_08_0371d31.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 2064,
      "updatedAt": "2026-08-25T00:02:46Z",
      "textHash": "2bc8ffee1a03a0755d291d2a7b7ed8a01063647768a21c79fdefaf009f772e5d"
    },
    {
      "key": "038d1bc",
      "nodeTitle": "item_rope",
      "sourceText": "Coarda vă permite să fiți în siguranță pe gheață și pietre.",
      "sourceEnText": "The rope allows you to be safe on ice and rocks.",
      "audioFile": "fr_08_038d1bc.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 3631,
      "updatedAt": "2026-08-25T00:01:59Z",
      "textHash": "724bc6a0e718b09a0d6c487b0d341730039107a8e2d731f9e7bf2d750bd16103"
    },
    {
      "key": "03db010",
      "nodeTitle": "npc_swiss",
      "sourceText": "Elveția se află la nord de Mont Blanc.",
      "sourceEnText": "Switzerland is north of Mont Blanc.",
      "audioFile": "fr_08_03db010.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2351,
      "updatedAt": "2026-03-15T16:42:14Z",
      "textHash": "9bd294fde3e3895f27f6135af8f9935d7d2bb6ccb81c353865410f06e56d9437"
    },
    {
      "key": "03dd802",
      "nodeTitle": "npc_base1",
      "sourceText": "Nu ai o haină. Du-te și găsește-o!",
      "sourceEnText": "You don't have a coat. Go find it!",
      "audioFile": "fr_08_03dd802.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-08-25T00:01:21Z",
      "textHash": "d112f8d41ee78c9f93cf6559b5e7f05f335db586fe55af9ec259ab78d9c7358c"
    },
    {
      "key": "045409f",
      "nodeTitle": "npc_intro",
      "sourceText": "În primul rând, ai nevoie de un rucsac.",
      "sourceEnText": "First, you need a backpack.",
      "audioFile": "fr_08_045409f.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2534,
      "updatedAt": "2026-08-25T00:01:09Z",
      "textHash": "7455d3ebde6d2e421dfb36677b3139a373d375c9b14004ae4cfa35eed8a38838"
    },
    {
      "key": "046eb33",
      "nodeTitle": "npc_intro",
      "sourceText": "Întoarce-te când l-ai găsit.",
      "sourceEnText": "Come back when you've found it.",
      "audioFile": "fr_08_046eb33.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1698,
      "updatedAt": "2026-08-25T00:01:03Z",
      "textHash": "bb6f76409d3ead6ee3618f86161ed2b83d13a0ac4962f364a06a2dd03495ecae"
    },
    {
      "key": "04bbada",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Uită-te cu atenție! O să vezi o marmotă.",
      "sourceEnText": "Look closely! You're going to see a marmot.",
      "audioFile": "fr_08_04bbada.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 2664,
      "updatedAt": "2026-08-25T00:02:32Z",
      "textHash": "0f38aa0a13df91e79df653654e879ba0788254793229781d4a2946da3cee3aec"
    },
    {
      "key": "04c1c1f",
      "nodeTitle": "npc_intro",
      "sourceText": "Ai rucsacul. Acum du-te și ia-ți hainele groase și echipamentul de munte.",
      "sourceEnText": "You have your backpack. Now go get your warm clothes and mountain gear.",
      "audioFile": "fr_08_04c1c1f.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 4624,
      "updatedAt": "2026-08-25T00:00:59Z",
      "textHash": "14b5e88474e4a600136f2e65995d76c95d3bebb71fd959a11a256907953e1412"
    },
    {
      "key": "050fe70",
      "nodeTitle": "npc_italy",
      "sourceText": "Italia se află la est de Mont Blanc.",
      "sourceEnText": "Italy is east of Mont Blanc.",
      "audioFile": "fr_08_050fe70.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2247,
      "updatedAt": "2026-03-15T16:42:13Z",
      "textHash": "862ac8c4ffe6ca9a5f14f6cd3eaa31ee1d1300822b2052c57e7518a81fab2f19"
    },
    {
      "key": "0557ef5",
      "nodeTitle": "spawned_hiker",
      "sourceText": "Este zăpadă în munți.",
      "sourceEnText": "There is snow in the mountains.",
      "audioFile": "fr_08_0557ef5.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_M",
      "durationMs": 14002,
      "updatedAt": "2026-08-25T00:02:39Z",
      "textHash": "8ab8195664f27972242aad031be36c0c0b0eff738b0db0ad3cf794ba1d0a6e86"
    },
    {
      "key": "056ec2b",
      "nodeTitle": "chest_base1",
      "sourceText": "Cufărul se deschide! Conține niște echipament.",
      "sourceEnText": "The chest opens! It contains some equipment.",
      "audioFile": "fr_08_056ec2b.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2795,
      "updatedAt": "2026-08-25T00:01:27Z",
      "textHash": "b6a87246e26a9692eee2429e8538c90085b473c1e00dc4f62f0b3a4e9b496759"
    },
    {
      "key": "058bb65",
      "nodeTitle": "snowman",
      "sourceText": "Tabăra de bază 3",
      "sourceEnText": "Basecamp 3",
      "audioFile": "fr_08_058bb65.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1358,
      "updatedAt": "2026-03-15T12:39:15Z",
