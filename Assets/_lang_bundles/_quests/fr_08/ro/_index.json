    },
    {
      "key": "0590129",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Pentru a urca pe vârful Mont Blanc, luați haine groase.",
      "sourceEnText": "To go to the summit of Mont Blanc, take warm clothes.",
      "audioFile": "fr_08_0590129.mp3",
      "voiceProfile": "cristi",
      "actorId": "ADULT_F",
      "durationMs": 3265,
      "updatedAt": "2026-08-25T00:02:35Z",
      "textHash": "4da2b1e956ab8e352ad1ca47d34134608cf41de523541ce1be5ba662d16da2ca"
    },
    {
      "key": "059d744",
      "nodeTitle": "item_hat",
      "sourceText": "Pălăria te protejează de vânt.",
      "sourceEnText": "The hat protects you from the wind.",
      "audioFile": "fr_08_059d744.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1776,
      "updatedAt": "2026-08-25T00:01:31Z",
      "textHash": "2fa26d094bff74b84fb5e9e53affe078937cf4265d11e1c28f7b5bc6d374ad8d"
    },
    {
      "key": "05cabb5",
      "nodeTitle": "npc_intro",
      "sourceText": "Deschide cufărul ca să găsești rucsacul!",
      "sourceEnText": "Open the chest to find the backpack!",
      "audioFile": "fr_08_05cabb5.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2377,
      "updatedAt": "2026-08-25T00:01:10Z",
      "textHash": "a38471a50cebd2aa4e884a01a051e2eb4fce0cdcd53f8262877cb82a4be5894f"
    },
    {
      "key": "05e3658",
      "nodeTitle": "snowman",
      "sourceText": "Tabăra de bază 2",
      "sourceEnText": "Basecamp 2",
      "audioFile": "fr_08_05e3658.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 1463,
      "updatedAt": "2026-03-15T12:39:14Z",
      "textHash": "ad9ec574c824f74b5307277baacd62c5eb55ead8aa2c259ecf85edd73e7dbfd9"
    },
    {
      "key": "05e80cb",
      "nodeTitle": "item_backpack",
      "sourceText": "În rucsac se află apă, mâncare și o hartă.",
      "sourceEnText": "In the backpack, there is water, food, and a map.",
      "audioFile": "fr_08_05e80cb.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2952,
      "updatedAt": "2026-08-25T00:01:16Z",
      "textHash": "cec00dfada854a152b17930a0d325bc63f44eeae52de4d4e39c223a489a3d8e4"
    },
    {
      "key": "0650acc",
      "nodeTitle": "npc_intro",
      "sourceText": "Găsește haine groase și echipament de munte.",
      "sourceEnText": "Find warm clothing and mountain gear.",
      "audioFile": "fr_08_0650acc.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2612,
      "updatedAt": "2026-08-25T00:01:07Z",
      "textHash": "8bb1196a8ca5fcd0a426e6f7ceb1edf491e688ac65e010cde29e5b423b308ac5"
    },
    {
      "key": "06b15bb",
      "nodeTitle": "npc_base3",
      "sourceText": "Ți-ai echipamentul de munte. Încă un ultim efort pentru a ajunge pe vârf.",
      "sourceEnText": "You have your mountain gear. One last effort to reach the summit.",
      "audioFile": "fr_08_06b15bb.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 4754,
      "updatedAt": "2026-08-25T00:01:49Z",
      "textHash": "329d68f7b375319ef8fe383d78a7246faee81a74357ed3083ca828cc2ec9f987"
    },
    {
      "key": "06b3363",
      "nodeTitle": "npc_base2",
      "sourceText": "Nu ai mănuși!",
      "sourceEnText": "You don't have any gloves!",
      "audioFile": "fr_08_06b3363.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 993,
      "updatedAt": "2026-08-25T00:01:35Z",
      "textHash": "92fa4a0ba57b24dcb9543c4ee354bf2abee0b8ac1aaf432f60aa1cac4f65e93a"
    },
    {
      "key": "06d9f34",
      "nodeTitle": "npc_base3",
      "sourceText": "Ca să mergem pe gheața glaciară, avem nevoie de echipament special.",
      "sourceEnText": "To walk on glacier ice, we need special gear.",
      "audioFile": "fr_08_06d9f34.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 3971,
      "updatedAt": "2026-03-15T12:38:49Z",
      "textHash": "635453830545a21f4703f863539af4d36c131be1bd6ee3b9a09ae223b29e7099"
    },
    {
      "key": "06f9a2a",
      "nodeTitle": "question_alps",
      "sourceText": "În ce lanț muntos se află Mont Blanc?",
      "sourceEnText": "What mountain range is Mont Blanc in?",
      "audioFile": "fr_08_06f9a2a.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2194,
      "updatedAt": "2026-03-15T12:38:58Z",
      "textHash": "5e8dacc316ec4b3810cbd90c14fd74ce1a6595c384cae435e89ca1c580a30257"
    },
    {
      "key": "07102e7",
      "nodeTitle": "item_crampons",
      "sourceText": "Crampoanele te ajută să mergi pe gheață.",
      "sourceEnText": "Crampons help you walk on ice.",
      "audioFile": "fr_08_07102e7.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
