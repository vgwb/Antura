    {
      "key": "000fc05",
      "nodeTitle": "item_hat",
      "sourceText": "Cu o pălărie, nu ți se va răci capul.",
      "sourceEnText": "With a hat, your head won't get cold.",
      "audioFile": "fr_08_000fc05.mp3",
      "voiceProfile": "cristi",
      "actorId": "Default",
      "durationMs": 2247,
      "updatedAt": "2026-08-25T00:01:30Z",
