  "lang": "hu",
  "lines": [
    {
      "key": "000fc05",
      "nodeTitle": "item_hat",
      "sourceText": "Kalappal nem fog fázni a fejed.",
      "sourceEnText": "With a hat, your head won't get cold.",
      "audioFile": "fr_08_000fc05.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1933,
      "updatedAt": "2026-08-24T23:54:41Z",
      "textHash": "eedcdc56ff968bda94aaf7cf813e46f725577febe7ce9242ba686e61962b7fa1"
    },
    {
      "key": "001e940",
      "nodeTitle": "npc_base4",
      "sourceText": "Válaszolj három kérdésre a heggyel kapcsolatban.",
      "sourceEnText": "Answer three questions about the mountain.",
      "audioFile": "fr_08_001e940.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2900,
      "updatedAt": "2026-08-24T23:55:14Z",
      "textHash": "2e6ce49ca94763e11fe3a11f4584b8be312a1c3c1ad88d1732bde909ac7ef14c"
    },
    {
      "key": "003e87c",
      "nodeTitle": "chest_bonus",
      "sourceText": "Itt egy szép meleg sál! Vedd csak!",
      "sourceEnText": "Here's a nice warm scarf! Take it!",
      "audioFile": "fr_08_003e87c.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2116,
      "updatedAt": "2026-08-24T23:55:38Z",
      "textHash": "de305fa17b4e6028e35b71fec6f40af7c02d8b17a1d429504ea0cc8bc092cb35"
    },
    {
      "key": "003ecb2",
      "nodeTitle": "spawned_tourist",
      "sourceText": "A Mont Blanc Franciaország legmagasabb hegye.",
      "sourceEnText": "Mont Blanc is the highest mountain in France.",
      "audioFile": "fr_08_003ecb2.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2769,
      "updatedAt": "2026-08-24T23:55:42Z",
      "textHash": "51afbdfa4f62071625a57f538766fe6065404e61c584e1b23ca5e58c6cb6d329"
    },
    {
      "key": "00a7e83",
      "nodeTitle": "npc_base3",
      "sourceText": "Pontosan!",
      "sourceEnText": "Exact ! ",
      "audioFile": "fr_08_00a7e83.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 888,
      "updatedAt": "2026-08-24T23:55:04Z",
      "textHash": "4191a2cad9f320adaab168758c7303fadadb3d8e37c26bc01f98cfe023d0eaca"
    },
    {
      "key": "011dc7e",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Imádom a hegyeket. És te?",
      "sourceEnText": "I love the mountains. And you?",
      "audioFile": "fr_08_011dc7e.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1541,
      "updatedAt": "2026-08-24T23:55:41Z",
      "textHash": "a44d96a5a2db14614a01640e0c79a24953ca53a6418bb607c4e5ee1c84fbc13f"
    },
    {
      "key": "015bf8a",
      "nodeTitle": "npc_base1",
      "sourceText": "Most már készen állsz. Felmehetsz a Mont Blanc csúcsára!",
      "sourceEnText": "Now you're ready. You can go to the summit of Mont Blanc!",
      "audioFile": "fr_08_015bf8a.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3370,
      "updatedAt": "2026-08-24T23:54:30Z",
      "textHash": "1e93095d18163e81a6de6ac7f2ab300d724e1c952930223095d2173e4813079b"
    },
    {
      "key": "018880a",
      "nodeTitle": "npc_base4",
      "sourceText": "A Mont Blanc csúcsa 4807 méter magas.",
      "sourceEnText": "The summit of Mont Blanc is 4807 meters high.",
      "audioFile": "fr_08_018880a.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2847,
      "updatedAt": "2026-08-24T23:55:13Z",
      "textHash": "e103448b148d32b3d3c226e757d359e7a295851ff986fe379496ace22a257d73"
    },
    {
      "key": "01a4b20",
      "nodeTitle": "npc_base3",
      "sourceText": "pálmalevelek",
      "sourceEnText": "palm fronds",
      "audioFile": "fr_08_01a4b20.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1045,
      "updatedAt": "2026-08-24T23:55:06Z",
      "textHash": "e4214630c6cf1bb28533f762d5da4a2c73a38f01f6a3c0de078fd39be6028d8a"
    },
    {
      "key": "01beb5e",
      "nodeTitle": "npc_intro",
      "sourceText": "A kutya felment a hegyekbe a holmijaiddal.",
      "sourceEnText": "The dog went up into the mountains with your things.",
      "audioFile": "fr_08_01beb5e.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2534,
      "updatedAt": "2026-08-24T23:54:18Z",
      "textHash": "7a420930ae5ad37aca50419bdf55663a813f76fb3752ea97e34f50e71bdac57c"
    },
    {
      "key": "01e5f66",
      "nodeTitle": "spawned_hiker",
      "sourceText": "Készítettél már hóembert?",
      "sourceEnText": "Have you ever made a snowman?",
      "audioFile": "fr_08_01e5f66.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1541,
      "updatedAt": "2026-08-24T23:55:52Z",
      "textHash": "b442fbd67cbbef488b7e1c6faf00df2f456813d5e9d2fb12470b8c5367b6bb02"
    },
    {
      "key": "029a03e",
      "nodeTitle": "npc_base2",
      "sourceText": "A nap és a hó bántja a szemed. Szükséged van napszemüvegre.",
      "sourceEnText": "The sun and snow hurt your eyes. You need sunglasses.",
      "audioFile": "fr_08_029a03e.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3213,
      "updatedAt": "2026-08-24T23:54:48Z",
      "textHash": "5dc1b94e50567bc40aa7d723d1c72ec645ca29414f5d7d75223eff29a945dc93"
    },
    {
      "key": "029f39c",
      "nodeTitle": "item_backpack",
      "sourceText": "Most menj a hegyekbe. Keress meleg ruhát és hegyi felszerelést.",
      "sourceEnText": "Now go to the mountains. Find warm clothes and mountain gear.",
      "audioFile": "fr_08_029f39c.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3370,
      "updatedAt": "2026-08-24T23:54:28Z",
      "textHash": "9e4ffe2d2629114c69a2b620d0499a8ffa3738cbc16a8f9c2bf0c9e479270e33"
    },
    {
      "key": "02a2ea9",
      "nodeTitle": "item_sunglasses",
      "sourceText": "A hegyekben a nap és a hó bántja a szemet",
      "sourceEnText": "In the mountains, the sun and snow hurt the eyes",
      "audioFile": "fr_08_02a2ea9.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2482,
      "updatedAt": "2026-08-24T23:54:57Z",
      "textHash": "3cf35d813e578e2d3a15d93423c79ff444ac269ed471090e4161bac97bf0f348"
    },
    {
      "key": "02a3874",
      "nodeTitle": "snowman_1",
      "sourceText": "Nem köszönöm, itt maradok.",
      "sourceEnText": "No thanks, I'll stay here.",
      "audioFile": "fr_08_02a3874.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1411,
      "updatedAt": "2026-08-24T23:55:32Z",
      "textHash": "fbc03df2859fcea164168fb2319508a18dd2f0ac6fed3af83cc9d1d5b8117fdf"
    },
    {
      "key": "02c9805",
      "nodeTitle": "activity_3_done",
      "sourceText": "Nyisd ki a mellkast, hogy hágóvasakat kapj!",
      "sourceEnText": "Open the chest to get crampons!",
      "audioFile": "fr_08_02c9805.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2351,
      "updatedAt": "2026-03-15T12:33:52Z",
      "textHash": "2bd54e9244bbc7f77b0109085457860a576815c7fad321efe5bf736273ddd26c"
    },
    {
      "key": "030fa1c",
      "nodeTitle": "npc_base4",
      "sourceText": "Szép munka! Elérted a Mont Blanc csúcsát.",
      "sourceEnText": "Well done! You've reached the summit of Mont Blanc.",
      "audioFile": "fr_08_030fa1c.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2664,
      "updatedAt": "2026-08-24T23:55:11Z",
      "textHash": "c93dc2ae5430ea783494a6266e957a691a3d0ae354e82cb912646f2a22c22db5"
    },
    {
      "key": "035e68a",
      "nodeTitle": "snowman",
      "sourceText": "4. alaptábor",
      "sourceEnText": "Basecamp 4",
      "audioFile": "fr_08_035e68a.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1358,
      "updatedAt": "2026-03-15T12:34:14Z",
      "textHash": "d590a2d15191cf278c5fb56b453853a9f4751662c4691c8e13ac3c181b5716f0"
    },
    {
      "key": "0371d31",
      "nodeTitle": "spawned_alps_climber",
      "sourceText": "Egy hegyi vezető elkísérhet.",
      "sourceEnText": "A mountain guide can come with you.",
      "audioFile": "fr_08_0371d31.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1881,
      "updatedAt": "2026-08-24T23:55:56Z",
      "textHash": "09a79fe93c3ec7881d89eaeeda8cd2432e751f5d82e3aaef305b88620ee32476"
    },
    {
      "key": "038d1bc",
      "nodeTitle": "item_rope",
      "sourceText": "A kötél biztonságot nyújt jégen és sziklákon.",
      "sourceEnText": "The rope allows you to be safe on ice and rocks.",
      "audioFile": "fr_08_038d1bc.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2847,
      "updatedAt": "2026-08-24T23:55:10Z",
      "textHash": "2b1460bee5018300446c3cc39c47993138acc1a45dc977ee12fb00b99314cdaa"
    },
    {
      "key": "03db010",
      "nodeTitle": "npc_swiss",
      "sourceText": "Svájc a Mont Blanc-tól északra található.",
      "sourceEnText": "Switzerland is north of Mont Blanc.",
      "audioFile": "fr_08_03db010.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2429,
      "updatedAt": "2026-03-15T16:41:45Z",
      "textHash": "4e19abc867e3a5efffa2d696a478319320cb5cef45dc0306cb2517a5136107ab"
    },
    {
      "key": "03dd802",
      "nodeTitle": "npc_base1",
      "sourceText": "Nincs kabátod. Menj és keresd meg!",
      "sourceEnText": "You don't have a coat. Go find it!",
      "audioFile": "fr_08_03dd802.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2116,
      "updatedAt": "2026-08-24T23:54:33Z",
      "textHash": "68524e70d10f8572ff7fb83effa59fbad35e8f0406cbf0ad6689a1cdbbd95b58"
    },
    {
      "key": "045409f",
      "nodeTitle": "npc_intro",
      "sourceText": "Először is, szükséged van egy hátizsákra.",
      "sourceEnText": "First, you need a backpack.",
      "audioFile": "fr_08_045409f.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2534,
      "updatedAt": "2026-08-24T23:54:21Z",
      "textHash": "281176132f2eb36c757901024ea436c317c595dd7a22c8a1aa82e1a139f6ba4f"
    },
    {
      "key": "046eb33",
      "nodeTitle": "npc_intro",
      "sourceText": "Gyere vissza, ha megtaláltad.",
      "sourceEnText": "Come back when you've found it.",
      "audioFile": "fr_08_046eb33.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1646,
      "updatedAt": "2026-08-24T23:54:15Z",
      "textHash": "38c624ac7c694d08c0c293683b8df5e78040765f3f271231b78dee0b3153c539"
    },
    {
      "key": "04bbada",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Nézd meg jól! Mormotát fogsz látni.",
      "sourceEnText": "Look closely! You're going to see a marmot.",
      "audioFile": "fr_08_04bbada.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1881,
      "updatedAt": "2026-08-24T23:55:44Z",
      "textHash": "f8d6d2a633c992037a6a58ad0d95f34def1991d925c7517c7f704932df0df850"
    },
    {
      "key": "04c1c1f",
      "nodeTitle": "npc_intro",
      "sourceText": "Nálad van a hátizsákod. Most menj, hozd a meleg ruháidat és a hegyi felszerelésedet.",
      "sourceEnText": "You have your backpack. Now go get your warm clothes and mountain gear.",
      "audioFile": "fr_08_04c1c1f.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 4859,
      "updatedAt": "2026-08-24T23:54:11Z",
      "textHash": "6418576ce13d04e1df95e9e8006d7d4049ce4ffb292262bc0428cec21b6b5b9e"
    },
    {
      "key": "050fe70",
      "nodeTitle": "npc_italy",
      "sourceText": "Olaszország a Mont Blanc-tól keletre található.",
      "sourceEnText": "Italy is east of Mont Blanc.",
      "audioFile": "fr_08_050fe70.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3082,
      "updatedAt": "2026-03-15T16:41:44Z",
      "textHash": "a39e0ddcf4b62660428d390b49a2e5687240f2a7094bb32796e4833b5299d090"
    },
    {
      "key": "0557ef5",
      "nodeTitle": "spawned_hiker",
      "sourceText": "Hó van a hegyekben.",
      "sourceEnText": "There is snow in the mountains.",
      "audioFile": "fr_08_0557ef5.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 1280,
      "updatedAt": "2026-08-24T23:55:49Z",
      "textHash": "e17242576211a1b63183c7e59be28c443bd0500ebc998ac69090ae0270290eba"
    },
    {
      "key": "056ec2b",
      "nodeTitle": "chest_base1",
      "sourceText": "A láda kinyílik! Van benne némi felszerelés.",
      "sourceEnText": "The chest opens! It contains some equipment.",
      "audioFile": "fr_08_056ec2b.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2795,
      "updatedAt": "2026-08-24T23:54:38Z",
      "textHash": "803be03771a936c99451a59fc661e4a73b389be42214daa58d6d64ea9edecae9"
    },
    {
      "key": "058bb65",
      "nodeTitle": "snowman",
      "sourceText": "3. alaptábor",
      "sourceEnText": "Basecamp 3",
      "audioFile": "fr_08_058bb65.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1358,
      "updatedAt": "2026-03-15T12:34:14Z",
      "textHash": "e89a6e3d1c8968ccd0973702ef49dc97453db845a4ecda4d65d2feeab138c8c5"
    },
    {
      "key": "0590129",
      "nodeTitle": "spawned_tourist",
      "sourceText": "A Mont Blanc csúcsára való feljutáshoz vigyél magaddal meleg ruhát.",
      "sourceEnText": "To go to the summit of Mont Blanc, take warm clothes.",
      "audioFile": "fr_08_0590129.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 3788,
      "updatedAt": "2026-08-24T23:55:45Z",
      "textHash": "c292f4fd468b32542577f84b2ac65603a0b8513da86cb075b55d7f0ffd25d479"
    },
    {
      "key": "059d744",
      "nodeTitle": "item_hat",
      "sourceText": "A sapka megvéd a széltől.",
      "sourceEnText": "The hat protects you from the wind.",
      "audioFile": "fr_08_059d744.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1776,
      "updatedAt": "2026-08-24T23:54:42Z",
      "textHash": "0d366225275ce481ce89ce5b58466dfa3468025b657f0c7811b64bcacfd5b628"
    },
    {
      "key": "05cabb5",
      "nodeTitle": "npc_intro",
      "sourceText": "Nyisd ki a ládát, hogy megtaláld a hátizsákot!",
      "sourceEnText": "Open the chest to find the backpack!",
      "audioFile": "fr_08_05cabb5.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2717,
      "updatedAt": "2026-08-24T23:54:23Z",
      "textHash": "ec924d0d83062341b926f2391e1a159e43b236b30823371fc1f710adfcdd7a2f"
    },
    {
      "key": "05e3658",
      "nodeTitle": "snowman",
      "sourceText": "2. alaptábor",
      "sourceEnText": "Basecamp 2",
      "audioFile": "fr_08_05e3658.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1045,
      "updatedAt": "2026-03-15T12:34:13Z",
      "textHash": "3249d9ddeda53bc910ef3ab33bde2ef8296ddfe932300e85c802f228615d7892"
    },
    {
      "key": "05e80cb",
      "nodeTitle": "item_backpack",
      "sourceText": "A hátizsákban víz, élelem és egy térkép van.",
      "sourceEnText": "In the backpack, there is water, food, and a map.",
      "audioFile": "fr_08_05e80cb.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3187,
      "updatedAt": "2026-08-24T23:54:27Z",
      "textHash": "d7a53e2edeab6730f4a3e454d6cbfa3f7d0927440c04492a39c6edce68ca1eb6"
    },
    {
      "key": "0650acc",
      "nodeTitle": "npc_intro",
      "sourceText": "Szerezz be meleg ruhát és hegyi felszerelést.",
      "sourceEnText": "Find warm clothing and mountain gear.",
      "audioFile": "fr_08_0650acc.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2612,
      "updatedAt": "2026-08-24T23:54:19Z",
      "textHash": "e1968fa359c9d20fcd2f98728ed2314babe8c9a3203dd42a2f0fb68b10e762c9"
    },
    {
      "key": "06b15bb",
      "nodeTitle": "npc_base3",
      "sourceText": "Megvan a hegyi felszerelésed. Már csak egy utolsó erőfeszítés a csúcs eléréséhez.",
      "sourceEnText": "You have your mountain gear. One last effort to reach the summit.",
      "audioFile": "fr_08_06b15bb.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 4885,
      "updatedAt": "2026-08-24T23:55:00Z",
      "textHash": "aefb2c5322f6c2843b955ab0de4cfdf9dec928795e85fa982a80c6cdfdd0e131"
    },
    {
      "key": "06b3363",
      "nodeTitle": "npc_base2",
      "sourceText": "Nincs is kesztyűd!",
      "sourceEnText": "You don't have any gloves!",
      "audioFile": "fr_08_06b3363.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1280,
      "updatedAt": "2026-08-24T23:54:46Z",
      "textHash": "ff116936e60372e1e332dc70cf3f3a4fd9f84c9508ff3c8d069f69973c9297ec"
    },
    {
      "key": "06d9f34",
      "nodeTitle": "npc_base3",
      "sourceText": "A gleccserek jégén való járáshoz speciális felszerelésre van szükségünk.",
      "sourceEnText": "To walk on glacier ice, we need special gear.",
      "audioFile": "fr_08_06d9f34.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 4519,
      "updatedAt": "2026-03-15T12:33:48Z",
      "textHash": "0b7a8dd839f79d5ad5798fc4e11410b8fc8d30c93f36ffcb005a8a70fcddd383"
    },
    {
      "key": "06f9a2a",
      "nodeTitle": "question_alps",
      "sourceText": "Melyik hegységben található a Mont Blanc?",
      "sourceEnText": "What mountain range is Mont Blanc in?",
      "audioFile": "fr_08_06f9a2a.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2299,
      "updatedAt": "2026-03-15T12:33:58Z",
      "textHash": "bae7f47bdb8c999103a897c576f0fbc3a3654548e27318179971a0e1430d0f3d"
    },
    {
      "key": "07102e7",
      "nodeTitle": "item_crampons",
      "sourceText": "A hágóvas segít a jégen járni.",
      "sourceEnText": "Crampons help you walk on ice.",
      "audioFile": "fr_08_07102e7.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T23:55:08Z",
      "textHash": "79512298bf72fd7575cdbee0561d7703cd11ff92865aaae1feeba042a4cbce27"
    },
    {
      "key": "0724de3",
      "nodeTitle": "npc_intro",
      "sourceText": "Segítség! Én vagyok a hegyi vezetőd. Egy kék kutya vitte el a holmidat.",
      "sourceEnText": "Help me! I'm your mountain guide. A blue dog took your things.",
      "audioFile": "fr_08_0724de3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 4232,
      "updatedAt": "2026-08-24T23:54:17Z",
      "textHash": "23354b9cc10c69b8e4f104275397355aadc86ad2835955d30a847c8f6ee446b8"
    },
    {
      "key": "076433f",
      "nodeTitle": "npc_base3",
      "sourceText": "Mit kell felvenni a cipőre, ha jégen kell járni?",
      "sourceEnText": "What do you put on your shoes to walk on ice?",
      "audioFile": "fr_08_076433f.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2717,
      "updatedAt": "2026-08-24T23:55:03Z",
      "textHash": "d9ff001464bcb078103cf63dec29cd29e0b0f7ae6ff682dbff10d5c84b20b45f"
    },
    {
      "key": "07c6385",
      "nodeTitle": "npc_base3",
      "sourceText": "Nem! Nem az uszodában vagy! Próbáld újra.",
      "sourceEnText": "No! You're not at the swimming pool! Try again.",
      "audioFile": "fr_08_07c6385.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2011,
      "updatedAt": "2026-08-24T23:55:07Z",
      "textHash": "a645ed86bf0c7df48bfaa465901ea292316255bee5dfbc03effc181602aec183"
    },
    {
      "key": "07f2635",
      "nodeTitle": "snowman",
      "sourceText": "1. alaptábor",
      "sourceEnText": "Basecamp 1",
      "audioFile": "fr_08_07f2635.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1176,
      "updatedAt": "2026-03-15T12:34:12Z",
      "textHash": "fabd835f687cba68afc0eb9d3cbe2c8051754f6380a948852bc70ae319e1bf7d"
    },
    {
      "key": "07f2699",
      "nodeTitle": "npc_intro",
      "sourceText": "Szerezz be meleg ruhákat és hegyi felszerelést.",
      "sourceEnText": "Find warm clothes and mountain gear.",
      "audioFile": "fr_08_07f2699.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2900,
      "updatedAt": "2026-08-24T23:54:14Z",
      "textHash": "1e9e2440341e31b3b7e80ff8121429bac57476eb559c6b03742cd4a60c932f73"
    },
    {
      "key": "0809dce",
      "nodeTitle": "spawned_alps_climber",
      "sourceText": "A Mont Blanc egy nagyon szép hegy.",
      "sourceEnText": "Mont Blanc is a very beautiful mountain.",
      "audioFile": "fr_08_0809dce.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 2116,
      "updatedAt": "2026-08-24T23:55:53Z",
      "textHash": "168743bcec783c4ea72d862ce9f07243d1e6c79df22649e0f0fcfa5bc85e396f"
    },
    {
      "key": "081fbe4",
      "nodeTitle": "spawned_alps_climber",
      "sourceText": "Szeretnél felmenni a hegyekbe?",
      "sourceEnText": "Do you want to go to the mountains?",
      "audioFile": "fr_08_081fbe4.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1593,
      "updatedAt": "2026-08-24T23:55:55Z",
      "textHash": "57364d9eb4f37a034c53bf8d8f35f237905b5625aaf1d9673cc98b57c75bcdea"
    },
    {
      "key": "088fb7f",
      "nodeTitle": "item_sunglasses",
      "sourceText": "A napszemüveg védi a szemet.",
      "sourceEnText": "Sunglasses protect the eyes.",
      "audioFile": "fr_08_088fb7f.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1959,
      "updatedAt": "2026-08-24T23:54:59Z",
      "textHash": "8bed9810d22008d1cc02335df633cd45205be6a102153029b66cab34aaddd1bc"
    },
    {
      "key": "097ecf0",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Figyelem! A hegy veszélyes.",
      "sourceEnText": "Warning! The mountain is dangerous.",
      "audioFile": "fr_08_097ecf0.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_F",
      "durationMs": 1724,
      "updatedAt": "2026-08-24T23:55:47Z",
      "textHash": "ea7c27217d78a695cca0306361d6c14b02fbff48d848166ba56b6013dcf93d4e"
    },
    {
      "key": "0a70f7d",
      "nodeTitle": "npc_base2",
      "sourceText": "Mi védi a szemet?",
      "sourceEnText": "What protects the eyes?",
      "audioFile": "fr_08_0a70f7d.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1358,
      "updatedAt": "2026-08-24T23:54:49Z",
      "textHash": "76550623a499cec6c5ec380393331086078ddb785721535debce0a3efd1a58a1"
    },
    {
      "key": "0a7146f",
      "nodeTitle": "item_hat",
      "sourceText": "Mássz tovább!",
      "sourceEnText": "Keep climbing!",
      "audioFile": "fr_08_0a7146f.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1123,
      "updatedAt": "2026-08-24T23:54:44Z",
      "textHash": "882949df2c8e84246ed1bc494701a4dd82cbf93412094f576e476c9e00f0bf3e"
    },
    {
      "key": "0afb2dc",
      "nodeTitle": "item_scarf",
      "sourceText": "Egy sállal nem fog fázni a nyakad.",
      "sourceEnText": "With a scarf, your neck won't get cold.",
      "audioFile": "fr_08_0afb2dc.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2142,
      "updatedAt": "2026-08-24T23:55:40Z",
      "textHash": "ec1d4770aec137614d7a569a755ae67f99276f703ab12a79fb3f787511a26112"
    },
    {
      "key": "0b50050",
      "nodeTitle": "npc_base3",
      "sourceText": "Hágóvasak",
      "sourceEnText": "Crampons",
      "audioFile": "fr_08_0b50050.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 993,
      "updatedAt": "2026-03-15T12:33:50Z",
      "textHash": "99a4a3fd1d3c286e3ae507ee3c4eadcc2f95734b897d7856a43218e548abc522"
    },
    {
      "key": "0bc67f7",
      "nodeTitle": "spawned_hiker",
      "sourceText": "Nézd meg jól! Egy kőszáli kecskét fogsz látni.",
      "sourceEnText": "Look closely! You're going to see an ibex.",
      "audioFile": "fr_08_0bc67f7.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 2429,
      "updatedAt": "2026-08-24T23:55:51Z",
      "textHash": "3097032536665ae6f503a4eeec009acb5639849636b8e081431688840ace07e8"
    },
    {
      "key": "0c18060",
      "nodeTitle": "snowman_1",
      "sourceText": "Segítségre van szükséged a továbblépéshez?",
      "sourceEnText": "Do you need help getting on?",
      "audioFile": "fr_08_0c18060.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2429,
      "updatedAt": "2026-08-24T23:55:30Z",
      "textHash": "ebf99435ae3177c0c41656b82a0db0f88415d04e287616471e9d8cee33a8c3c5"
    },
    {
      "key": "0c18c08",
      "nodeTitle": "npc_base3",
      "sourceText": "Nincs nálad köteled!",
      "sourceEnText": "You don't have a rope!",
      "audioFile": "fr_08_0c18c08.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1411,
      "updatedAt": "2026-08-24T23:55:02Z",
      "textHash": "61dc20bc33ca70a9150abd21ff9cc1c2d96cad3f27eb4f915ec592c04ca5c274"
    },
    {
      "key": "0c1f006",
      "nodeTitle": "chest_intro",
      "sourceText": "Nyílik a láda! Vedd a hátizsákot!",
      "sourceEnText": "The chest opens! Take the backpack.",
      "audioFile": "fr_08_0c1f006.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2116,
      "updatedAt": "2026-08-24T23:54:24Z",
      "textHash": "f670bd164e6eb39eb6d5a33adc7c48349cfac7626161424347c5cdd7dae91c86"
    },
    {
      "key": "0d01879",
      "nodeTitle": "item_gloves",
      "sourceText": "Hideg van a hegyekben",
      "sourceEnText": "It's cold in the mountains",
      "audioFile": "fr_08_0d01879.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1358,
      "updatedAt": "2026-08-24T23:54:56Z",
      "textHash": "265fcf8a87d8007ecc3f96a209fcefb745def43922cd580fd8dbe9631f754ce3"
    },
    {
      "key": "0d23529",
      "nodeTitle": "npc_france",
      "sourceText": "Franciaország a Mont Blanc-tól nyugatra található.",
      "sourceEnText": "France is west of Mont Blanc.",
      "audioFile": "fr_08_0d23529.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2900,
      "updatedAt": "2026-08-24T23:55:28Z",
      "textHash": "83dd0a6ee5f51658301def7a1fae02bbbe9d7326ed19801545e569fd9a5c13b3"
    },
    {
      "key": "0dbac73",
      "nodeTitle": "spawned_hiker",
      "sourceText": "A hegyekbe menéshez vigyél magaddal jó cipőt.",
      "sourceEnText": "To go into the mountains, take good shoes.",
      "audioFile": "fr_08_0dbac73.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 2429,
      "updatedAt": "2026-08-24T23:55:48Z",
      "textHash": "9a81e8aa75b3fa2205cfd7a0d6d9f6e472e28fb9c04523d5795e60e8c294717f"
    },
    {
      "key": "0e23f1f",
      "nodeTitle": "item_coat",
      "sourceText": "Kabátban melegen maradsz, ha szeles vagy havas az idő.",
      "sourceEnText": "With a coat, you stay warm when it's windy or snowy.",
      "audioFile": "fr_08_0e23f1f.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3135,
      "updatedAt": "2026-08-24T23:54:40Z",
      "textHash": "42819252fde52a0192c3aa9a23b55ffe2e44e326b19d2c93df3220a8dc8d89d3"
    },
    {
      "key": "0e83480",
      "nodeTitle": "activity_1_done",
      "sourceText": "Nyisd ki a ládát, hogy megtaláld a kalapot!",
      "sourceEnText": "Open the chest to find the hat!",
      "audioFile": "fr_08_0e83480.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2142,
      "updatedAt": "2026-08-24T23:54:37Z",
      "textHash": "d5a12fcb7e2ac3afe0b16d1ceb27e55f6011127a0059d1ddbaa53e2f43ab9be1"
    },
    {
      "key": "0f2aac7",
      "nodeTitle": "item_gloves",
      "sourceText": "A kesztyűk védik a kezeket.",
      "sourceEnText": "The gloves protect the hands.",
      "audioFile": "fr_08_0f2aac7.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1776,
      "updatedAt": "2026-08-24T23:54:54Z",
      "textHash": "5d1a543c4f93a4c3e2c1194424146e39140f119708bae2cc5057b2f457ab7a1d"
    },
    {
      "key": "0f4644b",
      "nodeTitle": "npc_intro",
      "sourceText": "Mássz fel a Mont Blanc tetejére",
      "sourceEnText": "Climb to the top of Mont Blanc",
      "audioFile": "fr_08_0f4644b.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1933,
      "updatedAt": "2026-08-24T23:54:12Z",
      "textHash": "989278768ab5c88f494ebccede62b4f39ac44f70ef3a8af3719a3a7c71b16d86"
    },
    {
      "key": "0f4c405",
      "nodeTitle": "snowman_1",
      "sourceText": "Igen, kérlek segíts nekem.",
      "sourceEnText": "Yes, please help me.",
      "audioFile": "fr_08_0f4c405.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1593,
      "updatedAt": "2026-08-24T23:55:31Z",
      "textHash": "0a8b7043eba3b0e4e711d34d0b9135dfa73cdf161e937aab40ab299688960190"
    },
    {
      "key": "0fdc3cb",
      "nodeTitle": "activity_2_done",
      "sourceText": "Nyisd ki a csomagtartót, hogy megtaláld a napszemüveget!",
      "sourceEnText": "Open the trunk to find the sunglasses!",
      "audioFile": "fr_08_0fdc3cb.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2952,
      "updatedAt": "2026-08-24T23:54:52Z",
      "textHash": "9db2975c8db8d9dd9c1d76f355d91d817b81b24333cefb60a55aacd440a972f1"
    },
    {
      "key": "b1_1",
      "nodeTitle": "npc_base1",
      "sourceText": "Szeles van. Védened kell a füledet.",
      "sourceEnText": "It's windy. You need to protect your ears.",
      "audioFile": "fr_08_b1_1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2247,
      "updatedAt": "2026-08-24T23:54:34Z",
      "textHash": "ea3106358cbc494ef23eaf73d76b10db524b0aa12c52c2f70ca1c9414437024b"
    },
    {
      "key": "b1_q",
      "nodeTitle": "npc_base1",
      "sourceText": "Hogyan védd a füleidet?",
      "sourceEnText": "How to protect your ears?",
      "audioFile": "fr_08_b1_q.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1463,
      "updatedAt": "2026-08-24T23:54:35Z",
      "textHash": "8e84c1e917f01889b8025f7ae8afcdc338b427889b1dedd98c3e55e33b47e21c"
    },
    {
      "key": "chest_locked",
      "nodeTitle": "chest_intro",
      "sourceText": "A láda zárva van. Keresd meg a kulcsot a nyitásához.",
      "sourceEnText": "The chest is locked. Find the key to open it.",
      "audioFile": "fr_08_chest_locked.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3396,
      "updatedAt": "2026-08-24T23:54:25Z",
      "textHash": "b7107fd205fa783e8f63c35d7f272451b521285f585bf609f19eb2dc940c4585"
    },
    {
      "key": "comebacklater",
      "nodeTitle": "question_alps",
      "sourceText": "Gyere vissza később!",
      "sourceEnText": "Come back later!",
      "audioFile": "fr_08_comebacklater.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1411,
      "updatedAt": "2026-03-15T18:58:56Z",
      "textHash": "70b839038a3e21bae3e6036819ffa0c0563f4258d91a99ab7d07b0dda5a2e88a"
    },
    {
      "key": "correct",
      "nodeTitle": "question_alps",
      "sourceText": "Így van.",
      "sourceEnText": "That's right.",
      "audioFile": "fr_08_correct.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 888,
      "updatedAt": "2026-08-24T23:55:17Z",
      "textHash": "b2829c67c6e14768a3b2f90fdb8efe913e1cd7176ba6c1468149fbcd46e5a566"
    },
    {
      "key": "dontknow",
      "nodeTitle": "question_alps",
      "sourceText": "Nem tudom",
      "sourceEnText": "I don't know",
      "audioFile": "fr_08_dontknow.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 758,
      "updatedAt": "2026-03-15T18:58:56Z",
      "textHash": "099c47eff0972328fa4832ed702e7410bb3558aae798c50b3f03b1f856e1f501"
    },
    {
      "key": "end_1",
      "nodeTitle": "quest_end",
      "sourceText": "Szép munka! Elérted a Mont Blanc csúcsát. 4807 méter magas. Ez Franciaország legmagasabb hegye.",
      "sourceEnText": "Well done! You've reached the summit of Mont Blanc. It measures 4807 meters. It's the highest mountain in France.",
      "audioFile": "fr_08_end_1.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 7027,
      "updatedAt": "2026-08-24T23:54:07Z",
      "textHash": "6f5710ec67965efc99f9efe296781b94115df42945dffa1550e1124d900005d4"
    },
    {
      "key": "end_2",
      "nodeTitle": "quest_end",
      "sourceText": "Az Alpokban számos nagy és gyönyörű hegy található.",
      "sourceEnText": "In the Alps, there are many large and beautiful mountains.",
      "audioFile": "fr_08_end_2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3213,
      "updatedAt": "2026-08-24T23:54:08Z",
      "textHash": "9afcaa01dd17a4360c2aa73acddc7dbaa92ba9a474ef583c7391a12e1621206b"
    },
    {
      "key": "fr08_b2_chest",
      "nodeTitle": "chest_base2",
      "sourceText": "Nyitva van a csomagtartó! Vedd ki a napszemüveget!",
      "sourceEnText": "The trunk is open! Take out the sunglasses.",
      "audioFile": "fr_08_fr08_b2_chest.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2978,
      "updatedAt": "2026-08-24T23:54:53Z",
      "textHash": "df444d538dde9c1128b0522b51c526002cc7a1ca74983549325232c6c8d5d9b1"
    },
    {
      "key": "fr08_b2_help",
      "nodeTitle": "npc_base2",
      "sourceText": "A hóember segíthet neked.",
      "sourceEnText": "The snowman can help you.",
      "audioFile": "fr_08_fr08_b2_help.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1776,
      "updatedAt": "2026-08-24T23:54:45Z",
      "textHash": "e7771c96ee94222bec5903acea8177a2d9eb8aed886281f527508de8786480a4"
    },
    {
      "key": "fr08_marmot_2",
      "nodeTitle": "marmot",
      "sourceText": "Egész télen alszom, azt mondják, téli álmot alszom.",
      "sourceEnText": "I sleep all winter, they say I hibernate.",
      "audioFile": "fr_08_fr08_marmot_2.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 2978,
      "updatedAt": "2026-08-24T23:55:34Z",
      "textHash": "5809261243ac47980bb1a45c0ebb452c64952d5499afbbdda75bc4110e36cefc"
    },
    {
      "key": "fr08_marmot_3",
      "nodeTitle": "marmot",
      "sourceText": "Imádok virágokat, gyümölcsöket és fűszernövényeket enni. Nyami!",
      "sourceEnText": "I love eating flowers, fruits, and herbs. Yum!",
      "audioFile": "fr_08_fr08_marmot_3.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 3788,
      "updatedAt": "2026-08-24T23:55:35Z",
      "textHash": "cf8bbd0680f6cba5b75f2b49ee986164c21d0bda6c152ee30ee81501837887b5"
    },
    {
      "key": "fr08_marmot_4",
      "nodeTitle": "marmot",
      "sourceText": "Szeretek a napon pihenni.",
      "sourceEnText": "I like to relax in the sun.",
      "audioFile": "fr_08_fr08_marmot_4.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1463,
      "updatedAt": "2026-08-24T23:55:37Z",
      "textHash": "a06a56227112a44b71f813af8b491ed9f788abd1127ad347590fcc118d3f03c2"
    },
    {
      "key": "keep_looking",
      "nodeTitle": "npc_base2",
      "sourceText": "Tovább keresgélj.",
      "sourceEnText": "Keep searching.",
      "audioFile": "fr_08_keep_looking.mp3",
      "voiceProfile": "shelley",
      "actorId": "Default",
      "durationMs": 1123,
      "updatedAt": "2026-08-24T23:54:50Z",
      "textHash": "a2d5dbf0c7bcab36d4c76058db3ce7276c4c2820ca47d1b1ced57b08ed07f25e"
    },
    {
      "key": "post_1",
      "nodeTitle": "post_quest_activity",
      "sourceText": "Rajzold le a füzetedbe a Mont Blanc-t, valamint Franciaország, Svájc és Olaszország zászlaját.",
