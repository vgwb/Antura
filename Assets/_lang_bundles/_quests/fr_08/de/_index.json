      "key": "06f9a2a",
      "nodeTitle": "question_alps",
      "sourceText": "In welchem ​​Gebirge liegt der Mont Blanc?",
      "sourceEnText": "In which mountain range is Mont Blanc located?",
      "audioFile": "fr_08_06f9a2a.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2247,
      "updatedAt": "2026-08-24T18:56:33Z",
