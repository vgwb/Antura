    },
    {
      "key": "0371d31",
      "nodeTitle": "spawned_alps_climber",
      "sourceText": "Ein Bergführer kann Sie begleiten.",
      "sourceEnText": "A mountain guide can come with you.",
      "audioFile": "fr_08_0371d31.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2351,
      "updatedAt": "2026-08-24T18:58:14Z",
