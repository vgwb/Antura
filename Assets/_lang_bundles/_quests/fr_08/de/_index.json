    },
    {
      "key": "038d1bc",
      "nodeTitle": "item_rope",
      "sourceText": "Das Seil sorgt für Sicherheit auf Eis und Felsen.",
      "sourceEnText": "The rope allows you to be safe on ice and rocks.",
      "audioFile": "fr_08_038d1bc.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3448,
      "updatedAt": "2026-08-24T18:56:23Z",
      "textHash": "e688b90aae944172413b1bc6d7b835e4049a75930e3ac0286797dfaa3fde4526"
