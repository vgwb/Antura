    },
    {
      "key": "059d744",
      "nodeTitle": "item_hat",
      "sourceText": "Der Hut schützt dich vor dem Wind.",
      "sourceEnText": "The hat protects you from the wind.",
      "audioFile": "fr_08_059d744.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
