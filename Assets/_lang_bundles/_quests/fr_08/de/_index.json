      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3631,
      "updatedAt": "2026-08-24T18:55:01Z",
      "textHash": "c4e549e1fbbab1fe09be6e8be973becfb3957a0e9fbb0c34d99ae2aad9145c1b"
    },
    {
      "key": "0650acc",
      "nodeTitle": "npc_intro",
      "sourceText": "Finden Sie warme Kleidung und Bergausrüstung.",
      "sourceEnText": "Find warm clothing and mountain gear.",
      "audioFile": "fr_08_0650acc.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2847,
