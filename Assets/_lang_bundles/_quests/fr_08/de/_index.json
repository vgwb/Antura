      "sourceText": "Steigeisen helfen beim Gehen auf Eis.",
      "sourceEnText": "Crampons help you walk on ice.",
      "audioFile": "fr_08_07102e7.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2978,
