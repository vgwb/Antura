    },
    {
      "key": "001e940",
      "nodeTitle": "npc_base4",
      "sourceText": "Beantworten Sie drei Fragen zum Berg.",
      "sourceEnText": "Answer three questions about the mountain.",
      "audioFile": "fr_08_001e940.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2482,
      "updatedAt": "2026-08-24T18:56:31Z",
      "textHash": "ed5d7fa7b338d4896a64c2bba5986500bdf597f6a87265b593250da6cfd070ad"
    },
    {
      "key": "003e87c",
      "nodeTitle": "chest_bonus",
      "sourceText": "Hier ist ein schöner, warmer Schal! Nimm ihn!",
      "sourceEnText": "Here's a nice warm scarf! Take it!",
      "audioFile": "fr_08_003e87c.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3213,
      "updatedAt": "2026-08-24T18:57:44Z",
      "textHash": "6e8a303a473d410104bc10c6aabb7429dcd763710814f1a485af134a06c18363"
    },
    {
      "key": "003ecb2",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Der Mont Blanc ist der höchste Berg Frankreichs.",
      "sourceEnText": "Mont Blanc is the highest mountain in France.",
      "audioFile": "fr_08_003ecb2.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 3265,
      "updatedAt": "2026-08-24T18:57:51Z",
      "textHash": "a06bc02b75c9b1d09bcfd97d10e4e3402ac1e24cd53a67687cd7b4305a52a1de"
    },
    {
      "key": "00a7e83",
      "nodeTitle": "npc_base3",
      "sourceText": "Genau!",
      "sourceEnText": "Exact ! ",
      "audioFile": "fr_08_00a7e83.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1045,
      "updatedAt": "2026-08-24T18:56:11Z",
      "textHash": "388ba3d5659edcfb6c9a1462cc832af72b3bd13f320c288bdefbe78ea5888e3f"
    },
    {
      "key": "011dc7e",
      "nodeTitle": "spawned_tourist",
      "sourceText": "Ich liebe die Berge. Und du?",
      "sourceEnText": "I love the mountains. And you?",
      "audioFile": "fr_08_011dc7e.mp3",
      "voiceProfile": "alice",
      "actorId": "ADULT_F",
      "durationMs": 2011,
      "updatedAt": "2026-08-24T18:57:49Z",
      "textHash": "125cffe073b238f365230067d6805fbcac222e2843a5b189446176f5fda13a82"
    },
    {
      "key": "015bf8a",
      "nodeTitle": "npc_base1",
      "sourceText": "Jetzt bist du bereit. Du kannst den Gipfel des Mont Blanc besteigen!",
      "sourceEnText": "Now you're ready. You can go to the summit of Mont Blanc!",
      "audioFile": "fr_08_015bf8a.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4232,
      "updatedAt": "2026-08-24T18:55:06Z",
      "textHash": "8b1de16dea3ca100bb63286696db3811463b1f42c395f7c553f7f98d3d93f781"
    },
    {
      "key": "018880a",
      "nodeTitle": "npc_base4",
      "sourceText": "Der Gipfel des Mont Blanc ist 4807 Meter hoch.",
      "sourceEnText": "The summit of Mont Blanc is 4807 meters high.",
      "audioFile": "fr_08_018880a.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4101,
      "updatedAt": "2026-08-24T18:56:28Z",
      "textHash": "8cabf795a10e37e25a9cbfd2a82b8122b16b23a27104091ccfba373d89c6e093"
    },
    {
      "key": "01a4b20",
      "nodeTitle": "npc_base3",
      "sourceText": "Palmenwedel",
      "sourceEnText": "palm fronds",
      "audioFile": "fr_08_01a4b20.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1228,
      "updatedAt": "2026-08-24T18:56:14Z",
      "textHash": "97e7e6cb1ceb04002c4c3e6f26bc54641cc59e1c002adbd639f1d2d02e9da5e2"
    },
    {
      "key": "01beb5e",
      "nodeTitle": "npc_intro",
      "sourceText": "Der Hund ist mit deinen Sachen in die Berge hinaufgegangen.",
      "sourceEnText": "The dog went up into the mountains with your things.",
      "audioFile": "fr_08_01beb5e.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2978,
      "updatedAt": "2026-08-24T18:54:46Z",
      "textHash": "28dd0a400dbb1334c61e89fb893ddaeef286627a7a50ddcee1968d53651bd798"
    },
    {
      "key": "01e5f66",
      "nodeTitle": "spawned_hiker",
      "sourceText": "Hast du schon mal einen Schneemann gebaut?",
      "sourceEnText": "Have you ever made a snowman?",
      "audioFile": "fr_08_01e5f66.mp3",
      "voiceProfile": "shelley",
      "actorId": "ADULT_M",
      "durationMs": 2011,
      "updatedAt": "2026-08-24T18:58:06Z",
      "textHash": "c81ac06cebb081e0e963149942b518bee4d4f8b4b0047d0cd71c909fa6354233"
    },
    {
      "key": "029a03e",
      "nodeTitle": "npc_base2",
      "sourceText": "Sonne und Schnee brennen in den Augen. Du brauchst eine Sonnenbrille.",
      "sourceEnText": "The sun and snow hurt your eyes. You need sunglasses.",
      "audioFile": "fr_08_029a03e.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4624,
      "updatedAt": "2026-08-24T18:55:37Z",
      "textHash": "6d6b1e61dd0be288451cf427752edac37cda734cbef54beb09af1d4d0eab36a5"
    },
    {
      "key": "029f39c",
      "nodeTitle": "item_backpack",
      "sourceText": "Geh jetzt in die Berge. Besorg dir warme Kleidung und Bergausrüstung.",
      "sourceEnText": "Now go to the mountains. Find warm clothes and mountain gear.",
      "audioFile": "fr_08_029f39c.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 4624,
      "updatedAt": "2026-08-24T18:55:03Z",
      "textHash": "6e1e2dcea309b7b1809093b2dec33f707f22f51aa2662434acd0d8daaf424a33"
    },
    {
      "key": "02a2ea9",
      "nodeTitle": "item_sunglasses",
      "sourceText": "In den Bergen schmerzten Sonne und Schnee in den Augen.",
      "sourceEnText": "In the mountains, the sun and snow hurt the eyes",
      "audioFile": "fr_08_02a2ea9.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3605,
      "updatedAt": "2026-08-24T18:55:54Z",
      "textHash": "350806c0332c38c8d2e5921fb36c5beb6f94be0bb87e5f6733aedf3284b531a2"
    },
    {
      "key": "02a3874",
      "nodeTitle": "snowman_1",
      "sourceText": "Nein danke, ich bleibe hier.",
      "sourceEnText": "No thanks, I'll stay here.",
      "audioFile": "fr_08_02a3874.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1593,
      "updatedAt": "2026-08-24T18:57:33Z",
      "textHash": "1fb024eeabd8ee01474ec910b061e3c7f3907f3edd8c87dfad2f57d66a5c5b47"
    },
    {
      "key": "02c9805",
      "nodeTitle": "node",
      "sourceText": "Öffne die Truhe, um Steigeisen zu erhalten!",
      "sourceEnText": "Open the chest to get crampons!",
      "audioFile": "fr_08_02c9805.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3082,
      "updatedAt": "2026-08-24T18:56:19Z",
      "textHash": "1f03ad35cbf32b73ed50be07c528924bc14ea66fc91a8dd5cf91964fb72c8aa0"
    },
    {
      "key": "030fa1c",
      "nodeTitle": "npc_base4",
      "sourceText": "Gut gemacht! Sie haben den Gipfel des Mont Blanc erreicht.",
      "sourceEnText": "Well done! You've reached the summit of Mont Blanc.",
      "audioFile": "fr_08_030fa1c.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 3631,
      "updatedAt": "2026-08-24T18:56:26Z",
      "textHash": "f92af407781478a7f6eecbd00fe390618e70da55cca90387824adeedcca04453"
    },
    {
      "key": "035e68a",
      "nodeTitle": "node",
      "sourceText": "Basislager 4",
      "sourceEnText": "Base Camp 4",
      "audioFile": "fr_08_035e68a.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1176,
