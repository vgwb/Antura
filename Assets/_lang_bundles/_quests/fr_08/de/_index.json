    {
      "key": "046eb33",
      "nodeTitle": "npc_intro",
      "sourceText": "Komm wieder, wenn du es gefunden hast.",
      "sourceEnText": "Come back when you've found it.",
      "audioFile": "fr_08_046eb33.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2142,
