      "key": "06b3363",
      "nodeTitle": "npc_base2",
      "sourceText": "Du hast keine Handschuhe!",
      "sourceEnText": "You don't have any gloves!",
      "audioFile": "fr_08_06b3363.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 1959,
