    {
      "key": "04c1c1f",
      "nodeTitle": "npc_intro",
      "sourceText": "Du hast deinen Rucksack. Hol jetzt deine warme Kleidung und deine Bergausrüstung.",
      "sourceEnText": "You have your backpack. Now go get your warm clothes and mountain gear.",
      "audioFile": "fr_08_04c1c1f.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 5042,
      "updatedAt": "2026-08-24T18:54:34Z",
      "textHash": "ad7073476bed8b90f7fa558fb088cd67e2241e21ea23b44e83bbec9932081917"
