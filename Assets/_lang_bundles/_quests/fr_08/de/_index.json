      "textHash": "f85747ad79d876c13e454478f53180509b69271f2d9057ead0abecb8c454a9f1"
    },
    {
      "key": "03dd802",
      "nodeTitle": "npc_base1",
      "sourceText": "Du hast keinen Mantel. Geh und such ihn!",
      "sourceEnText": "You don't have a coat. Go find it!",
      "audioFile": "fr_08_03dd802.mp3",
      "voiceProfile": "alice",
      "actorId": "Default",
      "durationMs": 2795,
      "updatedAt": "2026-08-24T18:55:10Z",
