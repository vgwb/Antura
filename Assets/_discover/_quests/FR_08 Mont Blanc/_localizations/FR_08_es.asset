--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_08_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: e1642aa48b6aa44aa987ba377a044cc2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 70723632840564736
    m_Localized: "\xA1Bienvenidos a los Alpes franceses! Los Alpes son altas monta\xF1as
      en el sureste de Francia."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564737
    m_Localized: "Hoy vais a ascender a la cima del Mont Blanc. Es la monta\xF1a
      m\xE1s alta de Francia."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564738
    m_Localized: "\xA1Bien hecho! Has llegado a la cima del Mont Blanc. Mide 4807
      metros. Es la monta\xF1a m\xE1s alta de Francia."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564739
    m_Localized: "En los Alpes hay muchas monta\xF1as grandes y hermosas."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564740
    m_Localized: En tu cuaderno, dibuja el Mont Blanc y las banderas de Francia,
      Suiza e Italia.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564741
    m_Localized: "Ya tienes tu mochila. Ahora ve a buscar tu ropa de abrigo y tu
      equipo de monta\xF1a."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564742
    m_Localized: Subir a la cima del Mont Blanc
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564743
    m_Localized: "Encuentra ropa de abrigo y equipo de monta\xF1a."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564744
    m_Localized: Vuelve cuando lo hayas encontrado.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564745
    m_Localized: "\xA1Ay\xFAdame! Soy tu gu\xEDa de monta\xF1a. Un perro azul se
      llev\xF3 tus cosas."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564746
    m_Localized: "El perro se fue a la monta\xF1a con tus cosas."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564747
    m_Localized: "Encuentra ropa de abrigo y equipo de monta\xF1a."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564748
    m_Localized: Primero, necesitas una mochila.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564749
    m_Localized: "\xA1Abre el cofre para encontrar la mochila!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564750
    m_Localized: "\xA1El cofre se abre! Coge la mochila."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564751
    m_Localized: "El cofre est\xE1 cerrado con llave. Encuentra la llave para abrirlo."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564752
    m_Localized: En la mochila hay agua, comida y un mapa.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564753
    m_Localized: "Ahora ve a las monta\xF1as. Busca ropa de abrigo y equipo de monta\xF1a."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564754
    m_Localized: "\xA1Ahora ya est\xE1s listo! \xA1Puedes subir a la cima del Mont
      Blanc!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564755
    m_Localized: "El mu\xF1eco de nieve puede ayudarte. \xA1Ve a verlo!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564756
    m_Localized: "No tienes abrigo. \xA1Ve a buscarlo!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564757
    m_Localized: "Hace viento. Necesitas protegerte los o\xEDdos."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564758
    m_Localized: "\xBFC\xF3mo proteger tus o\xEDdos?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564759
    m_Localized: "\xA1Abre el cofre para encontrar el sombrero!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564760
    m_Localized: "\xA1El cofre se abre! Contiene algunos equipos."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564762
    m_Localized: "Con un abrigo, te mantendr\xE1s abrigado cuando haga viento o nieve."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564763
    m_Localized: "Con un gorro, no se te enfriar\xE1 la cabeza."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564764
    m_Localized: El sombrero te protege del viento.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564765
    m_Localized: "\xA1Sigue escalando!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564767
    m_Localized: "El mu\xF1eco de nieve puede ayudarte."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564768
    m_Localized: "\xA1No tienes guantes!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564769
    m_Localized: El sol y la nieve te lastiman los ojos. Necesitas gafas de sol.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564770
    m_Localized: "\xBFQu\xE9 protege los ojos?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564771
    m_Localized: Sigue buscando.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564772
    m_Localized: "\xA1Abre el maletero para encontrar las gafas de sol!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564773
    m_Localized: "\xA1El maletero est\xE1 abierto! Saca las gafas de sol."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564775
    m_Localized: Los guantes protegen las manos.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564776
    m_Localized: "Hace fr\xEDo en las monta\xF1as."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564777
    m_Localized: "En las monta\xF1as, el sol y la nieve lastiman los ojos."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564778
    m_Localized: Las gafas de sol protegen los ojos.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564779
    m_Localized: "Ya tienes tu equipo de monta\xF1a. Un \xFAltimo esfuerzo para llegar
      a la cima."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564780
    m_Localized: "\xA1No tienes cuerda!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564781
    m_Localized: Para caminar sobre el hielo de los glaciares, necesitamos equipo
      especial.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564782
    m_Localized: "\xBFQu\xE9 te pones en los zapatos para caminar sobre hielo?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564783
    m_Localized: Crampones
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564784
    m_Localized: 'Exacto ! '
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564785
    m_Localized: hojas de palma
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564786
    m_Localized: "\xA1No! \xA1No est\xE1s en la piscina! Int\xE9ntalo de nuevo."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564787
    m_Localized: "\xA1Abre el cofre para sacar los crampones!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564790
    m_Localized: Los crampones te ayudan a caminar sobre el hielo.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564791
    m_Localized: La cuerda te permite estar seguro sobre hielo y rocas.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564792
    m_Localized: "\xA1Bien hecho! Has llegado a la cima del Mont Blanc."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564793
    m_Localized: La cima del Mont Blanc tiene una altura de 4807 metros.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564794
    m_Localized: "Responde a tres preguntas sobre la monta\xF1a."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564795
    m_Localized: "\xBFEn qu\xE9 cordillera se encuentra el Mont Blanc?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564796
    m_Localized: "El Mont Blanc est\xE1 en los Alpes."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564797
    m_Localized: "As\xED es."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564798
    m_Localized: "El Mont Blanc est\xE1 en los Pirineos."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564799
    m_Localized: "Esa no es la respuesta correcta. Int\xE9ntalo de nuevo."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564800
    m_Localized: "El Mont Blanc se encuentra en los C\xE1rpatos."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564802
    m_Localized: "\xBFCu\xE1l es la altura del Mont Blanc?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564803
    m_Localized: 4807 metros
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564805
    m_Localized: 3705 metros
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564807
    m_Localized: 5016 metros
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564809
    m_Localized: "\xBFQu\xE9 pa\xEDses se pueden ver desde la cima del Mont Blanc?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564810
    m_Localized: Francia, Italia y Suiza
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564811
    m_Localized: "\xA1Bien hecho! Desde la cima del Mont Blanc se pueden ver Francia,
      Italia y Suiza. Ahora, encuentra la bandera de estos tres pa\xEDses."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564812
    m_Localized: "Francia, Espa\xF1a y Alemania"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564813
    m_Localized: "Esa no es la respuesta correcta. \xA1Int\xE9ntalo de nuevo!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564814
    m_Localized: "Francia est\xE1 al oeste del Mont Blanc."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564815
    m_Localized: Italia se encuentra al este del Mont Blanc.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564816
    m_Localized: "Suiza est\xE1 al norte del Mont Blanc."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564817
    m_Localized: "\xBFNecesitas ayuda para conectarte?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564818
    m_Localized: "S\xED, por favor ay\xFAdame."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564819
    m_Localized: Campamento Base 1
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564820
    m_Localized: Campo Base 2
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564821
    m_Localized: Campamento base 3
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564822
    m_Localized: Campamento base 4
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564823
    m_Localized: "No, gracias, me quedo aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564824
    m_Localized: Dicen que duermo todo el invierno, que hiberno.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564825
    m_Localized: "Me encanta comer flores, frutas y hierbas. \xA1Qu\xE9 rico!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564826
    m_Localized: Me gusta relajarme al sol.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564827
    m_Localized: "\xA1Aqu\xED tienes una bufanda calentita! \xA1T\xF3mala!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564829
    m_Localized: "Con una bufanda, no se te enfriar\xE1 el cuello."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564830
    m_Localized: "Me encantan las monta\xF1as. \xBFY a ti?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564831
    m_Localized: "El Mont Blanc es la monta\xF1a m\xE1s alta de Francia."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564832
    m_Localized: "\xA1Mira con atenci\xF3n! Vas a ver una marmota."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564833
    m_Localized: Para subir a la cima del Mont Blanc, lleve ropa de abrigo.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564834
    m_Localized: "\xA1Advertencia! La monta\xF1a es peligrosa."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564835
    m_Localized: "Para ir a la monta\xF1a, lleva buen calzado."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564836
    m_Localized: "Hay nieve en las monta\xF1as."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564837
    m_Localized: "\xA1Mira con atenci\xF3n! Vas a ver una cabra mont\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564838
    m_Localized: "\xBFAlguna vez has hecho un mu\xF1eco de nieve?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564839
    m_Localized: "El Mont Blanc es una monta\xF1a muy hermosa."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564840
    m_Localized: "\xBFQuieres ir a la monta\xF1a?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564841
    m_Localized: "Un gu\xEDa de monta\xF1a puede acompa\xF1arle."
    m_Metadata:
      m_Items: []
  - m_Id: 70826283859173380
    m_Localized: "No s\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 70826283859173381
    m_Localized: "\xA1Vuelve m\xE1s tarde!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
