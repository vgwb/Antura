%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_08_ro
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ro
  m_SharedData: {fileID: 11400000, guid: e1642aa48b6aa44aa987ba377a044cc2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 70723632840564736
    m_Localized: "Bun venit \xEEn Alpii francezi! Alpii sunt mun\u021Bi \xEEnal\u021Bi
      din sud-estul Fran\u021Bei."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564737
    m_Localized: "Ast\u0103zi, mergi pe v\xE2rful Mont Blanc. Este cel mai \xEEnalt
      munte din Fran\u021Ba."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564738
    m_Localized: "Bravo! Ai ajuns pe v\xE2rful Mont Blanc. M\u0103soar\u0103 4807
      metri. Este cel mai \xEEnalt munte din Fran\u021Ba."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564739
    m_Localized: "\xCEn Alpi exist\u0103 mul\u021Bi mun\u021Bi mari \u0219i frumo\u0219i."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564740
    m_Localized: "\xCEn caietul t\u0103u, deseneaz\u0103 Mont Blanc \u0219i steagurile
      Fran\u021Bei, Elve\u021Biei \u0219i Italiei."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564741
    m_Localized: "Ai rucsacul. Acum du-te \u0219i ia-\u021Bi hainele groase \u0219i
      echipamentul de munte."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564742
    m_Localized: "Urc\u0103 pe v\xE2rful Mont Blanc"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564743
    m_Localized: "G\u0103se\u0219te haine groase \u0219i echipament de munte."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564744
    m_Localized: "\xCEntoarce-te c\xE2nd l-ai g\u0103sit."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564745
    m_Localized: "Ajuta\u021Bi-m\u0103! Sunt ghidul vostru montan. Un c\xE2ine albastru
      \u021Bi-a luat lucrurile."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564746
    m_Localized: "C\xE2inele s-a dus \xEEn munte cu lucrurile tale."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564747
    m_Localized: "G\u0103se\u0219te haine groase \u0219i echipament de munte."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564748
    m_Localized: "\xCEn primul r\xE2nd, ai nevoie de un rucsac."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564749
    m_Localized: "Deschide cuf\u0103rul ca s\u0103 g\u0103se\u0219ti rucsacul!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564750
    m_Localized: "Se deschide cuf\u0103rul! Ia rucsacul."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564751
    m_Localized: "Cuf\u0103rul este \xEEncuiat. G\u0103se\u0219te cheia pentru a-l
      deschide."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564752
    m_Localized: "\xCEn rucsac se afl\u0103 ap\u0103, m\xE2ncare \u0219i o hart\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564753
    m_Localized: "Acum du-te la munte. G\u0103se\u0219te haine groase \u0219i echipament
      de munte."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564754
    m_Localized: "Acum e\u0219ti gata. Po\u021Bi merge pe v\xE2rful Mont Blanc!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564755
    m_Localized: "Omul de z\u0103pad\u0103 te poate ajuta. Du-te s\u0103-l vezi!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564756
    m_Localized: "Nu ai o hain\u0103. Du-te \u0219i g\u0103se\u0219te-o!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564757
    m_Localized: "Bate v\xE2ntul. Trebuie s\u0103-\u021Bi protejezi urechile."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564758
    m_Localized: "Cum s\u0103 v\u0103 proteja\u021Bi urechile?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564759
    m_Localized: "Deschide cuf\u0103rul ca s\u0103 g\u0103se\u0219ti p\u0103l\u0103ria!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564760
    m_Localized: "Cuf\u0103rul se deschide! Con\u021Bine ni\u0219te echipament."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564762
    m_Localized: "Cu o hain\u0103, \xEE\u021Bi este cald c\xE2nd bate v\xE2ntul sau
      ninge."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564763
    m_Localized: "Cu o p\u0103l\u0103rie, nu \u021Bi se va r\u0103ci capul."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564764
    m_Localized: "P\u0103l\u0103ria te protejeaz\u0103 de v\xE2nt."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564765
    m_Localized: "Continu\u0103 s\u0103 urci!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564767
    m_Localized: "Omul de z\u0103pad\u0103 te poate ajuta."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564768
    m_Localized: "Nu ai m\u0103nu\u0219i!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564769
    m_Localized: "Soarele \u0219i z\u0103pada \xEE\u021Bi r\u0103nesc ochii. Ai nevoie
      de ochelari de soare."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564770
    m_Localized: "Ce protejeaz\u0103 ochii?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564771
    m_Localized: "Continu\u0103 s\u0103 cau\u021Bi."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564772
    m_Localized: "Deschide portbagajul ca s\u0103 g\u0103se\u0219ti ochelarii de
      soare!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564773
    m_Localized: Portbagajul e deschis! Scoate ochelarii de soare.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564775
    m_Localized: "M\u0103nu\u0219ile protejeaz\u0103 m\xE2inile."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564776
    m_Localized: E frig la munte
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564777
    m_Localized: "La munte, soarele \u0219i z\u0103pada r\u0103nesc ochii"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564778
    m_Localized: "Ochelarii de soare protejeaz\u0103 ochii."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564779
    m_Localized: "\u021Ai-ai echipamentul de munte. \xCEnc\u0103 un ultim efort pentru
      a ajunge pe v\xE2rf."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564780
    m_Localized: "N-ai fr\xE2nghie!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564781
    m_Localized: "Ca s\u0103 mergem pe ghea\u021Ba glaciar\u0103, avem nevoie de
      echipament special."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564782
    m_Localized: "Ce \xEE\u021Bi pui \xEEn pantofi ca s\u0103 mergi pe ghea\u021B\u0103?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564783
    m_Localized: Crampoane
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564784
    m_Localized: Exact!
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564785
    m_Localized: frunze de palmier
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564786
    m_Localized: "Nu! Nu e\u0219ti la piscin\u0103! \xCEncearc\u0103 din nou."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564787
    m_Localized: "Deschide cuf\u0103rul ca s\u0103 iei col\u021Bari!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564790
    m_Localized: "Crampoanele te ajut\u0103 s\u0103 mergi pe ghea\u021B\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564791
    m_Localized: "Coarda v\u0103 permite s\u0103 fi\u021Bi \xEEn siguran\u021B\u0103
      pe ghea\u021B\u0103 \u0219i pietre."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564792
    m_Localized: "Bravo! Ai ajuns pe v\xE2rful Mont Blanc."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564793
    m_Localized: "V\xE2rful Mont Blanc are o \xEEn\u0103l\u021Bime de 4807 metri."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564794
    m_Localized: "R\u0103spunde\u021Bi la trei \xEEntreb\u0103ri despre munte."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564795
    m_Localized: "\xCEn ce lan\u021B muntos se afl\u0103 Mont Blanc?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564796
    m_Localized: "Mont Blanc se afl\u0103 \xEEn Alpi"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564797
    m_Localized: Asta e corect.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564798
    m_Localized: "Mont Blanc se afl\u0103 \xEEn Pirinei"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564799
    m_Localized: "Acesta nu este r\u0103spunsul corect. \xCEncearc\u0103 din nou."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564800
    m_Localized: "Mont Blanc se afl\u0103 \xEEn Carpa\u021Bi"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564802
    m_Localized: "Care este \xEEn\u0103l\u021Bimea Mont Blanc-ului?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564803
    m_Localized: 4807 metri
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564805
    m_Localized: 3705 metri
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564807
    m_Localized: 5016 metri
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564809
    m_Localized: "Ce \u021B\u0103ri pot fi v\u0103zute de pe v\xE2rful Mont Blanc?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564810
    m_Localized: "Fran\u021Ba, Italia \u0219i Elve\u021Bia"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564811
    m_Localized: "Bravo! De pe v\xE2rful Mont Blanc, po\u021Bi vedea Fran\u021Ba,
      Italia \u0219i Elve\u021Bia. Acum, g\u0103se\u0219te steagul acestor trei \u021B\u0103ri."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564812
    m_Localized: "Fran\u021Ba, Spania \u0219i Germania"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564813
    m_Localized: "Acesta nu este r\u0103spunsul corect. \xCEncearc\u0103 din nou!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564814
    m_Localized: "Fran\u021Ba se afl\u0103 la vest de Mont Blanc."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564815
    m_Localized: "Italia se afl\u0103 la est de Mont Blanc."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564816
    m_Localized: "Elve\u021Bia se afl\u0103 la nord de Mont Blanc."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564817
    m_Localized: "Ai nevoie de ajutor s\u0103 te \xEEndrep\u021Bi?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564818
    m_Localized: "Da, te rog ajut\u0103-m\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564819
    m_Localized: "Tab\u0103ra de baz\u0103 1"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564820
    m_Localized: "Tab\u0103ra de baz\u0103 2"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564821
    m_Localized: "Tab\u0103ra de baz\u0103 3"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564822
    m_Localized: "Tab\u0103ra de baz\u0103 4"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564823
    m_Localized: "Nu, mul\u021Bumesc, voi r\u0103m\xE2ne aici."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564824
    m_Localized: "Dorm toat\u0103 iarna, se spune c\u0103 hibernez."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564825
    m_Localized: "\xCEmi place s\u0103 m\u0103n\xE2nc flori, fructe \u0219i ierburi
      aromatice. Poft\u0103 bun\u0103!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564826
    m_Localized: "\xCEmi place s\u0103 m\u0103 relaxez la soare."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564827
    m_Localized: "Uite o e\u0219arf\u0103 frumoas\u0103 \u0219i c\u0103lduroas\u0103!
      Ia-o!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564829
    m_Localized: "Cu o e\u0219arf\u0103, g\xE2tul nu-\u021Bi va fi rece."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564830
    m_Localized: "Iubesc mun\u021Bii. \u0218i tu?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564831
    m_Localized: "Mont Blanc este cel mai \xEEnalt munte din Fran\u021Ba."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564832
    m_Localized: "Uit\u0103-te cu aten\u021Bie! O s\u0103 vezi o marmot\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564833
    m_Localized: "Pentru a urca pe v\xE2rful Mont Blanc, lua\u021Bi haine groase."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564834
    m_Localized: "Aten\u021Bie! Muntele este periculos."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564835
    m_Localized: "Ca s\u0103 mergi la munte, ia-\u021Bi \xEEnc\u0103l\u021B\u0103minte
      bun\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564836
    m_Localized: "Este z\u0103pad\u0103 \xEEn mun\u021Bi."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564837
    m_Localized: "Uit\u0103-te cu aten\u021Bie! O s\u0103 vezi un ibex."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564838
    m_Localized: "Ai f\u0103cut vreodat\u0103 un om de z\u0103pad\u0103?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564839
    m_Localized: Mont Blanc este un munte foarte frumos.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564840
    m_Localized: "Vrei s\u0103 mergi la munte?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564841
    m_Localized: Un ghid montan poate veni cu tine.
    m_Metadata:
      m_Items: []
  - m_Id: 70826283859173380
    m_Localized: "Nu \u0219tiu"
    m_Metadata:
      m_Items: []
  - m_Id: 70826283859173381
    m_Localized: "Revino mai t\xE2rziu!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
