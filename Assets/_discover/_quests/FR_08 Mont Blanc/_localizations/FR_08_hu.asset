%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_08_hu
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: hu
  m_SharedData: {fileID: 11400000, guid: e1642aa48b6aa44aa987ba377a044cc2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 70723632840564736
    m_Localized: "\xDCdv\xF6z\xF6lj\xFCk a Francia Alpokban! Az Alpok magas hegyek
      Franciaorsz\xE1g d\xE9lkeleti r\xE9sz\xE9n."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564737
    m_Localized: "Ma a Mont Blanc cs\xFAcs\xE1ra m\xE9sz. Ez Franciaorsz\xE1g legmagasabb
      hegye."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564738
    m_Localized: "Sz\xE9p munka! El\xE9rted a Mont Blanc cs\xFAcs\xE1t. 4807 m\xE9ter
      magas. Ez Franciaorsz\xE1g legmagasabb hegye."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564739
    m_Localized: "Az Alpokban sz\xE1mos nagy \xE9s gy\xF6ny\xF6r\u0171 hegy tal\xE1lhat\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564740
    m_Localized: "Rajzold le a f\xFCzetedbe a Mont Blanc-t, valamint Franciaorsz\xE1g,
      Sv\xE1jc \xE9s Olaszorsz\xE1g z\xE1szlaj\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564741
    m_Localized: "N\xE1lad van a h\xE1tizs\xE1kod. Most menj, hozd a meleg ruh\xE1idat
      \xE9s a hegyi felszerel\xE9sedet."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564742
    m_Localized: "M\xE1ssz fel a Mont Blanc tetej\xE9re"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564743
    m_Localized: "Szerezz be meleg ruh\xE1kat \xE9s hegyi felszerel\xE9st."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564744
    m_Localized: "Gyere vissza, ha megtal\xE1ltad."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564745
    m_Localized: "Seg\xEDts\xE9g! \xC9n vagyok a hegyi vezet\u0151d. Egy k\xE9k kutya
      vitte el a holmidat."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564746
    m_Localized: A kutya felment a hegyekbe a holmijaiddal.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564747
    m_Localized: "Szerezz be meleg ruh\xE1t \xE9s hegyi felszerel\xE9st."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564748
    m_Localized: "El\u0151sz\xF6r is, sz\xFCks\xE9ged van egy h\xE1tizs\xE1kra."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564749
    m_Localized: "Nyisd ki a l\xE1d\xE1t, hogy megtal\xE1ld a h\xE1tizs\xE1kot!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564750
    m_Localized: "Ny\xEDlik a l\xE1da! Vedd a h\xE1tizs\xE1kot!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564751
    m_Localized: "A l\xE1da z\xE1rva van. Keresd meg a kulcsot a nyit\xE1s\xE1hoz."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564752
    m_Localized: "A h\xE1tizs\xE1kban v\xEDz, \xE9lelem \xE9s egy t\xE9rk\xE9p van."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564753
    m_Localized: "Most menj a hegyekbe. Keress meleg ruh\xE1t \xE9s hegyi felszerel\xE9st."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564754
    m_Localized: "Most m\xE1r k\xE9szen \xE1llsz. Felmehetsz a Mont Blanc cs\xFAcs\xE1ra!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564755
    m_Localized: "A h\xF3ember seg\xEDthet neked. L\xE1togasd meg!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564756
    m_Localized: "Nincs kab\xE1tod. Menj \xE9s keresd meg!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564757
    m_Localized: "Szeles van. V\xE9dened kell a f\xFCledet."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564758
    m_Localized: "Hogyan v\xE9dd a f\xFCleidet?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564759
    m_Localized: "Nyisd ki a l\xE1d\xE1t, hogy megtal\xE1ld a kalapot!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564760
    m_Localized: "A l\xE1da kiny\xEDlik! Van benne n\xE9mi felszerel\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564762
    m_Localized: "Kab\xE1tban melegen maradsz, ha szeles vagy havas az id\u0151."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564763
    m_Localized: "Kalappal nem fog f\xE1zni a fejed."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564764
    m_Localized: "A sapka megv\xE9d a sz\xE9lt\u0151l."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564765
    m_Localized: "M\xE1ssz tov\xE1bb!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564767
    m_Localized: "A h\xF3ember seg\xEDthet neked."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564768
    m_Localized: "Nincs is keszty\u0171d!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564769
    m_Localized: "A nap \xE9s a h\xF3 b\xE1ntja a szemed. Sz\xFCks\xE9ged van napszem\xFCvegre."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564770
    m_Localized: "Mi v\xE9di a szemet?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564771
    m_Localized: "Tov\xE1bb keresg\xE9lj."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564772
    m_Localized: "Nyisd ki a csomagtart\xF3t, hogy megtal\xE1ld a napszem\xFCveget!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564773
    m_Localized: "Nyitva van a csomagtart\xF3! Vedd ki a napszem\xFCveget!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564775
    m_Localized: "A keszty\u0171k v\xE9dik a kezeket."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564776
    m_Localized: Hideg van a hegyekben
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564777
    m_Localized: "A hegyekben a nap \xE9s a h\xF3 b\xE1ntja a szemet"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564778
    m_Localized: "A napszem\xFCveg v\xE9di a szemet."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564779
    m_Localized: "Megvan a hegyi felszerel\xE9sed. M\xE1r csak egy utols\xF3 er\u0151fesz\xEDt\xE9s
      a cs\xFAcs el\xE9r\xE9s\xE9hez."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564780
    m_Localized: "Nincs n\xE1lad k\xF6teled!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564781
    m_Localized: "A gleccserek j\xE9g\xE9n val\xF3 j\xE1r\xE1shoz speci\xE1lis felszerel\xE9sre
      van sz\xFCks\xE9g\xFCnk."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564782
    m_Localized: "Mit kell felvenni a cip\u0151re, ha j\xE9gen kell j\xE1rni?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564783
    m_Localized: "H\xE1g\xF3vasak"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564784
    m_Localized: Pontosan!
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564785
    m_Localized: "p\xE1lmalevelek"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564786
    m_Localized: "Nem! Nem az uszod\xE1ban vagy! Pr\xF3b\xE1ld \xFAjra."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564787
    m_Localized: "Nyisd ki a mellkast, hogy h\xE1g\xF3vasakat kapj!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564790
    m_Localized: "A h\xE1g\xF3vas seg\xEDt a j\xE9gen j\xE1rni."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564791
    m_Localized: "A k\xF6t\xE9l biztons\xE1got ny\xFAjt j\xE9gen \xE9s szikl\xE1kon."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564792
    m_Localized: "Sz\xE9p munka! El\xE9rted a Mont Blanc cs\xFAcs\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564793
    m_Localized: "A Mont Blanc cs\xFAcsa 4807 m\xE9ter magas."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564794
    m_Localized: "V\xE1laszolj h\xE1rom k\xE9rd\xE9sre a heggyel kapcsolatban."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564795
    m_Localized: "Melyik hegys\xE9gben tal\xE1lhat\xF3 a Mont Blanc?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564796
    m_Localized: "A Mont Blanc az Alpokban tal\xE1lhat\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564797
    m_Localized: "\xCDgy van."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564798
    m_Localized: "A Mont Blanc a Pireneusokban tal\xE1lhat\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564799
    m_Localized: "Ez nem a helyes v\xE1lasz. Pr\xF3b\xE1ld \xFAjra."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564800
    m_Localized: "A Mont Blanc a K\xE1rp\xE1tokban tal\xE1lhat\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564802
    m_Localized: "Mekkora a Mont Blanc magass\xE1ga?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564803
    m_Localized: "4807 m\xE9ter"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564805
    m_Localized: "3705 m\xE9ter"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564807
    m_Localized: "5016 m\xE9ter"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564809
    m_Localized: "Milyen orsz\xE1gokat lehet l\xE1tni a Mont Blanc cs\xFAcs\xE1r\xF3l?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564810
    m_Localized: "Franciaorsz\xE1g, Olaszorsz\xE1g \xE9s Sv\xE1jc"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564811
    m_Localized: "Sz\xE9p munka! A Mont Blanc cs\xFAcs\xE1r\xF3l l\xE1that\xF3 Franciaorsz\xE1g,
      Olaszorsz\xE1g \xE9s Sv\xE1jc. Most keresd meg e h\xE1rom orsz\xE1g z\xE1szlaj\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564812
    m_Localized: "Franciaorsz\xE1g, Spanyolorsz\xE1g \xE9s N\xE9metorsz\xE1g"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564813
    m_Localized: "Ez nem a helyes v\xE1lasz. Pr\xF3b\xE1ld \xFAjra!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564814
    m_Localized: "Franciaorsz\xE1g a Mont Blanc-t\xF3l nyugatra tal\xE1lhat\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564815
    m_Localized: "Olaszorsz\xE1g a Mont Blanc-t\xF3l keletre tal\xE1lhat\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564816
    m_Localized: "Sv\xE1jc a Mont Blanc-t\xF3l \xE9szakra tal\xE1lhat\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564817
    m_Localized: "Seg\xEDts\xE9gre van sz\xFCks\xE9ged a tov\xE1bbl\xE9p\xE9shez?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564818
    m_Localized: "Igen, k\xE9rlek seg\xEDts nekem."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564819
    m_Localized: "1. alapt\xE1bor"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564820
    m_Localized: "2. alapt\xE1bor"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564821
    m_Localized: "3. alapt\xE1bor"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564822
    m_Localized: "4. alapt\xE1bor"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564823
    m_Localized: "Nem k\xF6sz\xF6n\xF6m, itt maradok."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564824
    m_Localized: "Eg\xE9sz t\xE9len alszom, azt mondj\xE1k, t\xE9li \xE1lmot alszom."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564825
    m_Localized: "Im\xE1dok vir\xE1gokat, gy\xFCm\xF6lcs\xF6ket \xE9s f\u0171szern\xF6v\xE9nyeket
      enni. Nyami!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564826
    m_Localized: Szeretek a napon pihenni.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564827
    m_Localized: "Itt egy sz\xE9p meleg s\xE1l! Vedd csak!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564829
    m_Localized: "Egy s\xE1llal nem fog f\xE1zni a nyakad."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564830
    m_Localized: "Im\xE1dom a hegyeket. \xC9s te?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564831
    m_Localized: "A Mont Blanc Franciaorsz\xE1g legmagasabb hegye."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564832
    m_Localized: "N\xE9zd meg j\xF3l! Mormot\xE1t fogsz l\xE1tni."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564833
    m_Localized: "A Mont Blanc cs\xFAcs\xE1ra val\xF3 feljut\xE1shoz vigy\xE9l magaddal
      meleg ruh\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564834
    m_Localized: "Figyelem! A hegy vesz\xE9lyes."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564835
    m_Localized: "A hegyekbe men\xE9shez vigy\xE9l magaddal j\xF3 cip\u0151t."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564836
    m_Localized: "H\xF3 van a hegyekben."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564837
    m_Localized: "N\xE9zd meg j\xF3l! Egy k\u0151sz\xE1li kecsk\xE9t fogsz l\xE1tni."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564838
    m_Localized: "K\xE9sz\xEDtett\xE9l m\xE1r h\xF3embert?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564839
    m_Localized: "A Mont Blanc egy nagyon sz\xE9p hegy."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564840
    m_Localized: "Szeretn\xE9l felmenni a hegyekbe?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564841
    m_Localized: "Egy hegyi vezet\u0151 elk\xEDs\xE9rhet."
    m_Metadata:
      m_Items: []
  - m_Id: 70826283859173380
    m_Localized: Nem tudom
    m_Metadata:
      m_Items: []
  - m_Id: 70826283859173381
    m_Localized: "Gyere vissza k\xE9s\u0151bb!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
