%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_08_pl
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: e1642aa48b6aa44aa987ba377a044cc2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 70723632840564736
    m_Localized: "Witamy we francuskich Alpach! Alpy to wysokie g\xF3ry w po\u0142udniowo-wschodniej
      Francji."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564737
    m_Localized: "Dzisiaj wybierasz si\u0119 na szczyt Mont Blanc. To najwy\u017Csza
      g\xF3ra we Francji."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564738
    m_Localized: "Gratulacje! Zdoby\u0142e\u015B szczyt Mont Blanc. Mierzy on 4807
      metr\xF3w. To najwy\u017Csza g\xF3ra we Francji."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564739
    m_Localized: "W Alpach jest wiele du\u017Cych i pi\u0119knych g\xF3r."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564740
    m_Localized: "W zeszycie narysuj Mont Blanc oraz flagi Francji, Szwajcarii i
      W\u0142och."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564741
    m_Localized: "Masz plecak. Teraz id\u017A po ciep\u0142e ubrania i sprz\u0119t
      g\xF3rski."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564742
    m_Localized: "Wejd\u017A na szczyt Mont Blanc"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564743
    m_Localized: "Znajd\u017A ciep\u0142e ubrania i sprz\u0119t g\xF3rski."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564744
    m_Localized: "Wr\xF3\u0107, gdy znajdziesz."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564745
    m_Localized: "Ratunku! Jestem twoim przewodnikiem g\xF3rskim. Niebieski pies
      zabra\u0142 twoje rzeczy."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564746
    m_Localized: "Pies poszed\u0142 w g\xF3ry z twoimi rzeczami."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564747
    m_Localized: "Znajd\u017A ciep\u0142\u0105 odzie\u017C i sprz\u0119t g\xF3rski."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564748
    m_Localized: Po pierwsze, potrzebujesz plecaka.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564749
    m_Localized: "Otw\xF3rz skrzyni\u0119, aby znale\u017A\u0107 plecak!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564750
    m_Localized: "Skrzynia si\u0119 otwiera! We\u017A plecak."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564751
    m_Localized: "Skrzynia jest zamkni\u0119ta. Znajd\u017A klucz, \u017Ceby j\u0105
      otworzy\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564752
    m_Localized: "W plecaku znajduje si\u0119 woda, jedzenie i mapa."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564753
    m_Localized: "Teraz id\u017A w g\xF3ry. Znajd\u017A ciep\u0142e ubrania i sprz\u0119t
      g\xF3rski."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564754
    m_Localized: "Jeste\u015B gotowy. Mo\u017Cesz wej\u015B\u0107 na szczyt Mont
      Blanc!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564755
    m_Localized: "Ba\u0142wan mo\u017Ce ci pom\xF3c. Id\u017A do niego!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564756
    m_Localized: "Nie masz p\u0142aszcza. Id\u017A go poszuka\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564757
    m_Localized: "Wieje. Musisz chroni\u0107 uszy."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564758
    m_Localized: "Jak chroni\u0107 uszy?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564759
    m_Localized: "Otw\xF3rz skrzyni\u0119, aby znale\u017A\u0107 kapelusz!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564760
    m_Localized: "Skrzynia si\u0119 otwiera! Zawiera troch\u0119 sprz\u0119tu."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564762
    m_Localized: "W p\u0142aszczu b\u0119dzie Ci ciep\u0142o, gdy b\u0119dzie wietrznie
      i \u015Bnie\u017Cnie."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564763
    m_Localized: "W czapce g\u0142owa ci nie zmarznie."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564764
    m_Localized: Kapelusz chroni przed wiatrem.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564765
    m_Localized: "Wspinaj si\u0119 dalej!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564767
    m_Localized: "Ba\u0142wan mo\u017Ce ci pom\xF3c."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564768
    m_Localized: "Nie masz r\u0119kawiczek!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564769
    m_Localized: "S\u0142o\u0144ce i \u015Bnieg bol\u0105 oczy. Potrzebujesz okular\xF3w
      przeciws\u0142onecznych."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564770
    m_Localized: Co chroni oczy?
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564771
    m_Localized: Szukaj dalej.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564772
    m_Localized: "Otw\xF3rz baga\u017Cnik i znajd\u017A okulary przeciws\u0142oneczne!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564773
    m_Localized: "Baga\u017Cnik otwarty! Wyjmij okulary przeciws\u0142oneczne."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564775
    m_Localized: "R\u0119kawice chroni\u0105 d\u0142onie."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564776
    m_Localized: "W g\xF3rach jest zimno"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564777
    m_Localized: "W g\xF3rach s\u0142o\u0144ce i \u015Bnieg razi\u0142y w oczy"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564778
    m_Localized: "Okulary przeciws\u0142oneczne chroni\u0105 oczy."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564779
    m_Localized: "Masz sw\xF3j sprz\u0119t g\xF3rski. Ostatnia pr\xF3ba zdobycia
      szczytu."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564780
    m_Localized: Nie masz liny!
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564781
    m_Localized: "Aby chodzi\u0107 po lodowcu, potrzebujemy specjalnego sprz\u0119tu."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564782
    m_Localized: "Co zak\u0142adasz do but\xF3w, \u017Ceby chodzi\u0107 po lodzie?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564783
    m_Localized: Raki
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564784
    m_Localized: "Dok\u0142adny ! "
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564785
    m_Localized: "li\u015Bcie palmowe"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564786
    m_Localized: "Nie! Nie jeste\u015B na basenie! Spr\xF3buj ponownie."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564787
    m_Localized: "Otw\xF3rz skrzyni\u0119, aby wyj\u0105\u0107 raki!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564790
    m_Localized: "Raki pomagaj\u0105 chodzi\u0107 po lodzie."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564791
    m_Localized: "Lina zapewnia bezpiecze\u0144stwo na lodzie i ska\u0142ach."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564792
    m_Localized: "Gratulacje! Dotar\u0142e\u015B na szczyt Mont Blanc."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564793
    m_Localized: "Szczyt Mont Blanc ma 4807 metr\xF3w wysoko\u015Bci."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564794
    m_Localized: "Odpowiedz na trzy pytania dotycz\u0105ce g\xF3ry."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564795
    m_Localized: "W jakim pa\u015Bmie g\xF3rskim znajduje si\u0119 Mont Blanc?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564796
    m_Localized: "Mont Blanc znajduje si\u0119 w Alpach"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564797
    m_Localized: To prawda.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564798
    m_Localized: "Mont Blanc znajduje si\u0119 w Pirenejach"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564799
    m_Localized: "To nie jest prawid\u0142owa odpowied\u017A. Spr\xF3buj ponownie."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564800
    m_Localized: "Mont Blanc znajduje si\u0119 w Karpatach"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564802
    m_Localized: "Jaka jest wysoko\u015B\u0107 Mont Blanc?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564803
    m_Localized: "4807 metr\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564805
    m_Localized: "3705 metr\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564807
    m_Localized: "5016 metr\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564809
    m_Localized: "Jakie kraje mo\u017Cna zobaczy\u0107 ze szczytu Mont Blanc?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564810
    m_Localized: "Francja, W\u0142ochy i Szwajcaria"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564811
    m_Localized: "Brawo! Ze szczytu Mont Blanc wida\u0107 Francj\u0119, W\u0142ochy
      i Szwajcari\u0119. Teraz znajd\u017A flagi tych trzech kraj\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564812
    m_Localized: Francja, Hiszpania i Niemcy
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564813
    m_Localized: "To nie jest prawid\u0142owa odpowied\u017A. Spr\xF3buj ponownie!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564814
    m_Localized: "Francja le\u017Cy na zach\xF3d od Mont Blanc."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564815
    m_Localized: "W\u0142ochy le\u017C\u0105 na wsch\xF3d od Mont Blanc."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564816
    m_Localized: "Szwajcaria le\u017Cy na p\xF3\u0142noc od Mont Blanc."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564817
    m_Localized: Potrzebujesz pomocy przy wsiadaniu?
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564818
    m_Localized: "Tak, prosz\u0119 pom\xF3\u017C mi."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564819
    m_Localized: "Ob\xF3z bazowy 1"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564820
    m_Localized: "Ob\xF3z bazowy 2"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564821
    m_Localized: "Ob\xF3z bazowy 3"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564822
    m_Localized: "Ob\xF3z bazowy 4"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564823
    m_Localized: "Nie, dzi\u0119kuj\u0119. Zostan\u0119 tutaj."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564824
    m_Localized: "Przesypiam ca\u0142\u0105 zim\u0119, m\xF3wi\u0105, \u017Ce zapadam
      w sen zimowy."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564825
    m_Localized: "Uwielbiam je\u015B\u0107 kwiaty, owoce i zio\u0142a. Pycha!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564826
    m_Localized: "Lubi\u0119 relaksowa\u0107 si\u0119 na s\u0142o\u0144cu."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564827
    m_Localized: "Oto mi\u0142y, ciep\u0142y szalik! We\u017A go!"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564829
    m_Localized: Z szalikiem szyja ci nie zmarznie.
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564830
    m_Localized: "Uwielbiam g\xF3ry. A ty?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564831
    m_Localized: "Mont Blanc jest najwy\u017Csz\u0105 g\xF3r\u0105 we Francji."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564832
    m_Localized: "Przyjrzyj si\u0119 uwa\u017Cnie! Zobaczysz \u015Bwistaka."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564833
    m_Localized: "Aby wej\u015B\u0107 na szczyt Mont Blanc nale\u017Cy zabra\u0107
      ciep\u0142e ubrania."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564834
    m_Localized: "Uwaga! G\xF3ra jest niebezpieczna."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564835
    m_Localized: "Wybieraj\u0105c si\u0119 w g\xF3ry nale\u017Cy zabra\u0107 dobre
      buty."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564836
    m_Localized: "W g\xF3rach jest \u015Bnieg."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564837
    m_Localized: "Przyjrzyj si\u0119 uwa\u017Cnie! Zobaczysz kozioro\u017Cca."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564838
    m_Localized: "Czy kiedykolwiek lepi\u0142e\u015B ba\u0142wana?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564839
    m_Localized: "Mont Blanc to bardzo pi\u0119kna g\xF3ra."
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564840
    m_Localized: "Chcesz pojecha\u0107 w g\xF3ry?"
    m_Metadata:
      m_Items: []
  - m_Id: 70723632840564841
    m_Localized: "Mo\u017Cesz wybra\u0107 si\u0119 z przewodnikiem g\xF3rskim."
    m_Metadata:
      m_Items: []
  - m_Id: 70826283859173380
    m_Localized: Nie wiem
    m_Metadata:
      m_Items: []
  - m_Id: 70826283859173381
    m_Localized: "Wr\xF3\u0107 p\xF3\u017Aniej!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
