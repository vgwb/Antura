--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_03_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 91f7e04a176bf428ea7f4aab88304585, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2398309875441664
    m_Localized: "Bienvenidos a Nantes. \xA1Vayan a descubrir el Museo de Julio Verne!"
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441665
    m_Localized: "\xA1Ahora ya sabes qui\xE9n es Julio Verne y sus LIBROS!"
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441672
    m_Localized: Este es Julio Verne. Era un ESCRITOR.
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441673
    m_Localized: "Julio Verne naci\xF3 aqu\xED, en Nantes."
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441674
    m_Localized: Este es un MAPA de NANTES.
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441677
    m_Localized: "Este libro se titula \"La vuelta al mundo en 80 d\xEDas\"."
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441683
    m_Localized: Un cohete se impulsa con fuerza para abandonar la Tierra.
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441685
    m_Localized: Este libro es "Veinte mil leguas de viaje submarino".
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441687
    m_Localized: Un submarino viaja bajo el agua.
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441691
    m_Localized: Un globo se eleva con aire caliente.
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441692
    m_Localized: Se mueve con el VIENTO.
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441693
    m_Localized: "\xA1Me encanta leer LIBROS!"
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441694
    m_Localized: "Julio Verne invent\xF3 las historias de ciencia ficci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441695
    m_Localized: "\xA1Julio Verne escribi\xF3 muchos LIBROS!"
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441696
    m_Localized: "\xA1Sus libros se leen en muchos idiomas!"
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441697
    m_Localized: Me gusta la historia sobre el MUNDO.
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441699
    m_Localized: "Alg\xFAn d\xEDa quiero dar un paseo en globo aerost\xE1tico."
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441700
    m_Localized: "El cohete a la Luna parece r\xE1pido."
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441701
    m_Localized: Muestra muchos lugares de la Tierra.
    m_Metadata:
      m_Items: []
  - m_Id: 2398309875441708
    m_Localized: Muchas de las ideas de sus libros se hicieron realidad.
    m_Metadata:
      m_Items: []
  - m_Id: 2398349255761920
    m_Localized: "El submarino Nautilus es incre\xEDble."
    m_Metadata:
      m_Items: []
  - m_Id: 28754274107252736
    m_Localized: "\xBFQui\xE9n fue Julio Verne? \xBFY ad\xF3nde viaj\xF3?"
    m_Metadata:
      m_Items: []
  - m_Id: 28754274107252737
    m_Localized: "\xBFSabes qui\xE9n es Julio Verne?"
    m_Metadata:
      m_Items: []
  - m_Id: 28754274107252738
    m_Localized: "\xA1S\xED, es escritor!"
    m_Metadata:
      m_Items: []
  - m_Id: 28754274107252739
    m_Localized: "No, \xBFqui\xE9n es \xE9l?"
    m_Metadata:
      m_Items: []
  - m_Id: 28754274107252740
    m_Localized: "Julio Verne fue un escritor franc\xE9s. Naci\xF3 cerca de aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 28754274107252741
    m_Localized: "Escribi\xF3 libros de aventuras muy famosos."
    m_Metadata:
      m_Items: []
  - m_Id: 28754274107252743
    m_Localized: "\xA1Tenemos un PROBLEMA!"
    m_Metadata:
      m_Items: []
  - m_Id: 28754274107252744
    m_Localized: "\xA1Un gracioso PERRO azul entr\xF3 al MUSEO y arm\xF3 un desastre!"
    m_Metadata:
      m_Items: []
  - m_Id: 29108564554407936
    m_Localized: "Como actividad en clase, \xA1puedes DIBUJAR un SUBMARINO o un COHETE!"
    m_Metadata:
      m_Items: []
  - m_Id: 29449511649665024
    m_Localized: "\xA1Qu\xE9 DESASTRE hay fuera del MUSEO!"
    m_Metadata:
      m_Items: []
  - m_Id: 29451373941612544
    m_Localized: "Si vas a Nantes con tus padres, \xA1no dejes de visitar el Museo
      de Julio Verne!"
    m_Metadata:
      m_Items: []
  - m_Id: 29451373941612545
    m_Localized: "\xA1Gracias por limpiar!"
    m_Metadata:
      m_Items: []
  - m_Id: 29451373941612546
    m_Localized: "\xA1El museo ya est\xE1 abierto! \xA1Habla con el gu\xEDa del museo!"
    m_Metadata:
      m_Items: []
  - m_Id: 29451373941612547
    m_Localized: "\xA1Ese perro azul estaba corriendo y lo ensuci\xF3 todo!"
    m_Metadata:
      m_Items: []
  - m_Id: 29451373941612548
    m_Localized: No puedo inaugurar el MUSEO con este desorden.
    m_Metadata:
      m_Items: []
  - m_Id: 29451373941612549
    m_Localized: "\xA1Ay\xFAdame a limpiar la acera!"
    m_Metadata:
      m_Items: []
  - m_Id: 29451373941612550
    m_Localized: "\xA1Bien hecho! Vuelve y habla con el se\xF1or de la entrada del
      museo."
    m_Metadata:
      m_Items: []
  - m_Id: 29451373941612551
    m_Localized: "\xA1Gracias! Ahora el MUSEO est\xE1 en orden."
    m_Metadata:
      m_Items: []
  - m_Id: 29490495578169344
    m_Localized: "\xA1La misi\xF3n ha finalizado! \xA1Enhorabuena!"
    m_Metadata:
      m_Items: []
  - m_Id: 29490495578169345
    m_Localized: "\xBFPuedes ayudar a limpiar el MUSEO?"
    m_Metadata:
      m_Items: []
  - m_Id: 29490495578169346
    m_Localized: "\xA1Julio Verne estar\xEDa orgulloso de ti!"
    m_Metadata:
      m_Items: []
  - m_Id: 29490495578169347
    m_Localized: "\xA1Junta los LIBROS con sus veh\xEDculos!"
    m_Metadata:
      m_Items: []
  - m_Id: 29490495578169348
    m_Localized: "Eso est\xE1 bien. \xA1A\xFAn no has terminado, sigue adelante!"
    m_Metadata:
      m_Items: []
  - m_Id: 29490495578169349
    m_Localized: "\xA1Tenemos otro PROBLEMA!"
    m_Metadata:
      m_Items: []
  - m_Id: 29490495578169350
    m_Localized: "Los veh\xEDculos ya no est\xE1n all\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 29490495578169351
    m_Localized: "Por favor, hable con el encargado de la primera habitaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 29490495578169352
    m_Localized: "\xA1Bien hecho! Has emparejado todos los LIBROS con sus VEH\xCDCULOS."
    m_Metadata:
      m_Items: []
  - m_Id: 29490495578169353
    m_Localized: "\xA1Ahora todo est\xE1 listo para recibir a los visitantes!"
    m_Metadata:
      m_Items: []
  - m_Id: 29490495578169354
    m_Localized: "Perfecto. \xA1Ahora el museo est\xE1 limpio! Vuelve a la GU\xCDA
      DEL MUSEO."
    m_Metadata:
      m_Items: []
  - m_Id: 29498754787696640
    m_Localized: "\xA1Encontraste el SUBMARINO!"
    m_Metadata:
      m_Items: []
  - m_Id: 29498754787696641
    m_Localized: "\xBFPodr\xEDas arreglarlo, por favor?"
    m_Metadata:
      m_Items: []
  - m_Id: 29498754787696642
    m_Localized: "\xA1Socorro! \xA1El Nautilus ha desaparecido!"
    m_Metadata:
      m_Items: []
  - m_Id: 29498754787696643
    m_Localized: Encuentra el SUBMARINO
    m_Metadata:
      m_Items: []
  - m_Id: 29498754787696644
    m_Localized: "\xA1Lo arreglaste! \xA1Gracias!"
    m_Metadata:
      m_Items: []
  - m_Id: 29498754787696645
    m_Localized: "Ahora ve al siguiente guardi\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 29501744894435328
    m_Localized: "\xA1Genial! Ahora devu\xE9lvelo a su guardi\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 29724990315159552
    m_Localized: "\xA1Encontraste el GLOBO AEROST\xC1TICO! Tambi\xE9n se le llama
      globo."
    m_Metadata:
      m_Items: []
  - m_Id: 29724990315159554
    m_Localized: "\xA1Ayuda! \xA1Falta algo!"
    m_Metadata:
      m_Items: []
  - m_Id: 29724990315159555
    m_Localized: "Encuentra el GLOBO AEROST\xC1TICO"
    m_Metadata:
      m_Items: []
  - m_Id: 29724990315159558
    m_Localized: Este libro se titula "Cinco semanas en un globo".
    m_Metadata:
      m_Items: []
  - m_Id: 29724990315159559
    m_Localized: Un globo se eleva porque el aire caliente es ligero.
    m_Metadata:
      m_Items: []
  - m_Id: 29735032657534976
    m_Localized: "\xA1Pero est\xE1 ROTO!"
    m_Metadata:
      m_Items: []
  - m_Id: 29735032657534977
    m_Localized: "Vuelve a hablar conmigo m\xE1s tarde."
    m_Metadata:
      m_Items: []
  - m_Id: 29743951194873856
    m_Localized: Un submarino se desplaza bajo el mar.
    m_Metadata:
      m_Items: []
  - m_Id: 29743951199068165
    m_Localized: "\xA1Encontraste el tren!"
    m_Metadata:
      m_Items: []
  - m_Id: 29743951199068168
    m_Localized: "\xA1Socorro! \xA1Hemos perdido el tren!"
    m_Metadata:
      m_Items: []
  - m_Id: 29743951199068169
    m_Localized: Encuentra el VIEJO TREN DE VAPOR
    m_Metadata:
      m_Items: []
  - m_Id: 29743951199068174
    m_Localized: "Un tren circula sobre ra\xEDles."
    m_Metadata:
      m_Items: []
  - m_Id: 29743951199068175
    m_Localized: "Este viejo tren se mov\xEDa a vapor."
    m_Metadata:
      m_Items: []
  - m_Id: 29743951199068176
    m_Localized: "Los trenes hicieron que los viajes largos fueran m\xE1s r\xE1pidos."
    m_Metadata:
      m_Items: []
  - m_Id: 29743951199068177
    m_Localized: "\xA1Encontraste el COHETE!"
    m_Metadata:
      m_Items: []
  - m_Id: 29743951199068180
    m_Localized: "\xA1Socorro! \xA1Nuestra m\xE1quina m\xE1s valiosa ha desaparecido!"
    m_Metadata:
      m_Items: []
  - m_Id: 29743951199068181
    m_Localized: Encuentra el COHETE ESPACIAL
    m_Metadata:
      m_Items: []
  - m_Id: 29743951199068184
    m_Localized: "\xA1Vuelve a la GU\xCDA DEL MUSEO!"
    m_Metadata:
      m_Items: []
  - m_Id: 29743951199068186
    m_Localized: Esto es un cohete espacial.
    m_Metadata:
      m_Items: []
  - m_Id: 29748868638826511
    m_Localized: "\xA1Encontraste todos los veh\xEDculos!"
    m_Metadata:
      m_Items: []
  - m_Id: 29750743886979072
    m_Localized: Si no lo encuentras, USA EL MAPA
    m_Metadata:
      m_Items: []
  - m_Id: 29753348373602310
    m_Localized: "Julio Verne imagin\xF3 los cohetes y los viajes espaciales hace
      mucho tiempo."
    m_Metadata:
      m_Items: []
  - m_Id: 29753348373602311
    m_Localized: "La historia tiene un enorme ca\xF1\xF3n espacial para lanzar el
      cohete."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
