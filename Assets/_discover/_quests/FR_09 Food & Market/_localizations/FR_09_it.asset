  m_TableData:
  - m_Id: 125433798656
    m_Localized: "Benvenuti nella citt\xE0 di Marsiglia."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798657
    m_Localized: Ciao! Sono un fornaio. Vendo pane e torte.
    m_Metadata:
      m_Items: []
  - m_Id: 125433798658
    m_Localized: Ogni giorno mi alzo presto per infornare il pane, preparare torte
      e croissant.
    m_Metadata:
      m_Items: []
  - m_Id: 125433798660
    m_Localized: Bonjour!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798661
    m_Localized: Grazie!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798662
    m_Localized: Banana!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798663
    m_Localized: Cosa desideri acquistare?
    m_Metadata:
      m_Items: []
  - m_Id: 125433798664
    m_Localized: Pane
    m_Metadata:
      m_Items: []
  - m_Id: 125433798665
    m_Localized: Pesce e granchio
    m_Metadata:
      m_Items: []
  - m_Id: 125433798666
    m_Localized: Pomodori, arance e limoni
    m_Metadata:
      m_Items: []
  - m_Id: 125433798667
    m_Localized: Sale, pepe e olio
    m_Metadata:
      m_Items: []
  - m_Id: 125433798668
    m_Localized: Ora devi pagare i tuoi acquisti.
    m_Metadata:
      m_Items: []
