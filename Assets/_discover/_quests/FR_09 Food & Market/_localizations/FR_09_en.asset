  - m_Id: 125433798656
    m_Localized: Welcome to the city of Marseille.
    m_Metadata:
      m_Items: []
  - m_Id: 125433798657
    m_Localized: Hello! I'm a baker. I sell bread and cakes.
    m_Metadata:
      m_Items: []
  - m_Id: 125433798658
    m_Localized: Every day, I get up early to bake bread, prepare cakes and croissants.
    m_Metadata:
      m_Items: []
