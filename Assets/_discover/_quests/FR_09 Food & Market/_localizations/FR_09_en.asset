  - m_Id: 125433798698
    m_Localized: Hello! I am a cheesemaker. I sell products made with milk.
    m_Metadata:
      m_Items: []
  - m_Id: 125433798699
    m_Localized: I sell yogurt, cheese, butter, and milk.
