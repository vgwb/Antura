  m_TableData:
  - m_Id: 125433798656
    m_Localized: Willkommen in der Stadt Marseille.
    m_Metadata:
      m_Items: []
  - m_Id: 125433798657
    m_Localized: "Hallo! Ich bin B\xE4cker. Ich verkaufe Brot und Kuchen."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798658
    m_Localized: "Jeden Tag stehe ich fr\xFCh auf, um Brot zu backen, Kuchen und
      Croissants zuzubereiten."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798660
    m_Localized: Bonjour!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798661
    m_Localized: Merci!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798662
    m_Localized: Banane!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798663
    m_Localized: "Was m\xF6chten Sie kaufen?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798664
    m_Localized: Brot
    m_Metadata:
      m_Items: []
  - m_Id: 125433798665
    m_Localized: Fisch und Krabben
    m_Metadata:
      m_Items: []
  - m_Id: 125433798666
    m_Localized: Tomaten, Orangen und Zitronen
    m_Metadata:
      m_Items: []
  - m_Id: 125433798667
    m_Localized: "Salz, Pfeffer und \xD6l"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798668
    m_Localized: "Sie m\xFCssen nun Ihre Eink\xE4ufe bezahlen."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798669
    m_Localized: Merci!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798670
    m_Localized: Au revoir!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798671
    m_Localized: "Bonne journ\xE9e!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798673
    m_Localized: Au revoir!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798674
    m_Localized: Merci!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798675
    m_Localized: "Bonne journ\xE9e!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798677
    m_Localized: "Was m\xF6chten Sie kaufen?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798678
    m_Localized: Fisch und Krabben
    m_Metadata:
      m_Items: []
  - m_Id: 125433798679
    m_Localized: Tomaten, Orangen und Zitronen
    m_Metadata:
      m_Items: []
  - m_Id: 125433798680
    m_Localized: Brot
    m_Metadata:
      m_Items: []
  - m_Id: 125433798681
    m_Localized: Milch
    m_Metadata:
      m_Items: []
  - m_Id: 125433798682
    m_Localized: "Lyc\xE9e!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798683
    m_Localized: Bonjour!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798684
    m_Localized: Au revoir!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798685
    m_Localized: "Guten Morgen! Ich bin Fischh\xE4ndler und verkaufe Fisch und Krabben."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798686
    m_Localized: "Sie m\xFCssen nun Ihre Eink\xE4ufe bezahlen."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798687
    m_Localized: Merci!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798688
    m_Localized: Bonjour!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798689
    m_Localized: Chatten!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798690
    m_Localized: "Was m\xF6chten Sie kaufen?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798691
    m_Localized: Milch
    m_Metadata:
      m_Items: []
  - m_Id: 125433798692
    m_Localized: "Salz, Pfeffer und \xD6l"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798693
    m_Localized: Brot
    m_Metadata:
      m_Items: []
  - m_Id: 125433798694
    m_Localized: Tomaten, Orangen und Zitronen
    m_Metadata:
      m_Items: []
  - m_Id: 125433798695
    m_Localized: "Bonne journ\xE9e!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798696
    m_Localized: Au revoir!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798697
    m_Localized: Merci!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798698
    m_Localized: "Hallo! Ich bin K\xE4sehersteller. Ich verkaufe Produkte aus Milch."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798699
    m_Localized: "Ich verkaufe Joghurt, K\xE4se, Butter und Milch."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798702
    m_Localized: "Bonne journ\xE9e!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798703
    m_Localized: Merci!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798704
    m_Localized: Au revoir!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798705
    m_Localized: "Was m\xF6chten Sie kaufen?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798706
    m_Localized: Fisch und Krabben
    m_Metadata:
      m_Items: []
  - m_Id: 125433798707
    m_Localized: Brot
    m_Metadata:
      m_Items: []
  - m_Id: 125433798708
    m_Localized: Tomaten, Orangen und Zitronen
    m_Metadata:
      m_Items: []
  - m_Id: 125433798709
    m_Localized: Milch
    m_Metadata:
      m_Items: []
  - m_Id: 125433798710
    m_Localized: Merci!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798711
    m_Localized: Zug!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798712
    m_Localized: Bonjour!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798713
    m_Localized: "Hallo! Ich bin ein Obst- und Gem\xFCseh\xE4ndler."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798714
    m_Localized: "Ich verkaufe Gem\xFCse wie Salat, Tomaten und Karotten. Ich verkaufe
      Obst wie Zitronen, \xC4pfel und Bananen."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798715
    m_Localized: Au revoir!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798716
    m_Localized: Merci!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798717
    m_Localized: "Bonne journ\xE9e!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798719
    m_Localized: "Was m\xF6chten Sie kaufen?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798720
    m_Localized: Tomaten, Orangen und Zitronen
    m_Metadata:
      m_Items: []
  - m_Id: 125433798721
    m_Localized: Brot
    m_Metadata:
      m_Items: []
  - m_Id: 125433798722
    m_Localized: Milch
    m_Metadata:
      m_Items: []
  - m_Id: 125433798723
    m_Localized: "Salz, Pfeffer und \xD6l"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798724
    m_Localized: Merci!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798725
    m_Localized: Bonjour!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798726
    m_Localized: Livre!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798727
    m_Localized: "Hallo! Ich bin Lebensmittelh\xE4ndler. Ich verkaufe Gew\xFCrze
      wie Salz und Pfeffer. Aber ich verkaufe auch andere Zutaten wie Mehl und Zucker."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798728
    m_Localized: "Meine Produkte eignen sich f\xFCr viele Rezepte."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798729
    m_Localized: Ahoi! Willkommen an Bord.
    m_Metadata:
      m_Items: []
  - m_Id: 125433798730
    m_Localized: Wir sind Piraten.
    m_Metadata:
      m_Items: []
  - m_Id: 125433798731
    m_Localized: "Piraten verf\xFCgen \xFCber gro\xDFe Schiffe, um die Meere und
      Ozeane zu \xFCberqueren."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798732
    m_Localized: "Vor langer Zeit suchten Piraten nach Sch\xE4tzen."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798733
    m_Localized: "Die Piraten griffen auch andere Schiffe an. Sie stahlen Gegenst\xE4nde
      und Schmuck von den Schiffen."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798734
    m_Localized: "damit die Gesch\xE4fte ge\xF6ffnet bleiben k\xF6nnen!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798735
    m_Localized: "Hallo! Willkommen in Marseille. Sie gehen zum Markt, um Zutaten
      f\xFCr eine Bouillabaisse zu kaufen. Bouillabaisse ist eine traditionelle Fischsuppe."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798736
    m_Localized: "Ich m\xF6chte f\xFCr Sie ein traditionelles Gericht aus Marseille
      zubereiten. Eine Bouillabaisse!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798737
    m_Localized: Aber ich brauche deine Hilfe, um die Zutaten zu kaufen.
    m_Metadata:
      m_Items: []
  - m_Id: 125433798738
    m_Localized: "Geh zum Markt und bring mir die Zutaten f\xFCr eine Bouillabaisse
      mit."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798739
    m_Localized: "Begr\xFC\xDFen Sie die Marktverk\xE4ufer."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798740
    m_Localized: Verabschieden Sie sich, wenn Sie mit dem Einkaufen fertig sind.
    m_Metadata:
      m_Items: []
  - m_Id: 125433798741
    m_Localized: "Vergessen Sie nicht, den Ladenbesitzern \u201EDanke\u201C zu sagen."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798742
    m_Localized: "Geh zur\xFCck und schau dem Koch beim Kochen zu."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798743
    m_Localized: Gut gemacht! Du hast es geschafft, alle Zutaten zu kaufen.
    m_Metadata:
      m_Items: []
  - m_Id: 125433798744
    m_Localized: "Du hast jeden mit \u201EHallo\u201C begr\xFC\xDFt. Du hast dich
      bei allen Ladenbesitzern mit \u201EDanke\u201C bedankt."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798745
    m_Localized: Nun lasst uns gemeinsam das Boullabaise-Rezept zubereiten!
    m_Metadata:
      m_Items: []
  - m_Id: 125437992960
    m_Localized: "Ordnen Sie jedem Lebensmittel den entsprechenden Verk\xE4ufer zu."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992961
    m_Localized: Gut gemacht! Sie haben es geschafft, jedes Lebensmittel dem jeweiligen
      Anbieter zuzuordnen.
    m_Metadata:
      m_Items: []
  - m_Id: 125437992962
    m_Localized: 'Jetzt bereite ich die Fischsuppe zu: Bouillabaisse!'
    m_Metadata:
      m_Items: []
  - m_Id: 125437992963
    m_Localized: "Sie m\xFCssen nun Ihre Eink\xE4ufe bezahlen."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992964
    m_Localized: "Sie m\xFCssen nun Ihre Eink\xE4ufe bezahlen."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992965
    m_Localized: "Sie m\xFCssen nun Ihre Eink\xE4ufe bezahlen."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992966
    m_Localized: "Sie m\xFCssen nun Ihre Eink\xE4ufe bezahlen."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992970
    m_Localized: Entschuldigung, ich glaube, ich verstehe das nicht...
    m_Metadata:
      m_Items: []
  - m_Id: 125437992971
    m_Localized: Was?
    m_Metadata:
      m_Items: []
  - m_Id: 125437992972
    m_Localized: "H\xE4?"
    m_Metadata:
      m_Items: []
  - m_Id: 125437992973
    m_Localized: Brot
    m_Metadata:
      m_Items: []
  - m_Id: 125437992974
    m_Localized: Fisch
    m_Metadata:
      m_Items: []
  - m_Id: 125437992975
    m_Localized: Orange
    m_Metadata:
      m_Items: []
  - m_Id: 125437992976
    m_Localized: Zitrone
    m_Metadata:
      m_Items: []
  - m_Id: 125437992977
    m_Localized: Tomate
    m_Metadata:
      m_Items: []
  - m_Id: 125437992978
    m_Localized: Milch
    m_Metadata:
      m_Items: []
  - m_Id: 125437992979
    m_Localized: Salz und Pfeffer
    m_Metadata:
      m_Items: []
  - m_Id: 125437992981
    m_Localized: "Oliven\xF6l"
    m_Metadata:
      m_Items: []
  - m_Id: 80762619944960
    m_Localized: "Vervollst\xE4ndige das Bild."
    m_Metadata:
      m_Items: []
  - m_Id: 83685710094336
    m_Localized: Ich brauche mehr Zutaten!
    m_Metadata:
      m_Items: []
  - m_Id: 83685710094337
    m_Localized: "Besuche alle H\xE4ndler auf dem Markt."
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703168
    m_Localized: "Ich habe Ihre Eink\xE4ufe auf den Tisch neben Ihnen gestellt. Bedienen
      Sie sich!"
    m_Metadata:
      m_Items: []
  - m_Id: 845723419926528
    m_Localized: "Sammle alle Zutaten f\xFCr das Rezept."
    m_Metadata:
      m_Items: []
  - m_Id: 845723419926530
    m_Localized: Krabbe
    m_Metadata:
      m_Items: []
  - m_Id: 862493363003393
    m_Localized: Tut mir leid, das verkaufe ich nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 9169988422590464
    m_Localized: Hallo
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703181
    m_Localized: "Schau dir auch die anderen Verk\xE4ufer an!"
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703179
    m_Localized: Sie haben bereits Produkte von mir gekauft!
    m_Metadata:
      m_Items: []
  - m_Id: 2381619980656640
    m_Localized: "Gut gemacht! Du hast es geschafft, alle Zutaten f\xFCr den Koch
      zu besorgen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850944
    m_Localized: Was ist dein Lieblingsessen?
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850945
    m_Localized: Hallo! Ich besuche die Stadt Marseille.
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850946
    m_Localized: Das Essen hier ist fantastisch!
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850947
    m_Localized: Ich liebe das Meer!
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850948
    m_Localized: Es ist sehr angenehm, auf dem Markt einzukaufen!
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850949
    m_Localized: Bouillabaisse ist mein Lieblingsgericht!
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850950
    m_Localized: Ich muss noch frische Zutaten kaufen.
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850951
    m_Localized: Auf dem Markt kann man gute Produkte finden.
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850952
    m_Localized: "Der Fisch ist k\xF6stlich."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850953
    m_Localized: Ich freue mich darauf, ein leckeres Essen zu kochen.
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850954
    m_Localized: "In Frankreich und Europa hei\xDFt die W\xE4hrung Euro. Es gibt
      M\xFCnzen und Banknoten."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850955
    m_Localized: Sie haben den richtigen Geldbetrag gegeben. Gut gemacht!
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850956
    m_Localized: "Sie k\xF6nnen mit M\xFCnzen und Scheinen bezahlen. Sie k\xF6nnen
      aber auch mit einer Bankkarte bezahlen."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850957
    m_Localized: "Die Boullabaise-Suppe enth\xE4lt viel Fisch."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850958
    m_Localized: "Die Tomate ist k\xF6stlich."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850959
    m_Localized: "Oliven\xF6l verleiht dem Gericht Geschmack."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850960
    m_Localized: Manchmal essen wir Brot zur Suppe.
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850961
    m_Localized: "Ein B\xE4cker backt Brot. Er bereitet auch Croissants und Kuchen
      zu."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850962
    m_Localized: "Ein Fischh\xE4ndler verkauft Fisch und Krabben."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850963
    m_Localized: "Ein K\xE4seh\xE4ndler verkauft Produkte, die aus Milch hergestellt
      werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850964
    m_Localized: "Ein Gem\xFCseh\xE4ndler verkauft Obst und Gem\xFCse."
    m_Metadata:
      m_Items: []
  - m_Id: 6601427467100160
    m_Localized: Du hast doch schon Brot bei mir gekauft!
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703176
    m_Localized: Du hast das Obst ja schon gekauft!
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703172
    m_Localized: Du hast die Milch ja schon gekauft!
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703170
    m_Localized: Du hast den Fisch ja schon gekauft!
    m_Metadata:
      m_Items: []
  - m_Id: 6601427496460292
    m_Localized: "Na los, na los! Ich muss mich auf meine n\xE4chste Reise vorbereiten."
    m_Metadata:
      m_Items: []
  - m_Id: 6601427496460293
    m_Localized: Du musst deine Lebensmittel bezahlen.
    m_Metadata:
      m_Items: []
  - m_Id: 24016153620766720
    m_Localized: Etwas Brot
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155328
    m_Localized: Ein Fisch
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155329
    m_Localized: Eine Orange
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155330
    m_Localized: Eine Zitrone
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155331
    m_Localized: Eine Tomate
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155332
    m_Localized: Etwas Milch
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155333
    m_Localized: "Oliven\xF6l"
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155334
    m_Localized: Pfeffer und Salz
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155335
    m_Localized: Und nimm die Zutaten, die du kaufst.
    m_Metadata:
      m_Items: []
  - m_Id: 24018976370581505
    m_Localized: "M\xF6chtest du noch einmal spielen?"
    m_Metadata:
      m_Items: []
  - m_Id: 24018976370581506
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 24018976370581507
    m_Localized: NEIN
    m_Metadata:
      m_Items: []
  - m_Id: 24018986583711744
    m_Localized: "Heute erkundest du den Markt. Du kaufst Zutaten f\xFCr ein traditionelles
      Gericht aus Marseille: Bouillabaisse, eine Fischsuppe."
    m_Metadata:
      m_Items: []
  - m_Id: 24019923897409548
    m_Localized: "M\xF6chtest du ein Spiel spielen?"
    m_Metadata:
      m_Items: []
  - m_Id: 24019923897409551
    m_Localized: "Viel Gl\xFCck!"
    m_Metadata:
      m_Items: []
  - m_Id: 24329307819073536
    m_Localized: Das ist nicht richtig. Versuchen Sie es noch einmal!
    m_Metadata:
      m_Items: []
  - m_Id: 25849701587738642
    m_Localized: "Gut gemacht, Kumpel! Du hast das R\xE4tsel gel\xF6st."
    m_Metadata:
      m_Items: []
  - m_Id: 25849701587738643
    m_Localized: Nimm meinen Schatz als Belohnung.
    m_Metadata:
      m_Items: []
  - m_Id: 25849701587738644
    m_Localized: "Ahoi! Du hast das R\xE4tsel nicht gel\xF6st."
    m_Metadata:
      m_Items: []
  - m_Id: 25862652839321600
    m_Localized: Die Piratentruhe ist verschlossen.
    m_Metadata:
      m_Items: []
  - m_Id: 26141442744246272
    m_Localized: Super! Du hast alle Zutaten.
    m_Metadata:
      m_Items: []
  - m_Id: 129501256219615232
