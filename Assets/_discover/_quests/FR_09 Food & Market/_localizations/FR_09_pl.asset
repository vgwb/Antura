  m_TableData:
  - m_Id: 125433798656
    m_Localized: Witamy w Marsylii.
    m_Metadata:
      m_Items: []
  - m_Id: 125433798657
    m_Localized: "Cze\u015B\u0107! Jestem piekarzem. Sprzedaj\u0119 chleb i ciasta."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798658
    m_Localized: "Codziennie wstaj\u0119 wcze\u015Bnie rano, aby upiec chleb, przygotowa\u0107
      ciasta i rogaliki."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798660
    m_Localized: "Dzie\u0144 dobry!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798661
    m_Localized: "Dzi\u0119kuj\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798662
    m_Localized: Banan!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798663
    m_Localized: "Co chcesz kupi\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798664
    m_Localized: Chleb
    m_Metadata:
      m_Items: []
  - m_Id: 125433798665
    m_Localized: Ryby i kraby
    m_Metadata:
      m_Items: []
  - m_Id: 125433798666
    m_Localized: "Pomidory, pomara\u0144cze i cytryny"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798667
    m_Localized: "S\xF3l, pieprz i olej"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798668
    m_Localized: "Teraz musisz zap\u0142aci\u0107 za swoje zakupy."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798669
    m_Localized: "Dzi\u0119kuj\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798670
    m_Localized: Do widzenia!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798671
    m_Localized: "Bonne journ\xE9e!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798673
    m_Localized: Do widzenia!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798674
    m_Localized: "Dzi\u0119kuj\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798675
    m_Localized: "Bonne journ\xE9e!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798677
    m_Localized: "Co chcesz kupi\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798678
    m_Localized: Ryby i kraby
    m_Metadata:
      m_Items: []
  - m_Id: 125433798679
    m_Localized: "Pomidory, pomara\u0144cze i cytryny"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798680
    m_Localized: Chleb
    m_Metadata:
      m_Items: []
  - m_Id: 125433798681
    m_Localized: Mleko
    m_Metadata:
      m_Items: []
  - m_Id: 125433798682
    m_Localized: Liceum!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798683
    m_Localized: "Dzie\u0144 dobry!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798684
    m_Localized: Do widzenia!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798685
    m_Localized: "Dzie\u0144 dobry! Jestem rybakiem i sprzedaj\u0119 ryby i kraby."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798686
    m_Localized: "Teraz musisz zap\u0142aci\u0107 za swoje zakupy."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798687
    m_Localized: "Dzi\u0119kuj\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798688
    m_Localized: "Dzie\u0144 dobry!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798689
    m_Localized: "Pogaw\u0119dzi\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798690
    m_Localized: "Co chcesz kupi\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798691
    m_Localized: Mleko
    m_Metadata:
      m_Items: []
  - m_Id: 125433798692
    m_Localized: "S\xF3l, pieprz i olej"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798693
    m_Localized: Chleb
    m_Metadata:
      m_Items: []
  - m_Id: 125433798694
    m_Localized: "Pomidory, pomara\u0144cze i cytryny"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798695
    m_Localized: "Bonne journ\xE9e!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798696
    m_Localized: Do widzenia!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798697
    m_Localized: "Dzi\u0119kuj\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798698
    m_Localized: "Cze\u015B\u0107! Jestem serowarem. Sprzedaj\u0119 produkty z mleka."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798699
    m_Localized: "Sprzedaj\u0119 jogurt, ser, mas\u0142o i mleko."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798702
    m_Localized: "Bonne journ\xE9e!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798703
    m_Localized: "Dzi\u0119kuj\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798704
    m_Localized: Do widzenia!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798705
    m_Localized: "Co chcesz kupi\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798706
    m_Localized: Ryby i kraby
    m_Metadata:
      m_Items: []
  - m_Id: 125433798707
    m_Localized: Chleb
    m_Metadata:
      m_Items: []
  - m_Id: 125433798708
    m_Localized: "Pomidory, pomara\u0144cze i cytryny"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798709
    m_Localized: Mleko
    m_Metadata:
      m_Items: []
  - m_Id: 125433798710
    m_Localized: "Dzi\u0119kuj\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798711
    m_Localized: "Poci\u0105g!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798712
    m_Localized: "Dzie\u0144 dobry!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798713
    m_Localized: "Cze\u015B\u0107! Jestem sprzedawc\u0105 owoc\xF3w i warzyw."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798714
    m_Localized: "Sprzedaj\u0119 warzywa takie jak sa\u0142ata, pomidory i marchewki.
      Sprzedaj\u0119 owoce takie jak cytryny, jab\u0142ka i banany."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798715
    m_Localized: Do widzenia!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798716
    m_Localized: "Dzi\u0119kuj\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798717
    m_Localized: "Bonne journ\xE9e!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798719
    m_Localized: "Co chcesz kupi\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798720
    m_Localized: "Pomidory, pomara\u0144cze i cytryny"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798721
    m_Localized: Chleb
    m_Metadata:
      m_Items: []
  - m_Id: 125433798722
    m_Localized: Mleko
    m_Metadata:
      m_Items: []
  - m_Id: 125433798723
    m_Localized: "S\xF3l, pieprz i olej"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798724
    m_Localized: "Dzi\u0119kuj\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798725
    m_Localized: "Dzie\u0144 dobry!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798726
    m_Localized: "Ksi\u0105\u017Cka!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798727
    m_Localized: "Cze\u015B\u0107! Jestem sprzedawc\u0105 spo\u017Cywczym. Sprzedaj\u0119
      przyprawy, takie jak s\xF3l i pieprz. Ale sprzedaj\u0119 te\u017C inne sk\u0142adniki,
      takie jak m\u0105ka i cukier."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798728
    m_Localized: "Moje produkty mo\u017Cesz wykorzysta\u0107 w wielu przepisach."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798729
    m_Localized: "Ahoj! Witamy na pok\u0142adzie."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798730
    m_Localized: "Jeste\u015Bmy piratami."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798731
    m_Localized: "Piraci maj\u0105 du\u017Ce statki, kt\xF3rymi przemierzaj\u0105
      morza i oceany."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798732
    m_Localized: "Dawno temu piraci szukali skarb\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798733
    m_Localized: "Piraci zaatakowali r\xF3wnie\u017C inne statki, kradn\u0105c przedmioty
      i bi\u017Cuteri\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798734
    m_Localized: "aby sklepy mog\u0142y pozosta\u0107 otwarte!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798735
    m_Localized: "Witaj! Witamy w Marsylii. Idziesz na targ. Kupujesz sk\u0142adniki
      do przygotowania zupy rybnej (bouillabaisse). Zupa rybna to tradycyjna zupa
      rybna."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798736
    m_Localized: "Chc\u0119 przygotowa\u0107 dla Ciebie tradycyjne danie z Marsylii.
      Bouillabaisse!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798737
    m_Localized: "Ale potrzebuj\u0119 twojej pomocy, \u017Ceby kupi\u0107 sk\u0142adniki."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798738
    m_Localized: "Id\u017A na rynek i przywie\u017A mi sk\u0142adniki, \u017Ceby
      przygotowa\u0107 zup\u0119 rybn\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798739
    m_Localized: "Przywitaj si\u0119 ze sprzedawcami na targu."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798740
    m_Localized: "Po sko\u0144czonych zakupach po\u017Cegnaj si\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798741
    m_Localized: "Nie zapomnij podzi\u0119kowa\u0107 sprzedawcom."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798742
    m_Localized: "Wr\xF3\u0107 i zobacz jak gotuje szef kuchni."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798743
    m_Localized: "Brawo! Uda\u0142o Ci si\u0119 kupi\u0107 wszystkie sk\u0142adniki."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798744
    m_Localized: "Przywita\u0142e\u015B wszystkich s\u0142owem \u201Ecze\u015B\u0107\u201D.
      Podzi\u0119kowa\u0142e\u015B wszystkim sprzedawcom s\u0142owami \u201Edzi\u0119kuj\u0119\u201D."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798745
    m_Localized: Przygotujmy razem przepis na boullabaise!
    m_Metadata:
      m_Items: []
  - m_Id: 125437992960
    m_Localized: "Dopasuj ka\u017Cdy produkt spo\u017Cywczy do jego sprzedawcy."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992961
    m_Localized: "Gratulacje! Uda\u0142o Ci si\u0119 dopasowa\u0107 ka\u017Cdy produkt
      spo\u017Cywczy do jego sprzedawcy."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992962
    m_Localized: "Teraz przygotuj\u0119 zup\u0119 rybn\u0105: bouillabaisse!"
    m_Metadata:
      m_Items: []
  - m_Id: 125437992963
    m_Localized: "Teraz musisz zap\u0142aci\u0107 za swoje zakupy."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992964
    m_Localized: "Teraz musisz zap\u0142aci\u0107 za swoje zakupy."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992965
    m_Localized: "Teraz musisz zap\u0142aci\u0107 za swoje zakupy."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992966
    m_Localized: "Teraz musisz zap\u0142aci\u0107 za swoje zakupy."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992970
    m_Localized: Przepraszam, chyba nie rozumiem...
    m_Metadata:
      m_Items: []
  - m_Id: 125437992971
    m_Localized: Co?
    m_Metadata:
      m_Items: []
  - m_Id: 125437992972
    m_Localized: Co?
    m_Metadata:
      m_Items: []
  - m_Id: 125437992973
    m_Localized: Chleb
    m_Metadata:
      m_Items: []
  - m_Id: 125437992974
    m_Localized: Ryba
    m_Metadata:
      m_Items: []
  - m_Id: 125437992975
    m_Localized: "Pomara\u0144czowy"
    m_Metadata:
      m_Items: []
  - m_Id: 125437992976
    m_Localized: Cytrynowy
    m_Metadata:
      m_Items: []
  - m_Id: 125437992977
    m_Localized: Pomidor
    m_Metadata:
      m_Items: []
  - m_Id: 125437992978
    m_Localized: Mleko
    m_Metadata:
      m_Items: []
  - m_Id: 125437992979
    m_Localized: "S\xF3l i pieprz"
    m_Metadata:
      m_Items: []
  - m_Id: 125437992981
    m_Localized: Oliwa z oliwek
    m_Metadata:
      m_Items: []
  - m_Id: 80762619944960
    m_Localized: "Uzupe\u0142nij obraz."
    m_Metadata:
      m_Items: []
  - m_Id: 83685710094336
    m_Localized: "Potrzebuj\u0119 wi\u0119cej sk\u0142adnik\xF3w!"
    m_Metadata:
      m_Items: []
  - m_Id: 83685710094337
    m_Localized: "Id\u017A i zobacz wszystkich sprzedawc\xF3w na targu."
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703168
    m_Localized: "Po\u0142o\u017Cy\u0142em twoje zakupy na stoliku obok ciebie. Cz\u0119stuj
      si\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 845723419926528
    m_Localized: "Zbierz wszystkie sk\u0142adniki potrzebne do przepisu."
    m_Metadata:
      m_Items: []
  - m_Id: 845723419926530
    m_Localized: Krab
    m_Metadata:
      m_Items: []
  - m_Id: 862493363003393
    m_Localized: "Przykro mi, ale tego nie sprzedaj\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 9169988422590464
    m_Localized: Witam
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703181
    m_Localized: "Zobacz innych sprzedawc\xF3w!"
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703179
    m_Localized: "Ju\u017C kupi\u0142e\u015B u mnie produkty!"
    m_Metadata:
      m_Items: []
  - m_Id: 2381619980656640
    m_Localized: "Brawo! Uda\u0142o Ci si\u0119 kupi\u0107 wszystkie sk\u0142adniki
      dla szefa kuchni!"
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850944
    m_Localized: Jakie jest twoje ulubione jedzenie?
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850945
    m_Localized: "Cze\u015B\u0107! Odwiedzam Marsyli\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850946
    m_Localized: Jedzenie tutaj jest niesamowite!
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850947
    m_Localized: Uwielbiam morze!
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850948
    m_Localized: "Bardzo przyjemnie robi si\u0119 zakupy na targu!"
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850949
    m_Localized: Bouillabaisse to moje ulubione danie!
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850950
    m_Localized: "Musz\u0119 kupi\u0107 \u015Bwie\u017Ce sk\u0142adniki."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850951
    m_Localized: "Dobre produkty mo\u017Cna znale\u017A\u0107 na rynku."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850952
    m_Localized: Ryba jest pyszna.
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850953
    m_Localized: "Nie mog\u0119 si\u0119 doczeka\u0107, a\u017C przygotuj\u0119 pyszny
      posi\u0142ek."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850954
    m_Localized: "We Francji i Europie walut\u0105 jest euro. Istniej\u0105 monety
      i banknoty."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850955
    m_Localized: "Da\u0142e\u015B odpowiedni\u0105 kwot\u0119. Dobra robota!"
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850956
    m_Localized: "Mo\u017Cna p\u0142aci\u0107 monetami i banknotami. Mo\u017Cna r\xF3wnie\u017C
      p\u0142aci\u0107 kart\u0105 bankow\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850957
    m_Localized: "Zupa boullabaise zawiera du\u017Co ryb."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850958
    m_Localized: Pomidor jest pyszny.
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850959
    m_Localized: Oliwa z oliwek dodaje potrawie smaku.
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850960
    m_Localized: Czasami jemy chleb do zupy.
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850961
    m_Localized: "Piekarz piecze chleb. Przygotowuje r\xF3wnie\u017C rogaliki i ciasta."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850962
    m_Localized: Sprzedawca ryb sprzedaje ryby i kraby.
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850963
    m_Localized: Sprzedawca sera sprzedaje produkty wykonane z mleka.
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850964
    m_Localized: "Sprzedawca warzyw i owoc\xF3w sprzedaje warzywa."
    m_Metadata:
      m_Items: []
  - m_Id: 6601427467100160
    m_Localized: "Ju\u017C kupi\u0142e\u015B ode mnie chleb!"
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703176
    m_Localized: "Ju\u017C kupi\u0142e\u015B owoce!"
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703172
    m_Localized: "Ju\u017C kupi\u0142e\u015B mleko!"
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703170
    m_Localized: "Ju\u017C kupi\u0142e\u015B ryb\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 6601427496460292
    m_Localized: "No dalej, no dalej! Musz\u0119 przygotowa\u0107 si\u0119 do nast\u0119pnej
      podr\xF3\u017Cy."
    m_Metadata:
      m_Items: []
  - m_Id: 6601427496460293
    m_Localized: "Musisz zap\u0142aci\u0107 za zakupy spo\u017Cywcze."
    m_Metadata:
      m_Items: []
  - m_Id: 24016153620766720
    m_Localized: "Troch\u0119 chleba"
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155328
    m_Localized: Ryba
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155329
    m_Localized: "Pomara\u0144cza"
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155330
    m_Localized: Cytryna
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155331
    m_Localized: Pomidor
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155332
    m_Localized: "Troch\u0119 mleka"
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155333
    m_Localized: Oliwa z oliwek
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155334
    m_Localized: "Pieprz i s\xF3l"
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155335
    m_Localized: "I we\u017A sk\u0142adniki, kt\xF3re kupi\u0142e\u015B."
    m_Metadata:
      m_Items: []
  - m_Id: 24018976370581505
    m_Localized: "Czy chcesz zagra\u0107 jeszcze raz?"
    m_Metadata:
      m_Items: []
  - m_Id: 24018976370581506
    m_Localized: Tak
    m_Metadata:
      m_Items: []
  - m_Id: 24018976370581507
    m_Localized: NIE
    m_Metadata:
      m_Items: []
  - m_Id: 24018986583711744
    m_Localized: "Dzisiaj zwiedzisz targ. Kupisz sk\u0142adniki do przygotowania
      tradycyjnego dania z Marsylii \u2013 Bouillabaisse, zupy rybnej."
    m_Metadata:
      m_Items: []
  - m_Id: 24019923897409548
    m_Localized: "Chcesz zagra\u0107 w gr\u0119?"
    m_Metadata:
      m_Items: []
  - m_Id: 24019923897409551
    m_Localized: "\u017Bycz\u0119 powodzenia!"
    m_Metadata:
      m_Items: []
  - m_Id: 24329307819073536
    m_Localized: "To nieprawda. Spr\xF3buj ponownie!"
    m_Metadata:
      m_Items: []
  - m_Id: 25849701587738642
    m_Localized: "Dobra robota, kolego! Uda\u0142o ci si\u0119 rozwi\u0105za\u0107
      zagadk\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 25849701587738643
    m_Localized: "Przyjmij m\xF3j skarb jako nagrod\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 25849701587738644
    m_Localized: "Ahoj! Nie uda\u0142o Ci si\u0119 rozwi\u0105za\u0107 zagadki."
    m_Metadata:
      m_Items: []
  - m_Id: 25862652839321600
    m_Localized: "Skrzynia pirata jest zamkni\u0119ta."
    m_Metadata:
      m_Items: []
  - m_Id: 26141442744246272
    m_Localized: "\u015Awietnie! Masz wszystkie sk\u0142adniki."
    m_Metadata:
      m_Items: []
  - m_Id: 129501256219615232
    m_Localized: "Marsylia to miasto po\u0142o\u017Cone na wybrze\u017Cu Morza \u015Ar\xF3dziemnego,
      w po\u0142udniowej Francji."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
