  m_SharedData: {fileID: 11400000, guid: 2646a6189b598490d897d5cb77e3095b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 125433798656
    m_Localized: "Bine a\u021Bi venit \xEEn ora\u0219ul Marsilia."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798657
    m_Localized: "Bun\u0103! Sunt brutar. V\xE2nd p\xE2ine \u0219i pr\u0103jituri."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798658
    m_Localized: "\xCEn fiecare zi, m\u0103 trezesc devreme s\u0103 coc p\xE2ine,
      s\u0103 preg\u0103tesc pr\u0103jituri \u0219i croissante."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798660
    m_Localized: "Bun\u0103 ziua!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798661
    m_Localized: "Mul\u021Bumesc!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798662
    m_Localized: "Banan\u0103!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798663
    m_Localized: "Ce vrei s\u0103 cumperi?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798664
    m_Localized: "P\xE2ine"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798665
    m_Localized: "Pe\u0219te \u0219i crab"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798666
    m_Localized: "Ro\u0219ii, portocale \u0219i l\u0103m\xE2i"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798667
    m_Localized: "Sare, piper \u0219i ulei"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798668
    m_Localized: "Acum trebuie s\u0103 pl\u0103ti\u021Bi pentru achizi\u021Biile
      dvs."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798669
    m_Localized: "Mul\u021Bumesc!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798670
    m_Localized: La revedere!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798671
    m_Localized: "Bun\u0103 ziua!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798673
    m_Localized: La revedere!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798674
    m_Localized: "Mul\u021Bumesc!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798675
    m_Localized: "Bun\u0103 ziua!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798677
    m_Localized: "Ce vrei s\u0103 cumperi?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798678
    m_Localized: "Pe\u0219te \u0219i crab"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798679
    m_Localized: "Ro\u0219ii, portocale \u0219i l\u0103m\xE2i"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798680
    m_Localized: "P\xE2ine"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798681
    m_Localized: Lapte
    m_Metadata:
      m_Items: []
  - m_Id: 125433798682
    m_Localized: Liceu!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798683
    m_Localized: "Bun\u0103 ziua!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798684
    m_Localized: La revedere!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798685
    m_Localized: "Bun\u0103 diminea\u021Ba! Sunt pesc\u0103resc \u0219i v\xE2nd pe\u0219te
      \u0219i crabi."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798686
    m_Localized: "Acum trebuie s\u0103 pl\u0103ti\u021Bi pentru achizi\u021Biile
      dvs."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798687
    m_Localized: "Mul\u021Bumesc!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798688
    m_Localized: "Bun\u0103 ziua!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798689
    m_Localized: Chat!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798690
    m_Localized: "Ce vrei s\u0103 cumperi?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798691
    m_Localized: Lapte
    m_Metadata:
      m_Items: []
  - m_Id: 125433798692
    m_Localized: "Sare, piper \u0219i ulei"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798693
    m_Localized: "P\xE2ine"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798694
    m_Localized: "Ro\u0219ii, portocale \u0219i l\u0103m\xE2i"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798695
    m_Localized: "Bun\u0103 ziua!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798696
    m_Localized: La revedere!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798697
    m_Localized: "Mul\u021Bumesc!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798698
    m_Localized: "Bun\u0103! Sunt produc\u0103tor de br\xE2nzeturi. V\xE2nd produse
      f\u0103cute cu lapte."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798699
    m_Localized: "V\xE2nd iaurt, br\xE2nz\u0103, unt \u0219i lapte."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798702
    m_Localized: "Bun\u0103 ziua!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798703
    m_Localized: "Mul\u021Bumesc!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798704
    m_Localized: La revedere!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798705
    m_Localized: "Ce vrei s\u0103 cumperi?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798706
    m_Localized: "Pe\u0219te \u0219i crab"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798707
    m_Localized: "P\xE2ine"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798708
    m_Localized: "Ro\u0219ii, portocale \u0219i l\u0103m\xE2i"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798709
    m_Localized: Lapte
    m_Metadata:
      m_Items: []
  - m_Id: 125433798710
    m_Localized: "Mul\u021Bumesc!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798711
    m_Localized: Tren!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798712
    m_Localized: "Bun\u0103 ziua!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798713
    m_Localized: "Bun\u0103! Sunt v\xE2nz\u0103tor de fructe \u0219i legume."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798714
    m_Localized: "V\xE2nd legume precum salat\u0103 verde, ro\u0219ii \u0219i morcovi.
      V\xE2nd fructe precum l\u0103m\xE2i, mere \u0219i banane."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798715
    m_Localized: La revedere!
    m_Metadata:
      m_Items: []
  - m_Id: 125433798716
    m_Localized: "Mul\u021Bumesc!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798717
    m_Localized: "Bun\u0103 ziua!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798719
    m_Localized: "Ce vrei s\u0103 cumperi?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798720
    m_Localized: "Ro\u0219ii, portocale \u0219i l\u0103m\xE2i"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798721
    m_Localized: "P\xE2ine"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798722
    m_Localized: Lapte
    m_Metadata:
      m_Items: []
  - m_Id: 125433798723
    m_Localized: "Sare, piper \u0219i ulei"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798724
    m_Localized: "Mul\u021Bumesc!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798725
    m_Localized: "Bun\u0103 ziua!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798726
    m_Localized: "Livr\u0103!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798727
    m_Localized: "Bun\u0103! Sunt b\u0103can. V\xE2nd condimente precum sare \u0219i
      piper. Dar v\xE2nd \u0219i alte ingrediente precum f\u0103in\u0103 \u0219i
      zah\u0103r."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798728
    m_Localized: "Po\u021Bi folosi produsele mele pentru multe re\u021Bete."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798729
    m_Localized: "Ahoi! Bine a\u021Bi venit la bord."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798730
    m_Localized: "Suntem pira\u021Bi."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798731
    m_Localized: "Pira\u021Bii au cor\u0103bii mari pentru a traversa m\u0103rile
      \u0219i oceanele."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798732
    m_Localized: "Cu mult timp \xEEn urm\u0103, pira\u021Bii c\u0103utau comori."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798733
    m_Localized: "Pira\u021Bii au atacat \u0219i alte nave. Au furat obiecte \u0219i
      bijuterii de pe nave."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798734
    m_Localized: "ca magazinele s\u0103 poat\u0103 r\u0103m\xE2ne deschise!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798735
    m_Localized: "Salut! Bine a\u021Bi venit \xEEn ora\u0219ul Marsilia. Merge\u021Bi
      la pia\u021B\u0103. Ve\u021Bi cump\u0103ra ingrediente pentru a prepara o sup\u0103
      de bouillabaisse. Bouillabaisse este o sup\u0103 tradi\u021Bional\u0103 de
      pe\u0219te."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798736
    m_Localized: "Vreau s\u0103-\u021Bi preg\u0103tesc o m\xE2ncare tradi\u021Bional\u0103
      din Marsilia. O bouillabaisse!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798737
    m_Localized: "Dar am nevoie de ajutorul t\u0103u ca s\u0103 merg s\u0103 cump\u0103r
      ingredientele."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798738
    m_Localized: "Du-te la pia\u021B\u0103 \u0219i adu-mi ingredientele pentru a
      preg\u0103ti o bouillabaisse."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798739
    m_Localized: "Spune \u201Esalut\u201D v\xE2nz\u0103torilor de la pia\u021B\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798740
    m_Localized: "Spune \u201Ela revedere\u201D c\xE2nd ai terminat de f\u0103cut
      cump\u0103r\u0103turi."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798741
    m_Localized: "Nu uita s\u0103 le spui \u201Emul\u021Bumesc\u201D v\xE2nz\u0103torilor."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798742
    m_Localized: "\xCEntoarce-te \u0219i urm\u0103re\u0219te-l pe buc\u0103tar cum
      g\u0103te\u0219te."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798743
    m_Localized: "Bravo! Ai reu\u0219it s\u0103 cumperi toate ingredientele."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798744
    m_Localized: "I-ai salutat pe to\u021Bi cu \u201Esalut\u201D. Le-ai mul\u021Bumit
      tuturor negustorilor cu \u201Emul\u021Bumesc\u201D."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798745
    m_Localized: "Acum, haide\u021Bi s\u0103 preg\u0103tim \xEEmpreun\u0103 re\u021Beta
      de boullabaise!"
    m_Metadata:
      m_Items: []
  - m_Id: 125437992960
    m_Localized: "Asocia\u021Bi fiecare produs alimentar cu v\xE2nz\u0103torul s\u0103u."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992961
    m_Localized: "Bravo! Ai reu\u0219it s\u0103 asociezi fiecare produs alimentar
      cu v\xE2nz\u0103torul s\u0103u."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992962
    m_Localized: "Acum, o s\u0103 preg\u0103tesc supa de pe\u0219te: bouillabaisse!"
    m_Metadata:
      m_Items: []
  - m_Id: 125437992963
    m_Localized: "Acum trebuie s\u0103 pl\u0103ti\u021Bi pentru achizi\u021Biile
      dvs."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992964
    m_Localized: "Acum trebuie s\u0103 pl\u0103ti\u021Bi pentru achizi\u021Biile
      dvs."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992965
    m_Localized: "Acum trebuie s\u0103 pl\u0103ti\u021Bi pentru achizi\u021Biile
      dvs."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992966
    m_Localized: "Acum trebuie s\u0103 pl\u0103ti\u021Bi pentru achizi\u021Biile
      dvs."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992970
    m_Localized: "Scuze, nu cred c\u0103 \xEEn\u021Beleg..."
    m_Metadata:
      m_Items: []
  - m_Id: 125437992971
    m_Localized: Ce?
    m_Metadata:
      m_Items: []
  - m_Id: 125437992972
    m_Localized: "\u0102\u0103?"
    m_Metadata:
      m_Items: []
  - m_Id: 125437992973
    m_Localized: "P\xE2ine"
    m_Metadata:
      m_Items: []
  - m_Id: 125437992974
    m_Localized: "Pe\u015Fte"
    m_Metadata:
      m_Items: []
  - m_Id: 125437992975
    m_Localized: Portocale
    m_Metadata:
      m_Items: []
  - m_Id: 125437992976
    m_Localized: "L\u0103m\xE2ie"
    m_Metadata:
      m_Items: []
  - m_Id: 125437992977
    m_Localized: "Ro\u0219ie"
    m_Metadata:
      m_Items: []
  - m_Id: 125437992978
    m_Localized: Lapte
    m_Metadata:
      m_Items: []
  - m_Id: 125437992979
    m_Localized: "Sare \u0219i piper"
    m_Metadata:
      m_Items: []
  - m_Id: 125437992981
    m_Localized: "Ulei de m\u0103sline"
    m_Metadata:
      m_Items: []
  - m_Id: 80762619944960
    m_Localized: "Completeaz\u0103 imaginea."
    m_Metadata:
      m_Items: []
  - m_Id: 83685710094336
    m_Localized: Am nevoie de mai multe ingrediente!
    m_Metadata:
      m_Items: []
  - m_Id: 83685710094337
    m_Localized: "Du-te s\u0103 vezi to\u021Bi v\xE2nz\u0103torii de la pia\u021B\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703168
    m_Localized: "\u021Ai-am pus cump\u0103r\u0103turile pe masa de l\xE2ng\u0103
      tine. Serve\u0219te-te!"
    m_Metadata:
      m_Items: []
  - m_Id: 845723419926528
    m_Localized: "Adun\u0103 toate ingredientele pentru re\u021Bet\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 845723419926530
    m_Localized: Crab
    m_Metadata:
      m_Items: []
  - m_Id: 862493363003393
    m_Localized: "\xCEmi pare r\u0103u, dar nu v\xE2nd asta."
    m_Metadata:
      m_Items: []
  - m_Id: 9169988422590464
    m_Localized: Buna ziua
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703181
    m_Localized: "Du-te \u0219i vezi ceilal\u021Bi v\xE2nz\u0103tori!"
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703179
    m_Localized: "Ai cump\u0103rat deja produse de la mine!"
    m_Metadata:
      m_Items: []
  - m_Id: 2381619980656640
    m_Localized: "Bravo! Ai reu\u0219it s\u0103 cumperi toate ingredientele pentru
      buc\u0103tar!"
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850944
    m_Localized: "Care este m\xE2ncarea ta preferat\u0103?"
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850945
    m_Localized: "Bun\u0103! Vizitez ora\u0219ul Marsilia."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850946
    m_Localized: "M\xE2ncarea de aici este uimitoare!"
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850947
    m_Localized: Iubesc marea!
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850948
    m_Localized: "E foarte pl\u0103cut s\u0103-\u021Bi faci cump\u0103r\u0103turile
      la pia\u021B\u0103!"
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850949
    m_Localized: "Bouillabaisse-ul este felul meu de m\xE2ncare preferat!"
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850950
    m_Localized: "Trebuie s\u0103 cump\u0103r ni\u0219te ingrediente proaspete."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850951
    m_Localized: "Po\u021Bi g\u0103si produse bune la pia\u021B\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850952
    m_Localized: "Pe\u0219tele este delicios."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850953
    m_Localized: "Abia a\u0219tept s\u0103 g\u0103tesc o mas\u0103 delicioas\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850954
    m_Localized: "\xCEn Fran\u021Ba \u0219i Europa, moneda se nume\u0219te euro.
      Exist\u0103 monede \u0219i bancnote."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850955
    m_Localized: "Ai dat suma corect\u0103 de bani. Bravo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850956
    m_Localized: "Pute\u021Bi pl\u0103ti cu monede \u0219i bancnote. Dar pute\u021Bi
      pl\u0103ti \u0219i cu cardul bancar."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850957
    m_Localized: "Supa Boullabaise con\u021Bine mult pe\u0219te."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850958
    m_Localized: "Ro\u0219ia este delicioas\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850959
    m_Localized: "Uleiul de m\u0103sline adaug\u0103 savoare preparatului."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850960
    m_Localized: "Uneori m\xE2nc\u0103m p\xE2ine cu sup\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850961
    m_Localized: "Un brutar coace p\xE2ine. De asemenea, preg\u0103te\u0219te croissante
      \u0219i pr\u0103jituri."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850962
    m_Localized: "Un pesc\u0103resc vinde pe\u0219te \u0219i crabi."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850963
    m_Localized: "Un negustor de br\xE2nzeturi vinde produse f\u0103cute cu lapte."
    m_Metadata:
      m_Items: []
  - m_Id: 2381619984850964
    m_Localized: "O b\u0103c\u0103nie vinde fructe \u0219i legume."
    m_Metadata:
      m_Items: []
  - m_Id: 6601427467100160
    m_Localized: "Ai cump\u0103rat deja p\xE2ine de la mine!"
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703176
    m_Localized: "Ai cump\u0103rat deja fructele!"
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703172
    m_Localized: "Ai cump\u0103rat deja laptele!"
    m_Metadata:
      m_Items: []
  - m_Id: 9168233005703170
    m_Localized: "Ai cump\u0103rat deja pe\u0219tele!"
    m_Metadata:
      m_Items: []
  - m_Id: 6601427496460292
    m_Localized: "Haide, haide! Trebuie s\u0103 m\u0103 preg\u0103tesc pentru urm\u0103toarea
      mea c\u0103l\u0103torie."
    m_Metadata:
      m_Items: []
  - m_Id: 6601427496460293
    m_Localized: "Trebuie s\u0103 pl\u0103te\u0219ti pentru cump\u0103r\u0103turi."
    m_Metadata:
      m_Items: []
  - m_Id: 24016153620766720
    m_Localized: "Ni\u0219te p\xE2ine"
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155328
    m_Localized: "Un pe\u0219te"
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155329
    m_Localized: "O portocal\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155330
    m_Localized: "O l\u0103m\xE2ie"
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155331
    m_Localized: "O ro\u0219ie"
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155332
    m_Localized: "Ni\u0219te lapte"
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155333
    m_Localized: "Ulei de m\u0103sline"
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155334
    m_Localized: "Sare \u015Fi piper"
    m_Metadata:
      m_Items: []
  - m_Id: 24016153629155335
    m_Localized: "\u0218i ia ingredientele pe care le cumperi."
    m_Metadata:
      m_Items: []
  - m_Id: 24018976370581505
    m_Localized: "Vrei s\u0103 te joci din nou?"
    m_Metadata:
      m_Items: []
  - m_Id: 24018976370581506
    m_Localized: Da
    m_Metadata:
      m_Items: []
  - m_Id: 24018976370581507
    m_Localized: Nu
    m_Metadata:
      m_Items: []
  - m_Id: 24018986583711744
    m_Localized: "Ast\u0103zi, vei explora pia\u021Ba. Vei cump\u0103ra ingrediente
      pentru a prepara un fel de m\xE2ncare tradi\u021Bional marsiliez. Bouillabaisse,
      o sup\u0103 de pe\u0219te."
    m_Metadata:
      m_Items: []
  - m_Id: 24019923897409548
    m_Localized: "Vrei s\u0103 juc\u0103m un joc?"
    m_Metadata:
      m_Items: []
  - m_Id: 24019923897409551
    m_Localized: Mult noroc!
    m_Metadata:
      m_Items: []
  - m_Id: 24329307819073536
    m_Localized: "Nu este corect. \xCEncearc\u0103 din nou!"
    m_Metadata:
      m_Items: []
  - m_Id: 25849701587738642
    m_Localized: Bravo, prietene! Ai rezolvat puzzle-ul.
    m_Metadata:
      m_Items: []
  - m_Id: 25849701587738643
    m_Localized: "Ia comoara mea drept recompens\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 25849701587738644
    m_Localized: Ahoi! Nu ai terminat puzzle-ul.
    m_Metadata:
      m_Items: []
  - m_Id: 25862652839321600
    m_Localized: "Cuf\u0103rul piratului este \xEEncuiat."
    m_Metadata:
      m_Items: []
  - m_Id: 26141442744246272
    m_Localized: Grozav! Ai toate ingredientele.
    m_Metadata:
      m_Items: []
  - m_Id: 129501256219615232
    m_Localized: "Marsilia este un ora\u0219 situat pe coasta Mediteranei, \xEEn
      sudul Fran\u021Bei."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
