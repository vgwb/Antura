  m_TableData:
  - m_Id: 125433798656
    m_Localized: Bienvenidos a la ciudad de Marsella.
    m_Metadata:
      m_Items: []
  - m_Id: 125433798657
    m_Localized: "\xA1Hola! Soy panadero. Vendo pan y pasteles."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798658
    m_Localized: "Todos los d\xEDas me levanto temprano para hornear pan, preparar
      pasteles y croissants."
    m_Metadata:
      m_Items: []
  - m_Id: 125433798660
    m_Localized: "\xA1Hola!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798661
    m_Localized: "\xA1Gracias!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798662
    m_Localized: "\xA1Banana!"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798663
    m_Localized: "\xBFQu\xE9 quieres comprar?"
    m_Metadata:
      m_Items: []
  - m_Id: 125433798664
    m_Localized: Pan
    m_Metadata:
      m_Items: []
  - m_Id: 125433798665
    m_Localized: Pescado y cangrejo
    m_Metadata:
      m_Items: []
  - m_Id: 125433798666
