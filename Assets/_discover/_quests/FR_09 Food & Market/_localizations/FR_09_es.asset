    m_Metadata:
      m_Items: []
  - m_Id: 125433798667
    m_Localized: Sal, pimienta y aceite
    m_Metadata:
      m_Items: []
  - m_Id: 125433798668
    m_Localized: Ahora debes pagar tus compras.
    m_Metadata:
