  m_TableData:
  - m_Id: 11589049033678863
    m_Localized: Tu as choisi 2
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678862
    m_Localized: Option 2
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678861
    m_Localized: Bon beurre
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678860
    m_Localized: Beurre!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678859
    m_Localized: "Troisi\xE8me ligne. Que veux-tu ?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678858
    m_Localized: "Deuxi\xE8me ligne"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678857
    m_Localized: BIENVENUE
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678856
    m_Localized: "Tu peux gagner un drapeau fran\xE7ais"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678855
    m_Localized: Tu as au moins 3 drapeaux de la France
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678854
    m_Localized: "Tu as un drapeau fran\xE7ais"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678853
    m_Localized: une autre ligne
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678852
    m_Localized: Tu as plus de 2 drapeaux de la France
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678851
    m_Localized: Essaye encore
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678850
    m_Localized: "Tu as bien particip\xE9 \xE0 l'activit\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678849
    m_Localized: "Tu peux utiliser cette qu\xEAte pour tester  le jeu."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678848
    m_Localized: "Bienvenue dans la qu\xEAte DEV !"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678864
    m_Localized: Option 3
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678865
    m_Localized: Tu as choisi 3
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678866
    m_Localized: Option 4
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678867
    m_Localized: Tu as choisi 4
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678868
    m_Localized: Et ceci est du poisson
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678869
    m_Localized: "Les poissons sont toujours l\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678870
    m_Localized: On adore !
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678871
    m_Localized: "Premi\xE8re ligne v1"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678872
    m_Localized: "Premi\xE8re ligne v2"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678873
    m_Localized: J'ai faim. Et si on mangeait quelque chose ?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678874
    m_Localized: Il me faut 3 baguettes !
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678875
    m_Localized: Tu n'as pas assez de baguettes !
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678876
    m_Localized: 'Mais tu as du poisson ! '
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678877
    m_Localized: Merci.
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678878
    m_Localized: "Tu as trouv\xE9 une baguette !"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678879
    m_Localized: "Un poisson en bonne sant\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678880
    m_Localized: Maintenant, je te laisse faire le tour.
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678881
    m_Localized: Maintenant, je te montre quelques cartes.
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678882
    m_Localized: "Regarde ces d\xE9tails, s'il te plait."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678883
    m_Localized: "Retourne au menu et fais d\xE9filer les cartes"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678884
    m_Localized: et maintenant...
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678885
    m_Localized: C'est bien, n'est-ce pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678886
    m_Localized: Retourne travailler maintenant.
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678887
    m_Localized: Veux-tu 5 biscuits ?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678888
    m_Localized: Oui
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678889
    m_Localized: "Voil\xE0 ! profite-en !"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678890
    m_Localized: Non
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678891
    m_Localized: D'accord, pas de cookies pour toi !
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678892
    m_Localized: Tu as beaucoup de biscuits !
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678893
    m_Localized: Maintenant, je te montre la carte du jeu
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678894
    m_Localized: Tu comprends ce que je veux dire ?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678895
    m_Localized: Regarde ce palais !
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678896
    m_Localized: C'est sympa, non ?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678897
    m_Localized: Action Pre "pre_actions" et action_post "post_actions"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678898
    m_Localized: Veux-tu ouvrir le coffre ?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678899
    m_Localized: Oui
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678900
    m_Localized: Non
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678901
    m_Localized: "Merci ! Tu as termin\xE9 cette t\xE2che."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678902
    m_Localized: J'ai besoin de plus de pommes !
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678903
    m_Localized: Ramasse 4 pommes !
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678904
    m_Localized: Bravo ! Retourne voir le robot
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678905
    m_Localized: Merci ! J'en avais besoin.
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678906
    m_Localized: Tends la main et ouvre ce coffre !
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678907
    m_Localized: Bravo ! tu as ouvert le coffre
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678908
    m_Localized: Un bon torse !
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678909
    m_Localized: "Tu veux venir \xE0 ma f\xEAte ?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678910
    m_Localized: Oui
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678911
    m_Localized: Maintenant, je te suis !
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678912
    m_Localized: Non
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678913
    m_Localized: d'accord
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678914
    m_Localized: "Veux changer de f\xEAte ?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678915
    m_Localized: Cercle de formation
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678916
    m_Localized: Ligne de formation
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678917
    m_Localized: Formation V
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678918
    m_Localized: "F\xEAte de lancement"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678919
    m_Localized: Calcule 3*2
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678920
    m_Localized: quatre
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678921
    m_Localized: six
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678922
    m_Localized: huit
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678923
    m_Localized: OUI ! Exact.
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678924
    m_Localized: "Non, veux-tu r\xE9essayer ?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678925
    m_Localized: Oui
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678926
    m_Localized: Non
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678927
    m_Localized: "Tu peux terminer cette qu\xEAte avec ..."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678928
    m_Localized: "NON, je ne veux pas arr\xEAter."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678929
    m_Localized: "OUI, on arr\xEAte"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678930
    m_Localized: C'est le dernier message ! Au revoir
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678931
    m_Localized: Salut, Stefano
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678932
    m_Localized: Tu aimes les photos ?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678933
    m_Localized: Tu veux une orange ?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678934
    m_Localized: Tu veux de l'huile ?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678935
    m_Localized: Oh, aide-moi
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678936
    m_Localized: "Ordre d'activit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678937
    m_Localized: Suona sfx
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678938
    m_Localized: Apri Baule
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678939
    m_Localized: "Activit\xE9 termin\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678940
    m_Localized: Je vais maintenant activer l'objet de jeu test_setactive
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678941
    m_Localized: "Et maintenant, je vais l'\xE9teindre."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678942
    m_Localized: Sympa, non ?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678943
    m_Localized: Bonjour
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678944
