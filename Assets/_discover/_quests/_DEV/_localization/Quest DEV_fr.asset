    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678945
    m_Localized: Bien
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678946
    m_Localized: "C'est bon \xE0 savoir."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678947
    m_Localized: Mauvais
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678948
    m_Localized: "Oh, je suis d\xE9sol\xE9 d'apprendre cela."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678949
    m_Localized: Neutre
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678950
    m_Localized: "Je vois, j'esp\xE8re que \xE7a ira mieux bient\xF4t."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678951
