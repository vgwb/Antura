%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Quest DEV_hu
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: hu
  m_SharedData: {fileID: 11400000, guid: c9a54610c4a764de8b197884c5597762, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 11589049033678860
    m_Localized: Vaj!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678859
    m_Localized: Harmadik sor. Mit akarsz?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678858
    m_Localized: "M\xE1sodik vonal"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678857
    m_Localized: "\xDCDV\xD6Z\xD6LJ\xDCK"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678856
    m_Localized: "Begy\u0171jthetsz egy francia z\xE1szl\xF3t"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678855
    m_Localized: "Legal\xE1bb 3 francia z\xE1szl\xF3d van"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678854
    m_Localized: "Van egy francia z\xE1szl\xF3d"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678853
    m_Localized: "egy m\xE1sik sor"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678852
    m_Localized: "T\xF6bb mint 2 francia z\xE1szl\xF3d van"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678851
    m_Localized: "Pr\xF3b\xE1ld \xFAjra."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678850
    m_Localized: "J\xF3l j\xE1tszottad el a feladatot!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678849
    m_Localized: "Ezzel a k\xFCldet\xE9ssel tesztelheted a funkci\xF3kat \xE9s a
      parancsokat."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678848
    m_Localized: "\xDCdv\xF6zl\xFCnk a fejleszt\u0151i k\xFCldet\xE9sben!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678861
    m_Localized: "J\xF3 vaj"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678862
    m_Localized: "2. lehet\u0151s\xE9g"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678863
    m_Localized: "2-t v\xE1lasztott\xE1l"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678864
    m_Localized: "3. lehet\u0151s\xE9g"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678865
    m_Localized: "3-at v\xE1lasztott\xE1l"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678866
    m_Localized: "4. lehet\u0151s\xE9g"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678867
    m_Localized: "4-et v\xE1lasztott\xE1l"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678868
    m_Localized: "\xC9s ez egy hal"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678869
    m_Localized: "a hal m\xE9g mindig itt van"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678870
    m_Localized: "Tetszik nek\xFCnk!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678871
    m_Localized: "Els\u0151 sor v1"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678872
    m_Localized: "Els\u0151 sor v2"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678873
    m_Localized: "\xC9hes vagyok. Mit sz\xF3ln\xE1l egy kis \xE9telhez?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678874
    m_Localized: "3 bagettre van sz\xFCks\xE9gem!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678875
    m_Localized: "Nincs el\xE9g bagetted!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678876
    m_Localized: "De van n\xE1lad hal!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678877
    m_Localized: "K\xF6sz\xF6n\xF6m."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678878
    m_Localized: "Tal\xE1lt\xE1l egy bagettet!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678879
    m_Localized: "Eg\xE9szs\xE9ges hal!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678880
    m_Localized: "Most m\xE1r k\xF6rbeengedlek."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678881
    m_Localized: "Most mutatok neked p\xE1r k\xE1rty\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678882
    m_Localized: "K\xE9rlek, n\xE9zd meg a r\xE9szleteit"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678883
    m_Localized: "menj vissza a men\xFCbe \xE9s b\xF6ng\xE9szd \xE1t a k\xE1rty\xE1kat"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678884
    m_Localized: "\xE9s most..."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678885
    m_Localized: "J\xF3, ugye?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678886
    m_Localized: MENJ vissza dolgozni most.
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678887
    m_Localized: "K\xE9rsz \u200B\u200B5 s\xFCtit?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678888
    m_Localized: Igen
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678889
    m_Localized: "Itt vagy! J\xF3 sz\xF3rakoz\xE1st!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678890
    m_Localized: Nem
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678891
    m_Localized: "Ok\xE9, neked nem s\xFCtiket!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678892
    m_Localized: "Sok s\xFCtid van!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678893
    m_Localized: "Most megmutatom a j\xE1tsz\xF3t\xE9r t\xE9rk\xE9p\xE9t"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678894
    m_Localized: "L\xE1tod ezt a pontot?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678895
    m_Localized: "Most n\xE9zd meg azt a palot\xE1t!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678896
    m_Localized: "Sz\xE9p, nem igaz?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678897
    m_Localized: "Akci\xF3 el\u0151tti \u201Eel\u0151_m\u0171veletek\u201D \xE9s
      akci\xF3 ut\xE1ni \u201Em\u0171veletek ut\xE1ni\u201D m\u0171veletek"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678898
    m_Localized: "Ki akarod nyitni a L\xE1dik\xE1t?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678899
    m_Localized: Igen
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678900
    m_Localized: Nem
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678901
    m_Localized: "K\xF6sz\xF6n\xF6m! Befejezted ezt a feladatot"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678902
    m_Localized: "T\xF6bb alm\xE1ra van sz\xFCks\xE9gem!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678903
    m_Localized: "Gy\u0171jts \xF6ssze 4 alm\xE1t!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678904
    m_Localized: "Sz\xE9p munka! Menj vissza a robothoz!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678905
    m_Localized: "K\xF6sz\xF6n\xF6m! Erre volt sz\xFCks\xE9gem"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678906
    m_Localized: "Ny\xFAlj ki \xE9s nyisd ki azt a mellkast!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678907
    m_Localized: "Sz\xE9p munka! Kinyitottad a l\xE1d\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678908
    m_Localized: "J\xF3 mellkas!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678909
    m_Localized: Csatlakozni akarsz a bulihoz?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678910
    m_Localized: Igen
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678911
    m_Localized: "Most \xE9n k\xF6vetlek t\xE9ged!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678912
    m_Localized: Nem
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678913
    m_Localized: Rendben
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678914
    m_Localized: "P\xE1rtot akarsz v\xE1ltani?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678915
    m_Localized: "Form\xE1ci\xF3s k\xF6r"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678916
    m_Localized: "Form\xE1ci\xF3s vonal"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678917
    m_Localized: "V. form\xE1ci\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678918
    m_Localized: "Kiad\xF3i buli"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678919
    m_Localized: "Sz\xE1m\xEDtsa ki a 3*2-t"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678920
    m_Localized: "n\xE9gy"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678921
    m_Localized: hat
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678922
    m_Localized: nyolc
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678923
    m_Localized: IGEN! Helyes.
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678924
    m_Localized: "Nem. Megpr\xF3b\xE1lja \xFAjra?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678925
    m_Localized: Igen
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678926
    m_Localized: Nem
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678927
    m_Localized: "Befejezheted ezt a k\xFCldet\xE9st a k\xF6vetkez\u0151vel..."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678928
    m_Localized: "NEEE, nem akarom, hogy v\xE9ge legyen"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678929
    m_Localized: "IGEN, fejezz\xFCk be"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678930
    m_Localized: "Ez az utols\xF3 \xFCzenet! Viszl\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678931
    m_Localized: szia, stefano
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678932
    m_Localized: "szereted a fot\xF3t?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678933
    m_Localized: vuoi arany?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678934
    m_Localized: vuoi olaj?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678935
    m_Localized: "\xD3ra Chiudo"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678936
    m_Localized: "Tev\xE9kenys\xE9g sorrendje"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678937
    m_Localized: Suona sfx
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678938
    m_Localized: Apri Baule
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678939
    m_Localized: "Tev\xE9kenys\xE9g befejezve."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678940
    m_Localized: "Most aktiv\xE1lom a gameObject test_setactive objektumot."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678941
    m_Localized: "\xC9s most kikapcsolom"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678942
    m_Localized: "Sz\xE9p, nem igaz?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678943
    m_Localized: "Hall\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678944
    m_Localized: Hogy vagy?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678945
    m_Localized: "J\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678946
    m_Localized: "J\xF3 ezt hallani"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678947
    m_Localized: Rossz
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678948
    m_Localized: "\xD3, sajn\xE1lom, hogy ezt hallom"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678949
    m_Localized: Semleges
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678950
    m_Localized: "\xC9rtem, rem\xE9lem hamarosan jobb lesz"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678951
    m_Localized: "Mit akarsz csin\xE1lni az \xE9rm\xE9kkel?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678952
    m_Localized: "Mit szeretn\xE9l csin\xE1lni {0} \xE9rm\xE9vel?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678953
    m_Localized: "Nyisd ki az ajt\xF3t"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678954
    m_Localized: "Az ajt\xF3 nyitva van"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678955
    m_Localized: Otthon marad
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678956
    m_Localized: Otthon maradsz
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678957
    m_Localized: "Az ajt\xF3 nyitva van"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678958
    m_Localized: "Az ajt\xF3 z\xE1rva van"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678959
    m_Localized: "Egy\xE9ni jegyzet"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678960
    m_Localized: "ez hasznos jegyzetek hagy\xE1s\xE1ra a szerkeszt\u0151knek"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678961
    m_Localized: "mint eml\xE9keztet\u0151k a tennival\xF3kra"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678962
    m_Localized: "vagy ellen\u0151rizend\u0151 dolgok"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678963
    m_Localized: "vagy jav\xEDtand\xF3 dolgok"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678964
    m_Localized: "bel\xE9p\xE9s a h\xE1zba"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678965
    m_Localized: "Adok neked 100 \xE9rm\xE9t."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678966
    m_Localized: Boldog hangulat
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678967
    m_Localized: "Intelligens v\xE9letlenszer\u0171 1. sor"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678968
    m_Localized: "Intelligens v\xE9letlenszer\u0171 2. sor"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678969
    m_Localized: "Intelligens v\xE9letlenszer\u0171 3. sor"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678970
    m_Localized: Ez az 1. tipp
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678971
    m_Localized: Ez a 2. tipp
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678972
    m_Localized: 3. tipp
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678973
    m_Localized: "Aktivit\xE1s V\xC1SZON!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678974
    m_Localized: "J\xF3l j\xE1tszott\xE1l a CANVAS feladattal!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678975
    m_Localized: "Pr\xF3b\xE1ld \xFAjra."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678976
    m_Localized: "Aktivit\xE1s KIRAK\xD3S!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678977
    m_Localized: "J\xF3l j\xE1tszott\xE1l a KIRAK\xD3S j\xE1t\xE9kkal!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678978
    m_Localized: "Pr\xF3b\xE1ld \xFAjra."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678979
    m_Localized: "Tev\xE9kenys\xE9g MEM\xD3RIA!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678980
    m_Localized: "J\xF3l j\xE1tszottad a MEM\xD3RIA feladatot!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678981
    m_Localized: "Pr\xF3b\xE1ld \xFAjra."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678982
    m_Localized: "Aktivit\xE1s-egyez\xE9s!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678983
    m_Localized: "J\xF3l j\xE1tszottad a MATCH feladatot!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678984
    m_Localized: "Pr\xF3b\xE1ld \xFAjra."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678985
    m_Localized: "Aktivit\xE1s P\xC9NZ!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678986
    m_Localized: "J\xF3l j\xE1tszott\xE1l P\xC9NZES j\xE1t\xE9kkal!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678987
    m_Localized: "Pr\xF3b\xE1ld \xFAjra."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678988
    m_Localized: "Tev\xE9kenys\xE9g RENDEL\xC9S!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678989
    m_Localized: "J\xF3l j\xE1tszottad a RENDEL\xC9S feladatot!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678990
    m_Localized: "Pr\xF3b\xE1ld \xFAjra."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678991
    m_Localized: "J\xE1tsszd le ezt a zongoradallamot!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678992
    m_Localized: "J\xF3l j\xE1tszottad a zongora feladatot!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678993
    m_Localized: "Pr\xF3b\xE1ld \xFAjra."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
