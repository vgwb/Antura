  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Quest DEV_ro
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ro
  m_SharedData: {fileID: 11400000, guid: c9a54610c4a764de8b197884c5597762, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 11589049033678860
    m_Localized: Unt!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678859
    m_Localized: A treia linie. Ce vrei?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678858
    m_Localized: A doua linie
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678857
    m_Localized: BUN VENIT
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678856
    m_Localized: "Po\u021Bi colec\u021Biona un steag al Fran\u021Bei"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678855
    m_Localized: "Ai cel pu\u021Bin 3 steaguri ale Fran\u021Bei"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678854
    m_Localized: "Ai un steag al Fran\u021Bei"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678853
    m_Localized: "o alt\u0103 linie"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678852
    m_Localized: "Ai mai mult de 2 steaguri ale Fran\u021Bei"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678851
    m_Localized: "\xCEncearc\u0103 din nou."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678850
    m_Localized: Ai jucat bine activitatea!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678849
    m_Localized: "Po\u021Bi folosi aceast\u0103 misiune pentru a testa func\u021Bii
      \u0219i comenzi."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678848
    m_Localized: "Bun venit \xEEn misiunea DEV!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678861
    m_Localized: Unt bun
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678862
    m_Localized: "Op\u021Biunea 2"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678863
    m_Localized: Ai ales 2
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678864
    m_Localized: "Op\u021Biunea 3"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678865
    m_Localized: Ai ales 3
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678866
    m_Localized: "Op\u021Biunea 4"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678867
    m_Localized: Ai ales 4
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678868
    m_Localized: "\u0218i acesta este pe\u0219te"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678869
    m_Localized: "Pe\u0219tele este \xEEnc\u0103 aici"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678870
    m_Localized: Ne place!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678871
    m_Localized: Prima linie v1
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678872
    m_Localized: Prima linie v2
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678873
    m_Localized: "Mi-e foame. Ce zici de ni\u0219te m\xE2ncare?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678874
    m_Localized: Am nevoie de 3 baghete!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678875
    m_Localized: Nu ai destule baghete!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678876
    m_Localized: "Dar ai ni\u0219te pe\u0219ti!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678877
    m_Localized: "Mul\u021Bumesc."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678878
    m_Localized: "Ai g\u0103sit o baghet\u0103!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678879
    m_Localized: "Un pe\u0219te s\u0103n\u0103tos!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678880
    m_Localized: "Acum te las s\u0103 pleci."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678881
    m_Localized: "Acum v\u0103 ar\u0103t ni\u0219te c\u0103r\u021Bi"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678882
    m_Localized: "V\u0103 rug\u0103m s\u0103 consulta\u021Bi detaliile sale"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678883
    m_Localized: "\xCEntoarce-te la meniu \u0219i r\u0103sfoie\u0219te cardurile"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678884
    m_Localized: "\u0219i acum..."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678885
    m_Localized: "Bun, nu-i a\u0219a?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678886
    m_Localized: "\xCEntoarce-te la munc\u0103 acum."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678887
    m_Localized: Vrei 5 fursecuri?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678888
    m_Localized: Da
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678889
    m_Localized: "Poftim! Distrac\u021Bie pl\u0103cut\u0103!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678890
    m_Localized: Nu
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678891
    m_Localized: "Ok, f\u0103r\u0103 cookie-uri pentru tine!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678892
    m_Localized: "Ai o mul\u021Bime de fursecuri!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678893
    m_Localized: "Acum v\u0103 ar\u0103t harta locului de joac\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678894
    m_Localized: "\xCEn\u021Belegi acest aspect?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678895
    m_Localized: "Acum uit\u0103-te la palatul acela!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678896
    m_Localized: "Frumos, nu-i a\u0219a?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678897
    m_Localized: "Ac\u021Biune Pre \u201Epre_actions\u201D \u0219i ac\u021Biune_post
      \u201Epost_actions\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678898
    m_Localized: "Vrei s\u0103 deschizi Cuf\u0103rul?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678899
    m_Localized: Da
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678900
    m_Localized: Nu
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678901
    m_Localized: "Mul\u021Bumesc! Ai terminat aceast\u0103 sarcin\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678902
    m_Localized: Am nevoie de mai multe mere!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678903
    m_Localized: "Colecteaz\u0103 4 mere!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678904
    m_Localized: "Bravo! \xCEntoarce-te la robot."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678905
    m_Localized: "Mul\u021Bumesc! Aveam nevoie de asta."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678906
    m_Localized: "\xCEntinde m\xE2na \u0219i deschide cuf\u0103rul acela!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678907
    m_Localized: "Bravo! Ai deschis cuf\u0103rul."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678908
    m_Localized: Un piept bun!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678909
    m_Localized: "Vrei s\u0103 te al\u0103turi petrecerii mele?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678910
    m_Localized: Da
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678911
    m_Localized: "Acum te urm\u0103resc!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678912
    m_Localized: Nu
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678913
    m_Localized: Bine
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678914
    m_Localized: "Vrei s\u0103 schimbi partidul?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678915
    m_Localized: Cercul de formare
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678916
    m_Localized: "Linia de forma\u021Bie"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678917
    m_Localized: "Forma\u021Biunea V"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678918
    m_Localized: Petrecerea de lansare
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678919
    m_Localized: "Calcula\u021Bi 3 * 2"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678920
    m_Localized: patru
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678921
    m_Localized: "\u015Fase"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678922
    m_Localized: opt
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678923
    m_Localized: DA! Corect.
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678924
    m_Localized: "Nu. Vrei s\u0103 \xEEncerci din nou?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678925
    m_Localized: Da
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678926
    m_Localized: Nu
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678927
    m_Localized: "Po\u021Bi \xEEncheia aceast\u0103 misiune cu..."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678928
    m_Localized: "NU, nu vreau s\u0103 se termine"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678929
    m_Localized: "DA, s\u0103 \xEEncheiem"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678930
    m_Localized: Acesta este ultimul mesaj! La revedere
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678931
    m_Localized: Ciao, Stefano
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678932
    m_Localized: "\xEE\u021Bi plac fotografiile?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678933
    m_Localized: vrei arancia?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678934
    m_Localized: vrei ulei?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678935
    m_Localized: "or\u0103 \xEEnchis\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678936
    m_Localized: "Ordinea activit\u0103\u021Bii"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678937
    m_Localized: Suona sfx
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678938
    m_Localized: Apri Baule
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678939
    m_Localized: "Activitate terminat\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678940
    m_Localized: Acum voi activa gameObject test_setactive
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678941
    m_Localized: "\u0218i acum \xEEl voi opri"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678942
    m_Localized: "Frumos, nu-i a\u0219a?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678943
    m_Localized: Salut
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678944
    m_Localized: Ce mai faci?
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678945
    m_Localized: Bun
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678946
    m_Localized: "M\u0103 bucur s\u0103 aud asta"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678947
    m_Localized: "R\u0103u"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678948
    m_Localized: "\xCEmi pare r\u0103u s\u0103 aud asta"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678949
    m_Localized: Neutru
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678950
    m_Localized: "\xCEn\u021Beleg, sper s\u0103 se \xEEmbun\u0103t\u0103\u021Beasc\u0103
      cur\xE2nd."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678951
    m_Localized: "Ce vrei s\u0103 faci cu monedele?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678952
    m_Localized: "Ce vrei s\u0103 faci cu {0} monede?"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678953
    m_Localized: "Deschide u\u0219a"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678954
    m_Localized: "U\u0219a este deschis\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678955
    m_Localized: "Stai acas\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678956
    m_Localized: "Stai acas\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678957
    m_Localized: "U\u0219a este deschis\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678958
    m_Localized: "U\u0219a este \xEEnchis\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678959
    m_Localized: "Not\u0103 personalizat\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678960
    m_Localized: "Acest lucru este util pentru a l\u0103sa note pentru editori"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678961
    m_Localized: "ca ni\u0219te mementouri despre lucruri de f\u0103cut"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678962
    m_Localized: sau lucruri de verificat
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678963
    m_Localized: sau lucruri de reparat
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678964
    m_Localized: "intrare \xEEn cas\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678965
    m_Localized: "\xCE\u021Bi dau 100 de monede."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678966
    m_Localized: "Dispozi\u021Bie fericit\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678967
    m_Localized: "Linia 1 aleatorie inteligent\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678968
    m_Localized: "Linia aleatorie inteligent\u0103 2"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678969
    m_Localized: "Linia aleatorie inteligent\u0103 3"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678970
    m_Localized: Acesta este indiciul 1
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678971
    m_Localized: Acesta este indiciul 2
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678972
    m_Localized: Indiciu 3
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678973
    m_Localized: Activitate CANVAS!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678974
    m_Localized: Ai jucat bine activitatea CANVAS!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678975
    m_Localized: "\xCEncearc\u0103 din nou."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678976
    m_Localized: Activitate PUZZLE JIGSAW!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678977
    m_Localized: Ai jucat bine activitatea JIGSAW PUZZLE!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678978
    m_Localized: "\xCEncearc\u0103 din nou."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678979
    m_Localized: Activitate MEMORIE!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678980
    m_Localized: Ai jucat bine activitatea de MEMORIE!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678981
    m_Localized: "\xCEncearc\u0103 din nou."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678982
    m_Localized: "POTRIVIRE de activit\u0103\u021Bi!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678983
    m_Localized: Ai jucat bine activitatea MATCH!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678984
    m_Localized: "\xCEncearc\u0103 din nou."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678985
    m_Localized: Activitate BANI!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678986
    m_Localized: Ai jucat bine activitatea MONEY!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678987
    m_Localized: "\xCEncearc\u0103 din nou."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678988
    m_Localized: "Activitate COMAND\u0102!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678989
    m_Localized: "Ai jucat bine activitatea COMAND\u0102!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678990
    m_Localized: "\xCEncearc\u0103 din nou."
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678991
    m_Localized: "C\xE2nt\u0103 aceast\u0103 melodie la pian!"
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678992
    m_Localized: Ai jucat bine activitatea la PIAN!
    m_Metadata:
      m_Items: []
  - m_Id: 11589049033678993
    m_Localized: "\xCEncearc\u0103 din nou."
    m_Metadata:
      m_Items: []
