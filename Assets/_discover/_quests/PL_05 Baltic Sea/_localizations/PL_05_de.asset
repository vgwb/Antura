  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PL_05_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 1f123f384babc4d4dba78c64971dc3d2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2387309876994048
    m_Localized: "Willkommen bei GDA\u0143SK in POLEN."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994049
    m_Localized: Der LEUCHTTURM ist aus.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994050
    m_Localized: Lasst es uns reparieren!
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994051
    m_Localized: Diese Quest ist abgeschlossen.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994052
    m_Localized: "Zeichne eine H\xDCLLE."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994053
    m_Localized: "Wir brauchen ein Geschenk f\xFCr Neptun."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994054
    m_Localized: Bastle eine Halskette.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994055
    m_Localized: 5 Bernstein + 5 Muscheln.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994056
    m_Localized: Dies ist die Ostsee.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994057
    m_Localized: Lasst uns Muscheln im Sand suchen.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994058
    m_Localized: Ziehen Sie, um den SAND zu entfernen.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994059
    m_Localized: Finde 5 Muschelhaufen.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994060
    m_Localized: Geh nun und triff den FISCHER
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994061
    m_Localized: Hallo. Ich bin ein FISCHER.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994062
    m_Localized: "Das ist mein Schneideger\xE4t und mein Netz."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994063
    m_Localized: Lasst uns auch AMBER finden.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994064
    m_Localized: Bernstein ist baltisches Gold.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994065
    m_Localized: Reinige den SAND, um 5 zu finden.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994066
    m_Localized: "Gro\xDFartige Leistung, AMBER zu finden!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994067
    m_Localized: Jetzt gehen wir zum LEUCHTTURM.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994068
    m_Localized: Ein Leuchtturm hilft Schiffen.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994069
    m_Localized: Es strahlt ein helles Licht aus.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994070
    m_Localized: Die Reparatur des Leuchtturms war hervorragend!
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994071
    m_Localized: Nun basteln wir die HALSKETTE.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994072
    m_Localized: "Wir haben 10 St\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994073
    m_Localized: Bernstein und Muschelschale.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994074
    m_Localized: Erstelle ein Muster.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994076
    m_Localized: AMBER SHELL wiederholen.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994077
    m_Localized: Die Halskette ist dir hervorragend gelungen!
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994078
    m_Localized: Nun zu NEPTUNS BRUNNEN
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994079
    m_Localized: Lege die Halskette auf Neptun.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994080
    m_Localized: "Eine wundersch\xF6ne Halskette!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994081
    m_Localized: Du respektierst das Meer.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994082
    m_Localized: Ich werde dir helfen.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994083
    m_Localized: "AMBER ist hier ber\xFChmt."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994084
    m_Localized: Wie die Geschichte von AMBER ROOM.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994085
    m_Localized: Blitz! Der Leuchtturm erstrahlt.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994086
    m_Localized: Super gemacht!
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994087
    m_Localized: und haltet nach SEALs Ausschau
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994088
    m_Localized: Das sind wilde Robben.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994089
    m_Localized: Halten Sie einen sicheren Abstand.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994090
    m_Localized: Ja! Die Mission ist abgeschlossen!
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994091
    m_Localized: "W\xF6rter \xFCberpr\xFCfen"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994092
    m_Localized: "Ordnen Sie die W\xF6rter einander zu."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994093
    m_Localized: Gut gemacht!
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994094
    m_Localized: Nun zum Abschlussquiz
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994095
    m_Localized: Beantworten Sie drei Fragen.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994096
    m_Localized: "W\xE4hlen Sie die beste Option."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994097
    m_Localized: "Welches Meer liegt in der N\xE4he von GDA\u0143SK?"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994098
    m_Localized: OSTSEE
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994099
    m_Localized: SCHWARZES MEER
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994100
    m_Localized: Nicht der. Versuch es nochmal!
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994101
    m_Localized: Was ist baltisches Gold?
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994102
    m_Localized: BERNSTEIN
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994103
    m_Localized: SAND
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994104
    m_Localized: Nicht Sand. Versuchen Sie es erneut!
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994105
    m_Localized: Was macht ein Leuchtturm?
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994106
    m_Localized: Hilft SCHIFFEN
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994107
    m_Localized: "F\xE4ngt Fische"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994108
    m_Localized: Nein. Es leitet Schiffe. Versuchen Sie es erneut!
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994109
    m_Localized: "Sie haben GDA\u0143SK geholfen."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994110
    m_Localized: Der LEUCHTTURM erstrahlt wieder!
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994111
    m_Localized: "Ich habe einmal ein gro\xDFes Schiff gesehen."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994112
    m_Localized: Die Wellen spritzen schnell.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994113
    m_Localized: Ein alter Kran hebt schwere Lasten.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994114
    m_Localized: Helles Licht weist Booten den Weg.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994115
    m_Localized: "Hier m\xFCndet der Fluss ins Meer."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994116
    m_Localized: Im Hafen herrscht heute reger Betrieb.
    m_Metadata:
      m_Items: []
  - m_Id: 2387317279940608
    m_Localized: In der richtigen Reihenfolge anordnen.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
