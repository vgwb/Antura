  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PL_05_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 1f123f384babc4d4dba78c64971dc3d2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2387309876994048
    m_Localized: "Bienvenidos a Gda\u0143sk en Polonia."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994049
    m_Localized: "El faro est\xE1 apagado."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994050
    m_Localized: "\xA1Vamos a arreglarlo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994051
    m_Localized: "Esta misi\xF3n ha finalizado."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994052
    m_Localized: Dibuja una concha.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994053
    m_Localized: Necesitamos un regalo para Neptuno.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994054
    m_Localized: Haz un COLLAR.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994055
    m_Localized: "5 \xC1MBAR + 5 CONCHAS."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994056
    m_Localized: "Este es el MAR B\xC1LTICO."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994057
    m_Localized: Busquemos conchas en la arena.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994058
    m_Localized: Arrastra para limpiar la ARENA.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994059
    m_Localized: Encuentra 5 montones de conchas.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994060
    m_Localized: Ahora ve a conocer al PESCADOR
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994061
    m_Localized: Hola. Soy pescador.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994062
    m_Localized: Esta es mi CORTADORA y mi RED.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994063
    m_Localized: "Busquemos tambi\xE9n a \xC1MBAR."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994064
    m_Localized: "El \xE1mbar es oro b\xE1ltico."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994065
    m_Localized: Limpia la ARENA para encontrar 5.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994066
    m_Localized: "\xA1Buen trabajo encontrando a \xC1MBAR!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994067
    m_Localized: Ahora vayamos al FARO.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994068
    m_Localized: Un faro ayuda a los barcos.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994069
    m_Localized: Emite una luz brillante.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994070
    m_Localized: "\xA1Excelente trabajo arreglando el faro!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994071
    m_Localized: Ahora vamos a crear el COLLAR.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994072
    m_Localized: Tenemos 10 piezas.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994073
    m_Localized: "\xC1MBAR y CONCHA."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994074
    m_Localized: "Haz un patr\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994076
    m_Localized: "\xC1MBARGO repetido."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994077
    m_Localized: "\xA1Excelente trabajo al crear el COLLAR!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994078
    m_Localized: Ahora vamos a la FUENTE DE NEPTUNO.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994079
    m_Localized: Coloca el COLLAR en NEPTUNO.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994080
    m_Localized: "\xA1Un collar precioso!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994081
    m_Localized: Usted respeta el mar.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994082
    m_Localized: "Te ayudar\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994083
    m_Localized: "Amber es famosa aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994084
    m_Localized: "Como la historia de la HABITACI\xD3N \xC1MBAR."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994085
    m_Localized: "\xA1FLASH! El FARO brilla."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994086
    m_Localized: "\xA1Buen trabajo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994087
    m_Localized: "y est\xE9n atentos a los SEAL"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994088
    m_Localized: Estas son focas salvajes.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994089
    m_Localized: "Mant\xE9n una distancia segura."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994090
    m_Localized: "\xA1S\xED! \xA1La misi\xF3n est\xE1 completada!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994091
    m_Localized: Palabras de repaso
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994092
    m_Localized: Une las palabras.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994093
    m_Localized: "\xA1Bien hecho!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994094
    m_Localized: Ahora, la prueba final.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994095
    m_Localized: Responda a tres preguntas.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994096
    m_Localized: "Toca la mejor opci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994097
    m_Localized: "\xBFQu\xE9 mar hay cerca de Gda\u0143sk?"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994098
    m_Localized: "MAR B\xC1LTICO"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994099
    m_Localized: MAR NEGRO
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994100
    m_Localized: "Esa no. \xA1Int\xE9ntalo de nuevo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994101
    m_Localized: "\xBFQu\xE9 es BALTIC GOLD?"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994102
    m_Localized: "\xC1MBAR"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994103
    m_Localized: ARENA
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994104
    m_Localized: "No es arena. \xA1Int\xE9ntalo de nuevo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994105
    m_Localized: "\xBFQu\xE9 funci\xF3n tiene un FARO?"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994106
    m_Localized: Ayuda a los barcos
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994107
    m_Localized: Atrapa peces
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994108
    m_Localized: "No. Gu\xEDa a los BARCOS. \xA1Int\xE9ntalo de nuevo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994109
    m_Localized: "Ayudaste a GDA\u0143SK."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994110
    m_Localized: "\xA1El FARO vuelve a brillar!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994111
    m_Localized: Una vez vi un gran BARCO.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994112
    m_Localized: "Las olas salpican r\xE1pidamente."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994113
    m_Localized: "Una vieja gr\xFAa levanta cargas pesadas."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994114
    m_Localized: "Una luz brillante gu\xEDa a los barcos."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994115
    m_Localized: "Aqu\xED el r\xEDo se encuentra con el mar."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994116
    m_Localized: "El puerto est\xE1 muy concurrido hoy."
    m_Metadata:
      m_Items: []
  - m_Id: 2387317279940608
    m_Localized: Arrastrar en orden.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
