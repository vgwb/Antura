  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PL_05_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 1f123f384babc4d4dba78c64971dc3d2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2387309876994048
    m_Localized: "Bienvenue \xE0 GDA\u0143SK en POLOGNE."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994049
    m_Localized: "Le PHARE est \xE9teint."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994050
    m_Localized: "R\xE9parons \xE7a !"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994051
    m_Localized: "Cette qu\xEAte est termin\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994052
    m_Localized: Dessinez une COQUILLE.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994053
    m_Localized: Il nous faut un cadeau pour Neptune.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994054
    m_Localized: Fabriquez un COLLIER.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994055
    m_Localized: 5 AMBRE + 5 COQUILLAGES.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994056
    m_Localized: Voici la mer Baltique.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994057
    m_Localized: Cherchons des COQUILLAGES dans le SABLE.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994058
    m_Localized: Glissez pour nettoyer le SABLE.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994059
    m_Localized: Trouvez 5 tas de COQUILLAGES.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994060
    m_Localized: "Maintenant, allez rencontrer le P\xCACHEUR"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994061
    m_Localized: "Bonjour. Je suis p\xEAcheur."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994062
    m_Localized: Voici mon coupe-filets et mon filet.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994063
    m_Localized: Trouvons AMBER aussi.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994064
    m_Localized: L'AMBRE, C'EST DE L'OR BALTIQUE.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994065
    m_Localized: Nettoyer le sable pour en trouver 5.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994066
    m_Localized: "Bravo pour avoir trouv\xE9 AMBER !"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994067
    m_Localized: Maintenant, allons au PHARE.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994068
    m_Localized: Un phare aide les navires.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994069
    m_Localized: "Elle projette une lumi\xE8re vive."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994070
    m_Localized: "Excellent travail pour la r\xE9paration du PHARE !"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994071
    m_Localized: "Passons maintenant \xE0 la fabrication du COLLIER."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994072
    m_Localized: "Nous avons 10 pi\xE8ces."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994073
    m_Localized: AMBRE et COQUILLAGE.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994074
    m_Localized: "Cr\xE9ez un motif."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994076
    m_Localized: "COQUILLE D'AMBRE (r\xE9p\xE9ter)."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994077
    m_Localized: Superbe travail pour la confection du COLLIER !
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994078
    m_Localized: Maintenant, direction la fontaine de Neptune
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994079
    m_Localized: Placez le COLLIER sur NEPTUNE.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994080
    m_Localized: Un magnifique COLLIER !
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994081
    m_Localized: Vous respectez la MER.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994082
    m_Localized: Je vais vous aider.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994083
    m_Localized: "AMBER est c\xE9l\xE8bre ici."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994084
    m_Localized: Comme l'histoire de la CHAMBRE D'AMBRE.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994085
    m_Localized: FLASH ! Le PHARE brille.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994086
    m_Localized: Excellent travail !
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994087
    m_Localized: et surveillez les SEALs
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994088
    m_Localized: Ce sont des phoques sauvages.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994089
    m_Localized: "Gardez une distance de s\xE9curit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994090
    m_Localized: "Oui ! La qu\xEAte est termin\xE9e !"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994091
    m_Localized: "Mots \xE0 r\xE9viser"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994092
    m_Localized: Associez les mots.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994093
    m_Localized: "Bien jou\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994094
    m_Localized: Quiz final
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994095
    m_Localized: "R\xE9pondez \xE0 trois questions."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994096
    m_Localized: "S\xE9lectionnez la meilleure option."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994097
    m_Localized: "Quelle mer se trouve pr\xE8s de Gda\u0143sk ?"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994098
    m_Localized: MER BALTIQUE
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994099
    m_Localized: MER NOIRE
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994100
    m_Localized: "Pas celui-l\xE0. R\xE9essayez !"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994101
    m_Localized: Qu'est-ce que l'OR BALTIQUE ?
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994102
    m_Localized: AMBRE
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994103
    m_Localized: SABLE
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994104
    m_Localized: "Ce n'est pas du sable. R\xE9essayez !"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994105
    m_Localized: "\xC0 quoi sert un PHARE ?"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994106
    m_Localized: Aide les navires
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994107
    m_Localized: Attrape des poissons
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994108
    m_Localized: "Non. Il guide les navires. R\xE9essayez !"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994109
    m_Localized: "Vous avez aid\xE9 GDA\u0143SK."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994110
    m_Localized: "Le PHARE brille \xE0 nouveau !"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994111
    m_Localized: J'ai vu une fois un gros BATEAU.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994112
    m_Localized: "Les vagues d\xE9ferlent rapidement."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994113
    m_Localized: "Une vieille grue soul\xE8ve de lourdes charges."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994114
    m_Localized: "Une lumi\xE8re vive guide les bateaux."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994115
    m_Localized: Le fleuve rejoint la mer ici.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994116
    m_Localized: "Le port est anim\xE9 aujourd'hui."
    m_Metadata:
      m_Items: []
  - m_Id: 2387317279940608
    m_Localized: Faites glisser dans l'ordre.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
