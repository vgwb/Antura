MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PL_05_ro
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ro
  m_SharedData: {fileID: 11400000, guid: 1f123f384babc4d4dba78c64971dc3d2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2387309876994048
    m_Localized: "Bine a\u021Bi venit \xEEn GDA\u021ASK, POLONIA."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994049
    m_Localized: FARUL este stins.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994050
    m_Localized: "Hai s\u0103 repar\u0103m!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994051
    m_Localized: "Aceast\u0103 misiune este complet\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994052
    m_Localized: "Deseneaz\u0103 o scoic\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994053
    m_Localized: Avem nevoie de un cadou pentru NEPTUN.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994054
    m_Localized: "F\u0103 un COLIER."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994055
    m_Localized: 5 CHIHLIMBAR + 5 SCOICI.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994056
    m_Localized: "Aceasta este Marea Baltic\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994057
    m_Localized: "Hai s\u0103 g\u0103sim SCOCII \xEEn NISIP."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994058
    m_Localized: "Trage\u021Bi pentru a cur\u0103\u021Ba NISIPUL."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994059
    m_Localized: "G\u0103se\u0219te 5 gr\u0103mezi de SCOICI."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994060
    m_Localized: "Acum du-te \u0219i \xEEnt\xE2lne\u0219te-l pe PESCAR"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994061
    m_Localized: "Bun\u0103 ziua. Sunt PESCAR."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994062
    m_Localized: "Acesta este CUTTERUL \u0219i PLASA mea."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994063
    m_Localized: "Hai s\u0103 o g\u0103sim \u0219i pe AMBER."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994064
    m_Localized: CHIHLIMBARUL este AUR BATIC.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994065
    m_Localized: "Cur\u0103\u021B\u0103 NISIP pentru a g\u0103si 5."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994066
    m_Localized: "Bravo c\u0103 ai g\u0103sit-o pe AMBER!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994067
    m_Localized: "Acum haide\u021Bi s\u0103 mergem la FAR."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994068
    m_Localized: "Un FAR ajut\u0103 NAVELE."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994069
    m_Localized: "Str\u0103luce\u0219te o lumin\u0103 puternic\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994070
    m_Localized: Bravo la repararea FARULUI!
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994071
    m_Localized: "Acum haide\u021Bi s\u0103 confec\u021Bion\u0103m COLIERUL."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994072
    m_Localized: "Avem 10 buc\u0103\u021Bi."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994073
    m_Localized: "AMBER \u0219i SHELL."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994074
    m_Localized: "Crea\u021Bi un model."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994076
    m_Localized: "Repet\u0103 AMBER SHELL."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994077
    m_Localized: Bravo la realizarea COLIERULUI!
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994078
    m_Localized: "Acum, la F\xC2NT\xC2NA LUI NEPTUN"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994079
    m_Localized: "A\u0219eza\u021Bi COLIERUL pe NEPTUN."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994080
    m_Localized: Un COLIER superb!
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994081
    m_Localized: Respecti SEA.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994082
    m_Localized: Te voi ajuta.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994083
    m_Localized: "AMBER este faimoas\u0103 aici."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994084
    m_Localized: "Ca \u0219i povestea din CAMERA DE CHIHLIMBARIE."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994085
    m_Localized: "FLASH! Farul str\u0103luce\u0219te."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994086
    m_Localized: "Bun\u0103 treab\u0103!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994087
    m_Localized: "\u0219i fi\u021Bi aten\u021Bi la FIGURI"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994088
    m_Localized: "Acestea sunt foci s\u0103lbatice."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994089
    m_Localized: "P\u0103stra\u021Bi o distan\u021B\u0103 sigur\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994090
    m_Localized: Da! Misiunea s-a terminat!
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994091
    m_Localized: Cuvinte de recapitulare
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994092
    m_Localized: "Potrive\u0219te cuvintele."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994093
    m_Localized: "Bine f\u0103cut!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994094
    m_Localized: Acum testul final
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994095
    m_Localized: "R\u0103spunde\u021Bi la trei \xEEntreb\u0103ri."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994096
    m_Localized: "Atinge\u021Bi cea mai bun\u0103 op\u021Biune."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994097
    m_Localized: "Ce mare este \xEEn apropierea ora\u0219ului GDA\u021ASK?"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994098
    m_Localized: "Marea Baltic\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994099
    m_Localized: "MAREA NEAGR\u0102"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994100
    m_Localized: "Nu acela. \xCEncearc\u0103 din nou!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994101
    m_Localized: Ce este aurul baltic?
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994102
    m_Localized: CHIHLIMBAR
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994103
    m_Localized: NISIP
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994104
    m_Localized: "Nu NISIP. \xCEncearc\u0103 din nou!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994105
    m_Localized: Ce face un FAR?
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994106
    m_Localized: "Ajut\u0103 NAVELE"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994107
    m_Localized: "Prinde pe\u0219te"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994108
    m_Localized: "Nu. Ghideaz\u0103 NAVE. \xCEncearc\u0103 din nou!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994109
    m_Localized: "Ai ajutat GDA\u021ASK."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994110
    m_Localized: "FARUL str\u0103luce\u0219te din nou!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994111
    m_Localized: "Odat\u0103 am v\u0103zut o NAV\u0102 mare."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994112
    m_Localized: "Valurile se \xEEmpro\u0219c\u0103 repede."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994113
    m_Localized: "Macara veche ridic\u0103 sarcini grele."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994114
    m_Localized: "Lumina puternic\u0103 ghideaz\u0103 b\u0103rcile."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994115
    m_Localized: "Aici, r\xE2ul \xEEnt\xE2lne\u0219te marea."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994116
    m_Localized: "Portul este aglomerat ast\u0103zi."
    m_Metadata:
      m_Items: []
  - m_Id: 2387317279940608
    m_Localized: "Trage\u021Bi \xEEn ordine."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
