  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PL_05_hu
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: hu
  m_SharedData: {fileID: 11400000, guid: 1f123f384babc4d4dba78c64971dc3d2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2387309876994048
    m_Localized: "\xDCdv\xF6z\xF6lj\xFCk GDA\u0143SKban, LENGYELORSZ\xC1GBAN."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994049
    m_Localized: "A VIL\xC1G\xCDT\xD3TORONY ki van kapcsolva."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994050
    m_Localized: "Jav\xEDtsuk meg!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994051
    m_Localized: "Ez a k\xFCldet\xE9s teljes\xEDtve."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994052
    m_Localized: "Rajzolj egy H\xC9JAT."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994053
    m_Localized: "Aj\xE1nd\xE9kot kell keresn\xFCnk NEPTUNUSZNAK."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994054
    m_Localized: "K\xE9sz\xEDts egy nyakl\xE1ncot."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994055
    m_Localized: "5 BOROSTY\xC1N + 5 KAGYL\xD3."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994056
    m_Localized: Ez a BALTI-TENGER.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994057
    m_Localized: "Keress\xFCnk KAGYL\xD3KAT a HOMOKBAN."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994058
    m_Localized: "H\xFAzd a homok tiszt\xEDt\xE1s\xE1hoz."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994059
    m_Localized: "Keress 5 kagyl\xF3kupacot."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994060
    m_Localized: "Most menj \xE9s tal\xE1lkozz a HAL\xC1SZZAL"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994061
    m_Localized: "Hell\xF3. HAL\xC1SZ vagyok."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994062
    m_Localized: "Ez a V\xC1G\xD3M \xE9s a H\xC1L\xD3M."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994063
    m_Localized: "Keress\xFCk meg AMBER-t is."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994064
    m_Localized: "A BOROSTY\xC1N a BALTI ARANY."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994065
    m_Localized: "Tiszt\xEDtsd meg a HOMOKOT, hogy megtal\xE1ld az 5-\xF6t."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994066
    m_Localized: "Nagyszer\u0171 munka megtal\xE1lni AMBER-t!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994067
    m_Localized: "Most pedig menj\xFCnk a VIL\xC1G\xCDT\xD3TORONYHOZ."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994068
    m_Localized: "A VIL\xC1G\xCDT\xD3TORONY seg\xEDti a HAJ\xD3KAT."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994069
    m_Localized: "Ragyog\xF3 f\xE9nnyel vil\xE1g\xEDt."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994070
    m_Localized: "Nagyszer\u0171 munka a VIL\xC1G\xCDT\xD3TORONY megjav\xEDt\xE1sa!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994071
    m_Localized: "Most pedig k\xE9sz\xEDts\xFCk el a NYAKL\xC1NCOT."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994072
    m_Localized: Van 10 darabunk.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994073
    m_Localized: "BOROSTY\xC1N \xE9s KAGYL\xD3."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994074
    m_Localized: "K\xE9sz\xEDts egy mint\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994076
    m_Localized: "BOROSTY\xC1N H\xC9J ism\xE9tl\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994077
    m_Localized: "Nagyszer\u0171 munka a NYAKL\xC1NC elk\xE9sz\xEDt\xE9se!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994078
    m_Localized: "Most pedig a NEPTUNUSZ SZ\xD6K\u0150K\xDATJ\xC1HOZ"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994079
    m_Localized: "Helyezd a NYAKL\xC1NCOT a NEPTUNUSZRA."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994080
    m_Localized: "Egy sz\xE9p NYAKL\xC1NC!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994081
    m_Localized: Tiszteletben tartod a SEA-t.
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994082
    m_Localized: "Seg\xEDtek neked."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994083
    m_Localized: "AMBER h\xEDres errefel\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994084
    m_Localized: "Mint az AMBER ROOM t\xF6rt\xE9net."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994085
    m_Localized: "VILL\xC1M! A VIL\xC1G\xCDT\xD3TORONY ragyog."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994086
    m_Localized: "Nagyszer\u0171 munka!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994087
    m_Localized: "\xE9s figyelj a PECS\xC9KRE"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994088
    m_Localized: "Ezek vad F\xD3K\xC1K."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994089
    m_Localized: "Tartson biztons\xE1gos t\xE1vols\xE1got."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994090
    m_Localized: "Igen! A k\xFCldet\xE9s teljes\xEDtve!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994091
    m_Localized: "Szavak \xE1ttekint\xE9se"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994092
    m_Localized: "P\xE1ros\xEDtsd a szavakat."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994093
    m_Localized: "Gratul\xE1lok!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994094
    m_Localized: "Most a v\xE9gs\u0151 kv\xEDz"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994095
    m_Localized: "V\xE1laszolj h\xE1rom k\xE9rd\xE9sre."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994096
    m_Localized: "Koppintson a legjobb v\xE1laszt\xE1sra."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994097
    m_Localized: "Melyik tenger van GDA\u0143SK k\xF6zel\xE9ben?"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994098
    m_Localized: BALTI-TENGER
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994099
    m_Localized: FEKETE-TENGER
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994100
    m_Localized: "Azzal nem. Pr\xF3b\xE1ld \xFAjra!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994101
    m_Localized: Mi az a BALTI ARANY?
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994102
    m_Localized: "BOROSTY\xC1N"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994103
    m_Localized: HOMOK
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994104
    m_Localized: "Nem HOMOK. Pr\xF3b\xE1ld \xFAjra!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994105
    m_Localized: "Mit csin\xE1l egy VIL\xC1G\xCDT\xD3TORONY?"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994106
    m_Localized: "Seg\xEDti a HAJ\xD3KAT"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994107
    m_Localized: Halakat fog
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994108
    m_Localized: "Nem. HAJ\xD3KAT ir\xE1ny\xEDt. Pr\xF3b\xE1ld \xFAjra!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994109
    m_Localized: "Seg\xEDtett\xE9l GDA\u0143SK-nak."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994110
    m_Localized: "A VIL\xC1G\xCDT\xD3TORONY \xFAjra ragyog!"
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994111
    m_Localized: "Egyszer l\xE1ttam egy nagy HAJ\xD3T."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994112
    m_Localized: "A hull\xE1mok gyorsan csapkodnak."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994113
    m_Localized: "Egy r\xE9gi daru neh\xE9z terheket emel."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994114
    m_Localized: "\xC9les f\xE9ny vezeti a haj\xF3kat."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994115
    m_Localized: "A foly\xF3 itt tal\xE1lkozik a tengerrel."
    m_Metadata:
      m_Items: []
  - m_Id: 2387309876994116
    m_Localized: "A kik\xF6t\u0151 ma forgalmas."
    m_Metadata:
      m_Items: []
  - m_Id: 2387317279940608
    m_Localized: "H\xFAzd sorrendben."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
