--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_05_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: d08d57c8682af435cacfdff1f8d4e6ee, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 134388637696
    m_Localized: "Bienvenue dans les ch\xE2teaux de la Loire !"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637697
    m_Localized: "Antura s'est enfuie et se cache dans un ch\xE2teau !"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637698
    m_Localized: "Voici le ch\xE2teau de Chinon."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637699
    m_Localized: "Bienvenue au ch\xE2teau de Chambord."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637700
    m_Localized: "Touve les v\xEAtements du chevalier.:"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637701
    m_Localized: " et une armure pour se prot\xE9ger."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637702
    m_Localized: "Trouvez tous les objets du prince\_:"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637703
    m_Localized: et un masque de bal.
    m_Metadata:
      m_Items: []
  - m_Id: 134388637704
    m_Localized: "As-tu trouv\xE9 Antura ?"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637705
    m_Localized: OUI
    m_Metadata:
      m_Items: []
  - m_Id: 134388637706
    m_Localized: NON
    m_Metadata:
      m_Items: []
  - m_Id: 134388637707
    m_Localized: ")Il y a plus de 200 ch\xE2teaux comme celui-ci."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637708
    m_Localized: "Un pont-levis est un type de pont mobile utilis\xE9 dans les ch\xE2teaux."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637709
    m_Localized: "Un parapet comporte des ouvertures servant \xE0 la d\xE9fense."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637710
    m_Localized: un casque
    m_Metadata:
      m_Items: []
  - m_Id: 134388637711
    m_Localized: un chapeau
    m_Metadata:
      m_Items: []
  - m_Id: 134388637712
    m_Localized: "une \xE9p\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637713
    m_Localized: .
    m_Metadata:
      m_Items: []
  - m_Id: 134388637714
    m_Localized: "un arc et des fl\xE8ches"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637715
    m_Localized: 'TUTEUR : ceci'
    m_Metadata:
      m_Items: []
  - m_Id: 134388637716
    m_Localized: C'est une armure.!
    m_Metadata:
      m_Items: []
  - m_Id: 134388637717
    m_Localized: "Ce sont des meurtri\xE8res. Elles servent \xE0 tirer des fl\xE8ches
      sur l'ennemi."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637718
    m_Localized: "Ce ch\xE2teau servait \xE0 la d\xE9fense."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637719
    m_Localized: "Il est tr\xE8s vieux."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637720
    m_Localized: "bals, pi\xE8ces de th\xE9\xE2tre et concerts."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637721
    m_Localized: un instrument de musique
    m_Metadata:
      m_Items: []
  - m_Id: 134388637722
    m_Localized: es chaussures de danse.
    m_Metadata:
      m_Items: []
  - m_Id: 134388637723
    m_Localized: un masque de bal
    m_Metadata:
      m_Items: []
  - m_Id: 134388637724
    m_Localized: "Voici un plan du ch\xE2teau."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637725
    m_Localized: Quelle chambre !
    m_Metadata:
      m_Items: []
  - m_Id: 134388637726
    m_Localized: "C'est tr\xE8s joli !"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545920
    m_Localized: "Le jeu est termin\xE9 ! F\xE9licitations !"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545921
    m_Localized: "Avez-vous appr\xE9ci\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545922
    m_Localized: "Maintenant, dessinez votre ch\xE2teau pr\xE9f\xE9r\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545923
    m_Localized: "Les ch\xE2teaux vous ont plu ?"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545924
    m_Localized: "Saviez-vous que la vall\xE9e de la Loire est un site inscrit au
      patrimoine mondial de l'UNESCO ?"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545925
    m_Localized: "Le ch\xE2teau de Chambord compte 440 pi\xE8ces !"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545926
    m_Localized: "Le ch\xE2teau de Chinon \xE9tait une r\xE9sidence favorite du roi
      Henri II d'Angleterre."
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545927
    m_Localized: "La vall\xE9e de la Loire est connue comme le \xAB jardin de la
      France \xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545928
    m_Localized: "Le ch\xE2teau de Chambord a \xE9t\xE9 construit au XVIe si\xE8cle."
    m_Metadata:
      m_Items: []
  - m_Id: 2308569486581762
    m_Localized: "Maintenant, dessinez votre ch\xE2teau pr\xE9f\xE9r\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519559966720
    m_Localized: "Vous avez explor\xE9 deux ch\xE2teaux\_: le puissant Chinon et
      le somptueux Chambord\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161024
    m_Localized: "Vous avez compar\xE9 la d\xE9fense et la vie mondaine royale."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161025
    m_Localized: "Vous avez trouv\xE9 de l'\xE9quipement de chevalier et des articles
      de f\xEAte de prince."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161026
    m_Localized: "Grand explorateur de ch\xE2teaux !"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161027
    m_Localized: "Maintenant, dessinez votre ch\xE2teau pr\xE9f\xE9r\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161028
    m_Localized: "Les rois et les princes utilisaient ce ch\xE2teau pour"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161029
    m_Localized: casque
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161030
    m_Localized: "\xE9p\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161031
    m_Localized: arc
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161032
    m_Localized: chapeau
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161033
    m_Localized: instrument de musique
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161034
    m_Localized: chaussures de danse
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161035
    m_Localized: "Les ch\xE2teaux vous ont plu ?"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161036
    m_Localized: "Chambord poss\xE8de un escalier tellement sinueux que je m'y perdrais
      volontairement !"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161037
    m_Localized: "440 chambres\u2026 Il me faudrait 440 siestes."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161038
    m_Localized: Des bals royaux ? Je danserais comme une baguette qui gigote.
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161039
    m_Localized: "Si j'habitais ici, j'oublierais encore o\xF9 j'ai laiss\xE9 mes
      chaussures."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161040
    m_Localized: "Les murs de Chinon sont si solides que m\xEAme ma meilleure blague
      ne pourrait pas les briser !"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161041
    m_Localized: "Je fais semblant d'\xEAtre un chevalier\u2026 en r\xE9alit\xE9,
      je garde des en-cas."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161042
    m_Localized: "Failles : de minuscules ouvertures pour les fl\xE8ches\u2026 ou
      de tr\xE8s fines vagues."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161043
    m_Localized: "Les parapets sont parfaits pour jeter un coup d'\u0153il sans \xEAtre
      vu."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161044
    m_Localized: "La Loire ressemble \xE0 un long ruban d'argent \u2014 sans papier
      cadeau !"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161045
    m_Localized: "Je fais signe \xE0 chaque ch\xE2teau. Un jour, peut-\xEAtre qu'une
      tour me r\xE9pondra."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161046
    m_Localized: "Les ponts d'ici sont des endroits parfaits pour r\xE9fl\xE9chir
      aux en-cas."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161047
    m_Localized: "Tant de ch\xE2teaux que m\xEAme les nuages \u200B\u200Bsont des
      touristes."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
