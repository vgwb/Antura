--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_05_hu
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: hu
  m_SharedData: {fileID: 11400000, guid: d08d57c8682af435cacfdff1f8d4e6ee, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 134388637696
    m_Localized: "\xDCdv\xF6z\xF6lj\xFCk a Loire-v\xF6lgy kast\xE9lyaiban!"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637697
    m_Localized: "Antura elsz\xF6k\xF6tt \xE9s egy kast\xE9lyban rejt\u0151zik!"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637698
    m_Localized: "Ez Chinon v\xE1ra."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637699
    m_Localized: "\xDCdv\xF6z\xF6lj\xFCk a Chambord-kast\xE9lyban."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637700
    m_Localized: "Keresd meg az \xF6sszes ruh\xE1t, amit egy lovag visel:"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637701
    m_Localized: "\xE9s p\xE1nc\xE9l."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637702
    m_Localized: "Tal\xE1ld meg a herceg \xF6sszes t\xE1rgy\xE1t:"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637703
    m_Localized: "\xE9s b\xE1lmaszk."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637704
    m_Localized: "Megtal\xE1ltad Antur\xE1t?"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637705
    m_Localized: IGEN
    m_Metadata:
      m_Items: []
  - m_Id: 134388637706
    m_Localized: NEM
    m_Metadata:
      m_Items: []
  - m_Id: 134388637707
    m_Localized: "200 ilyen kast\xE9ly tal\xE1lhat\xF3 a Loire-v\xF6lgyben!"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637708
    m_Localized: "A felvon\xF3h\xEDd egyfajta mozgathat\xF3 h\xEDd, amelyet v\xE1rakban
      haszn\xE1lnak."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637709
    m_Localized: "A mellv\xE9dnek r\xE9seket haszn\xE1lnak a v\xE9dekez\xE9sre."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637710
    m_Localized: egy sisak
    m_Metadata:
      m_Items: []
  - m_Id: 134388637711
    m_Localized: egy kalap
    m_Metadata:
      m_Items: []
  - m_Id: 134388637712
    m_Localized: kard
    m_Metadata:
      m_Items: []
  - m_Id: 134388637713
    m_Localized: .
    m_Metadata:
      m_Items: []
  - m_Id: 134388637714
    m_Localized: "\xEDj \xE9s nyilak"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637715
    m_Localized: "OKTAT\xD3: ez"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637716
    m_Localized: "ez egy p\xE1nc\xE9l"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637717
    m_Localized: "Ezek l\u0151r\xE9sek. Ezeket arra haszn\xE1lj\xE1k, hogy nyilakat
      l\u0151jenek az ellens\xE9gre."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637718
    m_Localized: "Ezt a v\xE1rat v\xE9dekez\xE9sre haszn\xE1lt\xE1k."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637719
    m_Localized: "Nagyon r\xE9gi."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637720
    m_Localized: "b\xE1lok, el\u0151ad\xE1sok \xE9s koncertek."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637721
    m_Localized: egy hangszer
    m_Metadata:
      m_Items: []
  - m_Id: 134388637722
    m_Localized: "t\xE1nccip\u0151k"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637723
    m_Localized: "egy goly\xF3maszk"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637724
    m_Localized: "Ez a v\xE1r t\xE9rk\xE9pe."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637725
    m_Localized: Micsoda szoba!
    m_Metadata:
      m_Items: []
  - m_Id: 134388637726
    m_Localized: "Nagyon sz\xE9p!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545920
    m_Localized: "A j\xE1t\xE9k befejez\u0151d\xF6tt! Gratul\xE1lunk!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545921
    m_Localized: Tetszett?
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545922
    m_Localized: "Most rajzold le a kedvenc v\xE1radat!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545923
    m_Localized: "Tetszettek a v\xE1rak?"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545924
    m_Localized: "Tudtad, hogy a Loire-v\xF6lgy az UNESCO Vil\xE1g\xF6r\xF6ks\xE9g
      r\xE9sze?"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545925
    m_Localized: "A Chambord-i kast\xE9lynak 440 szob\xE1ja van!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545926
    m_Localized: "A chinoni v\xE1r II. Henrik angol kir\xE1ly kedvenc rezidenci\xE1ja
      volt."
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545927
    m_Localized: "A Loire-v\xF6lgyet \u201EFranciaorsz\xE1g kertjek\xE9nt\u201D is
      ismerik."
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545928
    m_Localized: "A chambordi v\xE1rat a 16. sz\xE1zadban \xE9p\xEDtett\xE9k."
    m_Metadata:
      m_Items: []
  - m_Id: 2308569486581762
    m_Localized: "Most rajzold le a kedvenc v\xE1radat!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519559966720
    m_Localized: "K\xE9t v\xE1rat fedezt\xE9l fel: az er\u0151s Chinont \xE9s a d\xEDszes
      Chambord-ot!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161024
    m_Localized: "\xD6sszehasonl\xEDtottad a v\xE9delmi rendszert \xE9s a kir\xE1lyi
      p\xE1rt\xE9letet."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161025
    m_Localized: "Lovagfelszerel\xE9st \xE9s hercegi partihoz val\xF3 dolgokat tal\xE1lt\xE1l."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161026
    m_Localized: "Nagyszer\u0171 v\xE1rfelfedez\u0151!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161027
    m_Localized: "Most rajzold le a kedvenc v\xE1radat!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161028
    m_Localized: "Kir\xE1lyok \xE9s hercegek haszn\xE1lt\xE1k ezt a v\xE1rat"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161029
    m_Localized: sisak
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161030
    m_Localized: kard
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161031
    m_Localized: "\xEDj"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161032
    m_Localized: kalap
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161033
    m_Localized: hangszer
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161034
    m_Localized: "t\xE1nccip\u0151k"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161035
    m_Localized: "Tetszettek a v\xE1rak?"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161036
    m_Localized: "Chambordnak olyan kanyarg\xF3s l\xE9pcs\u0151je van, hogy direkt
      elt\xE9vedn\xE9k!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161037
    m_Localized: "440 szoba\u2026 440 alv\xE1sra lenne sz\xFCks\xE9gem."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161038
    m_Localized: "Kir\xE1lyi b\xE1lok? \xDAgy t\xE1ncoln\xE9k, mint egy ringat\xF3z\xF3
      bagett."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161039
    m_Localized: "Ha itt lakn\xE9k, m\xE9g mindig elfelejten\xE9m, hol hagytam a
      cip\u0151met."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161040
    m_Localized: "A chinon falai olyan er\u0151sek, hogy m\xE9g a legjobb vicceim
      sem tudj\xE1k lerombolni \u0151ket!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161041
    m_Localized: "\xDAgy teszek, mintha lovag lenn\xE9k\u2026 val\xF3j\xE1ban uzsonn\xE1t
      \u0151rz\xF6k."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161042
    m_Localized: "Kiskapuk: apr\xF3 ablakok a nyilaknak\u2026 vagy nagyon v\xE9kony
      hull\xE1moknak."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161043
    m_Localized: "A mellv\xE9dek t\xF6k\xE9letesek arra, hogy \xE9szrev\xE9tlen\xFCl
      less\xFCnk."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161044
    m_Localized: "A Loire \xFAgy n\xE9z ki, mint egy hossz\xFA ez\xFCstszalag \u2013
      aj\xE1nd\xE9kcsomagol\xE1s n\xE9lk\xFCl!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161045
    m_Localized: "Minden v\xE1rnak integetek. Egy nap tal\xE1n egy torony viszonozza
      az integet\xE9st."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161046
    m_Localized: "A hidak itt remek helyek arra, hogy \xE1tgondoljuk a harapnival\xF3kat."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161047
    m_Localized: "Annyi v\xE1r, hogy m\xE9g a felh\u0151k is turist\xE1k."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
