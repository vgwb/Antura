--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_05_ro
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ro
  m_SharedData: {fileID: 11400000, guid: d08d57c8682af435cacfdff1f8d4e6ee, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 134388637696
    m_Localized: "Bine a\u021Bi venit la castelele din Loara!"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637697
    m_Localized: "Antura a fugit \u0219i se ascunde \xEEntr-un castel!"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637698
    m_Localized: Acesta este castelul din Chinon.
    m_Metadata:
      m_Items: []
  - m_Id: 134388637699
    m_Localized: "Bine a\u021Bi venit la Castelul Chambord."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637700
    m_Localized: "G\u0103se\u0219te toate lucrurile pe care le poart\u0103 un cavaler:"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637701
    m_Localized: "\u0219i armur\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637702
    m_Localized: "G\u0103se\u0219te toate obiectele prin\u021Bului:"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637703
    m_Localized: "\u0219i masc\u0103 de minge."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637704
    m_Localized: "L-ai g\u0103sit pe Antura?"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637705
    m_Localized: DA
    m_Metadata:
      m_Items: []
  - m_Id: 134388637706
    m_Localized: NU
    m_Metadata:
      m_Items: []
  - m_Id: 134388637707
    m_Localized: "Exist\u0103 200 de castele ca acesta \xEEn Valea Loarei!"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637708
    m_Localized: "Un pod mobil este un tip de pod mobil folosit \xEEn castele."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637709
    m_Localized: "Un parapet are goluri folosite pentru ap\u0103rare."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637710
    m_Localized: "o casc\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637711
    m_Localized: "o p\u0103l\u0103rie"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637712
    m_Localized: sabie
    m_Metadata:
      m_Items: []
  - m_Id: 134388637713
    m_Localized: .
    m_Metadata:
      m_Items: []
  - m_Id: 134388637714
    m_Localized: "un arc \u0219i s\u0103ge\u021Bi"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637715
    m_Localized: 'TUTOR: acesta'
    m_Metadata:
      m_Items: []
  - m_Id: 134388637716
    m_Localized: "aceasta este o armur\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637717
    m_Localized: "Acestea sunt porti\u021Be. Sunt folosite pentru a trage s\u0103ge\u021Bi
      asupra inamicului."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637718
    m_Localized: "Acest castel a fost folosit pentru ap\u0103rare."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637719
    m_Localized: Este foarte vechi.
    m_Metadata:
      m_Items: []
  - m_Id: 134388637720
    m_Localized: "baluri, piese de teatru \u0219i concerte."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637721
    m_Localized: un instrument muzical
    m_Metadata:
      m_Items: []
  - m_Id: 134388637722
    m_Localized: pantofi de dans
    m_Metadata:
      m_Items: []
  - m_Id: 134388637723
    m_Localized: "o masc\u0103 de bal"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637724
    m_Localized: "Aceasta este o hart\u0103 a castelului."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637725
    m_Localized: "Ce camer\u0103!"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637726
    m_Localized: Este foarte frumos!
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545920
    m_Localized: "Jocul este complet! Felicit\u0103ri!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545921
    m_Localized: "\u021Ai-a pl\u0103cut?"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545922
    m_Localized: "Acum deseneaz\u0103 castelul t\u0103u preferat!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545923
    m_Localized: "\u021Ai-au pl\u0103cut castelele?"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545924
    m_Localized: "\u0218tia\u021Bi c\u0103 Valea Loarei este inclus\u0103 \xEEn Patrimoniul
      Mondial UNESCO?"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545925
    m_Localized: Castelul Chambord are 440 de camere!
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545926
    m_Localized: "Castelul Chinon a fost o re\u0219edin\u021B\u0103 preferat\u0103
      a regelui Henric al II-lea al Angliei."
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545927
    m_Localized: "Valea Loarei este cunoscut\u0103 sub numele de \u201EGr\u0103dina
      Fran\u021Bei\u201D."
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545928
    m_Localized: "Castelul Chambord a fost construit \xEEn secolul al XVI-lea."
    m_Metadata:
      m_Items: []
  - m_Id: 2308569486581762
    m_Localized: "Acum deseneaz\u0103 castelul t\u0103u preferat!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519559966720
    m_Localized: "Ai explorat dou\u0103 castele: puternicul Chinon \u0219i elegantul
      Chambord!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161024
    m_Localized: "Ai comparat via\u021Ba din cadrul ap\u0103r\u0103rii cu cea din
      partidul regal."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161025
    m_Localized: "Ai g\u0103sit echipament de cavaler \u0219i lucruri de petrecere
      pentru prin\u021Bi."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161026
    m_Localized: Mare explorator de castele!
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161027
    m_Localized: "Acum deseneaz\u0103 castelul t\u0103u preferat!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161028
    m_Localized: "Regii \u0219i prin\u021Bii au folosit acest castel pentru"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161029
    m_Localized: "casc\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161030
    m_Localized: sabie
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161031
    m_Localized: arc
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161032
    m_Localized: "p\u0103l\u0103rie"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161033
    m_Localized: instrument muzical
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161034
    m_Localized: pantofi de dans
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161035
    m_Localized: "\u021Ai-au pl\u0103cut castelele?"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161036
    m_Localized: "Chambord are o scar\u0103 at\xE2t de \xEEntortocheat\u0103 \xEEnc\xE2t
      m-a\u0219 r\u0103t\u0103ci inten\u021Bionat!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161037
    m_Localized: "440 de camere\u2026 A\u0219 avea nevoie de 440 de pui de somn."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161038
    m_Localized: "Baluri regale? A\u0219 dansa ca o baghet\u0103 zburlit\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161039
    m_Localized: "Dac\u0103 a\u0219 locui aici, tot a\u0219 uita unde mi-am l\u0103sat
      pantofii."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161040
    m_Localized: "Zidurile Chinon sunt at\xE2t de puternice \xEEnc\xE2t nici cea
      mai bun\u0103 glum\u0103 a mea nu le poate d\u0103r\xE2ma!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161041
    m_Localized: "M\u0103 prefac c\u0103 sunt cavaler\u2026 de fapt, p\u0103zesc
      gust\u0103ri."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161042
    m_Localized: "Por\u021Biune de sp\u0103rtur\u0103: ferestre minuscule pentru
      s\u0103ge\u021Bi\u2026 sau valuri foarte sub\u021Biri."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161043
    m_Localized: "Parapetele sunt perfecte pentru a privi cu ochiul f\u0103r\u0103
      a fi v\u0103zut."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161044
    m_Localized: "Loara arat\u0103 ca o panglic\u0103 lung\u0103 de argint \u2014
      f\u0103r\u0103 ambalaj de cadou!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161045
    m_Localized: "Fac cu m\xE2na fiec\u0103rui castel. \xCEntr-o zi, un turn ar putea
      s\u0103-i r\u0103spund\u0103 cu m\xE2na."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161046
    m_Localized: "Podurile de aici sunt locuri minunate pentru a te g\xE2ndi la gust\u0103ri."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161047
    m_Localized: "At\xE2tea castele \xEEnc\xE2t p\xE2n\u0103 \u0219i norii sunt turi\u0219ti."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
