MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_05_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: d08d57c8682af435cacfdff1f8d4e6ee, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 134388637696
    m_Localized: "Willkommen in den Schl\xF6ssern der Loire!"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637697
    m_Localized: Antura ist weggelaufen und versteckt sich in einem Schloss!
    m_Metadata:
      m_Items: []
  - m_Id: 134388637698
    m_Localized: Dies ist die Burg Chinon.
    m_Metadata:
      m_Items: []
  - m_Id: 134388637699
    m_Localized: Willkommen im Schloss Chambord.
    m_Metadata:
      m_Items: []
  - m_Id: 134388637700
    m_Localized: "Finde alle Kleidungsst\xFCcke, die ein Ritter tr\xE4gt:"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637701
    m_Localized: "und R\xFCstung."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637702
    m_Localized: "Finde alle Gegenst\xE4nde des Prinzen:"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637703
    m_Localized: und Ballmaske.
    m_Metadata:
      m_Items: []
  - m_Id: 134388637704
    m_Localized: Hast du Antura gefunden?
    m_Metadata:
      m_Items: []
  - m_Id: 134388637705
    m_Localized: JA
    m_Metadata:
      m_Items: []
  - m_Id: 134388637706
    m_Localized: NEIN
    m_Metadata:
      m_Items: []
  - m_Id: 134388637707
    m_Localized: "Im Loiretal gibt es 200 solcher Schl\xF6sser!"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637708
    m_Localized: "Eine Zugbr\xFCcke ist eine Art bewegliche Br\xFCcke, die in Burgen
      verwendet wird."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637709
    m_Localized: "Eine Br\xFCstung weist L\xFCcken auf, die zur Verteidigung genutzt
      werden."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637710
    m_Localized: ein Helm
    m_Metadata:
      m_Items: []
  - m_Id: 134388637711
    m_Localized: ein Hut
    m_Metadata:
      m_Items: []
  - m_Id: 134388637712
    m_Localized: Schwert
    m_Metadata:
      m_Items: []
  - m_Id: 134388637713
    m_Localized: Die
    m_Metadata:
      m_Items: []
  - m_Id: 134388637714
    m_Localized: Pfeil und Bogen
    m_Metadata:
      m_Items: []
  - m_Id: 134388637715
    m_Localized: 'TUTOR: dieser'
    m_Metadata:
      m_Items: []
  - m_Id: 134388637716
    m_Localized: "Das ist eine R\xFCstung."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637717
    m_Localized: "Das sind Schlupfl\xF6cher. Sie werden benutzt, um Pfeile auf den
      Feind abzuschie\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637718
    m_Localized: Diese Burg diente der Verteidigung.
    m_Metadata:
      m_Items: []
  - m_Id: 134388637719
    m_Localized: Es ist sehr alt.
    m_Metadata:
      m_Items: []
  - m_Id: 134388637720
    m_Localized: "B\xE4lle, Theaterst\xFCcke und Konzerte."
    m_Metadata:
      m_Items: []
  - m_Id: 134388637721
    m_Localized: ein Musikinstrument
    m_Metadata:
      m_Items: []
  - m_Id: 134388637722
    m_Localized: Tanzschuhe
    m_Metadata:
      m_Items: []
  - m_Id: 134388637723
    m_Localized: eine Ballmaske
    m_Metadata:
      m_Items: []
  - m_Id: 134388637724
    m_Localized: Dies ist eine Karte der Burg.
    m_Metadata:
      m_Items: []
  - m_Id: 134388637725
    m_Localized: "Was f\xFCr ein Zimmer!"
    m_Metadata:
      m_Items: []
  - m_Id: 134388637726
    m_Localized: "Das ist sehr sch\xF6n!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545920
    m_Localized: "Das Spiel ist beendet! Herzlichen Gl\xFCckwunsch!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545921
    m_Localized: Hat es Ihnen gefallen?
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545922
    m_Localized: Zeichne nun dein Lieblingsschloss!
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545923
    m_Localized: "Haben Ihnen die Schl\xF6sser gefallen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545924
    m_Localized: "Wussten Sie, dass das Loiretal zum UNESCO-Weltkulturerbe geh\xF6rt?"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545925
    m_Localized: "Das Schloss Chambord verf\xFCgt \xFCber 440 Zimmer!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545926
    m_Localized: "Schloss Chinon war eine Lieblingsresidenz von K\xF6nig Heinrich
      II. von England."
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545927
    m_Localized: "Das Loiretal ist als der \u201EGarten Frankreichs\u201C bekannt."
    m_Metadata:
      m_Items: []
  - m_Id: 2248058430545928
    m_Localized: Das Schloss Chambord wurde im 16. Jahrhundert erbaut.
    m_Metadata:
      m_Items: []
  - m_Id: 2308569486581762
    m_Localized: Zeichne nun dein Lieblingsschloss!
    m_Metadata:
      m_Items: []
  - m_Id: 2383519559966720
    m_Localized: 'Sie haben zwei Burgen erkundet: das imposante Chinon und das prunkvolle
      Chambord!'
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161024
    m_Localized: "Sie verglichen Verteidigung und das Leben am K\xF6nigshof."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161025
    m_Localized: "Du hast Ritterausr\xFCstung und Prinzen-Partyartikel gefunden."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161026
    m_Localized: "Gro\xDFartiger Burgenforscher!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161027
    m_Localized: Zeichne nun dein Lieblingsschloss!
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161028
    m_Localized: "K\xF6nige und Prinzen nutzten diese Burg f\xFCr"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161029
    m_Localized: Helm
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161030
    m_Localized: Schwert
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161031
    m_Localized: Bogen
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161032
    m_Localized: Hut
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161033
    m_Localized: Musikinstrument
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161034
    m_Localized: Tanzschuhe
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161035
    m_Localized: "Haben Ihnen die Schl\xF6sser gefallen?"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161036
    m_Localized: "Chambord hat eine so gewundene Treppe, dass ich mich dort absichtlich
      verirren w\xFCrde!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161037
    m_Localized: "440 Zimmer\u2026 Ich br\xE4uchte 440 Nickerchen."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161038
    m_Localized: "K\xF6nigliche B\xE4lle? Da w\xFCrde ich tanzen wie ein wackeliges
      Baguette."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161039
    m_Localized: "Wenn ich hier wohnen w\xFCrde, w\xFCrde ich trotzdem vergessen,
      wo ich meine Schuhe gelassen habe."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161040
    m_Localized: Die Mauern von Chinon sind so stark, dass selbst mein bester Witz
      sie nicht durchbrechen kann!
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161041
    m_Localized: "Ich gebe vor, ein Ritter zu sein\u2026 in Wirklichkeit bewache
      ich Snacks."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161042
    m_Localized: "Schlupfl\xF6cher: winzige Fenster f\xFCr Pfeile\u2026 oder sehr
      d\xFCnne Wellen."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161043
    m_Localized: "Br\xFCstungen eignen sich perfekt zum Sp\xE4hen, ohne gesehen zu
      werden."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161044
    m_Localized: "Die Loire sieht aus wie ein langes silbernes Band \u2013 nur ohne
      Geschenkpapier!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161045
    m_Localized: "Ich winke jeder Burg zu. Vielleicht winkt eines Tages ein Turm
      zur\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161046
    m_Localized: "Die Br\xFCcken hier sind gro\xDFartige Orte, um \xFCber Snacks
      nachzudenken."
    m_Metadata:
      m_Items: []
  - m_Id: 2383519564161047
    m_Localized: "So viele Schl\xF6sser, dass sogar die Wolken Touristen sind."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
