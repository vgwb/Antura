%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_10_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: b90ebc042e6dd4584b2dc55809f17693, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 58867199224307712
    m_Localized: "Willkommen in Paris! Paris ist die Hauptstadt Frankreichs. In Paris
      flie\xDFt ein sehr ber\xFChmter Fluss. Dieser Fluss hei\xDFt Seine."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307713
    m_Localized: "Heute entdecken Sie die Seine und ihre vielen Br\xFCcken. Auf der
      Seine gibt es Boote aller Art."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307714
    m_Localized: "Gro\xDFartig, du hast diese Quest abgeschlossen!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307715
    m_Localized: "Sie haben die Br\xFCcken und Boote \xFCber die Seine entdeckt.
      Die Br\xFCcken erm\xF6glichen es Ihnen, den Fluss zu \xFCberqueren, der durch
      Paris flie\xDFt: die Seine."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307716
    m_Localized: "Es gibt Boote f\xFCr Touristen. Diese haben gro\xDFe Fenster, durch
      die man die Pariser Sehensw\xFCrdigkeiten von der Seine aus sehen kann."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307717
    m_Localized: "Es gibt Hausboote. Menschen leben auf diesen Booten. Sie werden
      Lastk\xE4hne genannt."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307718
    m_Localized: "Rund um die Seine wurden bedeutende Denkm\xE4ler in Paris errichtet."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307719
    m_Localized: "Zeichne eine Br\xFCcke in dein Notizbuch!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307721
    m_Localized: "Danke sch\xF6n!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307722
    m_Localized: "Du hast alle Fotos aus meinem Reisef\xFChrer gefunden!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307723
    m_Localized: "Ich kann endlich nach Hause! Ich habe noch eine letzte Frage\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502017
    m_Localized: "Aber mir fehlen 7 Fotos von Br\xFCcken und Booten auf der Seine!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502018
    m_Localized: Spazieren Sie am Seineufer entlang und finden Sie die Fotos!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502019
    m_Localized: "Falls Sie sie nicht finden k\xF6nnen, k\xF6nnen Sie sie mithilfe
      der Karte von Paris lokalisieren!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502020
    m_Localized: Du machst das gut!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502021
    m_Localized: Hilfe! Helft mir!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502022
    m_Localized: "Ich bin in Paris. Ich bin Touristin. Der Hund Antura hat mein Buch
      \xFCber Paris mitgenommen!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502023
    m_Localized: "Die Seiten meines Buches und die Fotos fielen in die N\xE4he der
      Seine!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502024
    m_Localized: Geh am Fluss entlang und du findest die Fotos!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502025
    m_Localized: Du hast alle Fotos gefunden!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502026
    m_Localized: "Geh zur\xFCck und sprich mit dem Touristen."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502029
    m_Localized: "Der Fluss, der durch Paris flie\xDFt, hei\xDFt..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502030
    m_Localized: Das Mittelmeer
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502031
    m_Localized: "Das ist nicht die richtige Antwort. Die Loire flie\xDFt durch Nantes,
      in der N\xE4he des Jules-Verne-Museums."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502032
    m_Localized: "Der \xC4rmelkanal"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502033
    m_Localized: "Ja, es ist die Seine. Der Fluss, der durch Paris flie\xDFt, hei\xDFt
      Seine."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502034
    m_Localized: Der Atlantische Ozean
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502037
    m_Localized: Dieses Boot transportiert Waren.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502038
    m_Localized: "Was findet man auf einem G\xFCterschiff?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502039
    m_Localized: "Ein G\xFCterschiff kann transportieren: Holz, Sand, aber auch Gegenst\xE4nde:
      Autos, M\xF6bel..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502040
    m_Localized: "Ja! Jetzt kannst du die Truhe \xF6ffnen!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502041
    m_Localized: Touristen mit Kameras
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502042
    m_Localized: Nein. Versuchen Sie es erneut.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502043
    m_Localized: Eisenbahnwagen
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502045
    m_Localized: "Ich wei\xDF nicht"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502046
    m_Localized: "Komm sp\xE4ter wieder."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502047
    m_Localized: "Spiele ein Minispiel, um die Truhe zu \xF6ffnen!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502048
    m_Localized: "Die Truhe \xF6ffnet sich. Du findest ein Foto!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502049
    m_Localized: Die Truhe ist leer.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502050
    m_Localized: Die Truhe ist verschlossen.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502051
    m_Localized: Dieses Boot ist ein Haus. Es gibt Menschen, die auf diesem Boot
      leben. Dieses Boot nennt man Hausboot.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502052
    m_Localized: Warum wird dieses Boot Hausboot genannt?
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502053
    m_Localized: "Es ist m\xF6glich, dort zu leben."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502055
    m_Localized: "Es ist eine Eisenbahnbr\xFCcke."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502057
    m_Localized: Dieses Boot transportiert Waren
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502064
    m_Localized: "Dieses Boot hat gro\xDFe Fenster. Touristen k\xF6nnen die Stadt
      bewundern. Es ist ein \u201EFlussboot\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502065
    m_Localized: "Warum hat ein Touristenboot gro\xDFe Fenster?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502066
    m_Localized: "Um die Stadt und ber\xFChmte Orte zu besichtigen"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502068
    m_Localized: Zum Transport von Autos
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502070
    m_Localized: Unter Wasser tauchen
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502077
    m_Localized: "Das ist die Alexander-III.-Br\xFCcke. Sie ist eine sehr ber\xFChmte
      Br\xFCcke."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502078
    m_Localized: "Warum ist diese Br\xFCcke ber\xFChmt?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502079
    m_Localized: Es gibt Statuen aus Gold.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502081
    m_Localized: "Es ist eine Eisenbahnbr\xFCcke."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502083
    m_Localized: "Es ist eine Br\xFCcke f\xFCr Autos."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502090
    m_Localized: "Das ist eine Br\xFCcke f\xFCr Autos!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502091
    m_Localized: "Die Autos fahren schnell. Wie kann ich sicher \xFCber die Stra\xDFe?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502092
    m_Localized: "Sie m\xFCssen auf dem Gehweg gehen und den Fu\xDFg\xE4nger\xFCberweg
      benutzen."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502094
    m_Localized: "Man kann die Stra\xDFe \xFCberall \xFCberqueren."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502096
    m_Localized: "Du musst auf der Stra\xDFe gehen"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502103
    m_Localized: "Es ist eine Br\xFCcke f\xFCr Z\xFCge!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502104
    m_Localized: "Eine Eisenbahnbr\xFCcke ist eine Br\xFCcke..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502105
    m_Localized: Sehr stark
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502107
    m_Localized: "f\xFCr Autos"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502109
    m_Localized: Nur zum Gehen
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502116
    m_Localized: "Ich w\xFCrde so gerne mit dem Zug fahren!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502117
    m_Localized: "Ich liebe Z\xFCge!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502118
    m_Localized: "Das ist eine Br\xFCcke f\xFCr Menschen!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502119
    m_Localized: "Eine Br\xFCcke, die nur zum Begehen bestimmt ist, nennt man..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502120
    m_Localized: Steg
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502122
    m_Localized: "Eisenbahnbr\xFCcke"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502124
    m_Localized: "eine Br\xFCcke f\xFCr Autos"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502131
    m_Localized: Schau dir diese Karte der Seine an.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502132
    m_Localized: "Die Seine m\xFCndet in n\xF6rdlicher Richtung in den \xC4rmelkanal."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502133
    m_Localized: Nein, ich habe Ihren Hund nicht gesehen.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502134
    m_Localized: Ein Hund? Hier gibt es viele Hunde...
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502135
    m_Localized: Ja, ich habe einen Hund herumlaufen sehen.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502136
    m_Localized: "Schau mal, wie h\xFCbsch es ist!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502137
    m_Localized: "Es gibt eine Insel namens \xCEle de la Cit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502138
    m_Localized: Es befindet sich im alten Zentrum von Paris.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502139
    m_Localized: "Die Seine m\xFCndet in den \xC4rmelkanal."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502140
    m_Localized: Guten Morgen!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502141
    m_Localized: La Seine est magnifique!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502142
    m_Localized: "In Paris gibt es viele Br\xFCcken!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502143
    m_Localized: Hallo!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502144
    m_Localized: "Ich genie\xDFe es sehr, entlang der Seine Rad zu fahren!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502145
    m_Localized: "Paris ist die sch\xF6nste Stadt der Welt!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502146
    m_Localized: Die Seine ist sehr lang!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502147
    m_Localized: "Eine Eisenbahnbr\xFCcke muss stabil sein."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502148
    m_Localized: "Manche Br\xFCcken sind nur f\xFCr Fu\xDFg\xE4nger bestimmt."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502149
    m_Localized: "Autos \xFCberqueren den Fluss jeden Tag."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502150
    m_Localized: "Auf der Seine k\xF6nnen Boote in Paris verkehren."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502151
    m_Localized: "Die Karten zeigen die M\xE4ander des Flusses."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502152
    m_Localized: "Der Fluss m\xFCndet ins Meer."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502153
    m_Localized: "Touristenboote haben gro\xDFe Fenster."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502154
    m_Localized: "G\xFCterschiffe transportieren viele Kisten."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502155
    m_Localized: Ein Hausboot kann ein Zuhause sein.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
