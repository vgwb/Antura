%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_10_pl
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: b90ebc042e6dd4584b2dc55809f17693, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 58867199224307712
    m_Localized: "Witamy w Pary\u017Cu! Pary\u017C jest stolic\u0105 Francji. W Pary\u017Cu
      p\u0142ynie bardzo s\u0142ynna rzeka. Ta rzeka nazywa si\u0119 Sekwana."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307713
    m_Localized: "Dzi\u015B odkryjesz Sekwan\u0119 i jej liczne mosty. Po Sekwanie
      p\u0142ywaj\u0105 najr\xF3\u017Cniejsze \u0142odzie."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307714
    m_Localized: "\u015Awietnie, uko\u0144czy\u0142e\u015B to zadanie!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307715
    m_Localized: "Odkry\u0142e\u015B mosty i \u0142odzie na Sekwanie. Mosty pozwalaj\u0105
      przekroczy\u0107 rzek\u0119 przep\u0142ywaj\u0105c\u0105 przez Pary\u017C:
      Sekwan\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307716
    m_Localized: "S\u0105 \u0142odzie dla turyst\xF3w. Maj\u0105 du\u017Ce okna,
      przez kt\xF3re mo\u017Cna podziwia\u0107 zabytki Pary\u017Ca z Sekwany."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307717
    m_Localized: "Istniej\u0105 \u0142odzie mieszkalne. Ludzie mieszkaj\u0105 na
      tych \u0142odziach. Nazywaj\u0105 si\u0119 barkami."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307718
    m_Localized: "Wa\u017Cne zabytki Pary\u017Ca zosta\u0142y zbudowane wok\xF3\u0142
      Sekwany."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307719
    m_Localized: Narysuj most w swoim zeszycie!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307721
    m_Localized: "Dzi\u0119kuj\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307722
    m_Localized: "Znalaz\u0142e\u015B wszystkie zdj\u0119cia z mojego przewodnika!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307723
    m_Localized: "Nareszcie mog\u0119 i\u015B\u0107 do domu! Mam jeszcze jedno ostatnie
      pytanie\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502017
    m_Localized: "Ale brakuje mi 7 zdj\u0119\u0107 most\xF3w i \u0142odzi na Sekwanie!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502018
    m_Localized: "Wybierz si\u0119 na spacer brzegiem Sekwany i znajd\u017A zdj\u0119cia!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502019
    m_Localized: "Je\u015Bli nie mo\u017Cesz ich znale\u017A\u0107, mo\u017Cesz skorzysta\u0107
      z mapy Pary\u017Ca!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502020
    m_Localized: Dobrze ci idzie!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502021
    m_Localized: "Pomocy! Pom\xF3\u017C mi!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502022
    m_Localized: "Odwiedzam Pary\u017C. Jestem turyst\u0105. Pies Antura zabra\u0142
      moj\u0105 ksi\u0105\u017Ck\u0119 o Pary\u017Cu!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502023
    m_Localized: "Strony mojej ksi\u0105\u017Cki i zdj\u0119cia upad\u0142y w pobli\u017Cu
      Sekwany!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502024
    m_Localized: "Spaceruj wzd\u0142u\u017C rzeki, a znajdziesz zdj\u0119cia!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502025
    m_Localized: "Znalaz\u0142e\u015B wszystkie zdj\u0119cia!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502026
    m_Localized: "Wr\xF3\u0107 i porozmawiaj z turyst\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502029
    m_Localized: "Rzeka przep\u0142ywaj\u0105ca przez Pary\u017C nazywa si\u0119..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502030
    m_Localized: "Morze \u015Ar\xF3dziemne"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502031
    m_Localized: "To nie jest poprawna odpowied\u017A. Loara przep\u0142ywa przez
      Nantes, w pobli\u017Cu Muzeum Juliusza Verne'a."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502032
    m_Localized: "Kana\u0142 La Manche"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502033
    m_Localized: "Tak, to Sekwana. Rzeka przep\u0142ywaj\u0105ca przez Pary\u017C
      nazywa si\u0119 Sekwana."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502034
    m_Localized: Ocean Atlantycki
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502037
    m_Localized: "Ta \u0142\xF3d\u017A przewozi towary."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502038
    m_Localized: "Co mo\u017Cna znale\u017A\u0107 na statku towarowym?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502039
    m_Localized: "Statek towarowy mo\u017Ce przewozi\u0107: drewno, piasek, ale tak\u017Ce
      przedmioty: samochody, meble..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502040
    m_Localized: "Tak! Teraz mo\u017Cesz otworzy\u0107 t\u0119 skrzyni\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502041
    m_Localized: "Tury\u015Bci z aparatami"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502042
    m_Localized: "Nie. Spr\xF3buj ponownie."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502043
    m_Localized: Wagony kolejowe
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502045
    m_Localized: Nie wiem
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502046
    m_Localized: "Wr\xF3\u0107 p\xF3\u017Aniej."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502047
    m_Localized: "Zagraj w minigr\u0119, aby otworzy\u0107 skrzyni\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502048
    m_Localized: "Skrzynia si\u0119 otwiera. Znajdziesz zdj\u0119cie!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502049
    m_Localized: Skrzynia jest pusta.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502050
    m_Localized: "Skrzynia jest zamkni\u0119ta."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502051
    m_Localized: "Ta \u0142\xF3d\u017A to dom. Na tej \u0142odzi mieszkaj\u0105 ludzie.
      Ta \u0142\xF3d\u017A nazywa si\u0119 houseboat."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502052
    m_Localized: "Dlaczego t\u0119 \u0142\xF3d\u017A nazywa si\u0119 houseboatem?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502053
    m_Localized: "Mo\u017Cna tam zamieszka\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502055
    m_Localized: "To jest most dla poci\u0105g\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502057
    m_Localized: "Ta \u0142\xF3d\u017A przewozi towary"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502064
    m_Localized: "Ta \u0142\xF3d\u017A ma du\u017Ce okna. Tury\u015Bci mog\u0105
      podziwia\u0107 miasto. To \u201Estatek rzeczny\u201D."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502065
    m_Localized: "Dlaczego statek turystyczny ma du\u017Ce okna?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502066
    m_Localized: "Aby zobaczy\u0107 miasto i znane miejsca"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502068
    m_Localized: "Do transportu samochod\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502070
    m_Localized: "Zanurzy\u0107 si\u0119 pod wod\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502077
    m_Localized: To jest most Aleksandra III. To bardzo znany most.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502078
    m_Localized: "Dlaczego ten most jest s\u0142awny?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502079
    m_Localized: "S\u0105 pos\u0105gi wykonane ze z\u0142ota."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502081
    m_Localized: "To jest most dla poci\u0105g\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502083
    m_Localized: "To most dla samochod\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502090
    m_Localized: "To most dla samochod\xF3w!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502091
    m_Localized: "Samochody jad\u0105 szybko. Jak mog\u0119 bezpiecznie przej\u015B\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502092
    m_Localized: "Nale\u017Cy chodzi\u0107 po chodniku i przechodzi\u0107 na przej\u015Bciu
      dla pieszych."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502094
    m_Localized: "Przez ulic\u0119 mo\u017Cna przej\u015B\u0107 w dowolnym miejscu."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502096
    m_Localized: "Musisz i\u015B\u0107 drog\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502103
    m_Localized: "To jest most dla poci\u0105g\xF3w!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502104
    m_Localized: Most kolejowy jest mostem...
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502105
    m_Localized: Bardzo silny
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502107
    m_Localized: "do samochod\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502109
    m_Localized: Tylko do chodzenia
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502116
    m_Localized: "Chcia\u0142bym poje\u017Adzi\u0107 poci\u0105giem!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502117
    m_Localized: "Uwielbiam poci\u0105gi!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502118
    m_Localized: To jest most dla ludzi!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502119
    m_Localized: "Most, po kt\xF3rym mog\u0105 chodzi\u0107 wy\u0142\u0105cznie ludzie,
      nazywa si\u0119..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502120
    m_Localized: "K\u0142adka"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502122
    m_Localized: Most kolejowy
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502124
    m_Localized: "most dla samochod\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502131
    m_Localized: "Sp\xF3jrz na t\u0119 map\u0119 Sekwany."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502132
    m_Localized: "Sekwana wp\u0142ywa do kana\u0142u La Manche (morza) w kierunku
      p\xF3\u0142nocnym."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502133
    m_Localized: "Nie, nie widzia\u0142em twojego psa."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502134
    m_Localized: "Pies? Jest tu wiele ps\xF3w..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502135
    m_Localized: "Tak, widzia\u0142em spaceruj\u0105cego psa."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502136
    m_Localized: "Sp\xF3jrz, jak \u0142adnie!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502137
    m_Localized: "Jest wyspa zwana \xCEle de la Cit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502138
    m_Localized: "Znajduje si\u0119 w starym centrum Pary\u017Ca."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502139
    m_Localized: "Sekwana wp\u0142ywa do kana\u0142u La Manche."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502140
    m_Localized: "Dzie\u0144 dobry!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502141
    m_Localized: La Seine est magnifique!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502142
    m_Localized: "W Pary\u017Cu jest wiele most\xF3w!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502143
    m_Localized: "Cze\u015B\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502144
    m_Localized: "Naprawd\u0119 lubi\u0119 je\u017Adzi\u0107 rowerem wzd\u0142u\u017C
      Sekwany!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502145
    m_Localized: "Pary\u017C jest najpi\u0119kniejszym miastem na \u015Bwiecie!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502146
    m_Localized: "Sekwana jest bardzo d\u0142uga!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502147
    m_Localized: "Most kolejowy musi by\u0107 solidny."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502148
    m_Localized: "Niekt\xF3re mosty przeznaczone s\u0105 wy\u0142\u0105cznie dla
      pieszych."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502149
    m_Localized: "Samochody przeje\u017Cd\u017Caj\u0105 przez rzek\u0119 codziennie."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502150
    m_Localized: "Sekwana umo\u017Cliwia ruch \u0142odzi w Pary\u017Cu."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502151
    m_Localized: "Na mapach zaznaczone s\u0105 meandry rzeki."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502152
    m_Localized: Rzeka wpada do morza.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502153
    m_Localized: "Statki turystyczne maj\u0105 du\u017Ce okna."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502154
    m_Localized: "Statki towarowe przewo\u017C\u0105 wiele pude\u0142."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502155
    m_Localized: "Dom na wodzie mo\u017Ce by\u0107 domem."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
