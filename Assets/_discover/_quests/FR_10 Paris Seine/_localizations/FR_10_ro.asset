%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_10_ro
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ro
  m_SharedData: {fileID: 11400000, guid: b90ebc042e6dd4584b2dc55809f17693, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 58867199224307712
    m_Localized: "Bine a\u021Bi venit la Paris! Parisul este capitala Fran\u021Bei.
      \xCEn Paris exist\u0103 un r\xE2u foarte faimos. Acest r\xE2u se nume\u0219te
      Sena."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307713
    m_Localized: "Ast\u0103zi, ve\u021Bi descoperi Sena \u0219i numeroasele sale
      poduri. Pe Sena, exist\u0103 tot felul de b\u0103rci."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307714
    m_Localized: "Grozav, ai finalizat aceast\u0103 misiune!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307715
    m_Localized: "Ai descoperit podurile \u0219i b\u0103rcile de pe Sena. Podurile
      \xEE\u021Bi permit s\u0103 traversezi r\xE2ul care curge prin Paris: Sena."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307716
    m_Localized: "Exist\u0103 b\u0103rci pentru turi\u0219ti. Au ferestre mari pentru
      a vedea monumentele Parisului de pe Sena."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307717
    m_Localized: "Exist\u0103 case plutitoare. Oamenii locuiesc pe aceste b\u0103rci.
      Se numesc barje."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307718
    m_Localized: "Monumente importante din Paris au fost construite \xEEn jurul Senei."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307719
    m_Localized: "Deseneaz\u0103 un pod \xEEn caietul t\u0103u!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307721
    m_Localized: "Mul\u021Bumesc!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307722
    m_Localized: "Ai g\u0103sit toate fotografiile din ghidul meu!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307723
    m_Localized: "\xCEn sf\xE2r\u0219it pot merge acas\u0103! Mai am o ultim\u0103
      \xEEntrebare\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502017
    m_Localized: "Dar \xEEmi lipsesc 7 fotografii despre poduri \u0219i b\u0103rci
      pe Sena!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502018
    m_Localized: "F\u0103 o plimbare pe malurile Senei \u0219i g\u0103se\u0219te
      fotografiile!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502019
    m_Localized: "Dac\u0103 nu le g\u0103si\u021Bi, pute\u021Bi folosi harta Parisului
      pentru a le localiza!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502020
    m_Localized: Te descurci bine!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502021
    m_Localized: "Ajutor! Ajut\u0103-m\u0103!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502022
    m_Localized: "Vizitez Parisul. Sunt turist. C\xE2inele Antura mi-a luat cartea
      despre Paris!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502023
    m_Localized: "Paginile c\u0103r\u021Bii mele \u0219i fotografiile au c\u0103zut
      l\xE2ng\u0103 Sena!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502024
    m_Localized: "Merge\u021Bi pe l\xE2ng\u0103 r\xE2u \u0219i ve\u021Bi g\u0103si
      fotografiile!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502025
    m_Localized: "Ai g\u0103sit toate fotografiile!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502026
    m_Localized: "\xCEntoarce-te \u0219i vorbe\u0219te cu turistul."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502029
    m_Localized: "R\xE2ul care curge prin Paris se nume\u0219te..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502030
    m_Localized: "Marea Mediteran\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502031
    m_Localized: "Acesta nu este r\u0103spunsul corect. Loara curge prin Nantes,
      \xEEn apropierea Muzeului Jules Verne."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502032
    m_Localized: "Canalul M\xE2necii"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502033
    m_Localized: "Da, este Sena. R\xE2ul care curge prin Paris se nume\u0219te Sena."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502034
    m_Localized: Oceanul Atlantic
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502037
    m_Localized: "Aceast\u0103 barc\u0103 transport\u0103 m\u0103rfuri."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502038
    m_Localized: "Ce po\u021Bi g\u0103si pe o nav\u0103 de marf\u0103?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502039
    m_Localized: "O nav\u0103 de marf\u0103 poate transporta: lemn, nisip, dar \u0219i
      obiecte: ma\u0219ini, mobil\u0103..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502040
    m_Localized: "Da! Acum po\u021Bi deschide cuf\u0103rul acela!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502041
    m_Localized: "Turi\u0219ti cu camere de filmat"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502042
    m_Localized: "Nu. \xCEncearc\u0103 din nou."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502043
    m_Localized: Vagoane de tren
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502045
    m_Localized: "Nu \u0219tiu"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502046
    m_Localized: "Revino mai t\xE2rziu."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502047
    m_Localized: "Joac\u0103 un mini-joc pentru a deschide cuf\u0103rul!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502048
    m_Localized: "Cuf\u0103rul se deschide. G\u0103se\u0219ti o fotografie!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502049
    m_Localized: "Cuf\u0103rul este gol."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502050
    m_Localized: "Pieptul este \xEEncuiat."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502051
    m_Localized: "Aceast\u0103 barc\u0103 este o cas\u0103. Sunt oameni care locuiesc
      pe aceast\u0103 barc\u0103. Aceast\u0103 barc\u0103 se nume\u0219te cas\u0103
      plutitoare."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502052
    m_Localized: "De ce se nume\u0219te aceast\u0103 barc\u0103 o cas\u0103 plutitoare?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502053
    m_Localized: "E posibil s\u0103 locuie\u0219ti acolo."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502055
    m_Localized: Este un pod pentru trenuri.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502057
    m_Localized: "Aceast\u0103 barc\u0103 transport\u0103 m\u0103rfuri"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502064
    m_Localized: "Aceast\u0103 barc\u0103 are ferestre mari. Turi\u0219tii pot admira
      ora\u0219ul. Este o \u201Ebarc\u0103 fluvial\u0103\u201D."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502065
    m_Localized: "De ce are o barc\u0103 turistic\u0103 ferestre mari?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502066
    m_Localized: "Pentru a vedea ora\u0219ul \u0219i locurile celebre"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502068
    m_Localized: "Pentru a transporta ma\u0219ini"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502070
    m_Localized: "A merge sub ap\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502077
    m_Localized: Acesta este Podul Alexandru al III-lea. Este un pod foarte faimos.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502078
    m_Localized: De ce este faimos acest pod?
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502079
    m_Localized: "Exist\u0103 statui f\u0103cute din aur."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502081
    m_Localized: Este un pod pentru trenuri.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502083
    m_Localized: "Este un pod pentru ma\u0219ini."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502090
    m_Localized: "E un pod pentru ma\u0219ini!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502091
    m_Localized: "Ma\u0219inile merg cu vitez\u0103. Cum pot traversa \xEEn siguran\u021B\u0103?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502092
    m_Localized: "Trebuie s\u0103 merge\u021Bi pe trotuar \u0219i s\u0103 traversa\u021Bi
      la trecerea de pietoni."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502094
    m_Localized: "Po\u021Bi traversa strada oriunde."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502096
    m_Localized: "Trebuie s\u0103 mergi pe drum"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502103
    m_Localized: E un pod pentru trenuri!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502104
    m_Localized: Un pod feroviar este un pod...
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502105
    m_Localized: Foarte puternic
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502107
    m_Localized: "pentru ma\u0219ini"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502109
    m_Localized: Doar pentru mers pe jos
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502116
    m_Localized: "Mi-ar pl\u0103cea s\u0103 merg cu trenul!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502117
    m_Localized: Iubesc trenurile!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502118
    m_Localized: Acesta este un pod pentru oameni!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502119
    m_Localized: "Un pod pe care doar oamenii pot merge se nume\u0219te..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502120
    m_Localized: "Pasarel\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502122
    m_Localized: Podul trenului
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502124
    m_Localized: "un pod pentru ma\u0219ini"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502131
    m_Localized: "Uit\u0103-te la aceast\u0103 hart\u0103 a Senei."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502132
    m_Localized: "Sena se vars\u0103 \xEEn Canalul M\xE2necii (o mare) \xEEn direc\u021Bia
      nordic\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502133
    m_Localized: "Nu, nu \u021Bi-am v\u0103zut c\xE2inele."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502134
    m_Localized: "Un c\xE2ine? Sunt mul\u021Bi c\xE2ini aici..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502135
    m_Localized: "Am v\u0103zut un c\xE2ine plimb\xE2ndu-se pe aici, da."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502136
    m_Localized: Uite ce frumos e!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502137
    m_Localized: "Exist\u0103 o insul\u0103 numit\u0103 \xCEle de la Cit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502138
    m_Localized: "Este \xEEn centrul vechi al Parisului."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502139
    m_Localized: "Sena se vars\u0103 \xEEn Canalul M\xE2necii."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502140
    m_Localized: "Bun\u0103 diminea\u0163a!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502141
    m_Localized: "Sena este magnific\u0103!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502142
    m_Localized: "Sunt multe poduri \xEEn Paris!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502143
    m_Localized: Hi!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502144
    m_Localized: "\xCEmi place foarte mult s\u0103 merg cu bicicleta de-a lungul
      Senei!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502145
    m_Localized: "Parisul este cel mai frumos ora\u0219 din lume!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502146
    m_Localized: "Sena e foarte lung\u0103!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502147
    m_Localized: "Un pod de cale ferat\u0103 trebuie s\u0103 fie rezistent."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502148
    m_Localized: Unele poduri sunt destinate exclusiv pietonilor.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502149
    m_Localized: "Ma\u0219inile traverseaz\u0103 r\xE2ul \xEEn fiecare zi."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502150
    m_Localized: "Sena permite circula\u021Bia ambarca\u021Biunilor \xEEn Paris."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502151
    m_Localized: "H\u0103r\u021Bile prezint\u0103 meandrele r\xE2ului."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502152
    m_Localized: "R\xE2ul se vars\u0103 \xEEn mare."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502153
    m_Localized: "B\u0103rcile turistice au ferestre mari."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502154
    m_Localized: "Navele de marf\u0103 transport\u0103 multe cutii."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502155
    m_Localized: "O cas\u0103 plutitoare poate fi o cas\u0103."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
