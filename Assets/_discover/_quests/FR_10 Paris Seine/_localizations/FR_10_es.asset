%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_10_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: b90ebc042e6dd4584b2dc55809f17693, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 58867199224307712
    m_Localized: "\xA1Bienvenidos a Par\xEDs! Par\xEDs es la capital de Francia.
      En Par\xEDs hay un r\xEDo muy famoso. Este r\xEDo se llama Sena."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307713
    m_Localized: "Hoy descubrir\xE1s el Sena y sus numerosos puentes. En el Sena
      hay todo tipo de embarcaciones."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307714
    m_Localized: "\xA1Genial, has completado esta misi\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307715
    m_Localized: "Descubriste los puentes y las barcas del Sena. Los puentes te permiten
      cruzar el r\xEDo que atraviesa Par\xEDs: el Sena."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307716
    m_Localized: "Hay barcos para turistas. Tienen grandes ventanas para contemplar
      los monumentos de Par\xEDs desde el Sena."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307717
    m_Localized: Hay casas flotantes. La gente vive en estos barcos. Se llaman barcazas.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307718
    m_Localized: "Importantes monumentos de Par\xEDs fueron construidos alrededor
      del Sena."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307719
    m_Localized: "\xA1Dibuja un puente en tu cuaderno!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307721
    m_Localized: "\xA1Gracias!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307722
    m_Localized: "\xA1Encontraste todas las fotos de mi gu\xEDa!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307723
    m_Localized: "\xA1Por fin puedo irme a casa! Tengo una \xFAltima pregunta\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502017
    m_Localized: "\xA1Pero me faltan 7 fotos de puentes y barcos en el Sena!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502018
    m_Localized: "\xA1Da un paseo por las orillas del Sena y encuentra las fotos!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502019
    m_Localized: "Si no los encuentras, \xA1puedes usar el mapa de Par\xEDs para
      localizarlos!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502020
    m_Localized: "\xA1Lo est\xE1s haciendo bien!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502021
    m_Localized: "\xA1Ayuda! \xA1Ay\xFAdenme!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502022
    m_Localized: "Estoy de visita en Par\xEDs. Soy turista. \xA1Antura, la perra,
      se llev\xF3 mi libro sobre Par\xEDs!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502023
    m_Localized: "\xA1Las p\xE1ginas de mi libro y las fotos cayeron cerca del Sena!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502024
    m_Localized: "\xA1Camina cerca del r\xEDo y encontrar\xE1s las fotos!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502025
    m_Localized: "\xA1Encontraste todas las fotos!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502026
    m_Localized: Vuelve y habla con el turista.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502029
    m_Localized: "El r\xEDo que atraviesa Par\xEDs se llama..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502030
    m_Localized: "El mar Mediterr\xE1neo"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502031
    m_Localized: "Esa no es la respuesta correcta. El Loira fluye a trav\xE9s de
      Nantes, cerca del Museo de Julio Verne."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502032
    m_Localized: El Canal de la Mancha
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502033
    m_Localized: "S\xED, es el Sena. El r\xEDo que atraviesa Par\xEDs se llama Sena."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502034
    m_Localized: "El oc\xE9ano Atl\xE1ntico"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502037
    m_Localized: "Este barco transporta mercanc\xEDas."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502038
    m_Localized: "\xBFQu\xE9 se puede encontrar en un barco de mercanc\xEDas?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502039
    m_Localized: "Un buque de mercanc\xEDas puede transportar: madera, arena, pero
      tambi\xE9n objetos: coches, muebles..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502040
    m_Localized: "\xA1S\xED! \xA1Ahora puedes abrir ese cofre!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502041
    m_Localized: "Turistas con c\xE1maras"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502042
    m_Localized: "No. Int\xE9ntalo de nuevo."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502043
    m_Localized: vagones de tren
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502045
    m_Localized: "No s\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502046
    m_Localized: "Vuelve m\xE1s tarde."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502047
    m_Localized: "\xA1Juega un minijuego para abrir el cofre!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502048
    m_Localized: "El cofre se abre. \xA1Encuentras una foto!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502049
    m_Localized: "El cofre est\xE1 vac\xEDo."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502050
    m_Localized: "El cofre est\xE1 cerrado con llave."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502051
    m_Localized: Este barco es una casa. Hay gente que vive en este barco. Este barco
      se llama casa flotante.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502052
    m_Localized: "\xBFPor qu\xE9 se llama casa flotante a esta embarcaci\xF3n?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502053
    m_Localized: "Es posible vivir all\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502055
    m_Localized: Es un puente para trenes.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502057
    m_Localized: "Este barco est\xE1 transportando mercanc\xEDas"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502064
    m_Localized: Este barco tiene grandes ventanas. Los turistas pueden admirar la
      ciudad. Es un "barco fluvial".
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502065
    m_Localized: "\xBFPor qu\xE9 un barco tur\xEDstico tiene ventanas grandes?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502066
    m_Localized: Para ver la ciudad y los lugares famosos
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502068
    m_Localized: Para transportar coches
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502070
    m_Localized: Para sumergirse en el agua
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502077
    m_Localized: Este es el puente Alejandro III. Es un puente muy famoso.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502078
    m_Localized: "\xBFPor qu\xE9 es famoso este puente?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502079
    m_Localized: Hay estatuas hechas de oro.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502081
    m_Localized: Es un puente para trenes.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502083
    m_Localized: Es un puente para coches.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502090
    m_Localized: "\xA1Es un puente para coches!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502091
    m_Localized: "Los coches van a toda velocidad. \xBFC\xF3mo puedo cruzar con seguridad?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502092
    m_Localized: Debes caminar por la acera y cruzar por el paso de peatones.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502094
    m_Localized: Puedes cruzar la calle en cualquier parte.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502096
    m_Localized: Tienes que caminar por la carretera
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502103
    m_Localized: "\xA1Es un puente para trenes!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502104
    m_Localized: Un puente ferroviario es un puente...
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502105
    m_Localized: "Ac\xE9rrimo"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502107
    m_Localized: para coches
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502109
    m_Localized: Solo para caminar
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502116
    m_Localized: "\xA1Me encantar\xEDa viajar en tren!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502117
    m_Localized: "\xA1Me encantan los trenes!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502118
    m_Localized: "\xA1Este es un puente para la gente!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502119
    m_Localized: Un puente solo para que la gente lo transite se llama...
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502120
    m_Localized: Puente peatonal
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502122
    m_Localized: Puente ferroviario
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502124
    m_Localized: un puente para coches
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502131
    m_Localized: Mira este mapa del Sena.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502132
    m_Localized: "El Sena desemboca en el Canal de la Mancha (un mar) en direcci\xF3n
      norte."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502133
    m_Localized: No, no he visto a tu perro.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502134
    m_Localized: "\xBFUn perro? Aqu\xED hay muchos perros..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502135
    m_Localized: "S\xED, vi un perro paseando por ah\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502136
    m_Localized: "\xA1Mira qu\xE9 bonito es!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502137
    m_Localized: "Hay una isla llamada \xCEle de la Cit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502138
    m_Localized: "Est\xE1 en el casco antiguo de Par\xEDs."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502139
    m_Localized: El Sena desemboca en el Canal de la Mancha.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502140
    m_Localized: "\xA1Buen d\xEDa!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502141
    m_Localized: La Seine est magnifique!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502142
    m_Localized: "\xA1Hay muchos puentes en Par\xEDs!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502143
    m_Localized: "\xA1Hola!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502144
    m_Localized: "\xA1Me encanta pasear en bicicleta a lo largo del Sena!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502145
    m_Localized: "\xA1Par\xEDs es la ciudad m\xE1s hermosa del mundo!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502146
    m_Localized: "\xA1El Sena es muy largo!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502147
    m_Localized: Un puente ferroviario debe ser resistente.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502148
    m_Localized: "Algunos puentes est\xE1n destinados exclusivamente a peatones."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502149
    m_Localized: "Todos los d\xEDas los coches cruzan el r\xEDo."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502150
    m_Localized: "El Sena permite la circulaci\xF3n de barcos en Par\xEDs."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502151
    m_Localized: "Los mapas muestran los meandros del r\xEDo."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502152
    m_Localized: "El r\xEDo desemboca en el mar."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502153
    m_Localized: "Los barcos tur\xEDsticos tienen ventanas grandes."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502154
    m_Localized: Los barcos de carga transportan muchas cajas.
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502155
    m_Localized: Una casa flotante puede ser un hogar.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
