%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_10_hu
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: hu
  m_SharedData: {fileID: 11400000, guid: b90ebc042e6dd4584b2dc55809f17693, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 58867199224307712
    m_Localized: "\xDCdv\xF6z\xF6lj\xFCk P\xE1rizsban! P\xE1rizs Franciaorsz\xE1g
      f\u0151v\xE1rosa. P\xE1rizsban van egy nagyon h\xEDres foly\xF3. Ezt a foly\xF3t
      Szajn\xE1nak h\xEDvj\xE1k."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307713
    m_Localized: "Ma felfedezheted a Szajn\xE1t \xE9s sz\xE1mos hidj\xE1t. A Szajn\xE1n
      mindenf\xE9le haj\xF3 tal\xE1lhat\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307714
    m_Localized: "Remek, teljes\xEDtetted ezt a k\xFCldet\xE9st!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307715
    m_Localized: "Felfedezted a Szajna h\xEDdjait \xE9s haj\xF3it. A hidak seg\xEDts\xE9g\xE9vel
      kelhetsz \xE1t a P\xE1rizson \xE1tfoly\xF3 foly\xF3n: a Szajn\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307716
    m_Localized: "Vannak haj\xF3k a turist\xE1k sz\xE1m\xE1ra. Nagy ablakokon kereszt\xFCl
      a Szajn\xE1r\xF3l is l\xE1that\xF3k P\xE1rizs m\u0171eml\xE9kei."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307717
    m_Localized: "Vannak lak\xF3haj\xF3k. Emberek laknak ezeken a haj\xF3kon. B\xE1rk\xE1knak
      h\xEDvj\xE1k \u0151ket."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307718
    m_Localized: "P\xE1rizsban fontos eml\xE9km\u0171veket \xE9p\xEDtettek a Szajna
      k\xF6rny\xE9k\xE9n."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307719
    m_Localized: "Rajzolj egy hidat a f\xFCzetedbe!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307721
    m_Localized: "K\xF6sz\xF6n\xF6m!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307722
    m_Localized: "Megtal\xE1ltad az \xF6sszes k\xE9pet az \xFAtmutat\xF3mb\xF3l!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199224307723
    m_Localized: "V\xE9gre hazamehetek! Van egy utols\xF3 k\xE9rd\xE9sem\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502017
    m_Localized: "De hi\xE1nyzik 7 fot\xF3 hidakr\xF3l \xE9s haj\xF3kr\xF3l a Szajn\xE1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502018
    m_Localized: "S\xE9t\xE1lj egyet a Szajna partj\xE1n, \xE9s keresd meg a fot\xF3kat!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502019
    m_Localized: "Ha nem tal\xE1lod \u0151ket, P\xE1rizs t\xE9rk\xE9p\xE9vel megkeresheted
      \u0151ket!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502020
    m_Localized: "J\xF3l csin\xE1lod!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502021
    m_Localized: "Seg\xEDts\xE9g! Seg\xEDts\xE9g!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502022
    m_Localized: "P\xE1rizsban vagyok. Turista vagyok. Antura, a kutya elvette a
      k\xF6nyvemet P\xE1rizsr\xF3l!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502023
    m_Localized: "A k\xF6nyvem lapjai \xE9s a fot\xF3k a Szajna k\xF6zel\xE9ben hullottak!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502024
    m_Localized: "S\xE9t\xE1lj k\xF6zel a foly\xF3hoz, \xE9s megtal\xE1lod a k\xE9peket!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502025
    m_Localized: "Megtal\xE1ltad az \xF6sszes k\xE9pet!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502026
    m_Localized: "Menj vissza, \xE9s besz\xE9lj a turist\xE1val."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502029
    m_Localized: "A P\xE1rizson \xE1tfoly\xF3 foly\xF3 neve..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502030
    m_Localized: "A F\xF6ldk\xF6zi-tenger"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502031
    m_Localized: "Ez nem a helyes v\xE1lasz. A Loire \xE1tfolyik Nantes-on, a Jules
      Verne M\xFAzeum k\xF6zel\xE9ben."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502032
    m_Localized: A La Manche csatorna
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502033
    m_Localized: "Igen, ez a Szajna. A P\xE1rizson \xE1tfoly\xF3 foly\xF3t Szajn\xE1nak
      h\xEDvj\xE1k."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502034
    m_Localized: "Az Atlanti-\xF3ce\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502037
    m_Localized: "Ez a haj\xF3 \xE1rut sz\xE1ll\xEDt."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502038
    m_Localized: "Mit tal\xE1lhatsz egy teherhaj\xF3n?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502039
    m_Localized: "Egy teherhaj\xF3 sz\xE1ll\xEDthat: f\xE1t, homokot, de t\xE1rgyakat
      is: aut\xF3kat, b\xFAtorokat..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502040
    m_Localized: "Igen! Most m\xE1r kinyithatod azt a l\xE1d\xE1t!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502041
    m_Localized: "Turist\xE1k kamer\xE1kkal"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502042
    m_Localized: "Nem. Pr\xF3b\xE1ld \xFAjra."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502043
    m_Localized: "Vas\xFAti kocsik"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502045
    m_Localized: Nem tudom
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502046
    m_Localized: "Gyere vissza k\xE9s\u0151bb."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502047
    m_Localized: "J\xE1tssz egy mini j\xE1t\xE9kot a l\xE1da kinyit\xE1s\xE1hoz!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502048
    m_Localized: "A l\xE1da kiny\xEDlik. Tal\xE1lsz egy fot\xF3t!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502049
    m_Localized: "A mellkas \xFCres."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502050
    m_Localized: "A mellkas z\xE1rva van."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502051
    m_Localized: "Ez a haj\xF3 egy h\xE1z. Emberek laknak ezen a haj\xF3n. Ezt a
      haj\xF3t lak\xF3haj\xF3nak h\xEDvj\xE1k."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502052
    m_Localized: "Mi\xE9rt h\xEDvj\xE1k ezt a haj\xF3t lak\xF3haj\xF3nak?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502053
    m_Localized: "Lehets\xE9ges ott \xE9lni."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502055
    m_Localized: "Ez egy h\xEDd a vonatok sz\xE1m\xE1ra."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502057
    m_Localized: "Ez a haj\xF3 \xE1rut sz\xE1ll\xEDt"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502064
    m_Localized: "Ennek a haj\xF3nak nagy ablakai vannak. A turist\xE1k megcsod\xE1lhatj\xE1k
      a v\xE1rost. Ez egy \"folyami haj\xF3\"."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502065
    m_Localized: "Mi\xE9rt van nagy ablaka egy turistahaj\xF3nak?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502066
    m_Localized: "L\xE1tni a v\xE1rost \xE9s a h\xEDres helyeket"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502068
    m_Localized: "Aut\xF3k sz\xE1ll\xEDt\xE1s\xE1ra"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502070
    m_Localized: "V\xEDz al\xE1 menni"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502077
    m_Localized: "Ez a III. S\xE1ndor h\xEDd. Nagyon h\xEDres h\xEDd."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502078
    m_Localized: "Mi\xE9rt h\xEDres ez a h\xEDd?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502079
    m_Localized: "Aranyb\xF3l k\xE9sz\xFClt szobrok vannak."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502081
    m_Localized: "Ez egy h\xEDd a vonatok sz\xE1m\xE1ra."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502083
    m_Localized: "Ez egy h\xEDd az aut\xF3k sz\xE1m\xE1ra."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502090
    m_Localized: "Ez egy h\xEDd az aut\xF3knak!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502091
    m_Localized: "Az aut\xF3k gyorsan mennek. Hogyan kelhetek \xE1t biztons\xE1gosan?"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502092
    m_Localized: "A j\xE1rd\xE1n kell haladni, \xE9s a gyalog\xE1tkel\u0151helyen
      kell \xE1tkelni."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502094
    m_Localized: "B\xE1rhol \xE1tkelhetsz az \xFAton."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502096
    m_Localized: "Az \xFAton kell gyalogolnod"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502103
    m_Localized: "Ez egy h\xEDd a vonatoknak!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502104
    m_Localized: "A vas\xFAti h\xEDd az egy h\xEDd..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502105
    m_Localized: "Nagyon er\u0151s"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502107
    m_Localized: "aut\xF3khoz"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502109
    m_Localized: "Csak gyalogl\xE1shoz"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502116
    m_Localized: "Im\xE1dn\xE9k vonatozni!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502117
    m_Localized: "Im\xE1dom a vonatokat!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502118
    m_Localized: "Ez egy h\xEDd az emberek\xE9rt!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502119
    m_Localized: "Az olyan hidat, amelyen csak emberek j\xE1rhatnak, hidaknak nevezik..."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502120
    m_Localized: "Gyalogh\xEDd"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502122
    m_Localized: "Vas\xFAti h\xEDd"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502124
    m_Localized: "egy h\xEDd aut\xF3knak"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502131
    m_Localized: "N\xE9zd meg ezt a Szajna t\xE9rk\xE9pet."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502132
    m_Localized: "A Szajna \xE9szaki ir\xE1nyban \xF6mlik a La Manche csatorn\xE1ba
      (egy tengerbe)."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502133
    m_Localized: "Nem, nem l\xE1ttam a kuty\xE1dat."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502134
    m_Localized: Egy kutya? Sok kutya van itt...
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502135
    m_Localized: "L\xE1ttam egy kuty\xE1t s\xE9t\xE1lni, igen."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502136
    m_Localized: "N\xE9zd, milyen sz\xE9p!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502137
    m_Localized: "Van egy \xCEle de la Cit\xE9 nev\u0171 sziget."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502138
    m_Localized: "P\xE1rizs r\xE9gi k\xF6zpontj\xE1ban tal\xE1lhat\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502139
    m_Localized: "A Szajna a La Manche csatorn\xE1ba \xF6mlik."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502140
    m_Localized: "J\xF3 reggelt!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502141
    m_Localized: "A Szajna csod\xE1latos!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502142
    m_Localized: "Rengeteg h\xEDd van P\xE1rizsban!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502143
    m_Localized: Szia!
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502144
    m_Localized: "Nagyon szeretek a Szajna ment\xE9n biciklizni!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502145
    m_Localized: "P\xE1rizs a vil\xE1g legszebb v\xE1rosa!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502146
    m_Localized: "A Szajna nagyon hossz\xFA!"
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502147
    m_Localized: "Egy vas\xFAti h\xEDdnak er\u0151snek kell lennie."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502148
    m_Localized: "N\xE9h\xE1ny h\xEDd csak gyalogosok sz\xE1m\xE1ra van fenntartva."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502149
    m_Localized: "Az aut\xF3k minden nap \xE1tkelnek a foly\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502150
    m_Localized: "A Szajna lehet\u0151v\xE9 teszi a haj\xF3k k\xF6zleked\xE9s\xE9t
      P\xE1rizsban."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502151
    m_Localized: "A t\xE9rk\xE9pek a foly\xF3 kanyarulatait mutatj\xE1k."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502152
    m_Localized: "A foly\xF3 a tengerbe \xF6mlik."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502153
    m_Localized: "A turistahaj\xF3knak nagy ablakaik vannak."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502154
    m_Localized: "A teherhaj\xF3k sok dobozt sz\xE1ll\xEDtanak."
    m_Metadata:
      m_Items: []
  - m_Id: 58867199228502155
    m_Localized: "Egy lak\xF3haj\xF3 is lehet otthon."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
