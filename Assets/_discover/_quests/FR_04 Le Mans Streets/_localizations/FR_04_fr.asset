MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_04_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: f7f8b5072cfba4608a8c85f60a8cde04, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 169314607104
    m_Localized: Voici la course automobile des 24 Heures du Mans.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801408
    m_Localized: "Les voitures sont tr\xE8s rapides !"
    m_Metadata:
      m_Items: []
  - m_Id: 169318801409
    m_Localized: Seuls les adultes peuvent les conduire.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801410
    m_Localized: "La course est termin\xE9e. Rentrez chez vous en train."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801411
    m_Localized: Ces voitures de course sont tellement rapides !
    m_Metadata:
      m_Items: []
  - m_Id: 169318801412
    m_Localized: Ceci est un panneau STOP.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801413
    m_Localized: "Vous n'avez pas fait attention. R\xE9essayez !"
    m_Metadata:
      m_Items: []
  - m_Id: 169318801414
    m_Localized: Ceci est un panneau DANGER.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801415
    m_Localized: JAUNE - LENT
    m_Metadata:
      m_Items: []
  - m_Id: 169318801416
    m_Localized: VERT - ALLEZ
    m_Metadata:
      m_Items: []
  - m_Id: 169318801417
    m_Localized: ROUGE - STOP
    m_Metadata:
      m_Items: []
  - m_Id: 169318801418
    m_Localized: Ce sont des feux de circulation.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801419
    m_Localized: "Ces rayures blanches repr\xE9sentent un passage pi\xE9ton."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801420
    m_Localized: "Sur la piste, on ne peut aller qu'\xE0 cette vitesse."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801421
    m_Localized: En ville, on roule lentement.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801422
    m_Localized: "Emm\xE8ne mon scooter \xE0 la gare."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801423
    m_Localized: Regardez les panneaux.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801424
    m_Localized: "Regardez des deux c\xF4t\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801425
    m_Localized: Cet homme est Lion
    m_Metadata:
      m_Items: []
  - m_Id: 169318801426
    m_Localized: Section scooters
    m_Metadata:
      m_Items: []
  - m_Id: 169318801427
    m_Localized: Ce sont des triangles.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801428
    m_Localized: "Il y a peut-\xEAtre quelque chose sur la route."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801429
    m_Localized: "Elle donne la priorit\xE9 aux pi\xE9tons."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801430
    m_Localized: "Arr\xEAtez-vous si quelqu'un veut traverser."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801431
    m_Localized: "Vous avez r\xE9ussi !"
    m_Metadata:
      m_Items: []
  - m_Id: 169318801432
    m_Localized: "Vous avez respect\xE9 les r\xE8gles."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801433
    m_Localized: "Vous \xEAtes excellent en mati\xE8re de s\xE9curit\xE9 routi\xE8re
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 902473647644672
    m_Localized: Bienvenue au Mans !
    m_Metadata:
      m_Items: []
  - m_Id: 1507427450085376
    m_Localized: "Il est temps de rentrer \xE0 la maison."
    m_Metadata:
      m_Items: []
  - m_Id: 1507427450085377
    m_Localized: "J'attendrai l\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1507427450085378
    m_Localized: "Arr\xEAtez-vous compl\xE8tement."
    m_Metadata:
      m_Items: []
  - m_Id: 1507427450085379
    m_Localized: Cela signifie ralentir.
    m_Metadata:
      m_Items: []
  - m_Id: 1507427450085380
    m_Localized: "Ralentissez \xE0 proximit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473600
    m_Localized: "La qu\xEAte est termin\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473601
    m_Localized: Dessinez un plan des rues autour de chez vous !
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473602
    m_Localized: "Regardez toujours des deux c\xF4t\xE9s avant de traverser la rue
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473603
    m_Localized: "Ne traversez jamais la rue en courant, m\xEAme si vous \xEAtes
      press\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473604
    m_Localized: "Regardez toujours des deux c\xF4t\xE9s avant de traverser la rue
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473605
    m_Localized: "Ne traversez jamais la rue en courant, m\xEAme si vous \xEAtes
      press\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742337
    m_Localized: Dessinez un plan des rues autour de chez vous !
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742338
    m_Localized: "Arrivez en toute s\xE9curit\xE9 \xE0 la gare."
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742339
    m_Localized: "Arr\xEAtez-vous au rouge. Avancez au vert."
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742342
    m_Localized: La course des 24 Heures du Mans dure 24 heures !
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742343
    m_Localized: Les voitures de course sont rapides sur circuit, pas sur route.
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742346
    m_Localized: Nous marchons sur le trottoir.
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742347
    m_Localized: "Nous nous arr\xEAtons et regardons avant de traverser."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849600
    m_Localized: Excellent travail !
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849601
    m_Localized: "Vous avez utilis\xE9 la signalisation pour rester en s\xE9curit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849602
    m_Localized: "La s\xE9curit\xE9 routi\xE8re peut \xEAtre amusante !"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849603
    m_Localized: Dessinez un plan des rues autour de chez vous !
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849604
    m_Localized: "Regardez toujours des deux c\xF4t\xE9s avant de traverser la rue
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849605
    m_Localized: "Ne traversez jamais la rue en courant, m\xEAme si vous \xEAtes
      press\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849606
    m_Localized: "Utilisez toujours un passage pi\xE9ton ou un passage couvert lorsqu'il
      est disponible !"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849607
    m_Localized: "Portez des v\xEAtements de couleur vive ou r\xE9fl\xE9chissants
      lorsque vous marchez la nuit !"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849608
    m_Localized: "N\u2019utilisez jamais votre t\xE9l\xE9phone ou vos \xE9couteurs
      en traversant la rue !"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849609
    m_Localized: La course des 24 Heures du Mans dure 24 heures !
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849610
    m_Localized: Les voitures de course sont rapides sur circuit, pas sur route.
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849611
    m_Localized: La vitesse est essentielle sur le circuit.
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849612
    m_Localized: "Dans les rues, nous avan\xE7ons lentement."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849613
    m_Localized: Nous marchons sur le trottoir.
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849614
    m_Localized: "Nous nous arr\xEAtons et regardons avant de traverser."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849615
    m_Localized: Nous attendons le feu vert.
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849616
    m_Localized: "Nous regardons \xE0 gauche et \xE0 droite pour rep\xE9rer les voitures."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849617
    m_Localized: Nous ne jouons pas dans la rue.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
