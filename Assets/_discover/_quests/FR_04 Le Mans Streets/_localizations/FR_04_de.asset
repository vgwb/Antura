  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_04_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: f7f8b5072cfba4608a8c85f60a8cde04, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 169314607104
    m_Localized: Das ist das 24-Stunden-Rennen von Le Mans.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801408
    m_Localized: Autos sind sehr schnell!
    m_Metadata:
      m_Items: []
  - m_Id: 169318801409
    m_Localized: "Nur Erwachsene d\xFCrfen sie fahren."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801410
    m_Localized: Das Rennen ist vorbei. Fahr mit dem Zug nach Hause.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801411
    m_Localized: Diese Rennwagen sind so schnell!
    m_Metadata:
      m_Items: []
  - m_Id: 169318801412
    m_Localized: Das ist ein Stoppschild.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801413
    m_Localized: Du hast nicht aufgepasst. Versuch es noch einmal!
    m_Metadata:
      m_Items: []
  - m_Id: 169318801414
    m_Localized: Dies ist ein GEFAHREN-Schild.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801415
    m_Localized: GELB - LANGSAM
    m_Metadata:
      m_Items: []
  - m_Id: 169318801416
    m_Localized: "GR\xDCN - LOS"
    m_Metadata:
      m_Items: []
  - m_Id: 169318801417
    m_Localized: "ROT \u2013 STOPP"
    m_Metadata:
      m_Items: []
  - m_Id: 169318801418
    m_Localized: Das sind Ampeln.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801419
    m_Localized: "Diese wei\xDFen Streifen markieren einen Zebrastreifen."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801420
    m_Localized: Nur auf der Rennstrecke kann man so schnell fahren.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801421
    m_Localized: "Auf den Stra\xDFen der Stadt fahren wir langsam."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801422
    m_Localized: Ich nehme meinen Roller mit zum Bahnhof.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801423
    m_Localized: Schau dir die Schilder an.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801424
    m_Localized: Schau in beide Richtungen.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801425
    m_Localized: Dieser Mann ist Leo.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801426
    m_Localized: Rollerbereich
    m_Metadata:
      m_Items: []
  - m_Id: 169318801427
    m_Localized: Es sind Dreiecke.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801428
    m_Localized: "M\xF6glicherweise ist etwas auf der Stra\xDFe."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801429
    m_Localized: "Es gew\xE4hrt Fu\xDFg\xE4ngern Vorfahrt."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801430
    m_Localized: "Anhalten, falls jemand die Stra\xDFe \xFCberqueren m\xF6chte."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801431
    m_Localized: Du hast es geschafft!
    m_Metadata:
      m_Items: []
  - m_Id: 169318801432
    m_Localized: Du hast dich an die Regeln gehalten.
    m_Metadata:
      m_Items: []
  - m_Id: 169318801433
    m_Localized: "Du bist gro\xDFartig, wenn es um Verkehrssicherheit geht!"
    m_Metadata:
      m_Items: []
  - m_Id: 902473647644672
    m_Localized: Willkommen in Le Mans!
    m_Metadata:
      m_Items: []
  - m_Id: 1507427450085376
    m_Localized: Zeit, nach Hause zu gehen.
    m_Metadata:
      m_Items: []
  - m_Id: 1507427450085377
    m_Localized: Ich werde dort warten.
    m_Metadata:
      m_Items: []
  - m_Id: 1507427450085378
    m_Localized: "Halten Sie vollst\xE4ndig an."
    m_Metadata:
      m_Items: []
  - m_Id: 1507427450085379
    m_Localized: Es bedeutet, langsamer zu machen.
    m_Metadata:
      m_Items: []
  - m_Id: 1507427450085380
    m_Localized: "Verlangsamen Sie in der N\xE4he."
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473600
    m_Localized: Die Suche ist beendet
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473601
    m_Localized: "Zeichne eine Karte der Stra\xDFen rund um dein Zuhause!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473602
    m_Localized: "Vor dem \xDCberqueren der Stra\xDFe immer nach links und rechts
      schauen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473603
    m_Localized: "\xDCberquere niemals die Stra\xDFe im Laufschritt, auch wenn du
      es eilig hast!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473604
    m_Localized: "Vor dem \xDCberqueren der Stra\xDFe immer nach links und rechts
      schauen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473605
    m_Localized: "\xDCberquere niemals die Stra\xDFe im Laufschritt, auch wenn du
      es eilig hast!"
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742337
    m_Localized: "Zeichne eine Karte der Stra\xDFen rund um dein Zuhause!"
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742338
    m_Localized: Kommen Sie sicher zum Bahnhof.
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742339
    m_Localized: "Bei Rot anhalten. Bei Gr\xFCn weiterfahren."
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742342
    m_Localized: Das 24-Stunden-Rennen von Le Mans dauert 24 Stunden!
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742343
    m_Localized: "Rennwagen sind auf der Rennstrecke schnell, nicht auf der Stra\xDFe."
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742346
    m_Localized: "Wir gehen auf dem B\xFCrgersteig."
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742347
    m_Localized: "Wir halten an und schauen uns um, bevor wir die Stra\xDFe \xFCberqueren."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849600
    m_Localized: Super gemacht!
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849601
    m_Localized: Du hast die Schilder benutzt, um dich in Sicherheit zu bringen.
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849602
    m_Localized: "Verkehrssicherheit kann Spa\xDF machen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849603
    m_Localized: "Zeichne eine Karte der Stra\xDFen rund um dein Zuhause!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849604
    m_Localized: "Vor dem \xDCberqueren der Stra\xDFe immer nach links und rechts
      schauen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849605
    m_Localized: "\xDCberquere niemals die Stra\xDFe im Laufschritt, auch wenn du
      es eilig hast!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849606
    m_Localized: "Benutzen Sie nach M\xF6glichkeit immer einen Zebrastreifen oder
      Fu\xDFg\xE4nger\xFCberweg!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849607
    m_Localized: Tragen Sie beim Nachtspaziergang helle oder reflektierende Kleidung!
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849608
    m_Localized: "Benutzen Sie beim \xDCberqueren der Stra\xDFe niemals Ihr Handy
      oder Ihre Kopfh\xF6rer!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849609
    m_Localized: Das 24-Stunden-Rennen von Le Mans dauert 24 Stunden!
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849610
    m_Localized: "Rennwagen sind auf der Rennstrecke schnell, nicht auf der Stra\xDFe."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849611
    m_Localized: "Geschwindigkeit geh\xF6rt auf die Rennstrecke."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849612
    m_Localized: "Auf den Stra\xDFen gehen wir langsam voran."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849613
    m_Localized: "Wir gehen auf dem B\xFCrgersteig."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849614
    m_Localized: "Wir halten an und schauen uns um, bevor wir die Stra\xDFe \xFCberqueren."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849615
    m_Localized: "Wir warten an der Ampel auf Gr\xFCn."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849616
    m_Localized: Wir schauen nach links und rechts, um Autos zu sehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849617
    m_Localized: "Wir spielen nicht auf der Stra\xDFe."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
