--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_04_hu
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: hu
  m_SharedData: {fileID: 11400000, guid: f7f8b5072cfba4608a8c85f60a8cde04, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 169314607104
    m_Localized: "Ez a Le Mans-i aut\xF3verseny."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801408
    m_Localized: "Az aut\xF3k nagyon gyorsak!"
    m_Metadata:
      m_Items: []
  - m_Id: 169318801409
    m_Localized: "Csak feln\u0151ttek vezethetik \u0151ket."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801410
    m_Localized: "V\xE9ge a versenynek. Menj haza vonattal."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801411
    m_Localized: "Annyira gyorsak ezek a versenyaut\xF3k!"
    m_Metadata:
      m_Items: []
  - m_Id: 169318801412
    m_Localized: "Ez egy STOP t\xE1bla."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801413
    m_Localized: "Nem figyelt\xE9l oda. Pr\xF3b\xE1ld \xFAjra!"
    m_Metadata:
      m_Items: []
  - m_Id: 169318801414
    m_Localized: "Ez egy VESZ\xC9LY jelz\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801415
    m_Localized: "S\xC1RGA - LASS\xDA"
    m_Metadata:
      m_Items: []
  - m_Id: 169318801416
    m_Localized: "Z\xD6LD - INDULJ"
    m_Metadata:
      m_Items: []
  - m_Id: 169318801417
    m_Localized: "PIROS - \xC1LLJ"
    m_Metadata:
      m_Items: []
  - m_Id: 169318801418
    m_Localized: "Ezek k\xF6zleked\xE9si l\xE1mp\xE1k."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801419
    m_Localized: "Ezek a feh\xE9r cs\xEDkok egy zebr\xE1n \xE1tkel\u0151helyet jelk\xE9peznek."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801420
    m_Localized: "Csak ilyen gyorsan lehet menni a p\xE1ly\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801421
    m_Localized: "A v\xE1rosi utc\xE1kon lassan haladunk."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801422
    m_Localized: "Vidd el a robog\xF3mat az \xE1llom\xE1sra."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801423
    m_Localized: "N\xE9zd a jeleket."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801424
    m_Localized: "N\xE9zz mindk\xE9t ir\xE1nyba."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801425
    m_Localized: "Ez a F\xC9RFI Leo"
    m_Metadata:
      m_Items: []
  - m_Id: 169318801426
    m_Localized: "Robog\xF3 r\xE9szleg"
    m_Metadata:
      m_Items: []
  - m_Id: 169318801427
    m_Localized: "Ezek h\xE1romsz\xF6gek."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801428
    m_Localized: "Valami lehet az \xFAton."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801429
    m_Localized: "Els\u0151bbs\xE9get biztos\xEDt a gyalogosoknak."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801430
    m_Localized: "\xC1llj meg, ha valaki \xE1t akar kelni."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801431
    m_Localized: "Siker\xFClt!"
    m_Metadata:
      m_Items: []
  - m_Id: 169318801432
    m_Localized: "K\xF6vetted a szab\xE1lyokat."
    m_Metadata:
      m_Items: []
  - m_Id: 169318801433
    m_Localized: "Nagyszer\u0171 vagy a k\xF6z\xFAti biztons\xE1gban!"
    m_Metadata:
      m_Items: []
  - m_Id: 902473647644672
    m_Localized: "\xDCdv\xF6zl\xFCnk Le Mans-ban!"
    m_Metadata:
      m_Items: []
  - m_Id: 1507427450085376
    m_Localized: Ideje hazamenni.
    m_Metadata:
      m_Items: []
  - m_Id: 1507427450085377
    m_Localized: "Ott fogok v\xE1rni."
    m_Metadata:
      m_Items: []
  - m_Id: 1507427450085378
    m_Localized: "\xC1llj meg eg\xE9szen."
    m_Metadata:
      m_Items: []
  - m_Id: 1507427450085379
    m_Localized: "Azt jelenti, hogy lass\xEDts."
    m_Metadata:
      m_Items: []
  - m_Id: 1507427450085380
    m_Localized: "Lass\xEDts le a k\xF6zel\xE9ben."
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473600
    m_Localized: "A k\xFCldet\xE9snek v\xE9ge"
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473601
    m_Localized: "Rajzolj t\xE9rk\xE9pet a h\xE1zad k\xF6r\xFCli utc\xE1kr\xF3l!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473602
    m_Localized: "Miel\u0151tt \xE1tkeln\xE9l az \xFAton, mindig n\xE9zz mindk\xE9t
      ir\xE1nyba!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473603
    m_Localized: "Soha ne szaladj \xE1t az utc\xE1n, m\xE9g akkor sem, ha sietsz!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473604
    m_Localized: "Miel\u0151tt \xE1tkeln\xE9l az \xFAton, mindig n\xE9zz mindk\xE9t
      ir\xE1nyba!"
    m_Metadata:
      m_Items: []
  - m_Id: 2248526808473605
    m_Localized: "Soha ne szaladj \xE1t az utc\xE1n, m\xE9g akkor sem, ha sietsz!"
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742337
    m_Localized: "Rajzolj t\xE9rk\xE9pet a h\xE1zad k\xF6r\xFCli utc\xE1kr\xF3l!"
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742338
    m_Localized: "\xC9rj el biztons\xE1gban a vas\xFAt\xE1llom\xE1sra."
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742339
    m_Localized: "Pirosn\xE1l \xE1llj meg, z\xF6ldn\xE9l menj tov\xE1bb."
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742342
    m_Localized: "A Le Mans-i verseny 24 \xF3r\xE1n \xE1t tart!"
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742343
    m_Localized: "A versenyaut\xF3k a p\xE1ly\xE1n mennek gyorsan, nem az utc\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742346
    m_Localized: "A j\xE1rd\xE1n s\xE9t\xE1lunk."
    m_Metadata:
      m_Items: []
  - m_Id: 2309037545742347
    m_Localized: "Meg\xE1llunk \xE9s k\xF6r\xFCln\xE9z\xFCnk, miel\u0151tt \xE1tkel\xFCnk."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849600
    m_Localized: "Nagyszer\u0171 munka!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849601
    m_Localized: "A jelz\xE9seket haszn\xE1ltad, hogy biztons\xE1gban maradj."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849602
    m_Localized: "A k\xF6z\xFAti biztons\xE1g lehet sz\xF3rakoztat\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849603
    m_Localized: "Rajzolj t\xE9rk\xE9pet a h\xE1zad k\xF6r\xFCli utc\xE1kr\xF3l!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849604
    m_Localized: "Miel\u0151tt \xE1tkeln\xE9l az \xFAton, mindig n\xE9zz mindk\xE9t
      ir\xE1nyba!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849605
    m_Localized: "Soha ne szaladj \xE1t az utc\xE1n, m\xE9g akkor sem, ha sietsz!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849606
    m_Localized: "Mindig haszn\xE1lj gyalog\xE1tkel\u0151helyet vagy zebr\xE1n l\xE9v\u0151
      \xE1tkel\u0151helyet, ha van r\xE1 lehet\u0151s\xE9g!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849607
    m_Localized: "\xC9jszaka s\xE9ta k\xF6zben \xE9l\xE9nk vagy f\xE9nyvisszaver\u0151
      ruh\xE1zatot viseljen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849608
    m_Localized: "Soha ne haszn\xE1lj telefont vagy fejhallgat\xF3t, amikor \xE1tkelsz
      az \xFAton!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849609
    m_Localized: "A Le Mans-i verseny 24 \xF3r\xE1n \xE1t tart!"
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849610
    m_Localized: "A versenyaut\xF3k a p\xE1ly\xE1n mennek gyorsan, nem az utc\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849611
    m_Localized: "A sebess\xE9g a k\xF6rp\xE1ly\xE1ra val\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849612
    m_Localized: "Lassan megy\xFCnk az utc\xE1kon."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849613
    m_Localized: "A j\xE1rd\xE1n s\xE9t\xE1lunk."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849614
    m_Localized: "Meg\xE1llunk \xE9s k\xF6r\xFCln\xE9z\xFCnk, miel\u0151tt \xE1tkel\xFCnk."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849615
    m_Localized: "Z\xF6ldre v\xE1runk a l\xE1mp\xE1n\xE1l."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849616
    m_Localized: "Jobbra-balra n\xE9z\xFCnk, aut\xF3kat keres\xFCnk."
    m_Metadata:
      m_Items: []
  - m_Id: 2383977661849617
    m_Localized: "Nem j\xE1tszunk az utc\xE1n."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
