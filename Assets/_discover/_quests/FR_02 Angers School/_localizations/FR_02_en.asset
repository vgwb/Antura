  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_02_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: a33cf71e477044299aba778db3c07af9, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 102163800064
    m_Localized: Welcome to Angers! Angers is a city in western France. Today is
      the first day of school! It's back to school!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994368
    m_Localized: School starts again in September. You are 10 years old and you are
      going into CM2.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994369
    m_Localized: Find your school and class!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994370
    m_Localized: 'Welcome! This is a preschool. It''s a school for children aged
      3 to 5. There are three classes in preschool: the youngest class, the middle
      class, and the oldest class.'
    m_Metadata:
      m_Items: []
  - m_Id: 102167994371
    m_Localized: You're too old. The elementary school is right next door. The students
      are between 6 and 10 years old.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994372
    m_Localized: 'Hello! Welcome! You''ve found your school. You''re in elementary
      school. There are 5 classes: CP, CE1, CE2, CM1 and CM2.'
    m_Metadata:
      m_Items: []
  - m_Id: 102167994373
    m_Localized: But you forgot to take your schoolbag.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994374
    m_Localized: You need your pencil case, your pencils, your notebooks and your
      books.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994375
    m_Localized: Hello! This is the school. The students are between 11 and 14 years
      old.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994376
    m_Localized: After CM2, students enter middle school. They start middle school
      at age 11. They enter 6th grade.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994377
    m_Localized: 'There are four grades in middle school: 6th, 5th, 4th and 3rd.'
    m_Metadata:
      m_Items: []
  - m_Id: 102167994378
    m_Localized: The students are called high school students. There are three classes
      in high school.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994379
    m_Localized: You are too young to enter middle or high school.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994380
    m_Localized: Hello! I found a schoolbag.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994384
    m_Localized: And there you go! Enter the classroom.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994385
    m_Localized: Come in! Your classroom is at the end of the corridor.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994386
    m_Localized: Find your class.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994387
    m_Localized: This is the first grade class.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994388
    m_Localized: Children start primary school at age 6 in CP.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994389
    m_Localized: This isn't your class. You're 10 years old. So you're in CM2.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994391
    m_Localized: This is the CE1 class.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994392
    m_Localized: First grade isn't your class. You're in fifth grade. Try again!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994393
    m_Localized: Hello! This is the CE2 class.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994394
    m_Localized: The students are 8 years old.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994395
    m_Localized: This isn't your class!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994397
    m_Localized: CM1 is the class after CE2.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994398
    m_Localized: Your classroom is very close!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994399
    m_Localized: And there you have it! This is your class. Welcome to CM2!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994400
    m_Localized: Take a seat at your table.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994401
    m_Localized: Take your pencil case and your notebook.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994402
    m_Localized: The teacher is there to help you learn.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994403
    m_Localized: You are going to do mathematics. You are going to learn to count,
      to calculate.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994404
    m_Localized: Rearrange the letters of the alphabet to spell the word SCHOOL.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994405
    m_Localized: Well done! You succeeded!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994408
    m_Localized: Well done! You wrote the word SCHOOL. You can go into the school.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994409
    m_Localized: You can take your seat. Here's your table and chair.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994410
    m_Localized: Find your schoolbag and then come back to see me.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994411
    m_Localized: Hello! At lunchtime, you can eat at the canteen or at home.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994412
    m_Localized: Look at the cafeteria menu.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994413
    m_Localized: 'At school, everyone is welcome: girls and boys,'
    m_Metadata:
      m_Items: []
  - m_Id: 102167994414
    m_Localized: regardless of their beliefs.
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824450
    m_Localized: Find your schoolbag so you can go to school.
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824449
    m_Localized: You've found your school!
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824448
    m_Localized: Find your class.
    m_Metadata:
      m_Items: []
  - m_Id: 960066824298496
    m_Localized: Find your school!
    m_Metadata:
      m_Items: []
  - m_Id: 1998423988363264
    m_Localized: That's not entirely accurate. Try again!
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660236
    m_Localized: At school, we learn to read, write, count and speak new languages.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660235
    m_Localized: There are holidays during the school year.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660234
    m_Localized: In France, school starts in September and ends in June.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660233
    m_Localized: I love doing sports with my class. Sometimes we go to the swimming
      pool.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660232
    m_Localized: I play football with my friends in the playground.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660231
    m_Localized: I like mathematics because I love doing calculations.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660230
    m_Localized: I love music and singing with my class.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660229
    m_Localized: I like to draw and color.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660228
    m_Localized: In the morning and afternoon, there is a recess. During recess,
      the children play in the playground.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660227
    m_Localized: Enjoy your food!
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660226
    m_Localized: Draw your classroom.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660225
    m_Localized: It's back to school!
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660224
    m_Localized: The game is over! Congratulations!
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660239
    m_Localized: At school, we learn to read and write.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660238
    m_Localized: At lunchtime, you can eat in the canteen or go home to eat.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660237
    m_Localized: Classes are held from 8 a.m. to 4 p.m.
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370887
    m_Localized: Sorry! That's not the right answer. Try again.
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370886
    m_Localized: Take it!
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370885
    m_Localized: Well done!
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370884
    m_Localized: Put the classes back in order.
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370883
    m_Localized: But first, you have to win it!
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370882
    m_Localized: Is this perhaps your book?
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370881
    m_Localized: These books are useful when learning to read. You learn the alphabet
      and letters with these books.
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370880
    m_Localized: Now, find your school!
    m_Metadata:
      m_Items: []
  - m_Id: 13528238370709505
    m_Localized: Go ask the people around you.
    m_Metadata:
      m_Items: []
  - m_Id: 13528238370709504
    m_Localized: Maybe someone took your book.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994396
    m_Localized: Hello! This is the class CM1.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
