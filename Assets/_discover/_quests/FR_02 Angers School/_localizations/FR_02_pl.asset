--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_02_pl
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: a33cf71e477044299aba778db3c07af9, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 102163800064
    m_Localized: "Witamy w Angers! Angers to miasto w zachodniej Francji. Dzi\u015B
      pierwszy dzie\u0144 szko\u0142y! Czas wraca\u0107 do szko\u0142y!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994368
    m_Localized: "Szko\u0142a zaczyna si\u0119 ponownie we wrze\u015Bniu. Masz 10
      lat i idziesz do CM2."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994369
    m_Localized: "Znajd\u017A swoj\u0105 szko\u0142\u0119 i klas\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994370
    m_Localized: "Witamy! To przedszkole. To szko\u0142a dla dzieci w wieku od 3
      do 5 lat. W przedszkolu s\u0105 trzy klasy: najm\u0142odsza, \u015Brednia i
      najstarsza."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994371
    m_Localized: "Jeste\u015B za stary. Szko\u0142a podstawowa jest tu\u017C obok.
      Uczniowie maj\u0105 od 6 do 10 lat."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994372
    m_Localized: "Witaj! Witamy! Znalaz\u0142e\u015B swoj\u0105 szko\u0142\u0119.
      Jeste\u015B w szkole podstawowej. Jest 5 klas: CP, CE1, CE2, CM1 i CM2."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994373
    m_Localized: "Ale zapomnia\u0142e\u015B zabra\u0107 plecaka szkolnego."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994374
    m_Localized: "Potrzebujesz pi\xF3rnika, o\u0142\xF3wk\xF3w, zeszyt\xF3w i ksi\u0105\u017Cek."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994375
    m_Localized: "Cze\u015B\u0107! To jest szko\u0142a. Uczniowie maj\u0105 od 11
      do 14 lat."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994376
    m_Localized: "Po uko\u0144czeniu CM2 uczniowie rozpoczynaj\u0105 nauk\u0119 w
      szkole \u015Bredniej. Rozpoczynaj\u0105 j\u0105 w wieku 11 lat i rozpoczynaj\u0105
      sz\xF3st\u0105 klas\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994377
    m_Localized: "Szko\u0142a \u015Brednia sk\u0142ada si\u0119 z czterech klas:
      6, 5, 4 i 3."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994378
    m_Localized: "Uczniowie nazywani s\u0105 uczniami szk\xF3\u0142 \u015Brednich.
      W szkole \u015Bredniej s\u0105 trzy klasy."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994379
    m_Localized: "Jeste\u015B za m\u0142ody, \u017Ceby i\u015B\u0107 do szko\u0142y
      \u015Bredniej lub gimnazjum."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994380
    m_Localized: "Cze\u015B\u0107! Znalaz\u0142em plecak szkolny."
    m_Metadata:
      m_Items: []
  - m_Id: 13528238370709505
    m_Localized: "Zapytaj ludzi wok\xF3\u0142 siebie."
    m_Metadata:
      m_Items: []
  - m_Id: 13528238370709504
    m_Localized: "By\u0107 mo\u017Ce kto\u015B zabra\u0142 Twoj\u0105 ksi\u0105\u017Ck\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994384
    m_Localized: I gotowe! Wchodzimy do klasy.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994385
    m_Localized: "Prosz\u0119! Wasza klasa jest na ko\u0144cu korytarza."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994386
    m_Localized: "Znajd\u017A swoj\u0105 klas\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994387
    m_Localized: To jest klasa pierwsza.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994388
    m_Localized: "Dzieci rozpoczynaj\u0105 nauk\u0119 w szkole podstawowej w wieku
      6 lat w CP."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994389
    m_Localized: "To nie twoja klasa. Masz 10 lat. Wi\u0119c jeste\u015B w CM2."
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370887
    m_Localized: "Przepraszamy! To nie jest prawid\u0142owa odpowied\u017A. Spr\xF3buj
      ponownie."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994391
    m_Localized: To jest klasa CE1.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994392
    m_Localized: "Pierwsza klasa to nie twoja klasa. Jeste\u015B w pi\u0105tej. Spr\xF3buj
      jeszcze raz!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994393
    m_Localized: "Cze\u015B\u0107! Tu klasa CE2."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994394
    m_Localized: "Uczniowie maj\u0105 8 lat."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994395
    m_Localized: "To nie s\u0105 twoje zaj\u0119cia!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994396
    m_Localized: "Cze\u015B\u0107! Tu klasa CM1."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994397
    m_Localized: "CM1 to klasa nast\u0119puj\u0105ca po CE2."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994398
    m_Localized: Twoja klasa jest bardzo blisko!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994399
    m_Localized: "I prosz\u0119! To wasza klasa. Witamy w CM2!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994400
    m_Localized: "Usi\u0105d\u017A przy stole."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994401
    m_Localized: "We\u017A pi\xF3rnik i notes."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994402
    m_Localized: "Nauczyciel jest po to, \u017Ceby pomaga\u0107 ci si\u0119 uczy\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994403
    m_Localized: "B\u0119dziesz uczy\u0107 si\u0119 matematyki. Nauczysz si\u0119
      liczy\u0107, kalkulowa\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994404
    m_Localized: "U\u0142\xF3\u017C litery alfabetu tak, aby powsta\u0142o s\u0142owo
      SZKO\u0141A."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994405
    m_Localized: "Brawo! Uda\u0142o Ci si\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370886
    m_Localized: "We\u017A to!"
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370885
    m_Localized: Dobrze zrobiony!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994408
    m_Localized: "Brawo! Napisa\u0142e\u015B s\u0142owo SZKO\u0141A. Mo\u017Cesz
      wej\u015B\u0107 do szko\u0142y."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994409
    m_Localized: "Mo\u017Cesz zaj\u0105\u0107 miejsce. Oto tw\xF3j stolik i krzes\u0142o."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994410
    m_Localized: "Znajd\u017A sw\xF3j plecak i wr\xF3\u0107 do mnie."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994411
    m_Localized: "Witaj! W porze lunchu mo\u017Cesz zje\u015B\u0107 w sto\u0142\xF3wce
      lub w domu."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994412
    m_Localized: "Sp\xF3jrz na menu kawiarni."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994413
    m_Localized: "W szkole mile widziani s\u0105 wszyscy: dziewcz\u0119ta i ch\u0142opcy,"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994414
    m_Localized: "niezale\u017Cnie od ich przekona\u0144."
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370884
    m_Localized: "Przywr\xF3\u0107 klasom porz\u0105dek."
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370883
    m_Localized: "Ale najpierw musisz wygra\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 960066824298496
    m_Localized: "Znajd\u017A swoj\u0105 szko\u0142\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824448
    m_Localized: "Znajd\u017A swoj\u0105 klas\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824449
    m_Localized: "Znalaz\u0142e\u015B swoj\u0105 szko\u0142\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824450
    m_Localized: "Znajd\u017A sw\xF3j plecak, \u017Ceby\u015B m\xF3g\u0142 p\xF3j\u015B\u0107
      do szko\u0142y."
    m_Metadata:
      m_Items: []
  - m_Id: 1998423988363264
    m_Localized: "To nie do ko\u0144ca prawda. Spr\xF3buj jeszcze raz!"
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370882
    m_Localized: "Czy to mo\u017Ce Twoja ksi\u0105\u017Cka?"
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370881
    m_Localized: "Te ksi\u0105\u017Cki s\u0105 przydatne podczas nauki czytania.
      Dzi\u0119ki nim nauczysz si\u0119 alfabetu i liter."
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370880
    m_Localized: "Teraz znajd\u017A swoj\u0105 szko\u0142\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660224
    m_Localized: "Gra sko\u0144czona! Gratulacje!"
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660225
    m_Localized: "Wracamy do szko\u0142y!"
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660226
    m_Localized: "Narysuj swoj\u0105 klas\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660227
    m_Localized: Smacznego!
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660228
    m_Localized: "Rano i po po\u0142udniu jest przerwa. Podczas przerwy dzieci bawi\u0105
      si\u0119 na placu zabaw."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660229
    m_Localized: "Lubi\u0119 rysowa\u0107 i kolorowa\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660230
    m_Localized: "Uwielbiam muzyk\u0119 i \u015Bpiewanie z moj\u0105 klas\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660231
    m_Localized: "Lubi\u0119 matematyk\u0119, bo uwielbiam wykonywa\u0107 obliczenia."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660232
    m_Localized: "Gram w pi\u0142k\u0119 no\u017Cn\u0105 z przyjaci\xF3\u0142mi na
      placu zabaw."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660233
    m_Localized: "Uwielbiam uprawia\u0107 sport z moj\u0105 klas\u0105. Czasami chodzimy
      na basen."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660234
    m_Localized: "We Francji szko\u0142a zaczyna si\u0119 we wrze\u015Bniu i ko\u0144czy
      w czerwcu."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660235
    m_Localized: "W ci\u0105gu roku szkolnego s\u0105 \u015Bwi\u0119ta."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660236
    m_Localized: "W szkole uczymy si\u0119 czyta\u0107, pisa\u0107, liczy\u0107 i
      m\xF3wi\u0107 w nowych j\u0119zykach."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660237
    m_Localized: "Zaj\u0119cia odbywaj\u0105 si\u0119 w godzinach 8:00-16:00."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660238
    m_Localized: "W porze lunchu mo\u017Cesz zje\u015B\u0107 posi\u0142ek w sto\u0142\xF3wce
      lub p\xF3j\u015B\u0107 do domu."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660239
    m_Localized: "W szkole uczymy si\u0119 czyta\u0107 i pisa\u0107."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
