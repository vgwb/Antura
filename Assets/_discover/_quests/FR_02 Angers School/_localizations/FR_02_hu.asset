%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_02_hu
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: hu
  m_SharedData: {fileID: 11400000, guid: a33cf71e477044299aba778db3c07af9, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 102163800064
    m_Localized: "\xDCdv\xF6zl\xFCnk Angers-ben! Angers egy v\xE1ros Nyugat-Franciaorsz\xE1gban.
      Ma van az els\u0151 tan\xEDt\xE1si nap! Vissza az iskol\xE1ba!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994368
    m_Localized: "Szeptemberben \xFAjra kezd\u0151dik az iskola. 10 \xE9ves leszel,
      \xE9s a CM2-be m\xE9sz."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994369
    m_Localized: "Keresd meg az iskol\xE1dat \xE9s az oszt\xE1lyodat!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994370
    m_Localized: "\xDCdv\xF6z\xF6lj\xFCk! Ez egy \xF3voda. 3-5 \xE9ves gyermekek
      iskol\xE1ja. Az \xF3vod\xE1ban h\xE1rom oszt\xE1ly van: a legfiatalabb, a k\xF6z\xE9ps\u0151
      \xE9s a legid\u0151sebb oszt\xE1ly."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994371
    m_Localized: "T\xFAl \xF6reg vagy. Az \xE1ltal\xE1nos iskola itt van a szomsz\xE9dban.
      A di\xE1kok 6 \xE9s 10 \xE9v k\xF6z\xF6ttiek."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994372
    m_Localized: "Szia! \xDCdv\xF6zl\xFCnk! Megtal\xE1ltad az iskol\xE1dat. \xC1ltal\xE1nos
      iskol\xE1ba j\xE1rsz. 5 \xE9vfolyam van: CP, CE1, CE2, CM1 \xE9s CM2."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994373
    m_Localized: "De elfelejtetted magaddal vinni az iskolat\xE1sk\xE1dat."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994374
    m_Localized: "Sz\xFCks\xE9ged lesz a tolltart\xF3dra, a ceruz\xE1idra, a jegyzetf\xFCzeteidre
      \xE9s a k\xF6nyveidre."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994375
    m_Localized: "\xDCdv\xF6zl\xF6m! Ez az iskola. A di\xE1kok 11 \xE9s 14 \xE9v
      k\xF6z\xF6ttiek."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994376
    m_Localized: "A CM2 ut\xE1n a di\xE1kok bel\xE9pnek a k\xF6z\xE9piskol\xE1ba.
      11 \xE9ves korukban kezdik a k\xF6z\xE9piskol\xE1t. 6. oszt\xE1lyba l\xE9pnek."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994377
    m_Localized: "A k\xF6z\xE9piskol\xE1ban n\xE9gy \xE9vfolyam van: hatodik, \xF6t\xF6dik,
      negyedik \xE9s harmadik."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994378
    m_Localized: "A di\xE1kokat k\xF6z\xE9piskol\xE1soknak h\xEDvj\xE1k. A k\xF6z\xE9piskol\xE1ban
      h\xE1rom oszt\xE1ly van."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994379
    m_Localized: "T\xFAl fiatal vagy ahhoz, hogy beiratkozz \xE1ltal\xE1nos iskol\xE1ba
      vagy gimn\xE1ziumba."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994380
    m_Localized: "Sziasztok! Tal\xE1ltam egy iskolat\xE1sk\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 13528238370709505
    m_Localized: "Menj, k\xE9rdezd meg a k\xF6r\xFCl\xF6tted \xE9l\u0151ket."
    m_Metadata:
      m_Items: []
  - m_Id: 13528238370709504
    m_Localized: "Lehet, hogy valaki elvette a k\xF6nyvedet."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994384
    m_Localized: "\xC9s tess\xE9k! L\xE9pj be a tanterembe."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994385
    m_Localized: "Gyere be! A tantermed a folyos\xF3 v\xE9g\xE9n van."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994386
    m_Localized: "Keresd meg az oszt\xE1lyodat."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994387
    m_Localized: "Ez az els\u0151 oszt\xE1ly."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994388
    m_Localized: "A gyerekek 6 \xE9ves korukban kezdik az \xE1ltal\xE1nos iskol\xE1t
      CP-ben."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994389
    m_Localized: "Ez nem a te \xF3r\xE1d. 10 \xE9ves vagy. Sz\xF3val a CM2-be j\xE1rsz."
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370887
    m_Localized: "Sajn\xE1lom! Ez nem a helyes v\xE1lasz. Pr\xF3b\xE1ld \xFAjra."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994391
    m_Localized: "Ez a CE1 oszt\xE1ly."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994392
    m_Localized: "Az els\u0151 oszt\xE1ly nem a te oszt\xE1lyod. \xD6t\xF6dik oszt\xE1lyos
      vagy. Pr\xF3b\xE1ld \xFAjra!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994393
    m_Localized: "Hell\xF3! Ez a CE2 oszt\xE1ly."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994394
    m_Localized: "A di\xE1kok 8 \xE9vesek."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994395
    m_Localized: "Ez nem a te oszt\xE1lyod!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994396
    m_Localized: "Sziasztok! Ez a CM1 oszt\xE1ly."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994397
    m_Localized: "A CM1 a CE2 ut\xE1ni oszt\xE1ly."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994398
    m_Localized: "Nagyon k\xF6zel van az oszt\xE1lytermed!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994399
    m_Localized: "\xC9s tess\xE9k! Ez a te \xF3r\xE1d. \xDCdv\xF6zl\xFCnk a CM2-ben!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994400
    m_Localized: "Foglalj helyet az asztalodn\xE1l."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994401
    m_Localized: "Fogd a tolltart\xF3dat \xE9s a jegyzetf\xFCzetedet."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994402
    m_Localized: "A tan\xE1r az\xE9rt van ott, hogy seg\xEDtsen neked tanulni."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994403
    m_Localized: "Matematik\xE1t fogsz tanulni. Meg fogsz tanulni sz\xE1molni, kalkul\xE1lni."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994404
    m_Localized: "Rendezd \xE1t az \xE1b\xE9c\xE9 bet\u0171it, hogy ki\xEDrjad az
      ISKOLA sz\xF3t."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994405
    m_Localized: "Sz\xE9p munka! Siker\xFClt!"
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370886
    m_Localized: Vedd el!
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370885
    m_Localized: "Gratul\xE1lok!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994408
    m_Localized: "Sz\xE9p munka! Le\xEDrtad az ISKOLA sz\xF3t. Bemehetsz az iskol\xE1ba."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994409
    m_Localized: "Foglalhatsz helyet. Itt az asztalod \xE9s a sz\xE9ked."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994410
    m_Localized: "Keresd meg az iskolat\xE1sk\xE1dat, \xE9s azt\xE1n gyere vissza
      hozz\xE1m."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994411
    m_Localized: "Hell\xF3! Eb\xE9did\u0151ben ehetsz a menz\xE1n vagy otthon is."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994412
    m_Localized: "N\xE9zd meg a menza \xE9tlapj\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994413
    m_Localized: "Az iskol\xE1ban mindenkit sz\xEDvesen l\xE1tunk: l\xE1nyokat \xE9s
      fi\xFAkat egyar\xE1nt."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994414
    m_Localized: "f\xFCggetlen\xFCl a meggy\u0151z\u0151d\xE9s\xFCkt\u0151l."
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370884
    m_Localized: "Rakd vissza az oszt\xE1lyokat a helyes sorrendbe."
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370883
    m_Localized: "De el\u0151sz\xF6r is meg kell nyerned!"
    m_Metadata:
      m_Items: []
  - m_Id: 960066824298496
    m_Localized: "Keresd meg az iskol\xE1dat!"
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824448
    m_Localized: "Keresd meg az oszt\xE1lyodat."
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824449
    m_Localized: "Megtal\xE1ltad az iskol\xE1dat!"
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824450
    m_Localized: "Keresd meg az iskolat\xE1sk\xE1dat, hogy el tudj menni iskol\xE1ba."
    m_Metadata:
      m_Items: []
  - m_Id: 1998423988363264
    m_Localized: "Ez nem teljesen pontos. Pr\xF3b\xE1ld \xFAjra!"
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370882
    m_Localized: "Tal\xE1n ez a te k\xF6nyved?"
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370881
    m_Localized: "Ezek a k\xF6nyvek hasznosak az olvas\xE1s tanul\xE1sakor. Megtanulod
      az \xE1b\xE9c\xE9t \xE9s a bet\u0171ket ezekkel a k\xF6nyvekkel."
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370880
    m_Localized: "Most pedig keresd meg az iskol\xE1dat!"
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660224
    m_Localized: "V\xE9ge a j\xE1t\xE9knak! Gratul\xE1lunk!"
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660225
    m_Localized: "Vissza az iskol\xE1ba!"
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660226
    m_Localized: "Rajzold le az oszt\xE1lytermedet."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660227
    m_Localized: "J\xF3 \xE9tv\xE1gyat az \xE9teledhez!"
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660228
    m_Localized: "D\xE9lel\u0151tt \xE9s d\xE9lut\xE1n sz\xFCnet van. Sz\xFCnet alatt
      a gyerekek a j\xE1tsz\xF3t\xE9ren j\xE1tszanak."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660229
    m_Localized: "Szeretek rajzolni \xE9s sz\xEDnezni."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660230
    m_Localized: "Szeretem a zen\xE9t \xE9s az oszt\xE1lyommal \xE9nekelni."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660231
    m_Localized: "Szeretem a matematik\xE1t, mert szeretek sz\xE1molni."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660232
    m_Localized: "Focizom a bar\xE1taimmal a j\xE1tsz\xF3t\xE9ren."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660233
    m_Localized: "Szeretek sportolni az oszt\xE1lyommal. N\xE9ha elmegy\xFCnk az
      uszod\xE1ba."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660234
    m_Localized: "Franciaorsz\xE1gban az iskola szeptemberben kezd\u0151dik \xE9s
      j\xFAniusban \xE9r v\xE9get."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660235
    m_Localized: "Vannak \xFCnnepek a tan\xE9v alatt."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660236
    m_Localized: "Az iskol\xE1ban megtanulunk olvasni, \xEDrni, sz\xE1molni \xE9s
      \xFAj nyelveket besz\xE9lni."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660237
    m_Localized: "Az \xF3r\xE1k reggel 8-t\xF3l d\xE9lut\xE1n 4-ig tartanak."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660238
    m_Localized: "Eb\xE9did\u0151ben ehetsz a menz\xE1ban, vagy hazamehetsz enni."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660239
    m_Localized: "Az iskol\xE1ban megtanulunk olvasni \xE9s \xEDrni."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
