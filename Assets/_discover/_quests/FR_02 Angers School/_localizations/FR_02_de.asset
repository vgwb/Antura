  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_02_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: a33cf71e477044299aba778db3c07af9, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 102163800064
    m_Localized: Willkommen in Angers! Angers ist eine Stadt in Westfrankreich. Heute
      ist der erste Schultag! Es geht wieder los in der Schule!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994368
    m_Localized: Die Schule beginnt wieder im September. Du bist 10 Jahre alt und
      kommst in die CM2. Klasse.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994369
    m_Localized: Finde deine Schule und Klasse!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994370
    m_Localized: "Herzlich willkommen! Dies ist ein Kindergarten. Es ist eine Einrichtung
      f\xFCr Kinder im Alter von 3 bis 5 Jahren. Der Kindergarten ist in drei Gruppen
      unterteilt: die j\xFCngste, die mittlere und die \xE4lteste Gruppe."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994371
    m_Localized: "Du bist zu alt. Die Grundschule ist gleich nebenan. Die Sch\xFCler
      sind zwischen 6 und 10 Jahre alt."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994372
    m_Localized: 'Hallo! Willkommen! Du hast deine Schule gefunden. Du bist in der
      Grundschule. Es gibt 5 Klassen: CP, CE1, CE2, CM1 und CM2.'
    m_Metadata:
      m_Items: []
  - m_Id: 102167994373
    m_Localized: Aber du hast vergessen, deine Schultasche mitzunehmen.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994374
    m_Localized: "Du brauchst dein Federm\xE4ppchen, deine Stifte, deine Notizb\xFCcher
      und deine B\xFCcher."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994375
    m_Localized: "Hallo! Das ist die Schule. Die Sch\xFCler sind zwischen 11 und
      14 Jahre alt."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994376
    m_Localized: "Nach der zweiten Klasse (CM2) wechseln die Sch\xFCler in die Mittelschule.
      Sie beginnen die Mittelschule im Alter von 11 Jahren und kommen in die sechste
      Klasse."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994377
    m_Localized: 'Die Mittelschule ist in vier Klassenstufen unterteilt: 6., 5.,
      4. und 3.'
    m_Metadata:
      m_Items: []
  - m_Id: 102167994378
    m_Localized: "Die Sch\xFCler werden als Gymnasiasten bezeichnet. Das Gymnasium
      hat drei Klassenstufen."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994379
    m_Localized: "Du bist noch zu jung f\xFCr die Mittel- oder Oberstufe."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994380
    m_Localized: Hallo! Ich habe eine Schultasche gefunden.
    m_Metadata:
      m_Items: []
  - m_Id: 13528238370709505
    m_Localized: Frag doch einfach die Leute in deiner Umgebung.
    m_Metadata:
      m_Items: []
  - m_Id: 13528238370709504
    m_Localized: Vielleicht hat jemand dein Buch mitgenommen.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994384
    m_Localized: Und los geht's! Betretet das Klassenzimmer.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994385
    m_Localized: Komm herein! Dein Klassenzimmer befindet sich am Ende des Flurs.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994386
    m_Localized: Finde deinen Kurs.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994387
    m_Localized: Das ist die erste Klasse.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994388
    m_Localized: In CP beginnen die Kinder mit 6 Jahren die Grundschule.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994389
    m_Localized: Das ist nicht deine Klasse. Du bist 10 Jahre alt. Also bist du in
      CM2.
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370887
    m_Localized: Entschuldigung! Das ist nicht die richtige Antwort. Versuchen Sie
      es erneut.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994391
    m_Localized: Dies ist die CE1-Klasse.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994392
    m_Localized: "Du bist nicht in der ersten Klasse. Du bist in der f\xFCnften Klasse.
      Versuch es nochmal!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994393
    m_Localized: Hallo! Dies ist der CE2-Kurs.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994394
    m_Localized: "Die Sch\xFCler sind 8 Jahre alt."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994395
    m_Localized: Das ist nicht dein Unterricht!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994396
    m_Localized: Hallo! Dies ist die Klasse CM1.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994397
    m_Localized: CM1 ist die Klasse nach CE2.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994398
    m_Localized: "Ihr Klassenzimmer ist ganz in der N\xE4he!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994399
    m_Localized: Und da haben Sie es! Das ist Ihr Kurs. Willkommen bei CM2!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994400
    m_Localized: Nehmen Sie an Ihrem Tisch Platz.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994401
    m_Localized: "Nimm dein Federm\xE4ppchen und dein Notizbuch mit."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994402
    m_Localized: Der Lehrer ist da, um Ihnen beim Lernen zu helfen.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994403
    m_Localized: "Du wirst Mathematik lernen. Du wirst lernen zu z\xE4hlen und zu
      rechnen."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994404
    m_Localized: Ordne die Buchstaben des Alphabets so an, dass das Wort SCHOOL entsteht.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994405
    m_Localized: Gut gemacht! Du hast es geschafft!
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370886
    m_Localized: Nimm es!
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370885
    m_Localized: Gut gemacht!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994408
    m_Localized: Gut gemacht! Du hast das Wort SCHULE geschrieben. Du kannst jetzt
      in die Schule gehen.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994409
    m_Localized: "Sie k\xF6nnen Platz nehmen. Hier sind Ihr Tisch und Ihr Stuhl."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994410
    m_Localized: Finde deine Schultasche und komm dann wieder zu mir.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994411
    m_Localized: "Hallo! Mittags k\xF6nnen Sie in der Kantine oder zu Hause essen."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994412
    m_Localized: Schau dir den Speiseplan der Cafeteria an.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994413
    m_Localized: "In der Schule ist jeder willkommen: M\xE4dchen und Jungen."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994414
    m_Localized: "unabh\xE4ngig von ihren \xDCberzeugungen."
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370884
    m_Localized: Bringt die Klassen wieder in die richtige Reihenfolge.
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370883
    m_Localized: Aber zuerst musst du es gewinnen!
    m_Metadata:
      m_Items: []
  - m_Id: 960066824298496
    m_Localized: Finde deine Schule!
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824448
    m_Localized: Finde deinen Kurs.
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824449
    m_Localized: Du hast deine Schule gefunden!
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824450
    m_Localized: Finde deine Schultasche, damit du zur Schule gehen kannst.
    m_Metadata:
      m_Items: []
  - m_Id: 1998423988363264
    m_Localized: Das stimmt so nicht ganz. Versuchen Sie es noch einmal!
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370882
    m_Localized: Ist das vielleicht Ihr Buch?
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370881
    m_Localized: "Diese B\xFCcher sind hilfreich beim Lesenlernen. Mit ihnen lernt
      man das Alphabet und die Buchstaben."
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370880
    m_Localized: Finde nun deine Schule!
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660224
    m_Localized: "Das Spiel ist vorbei! Herzlichen Gl\xFCckwunsch!"
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660225
    m_Localized: Die Schule beginnt wieder!
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660226
    m_Localized: Zeichne dein Klassenzimmer.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660227
    m_Localized: Guten Appetit!
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660228
    m_Localized: "Vormittags und nachmittags gibt es eine Pause. W\xE4hrend der Pause
      spielen die Kinder auf dem Spielplatz."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660229
    m_Localized: Ich zeichne und male gern.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660230
    m_Localized: Ich liebe Musik und singe gerne mit meiner Klasse.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660231
    m_Localized: Ich mag Mathematik, weil ich gerne rechne.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660232
    m_Localized: "Ich spiele mit meinen Freunden auf dem Spielplatz Fu\xDFball."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660233
    m_Localized: Ich liebe es, mit meiner Klasse Sport zu treiben. Manchmal gehen
      wir ins Schwimmbad.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660234
    m_Localized: In Frankreich beginnt die Schule im September und endet im Juni.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660235
    m_Localized: "Es gibt Ferien w\xE4hrend des Schuljahres."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660236
    m_Localized: In der Schule lernen wir lesen, schreiben, rechnen und neue Sprachen
      sprechen.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660237
    m_Localized: Der Unterricht findet von 8:00 bis 16:00 Uhr statt.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660238
    m_Localized: "Mittags k\xF6nnen Sie in der Kantine essen oder nach Hause gehen
      und dort essen."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660239
    m_Localized: In der Schule lernen wir lesen und schreiben.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
