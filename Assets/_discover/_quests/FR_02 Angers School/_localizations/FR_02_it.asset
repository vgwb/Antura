%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_02_it
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: a33cf71e477044299aba778db3c07af9, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 102163800064
    m_Localized: "Benvenuti ad Angers! Angers \xE8 una citt\xE0 nella Francia occidentale.
      Oggi \xE8 il primo giorno di scuola! Si torna a scuola!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994368
    m_Localized: La scuola ricomincia a settembre. Hai 10 anni e frequenterai la
      classe CM2.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994369
    m_Localized: Trova la tua scuola e la tua classe!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994370
    m_Localized: "Benvenuti! Questa \xE8 una scuola materna. \xC8 una scuola per
      bambini dai 3 ai 5 anni. Ci sono tre classi nella scuola materna: la classe
      dei pi\xF9 piccoli, la classe intermedia e la classe dei pi\xF9 grandi."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994371
    m_Localized: "Sei troppo grande. La scuola elementare \xE8 proprio qui accanto.
      Gli alunni hanno tra i 6 e i 10 anni."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994372
    m_Localized: 'Ciao! Benvenuto! Hai trovato la tua scuola. Sei alla scuola elementare.
      Ci sono 5 classi: CP, CE1, CE2, CM1 e CM2.'
    m_Metadata:
      m_Items: []
  - m_Id: 102167994373
    m_Localized: Ma hai dimenticato di portare la cartella.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994374
    m_Localized: Ti servono l'astuccio, le matite, i quaderni e i libri.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994375
    m_Localized: "Ciao! Questa \xE8 la scuola. Gli studenti hanno un'et\xE0 compresa
      tra gli 11 e i 14 anni."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994376
    m_Localized: "Dopo il CM2, gli studenti accedono alla scuola media. Iniziano
      la scuola media all'et\xE0 di 11 anni, entrando in sesta elementare."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994377
    m_Localized: 'Nella scuola media ci sono quattro classi: sesta, quinta, quarta
      e terza.'
    m_Metadata:
      m_Items: []
  - m_Id: 102167994378
    m_Localized: Gli studenti si chiamano studenti delle scuole superiori. Ci sono
      tre classi nelle scuole superiori.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994379
    m_Localized: Sei troppo giovane per iscriverti alle scuole medie o superiori.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994380
    m_Localized: Ciao! Ho trovato uno zaino scolastico.
    m_Metadata:
      m_Items: []
  - m_Id: 13528238370709505
    m_Localized: Chiedi alle persone che ti circondano.
    m_Metadata:
      m_Items: []
  - m_Id: 13528238370709504
    m_Localized: Forse qualcuno ha preso il tuo libro.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994384
    m_Localized: Ed ecco fatto! Entrate in classe.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994385
    m_Localized: "Entrate! La vostra aula \xE8 in fondo al corridoio."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994386
    m_Localized: Trova la tua classe.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994387
    m_Localized: "Questa \xE8 la classe prima elementare."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994388
    m_Localized: "Nel programma CP, i bambini iniziano la scuola primaria all'et\xE0
      di 6 anni."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994389
    m_Localized: "Questa non \xE8 la tua classe. Hai 10 anni. Quindi sei in CM2."
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370887
    m_Localized: "Spiacente! Non \xE8 la risposta corretta. Riprova."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994391
    m_Localized: "Questa \xE8 la classe CE1."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994392
    m_Localized: "La prima elementare non \xE8 la tua classe. Sei in quinta elementare.
      Riprova!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994393
    m_Localized: "Ciao! Questa \xE8 la classe CE2."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994394
    m_Localized: Gli studenti hanno 8 anni.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994395
    m_Localized: "Questa non \xE8 la tua classe!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994396
    m_Localized: "Ciao! Questa \xE8 la classe CM1."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994397
    m_Localized: "CM1 \xE8 il corso successivo a CE2."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994398
    m_Localized: "La tua aula \xE8 vicinissima!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994399
    m_Localized: "Ed ecco fatto! Questa \xE8 la tua classe. Benvenuto in CM2!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994400
    m_Localized: Prendete posto al vostro tavolo.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994401
    m_Localized: Prendi il tuo astuccio e il tuo quaderno.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994402
    m_Localized: "L'insegnante \xE8 l\xEC per aiutarti ad imparare."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994403
    m_Localized: Studierai matematica. Imparerai a contare, a calcolare.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994404
    m_Localized: Riordina le lettere dell'alfabeto per formare la parola SCUOLA.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994405
    m_Localized: Ben fatto! Ci sei riuscito!
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370886
    m_Localized: Prendilo!
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370885
    m_Localized: Ben fatto!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994408
    m_Localized: Bravo! Hai scritto la parola SCUOLA. Puoi entrare nella scuola.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994409
    m_Localized: Puoi accomodarti. Ecco il tuo tavolo e la tua sedia.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994410
    m_Localized: Trova la tua cartella e poi torna a trovarmi.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994411
    m_Localized: Ciao! All'ora di pranzo puoi mangiare in mensa o a casa.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994412
    m_Localized: "Dai un'occhiata al men\xF9 della mensa."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994413
    m_Localized: 'A scuola tutti sono benvenuti: ragazze e ragazzi,'
    m_Metadata:
      m_Items: []
  - m_Id: 102167994414
    m_Localized: indipendentemente dalle loro convinzioni.
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370884
    m_Localized: Rimetti le classi in ordine.
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370883
    m_Localized: Ma prima, devi vincerlo!
    m_Metadata:
      m_Items: []
  - m_Id: 960066824298496
    m_Localized: Trova la tua scuola!
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824448
    m_Localized: Trova la tua classe.
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824449
    m_Localized: Hai trovato la tua scuola!
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824450
    m_Localized: "Trova il tuo zaino cos\xEC potrai andare a scuola."
    m_Metadata:
      m_Items: []
  - m_Id: 1998423988363264
    m_Localized: "Non \xE8 del tutto esatto. Riprova!"
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370882
    m_Localized: "Forse questo \xE8 il tuo libro?"
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370881
    m_Localized: Questi libri sono utili per imparare a leggere. Con questi libri
      si impara l'alfabeto e le lettere.
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370880
    m_Localized: Ora, trova la tua scuola!
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660224
    m_Localized: "La partita \xE8 finita! Congratulazioni!"
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660225
    m_Localized: Si torna a scuola!
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660226
    m_Localized: Disegna la tua aula.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660227
    m_Localized: Buon appetito!
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660228
    m_Localized: "Al mattino e al pomeriggio c'\xE8 la ricreazione. Durante la ricreazione,
      i bambini giocano nel cortile."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660229
    m_Localized: Mi piace disegnare e colorare.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660230
    m_Localized: Adoro la musica e cantare con la mia classe.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660231
    m_Localized: "Mi piace la matematica perch\xE9 adoro fare calcoli."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660232
    m_Localized: Gioco a calcio con i miei amici nel parco giochi.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660233
    m_Localized: Mi piace fare sport con la mia classe. A volte andiamo in piscina.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660234
    m_Localized: In Francia, la scuola inizia a settembre e termina a giugno.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660235
    m_Localized: Durante l'anno scolastico ci sono delle vacanze.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660236
    m_Localized: A scuola impariamo a leggere, scrivere, contare e parlare nuove
      lingue.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660237
    m_Localized: Le lezioni si tengono dalle 8:00 alle 16:00.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660238
    m_Localized: All'ora di pranzo, puoi mangiare in mensa oppure tornare a casa
      per mangiare.
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660239
    m_Localized: A scuola impariamo a leggere e scrivere.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
