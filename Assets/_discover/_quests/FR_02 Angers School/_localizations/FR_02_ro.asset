%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FR_02_ro
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ro
  m_SharedData: {fileID: 11400000, guid: a33cf71e477044299aba778db3c07af9, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 102163800064
    m_Localized: "Bun venit \xEEn Angers! Angers este un ora\u0219 din vestul Fran\u021Bei.
      Ast\u0103zi este prima zi de \u0219coal\u0103! E din nou la \u0219coal\u0103!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994368
    m_Localized: "\u0218coala \xEEncepe din nou \xEEn septembrie. Ai 10 ani \u0219i
      intri \xEEn CM2."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994369
    m_Localized: "G\u0103se\u0219te-\u021Bi \u0219coala \u0219i clasa!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994370
    m_Localized: "Bun venit! Aceasta este o gr\u0103dini\u021B\u0103. Este o \u0219coal\u0103
      pentru copii cu v\xE2rste cuprinse \xEEntre 3 \u0219i 5 ani. Exist\u0103 trei
      clase la gr\u0103dini\u021B\u0103: clasa cea mic\u0103, clasa mijlocie \u0219i
      clasa cea mare."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994371
    m_Localized: "E\u0219ti prea b\u0103tr\xE2n. \u0218coala elementar\u0103 este
      chiar al\u0103turi. Elevii au \xEEntre 6 \u0219i 10 ani."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994372
    m_Localized: "Bun\u0103! Bine a\u021Bi venit! \u021Ai-ai g\u0103sit \u0219coala.
      E\u0219ti la \u0219coala primar\u0103. Exist\u0103 5 clase: CP, CE1, CE2, CM1
      \u0219i CM2."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994373
    m_Localized: "Dar ai uitat s\u0103-\u021Bi iei ghiozdanul."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994374
    m_Localized: "Ai nevoie de penar, creioane, caiete \u0219i c\u0103r\u021Bi."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994375
    m_Localized: "Bun\u0103! Aceasta este \u0219coala. Elevii au \xEEntre 11 \u0219i
      14 ani."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994376
    m_Localized: "Dup\u0103 CM2, elevii intr\u0103 \xEEn gimnaziu. \xCEncep gimnaziul
      la v\xE2rsta de 11 ani. Intr\u0103 \xEEn clasa a VI-a."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994377
    m_Localized: "Exist\u0103 patru clase \xEEn gimnaziu: a VI-a, a V-a, a IV-a \u0219i
      a III-a."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994378
    m_Localized: "Elevii se numesc elevi de liceu. Exist\u0103 trei clase \xEEn liceu."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994379
    m_Localized: "E\u0219ti prea mic pentru a intra la gimnaziu sau liceu."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994380
    m_Localized: "Salut! Am g\u0103sit un ghiozdan."
    m_Metadata:
      m_Items: []
  - m_Id: 13528238370709505
    m_Localized: "Du-te \u0219i \xEEntreab\u0103-i pe oamenii din jurul t\u0103u."
    m_Metadata:
      m_Items: []
  - m_Id: 13528238370709504
    m_Localized: "Poate cineva \u021Bi-a luat cartea."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994384
    m_Localized: "\u0218i gata! Intra\u021Bi \xEEn sala de clas\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994385
    m_Localized: "Intr\u0103! Sala ta de clas\u0103 este la cap\u0103tul coridorului."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994386
    m_Localized: "G\u0103se\u0219te-\u021Bi clasa."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994387
    m_Localized: "Aceasta este clasa \xEEnt\xE2i."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994388
    m_Localized: "Copiii \xEEncep \u0219coala primar\u0103 la v\xE2rsta de 6 ani
      \xEEn CP."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994389
    m_Localized: "Asta nu e clasa ta. Ai 10 ani. Deci e\u0219ti \xEEn CM2."
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370887
    m_Localized: "\xCEmi pare r\u0103u! Acesta nu este r\u0103spunsul corect. \xCEncearc\u0103
      din nou."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994391
    m_Localized: Aceasta este clasa CE1.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994392
    m_Localized: "Clasa \xEEnt\xE2i nu e clasa ta. E\u0219ti \xEEn clasa a cincea.
      \xCEncearc\u0103 din nou!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994393
    m_Localized: "Bun\u0103! Aceasta este clasa CE2."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994394
    m_Localized: Elevii au 8 ani.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994395
    m_Localized: Asta nu e clasa ta!
    m_Metadata:
      m_Items: []
  - m_Id: 102167994396
    m_Localized: "Bun\u0103! Aceasta este clasa CM1."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994397
    m_Localized: "CM1 este clasa de dup\u0103 CE2."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994398
    m_Localized: "Sala ta de clas\u0103 este foarte aproape!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994399
    m_Localized: "\u0218i iat\u0103! Aceasta este clasa voastr\u0103. Bine a\u021Bi
      venit la CM2!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994400
    m_Localized: Ia loc la masa ta.
    m_Metadata:
      m_Items: []
  - m_Id: 102167994401
    m_Localized: "Ia-\u021Bi penarul \u0219i caietul."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994402
    m_Localized: "Profesorul este acolo ca s\u0103 te ajute s\u0103 \xEEnve\u021Bi."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994403
    m_Localized: "Vei face matematic\u0103. Vei \xEEnv\u0103\u021Ba s\u0103 numeri,
      s\u0103 calculezi."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994404
    m_Localized: "Rearanja\u021Bi literele alfabetului pentru a scrie cuv\xE2ntul
      \u0218COAL\u0102."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994405
    m_Localized: "Bravo! Ai reu\u0219it!"
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370886
    m_Localized: Ia-l!
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370885
    m_Localized: "Bine f\u0103cut!"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994408
    m_Localized: "Bravo! Ai scris cuv\xE2ntul \u0218COAL\u0102. Po\u021Bi intra \xEEn
      \u0219coal\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994409
    m_Localized: "Po\u021Bi s\u0103-\u021Bi iei locul. Aici este masa \u0219i scaunul
      t\u0103u."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994410
    m_Localized: "G\u0103se\u0219te-\u021Bi ghiozdanul \u0219i apoi vino \xEEnapoi
      s\u0103 m\u0103 vezi."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994411
    m_Localized: "Bun\u0103! La pr\xE2nz, pute\u021Bi m\xE2nca la cantin\u0103 sau
      acas\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994412
    m_Localized: "Uit\u0103-te la meniul cantinei."
    m_Metadata:
      m_Items: []
  - m_Id: 102167994413
    m_Localized: "La \u0219coal\u0103, toat\u0103 lumea este binevenit\u0103: fete
      \u0219i b\u0103ie\u021Bi,"
    m_Metadata:
      m_Items: []
  - m_Id: 102167994414
    m_Localized: indiferent de convingerile lor.
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370884
    m_Localized: "Pune\u021Bi clasele la loc \xEEn ordine."
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370883
    m_Localized: "Dar mai \xEEnt\xE2i, trebuie s\u0103 c\xE2\u0219tigi!"
    m_Metadata:
      m_Items: []
  - m_Id: 960066824298496
    m_Localized: "G\u0103se\u0219te-\u021Bi \u0219coala!"
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824448
    m_Localized: "G\u0103se\u0219te-\u021Bi clasa."
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824449
    m_Localized: "\u021Ai-ai g\u0103sit \u0219coala!"
    m_Metadata:
      m_Items: []
  - m_Id: 960066878824450
    m_Localized: "G\u0103se\u0219te-\u021Bi ghiozdanul ca s\u0103 po\u021Bi merge
      la \u0219coal\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 1998423988363264
    m_Localized: "Nu este \xEEn \xEEntregime corect. \xCEncearc\u0103 din nou!"
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370882
    m_Localized: Poate fi aceasta cartea ta?
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370881
    m_Localized: "Aceste c\u0103r\u021Bi sunt utile atunci c\xE2nd \xEEnve\u021Bi
      s\u0103 cite\u0219ti. \xCEnve\u021Bi alfabetul \u0219i literele cu ajutorul
      acestor c\u0103r\u021Bi."
    m_Metadata:
      m_Items: []
  - m_Id: 9280941621370880
    m_Localized: "Acum, g\u0103se\u0219te-\u021Bi \u0219coala!"
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660224
    m_Localized: "Jocul s-a terminat! Felicit\u0103ri!"
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660225
    m_Localized: "E \xEEnapoi la \u0219coal\u0103!"
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660226
    m_Localized: "Deseneaz\u0103-\u021Bi sala de clas\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660227
    m_Localized: "Bucur\u0103-te de m\xE2ncare!"
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660228
    m_Localized: "Diminea\u021Ba \u0219i dup\u0103-amiaza exist\u0103 pauz\u0103.
      \xCEn timpul pauzei, copiii se joac\u0103 \xEEn locul de joac\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660229
    m_Localized: "\xCEmi place s\u0103 desenez \u0219i s\u0103 colorez."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660230
    m_Localized: "\xCEmi place muzica \u0219i s\u0103 c\xE2nt cu clasa mea."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660231
    m_Localized: "\xCEmi place matematica pentru c\u0103 \xEEmi place s\u0103 fac
      calcule."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660232
    m_Localized: "Joc fotbal cu prietenii mei \xEEn curtea \u0219colii."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660233
    m_Localized: "\xCEmi place s\u0103 fac sport cu clasa mea. Uneori mergem la piscin\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660234
    m_Localized: "\xCEn Fran\u021Ba, \u0219coala \xEEncepe \xEEn septembrie \u0219i
      se termin\u0103 \xEEn iunie."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660235
    m_Localized: "Exist\u0103 vacan\u021Be \xEEn timpul anului \u0219colar."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660236
    m_Localized: "La \u0219coal\u0103, \xEEnv\u0103\u021B\u0103m s\u0103 citim, s\u0103
      scriem, s\u0103 num\u0103r\u0103m \u0219i s\u0103 vorbim limbi noi."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660237
    m_Localized: "Cursurile se \u021Bin \xEEntre orele 8:00 \u0219i 16:00."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660238
    m_Localized: "La pr\xE2nz, po\u021Bi m\xE2nca la cantin\u0103 sau po\u021Bi merge
      acas\u0103 s\u0103 m\u0103n\xE2nci."
    m_Metadata:
      m_Items: []
  - m_Id: 2479185556660239
    m_Localized: "La \u0219coal\u0103, \xEEnv\u0103\u021B\u0103m s\u0103 citim \u0219i
      s\u0103 scriem."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
